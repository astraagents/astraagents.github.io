ce"}, {"id": "mol_016", "formula": "H+", "iupac_name": "hydron", "common_name": "proton", "inchi": "InChI=1S/p+1", "role": "starting", "environment_formed": null}, {"id": "mol_017", "formula": "C3H4O", "iupac_name": "prop-2-enal", "common_name": "acrolein", "inchi": "InChI=1S/C3H4O/c1-2-3-4/h2-3H,1H2", "role": "starting", "environment_formed": null}, {"id": "mol_018", "formula": "HCN", "iupac_name": "hydrogen cyanide", "common_name": "hydrogen cyanide", "inchi": "InChI=1S/CHN/c1-2/h1H", "role": "starting", "environment_formed": null}, {"id": "mol_019", "formula": "C4H5NO", "iupac_name": "4-oxobutanenitrile", "common_name": "3-cyanopropanal", "inchi": null, "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_020", "formula": "C5H6N2O", "iupac_name": "2-hydroxypentanedinitrile", "common_name": null, "inchi": "InChI=1S/C5H6N2O/c6-3-1-2-5(8)4-7/h5,8H,1-2H2", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_021", "formula": "C5H7N3", "iupac_name": "2-aminopentanedinitrile", "common_name": null, "inchi": "InChI=1S/C5H7N3/c6-3-1-2-5(8)4-7/h5H,1-2,8H2", "role": "hub_intermediate", "environment_formed": "Surface"}], "reactions": [{"id": "rxn_001", "name": "Mineral-mediated CO2 hydrogenation to pyruvate, aggregate transformation", "inputs": ["mol_001", "mol_002"], "outputs": ["mol_004", "mol_003"], "environment": "Hydrothermal", "agents": ["Awaruite, Ni3Fe, as an H2-activating mineral catalyst"], "conditions": {"temperature": "Approximately 373 K", "pressure": "Pressurized H2/CO2; sufficient to maintain liquid water", "catalyst": "Awaruite", "aqueous": true, "other": "Anoxic rock-water interface; initially alkaline conditions are plausible. Products require cooling and concentration before downstream surface chemistry."}, "mechanism": "Aggregate CO2 reduction and carbon-carbon bond formation on an H2-activating alloy surface. Neutral-reference balance: 3 CO2 + 5 H2 -> pyruvic acid + 3 H2O. This node does not imply a single elementary reaction.", "reasoning": "Preiner et al. (2020), as summarized in the supplied research, support mineral-mediated formation of pyruvate from CO2/H2. Pyruvate can be a minor product in a broader mixture; selective production and direct coupling to the downstream network are not established. Awaruite is chemically justified by its ability to activate hydrogen, rather than included merely as a generic mineral."}, {"id": "rxn_002", "name": "Oxaloacetate decarboxylation to pyruvate", "inputs": ["mol_006"], "outputs": ["mol_004", "mol_001"], "environment": "Surface", "agents": ["Dissolved Fe(II) as a coordination promoter"], "conditions": {"temperature": "343 K", "pressure": "Approximately 1 bar", "catalyst": "Fe(II)", "aqueous": true, "other": "Anoxic geothermal pool; residence time must account for rapid oxaloacetate consumption. This branch competes with oxaloacetate aldol addition in rxn_004."}, "mechanism": "Beta-ketoacid decarboxylation gives a pyruvate enol, which tautomerizes to pyruvate, releasing CO2 without requiring an oxidant.", "reasoning": "The supplied account of Muchowska et al. (2019) identifies iron-promoted oxaloacetate-to-pyruvate conversion. This provides a chemically distinct feedstock entry but depends on an external oxaloacetate supply. The laboratory temperature is assigned to a surface geothermal setting rather than incorrectly requiring a hot black-smoker environment."}, {"id": "rxn_003", "name": "Iron-promoted pyruvate-glyoxylate aldol addition", "inputs": ["mol_004", "mol_005"], "outputs": ["mol_007"], "environment": "Surface", "agents": ["Dissolved Fe(II) as a Lewis-acid and enolization promoter"], "conditions": {"temperature": "343 K", "pressure": "Approximately 1 bar", "catalyst": "Fe(II)", "aqueous": true, "other": "Anoxic, concentrated precursor solution in geothermal porewater; pH must retain useful iron availability and permit enolization. Strong sulfide precipitation would reduce dissolved Fe(II)."}, "mechanism": "The pyruvate enol or enolate attacks the glyoxylate aldehyde carbonyl, forming the new carbon-carbon bond of 4-hydroxy-2-oxoglutarate. This is aldol addition, with no net water loss at this node.", "reasoning": "Muchowska et al. (2019) support the iron-promoted precursor network, and Springsteen et al. (2018) provide related glyoxylate aldol chemistry. Bimolecular concentration requirements, competing condensations and product decomposition limit potential flux; quantitative accumulation in a natural pool is not demonstrated."}, {"id": "rxn_004", "name": "Oxaloacetate-glyoxylate aldol entry through oxalomalate", "inputs": ["mol_006", "mol_005"], "outputs": ["mol_008"], "environment": "Surface", "agents": null, "conditions": {"temperature": "296-313 K", "pressure": "Approximately 1 bar", "catalyst": null, "aqueous": true, "other": "Neutral to mildly alkaline concentrated water; no added mineral catalyst is assumed. Oxaloacetate decarboxylation and retro-aldol cleavage compete."}, "mechanism": "Enolization of the oxaloacetate methylene followed by attack on glyoxylate forms the C6 aldol adduct oxalomalate. The transformation is atom-balanced without an oxidant or reductant.", "reasoning": "Speculative preparative implementation consistent with the glyoxylate-cycle chemistry discussed by Springsteen et al. (2018). The supplied summary documents the downstream oxalomalate conversion but does not establish an isolated yield for this upstream step. Including its chemically plausible formation avoids treating the C6 intermediate as an unexplained starting material."}, {"id": "rxn_005", "name": "Nonoxidative oxalomalate decarboxylation", "inputs": ["mol_008"], "outputs": ["mol_007", "mol_001"], "environment": "Surface", "agents": null, "conditions": {"temperature": "Approximately 296 K", "pressure": "Approximately 1 bar", "catalyst": null, "aqueous": true, "other": "Ambient-temperature aqueous stage; the supplied review reports observation over approximately 3 hours. Subsequent dehydration requires a warmer stage."}, "mechanism": "Beta-ketoacid decarboxylation removes the carboxyl substituent on the central carbon of oxalomalate. Proton transfer and tautomerization produce 4-hydroxy-2-oxoglutarate and CO2.", "reasoning": "Springsteen et al. (2018) are the supplied source for this conversion. The stated formulas balance as a nonoxidative decarboxylation, so the review's description of this particular step as oxidative is not adopted. No oxygen or peroxide is introduced, and successful coupling to the warmer iron-promoted sequence remains unproven."}, {"id": "rxn_006", "name": "Hydroxy-oxoglutarate dehydration", "inputs": ["mol_007"], "outputs": ["mol_009", "mol_003"], "environment": "Surface", "agents": ["Dissolved Fe(II) as a coordination promoter"], "conditions": {"temperature": "343 K", "pressure": "Approximately 1 bar", "catalyst": "Fe(II)", "aqueous": true, "other": "Warm anoxic geothermal water; downstream consumption can favor net progression. Neither complete dehydration nor a single alkene stereoisomer is assumed."}, "mechanism": "Elimination of the beta-hydroxyl group and an adjacent hydrogen yields the conjugated unsaturated keto-diacid plus water.", "reasoning": "The supplied mechanistic account of Muchowska et al. (2019) motivates this step. Its representation as a separate node is a mechanistic decomposition of the reported network, not evidence that the intermediate was isolated at high yield. Hydration, retro-aldol cleavage and other decomposition reactions can compete."}, {"id": "rxn_007", "name": "Sacrificial-iron reduction of the unsaturated C5 keto-diacid", "inputs": ["mol_009", "mol_014", "mol_016"], "outputs": ["mol_010", "mol_015"], "environment": "Surface", "agents": ["Native iron, Fe(0), consumed as the electron donor", "Dissolved Fe(II) as a possible coordination promoter"], "conditions": {"temperature": "343 K", "pressure": "Approximately 1 bar", "catalyst": "Fe(II) coordination promoter; Fe(0) is sacrificial rather than catalytic", "aqueous": true, "other": "Fresh metallic iron contact in mildly acidic anoxic water; proton availability is controlled by the surrounding solution. Iron corrosion and carbonyl reduction compete."}, "mechanism": "Two-electron, two-proton reduction saturates the alkene while retaining the keto group. Reference balance: C5H4O5 + Fe + 2 H+ -> C5H6O5 + Fe2+.", "reasoning": "Muchowska et al. (2019) support the broader iron-promoted precursor chemistry. This explicit Fe(0)-driven implementation is speculative: the supplied review's Fe(II)-only description does not close the electron balance. Metallic iron supplies the missing reducing equivalents, but selective alkene reduction over keto-group reduction and decomposition requires experimental validation."}, {"id": "rxn_008", "name": "Hydroxylamine-derived oxime formation and iron reduction to glutamate", "inputs": ["mol_010", "mol_011", "mol_014", "mol_016"], "outputs": ["mol_013", "mol_015", "mol_003"], "environment": "Surface", "agents": ["Native iron, Fe(0), consumed as reductant", "Dissolved Fe(II) as a coordination promoter"], "conditions": {"temperature": "343 K", "pressure": "Approximately 1 bar", "catalyst": "Fe(II) coordination promoter; Fe(0) supplies reducing equivalents", "aqueous": true, "other": "Anoxic, mildly acidic solution with hydroxylamine supplied after C5 skeleton formation. Metallic iron availability and competing corrosion constrain throughput."}, "mechanism": "Hydroxylamine condenses with the keto group to form an oxime. Reduction of the C=N functionality and cleavage of the N-O bond yield glutamate. Reference balance: 2-oxoglutaric acid + NH2OH + 2 Fe + 4 H+ -> glutamic acid + 2 Fe2+ + 2 H2O.", "reasoning": "Muchowska et al. (2019) support hydroxylamine/iron conversion of keto-acid precursors to amino acids. This is reductive amination through an oxime, not transamination. Explicit four-electron accounting corrects the incomplete review equation. Hydroxylamine abundance is unresolved, and no chiral reagent or catalyst justifies selective L-glutamate production."}, {"id": "rxn_009", "name": "Conditional H2-driven ammonia reductive amination at an FeS interface", "inputs": ["mol_010", "mol_012", "mol_002"], "outputs": ["mol_013", "mol_003"], "environment": "Hydrothermal", "agents": ["FeS-bearing mineral interface as a candidate imine-binding and reduction surface"], "conditions": {"temperature": "350-400 K, proposed evaluation window", "pressure": "Elevated hydrothermal pressure with an H2-rich fluid", "catalyst": "FeS-bearing interface; catalytic competence for this exact implementation is unverified", "aqueous": true, "other": "Proposed mildly alkaline conditions, approximately pH 8-10; NH3/NH4+ speciation, H2 activation and competing keto-acid reduction require measurement. Avoid prolonged exposure to hotter vent interiors."}, "mechanism": "Ammonia adds to the keto group, followed by dehydration to an imine and hydrogenation to glutamate. Net reference balance: 2-oxoglutaric acid + NH3 + H2 -> glutamic acid + H2O.", "reasoning": "Speculative FeS/H2 implementation. The supplied review associates mineral-mediated ammonia amination with Kitadai et al. (2019), but does not establish that FeS plus H2 alone performs this exact reaction under the proposed conditions. H2 explicitly supplies reducing equivalents; FeS is not treated as an inexhaustible electron donor. This branch is retained as a testable alternative that avoids hydroxylamine, not as an independently verified final step."}, {"id": "rxn_010", "name": "Candidate conjugate cyanation of acrolein", "inputs": ["mol_017", "mol_018"], "outputs": ["mol_019"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-320 K, proposed", "pressure": "Approximately 1 bar", "catalyst": null, "aqueous": true, "other": "Proposed mildly alkaline water with some cyanide present; shallow-pore retention must limit HCN volatilization. Acrolein polymerization and carbonyl cyanohydrin formation compete."}, "mechanism": "Conjugate cyanide addition to the beta carbon of acrolein, followed by protonation, gives NC-CH2-CH2-CHO. The net transformation adds HCN without changing the aldehyde oxidation state.", "reasoning": "Speculative feedstock extension. Patel et al. (2015) provide the broader cyanide-derived amino-acid-precursor context, but the supplied report does not demonstrate this acrolein conjugate-cyanation step. It is included as a chemically plausible C3+C1 construction rather than assuming a preformed C5 dinitrile. Competition with 1,2-addition is a major selectivity bottleneck."}, {"id": "rxn_011", "name": "Cyanohydrin formation from 3-cyanopropanal", "inputs": ["mol_019", "mol_018"], "outputs": ["mol_020"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-320 K", "pressure": "Approximately 1 bar", "catalyst": null, "aqueous": true, "other": "HCN/CN- availability controlled by pH; product formation is reversible. UV attenuation and limited residence time may reduce precursor degradation."}, "mechanism": "Cyanide adds to the aldehyde carbonyl of 3-cyanopropanal; protonation of the alkoxide produces 2-hydroxypentanedinitrile.", "reasoning": "Speculative preparative reconstruction of the precursor chemistry associated with Patel et al. (2015). Cyanohydrin formation is chemically well established, but the supplied summary does not independently document this particular aldehyde-to-C5-cyanohydrin preparation. Equilibrium, HCN loss and precursor stability must be measured."}, {"id": "rxn_012", "name": "Cyanohydrin-mediated Strecker entry to the aminodinitrile", "inputs": ["mol_020", "mol_012"], "outputs": ["mol_021", "mol_003"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-330 K", "pressure": "Approximately 1 bar", "catalyst": null, "aqueous": true, "other": "Ammonia-rich concentrated solution with pH-dependent cyanohydrin/aldehyde/imine equilibria; no direct displacement of an unactivated hydroxyl