      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_009\",\n      \"formula\": \"H3N\",\n      \"iupac_name\": \"Ammonia\",\n      \"common_name\": \"Ammonia\",\n      \"inchi\": \"InChI=1S/H3N/h1H3\",\n      \"role\": \"hub_intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_010\",\n      \"formula\": \"Fe\",\n      \"iupac_name\": \"Iron\",\n      \"common_name\": \"Native iron\",\n      \"inchi\": \"InChI=1S/Fe\",\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_011\",\n      \"formula\": \"H+\",\n      \"iupac_name\": \"Hydrogen(1+)\",\n      \"common_name\": \"Aqueous proton\",\n      \"inchi\": \"InChI=1S/p+1\",\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_012\",\n      \"formula\": \"Fe+2\",\n      \"iupac_name\": \"Iron(2+)\",\n      \"common_name\": \"Ferrous ion\",\n      \"inchi\": \"InChI=1S/Fe/q+2\",\n      \"role\": \"hub_intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_013\",\n      \"formula\": \"H2O\",\n      \"iupac_name\": \"Water\",\n      \"common_name\": \"Water\",\n      \"inchi\": \"InChI=1S/H2O/h1H2\",\n      \"role\": \"hub_intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_014\",\n      \"formula\": \"CO2\",\n      \"iupac_name\": \"Carbon dioxide\",\n      \"common_name\": \"Carbon dioxide\",\n      \"inchi\": \"InChI=1S/CO2/c2-1-3\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_015\",\n      \"formula\": \"C4H5NO\",\n      \"iupac_name\": \"4-oxobutanenitrile\",\n      \"common_name\": \"3-Cyanopropanal\",\n      \"inchi\": null,\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_016\",\n      \"formula\": \"CHN\",\n      \"iupac_name\": \"Hydrogen cyanide\",\n      \"common_name\": \"Hydrogen cyanide\",\n      \"inchi\": \"InChI=1S/CHN/c1-2/h1H\",\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_017\",\n      \"formula\": \"C5H6N2O\",\n      \"iupac_name\": \"2-hydroxypentanedinitrile\",\n      \"common_name\": \"Glutamate-precursor cyanohydrin\",\n      \"inchi\": \"InChI=1S/C5H6N2O/c6-3-1-2-5(8)4-7/h5,8H,1-2H2\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_018\",\n      \"formula\": \"C5H7N3\",\n      \"iupac_name\": \"2-aminopentanedinitrile\",\n      \"common_name\": \"Glutamate-precursor aminodinitrile\",\n      \"inchi\": \"InChI=1S/C5H7N3/c6-3-1-2-5(8)4-7/h5H,1-2,8H2\",\n      \"role\": \"hub_intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_019\",\n      \"formula\": \"C5H9NO4\",\n      \"iupac_name\": \"2-aminopentanedioic acid\",\n      \"common_name\": \"Glutamic acid; racemic glutamate reference form\",\n      \"inchi\": \"InChI=1S/C5H9NO4/c6-3(5(9)10)1-2-4(7)8/h3H,1-2,6H2,(H,7,8)(H,9,10)\",\n      \"role\": \"target\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_020\",\n      \"formula\": \"C5H7NO5\",\n      \"iupac_name\": \"2-(hydroxyimino)pentanedioic acid\",\n      \"common_name\": \"2-Oxoglutarate oxime\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    }\n  ],\n  \"reactions\": [\n    {\n      \"id\": \"rxn_001\",\n      \"name\": \"Ferrous-ion-promoted pyruvate-glyoxylate aldol addition\",\n      \"inputs\": [\"mol_001\", \"mol_002\"],\n      \"outputs\": [\"mol_005\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Dissolved Fe2+ as a Lewis-acid promoter\"],\n      \"conditions\": {\n        \"temperature\": \"343 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": \"Fe2+\",\n        \"aqueous\": true,\n        \"other\": \"Anoxic, UV-shielded geothermal water. Proposed screening conditions: pH 4.5-6.5, 10-100 mM organic substrates, 1-10 mM dissolved Fe2+, and 1-24 h residence. These concentration, pH and residence ranges are not asserted to reproduce the cited protocol. Avoid sulfide-rich water that removes dissolved Fe2+.\"\n      },\n      \"mechanism\": \"The pyruvate enol or enolate attacks the glyoxylate aldehyde carbon, creating the C5 skeleton. Fe2+ coordination can facilitate carbonyl activation and enolization. Balanced net equation: pyruvic acid + glyoxylic acid -> 4-hydroxy-2-oxoglutaric acid. This is aldol addition, without net water loss.\",\n      \"reasoning\": \"The reaction family and 343 K iron-promoted setting are supported by Muchowska et al. (2019), with related aldol chemistry in Springsteen et al. (2018). Surface geothermal water accommodates the reported temperature without extrapolation to a hotter vent. Productive accumulation must compete with retro-aldol chemistry and other carbonyl reactions; the supplied review gives no isolated yield for the proposed operating window.\"\n    },\n    {\n      \"id\": \"rxn_002\",\n      \"name\": \"General-base pyruvate-glyoxylate aldol addition\",\n      \"inputs\": [\"mol_001\", \"mol_002\"],\n      \"outputs\": [\"mol_005\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Hydroxide-mediated general-base catalysis\"],\n      \"conditions\": {\n        \"temperature\": \"296-313 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": \"General base\",\n        \"aqueous\": true,\n        \"other\": \"Anoxic, shaded alkaline pool or tidal microenvironment. Proposed screening conditions: pH 8.5-10, 10-100 mM organic substrates, and 1-7 days. No added transition-metal catalyst. Subsequent iron-mediated processing requires a separate, less alkaline stage.\"\n      },\n      \"mechanism\": \"Base-assisted pyruvate enolization followed by addition to glyoxylate gives the same C5 beta-hydroxy keto acid as rxn_001. Balanced net equation: pyruvic acid + glyoxylic acid -> 4-hydroxy-2-oxoglutaric acid.\",\n      \"reasoning\": \"Springsteen et al. (2018) supports non-iron aldol chemistry within glyoxylate reaction networks. This is a catalyst and operating-regime alternative, not an independent biosynthetic family. The proposed pH and residence window requires experimental confirmation; glyoxylate side reactions and the subsequent change in solution conditions can reduce end-to-end yield.\"\n    },\n    {\n      \"id\": \"rxn_003\",\n      \"name\": \"Oxaloacetate decarboxylation supplying pyruvate\",\n      \"inputs\": [\"mol_003\"],\n      \"outputs\": [\"mol_001\", \"mol_014\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Dissolved Fe2+ as a keto-acid coordination promoter\"],\n      \"conditions\": {\n        \"temperature\": \"323-343 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": \"Fe2+\",\n        \"aqueous\": true,\n        \"other\": \"Anoxic, UV-shielded geothermal water. Proposed screening conditions: pH 4.5-6.5, 1-10 mM Fe2+, and 0.25-6 h residence. Supply oxaloacetate incrementally rather than assuming long-term storage of a concentrated stable pool.\"\n      },\n      \"mechanism\": \"Beta-keto-acid decarboxylation releases CO2 and gives a pyruvate enol that tautomerizes to pyruvate. Balanced net equation: oxaloacetic acid -> pyruvic acid + CO2.\",\n      \"reasoning\": \"Oxaloacetate-to-pyruvate conversion is supported by the iron-promoted network described by Muchowska et al. (2019) and by established beta-keto-acid chemistry. Fe2+ can promote the reaction but is not its electron source. This entry avoids an unspecified CO2-fixation implementation, while leaving oxaloacetate availability as an explicit feedstock-boundary limitation.\"\n    },\n    {\n      \"id\": \"rxn_004\",\n      \"name\": \"Oxaloacetate-glyoxylate aldol capture\",\n      \"inputs\": [\"mol_003\", \"mol_002\"],\n      \"outputs\": [\"mol_004\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"General-base catalysis in mildly alkaline water\"],\n      \"conditions\": {\n        \"temperature\": \"296-303 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": \"General base\",\n        \"aqueous\": true,\n        \"other\": \"Anoxic, shaded aqueous microenvironment. Proposed screening conditions: pH 7.5-9, 10-100 mM organic substrates, glyoxylate in excess, and 0.25-3 h initial observation. Lower temperature is chosen to limit premature oxaloacetate decarboxylation.\"\n      },\n      \"mechanism\": \"The enolizable methylene of oxaloacetate adds to glyoxylate, producing the C6 tricarboxylic beta-hydroxy keto acid. Balanced net equation: oxaloacetic acid + glyoxylic acid -> oxalomalic acid.\",\n      \"reasoning\": \"This precursor construction is chemically consistent with the oxalomalate branch discussed in Springsteen et al. (2018). The supplied review does not document a selective yield for this exact proposed implementation, so the entry remains provisional. Aldol capture must outcompete oxaloacetate decarboxylation, and detection of downstream products alone would not establish the flux through this intermediate.\"\n    },\n    {\n      \"id\": \"rxn_005\",\n      \"name\": \"Nonoxidative oxalomalate decarboxylation\",\n      \"inputs\": [\"mol_004\"],\n      \"outputs\": [\"mol_005\", \"mol_014\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"296-303 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Anoxic, UV-shielded aqueous solution. The supplied review associates the ambient-temperature conversion with approximately 3 h. Proposed pH screening: 6-8. No O2, peroxide or other oxidant is required by this net transformation.\"\n      },\n      \"mechanism\": \"Loss of the beta-keto-acid carboxyl group followed by proton transfer produces the C5 hydroxy keto acid. Balanced net equation: oxalomalic acid -> 4-hydroxy-2-oxoglutaric acid + CO2.\",\n      \"reasoning\": \"Springsteen et al. (2018) supports this connection between oxalomalate and the C5 intermediate. The supplied equation describes nonoxidative decarboxylation, despite the review calling it oxidative. Distinguishing this step from other oxidative reactions in the larger glyoxylate cycles avoids introducing an unjustified oxidant.\"\n    },\n    {\n      \"id\": \"rxn_006\",\n      \"name\": \"Hydroxy-oxoglutarate dehydration\",\n      \"inputs\": [\"mol_005\"],\n      \"outputs\": [\"mol_006\", \"mol_013\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Dissolved Fe2+ for carbonyl and hydroxyl coordination\"],\n      \"conditions\": {\n        \"temperature\": \"343 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": \"Fe2+\",\n        \"aqueous\": true,\n        \"other\": \"Anoxic, UV-shielded geothermal solution. Proposed screening conditions: pH 4.5-6.5, 1-10 mM Fe2+, and 1-24 h. Aqueous dehydration is reversible; evaporation to dryness is not assumed necessary or beneficial.\"\n      },\n      \"mechanism\": \"Elimination of the hydroxyl group and an adjacent hydrogen forms the conjugated alkene. Balanced net equation: 4-hydroxy-2-oxoglutaric acid -> 4-oxopent-2-enedioic acid + H2O. Alkene geometry is left unspecified.\",\n      \"reasoning\": \"The supplied account of Muchowska et al. (2019) supports dehydration within the iron-promoted C5 sequence. It does not establish quantitative accumulation of an isolated alkene stereoisomer. Rehydration, retro-aldol cleavage and keto-acid degradation remain competing processes, so this node is not treated as an irreversible quantitative conversion.\"\n    },\n    {\n      \"id\": \"rxn_007\",\n      \"name\": \"Sacrificial-iron reduction of the unsaturated C5 keto acid\",\n      \"inputs\": [\"mol_006\", \"mol_010\", \"mol_011\"],\n      \"outputs\": [\"mol_007\", \"mol_012\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Fresh native-iron surface, consumed as the reductant\"],\n      \"conditions\": {\n        \"temperature\": \"323-343 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Proposed implementation: anoxic, UV-shielded, sulfide-poor water at pH 4.5-6.5. Minimum redox demand is one mole of Fe0 per mole of alkene reduced. An initial 0.25-6 h contact-time screen should distinguish useful conversion from carbonyl reduction and decomposition. Fresh surface availability and passivation must be measured.\"\n      },\n      \"mechanism\": \"Two-electron reduction and protonation saturate the conjugated C=C bond while ideally retaining the keto group. Balanced net equation: C5H4O5 + Fe + 2 H+ -> C5H6O5 + Fe2+. Fe0 is a reagent, not an indefinitely regenerating catalyst.\",\n      \"reasoning\": \"Speculative isolated-step implementation. Muchowska et al. (2019) supports iron-promoted formation of metabolic precursors, but the supplied review does not establish selective reduction of this isolated substrate by the stated Fe0 system. Explicit Fe consumption repairs electron bookkeeping without proving selectivity. This remains a shared bottleneck for P1-P8: carbonyl reduction, corrosion and decarboxylation must be quantified before any of those complete routes can be called established.\"\n    },\n    {\n      \"id\": \"rxn_008\",\n      \"name\": \"2-Oxoglutarate oxime formation\",\n      \"inputs\": [\"mol_007\", \"mol_008\"],\n      \"outputs\": [\"mol_020\", \"mol_013\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-343 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Anoxic, UV-shielded solution. Proposed screening conditions: pH 4.5-6.5, 10-100 mM keto acid, approximately equimolar or modestly excess hydroxylamine, and 0.25-6 h before iron reduction. Avoid prolonged hot storage of unreacted 2-oxoglutarate.\"\n      },\n      \"mechanism\": \"Hydroxylamine adds to the keto carbonyl; carbinolamine dehydration gives an oxime. Balanced net equation: C5H6O5 + H3NO -> C5H7NO5 + H2O. This is oxime formation, not transamination.\",\n      \"reasoning\": \"Muchowska et al. (2019) supports the overall hydroxylamine/iron conversion of keto acids to amino acids. Resolving it into oxime formation and reduction makes the required intermediate and electron demand explicit. The review does not provide an isolated oxime yield or E/Z distribution, and prebiotic hydroxylamine supply remains unresolved.\"\n    },\n    {\n      \"id\": \"rxn_009\",\n      \"name\": \"Iron-driven oxime reduction to racemic glutamate\",\n      \"inputs\": [\"mol_020\", \"mol_010\", \"mol_011\"],\n      \"outputs\": [\"mol_019\", \"mol_013\", \"mol_012\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Native iron as a sacrificial four-electron reductant\"],\n      \"conditions\": {\n        \"temperature\": \"343 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Anoxic, UV-shielded geothermal water. Proposed pH 4.5-6.5 and 1-24 h screening window. The minimum stoichiometric demand is two moles of Fe0 per mole of oxime; corrosion can increase practical consumption. Sulfide exclusion and replenishment of reactive metal surfaces are implementation requirements.\"\n      },\n      \"mechanism\": \"Reduction of the C=N functionality and N-O bond cleavage gives the alpha-amino acid. Balanced net equation: C5H7NO5 + 2 Fe + 4 H+ -> C5H9NO4 + H2O + 2 Fe2+. Combining rxn_008 and rxn_009 produces two waters per glutamate.\",\n      \"reasoning\": \"The combined oxime-forming and reducing sequence corresponds to the hydroxylamine/iron chemistry reported by Muchowska et al. (2019). Explicit stoichiometry includes both Fe atoms and all four protons required for four-electron reduction. The proposed staging is not a separately validated protocol, and no isolated yield is supplied here. Achiral reagents and surfaces do not justify an L-selective product.\"\n    },\n    {\n      \"id\": \"rxn_010\",\n      \"name\": \"Candidate native-iron-driven ammonia reductive amination\",\n      \"inputs\": [\"mol_007\", \"mol_009\", \"mol_010\", \"mol_011\"],\n      \"outputs\": [\"mol_019\", \"mol_013\", \"mol_012\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Native iron as a sacrificial reductant and reactive interface\"],\n      \"conditions\": {\n        \"temperature\": \"343-363 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Speculative operating window: anoxic, UV-shielded, sulfide-poor water; pH 7.5-8.5; total NH3/NH4+ 0.05-0.5 M in a locally concentrated pool; 1-24 h initial screen. At least one mole of Fe0 is required per mole of glutamate. Ammonia speciation, iron passivation and keto-acid loss must be measured together.\"\n      },\n      \"mechanism\": \"Ammonia addition and dehydration generate an imine or iminium species, followed by two-electron reduction at the iron interface. Balanced net equation: C5H6O5 + NH3 + Fe + 2 H+ -> C5H9NO4 + H2O + Fe2+. The proton demand is formal acid/base bookkeeping at the operating pH.\",\n      \"reasoning\": \"Speculative replacement for the insufficiently specified FeS/H2 implementation. Kitadai et al. (2019) provides literature context for metal-enabled protometabolic reductive chemistry, but the supplied summary does not validate this precise Fe0/ammonia protocol. Consuming native iron supplies explicit electrons without assuming FeS activates H2. That correction does not demonstrate productive imine reduction; P2, P4, P6 and P8 therefore retain an additional terminal-step uncertainty.\"\n    },\n    {\n      \"id\": \"rxn_011\",\n      \"name\": \"Cyanohydrin capture of 4-oxobutanenitrile\",\n      \"inputs\": [\"mol_015\", \"mol_016\"],\n      \"outputs\": [\"mol_017\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"298-313 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Anoxic, shaded pool or sediment porewater. Proposed screening conditions: pH 7-8.5, 10-100 mM aldehyde and available cyanide, and 0.25-24 h. The C4 aldehyde is a declared feedstock; its generation by selective acrolein conjugate cyanation is not assumed. HCN loss must be included in any material balance.\"\n      },\n      \"mechanism\": \"Cyanide adds to the aldehyde carbonyl and protonation produces the cyanohydrin. Balanced net equation: C4H5NO + HCN -> C5H6N2O.\",\n      \"reasoning\": \"Patel et al. (2015) supports the relevance of cyanosulfidic cyanohydrin and aminonitrile chemistry. This particular entry is a conventional but provisional implementation from an explicitly supplied aldehyde; the review does not establish its selective preparation or delivery. Moving that precursor to the feedstock boundary avoids presenting uncertain acrolein regioselectivity as demonstrated chemistry, but does not resolve precursor availability.\"\n    },\n    {\n      \"id\": \"rxn_012\",\n      \"name\": \"Cyanohydrin-mediated Strecker equilibration\",\n      \"inputs\": [\"mol_017\", \"mol_009\"],\n      \"outputs\": [\"mol_018\", \"mol_013\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"298-313 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Anoxic, UV-shielded aqueous stage. Proposed screening conditions: pH 8-9, total ammonia/ammonium 0.05-0.5 M, and 1-48 h. Maintain an available cyanide pool through cyanohydrin equilibration and limit HCN escape. Hydrolysis is deferred to a separate acidic heating stage.\"\n      },\n      \"mechanism\": \"Reversible cyanohydrin dissociation exposes the aldehyde. Ammonia forms a carbinolamine and imine; cyanide addition then gives the aminodinitrile. Balanced net equation: C5H6N2O + NH3 -> C5H7N3 + H2O. This is not direct displacement of an unactivated hydroxyl group.\",\n      \"reasoning\": \"The supplied account of Patel et al. (2015) supports this precursor relationship. A Strecker-equilibration mechanism is more defensible than the review's simple hydroxyl-substitution description. The exact C5 substrate distribution, ammonia requirement and competing decomposition rates are not established by the supplied summary.\"\n    },\n    {\n      \"id\": \"rxn_013\",\n      \"name\": \"Imine-first Strecker formation of the aminodinitrile\",\n      \"inputs\": [\"mol_015\", \"mol_009\", \"mol_016\"],\n      \"outputs\": [\"mol_018\", \"mol_013\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"298-313 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Anoxic, shaded aqueous stage. Proposed screening conditions: pH 8-9, 10-100 mM aldehyde, total ammonia/ammonium 0.05-0.5 M, and 1-48 h. Ammonia exposure precedes substantial cyanide addition to favor an imine-first operating sequence; an isolated cyanohydrin pool is not required.\"\n      },\n      \"mechanism\": \"The aldehyde condenses with ammonia; cyanide addition to the imine/iminium carbon installs the second nitrile and the alpha-amino group. Balanced net equation: C4H5NO + NH3 + HCN -> C5H7N3 + H2O.\",\n      \"reasoning\": \"Speculative substrate-specific implementation of conventional Strecker chemistry. Patel et al. (2015) supplies the relevant cyanosulfidic precursor framework, but the supplied review does not establish this exact imine-first protocol. This is an operational alternative to rxn_011 followed by rxn_012, not an additional independently validated synthesis family.\"\n    },\n    {\n      \"id\": \"rxn_014\",\n      \"name\": \"Staged acid-catalyzed double-nitrile hydrolysis\",\n      \"inputs\": [\"mol_018\", \"mol_013\"],\n      \"outputs\": [\"mol_019\", \"mol_009\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Aqueous acid as a hydrolysis catalyst\"],\n      \"conditions\": {\n        \"temperature\": \"363-370 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": \"Hydronium\",\n        \"aqueous\": true,\n        \"other\": \"Proposed validation regime, not a reported successful protocol: anoxic, UV-shielded, volcanic-HCl-acidified geothermal water at pH 1-2; 7-30 days with continued liquid-water availability. Transfer from the alkaline Strecker stage must be local and must limit dilution. At this pH the released ammonia is predominantly NH4+, and amino-acid protonation differs from the neutral reference formula.\"\n      },\n      \"mechanism\": \"Both nitriles undergo hydration to amide intermediates and subsequent hydrolysis to carboxylic acids. This node lumps the sequential hydrolyses rather than asserting a single elementary event. Balanced neutral-reference equation: C5H7N3 + 4 H2O -> C5H9NO4 + 2 NH3.\",\n      \"reasoning\": \"Patel et al. (2015) supports the aminonitrile-precursor framework, but the supplied review does not establish rapid, productive double hydrolysis under ambient surface conditions. Heated acidic processing is a chemically motivated departure and remains unvalidated for the stated regime. Correct nitrogen conservation requires two ammonia products. Partial amide accumulation, lactam formation including pyroglutamate, and substrate decomposition must be measured; additional entry sequences do not remove this shared bottleneck for P9 and P10.\"\n    }\n  ],\n  \"pathways\": [\n    {\n      \"pathway_id\": \"P1\",\n      \"name\": \"Iron-promoted C3+C2 assembly with hydroxylamine completion\",\n      \"description\": \"Pyruvate and glyoxylate form the C5 skeleton, followed by dehydration, explicit sacrificial-iron reduction, oxime formation and oxime reduction. This is the closest sequence to the Muchowska framework, but its proposed isolated alkene-reduction implementation and end-to-end yield remain unvalidated.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_006\", \"rxn_007\", \"rxn_008\", \"rxn_009\"],\n      \"key_intermediates\": [\"mol_005\", \"mol_006\", \"mol_007\", \"mol_020\"]\n    },\n    {\n      \"pathway_id\": \"P2\",\n      \"name\": \"Iron-promoted C3+C2 assembly with ammonia completion\",\n      \"description\": \"Uses the same carbon assembly as P1 but substitutes candidate native-iron/ammonia reductive amination. Both selective alkene reduction and terminal ammonia amination require validation; this route is not evidence that FeS can activate H2.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_006\", \"rxn_007\", \"rxn_010\"],\n      \"key_intermediates\": [\"mol_005\", \"mol_006\", \"mol_007\"]\n    },\n    {\n      \"pathway_id\": \"P3\",\n      \"name\": \"Oxaloacetate decarboxylation entry with hydroxylamine completion\",\n      \"description\": \"Oxaloacetate first supplies pyruvate, which is captured by separately supplied glyoxylate. The downstream hydroxylamine sequence is shared with P1. Oxaloacetate supply and pyruvate capture efficiency are additional boundary and flux constraints.\",\n      \"reaction_sequence\": [\"rxn_003\", \"rxn_001\", \"rxn_006\", \"rxn_007\", \"rxn_008\", \"rxn_009\"],\n      \"key_intermediates\": [\"mol_001\", \"mol_005\", \"mol_007\", \"mol_020\"]\n    },\n    {\n      \"pathway_id\": \"P4\",\n      \"name\": \"Oxaloacetate decarboxylation entry with ammonia completion\",\n      \"description\": \"Combines oxaloacetate-derived pyruvate with the candidate native-iron/ammonia endpoint. It shares the carbon-reduction uncertainty of P3 and the terminal-step uncertainty of P2.\",\n      \"reaction_sequence\": [\"rxn_003\", \"rxn_001\", \"rxn_006\", \"rxn_007\", \"rxn_010\"],\n      \"key_intermediates\": [\"mol_001\", \"mol_005\", \"mol_007\"]\n    },\n    {\n      \"pathway_id\": \"P5\",\n      \"name\": \"Oxalomalate carbon-capture entry with hydroxylamine completion\",\n      \"description\": \"Oxaloacetate captures glyoxylate before decarboxylation, creating oxalomalate and then the C5 hydroxy keto acid. This is chemically distinct from decarboxylating oxaloacetate first. Productive aldol capture and survival through subsequent processing are unproven at the proposed conditions.\",\n      \"reaction_sequence\": [\"rxn_004\", \"rxn_005\", \"rxn_006\", \"rxn_007\", \"rxn_008\", \"rxn_009\"],\n      \"key_intermediates\": [\"mol_004\", \"mol_005\", \"mol_007\", \"mol_020\"]\n    },\n    {\n      \"pathway_id\": \"P6\",\n      \"name\": \"Oxalomalate carbon-capture entry with ammonia completion\",\n      \"description\": \"Uses the C6 aldol/decarboxylation entry and candidate native-iron/ammonia reductive amination. The entry competition, selective carbon reduction and terminal amination are separate unresolved requirements, not uncertainties that cancel each other.\",\n      \"reaction_sequence\": [\"rxn_004\", \"rxn_005\", \"rxn_006\", \"rxn_007\", \"rxn_010\"],\n      \"key_intermediates\": [\"mol_004\", \"mol_005\", \"mol_007\"]\n    },\n    {\n      \"pathway_id\": \"P7\",\n      \"name\": \"General-base aldol entry with hydroxylamine completion\",\n      \"description\": \"Forms the initial C5 skeleton without an added iron catalyst, then uses the shared iron-mediated downstream sequence. Local acidification and access to dissolved Fe2+ and native iron are required between stages; the network does not assume a single compatible reaction mixture.\",\n      \"reaction_sequence\": [\"rxn_002\", \"rxn_006\", \"rxn_007\", \"rxn_008\", \"rxn_009\"],\n      \"key_intermediates\": [\"mol_005\", \"mol_006\", \"mol_007\", \"mol_020\"]\n    },\n    {\n      \"pathway_id\": \"P8\",\n      \"name\": \"General-base aldol entry with ammonia completion\",\n      \"description\": \"Combines a non-iron initial aldol regime with candidate native-iron/ammonia reductive amination. This is a catalyst-regime sequence variant, not a separately demonstrated synthesis family, and retains the shared reduction bottlenecks.\",\n      \"reaction_sequence\": [\"rxn_002\", \"rxn_006\", \"rxn_007\", \"rxn_010\"],\n      \"key_intermediates\": [\"mol_005\", \"mol_006\", \"mol_007\"]\n    },\n    {\n      \"pathway_id\": \"P9\",\n      \"name\": \"Cyanohydrin-first aminodinitrile route\",\n      \"description\": \"Declared 4-oxobutanenitrile feedstock captures HCN, undergoes cyanohydrin-mediated Strecker equilibration and then enters a separate heated acidic hydrolysis stage. No selective acrolein cyanation is assumed. Precursor availability, HCN retention and productive double hydrolysis remain unresolved.\",\n      \"reaction_sequence\": [\"rxn_011\", \"rxn_012\", \"rxn_014\"],\n      \"key_intermediates\": [\"mol_017\", \"mol_018\"]\n    },\n    {\n      \"pathway_id\": \"P10\",\n      \"name\": \"Imine-first aminodinitrile route\",\n      \"description\": \"The same declared C4 aldehyde feedstock undergoes direct imine-first Strecker capture without requiring accumulation of the cyanohydrin. This operational sequence differs from P9 but shares its hydrolysis bottleneck and does not provide independent evidence for complete glutamate production.\",\n      \"reaction_sequence\": [\"rxn_013\", \"rxn_014\"],\n      \"key_intermediates\": [\"mol_018\"]\n    }\n  ],\n  \"hub_molecules\": [\n    \"mol_001\",\n    \"mol_002\",\n    \"mol_003\",\n    \"mol_005\",\n    \"mol_007\",\n    \"mol_009\",\n    \"mol_010\",\n    \"mol_011\",\n    \"mol_012\",\n    \"mol_013\",\n    \"mol_015\",\n    \"mol_016\",\n    \"mol_018\",\n    \"mol_019\"\n  ],\n  \"convergence_points\": [\n    {\n      \"molecule_id\": \"mol_001\",\n      \"incoming_reactions\": [\"rxn_003\"],\n      \"outgoing_reactions\": [\"rxn_001\", \"rxn_002\"]\n    },\n    {\n      \"molecule_id\": \"mol_005\",\n      \"incoming_reactions\": [\"rxn_001\", \"rxn_002\", \"rxn_005\"],\n      \"outgoing_reactions\": [\"rxn_006\"]\n    },\n    {\n      \"molecule_id\": \"mol_007\",\n      \"incoming_reactions\": [\"rxn_007\"],\n      \"outgoing_reactions\": [\"rxn_008\", \"rxn_010\"]\n    },\n    {\n      \"molecule_id\": \"mol_009\",\n      \"incoming_reactions\": [\"rxn_014\"],\n      \"outgoing_reactions\": [\"rxn_010\", \"rxn_012\", \"rxn_013\"]\n    },\n    {\n      \"molecule_id\": \"mol_018\",\n      \"incoming_reactions\": [\"rxn_012\", \"rxn_013\"],\n      \"outgoing_reactions\": [\"rxn_014\"]\n    },\n    {\n      \"molecule_id\": \"mol_019\",\n      \"incoming_reactions\": [\"rxn_009\", \"rxn_010\", \"rxn_014\"],\n      \"outgoing_reactions\": []\n    }\n  ]\n}", "parsed_response": {"target_molecule": "Glutamate, racemic, represented by neutral glutamic acid", "overall_strategy": "Construct a connected, anoxic network with ten distinct reaction-sequence variants, not ten independently demonstrated synthesis families. Eight sequences combine four carbon-skeleton entry routes with either hydroxylamine-mediated or ammonia-mediated reductive amination; two sequences use aminodinitrile chemistry. The declared carbon-feedstock boundary consists of glyoxylate, pyruvate, oxaloacetate and 4-oxobutanenitrile. Their complete synthesis from inorganic carbon is not claimed. All transformations are assigned to surface geothermal aqueous microenvironments, allowing the reported 343 K iron chemistry without requiring unsupported ocean-to-vent transport. Different pH stages are not assumed to operate simultaneously. Native iron is explicitly consumed wherever it supplies electrons; neither FeS-mediated H2 activation nor selective acrolein cyanation is assumed. Neutral acid/base reference forms are used for molecular bookkeeping; actual aqueous protonation depends on pH. Numerical ranges identified as proposed are screening conditions, not literature-validated protocols or yields. The supplied research does not establish ten end-to-end syntheses: selective carbon-skeleton reduction, the proposed Fe0/ammonia implementation, precursor availability and productive dinitrile hydrolysis remain consequential uncertainties. No enantioenrichment is claimed.", "molecules": [{"id": "mol_001", "formula": "C3H4O3", "iupac_name": "2-oxopropanoic acid", "common_name": "Pyruvic acid", "inchi": "InChI=1S/C3H4O3/c1-2(4)3(5)6/h1H3,(H,5,6)", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_002", "formula": "C2H2O3", "iupac_name": "2-oxoacetic acid", "common_name": "Glyoxylic acid", "inchi": "InChI=1S/C2H2O3/c3-1-2(4)5/h1H,(H,4,5)", "role": "starting", "environment_formed": null}, {"id": "mol_003", "formula": "C4H4O5", "iupac_name": "2-oxobutanedioic acid", "common_name": "Oxaloacetic acid", "inchi": "InChI=1S/C4H4O5/c5-2(4(8)9)1-3(6)7/h1H2,(H,6,7)(H,8,9)", "role": "starting", "environment_formed": null}, {"id": "mol_004", "formula": "C6H6O8", "iupac_name": "3-carboxy-2-hydroxy-4-oxopentanedioic acid", "common_name": "Oxalomalic acid", "inchi": "InChI=1S/C6H6O8/c7-2(5(11)12)1(4(9)10)3(8)6(13)14/h1-2,7H,(H,9,10)(H,11,12)(H,13,14)", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_005", "formula": "C5H6O6", "iupac_name": "2-hydroxy-4-oxopentanedioic acid", "common_name": "4-Hydroxy-2-oxoglutaric acid", "inchi": "InChI=1S/C5H6O6/c6-2(4(8)9)1-3(7)5(10)11/h2,6H,1H2,(H,8,9)(H,10,11)", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_006", "formula": "C5H4O5", "iupac_name": "4-oxopent-2-enedioic acid", "common_name": "Unsaturated oxoglutaric acid", "inchi": "InChI=1S/C5H4O5/c6-3(5(9)10)1-2-4(7)8/h1-2H,(H,7,8)(H,9,10)", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_007", "formula": "C5H6O5", "iupac_name": "2-oxopentanedioic acid", "common_name": "2-Oxoglutaric acid", "inchi": "InChI=1S/C5H6O5/c6-3(5(9)10)1-2-4(7)8/h1-2H2,(H,7,8)(H,9,10)", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_008", "formula": "H3NO", "iupac_name": "Hydroxylamine", "common_name": "Hydroxylamine", "inchi": "InChI=1S/H3NO/c1-2/h2H,1H2", "role": "starting", "environment_formed": null}, {"id": "mol_009", "formula": "H3N", "iupac_name": "Ammonia", "common_name": "Ammonia", "inchi": "InChI=1S/H3N/h1H3", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_010", "formula": "Fe", "iupac_name": "Iron", "common_name": "Native iron", "inchi": "InChI=1S/Fe", "role": "starting", "environment_formed": null}, {"id": "mol_011", "formula": "H+", "iupac_name": "Hydrogen(1+)", "common_name": "Aqueous proton", "inchi": "InChI=1S/p+1", "role": "starting", "environment_formed": null}, {"id": "mol_012", "formula": "Fe+2", "iupac_name": "Iron(2+)", "common_name": "Ferrous ion", "inchi": "InChI=1S/Fe/q+2", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_013", "formula": "H2O", "iupac_name": "Water", "common_name": "Water", "inchi": "InChI=1S/H2O/h1H2", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_014", "formula": "CO2", "iupac_name": "Carbon dioxide", "common_name": "Carbon dioxide", "inchi": "InChI=1S/CO2/c2-1-3", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_015", "formula": "C4H5NO", "iupac_name": "4-oxobutanenitrile", "common_name": "3-Cyanopropanal", "inchi": null, "role": "starting", "environment_formed": null}, {"id": "mol_016", "formula": "CHN", "iupac_name": "Hydrogen cyanide", "common_name": "Hydrogen cyanide", "inchi": "InChI=1S/CHN/c1-2/h1H", "role": "starting", "environment_formed": null}, {"id": "mol_017", "formula": "C5H6N2O", "iupac_name": "2-hydroxypentanedinitrile", "common_name": "Glutamate-precursor cyanohydrin", "inchi": "InChI=1S/C5H6N2O/c6-3-1-2-5(8)4-7/h5,8H,1-2H2", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_018", "formula": "C5H7N3", "iupac_name": "2-aminopentanedinitrile", "common_name": "Glutamate-precursor aminodinitrile", "inchi": "InChI=1S/C5H7N3/c6-3-1-2-5(8)4-7/h5H,1-2,8H2", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_019", "formula": "C5H9NO4", "iupac_name": "2-aminopentanedioic acid", "common_name": "Glutamic acid; racemic glutamate reference form", "inchi": "InChI=1S/C5H9NO4/c6-3(5(9)10)1-2-4(7)8/h3H,1-2,6H2,(H,7,8)(H,9,10)", "role": "target", "environment_formed": "Surface"}, {"id": "mol_020", "formula": "C5H7NO5", "iupac_name": "2-(hydroxyimino)pentanedioic acid", "common_name": "2-Oxoglutarate oxime", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}], "reactions": [{"id": "rxn_001", "name": "Ferrous-ion-promoted pyruvate-glyoxylate aldol addition", "inputs": ["mol_001", "mol_002"], "outputs": ["mol_005"], "environment": "Surface", "agents": ["Dissolved Fe2+ as a Lewis-acid promoter"], "conditions": {"temperature": "343 K", "pressure": "Approximately 1 atm", "catalyst": "Fe2+", "aqueous": true, "other": "Anoxic, UV-shielded geothermal water. Proposed screening conditions: pH 4.5-6.5, 10-100 mM organic substrates, 1-10 mM dissolved Fe2+, and 1-24 h residence. These concentration, pH and residence ranges are not asserted to reproduce the cited protocol. Avoid sulfide-rich water that removes dissolved Fe2+."}, "mechanism": "The pyruvate enol or enolate attacks the glyoxylate aldehyde carbon, creating the C5 skeleton. Fe2+ coordination can facilitate carbonyl activation and enolization. Balanced net equation: pyruvic acid + glyoxylic acid -> 4-hydroxy-2-oxoglutaric acid. This is aldol addition, without net water loss.", "reasoning": "The reaction family and 343 K iron-promoted setting are supported by Muchowska et al. (2019), with related aldol chemistry in Springsteen et al. (2018). Surface geothermal water accommodates the reported temperature without extrapolation to a hotter vent. Productive accumulation must compete with retro-aldol chemistry and other carbonyl reactions; the supplied review gives no isolated yield for the proposed operating window."}, {"id": "rxn_002", "name": "General-base pyruvate-glyoxylate aldol addition", "inputs": ["mol_001", "mol_002"], "outputs": ["mol_005"], "environment": "Surface", "agents": ["Hydroxide-mediated general-base catalysis"], "conditions": {"temperature": "296-313 K", "pressure": "Approximately 1 atm", "catalyst": "General base", "aqueous": true, "other": "Anoxic, shaded alkaline pool or tidal microenvironment. Proposed screening conditions: pH 8.5-10, 10-100 mM organic substrates, and 1-7 days. No added transition-metal catalyst. Subsequent iron-mediated processing requires a separate, less alkaline stage."}, "mechanism": "Base-assisted pyruvate enolization followed by addition to glyoxylate gives the same C5 beta-hydroxy keto acid as rxn_001. Balanced net equation: pyruvic acid + glyoxylic acid -> 4-hydroxy-2-oxoglutaric acid.", "reasoning": "Springsteen et al. (2018) supports non-iron aldol chemistry within glyoxylate reaction networks. This is a catalyst and operating-regime alternative, not an independent biosynthetic family. The proposed pH and residence window requires experimental confirmation; glyoxylate side reactions and the subsequent change in solution conditions can reduce end-to-end yield."}, {"id": "rxn_003", "name": "Oxaloacetate decarboxylation supplying pyruvate", "inputs": ["mol_003"], "outputs": ["mol_001", "mol_014"], "environment": "Surface", "agents": ["Dissolved Fe2+ as a keto-acid coordination promoter"], "conditions": {"temperature": "323-343 K", "pressure": "Approximately 1 atm", "catalyst": "Fe2+", "aqueous": true, "other": "Anoxic, UV-shielded geothermal water. Proposed screening conditions: pH 4.5-6.5, 1-10 mM Fe2+, and 0.25-6 h residence. Supply oxaloacetate incrementally rather than assuming long-term storage of a concentrated stable pool."}, "mechanism": "Beta-keto-acid decarboxylation releases CO2 and gives a pyruvate enol that tautomerizes to pyruvate. Balanced net equation: oxaloacetic acid -> pyruvic acid + CO2.", "reasoning": "Oxaloacetate-to-pyruvate conversion is supported by the iron-promoted network described by Muchowska et al. (2019) and by established beta-keto-acid chemistry. Fe2+ can promote the reaction but is not its electron source. This entry avoids an unspecified CO2-fixation implementation, while leaving oxaloacetate availability as an explicit feedstock-boundary limitation."}, {"id": "rxn_004", "name": "Oxaloacetate-glyoxylate aldol capture", "inputs": ["mol_003", "mol_002"], "outputs": ["mol_004"], "environment": "Surface", "agents": ["General-base catalysis in mildly alkaline water"], "conditions": {"temperature": "296-303 K", "pressure": "Approximately 1 atm", "catalyst": "General base", "aqueous": true, "other": "Anoxic, shaded aqueous microenvironment. Proposed screening conditions: pH 7.5-9, 10-100 mM organic substrates, glyoxylate in excess, and 0.25-3 h initial observation. Lower temperature is chosen to limit premature oxaloacetate decarboxylation."}, "mechanism": "The enolizable methylene of oxaloacetate adds to glyoxylate, producing the C6 tricarboxylic beta-hydroxy keto acid. Balanced net equation: oxaloacetic acid + glyoxylic acid -> oxalomalic acid.", "reasoning": "This precursor construction is chemically consistent with the oxalomalate branch discussed in Springsteen et al. (2018). The supplied review does not document a selective yield for this exact proposed implementation, so the entry remains provisional. Aldol capture must outcompete oxaloacetate decarboxylation, and detection of downstream products alone would not establish the flux through this intermediate."}, {"id": "rxn_005", "name": "Nonoxidative oxalomalate decarboxylation", "inputs": ["mol_004"], "outputs": ["mol_005", "mol_014"], "environment": "Surface", "agents": null, "conditions": {"temperature": "296-303 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Anoxic, UV-shielded aqueous solution. The supplied review associates the ambient-temperature conversion with approximately 3 h. Proposed pH screening: 6-8. No O2, peroxide or other oxidant is required by this net transformation."}, "mechanism": "Loss of the beta-keto-acid carboxyl group followed by proton transfer produces the C5 hydroxy keto acid. Balanced net equation: oxalomalic acid -> 4-hydroxy-2-oxoglutaric acid + CO2.", "reasoning": "Springsteen et al. (2018) supports this connection between oxalomalate and the C5 intermediate. The supplied equation describes nonoxidative decarboxylation, despite the review calling it oxidative. Distinguishing this step from other oxidative reactions in the larger glyoxylate cycles avoids introducing an unjustified oxidant."}, {"id": "rxn_006", "name": "Hydroxy-oxoglutarate dehydration", "inputs": ["mol_005"], "outputs": ["mol_006", "mol_013"], "environment": "Surface", "agents": ["Dissolved Fe2+ for carbonyl and hydroxyl coordination"], "conditions": {"temperature": "343 K", "pressure": "Approximately 1 atm", "catalyst": "Fe2+", "aqueous": true, "other": "Anoxic, UV-shielded geothermal solution. Proposed screening conditions: pH 4.5-6.5, 1-10 mM Fe2+, and 1-24 h. Aqueous dehydration is reversible; evaporation to dryness is not assumed necessary or beneficial."}, "mechanism": "Elimination of the hydroxyl group and an adjacent hydrogen forms the conjugated alkene. Balanced net equation: 4-hydroxy-2-oxoglutaric acid -> 4-oxopent-2-enedioic acid + H2O. Alkene geometry is left unspecified.", "reasoning": "The supplied account of Muchowska et al. (2019) supports dehydration within the iron-promoted C5 sequence. It does not establish quantitative accumulation of an isolated alkene stereoisomer. Rehydration, retro-aldol cleavage and keto-acid degradation remain competing processes, so this node is not treated as an irreversible quantitative conversion."}, {"id": "rxn_007", "name": "Sacrificial-iron reduction of the unsaturated C5 keto acid", "inputs": ["mol_006", "mol_010", "mol_011"], "outputs": ["mol_007", "mol_012"], "environment": "Surface", "agents": ["Fresh native-iron surface, consumed as the reductant"], "conditions": {"temperature": "323-343 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Proposed implementation: anoxic, UV-shielded, sulfide-poor water at pH 4.5-6.5. Minimum redox demand is one mole of Fe0 per mole of alkene reduced. An initial 0.25-6 h contact-time screen should distinguish useful conversion from carbonyl reduction and decomposition. Fresh surface availability and passivation must be measured."}, "mechanism": "Two-electron reduction and protonation saturate the conjugated C=C bond while ideally retaining the keto group. Balanced net equation: C5H4O5 + Fe + 2 H+ -> C5H6O5 + Fe2+. Fe0 is a reagent, not an indefinitely regenerating catalyst.", "reasoning": "Speculative isolated-step implementation. Muchowska et al. (2019) supports iron-promoted formation of metabolic precursors, but the supplied review does not establish selective reduction of this isolated substrate by the stated Fe0 system. Explicit Fe consumption repairs electron bookkeeping without proving selectivity. This remains a shared bottleneck for P1-P8: carbonyl reduction, corrosion and decarboxylation must be quantified before any of those complete routes can be called established."}, {"id": "rxn_008", "name": "2-Oxoglutarate oxime formation", "inputs": ["mol_007", "mol_008"], "outputs": ["mol_020", "mol_013"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-343 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Anoxic, UV-shielded solution. Proposed screening conditions: pH 4.5-6.5, 10-100 mM keto acid, approximately equimolar or modestly excess hydroxylamine, and 0.25-6 h before iron reduction. Avoid prolonged hot storage of unreacted 2-oxoglutarate."}, "mechanism": "Hydroxylamine adds to the keto carbonyl; carbinolamine dehydration gives an oxime. Balanced net equation: C5H6O5 + H3NO -> C5H7NO5 + H2O. This is oxime formation, not transamination.", "reasoning": "Muchowska et al. (2019) supports the overall hydroxylamine/iron conversion of keto acids to amino acids. Resolving it into oxime formation and reduction makes the required intermediate and electron demand explicit. The review does not provide an isolated oxime yield or E/Z distribution, and prebiotic hydroxylamine supply remains unresolved."}, {"id": "rxn_009", "name": "Iron-driven oxime reduction to racemic glutamate", "inputs": ["mol_020", "mol_010", "mol_011"], "outputs": ["mol_019", "mol_013", "mol_012"], "environment": "Surface", "agents": ["Native iron as a sacrificial four-electron reductant"], "conditions": {"temperature": "343 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Anoxic, UV-shielded geothermal water. Proposed pH 4.5-6.5 and 1-24 h screening window. The minimum stoichiometric demand is two moles of Fe0 per mole of oxime; corrosion can increase practical consumption. Sulfide exclusion and replenishment of reactive metal surfaces are implementation requirements."}, "mechanism": "Reduction of the C=N functionality and N-O bond cleavage gives the alpha-amino acid. Balanced net equation: C5H7NO5 + 2 Fe + 4 H+ -> C5H9NO4 + H2O + 2 Fe2+. Combining rxn_008 and rxn_009 produces two waters per glutamate.", "reasoning": "The combined oxime-forming and reducing sequence corresponds to the hydroxylamine/iron chemistry reported by Muchowska et al. (2019). Explicit stoichiometry includes both Fe atoms and all four protons required for four-electron reduction. The proposed staging is not a separately validated protocol, and no isolated yield is supplied here. Achiral reagents and surfaces do not justify an L-selective product."}, {"id": "rxn_010", "name": "Candidate native-iron-driven ammonia reductive amination", "inputs": ["mol_007", "mol_009", "mol_010", "mol_011"], "outputs": ["mol_019", "mol_013", "mol_012"], "environment": "Surface", "agents": ["Native iron as a sacrificial reductant and reactive interface"], "conditions": {"temperature": "343-363 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Speculative operating window: anoxic, UV-shielded, sulfide-poor water; pH 7.5-8.5; total NH3/NH4+ 0.05-0.5 M in a locally concentrated pool; 1-24 h initial screen. At least one mole of Fe0 is required per mole of glutamate. Ammonia speciation, iron passivation and keto-acid loss must be measured together."}, "mechanism": "Ammonia addition and dehydration generate an imine or iminium species, followed by two-electron reduction at the iron interface. Balanced net equation: C5H6O5 + NH3 + Fe + 2 H+ -> C5H9NO4 + H2O + Fe2+. The proton demand is formal acid/base bookkeeping at the operating pH.", "reasoning": "Speculative replacement for the insufficiently specified FeS/H2 implementation. Kitadai et al. (2019) provides literature context for metal-enabled protometabolic reductive chemistry, but the supplied summary does not validate this precise Fe0/ammonia protocol. Consuming native iron supplies explicit electrons without assuming FeS activates H2. That correction does not demonstrate productive imine reduction; P2, P4, P6 and P8 therefore retain an additional terminal-step uncertainty."}, {"id": "rxn_011", "name": "Cyanohydrin capture of 4-oxobutanenitrile", "inputs": ["mol_015", "mol_016"], "outputs": ["mol_017"], "environment": "Surface", "agents": null, "conditions": {"temperature": "298-313 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Anoxic, shaded pool or sediment porewater. Proposed screening conditions: pH 7-8.5, 10-100 mM aldehyde and available cyanide, and 0.25-24 h. The C4 aldehyde is a declared feedstock; its generation by selective acrolein conjugate cyanation is not assumed. HCN loss must be included in any material balance."}, "mechanism": "Cyanide adds to the aldehyde carbonyl and protonation produces the cyanohydrin. Balanced net equation: C4H5NO + HCN -> C5H6N2O.", "reasoning": "Patel et al. (2015) supports the relevance of cyanosulfidic cyanohydrin and aminonitrile chemistry. This particular entry is a conventional but provisional implementation from an explicitly supplied aldehyde; the review does not establish its selective preparation or delivery. Moving that precursor to the feedstock boundary avoids presenting uncertain acrolein regioselectivity as demonstrated chemistry, but does not resolve precursor availability."}, {"id": "rxn_012", "name": "Cyanohydrin-mediated Strecker equilibration", "inputs": ["mol_017", "mol_009"], "outputs": ["mol_018", "mol_013"], "environment": "Surface", "agents": null, "conditions": {"temperature": "298-313 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Anoxic, UV-shielded aqueous stage. Proposed screening conditions: pH 8-9, total ammonia/ammonium 0.05-0.5 M, and 1-48 h. Maintain an available cyanide pool through cyanohydrin equilibration and limit HCN escape. Hydrolysis is deferred to a separate acidic heating stage."}, "mechanism": "Reversible cyanohydrin dissociation exposes the aldehyde. Ammonia forms a carbinolamine and imine; cyanide addition then gives the aminodinitrile. Balanced net equation: C5H6N2O + NH3 -> C5H7N3 + H2O. This is not direct displacement of an unactivated hydroxyl group.", "reasoning": "The supplied account of Patel et al. (2015) supports this precursor relationship. A Strecker-equilibration mechanism is more defensible than the review's simple hydroxyl-substitution description. The exact C5 substrate distribution, ammonia requirement and competing decomposition rates are not established by the supplied summary."}, {"id": "rxn_013", "name": "Imine-first Strecker formation of the aminodinitrile", "inputs": ["mol_015", "mol_009", "mol_016"], "outputs": ["mol_018", "mol_013"], "environment": "Surface", "agents": null, "conditions": {"temperature": "298-313 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Anoxic, shaded aqueous stage. Proposed screening conditions: pH 8-9, 10-100 mM aldehyde, total ammonia/ammonium 0.05-0.5 M, and 1-48 h. Ammonia exposure precedes substantial cyanide addition to favor an imine-first operating sequence; an isolated cyanohydrin pool is not required."}, "mechanism": "The aldehyde condenses with ammonia; cyanide addition to the imine/iminium carbon installs the second nitrile and the alpha-amino group. Balanced net equation: C4H5NO + NH3 + HCN -> C5H7N3 + H2O.", "reasoning": "Speculative substrate-specific implementation of conventional Strecker chemistry. Patel et al. (2015) supplies the relevant cyanosulfidic precursor framework, but the supplied review does not establish this exact imine-first protocol. This is an operational alternative to rxn_011 followed by rxn_012, not an additional independently validated synthesis family."}, {"id": "rxn_014", "name": "Staged acid-catalyzed double-nitrile hydrolysis", "inputs": ["mol_018", "mol_013"], "outputs": ["mol_019", "mol_009"], "environment": "Surface", "agents": ["Aqueous acid as a hydrolysis catalyst"], "conditions": {"temperature": "363-370 K", "pressure": "Approximately 1 atm", "catalyst": "Hydronium", "aqueous": true, "other": "Proposed validation regime, not a reported successful protocol: anoxic, UV-shielded, volcanic-HCl-acidified geothermal water at pH 1-2; 7-30 days with continued liquid-water availability. Transfer from the alkaline Strecker stage must be local and must limit dilution. At this pH the released ammonia is predominantly NH4+, and amino-acid protonation differs from the neutral reference formula."}, "mechanism": "Both nitriles undergo hydration to amide intermediates and subsequent hydrolysis to carboxylic acids. This node lumps the sequential hydrolyses rather than asserting a single elementary event. Balanced neutral-reference equation: C5H7N3 + 4 H2O -> C5H9NO4 + 2 NH3.", "reasoning": "Patel et al. (2015) supports the aminonitrile-precursor framework, but the supplied review does not establish rapid, productive double hydrolysis under ambient surface conditions. Heated acidic processing is a chemically motivated departure and remains unvalidated for the stated regime. Correct nitrogen conservation requires two ammonia products. Partial amide accumulation, lactam formation including pyroglutamate, and substrate decomposition must be measured; additional entry sequences do not remove this shared bottleneck for P9 and P10."}], "pathways": [{"pathway_id": "P1", "name": "Iron-promoted C3+C2 assembly with hydroxylamine completion", "description": "Pyruvate and glyoxylate form the C5 skeleton, followed by dehydration, explicit sacrificial-iron reduction, oxime formation and oxime reduction. This is the closest sequence to the Muchowska framework, but its proposed isolated alkene-reduction implementation and end-to-end yield remain unvalidated.", "reaction_sequence": ["rxn_001", "rxn_006", "rxn_007", "rxn_008", "rxn_009"], "key_intermediates": ["mol_005", "mol_006", "mol_007", "mol_020"]}, {"pathway_id": "P2", "name": "Iron-promoted C3+C2 assembly with ammonia completion", "description": "Uses the same carbon assembly as P1 but substitutes candidate native-iron/ammonia reductive amination. Both selective alkene reduction and terminal ammonia amination require validation; this route is not evidence that FeS can activate H2.", "reaction_sequence": ["rxn_001", "rxn_006", "rxn_007", "rxn_010"], "key_intermediates": ["mol_005", "mol_006", "mol_007"]}, {"pathway_id": "P3", "name": "Oxaloacetate decarboxylation entry with hydroxylamine completion", "description": "Oxaloacetate first supplies pyruvate, which is captured by separately supplied glyoxylate. The downstream hydroxylamine sequence is shared with P1. Oxaloacetate supply and pyruvate capture efficiency are additional boundary and flux constraints.", "reaction_sequence": ["rxn_003", "rxn_001", "rxn_006", "rxn_007", "rxn_008", "rxn_009"], "key_intermediates": ["mol_001", "mol_005", "mol_007", "mol_020"]}, {"pathway_id": "P4", "name": "Oxaloacetate decarboxylation entry with ammonia completion", "description": "Combines oxaloacetate-derived pyruvate with the candidate native-iron/ammonia endpoint. It shares the carbon-reduction uncertainty of P3 and the terminal-step uncertainty of P2.", "reaction_sequence": ["rxn_003", "rxn_001", "rxn_006", "rxn_007", "rxn_010"], "key_intermediates": ["mol_001", "mol_005", "mol_007"]}, {"pathway_id": "P5", "name": "Oxalomalate carbon-capture entry with hydroxylamine completion", "description": "Oxaloacetate captures glyoxylate before decarboxylation, creating oxalomalate and then the C5 hydroxy keto acid. This is chemically distinct from decarboxylating oxaloacetate first. Productive aldol capture and survival through subsequent processing are unproven at the proposed conditions.", "reaction_sequence": ["rxn_004", "rxn_005", "rxn_006", "rxn_007", "rxn_008", "rxn_009"], "key_intermediates": ["mol_004", "mol_005", "mol_007", "mol_020"]}, {"pathway_id": "P6", "name": "Oxalomalate carbon-capture entry with ammonia completion", "description": "Uses the C6 aldol/decarboxylation entry and candidate native-iron/ammonia reductive amination. The entry competition, selective carbon reduction and terminal amination are separate unresolved requirements, not uncertainties that cancel each other.", "reaction_sequence": ["rxn_004", "rxn_005", "rxn_006", "rxn_007", "rxn_010"], "key_intermediates": ["mol_004", "mol_005", "mol_007"]}, {"pathway_id": "P7", "name": "General-base aldol entry with hydroxylamine completion", "description": "Forms the initial C5 skeleton without an add