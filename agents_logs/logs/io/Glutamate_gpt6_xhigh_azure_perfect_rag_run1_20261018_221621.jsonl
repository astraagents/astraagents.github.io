he number of pathway variants."}], "pathways": [{"pathway_id": "P1", "name": "Supplied pyruvate and glyoxylate through iron-promoted aldol chemistry", "description": "The shortest principal candidate from declared C3 and C2 organic inlets. It uses the best-supported carbon-assembly family and hydroxylamine completion, but remains conditional on selective rxn_009 reduction and measured full-sequence recovery.", "reaction_sequence": ["rxn_004", "rxn_008", "rxn_009", "rxn_010", "rxn_011"], "key_intermediates": ["mol_009", "mol_011", "mol_012", "mol_014"]}, {"pathway_id": "P2", "name": "Inorganic-carbon-derived pyruvate with iron-promoted aldol capture", "description": "Hydrothermal CO2/H2 chemistry supplies the C3 partner; glyoxylate is a declared external inlet. Cooling, discharge, pyruvate recovery and compatible concentrations must be demonstrated before this branch can be considered productive.", "reaction_sequence": ["rxn_001", "rxn_004", "rxn_008", "rxn_009", "rxn_010", "rxn_011"], "key_intermediates": ["mol_004", "mol_009", "mol_012", "mol_014"]}, {"pathway_id": "P3", "name": "Oxaloacetate decarboxylation followed by iron-promoted aldol capture", "description": "Oxaloacetate first supplies pyruvate; subsequently added glyoxylate supplies the C2 partner. Staging distinguishes this route from direct oxaloacetate capture in P9.", "reaction_sequence": ["rxn_002", "rxn_004", "rxn_008", "rxn_009", "rxn_010", "rxn_011"], "key_intermediates": ["mol_004", "mol_009", "mol_012", "mol_014"]}, {"pathway_id": "P4", "name": "Isocitrate-derived glyoxylate with iron-promoted aldol capture", "description": "Isocitrate cleavage supplies glyoxylate and explicitly releases succinate. Pyruvate is the external C3 inlet. This avoids assuming that glyoxylate must originate from a particular photochemical framework.", "reaction_sequence": ["rxn_003", "rxn_004", "rxn_008", "rxn_009", "rxn_010", "rxn_011"], "key_intermediates": ["mol_005", "mol_009", "mol_012", "mol_014"]}, {"pathway_id": 