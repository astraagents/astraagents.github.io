y_intermediates": ["mol_008", "mol_010", "mol_011"]}, {"pathway_id": "P8", "name": "Thiophosphate in situ serine-aminonitrile branch without added ammonia", "description": "Glycolonitrile, HCN and thiophosphate feed the experimentally observed approximately 16% serine-nitrile branch. The nitrogen source does not require external ammonia. Free serine remains conditional on the subsequent amide-resolved hydrolysis and preservation stages.", "reaction_sequence": ["rxn_001", "rxn_010", "rxn_011", "rxn_012"], "key_intermediates": ["mol_008", "mol_010", "mol_011"]}, {"pathway_id": "P9", "name": "Classical glycine precursor synthesis followed by hydroxymethylation", "description": "Formaldehyde, ammonia and HCN first build glycine aminonitrile. Hydrolysis through glycinamide supplies glycine, which receives a further formaldehyde-derived carbon to produce serine. This uses the experimentally supported non-Strecker serine-forming step, but upstream mild hydrolysis and competing glycine transamination limit the complete route.", "reaction_sequence": ["rxn_013", "rxn_014", "rxn_015", "rxn_016"], "key_intermediates": ["mol_019", "mol_020", "mol_021"]}, {"pathway_id": "P10", "name": "Proposed photochemical glycine-precursor entry followed by hydroxymethylation", "description": "HCN photoreduction and cyanide capture are proposed to provide glycine aminonitrile without an externally supplied ammonia reactant at that entry step. Hydrolysis supplies glycine, and separately available formaldehyde supplies the third serine carbon. The rxn_017 entry is explicitly less well supported than the other precursor-forming branches and requires direct validation before this pathway can be treated as experimentally established.", "reaction_sequence": ["rxn_017", "rxn_014", "rxn_015", "rxn_016"], "key_intermediates": ["mol_019", "mol_020", "mol_021"]}], "hub_molecules": ["mol_003", "mol_008", "mol_009", "mol_010", "mol_012", "mol_019", "mol_021"], "convergence_points": [{"molecule_id": "mol_00