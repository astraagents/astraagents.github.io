rxn_009"], "key_intermediates": ["mol_003", "mol_004", "mol_010"]}, {"pathway_id": "P4", "name": "Dihydroxyacetone-driven C6 aminonitrile pathway", "description": "Dihydroxyacetone \u2192 Acetone \u2192 Cyanohydrin \u2192 Direct C6 aminonitrile \u2192 Hydrolysis and chain shortening to L-Valine.", "reaction_sequence": ["rxn_001", "rxn_003", "rxn_008", "rxn_009"], "key_intermediates": ["mol_003", "mol_004", "mol_010"]}, {"pathway_id": "P5", "name": "Combined sugar pool convergent pathway", "description": "Both dihydroxyacetone and hydroxyacetone contribute in parallel to acetone, which then enters standard cyanosulfidic route.", "reaction_sequence": ["rxn_010", "rxn_003", "rxn_004", "rxn_005", "rxn_006", "rxn_007"], "key_intermediates": ["mol_003", "mol_004", "mol_007", "mol_008", "mol_009"]}, {"pathway_id": "P6", "name": "Speculative bypass: Direct Strecker/amination of cyanohydrin", "description": "Sugar \u2192 Acetone \u2192 Cyanohydrin \u2192 Aminonitrile (bypassing thioamide/chain extension) \u2192 Nitrile hydrolysis to L-valine.", "reaction_sequence": ["rxn_001", "rxn_003", "rxn_011", "rxn_007"], "key_intermediates": ["mol_003", "mol_004", "mol_009"]}, {"pathway_id": "P7", "name": "Hydroxyacetone direct Strecker/amination", "description": "Hydroxyacetone \u2192 Acetone \u2192 Cyanohydrin \u2192 Direct amination to aminonitrile \u2192 Nitrile hydrolysis.", "reaction_sequence": ["rxn_002", "rxn_003", "rxn_011", "rxn_007"], "key_intermediates": ["mol_003", "mol_004", "mol_009"]}, {"pathway_id": "P8", "name": "Parallel canonical with alternative acetone formation", "description": "Both sugars form acetone via rxn_010, which enters the canonical cyanosulfidic route.", "reaction_sequence": ["rxn_010", "rxn_003", "rxn_004", "rxn_005", "rxn_006", "rxn_007"], "key_intermediates": ["mol_003", "mol_004", "mol_007", "mol_008", "mol_009"]}, {"pathway_id": "P9", "name": "Short-chain bypass: Thioamide direct transformation to aminonitrile (speculative)", "description": "Sugar