nment_formed": null}, {"id": "mol_026", "formula": "C4H6N2O3", "iupac_name": "5-(hydroxymethyl)imidazolidine-2,4-dione", "common_name": "Serine hydantoin", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_027", "formula": "C4H8N2O4", "iupac_name": "2-(carbamoylamino)-3-hydroxypropanoic acid", "common_name": "N-Carbamoylserine", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}], "reactions": [{"id": "rxn_001", "name": "Cyanosulfidic photoreduction of HCN to formaldehyde", "inputs": ["mol_002", "mol_004", "mol_001"], "outputs": ["mol_006", "mol_003", "mol_005"], "environment": "Surface", "agents": ["Copper(I) cyanide complexes"], "conditions": {"temperature": "300-320 K", "pressure": "Approximately 1 atm", "catalyst": "Copper(I) cyanide complexes", "aqueous": true, "other": "Anoxic UV-irradiated water; approximately pH 7-9 as a design window; sustained cyanide and sulfide supply. Transfer carbonyl products into shaded water."}, "mechanism": "Net photochemical module: sulfide supplies reducing equivalents for nitrile reduction to a methanimine pool, followed by imine hydrolysis to formaldehyde and ammonia. Oxidized sulfur is represented by elemental sulfur.", "reasoning": "Patel et al. (2015) supports cyanosulfidic photoreductive homologation chemistry. This node summarizes multiple elementary events rather than asserting a single-step conversion. Copper complexes mediate photoredox electron transfer. S8 is an idealized terminal sulfur balance; actual sulfur speciation can include polysulfides. Formaldehyde accumulation competes with further reaction, volatilization and photodestruction."}, {"id": "rxn_002", "name": "Candidate anoxic photodehydrogenation of methanol", "inputs": ["mol_007"], "outputs": ["mol_006", "mol_008"], "environment": "Surface", "agents": ["Anatase, TiO2"], "conditions": {"temperature": "300-330 K", "pressure": "Approximately 1 atm", "catalyst": "Photoexcited anatase", "aqueous": true, "other": "Proposed UV-illuminated methanol-bearing mineral-water interface; no molecular oxygen; hydrogen escape and rapid removal of formaldehyde would favor accumulation."}, "mechanism": "Photogenerated holes oxidize methanol to formaldehyde, while electrons reduce released protons to hydrogen. The net process is methanol dehydrogenation, not oxygen-dependent oxidation.", "reasoning": "Speculative for this prebiotic setting: none of the supplied papers establishes this module. Semiconductor-driven alcohol dehydrogenation provides a chemically motivated alternative C1 supply, but efficient hydrogen evolution on unmodified natural anatase, methanol availability, and formaldehyde selectivity are unresolved. Overoxidation and electron-hole recombination may prevent useful yields."}, {"id": "rxn_003", "name": "Strecker formation of aminoacetonitrile", "inputs": ["mol_006", "mol_002", "mol_003"], "outputs": ["mol_014", "mol_001"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-330 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Concentrated, shaded, anoxic water; approximately pH 8-9; adequate ammonia and cyanide activities. Formaldehyde hydration and competing cyanohydrin formation must be considered."}, "mechanism": "Ammonia adds to formaldehyde; dehydration generates an imine or iminium population that is trapped by cyanide to form aminoacetonitrile.", "reasoning": "Patel et al. (2015) supports the aminoacetonitrile precursor branch described in the review. No mineral catalyst is required for the core Strecker chemistry. Reactant concentrations and competing aldehyde equilibria govern yield; this is not assumed to proceed quantitatively in dilute seawater."}, {"id": "rxn_004", "name": "Hydration of aminoacetonitrile to glycinamide", "inputs": ["mol_014", "mol_001"], "outputs": ["mol_015"], "environment": "Surface", "agents": ["Aqueous general-acid catalysis"], "conditions": {"temperature": "340-370 K", "pressure": "Approximately 1 atm", "catalyst": "Hydronium", "aqueous": true, "other": "Proposed acidic geothermal-water processing, approximately pH 1-3; shaded; separated from the alkaline Strecker stage. Residence time requires experimental determination."}, "mechanism": "Acid-assisted water addition to the nitrile gives an imidic intermediate that tautomerizes to glycinamide.", "reasoning": "Patel et al. (2015) supports aminoacetonitrile as an amino-acid precursor; the amide node resolves standard nitrile hydrolysis chemistry. The supplied review does not establish rapid complete hydrolysis in neutral ambient water. Acidic heating is therefore an explicit processing assumption, with competing aminonitrile decomposition a potential bottleneck."}, {"id": "rxn_005", "name": "Hydrolysis of glycinamide to glycine", "inputs": ["mol_015", "mol_001"], "outputs": ["mol_016", "mol_003"], "environment": "Surface", "agents": ["Aqueous general-acid catalysis"], "conditions": {"temperature": "350-370 K", "pressure": "Approximately 1 atm", "catalyst": "Hydronium", "aqueous": true, "other": "Approximately pH 1-3; prolonged residence may be necessary. Ammonia is predominantly ammonium during acidic processing; neutral reference formulas are used."}, "mechanism": "Water addition to the protonated amide carbonyl followed by C-N bond cleavage produces glycine and an ammonia/ammonium pool.", "reasoning": "This completes the aminoacetonitrile hydrolysis route associated with Patel et al. (2015). The elementary amide-to-acid step is standard chemistry, but its rate and yield under the proposed geothermal conditions are not supplied. It is retained explicitly because amide hydrolysis can limit environmental glycine production."}, {"id": "rxn_006", "name": "Candidate iron-driven reductive amination of glyoxylic acid with ammonia", "inputs": ["mol_009", "mol_003", "mol_011", "mol_012"], "outputs": ["mol_016", "mol_013", "mol_001"], "environment": "Surface", "agents": ["Native iron, consumed as a reductant"], "conditions": {"temperature": "323-353 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Proposed anoxic metal-water interface; mildly acidic water with substantial total ammonia. One Fe atom and two protons are required per glycine in the neutral-species net balance."}, "mechanism": "Glyoxylic acid and ammonia establish an imine equilibrium. Electron transfer from Fe0 reduces the C=N functionality to glycine while iron becomes Fe2+.", "reasoning": "Speculative extension of the iron-promoted amino-acid chemistry discussed by Muchowska et al. (2019). The supplied review specifically invokes hydroxylamine, so it does not demonstrate that ammonia can replace it efficiently. This branch tests a more geochemically widespread nitrogen donor. Imine scarcity, metal passivation, hydrogen evolution and competing carbonyl reduction may suppress glycine formation."}, {"id": "rxn_007", "name": "Oxime formation from glyoxylic acid and hydroxylamine", "inputs": ["mol_009", "mol_010"], "outputs": ["mol_017", "mol_001"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-343 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Approximately pH 4-7; anoxic concentrated solution. Glyoxylic acid hydration and oxime E/Z speciation are implicit equilibria."}, "mechanism": "Hydroxylamine attacks the aldehyde carbonyl of glyoxylic acid; dehydration produces a hydroxyimino group.", "reasoning": "Muchowska et al. (2019), as summarized in the supplied review, motivates the glyoxylate/hydroxylamine/iron module. Resolving it through an oxime is a chemically grounded mechanistic model, not a claim that this intermediate was isolated in the cited experiment. The prebiotic supply and persistence of hydroxylamine remain important boundary uncertainties."}, {"id": "rxn_008", "name": "Iron reduction of glyoxylic acid oxime to glycine", "inputs": ["mol_017", "mol_011", "mol_012"], "outputs": [