pathway_id": "P8", "name": "Supplied glycolaldehyde, cyanohydrin-first Strecker, alkaline hydrolysis", "description": "Supplied glycolaldehyde enters through the cyanohydrin reservoir and is subsequently aminated through reversible Strecker equilibria. Alkaline hydrolysis completes a wholly conditional process variant whose precursor-transfer and product-survival assumptions both require testing.", "reaction_sequence": ["rxn_004", "rxn_007", "rxn_009", "rxn_011"], "key_intermediates": ["mol_009", "mol_011", "mol_012"]}, {"pathway_id": "P9", "name": "Supplied formaldehyde, one homologation, imine-first alkaline route", "description": "Formaldehyde is homologated to glycolaldehyde before imine-first Strecker capture. The aminonitrile is hydrolyzed in a separately maintained alkaline reservoir. Photochemical transfer losses and alkaline serine survival are explicit unresolved constraints.", "reaction_sequence": ["rxn_002", "rxn_003", "rxn_005", "rxn_006", "rxn_009", "rxn_011"], "key_intermediates": ["mol_007", "mol_008", "mol_010", "mol_011", "mol_012"]}, {"pathway_id": "P10", "name": "HCN-derived carbon skeleton, cyanohydrin-first Strecker, alkaline hydrolysis", "description": "The full HCN-derived carbon-building sequence feeds cyanohydrin-first Strecker chemistry and conditional alkaline release of serine. This has the most demanding combination of staging and kinetic requirements among the listed variants and is not presented as an independently validated synthesis.", "reaction_sequence": ["rxn_001", "rxn_002", "rxn_003", "rxn_004", "rxn_007", "rxn_009", "rxn_011"], "key_intermediates": ["mol_006", "mol_007", "mol_008", "mol_009", "mol_011", "mol_012"]}], "hub_molecules": ["mol_001", "mol_002", "mol_003", "mol_004", "mol_005", "mol_008", "mol_011", "mol_012", "mol_013"], "convergence_points": [{"molecule_id": "mol_002", "incoming_reactions": ["rxn_005", "rxn_007"], "outgoing_reactions": ["rxn_001", "rxn_003", "rxn_008", "rxn_009", "rxn_010", "rxn_011"]}, {"molecule