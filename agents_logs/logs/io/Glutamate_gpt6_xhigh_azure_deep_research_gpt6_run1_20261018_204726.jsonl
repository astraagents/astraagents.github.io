\"inchi\": \"InChI=1S/C2H4O2/c1-2(3)4/h1H3,(H,3,4)\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_008\",\n      \"formula\": \"CO2\",\n      \"iupac_name\": \"carbon dioxide\",\n      \"common_name\": \"carbon dioxide\",\n      \"inchi\": \"InChI=1S/CO2/c2-1-3\",\n      \"role\": \"hub_intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_009\",\n      \"formula\": \"H2\",\n      \"iupac_name\": \"dihydrogen\",\n      \"common_name\": \"hydrogen\",\n      \"inchi\": \"InChI=1S/H2/h1H\",\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_010\",\n      \"formula\": \"Fe\",\n      \"iupac_name\": \"iron\",\n      \"common_name\": \"zerovalent iron\",\n      \"inchi\": \"InChI=1S/Fe\",\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_011\",\n      \"formula\": \"Fe^2+\",\n      \"iupac_name\": \"iron(2+)\",\n      \"common_name\": \"ferrous iron; formal oxidized-iron product pool\",\n      \"inchi\": \"InChI=1S/Fe/q+2\",\n      \"role\": \"hub_intermediate\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_012\",\n      \"formula\": \"H+\",\n      \"iupac_name\": \"hydron\",\n      \"common_name\": \"aqueous proton equivalent\",\n      \"inchi\": null,\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_013\",\n      \"formula\": \"SO3^2-\",\n      \"iupac_name\": \"sulfite\",\n      \"common_name\": \"sulfite\",\n      \"inchi\": null,\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_014\",\n      \"formula\": \"SO4^2-\",\n      \"iupac_name\": \"sulfate\",\n      \"common_name\": \"sulfate\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_