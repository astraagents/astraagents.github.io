ll\n    },\n    {\n      \"id\": \"mol_010\",\n      \"formula\": \"H+\",\n      \"iupac_name\": \"hydrogen(1+)\",\n      \"common_name\": \"Proton, representing buffered proton equivalents\",\n      \"inchi\": null,\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_011\",\n      \"formula\": \"Fe2+\",\n      \"iupac_name\": \"iron(2+)\",\n      \"common_name\": \"Ferrous iron\",\n      \"inchi\": \"InChI=1S/Fe/q+2\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Biochemical\"\n    },\n    {\n      \"id\": \"mol_012\",\n      \"formula\": \"SO3^2-\",\n      \"iupac_name\": \"trioxidosulfate(2-)\",\n      \"common_name\": \"Sulfite\",\n      \"inchi\": null,\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_013\",\n      \"formula\": \"SO4^2-\",\n      \"iupac_name\": \"tetraoxidosulfate(2-)\",\n      \"common_name\": \"Sulfate\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_014\",\n      \"formula\": \"NH3O\",\n      \"iupac_name\": \"hydroxylamine\",\n      \"common_name\": \"Hydroxylamine\",\n      \"inchi\": \"InChI=1S/H3NO/c1-2/h2H,1H2\",\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_015\",\n      \"formula\": \"C5H7NO5\",\n      \"iupac_name\": \"2-(hydroxyimino)pentanedioic acid\",\n      \"common_name\": \"2-Oxoglutarate oxime\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Biochemical\"\n    },\n    {\n      \"id\": \"mol_016\",\n      \"formula\": \"CH2O\",\n      \"iupac_name\": \"methanal\",\n      \"common_name\": \"Formaldehyde\",\n      \"inchi\": \"InChI=1S/CH2O/c1-2/h1H2\",\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_017\",\n      \"formula\": \"HCN\",\n      \"iupac_name\": \"hydrogen cyanide\",\n      \"common_name\": \"Hydrogen cyanide, representing the HCN/cyanide pool\",\n      \"inchi\": \"InChI=1S/CHN/c1-2/h1H\",\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_018\",\n      \"formula\": \"C2H4N2\",\n      \"iupac_name\": \"2-aminoethanenitrile\",\n      \"common_name\": \"Aminoacetonitrile\",\n      \"inchi\": \"InChI=1S/C2H4N2/c3-1-2-4/h1,3H2\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_019\",\n      \"formula\": \"C2H5NO2\",\n      \"iupac_name\": \"2-aminoacetic acid\",\n      \"common_name\": \"Glycine\",\n      \"inchi\": \"InChI=1S/C2H5NO2/c3-1-2(4)5/h1,3H2,(H,4,5)\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_020\",\n      \"formula\": \"H5N2O2P\",\n      \"iupac_name\": \"phosphorodiamidic acid\",\n      \"common_name\": \"Diamidophosphate, represented by its neutral acid\",\n      \"inchi\": null,\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_021\",\n      \"formula\": \"H3PO4\",\n      \"iupac_name\": \"phosphoric acid\",\n      \"common_name\": \"Orthophosphate reference form\",\n      \"inchi\": \"InChI=1S/H3O4P/c1-5(2,3)4/h(H3,1,2,3,4)\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_022\",\n      \"formula\": \"CO2\",\n      \"iupac_name\": \"carbon dioxide\",\n      \"common_name\": \"Carbon dioxide, exchanging with the bicarbonate pool\",\n      \"inchi\": \"InChI=1S/CO2/c2-1-3\",\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_023\",\n      \"formula\": \"C6H8N2O4\",\n      \"iupac_name\": \"3-(2,5-dioxoimidazolidin-4-yl)propanoic acid\",\n      \"common_name\": \"5-(2-Carboxyethyl)hydantoin\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_024\",\n      \"formula\": \"C3H4O\",\n      \"iupac_name\": \"prop-2-enal\",\n      \"common_name\": \"Acrolein\",\n      \"inchi\": \"InChI=1S/C3H4O/c1-2-3-4/h2-3H,1H2\",\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_025\",\n      \"formula\": \"C5H6N2O\",\n      \"iupac_name\": \"2-hydroxypentanedinitrile\",\n      \"common_name\": \"3-Cyanopropanal cyanohydrin\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_026\",\n      \"formula\": \"C5H7N3\",\n      \"iupac_name\": \"2-aminopentanedinitrile\",\n      \"common_name\": \"Glutamate aminodinitrile precursor\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_027\",\n      \"formula\": \"CH4\",\n      \"iupac_name\": \"methane\",\n      \"common_name\": \"Methane\",\n      \"inchi\": \"InChI=1S/CH4/h1H4\",\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_028\",\n      \"formula\": \"N2\",\n      \"iupac_name\": \"dinitrogen\",\n      \"common_name\": \"Nitrogen\",\n      \"inchi\": \"InChI=1S/N2/c1-2\",\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    }\n  ],\n  \"reactions\": [\n    {\n      \"id\": \"rxn_001\",\n      \"name\": \"Hydrogen-driven C5 ketoacid construction from pyruvate and glyoxylate\",\n      \"inputs\": [\"mol_004\", \"mol_005\", \"mol_002\"],\n      \"outputs\": [\"mol_006\", \"mol_001\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\"Supported metallic nickel for hydrogen activation and reductive carbon-skeleton growth\"],\n      \"conditions\": {\n        \"temperature\": \"295 K laboratory reference\",\n        \"pressure\": \"5 bar H2\",\n        \"catalyst\": \"Ni on silica-alumina\",\n        \"aqueous\": true,\n        \"other\": \"Anoxic, pH approximately 8, reaction-platform timescale up to 72 h. A 30 mM scale is representative of the cited platform, not an established optimum for both carbon-growth feeds. Cool pressurized mineral pores are a proposed environmental analogue.\"\n      },\n      \"mechanism\": \"Balanced net: C3H4O3 + C2H2O3 + H2 -> C5H6O5 + H2O. This multistep channel combines aldol carbon-carbon bond construction with reductive removal of an oxygen functionality; it is not represented as an elementary collision.\",\n      \"reasoning\": \"Kaur et al. (2024) support H2/Ni-driven reductive-aldol ketoacid growth and compatible amino-acid formation. The supplied research identifies pyruvate/glyoxylate chemistry as an upstream solution to 2-oxoglutarate availability, but does not provide a quantitative yield for this isolated net channel. Consequently, carbon flux and selectivity remain unresolved. Both starting organic inventories must be supplied; downstream glyoxylate regeneration does not close their initial geochemical supply. No speculative mineral-independent carbon fixation step is inserted.\"\n    },\n    {\n      \"id\": \"rxn_002\",\n      \"name\": \"Nickel-catalyzed hydrogen reductive amination\",\n      \"inputs\": [\"mol_006\", \"mol_003\", \"mol_002\"],\n      \"outputs\": [\"mol_007\", \"mol_001\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\"Supported metallic nickel\"],\n      \"conditions\": {\n        \"temperature\": \"295 K\",\n        \"pressure\": \"5 bar H2\",\n        \"catalyst\": \"Ni on silica-alumina\",\n        \"aqueous\": true,\n        \"other\": \"Anoxic, pH 8, approximately 30 mM ketoacid, ammonium bicarbonate nitrogen source, 72 h. The supplied study's substrate-panel ammonium range is 6-150 mM; that range is not a glutamate-specific optimization.\"\n      },\n      \"mechanism\": \"Balanced net: C5H6O5 + NH3 + H2 -> C5H9NO4 + H2O. Ammonia addition and dehydration establish a low-abundance imine/iminium pool; nickel activates H2 and reduces that pool.\",\n      \"reasoning\": \"Kaur et al. (2024) directly include 2-oxoglutarate-to-glutamate conversion in the Ni/H2 substrate scope. H2 is the consumed reductant, while Ni is catalytic. Competing direct carbonyl hydrogenation produces hydroxyacid and prevents equating substrate conversion with glutamate yield. Mayer and Moran (2022) show that 2-oxoglutarate imine formation and reductive amination are intrinsically unfavorable relative to several other ketoacids. This branch has the strongest operating-condition compatibility with rxn_001, although end-to-end selective accumulation remains unquantified.\"\n    },\n    {\n      \"id\": \"rxn_003\",\n      \"name\": \"Meteoritic Fe/Ni-catalyzed hydrogen reductive amination\",\n      \"inputs\": [\"mol_006\", \"mol_003\", \"mol_002\"],\n      \"outputs\": [\"mol_007\", \"mol_001\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\"Ground Aletai meteorite containing reactive Fe/Ni-rich metallic phases\"],\n      \"conditions\": {\n        \"temperature\": \"295 K\",\n        \"pressure\": \"5 bar H2\",\n        \"catalyst\": \"Reactive Fe/Ni-bearing phases in ground Aletai meteorite\",\n        \"aqueous\": true,\n        \"other\": \"Anoxic, pH 8, approximately 30 mM ketoacid, ammonium bicarbonate, 72 h. Activity depends on exposed metal area and cannot be assigned to an arbitrary weathered meteorite.\"\n      },\n      \"mechanism\": \"Balanced net: C5H6O5 + NH3 + H2 -> C5H9NO4 + H2O. Meteoritic metal activates hydrogen and reduces the imine/iminium formed from ammonia and 2-oxoglutarate.\",\n      \"reasoning\": \"Kaur et al. (2024) experimentally demonstrate glutamate-producing activity using a natural meteoritic material. This is retained separately because naturally occurring Fe/Ni material addresses catalyst provenance differently from manufactured supported Ni. It is a catalyst variant of reductive amination, not an independent nitrogen-incorporation mechanism. Hydroxyacid formation competes. Transport of the upstream ketoacid into a meteorite-bearing receiving pore is conditional; neither arbitrary terrestrial mineral equivalence nor quantitative upstream-to-meteorite integration has been demonstrated.\"\n    },\n    {\n      \"id\": \"rxn_004\",\n      \"name\": \"Palladium-catalyzed formate transfer reductive amination\",\n      \"inputs\": [\"mol_006\", \"mol_003\", \"mol_008\"],\n      \"outputs\": [\"mol_007\", \"mol_022\", \"mol_001\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\"Palladium on carbon\"],\n      \"conditions\": {\n        \"temperature\": \"Approximately 295 K\",\n        \"pressure\": \"Approximately 1 bar inert atmosphere; external H2 is not required by the net reaction\",\n        \"catalyst\": \"Pd/C\",\n        \"aqueous\": true,\n        \"other\": \"Anoxic, mildly alkaline medium near pH 8 and millimolar ketoacid. The supplied report establishes formate substitution in the Pd experiments but does not give its full branch-specific loading and timing; the H2 protocol must not be treated as an exact formate recipe.\"\n      },\n      \"mechanism\": \"Balanced net: C5H6O5 + NH3 + CH2O2 -> C5H9NO4 + CO2 + H2O. Oxidation of formate supplies two reducing equivalents for reduction of the ketoacid-derived iminium.\",\n      \"reasoning\": \"Kaur et al. (2024) report replacement of H2 by formate in Pd-mediated amino-acid synthesis. This adds a chemically distinct electron-donor option without requiring an elaborate organic cofactor. Pd improves amino-acid versus hydroxyacid selectivity in the reported substrate panel, but the panel-wide values are not glutamate-specific yields. The geochemical implementation is conditional because accessible Pd-rich surfaces are much less common than Fe/Ni phases; manufactured Pd/C is experimental evidence, not an assumed ubiquitous Hadean mineral.\"\n    },\n    {\n      \"id\": \"rxn_005\",\n      \"name\": \"Reductive amination on partially electroreduced FeS\",\n      \"inputs\": [\"mol_006\", \"mol_003\", \"mol_009\", \"mol_010\"],\n      \"outputs\": [\"mol_007\", \"mol_001\", \"mol_011\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\"Partially electroreduced FeS, treated as an expendable preconditioned reducing surface\"],\n      \"conditions\": {\n        \"temperature\": \"296-298 K\",\n        \"pressure\": \"Approximately 1 bar during the aqueous conversion\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Anoxic, pH approximately 9.6, 5 mM 2-oxoglutarate, ammonium in large excess, approximately 48 h. The laboratory surface was preconditioned near -0.7 V versus SHE for seven days. This is a cool mineral-interface implementation, not a 350-600 K reaction.\"\n      },\n      \"mechanism\": \"Balanced formal redox inventory: C5H6O5 + NH3 + Fe + 2 H+ -> C5H9NO4 + H2O + Fe2+. Here Fe -> Fe2+ represents one two-electron Fe(0)-equivalent of reducing capacity in the prepared surface; it does not identify the entire nonstoichiometric solid as native iron. Buffered proton equivalents do not imply an acidic pH.\",\n      \"reasoning\": \"Kitadai et al. (2019) report nearly complete glutamate conversion using partially electroreduced FeS under alkaline, near-room-temperature conditions. The yield belongs to that prepared material, not to ordinary FeS or an arbitrary mass of native Fe. Because the supplied evidence does not resolve the complete solid-phase oxidation inventory, the displayed equation is explicitly formal rather than a fully species-resolved mineral mechanism. Natural production and regeneration of the required reduced surface remain unproven; this route cannot claim an autonomous catalytic cycle.\"\n    },\n    {\n      \"id\": \"rxn_006\",\n      \"name\": \"ZnS photocatalytic reductive amination with sulfite\",\n      \"inputs\": [\"mol_006\", \"mol_003\", \"mol_012\"],\n      \"outputs\": [\"mol_007\", \"mol_013\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Illuminated colloidal ZnS semiconductor\"],\n      \"conditions\": {\n        \"temperature\": \"Near ambient; 298-303 K is a proposed environmental implementation window\",\n        \"pressure\": \"Approximately 1 bar\",\n        \"catalyst\": \"ZnS photocatalyst\",\n        \"aqueous\": true,\n        \"other\": \"Anoxic, pH approximately 9, large ammonium excess, four-hour experimental observation window, UV or near-UV illumination reaching the ZnS. Sulfite is a consumed hole scavenger. Exact temperature, photon flux and sulfite loading are not specified in the supplied summary.\"\n      },\n      \"mechanism\": \"Balanced net redox channel: C5H6O5 + NH3 + SO3^2- -> C5H9NO4 + SO4^2-. Photoexcited ZnS transfers electrons to the imine/iminium pool, while sulfite oxidation supplies the corresponding two-electron donor half-reaction. No molecular oxygen is required.\",\n      \"reasoning\": \"Wang et al. (2012) report approximately 0.5% glutamate after four hours without sulfite and roughly sixfold enhancement with sulfite. Light-only and dark-ZnS controls support the semiconductor's role. Sulfate is the formal fully oxidized sulfur endpoint used to close this net equation, not a claim that it was the exclusive measured sulfur product. Strong surface UV is useful here, but low yield, photon access, ammonium excess and competition in an unpurified upstream mixture remain important limitations.\"\n    },\n    {\n      \"id\": \"rxn_007\",\n      \"name\": \"Condensation of hydroxylamine with 2-oxoglutarate\",\n      \"inputs\": [\"mol_006\", \"mol_014\"],\n      \"outputs\": [\"mol_015\", \"mol_001\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"343 K reference temperature for the reported iron-driven network\",\n        \"pressure\": \"Approximately 1 bar\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Anoxic aqueous mineral-interface chemistry. Hydroxylamine is externally supplied. The supplied report does not specify a separately optimized oxime-formation pH, concentration or rate, so none is assigned as an experimental fact.\"\n      },\n      \"mechanism\": \"Balanced net: C5H6O5 + NH3O -> C5H7NO5 + H2O. Hydroxylamine adds to the keto group and the adduct dehydrates to the oxime; oxime geometry is unspecified.\",\n      \"reasoning\": \"Muchowska, Varma and Moran (2019) support an oxime-mediated route from ketoacids to amino acids, including glutamate. Their integrated precursor network is Fe-promoted; it is not identical to the Ni/H2 upstream module used here. Accordingly, receiving-solution compatibility after rxn_001 remains conditional. Kitadai et al. (2019) identify uncertain Hadean hydroxylamine availability as a substantive limitation. No unsupported hydroxylamine synthesis step is added merely to conceal that dependency.\"\n    },\n    {\n      \"id\": \"rxn_008\",\n      \"name\": \"Four-electron reduction of the 2-oxoglutarate oxime\",\n      \"inputs\": [\"mol_015\", \"mol_009\", \"mol_010\"],\n      \"outputs\": [\"mol_007\", \"mol_001\", \"mol_011\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\"Zero-valent iron as a stoichiometric reductant\"],\n      \"conditions\": {\n        \"temperature\": \"343 K reference temperature\",\n        \"pressure\": \"Approximately 1 bar\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Anoxic; reactive Fe(0) must provide at least two Fe-to-Fe(II) equivalents per oxime for the displayed channel. Actual loadings can be higher because of passivation and competing corrosion. Exact branch-specific pH and time are not supplied in the research summary.\"\n      },\n      \"mechanism\": \"Balanced net: C5H7NO5 + 2 Fe + 4 H+ -> C5H9NO4 + H2O + 2 Fe2+. Reduction of the C=N functionality and cleavage of the N-O bond require four electrons overall.\",\n      \"reasoning\": \"Muchowska, Varma and Moran (2019) experimentally support hydroxylamine/Fe(0) production of glutamate and reduction through oxime intermediates. Two Fe atoms, not one, are required for the stated four-electron bookkeeping when Fe(II) is the oxidation endpoint. Ferrous iron may subsequently complex or precipitate; it is an oxidation-state inventory rather than a claim of exclusively free aqueous Fe2+. The integrated Fe-network evidence does not establish identical performance after transfer from a Ni-containing precursor mixture.\"\n    },\n    {\n      \"id\": \"rxn_009\",\n      \"name\": \"Strecker formation of the glycine aminonitrile precursor\",\n      \"inputs\": [\"mol_016\", \"mol_003\", \"mol_017\"],\n      \"outputs\": [\"mol_018\", \"mol_001\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"298-310 K proposed implementation window\",\n        \"pressure\": \"Approximately 1 bar\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Proposed concentrated pool at pH approximately 8-9 with retained ammonia and cyanide. Shallow burial or mineral shading limits destructive UV exposure. Concentration and residence time are design variables, not values demonstrated for this integrated route in the supplied research.\"\n      },\n      \"mechanism\": \"Balanced net: CH2O + NH3 + HCN -> C2H4N2 + H2O. Formaldehyde/ammonia condensation produces an imine or iminium species that is trapped by cyanide.\",\n      \"reasoning\": \"This is established Strecker reaction logic, consistent with the cyanide/aldehyde framework discussed by Van Trump and Miller (1972). Pulletikurti et al. (2022) also identify aminoacetonitrile as relevant to glutamate-forming nitrogen-transfer chemistry. However, the supplied research does not directly demonstrate this exact upstream glycine preparation connected to rxn_011: its operating window and network integration are speculative. No yield or quantitative delivery efficiency is assigned.\"\n    },\n    {\n      \"id\": \"rxn_010\",\n      \"name\": \"Hydrolysis of aminoacetonitrile to glycine\",\n      \"inputs\": [\"mol_018\", \"mol_001\"],\n      \"outputs\": [\"mol_019\", \"mol_003\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Hydronium for acid-catalyzed nitrile hydrolysis\"],\n      \"conditions\": {\n        \"temperature\": \"353-370 K proposed hydrolysis window\",\n        \"pressure\": \"Approximately 1 bar\",\n        \"catalyst\": \"Aqueous acid\",\n        \"aqueous\": true,\n        \"other\": \"Proposed local acidic reservoir, pH approximately 1-2, with days-to-weeks residence and sustained water activity. This is a testable environmental scenario, not a literature-validated completion time from the supplied report. Residual free cyanide must not simply be carried into the subsequent Al(III) stage.\"\n      },\n      \"mechanism\": \"Balanced reference-form net: C2H4N2 + 2 H2O -> C2H5NO2 + NH3. The nitrile hydrolyzes through an amide; released ammonia is predominantly ammonium under the proposed acidic conditions.\",\n      \"reasoning\": \"Nitrile hydrolysis is the release step of the Strecker framework discussed by Van Trump and Miller (1972). The exact aminoacetonitrile hydrolysis protocol needed here is not established in the supplied research, so its proposed mild-environment rate is explicitly speculative. Complete conversion must be measured rather than assumed from aminonitrile disappearance. Conditioning to the hotter, moderately acidic, concentrated Al(III) transamination medium is a separate requirement.\"\n    },\n    {\n      \"id\": \"rxn_011\",\n      \"name\": \"Aluminum-assisted glycine-to-2-oxoglutarate transamination\",\n      \"inputs\": [\"mol_006\", \"mol_019\"],\n      \"outputs\": [\"mol_007\", \"mol_005\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Soluble Al(III) salt, such as potassium aluminum sulfate\"],\n      \"conditions\": {\n        \"temperature\": \"Approximately 353 K\",\n        \"pressure\": \"Approximately 1 bar\",\n        \"catalyst\": \"Al(III) Lewis-acid promoter\",\n        \"aqueous\": true,\n        \"other\": \"Hot acidic concentrated solution. The related confirmation used 0.2 M 2-oxoglutarate, pH 5 and 44 h; glycine is supplied as amino donor. These values must not be conflated with every detail of the original 44% yield experiment.\"\n      },\n      \"mechanism\": \"Balanced net: C5H6O5 + C2H5NO2 -> C5H9NO4 + C2H2O3. Metal-assisted Schiff-base chemistry transfers the amino group from glycine to 2-oxoglutarate, yielding glyoxylate without an external reductant.\",\n      \"reasoning\": \"Stubbs et al. (2020) report 44% glutamate in Al(III)-assisted hot acidic transamination. Pulletikurti et al. (2022) provide related confirmation at 0.2 M substrate, pH 5 and 80 degrees C. The amino-acid-forming step is not metal-free. Concentration, available Al(III), and separation or conditioning of cyanide-containing and Ni-containing feeds are necessary; carbonate or hydroxide precipitation can reduce promoter availability. Glyoxylate is regenerated here but cannot serve as the initial upstream seed.\"\n    },\n    {\n      \"id\": \"rxn_012\",\n      \"name\": \"Diamidophosphate deamidation as an ammonia-source inventory\",\n      \"inputs\": [\"mol_020\", \"mol_001\"],\n      \"outputs\": [\"mol_003\", \"mol_021\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"Approximately 298 K\",\n        \"pressure\": \"Approximately 1 bar\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Coupled to rxn_013 in the same pH 8.5, approximately 0.5 M bicarbonate mixture. The optimized preparation used approximately 0.7 M DAP and a 21-day formation period. This node is not an independently measured complete-hydrolysis stage.\"\n      },\n      \"mechanism\": \"Balanced ultimate deamidation inventory: H5N2O2P + 2 H2O -> 2 NH3 + H3PO4. Actual release can proceed through partially hydrolyzed phosphoramidates; orthophosphate denotes the terminal reference-form phosphorus pool.\",\n      \"reasoning\": \"Pulletikurti et al. (2022) use DAP as an ammonia source in the optimized hydantoin preparation. The observed coupled preparation supports sufficient nitrogen delivery under that formulated mixture, but does not independently establish complete DAP hydrolysis, its time-dependent release profile, or exclusive orthophosphate production. Accordingly, rxn_012 and rxn_013 are coupled bookkeeping modules rather than experimentally resolved consecutive kinetic stages. Prebiotic DAP supply remains external and conditional.\"\n    },\n    {\n      \"id\": \"rxn_013\",\n      \"name\": \"Bucherer-Bergs construction of carboxyethylhydantoin\",\n      \"inputs\": [\"mol_006\", \"mol_017\", \"mol_003\", \"mol_022\"],\n      \"outputs\": [\"mol_023\", \"mol_001\", \"mol_022\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"Approximately 298 K\",\n        \"pressure\": \"Approximately 1 bar\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"pH 8.5; 0.35 M 2-oxoglutarate, approximately 0.42 M cyanide, 0.7 M DAP supplied jointly with rxn_012, and 0.5 M bicarbonate; 21 days. Such simultaneous concentrations require an unproven concentration and retention mechanism.\"\n      },\n      \"mechanism\": \"Balanced net with explicit carbon-dioxide exchange: C5H6O5 + HCN + NH3 + CO2 -> C6H8N2O4 + H2O + CO2. Cyanide/ammonia addition, carbamylation, cyclization and decarboxylative processing build the hydantoin. CO2 participates in gross carbon exchange but cancels from the net inventory; this equation is not an isotope atom map.\",\n      \"reasoning\": \"Pulletikurti et al. (2022) report 96% carboxyethylhydantoin under the optimized DAP/cyanide/bicarbonate conditions. That is protected-skeleton yield, not free-glutamate yield. The balanced net does not eliminate bicarbonate's mechanistic and buffering roles. The experiment strongly supports this concentrated module, while natural co-concentration of 2-oxoglutarate, cyanide and DAP, together with compatible ammonia-release kinetics, remains unresolved.\"\n    },\n    {\n      \"id\": \"rxn_014\",\n      \"name\": \"Hydantoin hydrolysis and release of free glutamate\",\n      \"inputs\": [\"mol_023\", \"mol_001\"],\n      \"outputs\": [\"mol_007\", \"mol_022\", \"mol_003\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"353 K\",\n        \"pressure\": \"Approximately 1 bar\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Heat the preceding concentrated preparation for an additional 14 days. Maintain water activity; the preparation begins from the alkaline bicarbonate-buffered mixture. No quantitative separate rate is assigned to ring opening versus decarbamylation.\"\n      },\n      \"mechanism\": \"Balanced overall hydrolysis: C6H8N2O4 + 2 H2O -> C5H9NO4 + CO2 + NH3. Ring opening gives carbamoylated intermediates, followed by hydrolytic removal of the carbamoyl group.\",\n      \"reasoning\": \"Pulletikurti et al. (2022) report 19% glutamate after 14 days at 80 degrees C, with 72% hydantoin remaining. Thus release of free glutamate, not construction of its protected skeleton, is the demonstrated bottleneck. This node combines unresolved hydrolysis substeps and does not assign each an independently measured rate. Geological residence or cycling could increase release, but improved natural yields are not established by the experiment.\"\n    },\n    {\n      \"id\": \"rxn_015\",\n      \"name\": \"Two cyanide additions convert acrolein into a cyanohydrin reservoir\",\n      \"inputs\": [\"mol_024\", \"mol_017\"],\n      \"outputs\": [\"mol_025\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"Approximately 298 K\",\n        \"pressure\": \"Approximately 1 bar\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Approximately 140 mM acrolein and 700 mM KCN, pH 9.2. The reservoir must retain cyanide and limit competing acrolein polymerization. Cyanide is a consumed reagent, not a mineral catalyst.\"\n      },\n      \"mechanism\": \"Balanced net: C3H4O + 2 HCN -> C5H6N2O. Conjugate cyanide addition yields the 3-cyanopropanal framework, followed by carbonyl cyanohydrin formation. The transient free aldehyde is not introduced as a fictitiously isolated product.\",\n      \"reasoning\": \"Van Trump and Miller (1972) identify acrolein chemistry as a route toward glutamate. Fern\u00e1ndez-Garc\u00eda, Grefenstette and Powner (2017), as summarized in the supplied research, provide approximately 95% formation of the associated cyanohydrin under concentrated aqueous cyanide conditions. This high value concerns the cyanohydrin reservoir, not glutamate. Acrolein and cyanide supply, concentration and retention remain conditional.\"\n    },\n    {\n      \"id\": \"rxn_016\",\n      \"name\": \"Strecker conversion of the cyanohydrin reservoir to an aminodinitrile\",\n      \"inputs\": [\"mol_025\", \"mol_003\"],\n      \"outputs\": [\"mol_026\", \"mol_001\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"298-310 K proposed implementation window\",\n        \"pressure\": \"Approximately 1 bar\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Ammonia-rich cyanide-containing receiving solution, approximately pH 8-9 as a proposed operating window. The supplied report does not establish an optimized glutamate-aminodinitrile concentration, yield or residence time.\"\n      },\n      \"mechanism\": \"Balanced net: C5H6N2O + NH3 -> C5H7N3 + H2O. The cyanohydrin reversibly releases the aldehyde and HCN; aldehyde/ammonia condensation forms an imine that is trapped by cyanide. This is not an assumed direct displacement of hydroxide by ammonia.\",\n      \"reasoning\": \"Van Trump and Miller (1972) support the acrolein-to-glutamate Strecker proposal, while Fern\u00e1ndez-Garc\u00eda et al. (2017) support the preceding aldehyde/cyanohydrin chemistry. The supplied evidence does not quantify this exact reservoir-to-aminodinitrile conversion. Its selected operating window and efficiency are therefore explicitly speculative. Equilibrium partitioning, competing polymerization and ammonia retention must be measured before treating rxn_015's high yield as transferable to this step.\"\n    },\n    {\n      \"id\": \"rxn_017\",\n      \"name\": \"Exhaustive hydrolysis of both nitriles to free glutamate\",\n      \"inputs\": [\"mol_026\", \"mol_001\"],\n      \"outputs\": [\"mol_007\", \"mol_003\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Hydronium for acid-catalyzed nitrile and amide hydrolysis\"],\n      \"conditions\": {\n        \"temperature\": \"353-370 K proposed environmental hydrolysis window\",\n        \"pressure\": \"Approximately 1 bar\",\n        \"catalyst\": \"Aqueous acid\",\n        \"aqueous\": true,\n        \"other\": \"Proposed local pH 1-2 reservoir, days-to-weeks or longer, with sustained water activity. The supplied studies do not establish complete hydrolysis on this timescale. Acidification of the preceding cyanide-rich mixture requires cyanide-loss and safety-aware experimental controls.\"\n      },\n      \"mechanism\": \"Balanced reference-form net: C5H7N3 + 4 H2O -> C5H9NO4 + 2 NH3. Both nitriles must pass through amide-containing intermediates and reach carboxyl groups; stopping after partial hydrolysis does not deliver free glutamate.\",\n      \"reasoning\": \"The endpoint follows the acrolein/Strecker framework of Van Trump and Miller (1972) and the later cyanide chemistry discussed by Fern\u00e1ndez-Garc\u00eda et al. (2017). The supplied evidence specifically warns that partial hydrolysis can retain glutamine-related or other amide products. Consequently, efficient free-glutamate release under the proposed mild environmental conditions is speculative, not established by the cyanohydrin result. This is the principal release bottleneck of the alpha-ketoglutarate-independent molecular route.\"\n    },\n    {\n      \"id\": \"rxn_018\",\n      \"name\": \"Electric-discharge access to glutamate from simple gas-water feedstocks\",\n      \"inputs\": [\"mol_027\", \"mol_028\", \"mol_003\", \"mol_001\"],\n      \"outputs\": [\"mol_007\", \"mol_002\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"Near-ambient collection water; 298-323 K is a proposed collector window, not a reported Ring apparatus specification\",\n        \"pressure\": \"Approximately ambient gas-water apparatus; exact original pressure is not supplied in the research summary\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Reducing CH4/N2 atmosphere contacting water with trace ammonia, energized by electrical discharge. The spark channel experiences transient temperatures far above the collector temperature. Discharge power, residence time and any product work-up must follow the original study before quantitative reproduction is claimed.\"\n      },\n      \"mechanism\": \"Atom- and charge-balanced formal product-channel inventory: 15 CH4 + N2 + NH3 + 12 H2O -> 3 C5H9NO4 + 30 H2. This is a lumped reachability node for a complex radical, carbonyl, cyanide and aqueous network. The coefficients provide a conservation-valid reference channel; they are not measured gas-consumption ratios, an established partition of nitrogen sources, or a measured H2/glutamate yield.\",\n      \"reasoning\": \"Ring, Wolman, Friedmann and Miller (1972) directly identified glutamic acid in discharge products by ion-exchange chromatography and GC-MS. The explicit reference equation conserves C, H, N and O and corrects the conservation defect of an unspecified lumped edge. Nevertheless, the complete molecular mechanism and product distribution remain unresolved. Schlesinger and Miller (1983) show strong suppression of diverse amino-acid synthesis in insufficiently reducing atmospheres. This branch establishes qualitative access from simple feedstocks, not selective or continuously productive glutamate synthesis.\"\n    }\n  ],\n  \"pathways\": [\n    {\n      \"pathway_id\": \"P1\",\n      \"name\": \"Integrated H2/Ni carbon growth and reductive amination\",\n      \"description\": \"Externally supplied pyruvate and initial glyoxylate form the C5 ketoacid, followed by Ni/H2 reductive amination. The common pH, temperature and hydrogen platform makes this the best-supported compatibility option, but neither quantitative carbon closure nor selective free-glutamate accumulation from the initial mixture is established.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_002\"],\n      \"key_intermediates\": [\"mol_006\"]\n    },\n    {\n      \"pathway_id\": \"P2\",\n      \"name\": \"Carbon-growth feed followed by natural meteoritic-metal amination\",\n      \"description\": \"The C5 ketoacid reaches a receiving pore containing reactive meteoritic Fe/Ni material and hydrogen. This is a natural-catalyst alternative to P1. Transfer and retention are conditional; the pathway does not claim that every meteorite duplicates Aletai activity or that the precursor-growth experiment used the same meteorite.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_003\"],\n      \"key_intermediates\": [\"mol_006\"]\n    },\n    {\n      \"pathway_id\": \"P3\",\n      \"name\": \"Formate-supported transfer reductive amination\",\n      \"description\": \"After carbon-skeleton construction, formate supplies reducing equivalents to a Pd-mediated amination branch. This relaxes the need for H2 at the final step but substitutes a rare-catalyst accessibility requirement and an externally supplied formate inventory.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_004\"],\n      \"key_intermediates\": [\"mol_006\"]\n    },\n    {\n      \"pathway_id\": \"P4\",\n      \"name\": \"Prepared reduced-FeS surface amination\",\n      \"description\": \"The C5 feed is cooled and adjusted to the alkaline receiving conditions of the partially electroreduced FeS experiment. High laboratory conversion is supported, but surface preparation, mineral redox inventory and natural regeneration remain conditional. The Fe/Fe2+ equation is formal electron accounting, not identification of the entire solid.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_005\"],\n      \"key_intermediates\": [\"mol_006\"]\n    },\n    {\n      \"pathway_id\": \"P5\",\n      \"name\": \"Illuminated ZnS and sulfite amination\",\n      \"description\": \"The C5 ketoacid enters a light-exposed ZnS-bearing receiving solution with ammonia and sulfite. Photon access, donor supply and low measured glutamate yield distinguish this route from dark metal/H2 chemistry. Transfer from the pressurized precursor module is conditional rather than an established one-pot operation.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_006\"],\n      \"key_intermediates\": [\"mol_006\"]\n    },\n    {\n      \"pathway_id\": \"P6\",\n      \"name\": \"Oxime capture followed by Fe(0) reduction\",\n      \"description\": \"The C5 ketoacid captures externally supplied hydroxylamine, and the resulting oxime undergoes four-electron reduction by Fe(0). The oxime chemistry is experimentally supported, but compatibility of the present Ni-derived precursor mixture with the reported Fe-driven module requires testing.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_007\", \"rxn_008\"],\n      \"key_intermediates\": [\"mol_006\", \"mol_015\"]\n    },\n    {\n      \"pathway_id\": \"P7\",\n      \"name\": \"Strecker-derived glycine followed by transamination\",\n      \"description\": \"A formaldehyde/cyanide branch supplies glycine, while the separate carbon-growth branch supplies 2-oxoglutarate. After hydrolysis, residual-cyanide removal or depletion, pH adjustment and concentration, Al(III)-assisted transamination forms glutamate and regenerates glyoxylate. The sequence lists preparation of both required feeds before their convergence; it is not a single unconditioned flask.\",\n      \"reaction_sequence\": [\"rxn_009\", \"rxn_010\", \"rxn_001\", \"rxn_011\"],\n      \"key_intermediates\": [\"mol_018\", \"mol_019\", \"mol_006\"]\n    },\n    {\n      \"pathway_id\": \"P8\",\n      \"name\": \"DAP-supported Bucherer-Bergs hydantoin reservoir\",\n      \"description\": \"Concentrated 2-oxoglutarate enters the DAP/cyanide/bicarbonate module, with rxn_012 and rxn_013 representing coupled ammonia-source and hydantoin-formation accounting. Prolonged hot hydrolysis then releases some free glutamate. The approximately 96% protected-intermediate yield must not be substituted for the approximately 19% glutamate yield.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_012\", \"rxn_013\", \"rxn_014\"],\n      \"key_intermediates\": [\"mol_006\", \"mol_023\"]\n    },\n    {\n      \"pathway_id\": \"P9\",\n      \"name\": \"Acrolein-cyanide route independent of 2-oxoglutarate\",\n      \"description\": \"Acrolein and cyanide form a cyanohydrin reservoir, which can access an aminodinitrile by aldehyde/imine equilibration and Strecker trapping. Exhaustive hydrolysis of both nitriles is required for glutamate. The reservoir formation is strongly supported; aminodinitrile delivery and complete environmentally mild hydrolysis are less securely established.\",\n      \"reaction_sequence\": [\"rxn_015\", \"rxn_016\", \"rxn_017\"],\n      \"key_intermediates\": [\"mol_025\", \"mol_026\"]\n    },\n    {\n      \"pathway_id\": \"P10\",\n      \"name\": \"Reducing-atmosphere electrical-discharge synthesis\",\n      \"description\": \"Methane, nitrogen, water and trace ammonia access glutamate through an experimentally observed but molecularly unresolved discharge network. This is the simplest-feedstock pathway in the graph. Its balanced reference channel repairs elemental bookkeeping without claiming a selective reaction, measured stoichiometric gas ratio or glutamate-specific productivity.\",\n      \"reaction_sequence\": [\"rxn_018\"],\n      \"key_intermediates\": []\n    }\n  ],\n  \"hub_molecules\": [\n    \"mol_001\",\n    \"mol_002\",\n    \"mol_003\",\n    \"mol_005\",\n    \"mol_006\",\n    \"mol_007\",\n    \"mol_009\",\n    \"mol_010\",\n    \"mol_011\",\n    \"mol_017\",\n    \"mol_022\"\n  ],\n  \"convergence_points\": [\n    {\n      \"molecule_id\": \"mol_006\",\n      \"incoming_reactions\": [\"rxn_001\"],\n      \"outgoing_reactions\": [\n        \"rxn_002\",\n        \"rxn_003\",\n        \"rxn_004\",\n        \"rxn_005\",\n        \"rxn_006\",\n        \"rxn_007\",\n        \"rxn_011\",\n        \"rxn_013\"\n      ]\n    },\n    {\n      \"molecule_id\": \"mol_007\",\n      \"incoming_reactions\": [\n        \"rxn_002\",\n        \"rxn_003\",\n        \"rxn_004\",\n        \"rxn_005\",\n        \"rxn_006\",\n        \"rxn_008\",\n        \"rxn_011\",\n        \"rxn_014\",\n        \"rxn_017\",\n        \"rxn_018\"\n      ],\n      \"outgoing_reactions\": []\n    },\n    {\n      \"molecule_id\": \"mol_003\",\n      \"incoming_reactions\": [\n        \"rxn_010\",\n        \"rxn_012\",\n        \"rxn_014\",\n        \"rxn_017\"\n      ],\n      \"outgoing_reactions\": [\n        \"rxn_002\",\n        \"rxn_003\",\n        \"rxn_004\",\n        \"rxn_005\",\n        \"rxn_006\",\n        \"rxn_009\",\n        \"rxn_013\",\n        \"rxn_016\",\n        \"rxn_018\"\n      ]\n    },\n    {\n      \"molecule_id\": \"mol_005\",\n      \"incoming_reactions\": [\"rxn_011\"],\n      \"outgoing_reactions\": [\"rxn_001\"]\n    },\n    {\n      \"molecule_id\": \"mol_002\",\n      \"incoming_reactions\": [\"rxn_018\"],\n      \"outgoing_reactions\": [\"rxn_001\", \"rxn_002\", \"rxn_003\"]\n    },\n    {\n      \"molecule_id\": \"mol_022\",\n      \"incoming_reactions\": [\"rxn_004\", \"rxn_013\", \"rxn_014\"],\n      \"outgoing_reactions\": [\"rxn_013\"]\n    }\n  ]\n}", "parsed_response": {"target_molecule": "Glutamate, represented as stereochemically unspecified glutamic acid", "overall_strategy": "This connected bipartite graph contains ten distinct conditional pathways to glutamate. A hydrogen-driven pyruvate/glyoxylate carbon-growth module supplies 2-oxoglutarate to eight routes; acrolein/cyanide chemistry and atmospheric discharge provide two independent alternatives. P1 and P2 are experimentally supported catalyst variants, not different reaction families. The graph is a complete representation of the selected routes, not a claim that an uninterrupted, geochemically closed synthesis has been demonstrated. Pyruvate, an initial glyoxylate inventory, acrolein, cyanide, hydroxylamine, diamidophosphate and prepared reducing surfaces remain conditional external supplies. Regenerated glyoxylate cannot provide its own initial inventory. Reactions operating under different conditions represent separate receiving reservoirs or sequentially conditioned aliquots, not a universally compatible one-pot mixture. All settings are anoxic; surface UV is used where beneficial and shielding is specified where necessary. Organic acids and ammonia are represented using neutral reference formulas even when their dominant aqueous forms are ionic. Explicitly charged species retain charge bookkeeping. Balanced coefficients are given in mechanism descriptions without repeating IDs in input/output arrays. Some mineral and discharge equations are explicitly identified as formal redox or elemental accounting rather than fully resolved mechanisms. The schema's intermediate role also covers terminal coproducts. Null environment_formed denotes an external inventory or formation in multiple environments. No enantioselection or specifically L-glutamate synthesis is asserted.", "molecules": [{"id": "mol_001", "formula": "H2O", "iupac_name": "oxidane", "common_name": "Water", "inchi": "InChI=1S/H2O/h1H2", "role": "starting", "environment_formed": null}, {"id": "mol_002", "formula": "H2", "iupac_name": "dihydrogen", "common_name": "Hydrogen", "inchi": "InChI=1S/H2/h1H", "role": "starting", "environment_formed": null}, {"id": "mol_003", "formula": "NH3", "iupac_name": "azane", "common_name": "Ammonia, representing the ammonia/ammonium pool", "inchi": "InChI=1S/H3N/h1H3", "role": "starting", "environment_formed": null}, {"id": "mol_004", "formula": "C3H4O3", "iupac_name": "2-oxopropanoic acid", "common_name": "Pyruvic acid", "inchi": "InChI=1S/C3H4O3/c1-2(4)3(5)6/h1H3,(H,5,6)", "role": "starting", "environment_formed": null}, {"id": "mol_005", "formula": "C2H2O3", "iupac_name": "2-oxoacetic acid", "common_name": "Glyoxylic acid", "inchi": "InChI=1S/C2H2O3/c3-1-2(4)5/h1H,(H,4,5)", "role": "starting", "environment_formed": null}, {"id": "mol_006", "formula": "C5H6O5", "iupac_name": "2-oxopentanedioic acid", "common_name": "2-Oxoglutaric acid; alpha-ketoglutarate reference form", "inchi": "InChI=1S/C5H6O5/c6-3(5(9)10)1-2-4(7)8/h1-2H2,(H,7,8)(H,9,10)", "role": "hub_intermediate", "environment_formed": "Biochemical"}, {"id": "mol_007", "formula": "C5H9NO4", "iupac_name": "2-aminopentanedioic acid", "common_name": "Glutamic acid; glutamate reference form", "inchi": "InChI=1S/C5H9NO4/c6-3(5(9)10)1-2-4(7)8/h3H,1-2,6H2,(H,7,8)(H,9,10)", "role": "target", "environment_formed": null}, {"id": "mol_008", "formula": "CH2O2", "iupac_name": "methanoic acid", "common_name": "Formic acid; formate reference form", "inchi": "InChI=1S/CH2O2/c2-1-3/h1H,(H,2,3)", "role": "starting", "environment_formed": null}, {"id": "mol_009", "formula": "Fe", "iupac_name": "iron", "common_name": "Zero-valent iron", "inchi": "InChI=1S/Fe", "role": "starting", "environment_formed": null}, {"id": "mol_010", "formula": "H+", "iupac_name": "hydrogen(1+)", "common_name": "Proton, representing buffered proton equivalents", "inchi": null, "role": "starting", "environment_formed": null}, {"id": "mol_011", "formula": "Fe2+", "iupac_name": "iron(2+)", "common_name": "Ferrous iron", "inchi": "InChI=1S/Fe/q+2", "role": "intermediate", "environment_formed": "Biochemical"}, {"id": "mol_012", "formula": "SO3^2-", "iupac_name": "trioxidosulfate(2-)", "common_name": "Sulfite", "inchi": null, "role": "starting", "environment_formed": null}, {"id": "mol_013", "formula": "SO4^2-", "iupac_name": "tetraoxidosulfate(2-)", "common_name": "Sulfate", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_014", "formula": "NH3O", "iupac_name": "hydroxylamine", "common_name": "Hydroxylamine", "inchi": "InChI=1S/H3NO/c1-2/h2H,1H2", "role": "starting", "environment_formed": null}, {"id": "mol_015", "formula": "C5H7NO5", "iupac_name": "2-(hydroxyimino)pentanedioic acid", "common_name": "2-Oxoglutarate oxime", "inchi": null, "role": "intermediate", "environment_formed": "Biochemical"}, {"id": "mol_016", "formula": "CH2O", "iupac_name": "methanal", "common_name": "Formaldehyde", "inchi": "InChI=1S/CH2O/c1-2/h1H2", "role": "starting", "environment_formed": null}, {"id": "mol_017", "formula": "HCN", "iupac_name": "hydrogen cyanide", "common_name": "Hydrogen cyanide, representing the HCN/cyanide pool", "inchi": "InChI=1S/CHN/c1-2/h1H", "role": "starting", "environment_formed": null}, {"id": "mol_018", "formula": "C2H4N2", "iupac_name": "2-aminoethanenitrile", "common_name": "Aminoacetonitrile", "inchi": "InChI=1S/C2H4N2/c3-1-2-4/h1,3H2", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_019", "formula": "C2H5NO2", "iupac_name": "2-aminoacetic acid", "common_name": "Glycine", "inchi": "InChI=1S/C2H5NO2/c3-1-2(4)5/h1,3H2,(H,4,5)", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_020", "formula": "H5N2O2P", "iupac_name": "phosphorodiamidic acid", "common_name": "Diamidophosphate, represented by its neutral acid", "inchi": null, "role": "starting", "environment_formed": null}, {"id": "mol_021", "formula": "H3PO4", "iupac_name": "phosphoric acid", "common_name": "Orthophosphate reference form", "inchi": "InChI=1S/H3O4P/c1-5(2,3)4/h(H3,1,2,3,4)", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_022", "formula": "CO2", "iupac_name": "carbon dioxide", "common_name": "Carbon dioxide, exchanging with the bicarbonate pool", "inchi": "InChI=1S/CO2/c2-1-3", "role": "starting", "environment_formed": null}, {"id": "mol_023", "formula": "C6H8N2O4", "iupac_name": "3-(2,5-dioxoimidazolidin-4-yl)propanoic acid", "common_name": "5-(2-Carboxyethyl)hydantoin", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_024", "formula": "C3H4O", "iupac_name": "prop-2-enal", "common_name": "Acrolein", "inchi": "InChI=1S/C3H4O/c1-2-3-4/h2-3H,1H2", "role": "starting", "environment_formed": null}, {"id": "mol_025", "formula": "C5H6N2O", "iupac_name": "2-hydroxypentanedinitrile", "common_name": "3-Cyanopropanal cyanohydrin", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_026", "formula": "C5H7N3", "iupac_name": "2-aminopentanedinitrile", "common_name": "Glutamate aminodinitrile precursor", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_027", "formula": "CH4", "iupac_name": "methane", "common_name": "Methane", "inchi": "InChI=1S/CH4/h1H4", "role": "starting", "environment_formed": null}, {"id": "mol_028", "formula": "N2", "iupac_name": "dinitrogen", "common_name": "Nitrogen", "inchi": "InChI=1S/N2/c1-2", "role": "starting", "environment_formed": null}], "reactions": [{"id": "rxn_001", "name": "Hydrogen-driven C5 ketoacid construction from pyruvate and glyoxylate", "inputs": ["mol_004", "mol_005", "mol_002"], "outputs": ["mol_006", "mol_001"], "environment": "Biochemical", "agents": ["Supported metallic nickel for hydrogen activation and reductive carbon-skeleton growth"], "conditions": {"temperature": "295 K laboratory reference", "pressure": "5 bar H2", "catalyst": "Ni on silica-alumina", "aqueous": true, "other": "Anoxic, pH approximately 8, reaction-platform timescale up to 72 h. A 30 mM scale is representative of the cited platform, not an established optimum for both carbon-growth feeds. Cool pressurized mineral pores are a proposed environmental analogue."}, "mechanism": "Balanced net: C3H4O3 + C2H2O3 + H2 -> C5H6O5 + H2O. This multistep channel combines aldol carbon-carbon bond construction with reductive removal of an oxygen functionality; it is not represented as an elementary collision.", "reasoning": "Kaur et al. (2024) support H2/Ni-driven reductive-aldol ketoacid growth and compatible amino-acid formation. The supplied research identifies pyruvate/glyoxylate chemistry as an upstream solution to 2-oxoglutarate availability, but does not provide a quantitative yield for this isolated net channel. Consequently, carbon flux and selectivity remain unresolved. Both starting organic inventories must be supplied; downstream glyoxylate regeneration does not close their initial geochemical supply. No speculative mineral-independent carbon fixation step is inserted."}, {"id": "rxn_002", "name": "Nickel-catalyzed hydrogen reductive amination", "inputs": ["mol_006", "mol_003", "mol_002"], "outputs": ["mol_007", "mol_001"], "environment": "Biochemical", "agents": ["Supported metallic nickel"], "conditions": {"temperature": "295 K", "pressure": "5 bar H2", "catalyst": "Ni on silica-alumina", "aqueous": true, "other": "Anoxic, pH 8, approximately 30 mM ketoacid, ammonium bicarbonate nitrogen source, 72 h. The supplied study's substrate-panel ammonium range is 6-150 mM; that range is not a glutamate-specific optimization."}, "mechanism": "Balanced net: C5H6O5 + NH3 + H2 -> C5H9NO4 + H2O. Ammonia addition and dehydration establish a low-abundance imine/iminium pool; nickel activates H2 and reduces that pool.", "reasoning": "Kaur et al. (2024) directly include 2-oxoglutarate-to-glutamate conversion in the Ni/H2 substrate scope. H2 is the consumed reductant, while Ni is catalytic. Competing direct carbonyl hydrogenation produces hydroxyacid and prevents equating substrate conversion with glutamate yield. Mayer and Moran (2022) show that 2-oxoglutarate imine formation and reductive amination are intrinsically unfavorable relative to several other ketoacids. This branch has the strongest operating-condition compatibility with rxn_001, although end-to-end selective accumulation remains unquantified."}, {"id": "rxn_003", "name": "Meteoritic Fe/Ni-catalyzed hydrogen reductive amination", "inputs": ["mol_006", "mol_003", "mol_002"], "outputs": ["mol_007", "mol_001"], "environment": "Biochemical", "agents": ["Ground Aletai meteorite containing reactive Fe/Ni-rich metallic phases"], "conditions": {"temperature": "295 K", "pressure": "5 bar H2", "catalyst": "Reactive Fe/Ni-bearing phases in ground Aletai meteorite", "aqueous": true, "other": "Anoxic, pH 8, approximately 30 mM ketoacid, ammonium bicarbonate, 72 h. Activity depends on exposed metal area and cannot be assigned to an arbitrary weathered meteorite."}, "mechanism": "Balanced net: C5H6O5 + NH3 + H2 -> C5H9NO4 + H2O. Meteoritic metal activates hydrogen and reduces the imine/iminium formed from ammonia and 2-oxoglutarate.", "reasoning": "Kaur et al. (2024) experimentally demonstrate glutamate-producing activity using a natural meteoritic material. This is retained separately because naturally occurring Fe/Ni material addresses catalyst provenance differently from manufactured supported Ni. It is a catalyst variant of reductive amination, not an independent nitrogen-incorporation mechanism. Hydroxyacid formation competes. Transport of the upstream ketoacid into a meteorite-bearing receiving pore is conditional; neither arbitrary terrestrial mineral equivalence nor quantitative upstream-to-meteorite integration has been demonstrated."}, {"id": "rxn_004", "name": "Palladium-catalyzed formate transfer reductive amination", "inputs": ["mol_006", "mol_003", "mol_008"], "outputs": ["mol_007", "mol_022", "mol_001"], "environment": "Biochemical", "agents": ["Palladium on carbon"], "conditions": {"temperature": "Approximately 295 K", "pressure": "Approximately 1 bar inert atmosphere; external H2 is not required by the net reaction", "catalyst": "Pd/C", "aqueous": true, "other": "Anoxic, mildly alkaline medium near pH 8 and millimolar ketoacid. The supplied report establishes formate substitution in the Pd experiments but does not give its full branch-specific loading and timing; the H2 protocol must not be treated as an exact formate recipe."}, "mechanism": "Balanced net: C5H6O5 + NH3 + CH2O2 -> C5H9NO4 + CO2 + H2O. Oxidation of formate supplies two reducing equivalents for reduction of the ketoacid-derived iminium.", "reasoning": "Kaur et al. (2024) report replacement of H2 by formate in Pd-mediated amino-acid synthesis. This adds a chemically distinct electron-donor option without requiring an elaborate organic cofactor. Pd improves amino-acid versus hydroxyacid selectivity in the reported substrate panel, but the panel-wide values are not glutamate-specific yields. The geochemical implementation is conditional because accessible Pd-rich surfaces are much less common than Fe/Ni phases; manufactured Pd/C is experimental evidence, not an assumed ubiquitous Hadean mineral."}, {"id": "rxn_005", "name": "Reductive amination on partially electroreduced FeS", "inputs": ["mol_006", "mol_003", "mol_009", "mol_010"], "outputs": ["mol_007", "mol_001", "mol_011"], "environment": "Biochemical", "agents": ["Partially electroreduced FeS, treated as an expendable preconditioned reducing surface"], "conditions": {"temperature": "296-298 K", "pressure": "Approximately 1 bar during the aqueous conversion", "catalyst": null, "aqueous": true, "other": "Anoxic, pH approximately 9.6, 5 mM 2-oxoglutarate, ammonium in large excess, approximately 48 h. The laboratory surface was preconditioned near -0.7 V versus SHE for seven days. This is a cool mineral-interface implementation, not a 350-600 K reaction."}, "mechanism": "Balanced formal redox inventory: C5H6O5 + NH3 + Fe + 2 H+ -> C5H9NO4 + H2O + Fe2+. Here Fe -> Fe2+ represents one two-electron Fe(0)-equivalent of reducing capacity in the prepared surface; it does not identify the entire nonstoichiometric solid as native iron. Buffered proton equivalents do not imply an acidic pH.", "reasoning": "Kitadai et al. (2019) report nearly complete glutamate conversion using partially electroreduced FeS under alkaline, near-room-temperature conditions. The yield belongs to that prepared material, not to ordinary FeS or an arbitrary mass of native Fe. Because the supplied evidence does not resolve the complete solid-phase oxidation inventory, the displayed equation is explicitly formal rather than a fully species-resolved mineral mechanism. Natural production and regeneration of the required reduced surface remain unproven; this route cannot claim an autonomous catalytic cycle."}, {"id": "rxn_006", "name": "ZnS photocatalytic reductive amination with sulfite", "inputs": ["mol_006", "mol_003", "mol_012"], "outputs": ["mol_007", "mol_013"], "environment": "Surface", "agents": ["Illuminated colloidal ZnS semiconductor"], "conditions": {"temperature": "Near ambient; 298-303 K is a proposed environmental implementation window", "pressure": "Approximately 1 bar", "catalyst": "ZnS photocatalyst", "aqueous": true, "other": "Anoxic, pH approximately 9, large ammonium excess, four-hour experimental observation window, UV or near-UV illumination reaching the ZnS. Sulfite is a consumed hole scavenger. Exact temperature, photon flux and sulfite loading are not specified in the supplied summary."}, "mechanism": "Balanced net redox channel: C5H6O5 + NH3 + SO3^2- -> C5H9NO4 + SO4^2-. Photoexcited ZnS transfers electrons to the imine/iminium pool, while sulfite oxidation supplies the corresponding two-electron donor half-reaction. No molecular oxygen is required.", "reasoning": "Wang et al. (2012) report approximately 0.5% glutamate after four hours without sulfite and roughly sixfold enhancement with sulfite. Light-only and dark-ZnS controls support the semiconductor's role. Sulfate is the formal fully oxidized sulfur endpoint used to close this net equation, not a claim that it was the exclusive measured sulfur product. Strong surface UV is useful here, but low yield, photon access, ammonium excess and competition in an unpurified upstream mixture remain important limitations."}, {"id": "rxn_007", "name": "Condensation of hydroxylamine with 2-oxoglutarate", "inputs": ["mol_006", "mol_014"], "outputs": ["mol_015", "mol_001"], "environment": "Biochemical", "agents": null, "conditions": {"temperature": "343 K reference temperature for the reported iron-driven network", "pressure": "Approximately 1 bar", "catalyst": null, "aqueous": true, "other": "Anoxic aqueous mineral-interface chemistry. Hydroxylamine is externally supplied. The supplied report does not specify a separately optimized oxime-formation pH, concentration or rate, so none is assigned as an experimental fact."}, "mechanism": "Balanced net: C5H6O5 + NH3O -> C5H7NO5 + H2O. Hydroxylamine adds to the keto group and the adduct dehydrates to the oxime; oxime geometry is unspecified.", "reasoning": "Muchowska, Varma and Moran (2019) support an oxime-mediated route from ketoacids to amino acids, including glutamate. Their integrated precursor network is Fe-promoted; it is not identical to the Ni/H2 upstream module used here. Accordingly, receiving-solution compatibility after rxn_001 remains conditional. Kitadai et al. (2019) identify uncertain Hadean hydroxylamine availability as a substantive limitation. No unsupported hydroxylamine synthesis step is added merely to conceal that dependency."}, {"id": "rxn_008", "name": "Four-electron reduction of the 2-oxoglutarate oxime", "inputs": ["mol_015", "mol_009", "mol_010"], "outputs": ["mol_007", "mol_001", "mol_011"], "environment": "Biochemical", "agents": ["Zero-valent iron as a stoichiometric reductant"], "conditions": {"temperature": "343 K reference temperature", "pressure": "Approximately 1 bar", "catalyst": null, "aqueous": true, "other": "Anoxic; reactive Fe(0) must provide at least two Fe-to-Fe(II) equivalents per oxime for the displayed channel. Actual loadings can be higher because of passivation and competing corrosion. Exact branch-specific pH and time are not supplied in the research summary."}, "mechanism": "Balanced net: C5H7NO5 + 2 Fe + 4 H+ -> C5H9NO4 + H2O + 2 Fe2+. Reduction of the C=N functionality and cleavage of the N-O bond require four electrons overall.", "reasoning": "Muchowska, Varma and Moran (2019) experimentally support hydroxylamine/Fe(0) production of glutamate and reduction through oxime intermediates. Two Fe atoms, not one, are required for the stated four-electron bookkeeping when Fe(II) is the oxidation endpoint. Ferrous iron may subsequently complex or precipitate; it is an oxidation-state inventory rather than a claim of exclusively free aqueous Fe2+. The integrated Fe-network evidence does not establish identical performance after transfer from a Ni-containing precursor mixture."}, {"id": "rxn_009", "name": "Strecker formation of the glycine aminonitrile precursor", "inputs": ["mol_016", "mol_003", "mol_017"], "outputs": ["mol_018", "mol_001"], "environment": "Surface", "agents": null, "conditions": {"temperature": "298-310 K proposed implementation window", "pressure": "Approximately 1 bar", "catalyst": null, "aqueous": true, "other": "Proposed concentrated pool at pH approximately 8-9 with retained ammonia and cyanide. Shallow burial or mineral shading limits destructive UV exposure. Concentration and residence time are design variables, not values demonstrated for this integrated route in the supplied research."}, "mechanism": "Balanced net: CH2O + NH3 + HCN -> C2H4N2 + H2O. Formaldehyde/ammonia condensation produces an imine or iminium species that is trapped by cyanide.", "reasoning": "This is established Strecker reaction logic, consistent with the cyanide/aldehyde framework discussed by Van Trump and Miller (1972). Pulletikurti et al. (2022) also identify aminoacetonitrile as relevant to glutamate-forming nitrogen-transfer chemistry. However, the supplied research does not directly demonstrate this exact upstream glycine preparation connected to rxn_011: its operating window and network integration are speculative. No yield or quantitative delivery efficiency is assigned."}, {"id": "rxn_010", "name": "Hydrolysis of aminoacetonitrile to glycine", "inputs": ["mol_018", "mol_001"], "outputs": ["mol_019", "mol_003"], "environment": "Surface", "agents": ["Hydronium for acid-catalyzed nitrile hydrolysis"], "conditions": {"temperature": "353-370 K proposed hydrolysis window", "pressure": "Approximately 1 bar", "catalyst": "Aqueous acid", "aqueous": true, "other": "Proposed local acidic reservoir, pH approximately 1-2, with days-to-weeks residence and sustained water activity. This is a testable environmental scenario, not a literature-validated completion time from the supplied report. Residual free cyanide must not simply be carried into the subsequent Al(III) stage."}, "mechanism": "Balanced reference-form net: C2H4N2 + 2 H2O -> C2H5NO2 + NH3. The nitrile hydrolyzes through an amide; released ammonia is predominantly ammonium under the proposed acidic conditions.", "reasoning": "Nitrile hydrolysis is the release step of the Strecker framework discussed by Van Trump and Miller (1972). The exact aminoacetonitrile hydrolysis protocol needed here is not established in the supplied research, so its proposed mild-environment rate is explicitly speculative. Complete conversion must be measured rather than assumed from aminonitrile disappearance. Conditioning to the hotter, moderately acidic, concentrated Al(III) transamination medium is a separate requirement."}, {"id": "rxn_011", "name": "Aluminum-assisted glycine-to-2-oxoglutarate transamination", "inputs": ["mol_006", "mol_019"], "outputs": ["mol_007", "mol_005"], "environment": "Surface", "agents": ["Soluble Al(III) salt, such as potassium aluminum sulfate"], "conditions": {"temperature": "Approximately 353 K", "pressure": "Approximately 1 bar", "catalyst": "Al(III) Lewis-acid promoter", "aqueous": true, "other": "Hot acidic concentrated solution. The related confirmation used 0.2 M 2-oxoglutarate, pH 5 and 44 h; glycine is supplied as amino donor. These values must not be conflated with every detail of the original 44% yield experiment."}, "mechanism": "Balanced net: C5H6O5 + C2H5NO2 -> C5H9NO4 + C2H2O3. Metal-assisted Schiff-base chemistry transfers the amino group from glycine to 2-oxoglutarate, yielding glyoxylate without an external reductant.", "reasoning": "Stubbs et al. (2020) report 44% glutamate in Al(III)-assisted hot acidic transamination. Pulletikurti et al. (2022) provide related confirmation at 0.2 M substrate, pH 5 and 80 degrees C. The amino-acid-forming step is not metal-free. Concentration, available Al(III), and separation or conditioning of cyanide-containing and Ni-containing feeds are necessary; carbonate or hydroxide precipitation can reduce promoter availability. Glyoxylate is regenerated here but cannot serve as the initial upstream seed."}, {"id": "rxn_012", "name": "Diamidophosphate deamidation as an ammonia-source inventory", "inputs": ["mol_020", "mol_001"], "outputs": ["mol_003", "mol_021"], "environment": "Surface", "agents": null, "conditions": {"temperature": "Approximately 298 K", "pressure": "Approximately 1 bar", "catalyst": null, "aqueous": true, "other": "Coupled to rxn_013 in the same pH 8.5, approximately 0.5 M bicarbonate mixture. The optimized preparation used approximately 0.7 M DAP and a 21-day formation period. This node is not an independently measured complete-hydrolysis stage."}, "mechanism": "Balanced ultimate deamidation inventory: H5N2O2P + 2 H2O -> 2 NH3 + H3PO4. Actual release can proceed through partially hydrolyzed phosphoramidates; orthophosphate denotes the terminal reference-form phosphorus pool.", "reasoning": "Pulletikurti et al. (2022) use DAP as an ammonia source in the optimized hydantoin preparation. The observed coupled preparation supports sufficient nitrogen delivery under that formulated mixture, but does not independently establish complete DAP hydrolysis, its time-dependent release profile, or exclusive orthophosphate production. Accordingly, rxn_012 and rxn_013 are coupled bookkeeping modules rather than experimentally resolved consecutive kinetic stages. Prebiotic DAP supply remains external and conditional."}, {"id": "rxn_013", "name": "Bucherer-Bergs construction of carboxyethylhydantoin", "inputs": ["mol_006", "mol_017", "mol_003", "mol_022"], "outputs": ["mol_023", "mol_001", "mol_022"], "environment": "Surface", "agents": null, "conditions": {"temperature": "Approximately 298 K", "pressure": "Approximately 1 bar", "catalyst": null, "aqueous": true, "other": "pH 8.5; 0.35 M 2-oxoglutarate, approximately 0.42 M cyanide, 0.7 M DAP supplied jointly with rxn_012, and 0.5 M bicarbonate; 21 days. Such simultaneous concentrations require an unproven concentration and retention mechanism."}, "mechanism": "Balanced net with explicit carbon-dioxide exchange: C5H6O5 + HCN + NH3 + CO2 -> C6H8N2O4 + H2O + CO2. Cyanide/ammonia addition, carbamylation, cyclization and decarboxylative processing build the hydantoin. CO2 participates in gross carbon exchange but cancels from the net inventory; this equation is not an isotope atom map.", "reasoning": "Pulletikurti et al. (2022) report 96% carboxyethylhydantoin under the optimized DAP/cyanide/bicarbonate conditions. That is protected-skeleton yield, not free-glutamate yield. The balanced net does not eliminate bicarbonate's mechanistic and buffering roles. The experiment strongly supports this concentrated module, while natural co-concentration of 2-oxoglutarate, cyanide and DAP, together with compatible ammonia-release kinetics, remains unresolved."}, {"id": "rxn_014", "name": "Hydantoin hydrolysis and release of free glutamate", "inputs": ["mol_023", "mol_001"], "outputs": ["mol_007", "mol_022", "mol_003"], "environment": "Surface", "agents": null, "conditions": {"temperature": "353 K", "pressure": "Approximately 1 bar", "catalyst": null, "aqueous": true, "other": "Heat the preceding concentrated preparation for an additional 14 days. Maintain water activity; the preparation begins from the alkaline bicarbonate-buffered mixture. No quantitative separate rate is assigned to ring opening versus decarbamylation."}, "mechanism": "Balanced overall hydrolysis: C6H8N2O4 + 2 H2O -> C5H9NO4 + CO2 + NH3. Ring opening gives carbamoylated intermediates, followed by hydrolytic removal of the carbamoyl group.", "reasoning": "Pulletikurti et al. (2022) report 19% glutamate after 14 days at 80 degrees C, with 72% hydantoin remaining. Thus release of free glutamate, not construction of its protected skeleton, is the demonstrated bottleneck. This node combines unresolved hydrolysis substeps and does not assign each an independently measured rate. Geological residence or cycling could increase release, but improved natural yields are not established by the experiment."}, {"id": "rxn_015", "name": "Two cyanide additions convert acrolein into a cyanohydrin reservoir", "inputs": ["mol_024", "mol_017"], "outputs": ["mol_025"], "environment": "Surface", "agents": null, "conditions": {"temperature": "Approximately 298 K", "pressure": "Approximately 1 bar", "catalyst": null, "aqueous": true, "other": "Approximately 140 mM acrolein and 700 mM KCN, pH 9.2. The reservoir must retain cyanide and limit competing acrolein polymerization. Cyanide is a consumed reagent, not a mineral catalyst."}, "mechanism": "Balanced net: C3H4O + 2 HCN -> C5H6N2O. Conjugate cyanide addition yields the 3-cyanopropanal framework, followed by carbonyl cyanohydrin formation. The transient free aldehyde is not introduced as a fictitiously isolated product.", "reasoning": "Van Trump and Miller (1972) identify acrolein chemistry as a route toward glutamate. Fern\u00e1ndez-Garc\u00eda, Grefenstette and Powner (2017), as summarized in the supplied research, provide approximately 95% formation of the associated cyanohydrin under concentrated aqueous cyanide conditions. This high value concerns the cyanohydrin reservoir, not glutamate. Acrolein and cyanide supply, concentration and retention remain conditional."}, {"id": "rxn_016", "name": "Strecker conversion of the cyanohydrin reservoir to an aminodinitrile", "inputs": ["mol_025", "mol_003"], "outputs": ["mol_026", "mol_001"], "environment": "Surface", "agents": null, "conditions": {"temperature": "298-310 K proposed implementation window", "pressure": "Approximately 1 bar", "catalyst": null, "aqueous": true, "other": "Ammonia-rich cyanide-containing receiving solution, approximately pH 8-9 as a proposed operating window. The supplied report does not establish an optimized glutamate-aminodinitrile concentration, yield or residence time."}, "mechanism": "Balanced net: C5H6N2O + NH3 -> C5H7N3 + H2O. The cyanohydrin reversibly releases the aldehyde and HCN; aldehyde/ammonia condensation forms an imine that is trapped by cyanide. This is not an assumed direct displacement of hydroxide by ammonia.", "reasoning": "Van Trump and Miller (1972) support the acrolein-to-glutamate Strecker proposal, while Fern\u00e1ndez-Garc\u00eda et al. (2017) support the preceding aldehyde/cyanohydrin chemistry. The supplied evidence does not quantify this exact reservoir-to-aminodinitrile conversion. Its selected operating window and efficiency are therefore explicitly speculative. Equilibrium partitioning, competing polymerization and ammonia retention must be measured before treating rxn_015's high yield as transferable to this step."}, {"id": "rxn_017", "name": "Exhaustive hydrolysis of both nitriles to free glutamate", "inputs": ["mol_026", "mol_001"], "outputs": ["mol_007", "mol_003"], "environment": "Surface", "agents": ["Hydronium for acid-catalyzed nitrile and amide hydrolysis"], "conditions": {"temperature": "353-370 K proposed environmental hydrolysis window", "pressure": "Approximately 1 bar", "catalyst": "Aqueous acid", "aqueous": true, "other": "Proposed local pH 1-2 reservoir, days-to-weeks or longer, with sustained water activity. The supplied studies do not establish complete hydrolysis on this timescale. Acidification of the preceding cyanide-rich mixture requires cyanide-loss and safety-aware experimental controls."}, "mechanism": "Balanced reference-form net: C5H7N3 + 4 H2O -> C5H9NO4 + 2 NH3. Both nitriles must pass through amide-containing intermediates and reach carboxyl groups; stopping after partial hydrolysis does not deliver free glutamate.", "reasoning": "The endpoint follows the acrolein/Strecker framework of Van Trump and Miller (1972) and the later cyanide chemistry discussed by Fern\u00e1ndez-Garc\u00eda et al. (2017). The supplied evidence specifically warns that partial hydrolysis can retain glutamine-related or other amide products. Consequently, efficient free-glutamate release under the proposed mild environmental conditions is speculative, not established by the cyanohydrin result. This is the principal release bottleneck of the alpha-ketoglutarate-independent molecular route."}, {"id": "rxn_018", "name": "Electric-discharge access to glutamate from simple gas-water feedstocks", "inputs": ["mol_027", "mol_028", "mol_003", "mol_001"], "outputs": ["mol_007", "mol_002"], "environment": "Surface", "agents": null, "conditions": {"temperature": "Near-ambient collection water; 298-323 K is a proposed collector window, not a reported Ring apparatus specification", "pressure": "Approximately ambient gas-water apparatus; exact original pressure is not supplied in the research summary", "catalyst": null, "aqueous": true, "other": "Reducing CH4/N2 atmosphere contacting water with trace ammonia, energized by electrical discharge. The spark channel experiences transient temperatures far above the collector temperature. Discharge power, residence time and any product work-up must follow the original study before quantitative reproduction is claimed."}, "mechanism": "Atom- and charge-balanced formal product-channel inventory: 15 CH4 + N2 + NH3 + 12 H2O -> 3 C5H9NO4 + 30 H2. This is a lumped reachability node for a complex radical, carbonyl, cyanide and aqueous network. The coefficients provide a conservation-valid reference channel; they are not measured gas-consumption ratios, an established partition of nitrogen sources, or a measured H2/glutamate yield.", "reasoning": "Ring, Wolman, Friedmann and Miller (1972) directly identified glutamic acid in discharge products by ion-exchange chromatography and GC-MS. The explicit reference equation conserves C, H, N and O and corrects the conservation defect of an unspecified lumped edge. Nevertheless, the complete molecular mechanism and product distribution remain unresolved. Schlesinger and Miller (1983) show strong suppression of diverse amino-acid synthesis in insufficiently reducing atmospheres. This branch establishes qualitative access from simple feedstocks, not selective or continuously productive glutamate synthesis."}], "pathways": [{"pathway_id": "P1", "name": "Integrated H2/Ni carbon growth and reductive amination", "description": "Externally supplied pyruvate and initial glyoxylate form the C5 ketoacid, followed by Ni/H2 reductive amination. The common pH, temperature and hydrogen platform makes this the best-supported compatibility option, but neither quantitative carbon closure nor selective free-glutamate accumulation from the initial mixture is established.", "reaction_sequence": ["rxn_001", "rxn_002"], "key_intermediates": ["mol_006"]}, {"pathway_id": "P2", "name": "Carbon-growth feed followed by natural meteoritic-metal amination", "description": "The C5 ketoacid reaches a receiving pore containing reactive meteoritic Fe/Ni material and hydrogen. This is a natural-catalyst alternative to P1. Transfer and retention are conditional; the pathway does not claim that every meteorite duplicates Aletai activity or that the precursor-growth experiment used the same meteorite.", "reaction_sequence": ["rxn_001", "rxn_003"], "key_intermediates": ["mol_006"]}, {"pathway_id": "P3", "name": "Formate-supported transfer reductive amination", "description": "After carbon-skeleton construction, formate supplies reducing equivalents to a Pd-mediated amination branch. This relaxes the need for H2 at the final step but substitutes a rare-catalyst accessibility requirement and an externally supplied formate inventory.", "reaction_sequence": ["rxn_001", "rxn_004"], "key_intermediates": ["mol_006"]}, {"pathway_id": "P4", "name": "Prepared reduced-FeS surface amination", "description": "The C5 feed is cooled and adjusted to the alkaline receiving conditions of the partially electroreduced FeS experiment. High laboratory conversion is supported, but surface preparation, mineral redox inventory and natural regeneration remain conditional. The Fe/Fe2+ equation is formal electron accounting, not identification of the entire solid.", "reaction_sequence": ["rxn_001", "rxn_005"], "key_intermediates": ["mol_006"]}, {"pathway_id": "P5", "name": "Illuminated ZnS and sulfite amination", "description": "The C5 ketoacid enters a light-exposed ZnS-bearing receiving solution with ammonia and sulfite. Photon access, donor supply and low measured glutamate yield distinguish this route from dark metal/H2 chemistry. Transfer from the pressurized precursor module is conditional rather than an established one-pot operation.", "reaction_sequence": ["rxn_001", "rxn_006"], "key_intermediates": ["mol_006"]}, {"pathway_id": "P6", "name": "Oxime capture followed by Fe(0) reduction", "description": "The C5 ketoacid captures externally supplied hydroxylamine, and the resulting oxime undergoes four-electron reduction by Fe(0). The oxime chemistry is experimentally supported, but compatibility of the present Ni-derived precursor mixture with the reported Fe-driven module requires testing.", "reaction_sequence": ["rxn_001", "rxn_007", "rxn_008"], "key_intermediates": ["mol_006", "mol_015"]}, {"pathway_id": "P7", "name": "Strecker-derived glycine followed by transamination", "description": "A formaldehyde/cyanide branch supplies glycine, while the separate carbon-growth branch supplies 2-oxoglutarate. After hydrolysis, residual-cyanide removal or depletion, pH adjustment and concentration, Al(III)-assisted transamination forms glutamate and regenerates glyoxylate. The sequence lists preparation of both required feeds before their convergence; it is not a single unconditioned flask.", "reaction_sequence": ["rxn_009", "rxn_010", "rxn_001", "rxn_011"], "key_intermediates": ["mol_018", "mol_019", "mol_006"]}, {"pathway_id": "P8", "name": "DAP-supported Bucherer-Bergs hydantoin reservoir", "description": "Concentrated 2-oxoglutarate enters the DAP/cyanide/bicarbonate module, with rxn_012 and rxn_013 representing coupled ammonia-source and hydantoin-formation accounting. Prolonged hot hydrolysis then releases some free glutamate. The approximately 96% protected-intermediate yield must not be substituted for the approximately 19% glutamate yield.", "reaction_sequence": ["rxn_001", "rxn_012", "rxn_013", "rxn_014"], "key_intermediates": ["mol_006", "mol_023"]}, {"pathway_id": "P9", "name": "Acrolein-cyanide route independent of 2-oxoglutarate", "description": "Acrolein and cyanide form a cyanohydrin reservoir, which can access an aminodinitrile by aldehyde/imine equilibration and Strecker trapping. Exhaustive hydrolysis of both nitriles is required for glutamate. The reservoir formation is strongly supported; aminodinitrile delivery and complete environmentally mild hydrolysis are less securely established.", "reaction_sequence": ["rxn_015", "rxn_016", "rxn_017"], "key_intermediates": ["mol_025", "mol_026"]}, {"pathway_id": "P10", "name": "Reducing-atmosphere electrical-discharge synthesis", "description": "Methane, nitrogen, water and trace ammonia access glutamate through an experimentally observed but molecularly unresolved discharge network. This is the simplest-feedstock pathway in the graph. Its balanced reference channel repairs elemental bookkeeping without claiming a selective reaction, measured stoichiometric gas ratio or glutamate-specific productivity.", "reaction_sequence": ["rxn_018"], "key_intermediates": []}], "hub_molecules": ["mol_001", "mol_002", "mol_003", "mol_005", "mol_006", "mol_007", "mol_009", "mol_010", "mol_011", "mol_017", "mol_022"], "convergence_points": [{"molecule_id": "mol_006", "incoming_reactions": ["rxn_001"], "outgoing_reactions": ["rxn_002", "rxn_003", "rxn_004", "rxn_005", "rxn_006", "rxn_007", "rxn_011", "rxn_013"]}, {"molecule_id": "mol_007", "incoming_reactions": ["rxn_002", "rxn_003", "rxn_004", "rxn_005", "rxn_006", "rxn_008", "rxn_011", "rxn_014", "rxn_017", "rxn_018"], "outgoing_reactions": []}, {"molecule_id": "mol_003", "incoming_reactions": ["rxn_010", "rxn_012", "rxn_014", "rxn_017"], "outgoing_reactions": ["rxn_002", "rxn_003", "rxn_004", "rxn_005", "rxn_006", "rxn_009", "rxn_013", "rxn_016", "rxn_018"]}, {"molecule_id": "mol_005", "incoming_reactions": ["rxn_011"], "outgoing_reactions": ["rxn_001"]}, {"molecule_id": "mol_002", "incoming_reactions": ["rxn_018"], "outgoing_reactions": ["rxn_001", "rxn_002", "rxn_003"]}, {"molecule_id": "mol_022", "incoming_reactions": ["rxn_004", "rxn_013", "rxn_014"], "outgoing_reactions": ["rxn_013"]}]}, "reasoning": "", "duration_ms": 536800.5976676941, "success": true, "error_message": null}
