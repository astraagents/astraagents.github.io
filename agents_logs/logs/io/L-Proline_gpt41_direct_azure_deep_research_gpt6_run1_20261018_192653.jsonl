ditions\": {\n        \"temperature\": \"300\u2013320K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"borosilicate/glass surface\",\n        \"aqueous\": true,\n        \"other\": \"electric discharge, reducing gas atmosphere\"\n      },\n      \"mechanism\": \"High-energy discharge forms C- and N-radicals, which couple through multi-step condensations into amino acids including proline and glycine.\",\n      \"reasoning\": \"Experimentally demonstrated by Ring et al. (1972), Criado-Reyes et al. (2021); low abundance, non-specific mechanism, racemic. Atom balance approximated due to complexity; proline/glycine yield modest.\"\n    },\n    {\n      \"id\": \"rxn_010\",\n      \"name\": \"Direct hydrothermal HCN/HCHO/NH4+ Strecker pathway to proline\",\n      \"inputs\": [\"mol_001\", \"mol_012\", \"mol_021\"],\n      \"outputs\": [\"mol_023\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"pyrite\u2013pyrrhotite\u2013magnetite\", \"heat\"],\n      \"conditions\": {\n        \"temperature\": \"420\u2013440K\",\n        \"pressure\": \"10 bar\",\n        \"catalyst\": \"FeS/Fe3O4\",\n        \"aqueous\": true,\n        \"other\": \"industrial hydrothermal vent conditions\"\n      },\n      \"mechanism\": \"Multi-component Strecker-type reaction under hydrothermal conditions, mineral redox catalysis forms amino acids including proline.\",\n      \"reasoning\": \"Directly supported by Hennet et al. (1992), Marshall (1994). Atom balance reconstructed for pathway feedstocks.\"\n    },\n    {\n      \"id\": \"rxn_011\",\n      \"name\": \"Thermal formaldehyde\u2013ammonia condensation (Fox\u2013Windsor)\",\n      \"inputs\": [\"mol_012\", \"mol_003\", \"mol_014\"],\n      \"outputs\": [\"mol_023\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"heat\"],\n      \"conditions\": {\n        \"temperature\": \"450K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"ther