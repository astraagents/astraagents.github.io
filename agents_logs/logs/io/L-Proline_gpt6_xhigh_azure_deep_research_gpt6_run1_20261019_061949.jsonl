ull\n    },\n    {\n      \"id\": \"mol_022\",\n      \"formula\": \"C3H6O2\",\n      \"iupac_name\": \"3-hydroxypropanal\",\n      \"common_name\": \"beta-hydroxypropionaldehyde\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_023\",\n      \"formula\": \"C3H4O\",\n      \"iupac_name\": \"prop-2-enal\",\n      \"common_name\": \"acrolein\",\n      \"inchi\": \"InChI=1S/C3H4O/c1-2-3-4/h2-3H,1H2\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_024\",\n      \"formula\": \"CH4\",\n      \"iupac_name\": \"methane\",\n      \"common_name\": \"methane\",\n      \"inchi\": \"InChI=1S/CH4/h1H4\",\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_025\",\n      \"formula\": \"N2\",\n      \"iupac_name\": \"dinitrogen\",\n      \"common_name\": \"nitrogen\",\n      \"inchi\": \"InChI=1S/N2/c1-2\",\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_026\",\n      \"formula\": \"H2\",\n      \"iupac_name\": \"dihydrogen\",\n      \"common_name\": \"hydrogen\",\n      \"inchi\": \"InChI=1S/H2/h1H\",\n      \"role\": \"hub_intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_027\",\n      \"formula\": \"CH2O2\",\n      \"iupac_name\": \"methanoic acid\",\n      \"common_name\": \"formic acid\",\n      \"inchi\": \"InChI=1S/CH2O2/c2-1-3/h1H,(H,2,3)\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Hydrothermal\"\n    },\n    {\n      \"id\": \"mol_028\",\n      \"formula\": \"H3NO\",\n      \"iupac_name\": \"hydroxylamine\",\n      \"common_name\": \"hydroxylamine\",\n      \"inchi\": \"InChI=1S/H3NO/c1-2/h2H,1H2\",\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    }\n  ],\n  \"reactions\": [\n    {\n      \"id\": \"rxn_001\",\n      \"name\": \"Copper-mediated hydrocyanation of acetylene\",\n      \"inputs\": [\"mol_001\", \"mol_002\"],\n      \"outputs\": [\"mol_006\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"aqueous Cu(I) chloride/cyanide complexes\"],\n      \"conditions\": {\n        \"temperature\": \"330-365 K\",\n        \"pressure\": \"approximately 1 atm\",\n        \"catalyst\": \"aqueous Cu(I) complexes\",\n        \"aqueous\": true,\n        \"other\": \"Anoxic gas-water contact in a warm surface reservoir; acetylene and HCN must be supplied and retained. Copper ligation and competing precipitation require control.\"\n      },\n      \"mechanism\": \"Copper-mediated addition of HCN across the acetylene triple bond generates acrylonitrile.\",\n      \"reasoning\": \"This supplies the C3 nitrile entry to the proline branch described by Patel et al. (2015). Copper is assigned because it participates in the relevant nitrile-generating chemistry, not because copper minerals universally catalyze prebiotic reactions. Natural acetylene supply, HCN retention and soluble copper availability remain unresolved integration requirements.\"\n    },\n    {\n      \"id\": \"rxn_002\",\n      \"name\": \"Ammonia conjugate addition to acrylonitrile\",\n      \"inputs\": [\"mol_006\", \"mol_003\"],\n      \"outputs\": [\"mol_007\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-330 K\",\n        \"pressure\": \"approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Ammonia-rich solution, approximately pH 9-10; staged substrate supply limits competing oligomerization and repeated cyanoethylation.\"\n      },\n      \"mechanism\": \"Aza-Michael addition installs a terminal amino group while retaining the nitrile.\",\n      \"reasoning\": \"Patel et al. (2015) report approximately 83% conversion in the experimentally optimized acrylonitrile-to-beta-aminopropionitrile segment. Ammonia is a consumed reactant rather than a mineral catalyst. The reported segment yield is not an uninterrupted environmental pathway yield.\"\n    },\n    {\n      \"id\": \"rxn_003\",\n      \"name\": \"Sulfide-driven photoreductive conversion of aminonitrile to aminoaldehyde\",\n      \"inputs\": [\"mol_007\", \"mol_005\", \"mol_004\"],\n      \"outputs\": [\"mol_008\", \"mol_003\", \"mol_018\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Cu(I)/Cu(II) cyanide photoredox complexes\"],\n      \"conditions\": {\n        \"temperature\": \"300-320 K\",\n        \"pressure\": \"approximately 1 atm\",\n        \"catalyst\": \"copper cyanide photoredox complexes\",\n        \"aqueous\": true,\n        \"other\": \"Anoxic UV-irradiated shallow water, approximately pH 7-9. H2S represents the protonation-state-normalized H2S/HS- reagent reservoir; sulfide is consumed as reducing power.\"\n      },\n      \"mechanism\": \"Photoreduction of the nitrile to an imine is followed by hydrolysis, producing 3-aminopropanal and ammonia.\",\n      \"reasoning\": \"The approximately 45% aminoaldehyde conversion reported by Patel et al. (2015) supports this carbon-skeleton transformation. Copper-mediated electron transfer and sulfide consumption are distinguished. Disulfane is a speculative, atom-balanced representation of an initial oxidized-sulfur product, not an experimentally established exclusive coproduct; actual sulfur can partition among polysulfides and elemental sulfur. Over-reduction, copper sulfide precipitation and aldehyde instability require testing.\"\n    },\n    {\n      \"id\": \"rxn_004\",\n      \"name\": \"Cyanohydrin homologation of 3-aminopropanal\",\n      \"inputs\": [\"mol_008\", \"mol_001\"],\n      \"outputs\": [\"mol_009\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-320 K\",\n        \"pressure\": \"approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Approximately pH 6-8 with prompt cyanide trapping of freshly generated aminoaldehyde; avoid prolonged storage of the free aldehyde.\"\n      },\n      \"mechanism\": \"Cyanide addition to the aldehyde carbonyl, followed by proton transfer, produces a C4 cyanohydrin.\",\n      \"reasoning\": \"Patel et al. (2015) report essentially quantitative cyanohydrin formation in this segment. This is a defined carbon-chain extension, not an ordinary Strecker shortcut directly to proline. Achiral conditions do not impose an L-directed stereochemical bias.\"\n    },\n    {\n      \"id\": \"rxn_005\",\n      \"name\": \"Sulfide addition to the cyanohydrin nitrile\",\n      \"inputs\": [\"mol_009\", \"mol_005\"],\n      \"outputs\": [\"mol_010\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-340 K\",\n        \"pressure\": \"approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Approximately pH 7-9 with available hydrosulfide. Sulfur incorporation is stoichiometric; competing thioamide products are not assumed absent.\"\n      },\n      \"mechanism\": \"Hydrosulfide attacks the nitrile, followed by proton transfers and tautomerization to the alpha-hydroxythioamide.\",\n      \"reasoning\": \"The hydroxythioamide manifold is experimentally supported by Patel et al. (2015). The node identifies the linear species required for the ring-forming branch without implying that it was the only sulfur-containing product or that all material entered the proline pathway.\"\n    },\n    {\n      \"id\": \"rxn_006\",\n      \"name\": \"Intramolecular thioamide substitution forming the five-membered ring\",\n      \"inputs\": [\"mol_010\"],\n      \"outputs\": [\"mol_011\", \"mol_003\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-340 K\",\n        \"pressure\": \"approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Mildly buffered aqueous conditions permitting a nucleophilic terminal amino group; intramolecular capture must compete with intermolecular condensation.\"\n      },\n      \"mechanism\": \"The terminal amino group attacks the thioamide carbon, and loss of ammonia closes a five-membered thiolactam ring.\",\n      \"reasoning\": \"Patel et al. (2015) identify cyclization within this thioamide manifold. This step explicitly solves proline's ring-construction requirement. It is not inferred merely from a generic amino-acid-forming Strecker reaction.\"\n    },\n    {\n      \"id\": \"rxn_007\",\n      \"name\": \"Photoreductive deoxygenation of the cyclic hydroxythioamide\",\n      \"inputs\": [\"mol_011\", \"mol_005\"],\n      \"outputs\": [\"mol_012\", \"mol_004\", \"mol_018\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-320 K\",\n        \"pressure\": \"approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Anoxic UV/sulfide photochemistry. No specific mineral catalyst is assigned from the supplied evidence; irradiation and reagent ordering must follow a validated photochemical protocol.\"\n      },\n      \"mechanism\": \"Net reductive removal of the alpha-hydroxyl group generates gamma-butyrothiolactam, with water release.\",\n      \"reasoning\": \"Formation of gamma-butyrothiolactam through irradiation/reduction is part of the experimentally tracked branch in Patel et al. (2015). The detailed radical sequence and natural reactor performance are not established here. Disulfane is a speculative redox-bookkeeping coproduct rather than a claimed isolated product.\"\n    },\n    {\n      \"id\": \"rxn_008\",\n      \"name\": \"Photoreductive desulfurization to a transient cyclic imine\",\n      \"inputs\": [\"mol_012\", \"mol_005\"],\n      \"outputs\": [\"mol_013\", \"mol_018\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-320 K\",\n        \"pressure\": \"approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Anoxic UV irradiation with sulfide, followed promptly by cyanide capture. A persistent isolated 1-pyrroline reservoir is not assumed.\"\n      },\n      \"mechanism\": \"Net reduction and sulfur removal from the cyclic thioamide gives an imine/iminium intermediate that can be trapped by cyanide.\",\n      \"reasoning\": \"Patel et al. (2015) support the combined thiolactam-to-proline-aminonitrile sequence. The explicit 1-pyrroline node is a mechanistically inferred transient, not a separately quantified isolated endpoint in the supplied report. Its separation into this reaction and rxn_009 is therefore a model-level mechanistic interpretation. Disulfane is an unvalidated sulfur-balance closure.\"\n    },\n    {\n      \"id\": \"rxn_009\",\n      \"name\": \"Cyanide capture of the cyclic imine\",\n      \"inputs\": [\"mol_013\", \"mol_001\"],\n      \"outputs\": [\"mol_014\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-320 K\",\n        \"pressure\": \"approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Approximately pH 6-8, with cyanide trapping before cyclic-imine hydrolysis, oligomerization or over-reduction.\"\n      },\n      \"mechanism\": \"Cyanide attacks the imine/iminium carbon to install the future carboxyl carbon on the preformed pyrrolidine ring.\",\n      \"reasoning\": \"The pyrrolidine alpha-aminonitrile is an experimentally demonstrated endpoint in Patel et al. (2015), with approximately 32% reported for the combined final two-step segment rather than for an independently isolated imine step. No substantial L-selectivity or measured free-proline yield follows from this result.\"\n    },\n    {\n      \"id\": \"rxn_010\",\n      \"name\": \"Acid-catalyzed hydration of the proline aminonitrile\",\n      \"inputs\": [\"mol_014\", \"mol_004\"],\n      \"outputs\": [\"mol_015\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"aqueous hydronium\"],\n      \"conditions\": {\n        \"temperature\": \"340-370 K\",\n        \"pressure\": \"approximately 1 atm\",\n        \"catalyst\": \"general acid catalysis\",\n        \"aqueous\": true,\n        \"other\": \"Proposed acidic geothermal pool, approximately pH 1-3; residence time and competing retro-Strecker loss require measurement.\"\n      },\n      \"mechanism\": \"Nitrile protonation, water addition and tautomerization produce the corresponding carboxamide.\",\n      \"reasoning\": \"Speculative environmental completion based on standard acid-catalyzed nitrile chemistry. Patel et al. (2015) establish the aminonitrile but do not demonstrate its quantitative conversion to free proline under this proposed regime. Acid availability, hydrolysis rate and aminonitrile survival are key bottlenecks.\"\n    },\n    {\n      \"id\": \"rxn_011\",\n      \"name\": \"Base-catalyzed hydration of the proline aminonitrile\",\n      \"inputs\": [\"mol_014\", \"mol_004\"],\n      \"outputs\": [\"mol_015\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"aqueous hydroxide\"],\n      \"conditions\": {\n        \"temperature\": \"340-370 K\",\n        \"pressure\": \"approximately 1 atm\",\n        \"catalyst\": \"general base catalysis\",\n        \"aqueous\": true,\n        \"other\": \"Proposed alkaline surface reservoir, approximately pH 10-11.5; subsequent acidification is required before the shared acid-hydrolysis step.\"\n      },\n      \"mechanism\": \"Hydroxide addition to the nitrile and proton transfers produce the amide through a base-catalyzed hydration mechanism.\",\n      \"reasoning\": \"Speculative environmental completion, not a transformation measured in the supplied proline studies. It is chemically distinct from acid-catalyzed hydration but not a separate experimentally validated proline scaffold-production family. Patel et al. (2015) provide the substrate precedent only; kinetics, competing reactions and environmental pH sequencing remain unverified.\"\n    },\n    {\n      \"id\": \"rxn_012\",\n      \"name\": \"Prolinamide hydrolysis yielding both proline enantiomers\",\n      \"inputs\": [\"mol_015\", \"mol_004\"],\n      \"outputs\": [\"mol_016\", \"mol_017\", \"mol_003\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"aqueous hydronium\"],\n      \"conditions\": {\n        \"temperature\": \"350-370 K\",\n        \"pressure\": \"approximately 1 atm\",\n        \"catalyst\": \"general acid catalysis\",\n        \"aqueous\": true,\n        \"other\": \"Proposed acidic geothermal water, approximately pH 1-3; actual residence time must be established experimentally. Neutral formulas normalize protonation states; dissolved proline and ammonia speciation follows pH.\"\n      },\n      \"mechanism\": \"Acid-catalyzed acyl substitution hydrolyzes the amide, releasing ammonia/ammonium and the amino-acid carboxyl group.\",\n      \"reasoning\": \"Speculative prebiotic completion based on established amide hydrolysis chemistry; no supplied study validates this complete environmental sequence from the Patel et al. (2015) aminonitrile. The L and D nodes denote products expected from an unresolved racemic precursor population, not a stereoselective reaction or physical separation. No rate, yield or enantiomeric excess is assigned.\"\n    },\n    {\n      \"id\": \"rxn_013\",\n      \"name\": \"Sulfur-assisted capture of the proline aminonitrile\",\n      \"inputs\": [\"mol_014\", \"mol_005\"],\n      \"outputs\": [\"mol_019\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"310-350 K\",\n        \"pressure\": \"approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Proposed sulfide-rich solution, approximately pH 8-9; hydrosulfide is a consumed nucleophile rather than an inert catalyst.\"\n      },\n      \"mechanism\": \"Sulfide addition to the exocyclic nitrile followed by proton transfer forms proline thioamide.\",\n      \"reasoning\": \"Speculative substrate-specific extension. Patel et al. (2015) demonstrate nitrile-to-thioamide chemistry elsewhere in the same sulfur-rich network, but the supplied report does not demonstrate this transformation of proline aminonitrile. It is included as a chemically motivated alternative to direct oxygen hydration, not as an established yield-enhancing route.\"\n    },\n    {\n      \"id\": \"rxn_014\",\n      \"name\": \"Hydrolytic sulfur replacement in proline thioamide\",\n      \"inputs\": [\"mol_019\", \"mol_004\"],\n      \"outputs\": [\"mol_015\", \"mol_005\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"aqueous hydronium\"],\n      \"conditions\": {\n        \"temperature\": \"350-370 K\",\n        \"pressure\": \"approximately 1 atm\",\n        \"catalyst\": \"general acid catalysis\",\n        \"aqueous\": true,\n        \"other\": \"Proposed acidic hydrolysis after the sulfide-rich stage; sulfur release, competing C-N cleavage and intermediate lifetimes require measurement.\"\n      },\n      \"mechanism\": \"Water attacks the activated thiocarbonyl, allowing sulfur replacement by oxygen and release of hydrogen sulfide.\",\n      \"reasoning\": \"Speculative: no supplied paper demonstrates proline-thioamide hydrolysis under these conditions. General thioamide hydrolysis chemistry motivates the step, while the sulfur chemistry of Patel et al. (2015) motivates testing it in this network. Formation of prolinamide rather than competing hydrolysis products must be established; a kinetic advantage over direct nitrile hydrolysis is not assumed.\"\n    },\n    {\n      \"id\": \"rxn_015\",\n      \"name\": \"Crossed aldol construction of a C3 hydroxyaldehyde\",\n      \"inputs\": [\"mol_020\", \"mol_021\"],\n      \"outputs\": [\"mol_022\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"aqueous hydroxide\"],\n      \"conditions\": {\n        \"temperature\": \"300-330 K\",\n        \"pressure\": \"approximately 1 atm\",\n        \"catalyst\": \"general base catalysis\",\n        \"aqueous\": true,\n        \"other\": \"Proposed mildly alkaline concentrated pool, approximately pH 9-10.5; staged acetaldehyde supply and short residence would be needed to limit self-condensation and formose chemistry.\"\n      },\n      \"mechanism\": \"Acetaldehyde enolate adds to formaldehyde, producing 3-hydroxypropanal.\",\n      \"reasoning\": \"Speculative: none of the supplied studies demonstrates a selective prebiotic implementation of this particular crossed aldol reaction. Standard carbonyl chemistry provides a direct C1-plus-C2 construction of a possible alternative C3 feed to the established proline branch. Fox and Windsor (1970) do not identify this intermediate, and their unresolved formaldehyde chemistry is not being assigned this mechanism.\"\n    },\n    {\n      \"id\": \"rxn_016\",\n      \"name\": \"Dehydration of 3-hydroxypropanal to acrolein\",\n      \"inputs\": [\"mol_022\"],\n      \"outputs\": [\"mol_023\", \"mol_004\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"aqueous hydroxide\"],\n      \"conditions\": {\n        \"temperature\": \"320-365 K\",\n        \"pressure\": \"approximately 1 atm\",\n        \"catalyst\": \"general base catalysis\",\n        \"aqueous\": true,\n        \"other\": \"Proposed concentrating wet-dry pool during a warm aqueous stage; prompt downstream capture is needed because acrolein is volatile and polymerization-prone.\"\n      },\n      \"mechanism\": \"Aldol-condensation dehydration generates the conjugated aldehyde.\",\n      \"reasoning\": \"Speculative: the supplied literature contains no measured yield for this prebiotic step. The transformation is chemically conventional, but selective acrolein accumulation in a mixed prebiotic carbonyl pool is not established. It is required only by the explicitly hypothetical alternative entry to 3-aminopropanal.\"\n    },\n    {\n      \"id\": \"rxn_017\",\n      \"name\": \"Proposed ammonia conjugate addition to acrolein\",\n      \"inputs\": [\"mol_023\", \"mol_003\"],\n      \"outputs\": [\"mol_008\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-315 K\",\n        \"pressure\": \"approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Proposed ammonia-rich water with low acrolein loading and immediate cyanohydrin trapping; imine formation, repeated addition and polymerization may dominate.\"\n      },\n      \"mechanism\": \"Aza-Michael addition across the conjugated double bond would generate 3-aminopropanal without first reducing an aminonitrile.\",\n      \"reasoning\": \"Speculative and a major bottleneck: no supplied study establishes selective ammonia-to-acrolein addition as a usable prebiotic aminoaldehyde source. Its chemical merit is direct access to the structurally defined intermediate used by Patel et al. (2015), not evidence that the competing reactions can be controlled. The downstream pathway is conditional on successful demonstration of this entry step.\"\n    },\n    {\n      \"id\": \"rxn_018\",\n      \"name\": \"Empirical reducing-atmosphere discharge process producing proline\",\n      \"inputs\": [\"mol_024\", \"mol_025\", \"mol_003\", \"mol_004\"],\n      \"outputs\": [\"mol_016\", \"mol_017\", \"mol_026\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-350 K bulk gas-water reservoir; the electrical-discharge zone is nonthermal\",\n        \"pressure\": \"approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Anoxic CH4/N2/H2O atmosphere with trace NH3, electrical discharge, aqueous collection and the reported analytical processing. Restricted geochemically to transient or local strongly reducing settings; no deliberate mineral catalyst is assigned.\"\n      },\n      \"mechanism\": \"Lumped empirical process: energetic gas activation produces a complex reactive inventory, followed by aqueous chemistry and unresolved C5 nitrogen-ring construction. Hydrogen is a plausible reduced-gas coproduct for formal net balance; the complete product mixture is not represented.\",\n      \"reasoning\": \"Ring et al. (1972) detected approximately 1.5 micromoles of proline, establishing a low-abundance endpoint but not its elementary mechanism. Criado-Reyes et al. (2021) show that silicate reactor surfaces can alter discharge chemistry, so agents=null does not establish absence of wall effects. Trail et al. (2011) challenge a persistently methane-rich global atmosphere. Separate L/D outputs express the achiral-model expectation, not reported enantiomer-resolved yields.\"\n    },\n    {\n      \"id\": \"rxn_019\",\n      \"name\": \"Empirical thermal formaldehyde-ammonia process with hydrolytic proline release\",\n      \"inputs\": [\"mol_020\", \"mol_003\"],\n      \"outputs\": [\"mol_016\", \"mol_017\", \"mol_027\", \"mol_004\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"aqueous acid during analytical hydrolysis only\"],\n      \"conditions\": {\n        \"temperature\": \"approximately 458 K for synthesis; subsequent hot hydrolysis conditions are not specified in the supplied summary\",\n        \"pressure\": \"confined pressure sufficient to retain the hot aqueous phase\",\n        \"catalyst\": \"none assigned to thermal scaffold assembly; acid during hydrolytic workup\",\n        \"aqueous\": true,\n        \"other\": \"Concentrated formaldehyde/ammonia is heated and the resulting material is subsequently hydrolyzed. The Hydrothermal label maps the hot confined aqueous regime; it does not identify a demonstrated natural vent reaction.\"\n      },\n      \"mechanism\": \"Lumped empirical synthesis-and-workup module. Unresolved carbon-chain construction and nitrogen incorporation produce hydrolysable material that releases proline. Formate is a provisional disproportionation coproduct permitting a formal atom-balanced representation.\",\n      \"reasoning\": \"Fox and Windsor (1970) report proline after hydrolysis, not a resolved route or a measured pre-workup free-proline inventory. Wolman et al. (1971) and contemporary analytical concerns motivate rigorous blanks and isotope tracing. The specific formate closure is speculative and is not a reported proline-linked coproduct assignment. Natural precursor concentration, ring formation and environmental reproduction of the hydrolysis workup remain unresolved.\"\n    },\n    {\n      \"id\": \"rxn_020\",\n      \"name\": \"Empirical formaldehyde-hydroxylamine metal-clay process with hydrolytic proline release\",\n      \"inputs\": [\"mol_020\", \"mol_028\"],\n      \"outputs\": [\"mol_016\", \"mol_017\", \"mol_027\", \"mol_004\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\n        \"molybdate\",\n        \"Zn(II), Fe(III), Cu(II), Co(II) and Mn(II) ions\",\n        \"kaolinite\",\n        \"montmorillonite\",\n        \"aqueous acid during subsequent analytical hydrolysis\"\n      ],\n      \"conditions\": {\n        \"temperature\": \"373-383 K for seven days, followed by analytical acid hydrolysis\",\n        \"pressure\": \"sealed N2 atmosphere at autogenous pressure sufficient to retain liquid water\",\n        \"catalyst\": \"multicomponent metal/clay medium; no unique active catalyst established\",\n        \"aqueous\": true,\n        \"other\": \"Reported starting conditions include 0.30 M formaldehyde, 0.05 M hydroxylamine, initial pH 5.5, 1e-4 M of each listed transition-metal ion and approximately 2% w/v of each clay. A 1e-4 M molybdate condition is represented rather than assuming natural 1e-2 M molybdate. No molecular oxygen is supplied. Trace added Fe(III) is a laboratory variable, not the assumed dominant environmental iron state.\"\n      },\n      \"mechanism\": \"Lumped empirical condensation, redox and hydrolysis process; the proline-specific ring-forming mechanism is unresolved. Formate is a provisional atom-balance closure, not an identified mechanistic intermediate.\",\n      \"reasoning\": \"Hatanaka and Egami (1977) report approximately 0.16 mol% proline among analyzed amino-acid residues at 1e-4 M molybdate and 2.75 mol% at 1e-2 M; these are product-distribution fractions, not feedstock-to-proline yields. The combined metal/clay medium cannot be reduced to a uniquely established molybdate catalyst. Scott et al. (2008) make abundant anoxic dissolved molybdate geochemically problematic. Hydroxylamine supply, metal speciation in Fe(II)-dominated environments, concentration and natural hydrolytic release remain unverified. The formate closure is speculative.\"\n    },\n    {\n      \"id\": \"rxn_021\",\n      \"name\": \"Empirical reducing hydrothermal cyanide-carbonyl-ammonium process\",\n      \"inputs\": [\"mol_001\", \"mol_020\", \"mol_003\", \"mol_026\"],\n      \"outputs\": [\"mol_016\", \"mol_017\", \"mol_004\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"pyrite-pyrrhotite-magnetite redox-buffer assemblage\"],\n      \"conditions\": {\n        \"temperature\": \"approximately 423 K\",\n        \"pressure\": \"approximately 10 bar\",\n        \"catalyst\": \"mineral redox-buffer assemblage; a specific proline ring-forming catalytic site is not established\",\n        \"aqueous\": true,\n        \"other\": \"Concentrated cyanide, formaldehyde and ammonium under reducing conditions. Neutral NH3 and HCN nodes normalize the actual pH-dependent species. Hydrogen may be externally supplied by water-rock reactions or supplied from another network branch. A natural implementation requires limited hot residence and rapid quenching.\"\n      },\n      \"mechanism\": \"Lumped empirical amino-acid-forming network containing cyanide/carbonyl/ammonium chemistry and unresolved pyrrolidine-ring construction. The listed species permit formal net atom balance but do not establish atom mapping or a complete coproduct inventory.\",\n      \"reasoning\": \"Hennet et al. (1992) demonstrate proline formation under simulated reducing hydrothermal conditions while explicitly declining to identify their high precursor concentrations with natural vent-fluid concentrations. The mineral assemblage is justified as a redox environment, not as a proven selective ring catalyst. Bada et al. (1995) establish serious high-temperature destruction constraints; Yanagawa and Kobayashi (1997) show that hydrogen fugacity can mitigate amino-acid decomposition. Neither result establishes a net natural proline flux or L-selectivity.\"\n    }\n  ],\n  \"pathways\": [\n    {\n      \"pathway_id\": \"P1\",\n      \"name\": \"Acetylene-cyanosulfidic scaffold route with acidic nitrile hydration\",\n      \"description\": \"The experimentally grounded cyanosulfidic scaffold sequence is followed by proposed acid-catalyzed nitrile hydration and amide hydrolysis. The aminonitrile is demonstrated; free-proline production under the proposed environmental completion is not. L-proline is accompanied by D-proline.\",\n      \"reaction_sequence\": [\n        \"rxn_001\",\n        \"rxn_002\",\n        \"rxn_003\",\n        \"rxn_004\",\n        \"rxn_005\",\n        \"rxn_006\",\n        \"rxn_007\",\n        \"rxn_008\",\n        \"rxn_009\",\n        \"rxn_010\",\n        \"rxn_012\"\n      ],\n      \"key_intermediates\": [\"mol_007\", \"mol_008\", \"mol_011\", \"mol_012\", \"mol_014\", \"mol_015\"]\n    },\n    {\n      \"pathway_id\": \"P2\",\n      \"name\": \"Acetylene-cyanosulfidic scaffold route with alkaline nitrile hydration\",\n      \"description\": \"Shares the supported scaffold chemistry with P1 but uses base-catalyzed nitrile hydration before acidification and amide hydrolysis. This is a distinct chemical-processing sequence, not an independently demonstrated scaffold-production family. Environmental pH sequencing is unresolved.\",\n      \"reaction_sequence\": [\n        \"rxn_001\",\n        \"rxn_002\",\n        \"rxn_003\",\n        \"rxn_004\",\n        \"rxn_005\",\n        \"rxn_006\",\n        \"rxn_007\",\n        \"rxn_008\",\n        \"rxn_009\",\n        \"rxn_011\",\n        \"rxn_012\"\n      ],\n      \"key_intermediates\": [\"mol_008\", \"mol_012\", \"mol_014\", \"mol_015\"]\n    },\n    {\n      \"pathway_id\": \"P3\",\n      \"name\": \"Acetylene-cyanosulfidic scaffold route with sulfur-assisted nitrile processing\",\n      \"description\": \"The demonstrated proline aminonitrile is proposed to undergo sulfide capture, thioamide hydrolysis and amide hydrolysis. The proline-specific sulfur-processing extension is speculative and is not assumed more efficient than direct nitrile hydration.\",\n      \"reaction_sequence\": [\n        \"rxn_001\",\n        \"rxn_002\",\n        \"rxn_003\",\n        \"rxn_004\",\n        \"rxn_005\",\n        \"rxn_006\",\n        \"rxn_007\",\n        \"rxn_008\",\n        \"rxn_009\",\n        \"rxn_013\",\n        \"rxn_014\",\n        \"rxn_012\"\n      ],\n      \"key_intermediates\": [\"mol_008\", \"mol_012\", \"mol_014\", \"mol_019\", \"mol_015\"]\n    },\n    {\n      \"pathway_id\": \"P4\",\n      \"name\": \"Candidate aldol-acrolein entry with acidic nitrile hydration\",\n      \"description\": \"Formaldehyde and acetaldehyde are proposed to furnish acrolein and then 3-aminopropanal through ammonia addition. The route then uses the cyanosulfidic ring-construction sequence and acidic nitrile processing. Selective aminoaldehyde formation is an unverified bottleneck, so this is a candidate pathway rather than a demonstrated synthesis.\",\n      \"reaction_sequence\": [\n        \"rxn_015\",\n        \"rxn_016\",\n        \"rxn_017\",\n        \"rxn_004\",\n        \"rxn_005\",\n        \"rxn_006\",\n        \"rxn_007\",\n        \"rxn_008\",\n        \"rxn_009\",\n        \"rxn_010\",\n        \"rxn_012\"\n      ],\n      \"key_intermediates\": [\"mol_022\", \"mol_023\", \"mol_008\", \"mol_012\", \"mol_014\", \"mol_015\"]\n    },\n    {\n      \"pathway_id\": \"P5\",\n      \"name\": \"Candidate aldol-acrolein entry with alkaline nitrile hydration\",\n      \"description\": \"Combines the speculative carbonyl-derived aminoaldehyde entry with the supported thioamide ring-construction logic and proposed alkaline nitrile hydration. Subsequent acidic amide hydrolysis produces an expected DL mixture. Neither the upstream selectivity nor the complete environmental sequence is established.\",\n      \"reaction_sequence\": [\n        \"rxn_015\",\n        \"rxn_016\",\n        \"rxn_017\",\n        \"rxn_004\",\n        \"rxn_005\",\n        \"rxn_006\",\n        \"rxn_007\",\n        \"rxn_008\",\n        \"rxn_009\",\n        \"rxn_011\",\n        \"rxn_012\"\n      ],\n      \"key_intermediates\": [\"mol_022\", \"mol_023\", \"mol_008\", \"mol_014\", \"mol_015\"]\n    },\n    {\n      \"pathway_id\": \"P6\",\n      \"name\": \"Candidate aldol-acrolein entry with sulfur-assisted nitrile processing\",\n      \"description\": \"Combines two explicitly speculative extensions: the acrolein-to-aminoaldehyde entry and proline-thioamide processing. The intervening ring-construction chemistry is experimentally motivated. This is a testable network alternative, not evidence for a sixth independently demonstrated modern scaffold synthesis.\",\n      \"reaction_sequence\": [\n        \"rxn_015\",\n        \"rxn_016\",\n        \"rxn_017\",\n        \"rxn_004\",\n        \"rxn_005\",\n        \"rxn_006\",\n        \"rxn_007\",\n        \"rxn_008\",\n        \"rxn_009\",\n        \"rxn_013\",\n        \"rxn_014\",\n        \"rxn_012\"\n      ],\n      \"key_intermediates\": [\"mol_023\", \"mol_008\", \"mol_012\", \"mol_014\", \"mol_019\", \"mol_015\"]\n    },\n    {\n      \"pathway_id\": \"P7\",\n      \"name\": \"Empirical transient reducing-atmosphere discharge pathway\",\n      \"description\": \"A reported proline-producing process from methane, nitrogen, water and trace ammonia. The single graph reaction deliberately represents an unresolved multistep experimental process, not an elementary gas-to-proline conversion. Low abundance, atmospheric redox requirements and absence of demonstrated L-selectivity limit interpretation.\",\n      \"reaction_sequence\": [\"rxn_018\"],\n      \"key_intermediates\": []\n    },\n    {\n      \"pathway_id\": \"P8\",\n      \"name\": \"Empirical hot formaldehyde-ammonia hydrolysate pathway\",\n      \"description\": \"Heating formaldehyde and ammonia generates material reported to release proline on hydrolysis. Unknown precursor structures are not invented. This pathway reaches the analytical hydrolysate endpoint and does not establish environmental free-proline accumulation or L-enrichment.\",\n      \"reaction_sequence\": [\"rxn_019\"],\n      \"key_intermediates\": []\n    },\n    {\n      \"pathway_id\": \"P9\",\n      \"name\": \"Empirical hydroxylamine-formaldehyde metal-clay hydrolysate pathway\",\n      \"description\": \"A molybdate-dependent multicomponent medium produces proline-releasing material. The represented lower-molybdate experimental condition reduces but does not remove the geochemical concentration problem. Hydroxylamine supply, mixed-metal speciation and the translation of analytical hydrolysis to nature remain unresolved.\",\n      \"reaction_sequence\": [\"rxn_020\"],\n      \"key_intermediates\": []\n    },\n    {\n      \"pathway_id\": \"P10\",\n      \"name\": \"Empirical reducing hydrothermal cyanide-carbonyl pathway\",\n      \"description\": \"Concentrated cyanide, formaldehyde and ammonium produce a proline-containing mixture under reducing hydrothermal conditions. The ring-forming mechanism is unresolved; natural precursor supply and production-versus-destruction flux require validation. Hydrogen can be supplied geochemically without requiring the atmospheric discharge pathway.\",\n      \"reaction_sequence\": [\"rxn_021\"],\n      \"key_intermediates\": []\n    }\n  ],\n  \"hub_molecules\": [\n    \"mol_001\",\n    \"mol_003\",\n    \"mol_004\",\n    \"mol_005\",\n    \"mol_008\",\n    \"mol_014\",\n    \"mol_015\",\n    \"mol_016\",\n    \"mol_017\",\n    \"mol_020\",\n    \"mol_026\"\n  ],\n  \"convergence_points\": [\n    {\n      \"molecule_id\": \"mol_008\",\n      \"incoming_reactions\": [\"rxn_003\", \"rxn_017\"],\n      \"outgoing_reactions\": [\"rxn_004\"]\n    },\n    {\n      \"molecule_id\": \"mol_015\",\n      \"incoming_reactions\": [\"rxn_010\", \"rxn_011\", \"rxn_014\"],\n      \"outgoing_reactions\": [\"rxn_012\"]\n    },\n    {\n      \"molecule_id\": \"mol_016\",\n      \"incoming_reactions\": [\"rxn_012\", \"rxn_018\", \"rxn_019\", \"rxn_020\", \"rxn_021\"],\n      \"outgoing_reactions\": []\n    },\n    {\n      \"molecule_id\": \"mol_017\",\n      \"incoming_reactions\": [\"rxn_012\", \"rxn_018\", \"rxn_019\", \"rxn_020\", \"rxn_021\"],\n      \"outgoing_reactions\": []\n    }\n  ]\n}", "parsed_response": {"target_molecule": "L-Proline", "overall_strategy": "Construct a connected terrestrial network that produces L-proline as one component of an expected DL-proline mixture, not as an enantiopure or demonstrated L-enriched product. None of the supplied studies establishes prebiotic L-selectivity. The ten pathways comprise six distinct reaction sequences combining two routes to 3-aminopropanal with three alternative aminonitrile-processing sequences, plus four experimentally reported scaffold-production families. These are not ten independently validated syntheses: speculative extensions and unresolved empirical process modules are explicitly identified. The cyanosulfidic branch has the strongest intermediate-level evidence; the alternative aldol/acrolein entry and environmental conversion of the final aminonitrile to free proline require validation. Historical experiments with unresolved intermediates are represented as explicitly lumped synthesis-and-workup nodes rather than assigned invented molecular intermediates. Disulfane and formic acid provide explicitly provisional atom-balance closures where coproduct identities are unresolved; their inclusion does not establish their measured yields or accumulation. Unspecified stereochemical intermediates represent unresolved enantiomer populations. Temperature ranges are proposed test windows unless identified as reported experimental conditions. Null environment_formed denotes external supply or formation in multiple environments. The schema lacks a coproduct role, so terminal coproducts are classified as intermediate. Extraterrestrial irradiation experiments are not relabeled as terrestrial surface chemistry.", "molecules": [{"id": "mol_001", "formula": "HCN", "iupac_name": "hydrogen cyanide", "common_name": "hydrogen cyanide", "inchi": "InChI=1S/CHN/c1-2/h1H", "role": "starting", "environment_formed": null}, {"id": "mol_002", "formula": "C2H2", "iupac_name": "ethyne", "common_name": "acetylene", "inchi": "InChI=1S/C2H2/c1-2/h1-2H", "role": "starting", "environment_formed": null}, {"id": "mol_003", "formula": "NH3", "iupac_name": "azane", "common_name": "ammonia", "inchi": "InChI=1S/H3N/h1H3", "role": "starting", "environment_formed": null}, {"id": "mol_004", "formula": "H2O", "iupac_name": "oxidane", "common_name": "water", "inchi": "InChI=1S/H2O/h1H2", "role": "starting", "environment_formed": null}, {"id": "mol_005", "formula": "H2S", "iupac_name": "sulfane", "common_name": "hydrogen sulfide", "inchi": "InChI=1S/H2S/h1H2", "role": "starting", "environment_formed": null}, {"id": "mol_006", "formula": "C3H3N", "iupac_name": "prop-2-enenitrile", "common_name": "acrylonitrile", "inchi": "InChI=1S/C3H3N/c1-2-3-4/h2H,1H2", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_007", "formula": "C3H6N2", "iupac_name": "3-aminopropanenitrile", "common_name": "beta-aminopropionitrile", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_008", "formula": "C3H7NO", "iupac_name": "3-aminopropanal", "common_name": "beta-aminopropionaldehyde", "inchi": null, "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_009", "formula": "C4H8N2O", "iupac_name": "4-amino-2-hydroxybutanenitrile", "common_name": "3-aminopropanal cyanohydrin", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_010", "formula": "C4H10N2OS", "iupac_name": "4-amino-2-hydroxybutanethioamide", "common_name": "linear amino-hydroxythioamide", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_011", "formula": "C4H7NOS", "iupac_name": "3-hydroxypyrrolidine-2-thione", "common_name": "cyclic alpha-hydroxythioamide", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_012", "formula": "C4H7NS", "iupac_name": "pyrrolidine-2-thione", "common_name": "gamma-butyrothiolactam", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_013", "formula": "C4H7N", "iupac_name": "3,4-dihydro-2H-pyrrole", "common_name": "1-pyrroline", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_014", "formula": "C5H8N2", "iupac_name": "pyrrolidine-2-carbonitrile", "common_name": "proline aminonitrile", "inchi": null, "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_015", "formula": "C5H10N2O", "iupac_name": "pyrrolidine-2-carboxamide", "common_name": "prolinamide", "inchi": null, "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_016", "formula": "C5H9NO2", "iupac_name": "(2S)-pyrrolidine-2-carboxylic acid", "common_name": "L-proline", "inchi": "InChI=1S/C5H9NO2/c7-5(8)4-2-1-3-6-4/h4,6H,1-3H2,(H,7,8)/t4-/m0/s1", "role": "target", "environment_formed": null}, {"id": "mol_017", "formula": "C5H9NO2", "iupac_name": "(2R)-pyrrolidine-2-carboxylic acid", "common_name": "D-proline", "inchi": "InChI=1S/C5H9NO2/c7-5(8)4-2-1-3-6-4/h4,6H,1-3H2,(H,7,8)/t4-/m1/s1", "role": "intermediate", "environment_formed": null}, {"id": "mol_018", "formula": "H2S2", "iupac_name": "disulfane", "common_name": "hydrogen disulfide", "inchi": "InChI=1S/H2S2/c1-2/h1-2H", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_019", "formula": "C5H10N2S", "iupac_name": "pyrrolidine-2-carbothioamide", "common_name": "proline thioamide", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_020", "formula": "CH2O", "iupac_name": "methanal", "common_name": "formaldehyde", "inchi": "InChI=1S/CH2O/c1-2/h1H2", "role": "starting", "environment_formed": null}, {"id": "mol_021", "formula": "C2H4O", "iupac_name": "ethanal", "common_name": "acetaldehyde", "inchi": "InChI=1S/C2H4O/c1-2-3/h2H,1H3", "role": "starting", "environment_formed": null}, {"id": "mol_022", "formula": "C3H6O2", "iupac_name": "3-hydroxypropanal", "common_name": "beta-hydroxypropionaldehyde", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_023", "formula": "C3H4O", "iupac_name": "prop-2-enal", "common_name": "acrolein", "inchi": "InChI=1S/C3H4O/c1-2-3-4/h2-3H,1H2", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_024", "formula": "CH4", "iupac_name": "methane", "common_name": "methane", "inchi": "InChI=1S/CH4/h1H4", "role": "starting", "environment_formed": null}, {"id": "mol_025", "formula": "N2", "iupac_name": "dinitrogen", "common_name": "nitrogen", "inchi": "InChI=1S/N2/c1-2", "role": "starting", "environment_formed": null}, {"id": "mol_026", "formula": "H2", "iupac_name": "dihydrogen", "common_name": "hydrogen", "inchi": "InChI=1S/H2/h1H", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_027", "formula": "CH2O2", "iupac_name": "methanoic acid", "common_name": "formic acid", "inchi": "InChI=1S/CH2O2/c2-1-3/h1H,(H,2,3)", "role": "intermediate", "environment_formed": "Hydrothermal"}, {"id": "mol_028", "formula": "H3NO", "iupac_name": "hydroxylamine", "common_name": "hydroxylamine", "inchi": "InChI=1S/H3NO/c1-2/h2H,1H2", "role": "starting", "environment_formed": null}], "reactions": [{"id": "rxn_001", "name": "Copper-mediated hydrocyanation of acetylene", "inputs": ["mol_001", "mol_002"], "outputs": ["mol_006"], "environment": "Surface", "agents": ["aqueous Cu(I) chloride/cyanide complexes"], "conditions": {"temperature": "330-365 K", "pressure": "approximately 1 atm", "catalyst": "aqueous Cu(I) complexes", "aqueous": true, "other": "Anoxic gas-water contact in a warm surface reservoir; acetylene and HCN must be supplied and retained. Copper ligation and competing precipitation require control."}, "mechanism": "Copper-mediated addition of HCN across the acetylene triple bond generates acrylonitrile.", "reasoning": "This supplies the C3 nitrile entry to the proline branch described by Patel et al. (2015). Copper is assigned because it participates in the relevant nitrile-generating chemistry, not because copper minerals universally catalyze prebiotic reactions. Natural acetylene supply, HCN retention and soluble copper availability remain unresolved integration requirements."}, {"id": "rxn_002", "name": "Ammonia conjugate addition to acrylonitrile", "inputs": ["mol_006", "mol_003"], "outputs": ["mol_007"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-330 K", "pressure": "approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Ammonia-rich solution, approximately pH 9-10; staged substrate supply limits competing oligomerization and repeated cyanoethylation."}, "mechanism": "Aza-Michael addition installs a terminal amino group while retaining the nitrile.", "reasoning": "Patel et al. (2015) report approximately 83% conversion in the experimentally optimized acrylonitrile-to-beta-aminopropionitrile segment. Ammonia is a consumed reactant rather than a mineral catalyst. The reported segment yield is not an uninterrupted environmental pathway yield."}, {"id": "rxn_003", "name": "Sulfide-driven photoreductive conversion of aminonitrile to aminoaldehyde", "inputs": ["mol_007", "mol_005", "mol_004"], "outputs": ["mol_008", "mol_003", "mol_018"], "environment": "Surface", "agents": ["Cu(I)/Cu(II) cyanide photoredox complexes"], "conditions": {"temperature": "300-320 K", "pressure": "approximately 1 atm", "catalyst": "copper cyanide photoredox complexes", "aqueous": true, "other": "Anoxic UV-irradiated shallow water, approximately pH 7-9. H2S represents the protonation-state-normalized H2S/HS- reagent reservoir; sulfide is consumed as reducing power."}, "mechanism": "Photoreduction of the nitrile to an imine is followed by hydrolysis, producing 3-aminopropanal and ammonia.", "reasoning": "The approximately 45% aminoaldehyde conversion reported by Patel et al. (2015) supports this carbon-skeleton transformation. Copper-mediated electron transfer and sulfide consumption are distinguished. Disulfane is a speculative, atom-balanced representation of an initial oxidized-sulfur product, not an experimentally established exclusive coproduct; actual sulfur can partition among polysulfides and elemental sulfur. Over-reduction, copper sulfide precipitation and aldehyde instability require testing."}, {"id": "rxn_004", "name": "Cyanohydrin homologation of 3-aminopropanal", "inputs": ["mol_008", "mol_001"], "outputs": ["mol_009"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-320 K", "pressure": "approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Approximately pH 6-8 with prompt cyanide trapping of freshly generated aminoaldehyde; avoid prolonged storage of the free aldehyde."}, "mechanism": "Cyanide addition to the aldehyde carbonyl, followed by proton transfer, produces a C4 cyanohydrin.", "reasoning": "Patel et al. (2015) report essentially quantitative cyanohydrin formation in this segment. This is a defined carbon-chain extension, not an ordinary Strecker shortcut directly to proline. Achiral conditions do not impose an L-directed stereochemical bias."}, {"id": "rxn_005", "name": "Sulfide addition to the cyanohydrin nitrile", "inputs": ["mol_009", "mol_005"], "outputs": ["mol_010"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-340 K", "pressure": "approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Approximately pH 7-9 with available hydrosulfide. Sulfur incorporation is stoichiometric; competing thioamide products are not assumed absent."}, "mechanism": "Hydrosulfide attacks the nitrile, followed by proton transfers and tautomerization to the alpha-hydroxythioamide.", "reasoning": "The hydroxythioamide manifold is experimentally supported by Patel et al. (2015). The node identifies the linear species required for the ring-forming branch without implying that it was the only sulfur-containing product or that all material entered the proline pathway."}, {"id": "rxn_006", "name": "Intramolecular thioamide substitution forming the five-membered ring", "inputs": ["mol_010"], "outputs": ["mol_011", "mol_003"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-340 K", "pressure": "approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Mildly buffered aqueous conditions permitting a nucleophilic terminal amino group; intramolecular capture must compete with intermolecular condensation."}, "mechanism": "The terminal amino group attacks the thioamide carbon, and loss of ammonia closes a five-membered thiolactam ring.", "reasoning": "Patel et al. (2015) identify cyclization within this thioamide manifold. This step explicitly solves proline's ring-construction requirement. It is not inferred merely from a generic amino-acid-forming Strecker reaction."}, {"id": "rxn_007", "name": "Photoreductive deoxygenation of the cyclic hydroxythioamide", "inputs": ["mol_011", "mol_005"], "outputs": ["mol_012", "mol_004", "mol_018"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-320 K", "pressure": "approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Anoxic UV/sulfide photochemistry. No specific mineral catalyst is assigned from the supplied evidence; irradiation and reagent ordering must follow a validated photochemical protocol."}, "mechanism": "Net reductive removal of the alpha-hydroxyl group generates gamma-butyrothiolactam, with water release.", "reasoning": "Formation of gamma-butyrothiolactam through irradiation/reduction is part of the experimentally tracked branch in Patel et al. (2015). The detailed radical sequence and natural reactor performance are not established here. Disulfane is a speculative redox-bookkeeping coproduct rather than a claimed isolated product."}, {"id": "rxn_008", "name": "Photoreductive desulfurization to a transient cyclic imine", "inputs": ["mol_012", "mol_005"], "outputs": ["mol_013", "mol_018"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-320 K", "pressure": "approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Anoxic UV irradiation with sulfide, followed promptly by cyanide capture. A persistent isolated 1-pyrroline reservoir is not assumed."}, "mechanism": "Net reduction and sulfur removal from the cyclic thioamide gives an imine/iminium intermediate that can be trapped by cyanide.", "reasoning": "Patel et al. (2015) support the combined thiolactam-to-proline-aminonitrile sequence. The explicit 1-pyrroline node is a mechanistically inferred transient, not a separately quantified isolated endpoint in the supplied report. Its separation into this reaction and rxn_009 is therefore a model-level mechanistic interpretation. Disulfane is an unvalidated sulfur-balance closure."}, {"id": "rxn_009", "name": "Cyanide capture of the cyclic imine", "inputs": ["mol_013", "mol_001"], "outputs": ["mol_014"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-320 K", "pressure": "approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Approximately pH 6-8, with cyanide trapping before cyclic-imine hydrolysis, oligomerization or over-reduction."}, "mechanism": "Cyanide attacks the imine/iminium carbon to install the future carboxyl carbon on the preformed pyrrolidine ring.", "reasoning": "The pyrrolidine alpha-aminonitrile is an experimentally demonstrated endpoint in Patel et al. (2015), with approximately 32% reported for the combined final two-step segment rather than for an independently isolated imine step. No substantial L-selectivity or measured free-proline yield follows from this result."}, {"id": "rxn_010", "name": "Acid-catalyzed hydration of the proline aminonitrile", "inputs": ["mol_014", "mol_004"], "outputs": ["mol_015"], "environment": "Surface", "agents": ["aqueous hydronium"], "conditions": {"temperature": "340-370 K", "pressure": "approximately 1 atm", "catalyst": "general acid catalysis", "aqueous": true, "other": "Proposed acidic geothermal pool, approximately pH 1-3; residence time and competing retro-Strecker loss require measurement."}, "mechanism": "Nitrile protonation, water addition and tautomerization produce the corresponding carboxamide.", "reasoning": "Speculative environmental completion based on standard acid-catalyzed nitrile chemistry. Patel et al. (2015) establish the aminonitrile but do not demonstrate its quantitative conversion to free proline under this proposed regime. Acid availability, hydrolysis rate and aminonitrile survival are key bottlenecks."}, {"id": "rxn_011", "name": "Base-catalyzed hydration of the proline aminonitrile", "inputs": ["mol_014", "mol_004"], "outputs": ["mol_015"], "environment": "Surface", "agents": ["aqueous hydroxide"], "conditions": {"temperature": "340-370 K", "pressure": "approximately 1 atm", "catalyst": "general base catalysis", "aqueous": true, "other": "Proposed alkaline surface reservoir, approximately pH 10-11.5; subsequent acidification is required before the shared acid-hydrolysis step."}, "mechanism": "Hydroxide addition to the nitrile and proton transfers produce the amide through a base-catalyzed hydration mechanism.", "reasoning": "Speculative environmental completion, not a transformation measured in the supplied proline studies. It is chemically distinct from acid-catalyzed hydration but not a separate experimentally validated proline scaffold-production family. Patel et al. (2015) provide the substrate precedent only; kinetics, competing reactions and environmental pH sequencing remain unverified."}, {"id": "rxn_012", "name": "Prolinamide hydrolysis yielding both proline enantiomers", "inputs": ["mol_015", "mol_004"], "outputs": ["mol_016", "mol_017", "mol_003"], "environment": "Surface", "agents": ["aqueous hydronium"], "conditions": {"temperature": "350-370 K", "pressure": "approximately 1 atm", "catalyst": "general acid catalysis", "aqueous": true, "other": "Proposed acidic geothermal water, approximately pH 1-3; actual residence time must be established experimentally. Neutral formulas normalize protonation states; dissolved proline and ammonia speciation follows pH."}, "mechanism": "Acid-catalyzed acyl substitution hydrolyzes the amide, releasing ammonia/ammonium and the amino-acid carboxyl group.", "reasoning": "Speculative prebiotic completion based on established amide hydrolysis chemistry; no supplied study validates this complete environmental sequence from the Patel et al. (2015) aminonitrile. The L and D nodes denote products expected from an unresolved racemic precursor population, not a stereoselective reaction or physical separation. No rate, yield or enantiomeric excess is assigned."}, {"id": "rxn_013", "name": "Sulfur-assisted capture of the proline aminonitrile", "inputs": ["mol_014", "mol_005"], "outputs": ["mol_019"], "environment": "Surface", "agents": null, "conditions": {"temperature": "310-350 K", "pressure": "approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Proposed sulfide-rich solution, approximately pH 8-9; hydrosulfide is a consumed nucleophile rather than an inert catalyst."}, "mechanism": "Sulfide addition to the exocyclic nitrile followed by proton transfer forms proline thioamide.", "reasoning": "Speculative substrate-specific extension. Patel et al. (2015) demonstrate nitrile-to-thioamide chemistry elsewhere in the same sulfur-rich network, but the supplied report does not demonstrate this transformation of proline aminonitrile. It is included as a chemically motivated alternative to direct oxygen hydration, not as an established yield-enhancing route."}, {"id": "rxn_014", "name": "Hydrolytic sulfur replacement in proline thioamide", "inputs": ["mol_019", "mol_004"], "outputs": ["mol_015", "mol_005"], "environment": "Surface", "agents": ["aqueous hydronium"], "conditions": {"temperature": "350-370 K", "pressure": "approximately 1 atm", "catalyst": "general acid catalysis", "aqueous": true, "other": "Proposed acidic hydrolysis after the sulfide-rich stage; sulfur release, competing C-N cleavage and intermediate lifetimes require measurement."}, "mechanism": "Water attacks the activated thiocarbonyl, allowing sulfur replacement by oxygen and release of hydrogen sulfide.", "reasoning": "Speculative: no supplied paper demonstrates proline-thioamide hydrolysis under these conditions. General thioamide hydrolysis chemistry motivates the step, while the sulfur chemistry of Patel et al. (2015) motivates testing it in this network. Formation of prolinamide rather than competing hydrolysis products must be established; a kinetic advantage over direct nitrile hydrolysis is not assumed."}, {"id": "rxn_015", "name": "Crossed aldol construction of a C3 hydroxyaldehyde", "inputs": ["mol_020", "mol_021"], "outputs": ["mol_022"], "environment": "Surface", "agents": ["aqueous hydroxide"], "conditions": {"temperature": "300-330 K", "pressure": "approximately 1 atm", "catalyst": "general base catalysis", "aqueous": true, "other": "Proposed mildly alkaline concentrated pool, approximately pH 9-10.5; staged acetaldehyde supply and short residence would be needed to limit self-condensation and formose chemistry."}, "mechanism": "Acetaldehyde enolate adds to formaldehyde, producing 3-hydroxypropanal.", "reasoning": "Speculative: none of the supplied studies demonstrates a selective prebiotic implementation of this particular crossed aldol reaction. Standard carbonyl chemistry provides a direct C1-plus-C2 construction of a possible alternative C3 feed to the established proline branch. Fox and Windsor (1970) do not identify this intermediate, and their unresolved formaldehyde chemistry is not being assigned this mechanism."}, {"id": "rxn_016", "name": "Dehydration of 3-hydroxypropanal to acrolein", "inputs": ["mol_022"], "outputs": ["mol_023", "mol_004"], "environment": "Surface", "agents": ["aqueous hydroxide"], "conditions": {"temperature": "320-365 K", "pressure": "approximately 1 atm", "catalyst": "general base catalysis", "aqueous": true, "other": "Proposed concentrating wet-dry pool during a warm aqueous stage; prompt downstream capture is needed because acrolein is volatile and polymerization-prone."}, "mechanism": "Aldol-condensation dehydration generates the conjugated aldehyde.", "reasoning": "Speculative: the supplied literature contains no measured yield for this prebiotic step. The transformation is chemically conventional, but selective acrolein accumulation in a mixed prebiotic carbonyl pool is not established. It is required only by the explicitly hypothetical alternative entry to 3-aminopropanal."}, {"id": "rxn_017", "name": "Proposed ammonia conjugate addition to acrolein", "inputs": ["mol_023", "mol_003"], "outputs": ["mol_008"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-315 K", "pressure": "approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Proposed ammonia-rich water with low acrolein loading and immediate cyanohydrin trapping; imine formation, repeated addition and polymerization may dominate."}, "mechanism": "Aza-Michael addition across the conjugated double bond would generate 3-aminopropanal without first reducing an aminonitrile.", "reasoning": "Speculative and a major bottleneck: no supplied study establishes selective ammonia-to-acrolein addition as a usable prebiotic aminoaldehyde source. Its chemical merit is direct access to the structurally defined intermediate used by Patel et al. (2015), not evidence that the competing reactions can be controlled. The downstream pathway is conditional on successful demonstration of this entry step."}, {"id": "rxn_018", "name": "Empirical reducing-atmosphere discharge process producing proline", "inputs": ["mol_024", "mol_025", "mol_003", "mol_004"], "outputs": ["mol_016", "mol_017", "mol_026"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-350 K bulk gas-water reservoir; the electrical-discharge zone is nonthermal", "pressure": "approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Anoxic CH4/N2/H2O atmosphere with trace NH3, electrical discharge, aqueous collection and the reported analytical processing. Restricted geochemically to transient or local strongly reducing settings; no deliberate mineral catalyst is assigned."}, "mechanism": "Lumped empirical process: energetic gas activation produces a complex reactive inventory, followed by aqueous chemistry and unresolved C5 nitrogen-ring construction. Hydrogen is a plausible reduced-gas coproduct for formal net balance; the complete product mixture is not represented.", "reasoning": "Ring et al. (1972) detected approximately 1.5 micromoles of proline, establishing a low-abundance endpoint but not its elementary mechanism. Criado-Reyes et al. (2021) show that silicate reactor surfaces can alter discharge chemistry, so agents=null does not establish absence of wall effects. Trail et al. (2011) challenge a persistently methane-rich global atmosphere. Separate L/D outputs express the achiral-model expectation, not reported enantiomer-resolved yields."}, {"id": "rxn_019", "name": "Empirical thermal formaldehyde-ammonia process with hydrolytic proline release", "inputs": ["mol_020", "mol_003"], "outputs": ["mol_016", "mol_017", "mol_027", "mol_004"], "environment": "Hydrothermal", "agents": ["aqueous acid during analytical hydrolysis only"], "conditions": {"temperature": "approximately 458 K for synthesis; subsequent hot hydrolysis conditions are not specified in the supplied summary", "pressure": "confined pressure sufficient to retain the hot aqueous phase", "catalyst": "none assigned to thermal scaffold assembly; acid during hydrolytic workup", "aqueous": true, "other": "Concentrated formaldehyde/ammonia is heated and the resulting material is subsequently hydrolyzed. The Hydrothermal label maps the hot confined aqueous regime; it does not identify a demonstrated natural vent reaction."}, "mechanism": "Lumped empirical synthesis-and-workup module. Unresolved carbon-chain construction and nitrogen incorporation produce hydrolysable material that releases proline. Formate is a provisional disproportionation coproduct permitting a formal atom-balanced representation.", "reasoning": "Fox and Windsor (1970) report proline after hydrolysis, not a resolved route or a measured pre-workup free-proline inventory. Wolman et al. (1971) and contemporary analytical concerns motivate rigorous blanks and isotope tracing. The specific formate closure is speculative and is not a reported proline-linked coproduct assignment. Natural precursor concentration, ring formation and environmental reproduction of the hydrolysis workup remain unresolved."}, {"id": "rxn_020", "name": "Empirical formaldehyde-hydroxylamine metal-clay process with hydrolytic proline release", "inputs": ["mol_020", "mol_028"], "outputs": ["mol_016", "mol_017", "mol_027", "mol_004"], "environment": "Hydrothermal", "agents": ["molybdate", "Zn(II), Fe(III), Cu(II), Co(II) and Mn(II) ions", "kaolinite", "montmorillonite", "aqueous acid during subsequent analytical hydrolysis"], "conditions": {"temperature": "373-383 K for seven days, followed by analytical acid hydrolysis", "pressure": "sealed N2 atmosphere at autogenous pressure sufficient to retain liquid water", "catalyst": "multicomponent metal/clay medium; no unique active catalyst established", "aqueous": true, "other": "Reported starting conditions include 0.30 M formaldehyde, 0.05 M hydroxylamine, initial pH 5.5, 1e-4 M of each listed transition-metal ion and approximately 2% w/v of each clay. A 1e-4 M molybdate condition is represented rather than assuming natural 1e-2 M molybdate. No molecular oxygen is supplied. Trace added Fe(III) is a laboratory variable, not the assumed dominant environmental iron state."}, "mechanism": "Lumped empirical condensation, redox and hydrolysis process; the proline-specific ring-forming mechanism is unresolved. Formate is a provisional atom-balance closure, not an identified mechanistic intermediate.", "reasoning": "Hatanaka and Egami (1977) report approximately 0.16 mol% proline among analyzed amino-acid residues at 1e-4 M molybdate and 2.75 mol% at 1e-2 M; these are product-distribution fractions, not feedstock-to-proline yields. The combined metal/clay medium cannot be reduced to a uniquely established molybdate catalyst. Scott et al. (2008) make abundant anoxic dissolved molybdate geochemically problematic. Hydroxylamine supply, metal speciation in Fe(II)-dominated environments, concentration and natural hydrolytic release remain unverified. The formate closure is speculative."}, {"id": "rxn_021", "name": "Empirical reducing hydrothermal cyanide-carbonyl-ammonium process", "inputs": ["mol_001", "mol_020", "mol_003", "mol_026"], "outputs": ["mol_016", "mol_017", "mol_004"], "environment": "Hydrothermal", "agents": ["pyrite-pyrrhotite-magnetite redox-buffer assemblage"], "conditions": {"temperature": "approximately 423 K", "pressure": "approximately 10 bar", "catalyst": "mineral redox-buffer assemblage; a specific proline ring-forming catalytic site is not established", "aqueous": true, "other": "Concentrated cyanide, formaldehyde and ammonium under reducing conditions. Neutral NH3 and HCN nodes normalize the actual pH-dependent species. Hydrogen may be externally supplied by water-rock reactions or supplied from another network branch. A natural implementation requires limited hot residence and rapid quenching."}, "mechanism": "Lumped empirical amino-acid-forming network containing cyanide/carbonyl/ammonium chemistry and unresolved pyrrolidine-ring construction. The listed species permit formal net atom balance but do not establish atom mapping or a complete coproduct inventory.", "reasoning": "Hennet et al. (1992) demonstrate proline formation under simulated reducing hydrothermal conditions while explicitly declining to identify their high precursor concentrations with natural vent-fluid concentrations. The mineral assemblage is justified as a redox environment, not as a proven selective ring catalyst. Bada et al. (1995) establish serious high-temperature destruction constraints; Yanagawa and Kobayashi (1997) show that hydrogen fugacity can mitigate amino-acid decomposition. Neither result establishes a net natural proline flux or L-selectivity."}], "pathways": [{"pathway_id": "P1", "name": "Acetylene-cyanosulfidic scaffold route with acidic nitrile hydration", "description": "The experimentally grounded cyanosulfidic scaffold sequence is followed by proposed acid-catalyzed nitrile hydration and amide hydrolysis. The aminonitrile is demonstrated; free-proline production under the proposed environmental completion is not. L-proline is accompanied by D-proline.", "reaction_sequence": ["rxn_001", "rxn_002", "rxn_003", "rxn_004", "rxn_005", "rxn_006", "rxn_007", "rxn_008", "rxn_009", "rxn_010", "rxn_012"], "key_intermediates": ["mol_007", "mol_008", "mol_011", "mol_012", "mol_014", "mol_015"]}, {"pathway_id": "P2", "name": "Acetylene-cyanosulfidic scaffold route with alkaline nitrile hydration", "description": "Shares the supported scaffold chemistry with P1 but uses base-catalyzed nitrile hydration before acidification and amide hydrolysis. This is a distinct chemical-processing sequence, not an independently demonstrated scaffold-production family. Environmental pH sequencing is unresolved.", "reaction_sequence": ["rxn_001", "rxn_002", "rxn_003", "rxn_004", "rxn_005", "rxn_006", "rxn_007", "rxn_008", "rxn_009", "rxn_011", "rxn_012"], "key_intermediates": ["mol_008", "mol_012", "mol_014", "mol_015"]}, {"pathway_id": "P3", "name": "Acetylene-cyanosulfidic scaffold route with sulfur-assisted nitrile processing", "description": "The demonstrated proline aminonitrile is proposed to undergo sulfide capture, thioamide hydrolysis and amide hydrolysis. The proline-specific sulfur-processing extension is speculative and is not assumed more efficient than direct nitrile hydration.", "reaction_sequence": ["rxn_001", "rxn_002", "rxn_003", "rxn_004", "rxn_005", "rxn_006", "rxn_007", "rxn_008", "rxn_009", "rxn_013", "rxn_014", "rxn_012"], "key_intermediates": ["mol_008", "mol_012", "mol_014", "mol_019", "mol_015"]}, {"pathway_id": "P4", "name": "Candidate aldol-acrolein entry with acidic nitrile hydration", "description": "Formaldehyde and acetaldehyde are proposed to furnish acrolein and then 3-aminopropanal through ammonia addition. The route then uses the cyanosulfidic ring-construction sequence and acidic nitrile processing. Selective aminoaldehyde formation is an unverified bottleneck, so this is a candidate pathway rather than a demonstrated synthesis