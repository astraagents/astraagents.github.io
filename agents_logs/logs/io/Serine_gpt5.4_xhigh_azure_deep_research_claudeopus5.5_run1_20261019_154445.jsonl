ecule": "Serine", "overall_strategy": "This network prioritizes the two experimentally strongest terrestrial serine disconnections under mild, anoxic, near-surface aqueous conditions: (i) glycolaldehyde-centered Strecker chemistry, with glycolonitrile reduced to glycolaldehyde by H2S/CuCN, H2S alone, or sulfite/ferrocyanide before conversion to Ser-CN and hydrolysis; and (ii) glycine hydroxymethylation by formaldehyde under catalyst-gated Cu2+ or pyridoxal-metal conditions. Direct high-temperature hydrothermal serine formation, spark products, and exogenous delivery are not used as primary productive edges because the supplied literature treats them as low-selectivity or sink-dominated. Protonated H2SO3/H2SO4 formulas are bookkeeping stand-ins for sulfite/bisulfite and sulfate pools, and selectivity losses such as glycolaldehyde over-reduction and over-hydroxymethylation are treated in reaction reasoning rather than expanded as separate nodes to keep the network compact.", "molecules": [{"id": "mol_001", "formula": "HCN", "iupac_name": "hydrogen cyanide", "common_name": "hydrogen cyanide", "inchi": "InChI=1S/CHN/c1-2/h1H", "role": "starting", "environment_formed": null}, {"id": "mol_002", "formula": "NH3", "iupac_name": "ammonia", "common_name": "ammonia", "inchi": "InChI=1S/H3N/h1H3", "role": "starting", "environment_formed": null}, {"id": "mol_003", "formula": "H2O", "iupac_name": "water", "common_name": "water", "inchi": "InChI=1S/H2O/h1H2", "role": "starting", "environment_formed": null}, {"id": "mol_004", "formula": "CH2O", "iupac_name": "methanal", "common_name": "formaldehyde", "inchi": "InChI=1S/CH2O/c1-2/h1H2", "role": "starting", "environment_formed": null}, {"id": "mol_005", "formula": "C2H3NO", "iupac_name": "2-hydroxyacetonitrile", "common_name": "glycolonitrile", "inchi": null, "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_006", "formula": "C2H4O2", "iupac_name": "2-hydroxyethanal", "common_name": "glycolaldehyde", "inchi": 