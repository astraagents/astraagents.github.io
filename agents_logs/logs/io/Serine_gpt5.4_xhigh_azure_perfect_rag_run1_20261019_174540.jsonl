",\n      \"common_name\": \"glycine nitrile\",\n      \"inchi\": \"InChI=1S/C2H4N2/c3-1-2-4/h1,3H2\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_011\",\n      \"formula\": \"C2H4O3\",\n      \"iupac_name\": \"peroxyacetic acid\",\n      \"common_name\": \"peracetic acid\",\n      \"inchi\": \"InChI=1S/C2H4O3/c1-2(3)5-4/h4H,1H3\",\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_012\",\n      \"formula\": \"C2H4O4\",\n      \"iupac_name\": \"2,2-dihydroxyacetic acid\",\n      \"common_name\": \"glyoxylic acid hydrate\",\n      \"inchi\": null,\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_013\",\n      \"formula\": \"C2H4O2\",\n      \"iupac_name\": \"2-hydroxyethanal\",\n      \"common_name\": \"glycolaldehyde\",\n      \"inchi\": \"InChI=1S/C2H4O2/c3-1-2-4/h1,4H,2H2\",\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_014\",\n      \"formula\": \"C3H6N2O\",\n      \"iupac_name\": \"2-amino-3-hydroxypropanenitrile\",\n      \"common_name\": \"serine nitrile\",\n      \"inchi\": \"InChI=1S/C3H6N2O/c4-1-3(5)2-6/h3,6H,2,5H2\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_015\",\n      \"formula\": \"HCN\",\n      \"iupac_name\": \"hydrogen cyanide\",\n      \"common_name\": \"hydrogen cyanide\",\n      \"inchi\": \"InChI=1S/CHN/c1-2/h1H\",\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    }\n  ],\n  \"reactions\": [\n    {\n      \"id\": \"rxn_001\",\n      \"name\": \"Strecker formation of aminoacetonitrile from formaldehyde\",\n      \"inputs\": [\"mol_003\", \"mol_015\", \"mol_009\"],\n      \"outputs\": [\"mol_010\", \"mol_008\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-330K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"anoxic cyanosulfidic evaporitic pools; wet-dry concentration of HCN and NH3\"\n      },\n      \"mechanism\": \"Strecker-type imine/iminium formation from formaldehyde and ammonia followed by cyanide capture, yielding the aminonitrile and releasing water.\",\n      \"reasoning\": \"Patel et al. (2015) place aminoacetonitrile in the cyanosulfidic network from formaldehyde, HCN, and NH3. This surface-compatible step is experimentally grounded and provides one major entry into the glycine hub.\"\n    },\n    {\n      \"id\": \"rxn_002\",\n      \"name\": \"Aminoacetonitrile hydrolysis to glycine\",\n      \"inputs\": [\"mol_010\", \"mol_008\"],\n      \"outputs\": [\"mol_002\", \"mol_009\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-330K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"ambient aqueous hydrolysis in repeated wet phases; overall balanced form uses 2 H2O equivalents\"\n      },\n      \"mechanism\": \"Sequential nitrile hydration to an amide and then to the carboxylic acid, releasing ammonia.\",\n      \"reasoning\": \"Hydrolysis of aminoacetonitrile to glycine is directly supported in cyanosulfidic chemistry by Patel et al. (2015). Repeated hydration phases plausibly supply the two water equivalents required overall, making this a strong surface route into the glycine pool.\"\n    },\n    {\n      \"id\": \"rxn_003\",\n      \"name\": \"Iron-promoted reductive amination of glyoxylate to glycine\",\n      \"inputs\": [\"mol_005\", \"mol_006\", \"mol_007\"],\n      \"outputs\": [\"mol_002\", \"mol_008\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"elemental iron (Fe0)\", \"ferrous iron (Fe2+)\"],\n      \"conditions\": {\n        \"temperature\": \"340-350K\",\n        \"pressure\": \"high\",\n        \"catalyst\": \"Fe0/Fe2+\",\n        \"aqueous\": true,\n        \"other\": \"anoxic Fe-rich, H2-rich subseafloor fluids; balanced net form uses 2 H2 equivalents and yields 2 H2O\"\n      },\n      \"mechanism\": \"Oxime/imino intermediate formation at the alpha-keto acid followed by iron-assisted reduction to the amino acid.\",\n      \"reasoning\": \"Muchowska et al. (2019) demonstrated Fe0/Fe2+-promoted conversion of alpha-keto acids to amino acids, including glyoxylate to glycine, in water near 343 K. This balanced net form explicitly includes the reducing equivalents needed overall; the experiments use iron as the proximal reductant, while H2 is the geochemically plausible vent-scale electron source in serpentinization-driven systems.\"\n    },\n    {\n      \"id\": \"rxn_004\",\n      \"name\": \"Peracetic acid amination to glycine\",\n      \"inputs\": [\"mol_011\", \"mol_009\"],\n      \"outputs\": [\"mol_002\", \"mol_008\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"343-373K\",\n        \"pressure\": \"high\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"mild submarine hydrothermal conditions; rapid cooling after formation favors product survival\"\n      },\n      \"mechanism\": \"Ammonolysis of the peroxyacetyl carbonyl followed by rearrangement and O-O bond loss to furnish the amino acid.\",\n      \"reasoning\": \"Aubrey et al. (2008) reported glycine formation from peracetic acid and ammonia under simulated submarine hydrothermal conditions. This gives a hydrothermal entry to the glycine hub independent of nitriles or glyoxylate, although the sustained availability of peracetic acid in natural vents is less constrained than the other feeder routes.\"\n    },\n    {\n      \"id\": \"rxn_005\",\n      \"name\": \"UV dehydration of glyoxylic acid hydrate to glyoxylate\",\n      \"inputs\": [\"mol_012\"],\n      \"outputs\": [\"mol_005\", \"mol_008\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"UV radiation\"],\n      \"conditions\": {\n        \"temperature\": \"300-320K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"UV photons\",\n        \"aqueous\": true,\n        \"other\": \"UV-irradiated shallow pools under a no-ozone atmosphere\"\n      },\n      \"mechanism\": \"UV-driven dehydration of the gem-diol hydrate regenerates aldehydic glyoxylate.\",\n      \"reasoning\": \"Liu et al. (2021) showed UV photoredox conditions can regenerate glyoxylate from hydrated C2 precursors. Writing the precursor explicitly as 2,2-dihydroxyacetic acid makes the node mass-balanced and captures an experimentally supported surface feeder into the glyoxylate hub.\"\n    },\n    {\n      \"id\": \"rxn_006\",\n      \"name\": \"Glycine-formaldehyde aldol homologation to serine\",\n      \"inputs\": [\"mol_002\", \"mol_003\"],\n      \"outputs\": [\"mol_001\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"343-373K\",\n        \"pressure\": \"high\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"mild subseafloor hydrothermal conditions; rapid quenching favored to limit serine decomposition\"\n      },\n      \"mechanism\": \"Nonenzymatic aldol-like hydroxymethylation of glycine at the alpha carbon by formaldehyde forms the beta-hydroxyl amino acid.\",\n      \"reasoning\": \"Aubrey et al. (2008) observed serine formation from glycine and formaldehyde under submarine hydrothermal conditions. The main caveat is serine thermal lability and possible retro-aldol decomposition back to glycine plus formaldehyde at prolonged high temperature, noted in the review (Aubrey et al., 2008; Bada et al., 1978), so the most plausible window is mild hydrothermal heating with rapid quench.\"\n    },\n    {\n      \"id\": \"rxn_007\",\n      \"name\": \"Schiff-base formation of N-methylene glycine\",\n      \"inputs\": [\"mol_002\", \"mol_003\"],\n      \"outputs\": [\"mol_004\", \"mol_008\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"323K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"warm formaldehyde-rich geothermal or evaporitic pool; concentration by wet-dry cycling\"\n      },\n      \"mechanism\": \"Condensation of the glycine amino group with formaldehyde forms an imine (Schiff base) and releases water.\",\n      \"reasoning\": \"Krishnamurthy et al. (2016) showed that glycine and formaldehyde spontaneously form N-methylene glycine in warm aqueous solution. This provides the experimentally anchored imine node for the surface serine branch, although maintaining sufficient local formaldehyde remains an open prebiotic concentration problem.\"\n    },\n    {\n      \"id\": \"rxn_008\",\n      \"name\": \"Net conversion of N-methylene glycine to serine\",\n      \"inputs\": [\"mol_004\", \"mol_008\"],\n      \"outputs\": [\"mol_001\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"323K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"warm aqueous pool; encoded as the net serine-forming branch of dynamic iminium chemistry over about 24 h\"\n      },\n      \"mechanism\": \"Net hydrolytic rearrangement and prototropic reorganization of the preformed C3 imine gives serine.\",\n      \"reasoning\": \"Krishnamurthy et al. (2016) reported serine among the products of N-methylene-glycine/formaldehyde aqueous chemistry near 323 K. To keep the graph mass-balanced, this node is written as the net conversion of the already assembled C3 imine to serine; the extra formaldehyde discussed mechanistically is treated as part of the prior iminium equilibrium rather than as a separate net carbon input. The route is therefore literature-guided but intentionally compressed, and the experimentally observed competition with glyoxylate formation remains an open selectivity problem.\"\n    },\n    {\n      \"id\": \"rxn_009\",\n      \"name\": \"Strecker formation of serine aminonitrile from glycolaldehyde\",\n      \"inputs\": [\"mol_013\", \"mol_015\", \"mol_009\"],\n      \"outputs\": [\"mol_014\", \"mol_008\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-330K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"HCN/NH3-rich cyanosulfidic pools with evaporative concentration\"\n      },\n      \"mechanism\": \"Strecker-type imine formation at glycolaldehyde followed by cyanide addition gives the beta-hydroxyl aminonitrile.\",\n      \"reasoning\": \"Patel et al. (2015) place 2-amino-3-hydroxypropanenitrile in the cyanosulfidic network from glycolaldehyde, HCN, and NH3. This is the most direct experimentally supported entry into serine precursor space on the surface and bypasses the free-glycine hub.\"\n    },\n    {\n      \"id\": \"rxn_010\",\n      \"name\": \"Serine aminonitrile hydrolysis to serine\",\n      \"inputs\": [\"mol_014\", \"mol_008\"],\n      \"outputs\": [\"mol_001\", \"mol_009\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-330K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"wet-phase hydrolysis in cyanosulfidic pools; overall balanced form uses 2 H2O equivalents\"\n      },\n      \"mechanism\": \"Sequential nitrile hydration and amide hydrolysis convert the aminonitrile into the amino acid with release of ammonia.\",\n      \"reasoning\": \"Patel et al. (2015) showed that 2-amino-3-hydroxypropanenitrile hydrolyzes to serine and ammonia in water. The overall hydrolysis consumes two water equivalents, and the review notes that aminonitrile persistence under intense UV and fluctuating pH is still a genuine uncertainty.\"\n    }\n  ],\n  \"pathways\": [\n    {\n      \"pathway_id\": \"P1\",\n      \"name\": \"Surface Strecker glycine to hydrothermal aldol serine\",\n      \"description\": \"Formaldehyde enters cyanosulfidic Strecker chemistry on the surface to give aminoacetonitrile; wet hydrolysis yields glycine, which is then physically transferred or retained in a nearby mild hydrothermal niche where formaldehyde homologation gives serine.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_002\", \"rxn_006\"],\n      \"key_intermediates\": [\"mol_010\", \"mol_002\"]\n    },\n    {\n      \"pathway_id\": \"P2\",\n      \"name\": \"Surface Strecker glycine to surface imine serine\",\n      \"description\": \"The same surface Strecker branch supplies glycine, but serine arises through the warm-pool N-methylene-glycine sequence, avoiding hydrothermal exposure.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_002\", \"rxn_007\", \"rxn_008\"],\n      \"key_intermediates\": [\"mol_010\", \"mol_002\", \"mol_004\"]\n    },\n    {\n      \"pathway_id\": \"P3\",\n      \"name\": \"Hydrothermal peracetic-to-serine aldol route\",\n      \"description\": \"Hydrothermal peracetic-acid amination gives glycine, followed directly by hydrothermal glycine-formaldehyde aldol homologation to serine.\",\n      \"reaction_sequence\": [\"rxn_004\", \"rxn_006\"],\n      \"key_intermediates\": [\"mol_002\"]\n    },\n    {\n      \"pathway_id\": \"P4\",\n      \"name\": \"Peracetic-to-glycine then surface imine route\",\n      \"description\": \"Hydrothermal peracetic-acid amination generates glycine that is then transferred to a warm surface pool for N-methylene-glycine formation and net conversion to serine.\",\n      \"reaction_sequence\": [\"rxn_004\", \"rxn_007\", \"rxn_008\"],\n      \"key_intermediates\": [\"mol_002\", \"mol_004