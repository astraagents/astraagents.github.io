\",\n      \"iupac_name\": \"2-amino-3-hydroxypropanamide\",\n      \"common_name\": \"serinamide\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Biochemical\"\n    },\n    {\n      \"id\": \"mol_010\",\n      \"formula\": \"CO2\",\n      \"iupac_name\": \"carbon dioxide\",\n      \"common_name\": \"carbon dioxide\",\n      \"inchi\": \"InChI=1S/CO2/c2-1-3\",\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_011\",\n      \"formula\": \"C4H6N2O3\",\n      \"iupac_name\": \"5-(hydroxymethyl)imidazolidine-2,4-dione\",\n      \"common_name\": \"5-hydroxymethylhydantoin\",\n      \"inchi\": null,\n      \"role\": \"hub_intermediate\",\n      \"environment_formed\": \"Biochemical\"\n    },\n    {\n      \"id\": \"mol_012\",\n      \"formula\": \"C4H8N2O4\",\n      \"iupac_name\": \"2-(carbamoylamino)-3-hydroxypropanoic acid\",\n      \"common_name\": \"N-carbamylserine\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Biochemical\"\n    },\n    {\n      \"id\": \"mol_013\",\n      \"formula\": \"C2H4N2\",\n      \"iupac_name\": \"2-aminoacetonitrile\",\n      \"common_name\": \"glycine nitrile\",\n      \"inchi\": \"InChI=1S/C2H4N2/c3-1-2-4/h1,3H2\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Biochemical\"\n    },\n    {\n      \"id\": \"mol_014\",\n      \"formula\": \"C3H7NO3\",\n      \"iupac_name\": \"2-amino-3-hydroxypropanoic acid\",\n      \"common_name\": \"serine\",\n      \"inchi\": \"InChI=1S/C3H7NO3/c4-2(1-5)3(6)7/h2,5H,1,4H2,(H,6,7)\",\n      \"role\": \"target\",\n      \"environment_formed\": \"Biochemical\"\n    }\n  ],\n  \"reactions\": [\n    {\n      \"id\": \"rxn_001\",\n      \"name\": \"Formose dimerization of formaldehyde to glycolaldehyde\",\n      \"inputs\": [\"mol_001\"],\n      \"outputs\": [\"mol_004\"],\n      \"environment\": \"Surface\",\n      \"agents\": [],\n      \"conditions\": {\n        \"temperature\": \"320-360K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"alkaline evaporitic or geothermal pool; wet-dry concentration; borate-rich brines can help preserve glycolaldehyde once formed\"\n      },\n      \"mechanism\": \"Base-promoted enediolization of formaldehyde followed by C-C bond formation gives glycolaldehyde as the first sugar product.\",\n      \"reasoning\": \"Known formose chemistry provides glycolaldehyde as an early C2 product. The main limitation is poor selectivity because continuing sugar growth can consume it, so rapid trapping or borate stabilization is advantageous.\"\n    },\n    {\n      \"id\": \"rxn_002\",\n      \"name\": \"Hydrothermal reduction of glyoxal to glycolaldehyde\",\n      \"inputs\": [\"mol_002\", \"mol_003\"],\n      \"outputs\": [\"mol_004\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"Fe-Ni sulfide and magnetite surfaces\"],\n      \"conditions\": {\n        \"temperature\": \"370-430K\",\n        \"pressure\": \"high\",\n        \"catalyst\": \"Fe-Ni sulfide and magnetite surfaces\",\n        \"aqueous\": true,\n        \"other\": \"H2-rich vent or subseafloor mixing zone; rapid quench into cooler pores helps preserve the aldehyde product\"\n      },\n      \"mechanism\": \"Mineral-surface hydrogenation reduces one aldehyde of glyoxal to the alcohol, yielding glycolaldehyde.\",\n      \"reasoning\": \"Hydrothermal H2 and reduced iron-nickel mineral surfaces can reduce carbonyl compounds. Because glyoxal already contains the needed C-C bond, its conversion to glycolaldehyde is less demanding than full C1 coupling and offers a vent-derived source of the same hub intermediate.\"\n    },\n    {\n      \"id\": \"rxn_003\",\n      \"name\": \"Strecker synthesis of serine nitrile from glycolaldehyde\",\n      \"inputs\": [\"mol_004\", \"mol_005\", \"mol_006\"],\n      \"outputs\": [\"mol_008\", \"mol_007\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [],\n      \"conditions\": {\n        \"temperature\": \"290-330K\",\n        \"pressure\": \"1 atm to pore-confined\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"concentrated prebiotic pool or mineral pore with NH3 and HCN; evaporation or cooling concentrates glycolaldehyde\"\n      },\n      \"mechanism\": \"Ammonia forms a carbinolamine or iminium manifold with glycolaldehyde, and cyanide capture furnishes the alpha-aminonitrile serine nitrile with water released overall.\",\n      \"reasoning\": \"This is the strongest direct prebiotic entry to serine because glycolaldehyde already carries the required hydroxymethyl group. The same transformation can act on glycolaldehyde made at the surface or delivered as a soluble product from hydrothermal mixing zones into concentrating aqueous microenvironments.\"\n    },\n    {\n      \"id\": \"rxn_004\",\n      \"name\": \"Overall hydrolysis of serine nitrile to serine\",\n      \"inputs\": [\"mol_008\", \"mol_007\"],\n      \"outputs\": [\"mol_014\", \"mol_005\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [],\n      \"conditions\": {\n        \"temperature\": \"330-380K\",\n        \"pressure\": \"1 atm to pore-confined\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"net two-water hydrolysis under repeated heating and cooling; mildly acidic, neutral, or mineral-buffered conditions\"\n      },\n      \"mechanism\": \"Serine nitrile undergoes sequential hydration and hydrolysis to the carboxylic acid; this node represents the overall nitrile-to-amino-acid conversion when the amide does not accumulate.\",\n      \"reasoning\": \"Amino nitriles are credible prebiotic reservoirs that hydrolyze to amino acids during prolonged aqueous heating. This node captures the net outcome of the more explicit stepwise chemistry represented separately in rxn_005 and rxn_006.\"\n    },\n    {\n      \"id\": \"rxn_005\",\n      \"name\": \"Partial hydrolysis of serine nitrile to serinamide\",\n      \"inputs\": [\"mol_008\", \"mol_007\"],\n      \"outputs\": [\"mol_009\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [],\n      \"conditions\": {\n        \"temperature\": \"320-360K\",\n        \"pressure\": \"1 atm to pore-confined\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"hydrating pool or mineral interface; first hydrolysis step favored before full acid formation\"\n      },\n      \"mechanism\": \"Nitrile hydration converts serine nitrile to the corresponding amide, serinamide.\",\n      \"reasoning\": \"The amide is the expected first hydrolysis product of an amino nitrile and is a likely kinetic bottleneck. Including serinamide explicitly gives a more conservative and mechanistically resolved route to serine.\"\n    },\n    {\n      \"id\": \"rxn_006\",\n      \"name\": \"Hydrolysis of serinamide to serine\",\n      \"inputs\": [\"mol_009\", \"mol_007\"],\n      \"outputs\": [\"mol_014\", \"mol_005\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [],\n      \"conditions\": {\n        \"temperature\": \"330-380K\",\n        \"pressure\": \"1 atm to pore-confined\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"continued aqueous heating in geothermal cycling or long-residence pools\"\n      },\n      \"mechanism\": \"Serinamide hydrolyzes to the carboxylic acid, releasing ammonia.\",\n      \"reasoning\": \"Once the amide is formed, further hydrolysis yields serine under sustained aqueous heating. This stepwise branch is often more realistic than assuming immediate full nitrile hydrolysis.\"\n    },\n    {\n      \"id\": \"rxn_007\",\n      \"name\": \"Bucherer-Bergs-type formation of 5-hydroxymethylhydantoin from glycolaldehyde\",\n      \"inputs\": [\"mol_004\", \"mol_006\", \"mol_005\", \"mol_010\"],\n      \"outputs\": [\"mol_011\", \"mol_007\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [],\n      \"conditions\": {\n        \"temperature\": \"300-340K\",\n        \"pressure\": \"1 atm to pore-confined\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"cyanide and ammonium carbonate-rich pool or evaporative pore network; CO2 and NH3 act through carbamate or carbonate speciation\"\n      },\n      \"mechanism\": \"Glycolaldehyde enters a Bucherer-Bergs-type manifold: cyanide and ammonia generate the amino-nitrile chemistry, carbamylation by CO2-derived species follows, and ring closure yields 5-hydroxymethylhydantoin.\",\n      \"reasoning\": \"Hydantoins are plausible protected reservoirs of amino-acid skeletons under cyanide and carbonate chemistry. This branch is slower and more condition-sensitive than direct Strecker synthesis but can preserve the serine framework in a less labile form.\"\n    },\n    {\n      \"id\": \"rxn_008\",\n      \"name\": \"Overall hydrolysis of 5-hydroxymethylhydantoin to serine\",\n      \"inputs\": [\"mol_011\", \"mol_007\"],\n      \"outputs\": [\"mol_014\", \"mol_010\", \"mol_005\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [],\n      \"conditions\": {\n        \"temperature\": \"340-390K\",\n        \"pressure\": \"1 atm to pore-confined\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"net two-water hydrolysis and decarbamylation under prolonged heating\"\n      },\n      \"mechanism\": \"Ring opening, ureide hydrolysis, and decarbamylation convert 5-hydroxymethylhydantoin to serine; this node encodes the overall transformation when the carbamylated amino-acid intermediate does not accumulate.\",\n      \"reasoning\": \"Hydantoin hydrolysis to amino acids is chemically well precedented under sustained heating. This node is a coarse-grained overall transformation; the more explicit stepwise alternative through N-carbamylserine is given in rxn_009 and rxn_010.\"\n    },\n    {\n      \"id\": \"rxn_009\",\n      \"name\": \"Ring opening of 5-hydroxymethylhydantoin to N-carbamylserine\",\n      \"inputs\": [\"mol_011\", \"mol_007\"],\n      \"outputs\": [\"mol_012\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [],\n      \"conditions\": {\n        \"temperature\": \"330-370K\",\n        \"pressure\": \"1 atm to pore-confined\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"mildly alkaline or neutral aqueous conditions; partial hydrolysis before full decarbamylation\"\n      },\n      \"mechanism\": \"Hydantoin ring opening by water gives the corresponding N-carbamyl amino acid, N-carbamylserine.\",\n      \"reasoning\": \"N-carbamyl amino acids are the expected intermediates of hydantoin hydrolysis. Including N-carbamylserine explicitly captures the chemically orthodox stepwise route and avoids overcompressing the branch.\"\n    },\n    {\n      \"id\": \"rxn_010\",\n      \"name\": \"Hydrolysis and decarbamylation of N-carbamylserine to serine\",\n      \"inputs\": [\"mol_012\", \"mol_007\"],\n      \"outputs\": [\"mol_014\", \"mol_010\", \"mol_005\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [],\n      \"conditions\": {\n        \"temperature\": \"340-390K\",\n        \"pressure\": \"1 atm to pore-confined\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"continued aqueous heating or geothermal cycling promotes carbamyl cleavage\"\n      },\n      \"mechanism\": \"N-carbamylserine hydrolyzes and decarbamylates to serine, releasing carbon dioxide and ammonia.\",\n      \"reasoning\": \"This step completes the hydantoin branch through a chemically orthodox intermediate. It is slower than direct Strecker-to-hydrolysis chemistry but can benefit from the greater persistence of hydantoin reservoirs in fluctuating prebiotic pools.\"\n    },\n    {\n      \"id\": \"rxn_011\",\n      \"name\": \"Strecker synthesis of glycine nitrile from formaldehyde\",\n      \"inputs\": [\"mol_001\", \"mol_005\", \"mol_006\"],\n      \"outputs\": [\"mol_013\", \"mol_007\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [],\n      \"conditions\": {\n        \"temperature\": \"290-330K\",\n        \"pressure\": \"1 atm to pore-confined\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"concentrated NH3 and HCN pool or pore network; formaldehyde serves as the aldehyde component\"\n      },\n      \"mechanism\": \"Formaldehyde reacts with ammonia to give an iminium or carbinolamine manifold that is trapped by cyanide, yielding aminoacetonitrile.\",\n      \"reasoning\": \"Glycine nitrile is the Strecker product of the simplest aldehyde and is a plausible aminonitrile reservoir. Including it creates an alternative serine entry that does not require prior formation of glycolaldehyde.\"\n    },\n    {\n      \"id\": \"rxn_012\",\n      \"name\": \"Homologation of glycine nitrile with formaldehyde to serine nitrile\",\n      \"inputs\": [\"mol_013\", \"mol_001\"],\n      \"outputs\": [\"mol_008\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [],\n      \"conditions\": {\n        \"temperature\": \"300-340K\",\n        \"pressure\": \"1 atm to pore-confined\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"mildly basic concentrated pool or mineral interface; formaldehyde in excess; lower-confidence alternative\"\n      },\n      \"mechanism\": \"Glycine nitrile is hydroxymethylated at the alpha carbon by formaldehyde through aminonitrile iminium or enamine-like chemistry, giving serine nitrile.\",\n      \"reasoning\": \"This branch is more speculative than direct Strecker synthesis from glycolaldehyde. It is included because aminonitriles are more activated homologation partners than amino acids and can plausibly add formaldehyde to build the serine skeleton, but its confidence is lower than rxn_003.\"\n    }\n  ],\n  \"pathways\": [\n    {\n      \"pathway_id\": \"P1\",\n      \"name\": \"Surface formose to serine via net nitrile hydrolysis\",\n      \"description\": \"Formaldehyde dimerizes to glycolaldehyde in a surface pool; Strecker chemistry gives serine nitrile, which hydrolyzes overall to serine.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_003\", \"rxn_004\"],\n      \"key_intermediates\": [\"mol_004\", \"mol_008\"]\n    },\n    {\n      \"pathway_id\": \"P2\",\n      \"name\": \"Surface formose to serine via serinamide\",\n      \"description\": \"The same surface glycolaldehyde hub enters Strecker chemistry, but hydrolysis proceeds through explicit serinamide accumulation.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_003\", \"rxn_005\", \"rxn_006\"],\n      \"key_intermediates\": [\"mol_004\", \"mol_008\", \"mol_009\"]\n    },\n    {\n      \"pathway_id\": \"P3\",\n      \"name\": \"Surface formose to serine via hydantoin overall hydrolysis\",\n      \"description\": \"Surface-generated glycolaldehyde enters a hydantoin reservoir and is released directly as serine under prolonged hydrolysis.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_007\", \"rxn_008\"],\n      \"key_intermediates\": [\"mol_004\", \"mol_011\"]\n    },\n    {\n      \"pathway_id\": \"P4\",\n      \"name\": \"Surface formose to serine via N-carbamylserine\",\n      \"description\": \"The hydantoin branch is resolved stepwise through N-carbamylserine before final release of serine.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_007\", \"rxn_009\", \"rxn_010\"],\n      \"key_intermediates\": [\"mol_004\", \"mol_011\", \"mol_012\"]\n    },\n    {\n      \"pathway_id\": \"P5\",\n      \"name\": \"Hydrothermal glyoxal reduction to serine via net nitrile hydrolysis\",\n      \"description\": \"Hydrothermal reduction of glyoxal gives glycolaldehyde, which is then trapped in a concentrating prebiotic pool and converted to serine through Strecker chemistry and overall nitrile hydrolysis.\",\n      \"