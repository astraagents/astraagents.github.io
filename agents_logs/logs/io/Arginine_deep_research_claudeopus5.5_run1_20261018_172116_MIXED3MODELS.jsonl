": "Nitrile hydrolyzes under aqueous acidic or basic conditions to the free amino acid.", "reasoning": "No experimental demonstration for arginine \u03b1-aminonitrile hydrolysis; strong precedent from Strecker hydrolysis of other aminonitriles. Treated as plausible but speculative. (Patel et al. 2015, Strecker precedent)"}, {"id": "rxn_008", "name": "HCN polymerization and acid hydrolysis (disputed)", "inputs": ["mol_001", "mol_002"], "outputs": ["mol_013"], "environment": "Surface", "agents": [null], "conditions": {"temperature": "273\u2013363K (polymerization), 373\u2013383K (hydrolysis)", "pressure": "1 atm", "catalyst": null, "aqueous": "true", "other": "Concentrated HCN with ammonia, then 6 N HCl at 100\u2013110\u00b0C, 16\u201324 h"}, "mechanism": "HCN polymerization with ammonia under ambient conditions followed by acid hydrolysis to release various amino acids.", "reasoning": "Arginine reported by Matthews & Moser (1967) via amino acid analyzer; GC-MS studies failed to confirm. Treated as disputed. (Matthews & Moser 1967; Ferris et al. 1973; Ruiz-Bermejo et al. 2013)"}, {"id": "rxn_009", "name": "Strecker-type synthesis of ornithine via aldehyde precursor (spark discharge route)", "inputs": ["mol_001", "mol_002"], "outputs": ["mol_010"], "environment": "Surface", "agents": ["electric discharge (spark)"], "conditions": {"temperature": "300\u2013340K", "pressure": "1 atm", "catalyst": null, "aqueous": "true", "other": "Simulated spark discharge with reduced atmosphere gases"}, "mechanism": "Electric discharge forms complex mixture of Strecker intermediates, some of which hydrolyze to ornithine.", "reasoning": "Ornithine detected consistently as minor product in spark discharge and Miller/volcanic sample hydrolysates (Johnson et al. 2008; Parker et al. 2011). Arginine not detected."}, {"id": "rxn_010", "name": "Guanidinylation of ornithine by cyanamide (speculative)", "inputs": ["mol_010", "mol_011"], "outputs": ["mol_013"], "environment": "Biochemical", "agent