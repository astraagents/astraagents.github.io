gents": null, "conditions": {"temperature": "350-370K", "pressure": "1 atm", "catalyst": null, "aqueous": "true", "other": "Concentrated NH4CN or HCN/NH4OH solutions, hours to days, historical product assignments after hydrolytic workup"}, "mechanism": "HCN oligomerization followed by hydrolytic release yields trace diamino-acid products including ornithine.", "reasoning": "Ruiz-Bermejo and co-workers summarize older reports of ornithine formation from hot ammonium cyanide or HCN/NH4OH chemistry (Ruiz-Bermejo et al., 2013). This route is included only as a low-confidence scaffold source because historical HCN-polymer amino-acid assignments are difficult to validate, and later GC-MS reanalyses did not confirm arginine claims (Ferris et al., 1973; Ferris et al., 1974)."}, {"id": "rxn_009", "name": "Volcanic spark-discharge synthesis of ornithine", "inputs": ["mol_004", "mol_002", "mol_005", "mol_006"], "outputs": ["mol_011"], "environment": "Surface", "agents": null, "conditions": {"temperature": "Electrical discharge; condensate 280-320K", "pressure": "1 atm", "catalyst": null, "aqueous": "true", "other": "Reduced volcanic gas mixture with aqueous condensate enabling Strecker-type downstream chemistry"}, "mechanism": "Plasma chemistry generates nitriles, aldehydes, and reduced C-N fragments that condense into aqueous amino-acid mixtures including ornithine.", "reasoning": "Modern reanalysis of Miller archival spark-discharge samples detected ornithine in volcanic and sulfidic experiments, whereas arginine was not observed (Johnson et al., 2008; Parker et al., 2011). The route is therefore chemically useful only as an ornithine entry point."}, {"id": "rxn_010", "name": "Aqueous guanidinylation of ornithine by cyanamide", "inputs": ["mol_011", "mol_007"], "outputs": ["mol_013"], "environment": "Biochemical", "agents": null, "conditions": {"temperature": "300-340K", "pressure": "1 atm", "catalyst": null, "aqueous": "true", "other": "Concentrated pools, membrane-confined water, or mineral-interface microenvironments; neutral to mildly basic pH"}, "mechanism": "The terminal delta-amine of ornithine reacts with cyanamide to install the guanidinium side chain, yielding arginine.", "reasoning": "Longo et al. showed that chemical guanidination converts ornithine side chains to arginine side chains in water and argued that cyanamide could have served as a primordial reagent (Longo et al., 2020). The supplied review notes that efficient, selective guanidinylation of free ornithine by cyanamide in water has not been published, so this monomer reaction is plausible but explicitly speculative."}, {"id": "rxn_011", "name": "HCN polymer aging and fragmentation to cyanamide", "inputs": ["mol_001", "mol_002"], "outputs": ["mol_007"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-360K", "pressure": "1 atm", "catalyst": null, "aqueous": "true", "other": "Concentrated HCN/NH3 mixtures undergoing oligomerization, aging, and partial hydrolytic fragmentation"}, "mechanism": "HCN polymer chemistry releases small C-N molecules, including cyanamide, as oligomers age and fragment.", "reasoning": "Ruiz-Bermejo et al. identify cyanamide among the small molecules generated by HCN polymer chemistry (Ruiz-Bermejo et al., 2013). Mapping this chemistry as a direct HCN plus NH3 to cyanamide step is simplified, but it is literature-based and provides a second prebiotic source of the same key guanidinylating reagent."}, {"id": "rxn_012", "name": "Subseafloor hydrothermal hydrolysis of the arginine alpha-aminonitrile", "inputs": ["mol_012"], "outputs": ["mol_013"], "environment": "Hydrothermal", "agents": null, "conditions": {"temperature": "350-390K", "pressure": "high", "catalyst": null, "aqueous": "true", "other": "Short-residence-time subseafloor pore waters to limit secondary decomposition of arginine"}, "mechanism": "Hot water promotes nitrile hydration to the corresponding amino acid, potentially yielding arginine transiently.", "reasoning": "Speculative. No hydrothermal arginine-aminonitrile hydrolysis experiment was identified in the supplied literature. This alternative is included because nitriles are generally hydrolysable in hot water, but the review stresses that arginine itself is vulnerable under harsh hydrolytic conditions. Hydrothermal support is therefore only broad thermodynamic permissibility, not direct kinetics for this substrate (Amend and Shock, 1998)."}], "pathways": [{"pathway_id": "P1", "name": "UV cyanamide plus nitrile-first cyanosulfidic route with mild pool hydrolysis", "description": "Cyanamide from irradiated ammonium cyanide feeds the Patel nitrile-first branch to the arginine alpha-aminonitrile, followed by speculative mild hydrolysis in prebiotic pools.", "reaction_sequence": ["rxn_001", "rxn_002", "rxn_003", "rxn_005", "rxn_007"], "key_intermediates": ["mol_007", "mol_009", "mol_012"]}, {"pathway_id": "P2", "name": "UV cyanamide plus nitrile-first cyanosulfidic route with hydrothermal hydrolysis", "description": "The same nitrile-first cyanosulfidic precursor route is coupled to a hotter, more speculative subseafloor hydrolysis endgame.", "reaction_sequence": ["rxn_001", "rxn_002", "rxn_003", "rxn_005", "rxn_012"], "key_intermediates": ["mol_007", "mol_009", "mol_012"]}, {"pathway_id": "P3", "name": "UV cyanamide plus aldehyde-adduct cyanosulfidic route with mild pool hydrolysis", "description": "The best-supported aldehyde-capture branch passes through beta-aminopropionaldehyde before converging on the arginine alpha-aminonitrile and then undergoing speculative mild hydrolysis.", "reaction_sequence": ["rxn_001", "rxn_002", "rxn_003", "rxn_004", "rxn_006", "rxn_007"], "key_intermediates": ["mol_007", "mol_009", "mol_010", "mol_012"]}, {"pathway_id": "P4", "name": "UV cyanamide plus aldehyde-adduct cyanosulfidic route with hydrothermal hydrolysis", "description": "The aldehyde-adduct precursor sequence is coupled to a subseafloor hydrothermal nitrile hydrolysi