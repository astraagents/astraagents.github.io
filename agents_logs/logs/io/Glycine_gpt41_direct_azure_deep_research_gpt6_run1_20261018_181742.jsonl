 \"Aminoacetaldehyde\",\n      \"common_name\": \"Aminoacetaldehyde\",\n      \"inchi\": \"InChI=1S/C2H5NO/c3-1-2-4/h2H,1,3H2\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Hydrothermal\"\n    },\n    {\n      \"id\": \"mol_018\",\n      \"formula\": \"C4H4N2O4\",\n      \"iupac_name\": \"N-oxalylglycine\",\n      \"common_name\": \"N-oxalylglycine\",\n      \"inchi\": \"InChI=1S/C4H4N2O4/c7-3(8)1-5-2(6)4(9)10/h1H2,(H2,5,6)(H,7,8)(H,9,10)\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_019\",\n      \"formula\": \"NO3-\",\n      \"iupac_name\": \"Nitrate ion\",\n      \"common_name\": \"Nitrate\",\n      \"inchi\": \"InChI=1S/NO3/c2-1(3)4/q-1\",\n      \"role\": \"starting\",\n      \"environment_formed\": \"Surface\"\n    }\n  ],\n  \"reactions\": [\n    {\n      \"id\": \"rxn_001\",\n      \"name\": \"Formaldehyde + Ammonia + HCN Strecker Synthesis\",\n      \"inputs\": [\"mol_001\", \"mol_002\", \"mol_003\"],\n      \"outputs\": [\"mol_004\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300-350K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Requires millimolar to high-millimolar reactant concentrations\"\n      },\n      \"mechanism\": \"Nucleophilic addition of cyanide to imine formed from formaldehyde and ammonia yields aminoacetonitrile.\",\n      \"reasoning\": \"The classical Strecker amino acid synthesis is well established experimentally and is central to many prebiotic amino acid experiments, including Miller's and Schlesinger's. No mineral catalyst is required (Miller, 1957; Schlesinger & Miller, 1983; Johnson et al., 2008).\"\n    },\n    {\n      \"id\": \"rxn_002\",\n      \"name\": \"Aminoacetonitrile Hydrolysis to Glycinamide\",\n      \"inputs\": [\"mol_004\"],\n      \"outputs\": [\"mol_005\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"350K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Mildly acidic or neutral pH, hydrolysis requires heat or extended time\"\n      },\n      \"mechanism\": \"Stepwise hydrolysis of the nitrile group to amide.\",\n      \"reasoning\": \"Demonstrated in acidic or prolonged aqueous conditions following Strecker/HCN chemistry (Miller, 1957; Or\u00f3 & Kamat, 1961; Schlesinger & Miller, 1983).\"\n    },\n    {\n      \"id\": \"rxn_003\",\n      \"name\": \"Glycinamide Hydrolysis to Glycine\",\n      \"inputs\": [\"mol_005\"],\n      \"outputs\": [\"mol_006\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"350-370K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Can occur on mineral surfaces or in water during hydrolysis step\"\n      },\n      \"mechanism\": \"Amide hydrolysis to carboxyl group, forming glycine.\",\n      \"reasoning\": \"Final conversion in the Strecker sequence; confirmed experimentally as the main glycine liberation step (Miller, 1957; Schlesinger & Miller, 1983).\"\n    },\n    {\n      \"id\": \"rxn_004\",\n      \"name\": \"HCN Addition to Formaldehyde (Glycolonitrile Formation)\",\n      \"inputs\": [\"mol_001\", \"mol_003\"],\n      \"outputs\": [\"mol_007\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"280-320K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Favored in cold, moderately concentrated solutions\"\n      },\n      \"mechanism\": \"Cyanide nucleophilic attack on formaldehyde forms glycolonitrile.\",\n      \"reasoning\": \"Observed as a key condensation product and precursor to Strecker network (Miller, 1957; Patel et al., 2015).\"\n    },\n    {\n      \"id\": \"rxn_005\",\n      \"name\": \"Ammoniation of Glycolonitrile to Aminoacetonitrile\",\n      \"inputs\": [\"mol_007\", \"mol_002\"],\n      \"outputs\": [\"mol_004\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300-350K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Can proceed with or without minerals\"\n      },\n      \"mechanism\": \"Amination/nucleophilic attack of ammonia on glycolonitrile converts the hydroxyl to an amino group, yielding aminoacetonitrile.\",\n      \"reasoning\": \"Established in cyanide/aldehyde/ammonia systems; direct evidence from atmospheric and cyanosulfidic prebiotic experiments (Patel et al., 2015; Schlesinger & Miller, 1983).\"\n    },\n    {\n      \"id\": \"rxn_006\",\n      \"name\": \"Aza-Cannizzaro Disproportionation (Glyoxylate + Ammonia)\",\n      \"inputs\": [\"mol_008\", \"mol_002\"],\n      \"outputs\": [\"mol_006\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"320-330K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Strongly concentration-dependent; efficient above ~0.25M glyoxylate, pH 7-10\"\n      },\n      \"mechanism\": \"Imine/hemiaminal intermediate forms; internal hydride transfer yields glycine.\",\n      \"reasoning\": \"Clean, experimentally demonstrated non-cyanide glycine formation in concentrated ammonium/glyoxylate solutions (Jarois et al., 2024).\"\n    },\n    {\n      \"id\": \"rxn_007\",\n      \"name\": \"FeS/Fe\u2070-Catalyzed Glyoxylate Reductive Amination\",\n      \"inputs\": [\"mol_008\", \"mol_002\"],\n      \"outputs\": [\"mol_006\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"FeS\u2013Fe\u2070 mineral assemblage\"],\n      \"conditions\": {\n        \"temperature\": \"295-320K\",\n        \"pressure\": \"mild hydrothermal or ambient\",\n        \"catalyst\": \"FeS\u2013Fe\u2070\",\n        \"aqueous\": true,\n        \"other\": \"Alkaline (pH 8-10), requires partial mineral reduction\"\n      },\n      \"mechanism\": \"Glyoxylate reacts with ammonia to form imine; mineral Fe(II)/Fe(0) supplies electrons to reduce imine to glycine.\",\n      \"reasoning\": \"Supported by laboratory experiments directly connecting FeS-Fe\u2070 systems to glycine synthesis from glyoxylate and NH3 (Kitadai et al., 2019).\"\n    },\n    {\n      \"id\": \"rxn_008\",\n      \"name\": \"Nitrate Reduction Coupled Glyoxylate Reductive Amination (Brucite)\",\n      \"inputs\": [\"mol_008\", \"mol_019\"],\n      \"outputs\": [\"mol_006\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"Ferroan brucite\"],\n      \"conditions\": {\n        \"temperature\": \"295-303K\",\n        \"pressure\": \"1 atm (surface/near-surface hydrothermal)\",\n        \"catalyst\": \"Ferroan brucite [Fe0.33Mg0.67(OH)2]\",\n        \"aqueous\": true,\n        \"other\": \"Alkaline conditions, up to 0.1M, 6 weeks\"\n      },\n      \"mechanism\": \"Fe(II) reduces nitrate to ammonia, which condenses with glyoxylate; further reduction gives glycine.\",\n      \"reasoning\": \"Laboratory experiments confirm coupling of nitrate reduction and glycine formation; majority of glycine forms bound to mineral phase (Chimiak et al., 2024).\"\n    },\n    {\n      \"id\": \"rxn_009\",\n      \"name\": \"Bucherer\u2013Bergs Reaction (Glyoxylate + Ammonia + Cyanide)\",\n      \"inputs\": [\"mol_008\", \"mol_003\", \"mol_002\"],\n      \"outputs\": [\"mol_010\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"330-350K\",\n        \"pressure\": \"ambient\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Often heated, works without added catal