 "key_intermediates": ["mol_007", "mol_008", "mol_014", "mol_015", "mol_016"]}, {"pathway_id": "P5", "name": "HCN-fed sulfite/ferrocyanide route with imine-first assembly", "description": "Both photoreductions use the sulfite/ferrocyanide module. Formaldehyde and glycolaldehyde adduct-release gates are explicit. No copper/sulfide stream is introduced. Success requires measured aldehyde-release flux and the shared serine-preserving hydrolysis window.", "reaction_sequence": ["rxn_004", "rxn_005", "rxn_002", "rxn_006", "rxn_007", "rxn_008", "rxn_009", "rxn_012", "rxn_013"], "key_intermediates": ["mol_011", "mol_007", "mol_012", "mol_008", "mol_013", "mol_015", "mol_016"]}, {"pathway_id": "P6", "name": "HCN-fed sulfite/ferrocyanide route with cyanohydrin-first assembly", "description": "Sulfite photochemistry supplies glycolaldehyde through two explicitly represented aldehyde reservoirs. Released glycolaldehyde is captured as glyceronitrile before ammonia delivery. Sulfite-adduct exchange, cyanohydrin exchange and final hydrolysis are separate kinetic requirements.", "reaction_sequence": ["rxn_004", "rxn_005", "rxn_002", "rxn_006", "rxn_007", "rxn_010", "rxn_011", "rxn_012", "rxn_013"], "key_intermediates": ["mol_011", "mol_007", "mol_012", "mol_014", "mol_015", "mol_016"]}, {"pathway_id": "P7", "name": "Formaldehyde-fed sulfite/ferrocyanide route with imine-first assembly", "description": "External formaldehyde is captured as glycolonitrile before introduction into the sulfite photochemical module. Glycolaldehyde-adduct release supplies imine-first Strecker chemistry. This bypasses the first photoreduction but does not resolve downstream substrate-availability or hydrolysis limitations.", "reaction_sequence": ["rxn_002", "rxn_006", "rxn_007", "rxn_008", "rxn_009", "rxn_012", "rxn_013"], "key_intermediates": ["mol_007", "mol_012", "mol_008", "mol_013", "mol_015", "mol_016"]}, {"pathway_id": "P8", "name": "Formaldehyde-fed sulfite/ferrocyanide route with cyanohydrin-firs