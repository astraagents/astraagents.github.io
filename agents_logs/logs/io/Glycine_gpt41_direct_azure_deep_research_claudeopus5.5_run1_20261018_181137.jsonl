nism\": \"Nucleophilic addition of water to the nitrile, followed by rearrangement to amide.\",\n      \"reasoning\": \"Aqueous hydrolysis of aminonitrile to glycinamide is experimentally validated (Miller, 1974). HCN is a co-product (derived from N-hydrolysis balance).\"\n    },\n    {\n      \"id\": \"rxn_004\",\n      \"name\": \"Glycine hydrolysis from glycinamide\",\n      \"inputs\": [\"mol_006\", \"mol_023\"],\n      \"outputs\": [\"mol_007\", \"mol_003\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300-370K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"mild heating, neutral to basic pH\"\n      },\n      \"mechanism\": \"Hydrolysis of amide bond by water, releasing glycine and ammonia.\",\n      \"reasoning\": \"Final canonical aqueous step in the Strecker process (Miller\u2013Urey, Johnson et al., 2008; Bada et al., 1995). Ammonia is released.\"\n    },\n    {\n      \"id\": \"rxn_005\",\n      \"name\": \"Glycolonitrile formation (cyanohydrin competition)\",\n      \"inputs\": [\"mol_002\", \"mol_001\"],\n      \"outputs\": [\"mol_008\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300-330K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"same as Strecker\"\n      },\n      \"mechanism\": \"Addition of HCN to formaldehyde, giving glycolonitrile.\",\n      \"reasoning\": \"Competing side branch to Strecker, key for byproduct distribution (Patel et al., 2015; Sutherland, 2017).\"\n    },\n    {\n      \"id\": \"rxn_006\",\n      \"name\": \"Aminoacetonitrile from glycolonitrile (cyanosulfidic chemistry)\",\n      \"inputs\": [\"mol_008\", \"mol_003\"],\n      \"outputs\": [\"mol_005\", \"mol_023\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditio