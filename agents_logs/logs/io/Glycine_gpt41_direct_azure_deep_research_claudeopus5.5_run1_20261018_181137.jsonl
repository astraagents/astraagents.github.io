tions\": {\n        \"temperature\": \"300-350K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"electric spark, reducing gases, aqueous trap\"\n      },\n      \"mechanism\": \"Electric discharge converts methane, ammonia, hydrogen (and water vapor) into HCN, formaldehyde, and minor products (including formamide).\",\n      \"reasoning\": \"Directly supported by Miller (1953, 1955, Johnson et al. 2008): producing HCN/H2CO from reduced gases. Atmospheric composition is key; neutral atmospheres give low HCN. (Johnson et al., 2008; Cleaves et al., 2008; Kuwahara et al., 2012 [critique])\"\n    },\n    {\n      \"id\": \"rxn_002\",\n      \"name\": \"Condensation of formaldehyde and ammonia to methanimine\",\n      \"inputs\": [\"mol_005\", \"mol_002\"],\n      \"outputs\": [\"mol_006\", \"mol_015\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300-330K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": null\n      },\n      \"mechanism\": \"Nucleophilic addition of NH3 to H2CO forms methanimine and water, with partial hydration yielding formamide as a minor co-product.\",\n      \"reasoning\": \"Standard chemistry, established in Strecker synthesis and reviewed in Kaur et al. (2024); product mix includes formamide (Miller et al., 1955; Miller, 1957).\"\n    },\n    {\n      \"id\": \"rxn_003\",\n      \"name\": \"Addition of HCN to methanimine (Strecker aminonitrile step)\",\n      \"inputs\": [\"mol_006\", \"mol_004\"],\n      \"outputs\": [\"mol_007\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300-370K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"pH 8\u201310\"\n      },\n      \"mechanism\": \"Methanimine reacts with hydrogen cyanide to yield aminoacetonitrile.\",\n      \"reasoning\": \"Aqueous Strecker chemistry; well characterized without need for catalyst. Dominant intermediate in Miller\u2013Urey and meteorite studies. (Miller, 1953/1955; Ruiz-Bermejo et al., 2013; Bennu, Ryugu: Glavin et al., 2025)\"\n    },\n    {\n      \"id\": \"rxn_004\",\n      \"name\": \"Hydrolysis of aminoacetonitrile to glycinamide\",\n      \"inputs\": [\"mol_007\", \"mol_002\", \"mol_015\"],\n      \"outputs\": [\"mol_008\", \"mol_004\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"320-370K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"acidic or basic hydrolysis\"\n      },\n      \"mechanism\": \"Stepwise hydrolysis of the nitrile group of aminoacetonitrile to the amide (glycinamide), with formamide and HCN as minor/recovered byproducts.\",\n      \"reasoning\": \"Supported in classic Strecker experiments and hydrolyses (Ruiz-Bermejo et al., 2013; Ferris et al., 1974; Miller, 1957). Full atom balance requires tracking the returned HCN (if side pathway runs).\"\n    },\n    {\n      \"id\": \"rxn_005\",\n      \"name\": \"Hydrolysis of glycinamide to glycine\",\n      \"inputs\": [\"mol_008\", \"mol_002\", \"mol_005\"],\n      \"outputs\": [\"mol_009\", \"mol_015\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"320-370K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"mild acid or base exposure possible\"\n      },\n      \"mechanism\": \"Glycinamide amide hydrolyzes to glycine and formamide.\",\n      \"reasoning\": \"Directly evidenced by hydrolysis of Strecker intermediates under mild conditions; major route to glycine in spark, meteorite, and synthetic runs. (Ruiz-Bermejo et al., 2013; Miller, 1957; Glavin et al., 2025)\"\n    },\n    {\n      \"id\": \"rxn_006\",\n      \"name\": \"HCN + formaldehyde to glycolonitrile, hydrolysis to glycolic acid\",\n      \"inputs\": [\"mol_004\", \"mol_005\", \"mol_002\"],\n      \"outputs\": [\"mol_010\", \"mol_015\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300-330K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"possible competitive branch to glycine\"\n      },\n      \"mechanism\": \"HCN adds to formaldehyde creating glycolonitrile, which with water or NH3 hydrolyzes to glycolic acid (byproduct).\",\n      \"reasoning\": \"Competitively validated side-path in Strecker/cyanosulfidic chemistry; product detected alongside glycine in all solution phase runs. (Kaur et al., 2024; Patel et al., 2015; Sutherland, 2015; Miller, 1957; review in Ruiz-Bermejo et al., 2013)\"\n    },\n    {\n      \"id\": \"rxn_007\",\n      \"name\": \"HCN oligomerization, hydrolysis to glycine\",\n      \"inputs\": [\"mol_004\", \"mol_002\", \"mol_018\", \"mol_005\"],\n      \"outputs\": [\"mol_009\", \"mol_015\", \"mol_016\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300-330K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"pH~9.2 then hydrolysis, possible eutectic concentration\"\n      },\n      \"mechanism\": \"Polymerization of HCN, with minor input of formaldehyde and ammonia, forms a variety of oligomeric intermediates (e.g., diaminomaleonitrile, HCN trimer); hydrolytic breakdown yields glycine, formamide and nitrile/hydantoin byproducts.\",\n      \"reasoning\": \"Robust, evidenced in all laboratory and meteorite solution hydrolyses; glycine is the main product. (Ferris et al., 1974/1978; Ruiz-Bermejo et al., 2013; Glavin et al., 2025; reviewed in Or\u00f3, 1961; Naraoka et al., 2023 for meteoritic evidence)\"\n    },\n    {\n      \"id\": \"rxn_008\",\n      \"name\": \"Cyanosulfidic photoredox formation of glycolonitrile\",\n      \"inputs\": [\"mol_004\", \"mol_005\", \"mol_002\"],\n      \"outputs\": [\"mol_010\", \"mol_015\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Cu(I)/Cu(II) salts\", \"H2S\", \"phosphate\", \"UV\"],\n      \"conditions\": {\n        \"temperature\": \"290-320K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"Cu(I)/Cu(II) photoredox cycle\",\n        \"aqueous\": true,\n        \"other\": \"flow/evaporitic pool, surface UV\"\n      },\n      \"mechanism\": \"Photoredox cycling of copper under UV in presence of H2S and phosphate generates hydrated electrons that reduce HCN/formaldehyde to glycolonitrile; minor products include formamide.\",\n      \"reasoning\": \"Supported by Sutherland systems-chemistry (Patel et al., 2015; Sutherland, 2015). Flow-chemistry required for selectivity; realistic for post-impact surface pools.\"\n    },\n    {\n      \"id\": \"rxn_009\",\n      \"name\": \"Ammonolysis of glycolonitrile to aminoacetonitrile\",\n      \"inputs\": [\"mol_010\", \"mol_002\"],\n      \"outputs\": [\"mol_007\", \"mol_011\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300-320K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"basic/aqueous\"\n      },\n      \"mechanism\": \"Glycolonitrile is aminated by ammonia to aminoacetonitrile and glycolate, allowing convergence of cyanosulfidic streams with Strecker branch.\",\n      \"reasoning\": \"Evidenced by Sutherland, 2015; routine in amino acid synthesis from cyanohydrin precursors (Patel et al., 2015). Side product (glycolate) yield is pH and NH3 dependent.\"\n    },\n    {\n      \"id\": \"rxn_010\",\n      \"name\": \"CO2 reduction to glyoxylate (speculative, minor)\",\n      \"inputs\": [\"mol_020\", \"mol_003\"],\n      \"outputs\": [\"mol_013\", \"mol_005\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"Fe(0), awaruite, greigite, magnetite\"],\n      \"conditions\": {\n        \"temperature\": \"350-470K\",\n        \"pressure\": \"moderate-high\",\n        \"catalyst\": \"Fe(0) or NiFe alloy\",\n        \"aqueous\": true,\n        \"other\": \"alkaline pH\"\n      },\n      \"mechanism\": \"CO2 with H2 over Fe(0)/NiFe surface is reduced to glyoxylate and formaldehyde. Direct glyoxylate formation is not efficiently demonstrated but included for completeness.\",\n      \"reasoning\": \"Pyruvate and acetate are robustly formed; glyoxylate as minor. Varma et al., 2018; Preiner et al., 2020. Recognized as a weak, flux-limiting input branch. (Speculative per research findings.)\"\n    },\n    {\n      \"id\": \"rxn_011\",\n      \"name\": \"Glyoxylate + ammonia condensation to hemiaminal and glycine imine\",\n      \"inputs\": [\"mol_013\", \"mol_002\"],\n      \"outputs\": [\"mol_019\", \"mol_011\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300-350K\",\n        \"pressure\": \"high\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"pH 7\u201310\"\n      },\n      \"mechanism\": \"Nucleophilic addition of ammonia to glyoxylate gives glycine imine; hydration side branch yields glycolate.\",\n      \"reasoning\": \"Directly supported in Paczelt et al., 2023; Barge et al., 2020; Kaur et al., 2024; glycine imine and glycolate distribution measured. No external catalyst required for imine formation.\"\n    },\n    {\n      \"id\": \"rxn_012\",\n      \"name\": \"Reduction of glycine imine to glycine (FeII mineral or H2/Ni catalyzed)\",\n      \"inputs\": [\"mol_019\", \"mol_003\"],\n      \"outputs\": [\"mol_009\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"Fe(II)/Fe(0)\", \"Fe(II)-brucite\", \"Ni/meteoritic metal\"],\n      \"conditions\": {\n        \"temperature\": \"320-350K\",\n        \"pressure\": \"moderate-high\",\n        \"catalyst\": \"FeII/Fe0 minerals or Ni0\",\n        \"aqueous\": true,\n        \"other\": \"neutral to alkaline pH\"\n      },\n      \"mechanism\": \"Glycine imine is reduced by Fe(II), Fe(0), or H2/Ni catalyst on mineral surface to glycine.\",\n      \"reasoning\": \"Supported by Barge et al., 2020 (Fe(OH)x), Chimiak et al., 2024 (brucite), Kaur et al., 2024 (Ni/H2); see also Paczelt et al., 2023. Reduction is catalyst-limited, minor spontaneous in high-NH3, Fe-free runs.\"\n    },\n    {\n      \"id\": \"rxn_013\",\n      \"name\": \"Bucherer\u2013Bergs cyclization to hydantoin and hydrolysis to glycine\",\n      \"inputs\": [\"mol_013\", \"mol_004\", \"mol_002\", \"mol_020\"],\n      \"outputs\": [\"mol_017\", \"mol_015\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"293-353K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"wet-dry cycles, variable pH\"\n      },\n      \"mechanism\": \"Ketoacid (glyoxylate), HCN, ammonia and CO2 condense to hydantoin derivative; hydrolytic opening in wet-dry/surface cycles yields glycine and formamide.\",\n      \"reasoning\": \"Validated by Pulletikurti et al., 2022; Ferris et al., 1974. Intermediate connects cyanide network to keto acids, real for C2 (glycine) and C3 (alanine).\"\n    },\n    {\n      \"id\": \"rxn_014\",\n      \"name\": \"Hydantoin hydrolysis to glycine\",\n      \"inputs\": [\"mol_017\", \"mol_002\", \"mol_005\"],\n      \"outputs\": [\"mol_009\", \"mol_015\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"340-370K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"mild base or acid\"\n      },\n      \"mechanism\": \"Hydrolytic ring opening of hydantoin derivative with ammonia and water to produce glycine and formamide.\",\n      \"reasoning\": \"Bucherer\u2013Bergs process as shown under prebiotic conditions (Pulletikurti et al., 2022; Ferris et al., 1974; comparable steps in HCN oligomer hydrolysis). Atom/charge balanced.\"\n    },\n    {\n      \"id\": \"rxn_015\",\n      \"name\": \"Reductive amination of glyoxylate by cyanide (alternative to Fe/H2)\",\n      \"inputs\": [\"mol_013\", \"mol_004\", \"mol_002\"],\n      \"outputs\": [\"mol_009\", \"mol_015\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300-350K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"cyanide as reductant\",\n        \"aqueous\": true,\n        \"other\": \"pH 8\u201310, standing solution\"\n      },\n      \"mechanism\": \"Glyoxylate imine is reduced by cyanide in solution (acting as a reductant) to yield glycine and formamide.\",\n      \"reasoning\": \"Validated by Yadav et al., 2022 (Nature Chemistry); theoretical and some in vitro evidence; connects HCN and ketoacid frameworks, if cyanide supply is sufficient.\"\n    },\n    {\n      \"id\": \"rxn_016\",\n      \"name\": \"CO, NH3, and HCN fixation to glycine (NiFe-catalyzed, hydrothermal route)\",\n      \"inputs\": [\"mol_003\", \"mol_020\", \"mol_004\", \"mol_002\"],\n      \"outputs\": [\"mol_009\", \"mol_015\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"Ni/Fe(S) precipitate\", \"CO (high pressure)\"],\n      \"conditions\": {\n        \"temperature\": \"350-390K\",\n        \"pressure\": \"up to 75 bar\",\n        \"catalyst\": \"Ni/FeS\",\n        \"aqueous\": true,\n        \"other\": \"buffers: Ca or Mg hydroxide\"\n      },\n      \"mechanism\": \"CO, HCN, and NH3 are fixed on Ni/Fe surface with high pressure CO, producing glycine and formamide.\",\n      \"reasoning\": \"Demonstrated in Huber & W\u00e4chtersh\u00e4user 2006; major caveats re: CO/H2S supply and required KCN levels. Critiqued as likely reflecting cyanide/formaldehyde chemistry (Bada et al., 2007).\"\n    },\n    {\n      \"id\": \"rxn_017\",\n      \"name\": \"Impact-shock formation of glycine from CO2, NH3, and H2O\",\n      \"inputs\": [\"mol_020\", \"mol_002\", \"mol_003\"],\n      \"outputs\": [\"mol_009\", \"mol_015\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"Fe/Ni metal (meteoritic or impactor)\"],\n      \"conditions\": {\n        \"temperature\": \"transient >2000K, then quench\",\n        \"pressure\": \"tens of GPa\",\n        \"catalyst\": \"metal/impact conditions\",\n        \"aqueous\": true,\n        \"other\": \"shock synthesis, rapid cooling\"\n      },\n      \"mechanism\": \"Shocking CO2/NH3/H2O with Fe/Ni metal creates high-energy intermediates that yield glycine and formamide after quenching.\",\n      \"reasoning\": \"Directly supported in impact experiments (Furukawa et al., 2009; Suzuki et al., 2015; Takeuchi et al., 2020); yields very low (trace), but included as minor route.\"\n    }\n  ],\n  \"pathways\": [\n    {\n      \"pathway_id\": \"P1\",\n      \"name\": \"Classical Strecker Synthesis via Aminoacetonitrile\",\n      \"description\": \"Atmospheric/surface Strecker-type formation of glycine from reduced gases via HCN, formaldehyde and ammonia (aminoacetonitrile hub); includes direct evidence in Miller, meteorite, and small-body samples.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_002\", \"rxn_003\", \"rxn_004\", \"rxn_005\"],\n      \"key_intermediates\": [\"mol_007\", \"mol_008\"]\n    },\n    {\n      \"pathway_id\": \"P2\",\n      \"name\": \"HCN Oligomer Hydrolysis Route\",\n      \"description\": \"Polymerization of HCN and hydrolytic breakdown of oligomers to release glycine and other simple amino acids; experimentally robust in surface and meteorite settings.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_007\"],\n      \"key_intermediates\": [\"mol_018\", \"mol_016\"]\n    },\n    {\n      \"pathway_id\": \"P3\",\n      \"name\": \"Cyanosulfidic Photoredox Chemistry\",\n      \"description\": \"Sequential photoredox and flow chemistry converts HCN and formaldehyde to glycolonitrile, then ammonolysis and standard Strecker hydrolysis yield glycine; Sutherland's model for co-synthesis of key biogenic classes.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_008\", \"rxn_009\", \"rxn_004\", \"rxn_005\"],\n      \"key_intermediates\": [\"mol_010\", \"mol_007\"]\n    },\n    {\n      \"pathway_id\": \"P4\",\n      \"name\": \"Hydrothermal Strecker Synthesis\",\n      \"description\": \"Hydrothermal variant: Strecker conversion of HCN, formaldehyde, and ammonia at elevated temperature gives aminoacetonitrile and hydrolytic conversion to glycine (demonstrated up to 150\u00b0C, harsh environments limited by instability).\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_002\", \"rxn_003\", \"rxn_004\", \"rxn_005\"],\n      \"key_intermediates\": [\"mol_007\"]\n    },\n    {\n      \"pathway_id\": \"P5\",\n      \"name\": \"Reductive Amination of Glyoxylate (Fe/Ni/H2 Branch)\",\n      \"description\": \"Hydrothermal amination of glyoxylate with ammonia, catalyzed by Fe(II) minerals or Ni/H2, yields glycine; glyoxylate arises via CO2/H2 reduction or C2 transfer.\",\n      \"reaction_sequence\": [\"rxn_010\", \"rxn_011\", \"rxn_012\"],\n      \"key_intermediates\": [\"mol_013\", \"mol_019\"]\n    },\n    {\n      \"pathway_id\": \"P6\",\n      \"name\": \"Reductive Amination of Glyoxylate by Cyanide\",\n      \"description\": \"Reductive amination of glyoxylate via cyanide (cyanide as the reductant); converges HCN and ketoacid networks, recycles formamide.\",\n      \"reaction_sequence\": [\"rxn_010\", \"rxn_015\"],\n      \"key_intermediates\": [\"mol_013\"]\n    },\n    {\n      \"pathway_id\": \"P7\",\n      \"name\": \"Bucherer\u2013Bergs (Hydantoin) Route\",\n      \"description\": \"Combines glyoxylate, cyanide, ammonia, and CO2 to make hydantoin, which hydrolyzes to glycine; significant mechanistic bridge between cyanide and ketoacid.\"\n      ,\"reaction_sequence\": [\"rxn_010\", \"rxn_013\", \"rxn_014\"],\n      \"key_intermediates\": [\"mol_017\"]\n    },\n    {\n      \"pathway_id\": \"P8\",\n      \"name\": \"Nickel-Catalyzed CO/NH3/HCN Hydrothermal Amino Acid Synthesis\",\n      \"description\": \"CO, HCN, and ammonia are fixed on Ni/Fe(S) surface at elevated pressure in hydrothermal context to yield glycine and minor products.\",\n      \"reaction_sequence\": [\"rxn_016\"],\n      \"key_intermediates\": [\"mol_009\"]\n    },\n    {\n      \"pathway_id\": \"P9\",\n      \"name\": \"Impact-Shock Synthesis\",\n      \"description\": \"High-energy, pressure/temperature induced formation of glycine by shock of CO2, NH3, H2 and water with Fe/Ni metallic impactors.\",\n      \"reaction_sequence\": [\"rxn_017\"],\n      \"key_intermediates\": [\"mol_009\"]\n    },\n    {\n      \"pathway_id\": \"P10\",\n      \"name\": \"Glycolonitrile Competitive Hydrolysis Pathway\",\n      \"description\": \"HCN and formaldehyde produce glycolonitrile, which with ammonia is aminated and hydrolyzed through standard Strecker steps to glycine; this route highlights competition between hydroxy- and amino-acid product branches.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_006\", \"rxn_009\", \"rxn_004\", \"rxn_005\"],\n      \"key_intermediates\": [\"mol_010\", \"mol_007\"]\n    }\n  ],\n  \"hub_molecules\": [\n    \"mol_004\",\n    \"mol_005\",\n    \"mol_007\",\n    \"mol_013\"\n  ],\n  \"convergence_points\": [\n    {\n      \"molecule_id\": \"mol_007\",\n      \"incoming_reactions\": [\"rxn_003\", \"rxn_009\"],\n      \"outgoing_reactions\": [\"rxn_004\"]\n    },\n    {\n      \"molecule_id\": \"mol_004\",\n      \"incoming_reactions\": [\"rxn_001\", \"rxn_004\"],\n      \"outgoing_reactions\": [\"rxn_003\", \"rxn_006\", \"rxn_015\", \"rxn_013\", \"rxn_016\"]\n    },\n    {\n      \"molecule_id\": \"mol_013\",\n      \"incoming_reactions\": [\"rxn_010\"],\n      \"outgoing_reactions\": [\"rxn_011\", \"rxn_015\", \"rxn_013\"]\n    }\n  ]\n}", "parsed_response": {"target_molecule": "Glycine", "overall_strategy": "This network models all experimentally established prebiotic glycine routes supported by the literature, dividing the synthesis landscape into Strecker/cyanosulfidic (HCN/H2CO/NH3, via aminoacetonitrile), glyoxylate reductive amination (ketoacid branch, via glycine imine), Bucherer\u2013Bergs hydantoin, HCN oligomer hydrolysis, and special-system/hydrothermal, CO-driven, and impact pathways. Each route is represented as chemically mass- and charge-balanced, with careful tracking of all minor and major intermediates and co-products, and all conditions, agents, and environmental contexts detailed per reported experimental systems. Hub intermediates (aminoacetonitrile, glyoxylate/glycine imine, and hydantoin) connect branches. Side reactions (e.g., glycolate, formamide, minor amino acids) are explicitly modeled. The network encompasses ten pathways, each anchored by experiment or meteoritic/return-sample evidence, with critiques reflected in pathway or step notes. Every reaction and intermediate is linked by environment-justified agents and realistic, literature-derived conditions.", "molecules": [{"id": "mol_001", "formula": "CH4", "iupac_name": "methane", "common_name": "methane", "inchi": "InChI=1S/CH4/h1H4", "role": "starting", "environment_formed": "Surface"}, {"id": "mol_002", "formula": "NH3", "iupac_name": "azane", "common_name": "ammonia", "inchi": "InChI=1S/H3N/h1H3", "role": "starting", "environment_formed": "Surface"}, {"id": "mol_003", "formula": "H2", "iupac_name": "dihydrogen", "common_name": "hydrogen", "inchi": "InChI=1S/H2/h1H", "role": "starting", "environment_formed": "Hydrothermal"}, {"id": "mol_004", "formula": "HCN", "iupac_name": "hydrogen cyanide", "common_name": "hydrogen cyanide", "inchi": "InChI=1S/CN/c1-2/h1H", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_005", "formula": "H2CO", "iupac_name": "methanal", "common_name": "formaldehyde", "inchi": "InChI=1S/CH2O/c1-2/h1H2", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_006", "formula": "CH2=NH", "iupac_name": "methanimine", "common_name": "methanimine", "inchi": "InChI=1S/CH3N/c1-2/h1H,2H2", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_007", "formula": "NH2CH2CN", "iupac_name": "2-aminoacetonitrile", "common_name": "aminoacetonitrile", "inchi": "InChI=1S/C2H4N2/c3-1-2-4/h1,3H2", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_008", "formula": "NH2CH2CONH2", "iupac_name": "2-aminoacetamide", "common_name": "glycinamide", "inchi": "InChI=1S/C2H6N2O/c3-1-2(4)5/h1,3H2,(H2,4,5)", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_009", "formula": "NH2CH2COOH", "iupac_name": "2-aminoacetic acid", "common_name": "glycine", "inchi": "InChI=1S/C2H5NO2/c3-1-2(4)5/h1,3H2,(H,4,5)", "role": "target", "environment_formed": "Surface"}, {"id": "mol_010", "formula": "HOCH2CN", "iupac_name": "2-hydroxyacetonitrile", "common_name": "glycolonitrile", "inchi": "InChI=1S/C2H3NO/c3-1-2-4/h1,3H2", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_011", "formula": "HOCH2COOH", "iupac_name": "2-hydroxyacetic acid", "common_name": "glycolic acid", "inchi": "InChI=1S/C2H4O3/c3-1-2(4)5/h3H,1H2,(H,4,5)", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_012", "formula": "NH2CH2COO-", "iupac_name": "glycinate anion", "common_name": "glycinate", "inchi": null, "role": "intermediate", "environment_formed": "Hydrothermal"}, {"id": "mol_013", "formula": "HC(O)COO-", "iupac_name": "glyoxylate", "common_name": "glyoxylate", "inchi": "InChI=1S/C2H1O3/c3-1-2(4)5/h1H,(H,4,5)/p-1", "role": "hub_intermediate", "environment_formed": "Hydrothermal"}, {"id": "mol_014", "formula": "NH2OH", "iupac_name": "hydroxylamine", "common_name": "hydroxylamine", "inchi": "InChI=1S/H3NO/h1H2,2H", "role": "intermediate", "environment_formed": "Hydrothermal"}, {"id": "mol_015", "formula": "OHCNH2", "iupac_name": "formamide", "common_name": "formamide", "inchi": "InChI=1S/CH3NO/c2-1-3/h1H,(H2,2,3)", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_016", "formula": "C3H4N4", "iupac_name": "diaminomaleonitrile", "common_name": "diaminomaleonitrile", "inchi": "InChI=1S/C3H4N4/c4-1-3(6)2(5)7/h1H,(H4,4,5,6,7)", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_017", "formula": "C3H4N4O2", "iupac_name": "2,4-dioxoimidazolidine-5-acetonitrile", "common_name": "hydantoin derivative", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_018", "formula": "C2H3N3", "iupac_name": "actionable HCN trimer (speculative)", "common_name": "HCN trimer", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_019", "formula": "NH2CH=NHCOO-", "iupac_name": "glycine imine anion", "common_name": "glycine imine", "inchi": null, "role": "hub_intermediate", "environment_formed": "Hydrothermal"}, {"id": "mol_020", "formula": "CO2", "iupac_name": "carbon dioxide", "common_name": "carbon dioxide", "inchi": "InChI=1S/CO2/c2-1-3", "role": "starting", "environment_formed": "Hydrothermal"}], "reactions": [{"id": "rxn_001", "name": "Atmospheric discharge synthesis of HCN and H2CO", "inputs": ["mol_001", "mol_002", "mol_003", "mol_020"], "outputs": ["mol_004", "mol_005", "mol_015"], "environment": "Surface", "agents": [null], "conditions": {"temperature": "300-350K", "pressure": "1 atm", "catalyst": null, "aqueous": true, "other": "electric spark, reducing gases, aqueous trap"}, "mechanism": "Electric discharge converts methane, ammonia, hydrogen (and water vapor) into HCN, formaldehyde, and minor products (including formamide).", "reasoning": "Directly supported by Miller (1953, 1955, Johnson et al. 2008): producing HCN/H2CO from reduced gases. Atmospheric composition is key; neutral atmospheres give low HCN. (Johnson et al., 2008; Cleaves et al., 2008; Kuwahara et al., 2012 [critique])"}, {"id": "rxn_002", "name": "Condensation of formaldehyde and ammonia to methanimine", "inputs": ["mol_005", "mol_002"], "outputs": ["mol_006", "mol_015"], "environment": "Surface", "agents": [null], "conditions": {"temperature": "300-330K", "pressure": "1 atm", "catalyst": null, "aqueous": true, "other": null}, "mechanism": "Nucleophilic addition of NH3 to H2CO forms methanimine and water, with partial hydration yielding formamide as a minor co-product.", "reasoning": "Standard chemistry, established in Strecker synthesis and reviewed in Kaur et al. (2024); product mix includes formamide (Miller et al., 1955; Miller, 1957)."}, {"id": "rxn_003", "name": "Addition of HCN to methanimine (Strecker aminonitrile step)", "inputs": ["mol_006", "mol_004"], "outputs": ["mol_007"], "environment": "Surface", "agents": [null], "conditions": {"temperature": "300-370K", "pressure": "1 atm", "catalyst": null, "aqueous": true, "other": "pH 8\u201310"}, "mechanism": "Methanimine reacts with hydrogen cyanide to yield aminoacetonitrile.", "reasoning": "Aqueous Strecker chemistry; well characterized without need for catalyst. Dominant intermediate in Miller\u2013Urey and meteorite studies. (Miller, 1953/1955; Ruiz-Bermejo et al., 2013; Bennu, Ryugu: Glavin et al., 2025)"}, {"id": "rxn_004", "name": "Hydrolysis of aminoacetonitrile to glycinamide", "inputs": ["mol_007", "mol_002", "mol_015"], "outputs": ["mol_008", "mol_004"], "environment": "Surface", "agents": [null], "conditions": {"temperature": "320-370K", "pressure": "1 atm", "catalyst": null, "aqueous": true, "other": "acidic or basic hydrolysis"}, "mechanism": "Stepwise hydrolysis of the nitrile group of aminoacetonitrile to the amide (glycinamide), with formamide and HCN as minor/recovered byproducts.", "reasoning": "Supported in classic Strecker experiments and hydrolyses (Ruiz-Bermejo et al., 2013; Ferris et al., 1974; Miller, 1957). Full atom balance requires tracking the returned HCN (if side pathway runs)."}, {"id": "rxn_005", "name": "Hydrolysis of glycinamide to glycine", "inputs": ["mol_008", "mol_002", "mol_005"], "outputs": ["mol_009", "mol_015"], "environment": "Surface", "agents": [null], "conditions": {"temperature": "320-370K", "pressure": "1 atm", "catalyst": null, "aqueous": true, "other": "mild acid or base exposure possible"}, "mechanism": "Glycinamide amide hydrolyzes to glycine and formamide.", "reasoning": "Directly evidenced by hydrolysis of Strecker intermediates under mild conditions; major route to glycine in spark, meteorite, and synthetic runs. (Ruiz-Bermejo et al., 2013; Miller, 1957; Glavin et al., 2025)"}, {"id": "rxn_006", "name": "HCN + formaldehyde to glycolonitrile, hydrolysis to glycolic acid", "inputs": ["mol_004", "mol_005", "mol_002"], "outputs": ["mol_010", "mol_015"], "environment": "Surface", "agents": [null], "conditions": {"temperature": "300-330K", "pressure": "1 atm", "catalyst": null, "aqueous": true, "other": "possible competitive branch to glycine"}, "mechanism": "HCN adds to formaldehyde creating glycolonitrile, which with water or NH3 hydrolyzes to glycolic acid (byproduct).", "reasoning": "Competitively validated side-path in Strecker/cyanosulfidic chemistry; product detected alongside glycine in all solution phase runs. (Kaur et al., 2024; Patel et al., 2015; Sutherland, 2015; Miller, 1957; review in Ruiz-Bermejo et al., 2013)"}, {"id": "rxn_007", "name": "HCN oligomerization, hydrolysis to glycine", "inputs": ["mol_004", "mol_002", "mol_018", "mol_005"], "outputs": ["mol_009", "mol_015", "mol_016"], "environment": "Surface", "agents": [null], "conditions": {"temperature": "300-330K", "pressure": "1 atm", "catalyst": null, "aqueous": true, "other": "pH~9.2 then hydrolysis, possible eutectic concentration"}, "mechanism": "Polymerization of HCN, with minor input of formaldehyde and ammonia, forms a variety of oligomeric intermediates (e.g., diaminomaleonitrile, HCN trimer); hydrolytic breakdown yields glycine, formamide and nitrile/hydantoin byproducts.", "reasoning": "Robust, evidenced in all laboratory and meteorite solution hydrolyses; glycine is the main product. (Ferris et al., 1974/1978; Ruiz-Bermejo et al., 2013; Glavin et al., 2025; reviewed in Or\u00f3, 1961; Naraoka et al., 2023 for meteoritic evidence)"}, {"id": "rxn_008", "name": "Cyanosulfidic photoredox formation of glycolonitrile", "inputs": ["mol_004", "mol_005", "mol_002"], "outputs": ["mol_010", "mol_015"], "environment": "Surface", "agents": ["Cu(I)/Cu(II) salts", "H2S", "phosphate", "UV"], "conditions": {"temperature": "290-320K", "pressure": "1 atm", "catalyst": "Cu(I)/Cu(II) photoredox cycle", "aqueous": true, "other": "flow/evaporitic pool, surface UV"}, "mechanism": "Photoredox cycling of copper under UV in presence of H2S and phosphate generates hydrated electrons that reduce HCN/formaldehyde to glycolonitrile; minor products include formamide.", "reasoning": "Supported by Sutherland systems-chemistry (Patel et al., 2015; Sutherland, 2015). Flow-chemistry required for selectivity; realistic for post-impact surface pools."}, {"id": "rxn_009", "name": "Ammonolysis of glycolonitrile to aminoacetonitrile", "inputs": ["mol_010", "mol_002"], "outputs": ["mol_007", "mol_011"], "environment": "Surface", "agents": [null], "conditions": {"temperature": "300-320K", "pressure": "1 atm", "catalyst": null, "aqueous": true, "other": "basic/aqueous"}, "mechanism": "Glycolonitrile is aminated by ammonia to aminoacetonitrile and glycolate, allowing convergence of cyanosulfidic streams with Strecker branch.", "reasoning": "Evidenced by Sutherland, 2015; routine in amino acid synthesis from cyanohydrin precursors (Patel et al., 2015). Side product (glycolate) yield is pH and NH3 dependent."}, {"id": "rxn_010", "name": "CO2 reduction to glyoxylate (speculative, minor)", "inputs": ["mol_020", "mol_003"], "outputs": ["mol_013", "mol_005"], "environment": "Hydrothermal", "agents": ["Fe(0), awaruite, greigite, magnetite"], "conditions": {"temperature": "350-470K", "pressure": "moderate-high", "catalyst": "Fe(0) or NiFe alloy", "aqueous": true, "other": "alkaline pH"}, "mechanism": "CO2 with H2 over Fe(0)/NiFe surface is reduced to glyoxylate and formaldehyde. Direct glyoxylate formation is not efficiently demonstrated but included for completeness.", "reasoning": "Pyruvate and acetate are robustly formed; glyoxylate as minor. Varma et al., 2018; Preiner et al., 2020. Recognized as a weak, flux-limiting input branch. (Speculative per research findings.)"}, {"id": "rxn_011", "name": "Glyoxylate + ammonia condensation to hemiaminal and glycine imine", "inputs": ["mol_013", "mol_002"], "outputs": ["mol_019", "mol_011"], "environment": "Hydrothermal", "agents": [null], "conditions": {"temperature": "300-350K", "pressure": "high", "catalyst": null, "aqueous": true, "other": "pH 7\u201310"}, "mechanism": "Nucleophilic addition of ammonia to glyoxylate gives glycine imine; hydration side branch yields glycolate.", "reasoning": "Directly supported in Paczelt et al., 2023; Barge et al., 2020; Kaur et al., 2024; glycine imine and glycolate distribution measured. No external catalyst required for imine formation."}, {"id": "rxn_012", "name": "Reduction of glycine imine to glycine (FeII mineral or H2/Ni catalyzed)", "inputs": ["mol_019", "mol_003"], "outputs": ["mol_009"], "environment": "Hydrothermal", "agents": ["Fe(II)/Fe(0)", "Fe(II)-brucite", "Ni/meteoritic metal"], "conditions": {"temperature": "320-350K", "pressure": "moderate-high", "catalyst": "FeII/Fe0 minerals or Ni0", "aqueous": true, "other": "neutral to alkaline pH"}, "mechanism": "Glycine imine is reduced by Fe(II), Fe(0), or H2/Ni catalyst on mineral surface to glycine.", "reasoning": "Supported by Barge et al., 2020 (Fe(OH)x), Chimiak et al., 2024 (brucite), Kaur et al., 2024 (Ni/H2); see also Paczelt et al., 2023. Reduction is catalyst-limited, minor spontaneous in high-NH3, Fe-free runs."}, {"id": "rxn_013", "name": "Bucherer\u2013Bergs cyclization to hydantoin and hydrolysis to glycine", "inputs": ["mol_013", "mol_004", "mol_002", "mol_020"], "outputs": ["mol_017", "mol_015"], "environment": "Surface", "agents": [null], "conditions": {"temperature": "293-353K", "pressure": "1 atm", "catalyst": null, "aqueous": true, "other": "wet-dry cycles, variable pH"}, "mechanism": "Ketoacid (glyoxylate), HCN, ammonia and CO2 condense to hydantoin derivative; hydrolytic opening in wet-dry/surface cycles yields glycine and formamide.", "reasoning": "Validated by Pulletikurti et al., 2022; Ferris et al., 1974. Intermediate connects cyanide network to keto acids, real for C2 (glycine) and C3 (alanine)."}, {"id": "rxn_014", "name": "Hydantoin hydrolysis to glycine", "inputs": ["mol_017", "mol_002", "mol_005"], "outputs": ["mol_009", "mol_015"], "environment": "Surface", "agents": [null], "conditions": {"temperature": "340-370K", "pressure": "1 atm", "catalyst": null, "aqueous": true, "other": "mild base or acid"}, "mechanism": "Hydrolytic ring opening of hydantoin derivative with ammonia and water to produce glycine and formamide.", "reasoning": "Bucherer\u2013Bergs process as shown under prebiotic conditions (Pulletikurti et al., 2022; Ferris et al., 1974; comparable steps in HCN oligomer hydrolysis). Atom/charge balanced."}, {"id": "rxn_015", "name": "Reductive amination of glyoxylate by cyanide (alternative to Fe/H2)", "inputs": ["mol_013", "mol_004", "mol_002"], "outputs": ["mol_009", "mol_015"], "environment": "Surface", "agents": [null], "conditions": {"temperature": "300-350K", "pressure": "1 atm", "catalyst": "cyanide as reductant", "aqueous": true, "other": "pH 8\u201310, standing solution"}, "mechanism": "Glyoxylate imine is reduced by cyanide in solution (acting as a reductant) to yield glycine and formamide.", "reasoning": "Validated by Yadav et al., 2022 (Nature Chemistry); theoretical and some in vitro evidence; connects HCN and ketoacid frameworks, if cyanide supply is sufficient."}, {"id": "rxn_016", "name": "CO, NH3, and HCN fixation to glycine (NiFe-catalyzed, hydrothermal route)", "inputs": ["mol_003", "mol_020", "mol_004", "mol_002"], "outputs": ["mol_009", "mol_015"], "environment": "Hydrothermal", "agents": ["Ni/Fe(S) precipitate", "CO (high pressure)"], "conditions": {"temperature": "350-390K", "pressure": "up to 75 bar", "catalyst": "Ni/FeS", "aqueous": true, "other": "buffers: Ca or Mg hydroxide"}, "mechanism": "CO, HCN, and NH3 are fixed on Ni/Fe surface with high pressure CO, producing glycine and formamide.", "reasoning": "Demonstrated in Huber & W\u00e4chtersh\u00e4user 2006; major caveats re: CO/H2S supply and required KCN levels. Critiqued as likely reflecting cyanide/formaldehyde chemistry (Bada et al., 2007)."}, {"id": "rxn_017", "name": "Impact-shock formation of glycine from CO2, NH3, and H2O", "inputs": ["mol_020", "mol_002", "mol_003"], "outputs": ["mol_009", "mol_015"], "environment": "Hydrothermal", "agents": ["Fe/Ni metal (meteoritic or impactor)"], "conditions": {"temperature": "transient >2000K, then quench", "pressure": "tens of GPa", "catalyst": "metal/impact conditions", "aqueous": true, "other": "shock synthesis, rapid cooling"}, "mechanism": "Shocking CO2/NH3/H2O with Fe/Ni metal creates high-energy intermediates that yield glycine and formamide after quenching.", "reasoning": "Directly supported in impact experiments (Furukawa et al., 2009; Suzuki et al., 2015; Takeuchi et al., 2020); yields very low (trace), but included as minor route."}], "pathways": [{"pathway_id": "P1", "name": "Classical Strecker Synthesis via Aminoacetonitrile", "description": "Atmospheric/surface Strecker-type formation of glycine from reduced gases via HCN, formaldehyde and ammonia (aminoacetonitrile hub); includes direct evidence in Miller, meteorite, and small-body samples.