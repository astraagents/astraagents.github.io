\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"400-470K\",\n        \"pressure\": \"high\",\n        \"catalyst\": null,\n        \"aqueous\": \"true\",\n        \"other\": \"High-temperature hydrothermal vent\"\n      },\n      \"mechanism\": \"Hydrolytic degradation via aspartate intermediate, producing two equivalents of glycine.\",\n      \"reasoning\": \"Direct experimental kinetics; see Qian et al. (1993, GCA).\"\n    },\n    {\n      \"id\": \"rxn_008\",\n      \"name\": \"Isocitrate iron-catalyzed cleavage to glyoxylate\",\n      \"inputs\": [\"mol_014\"],\n      \"outputs\": [\"mol_005\", \"mol_015\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"Ferrous iron\"],\n      \"conditions\": {\n        \"temperature\": \"343K\",\n        \"pressure\": \"high\",\n        \"catalyst\": \"Fe^2+\",\n        \"aqueous\": \"true\",\n        \"other\": \"Near-neutral pH\"\n      },\n      \"mechanism\": \"Fe^2+-promoted retro-aldol fragmentation of isocitrate to glyoxylate and succinate.\",\n      \"reasoning\": \"Confirmed origin of metabolic glyoxylate; see Muchowska et al. (2019, Nature).\"\n    },\n    {\n      \"id\": \"rxn_009\",\n      \"name\": \"2,2-Dihydroxyacetic acid UV photodehydration to glyoxylate\",\n      \"inputs\": [\"mol_016\"],\n      \"outputs\": [\"mol_005\", \"mol_003\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Ultraviolet radiation\"],\n      \"conditions\": {\n        \"temperature\": \"300-330K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"UV\",\n        \"aqueous\": \"true\",\n        \"other\": \"UV-irradiated shallow pool\"\n      },\n      \"mechanism\": \"UV-driven dehydration eliminates H2O from gem-diol, yielding glyoxylate.\",\n      \"reasoning\": \"Experimentally established as photochemical glyoxylate source; see Liu et al. (2021, Nature Chem).\"\n    },\n    {\n      \"id\": \"rxn_010\",\n      \"name\":