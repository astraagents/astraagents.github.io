ronment\": \"Surface\",\n      \"agents\": [\"null\"],\n      \"conditions\": {\n        \"temperature\": \"300-320K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"neutral to mildly basic pH\"\n      },\n      \"mechanism\": \"Conjugate (Michael-type) addition of HCN to the \u03b2-carbon of acrolein yielding 3-cyanopropanal.\",\n      \"reasoning\": \"Explicitly proposed as the C4 precursor step in Miller-type prebiotic chemistry; see Van Trump & Miller (1972), Parker et al. (2011). While never complete in a one-pot Glu synthesis, the chemistry is plausible and mass balanced under aqueous conditions.\"\n    },\n    {\n      \"id\": \"rxn_002\",\n      \"name\": \"Strecker synthesis from 3-cyanopropanal to glutaminonitrile (\u03b1-aminonitrile)\",\n      \"inputs\": [\"mol_004\", \"mol_002\", \"mol_003\", \"mol_014\"],\n      \"outputs\": [\"mol_005\", \"mol_014\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"null\"],\n      \"conditions\": {\n        \"temperature\": \"280-330K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"neutral to basic pH\"\n      },\n      \"mechanism\": \"Sequential nucleophilic addition of ammonia and cyanide to the carbonyl of 3-cyanopropanal followed by proton transfers and formation of \u03b1-aminonitrile.\",\n      \"reasoning\": \"Strecker chemistry is well established for small aldehydes and is plausible for this intermediate. Prebiotic conditions supported by Parker et al. (2011), Johnson et al. (2008), and analogous aldehyde Strecker.\"\n    },\n    {\n      \"id\": \"rxn_003\",\n      \"name\": \"Hydrolysis of glutaminonitrile to glutamic acid\",\n      \"inputs\": [\"mol_005\", \"mol_014\"],\n      \"outputs\": [\"mol_006\", \"mol_014\", \"mol_003\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\"null\"],\n      \"conditions\": {\n        \"temperature\": \"340-370K (evaporitic cycling)\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Wet-dry cycling with heating, repeated hydration\"\n      },\n      \"mechanism\": \"Two-step hydrolysis of the aminonitrile: first to the amide, second to the amino acid, with stoichiometric consumption and production of water and ammonia.\",\n      \"reasoning\": \"Hydrolysis is well supported in prebiotic chemistry; Miller experiments and HCN polymer hydrolysis demonstrate conversion to amino acids. Mass-balanced with water and ammonia byproducts (Ruiz-Bermejo et al. 2013; Parker et al. 2011).\"\n    },\n    {\n      \"id\": \"rxn_004\",\n      \"name\": \"Cyanosulfidic photoreduction to 3-cyanopropanal from succinonitrile\",\n      \"inputs\": [\"mol_002\", \"mol_002\", \"mol_014\"],\n      \"outputs\": [\"mol_004\", \"mol_002\", \"mol_014\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Cu(I)/Cu(II)\", \"H2S\"],\n      \"conditions\": {\n        \"temperature\": \"300-320K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"Cu(I)/Cu(II) (trace copper salt)\",\n        \"aqueous\": true,\n        \"other\": \"Strong UV (254 nm), presence of H2S as reductant\"\n      },\n      \"mechanism\": \"UV-driven, Cu-photoredox cycle: two sequential photoreductions of succinonitrile in the presence of H2S yield the semialdehyde 3-cyanopropanal, liberating HCN and water.\",\n      \"reasoning\": \"Experimentally reported by Patel et al. (2015, Nature Chemistry). Requires local sulfide, copper, and UV; per-step yields and balances inferred from full mechanism.\"\n    },\n    {\n      \"id\": \"rxn_005\",\n      \"name\": \"Polymerization of HCN to aminonitrile-rich HCN tetramers (DAMN-type intermediates)\",\n      \"inputs\": [\"mol_002\", \"mol_002\", \"mol_002\", \"mol_002\"],\n      \"outputs\": [\"mol_013\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"null\"],\n      \"conditions\": {\n        \"temperature\": \"300-330K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"High HCN concentration\"\n      },\n      \"mechanism\": \"Stepwise condensation of four HCN molecules in mildly basic solution forms diamino-maleonitrile or related aminonitrile tetramers.\",\n      \"reasoning\": \"Directly supported by Ferris et al. (1978), Ruiz-Bermejo et al. (2013). Mass-balanced for 4 \u00d7 HCN \u2192 HCN tetramer; structure represents major prebiotic polymer intermediate to Glu via hydrolysis.\"\n    },\n    {\n      \"id\": \"rxn_006\",\n      \"name\": \"Hydrolysis of HCN polymers to aminonitriles/amino acids (includes Glu fragment release)\",\n      \"inputs\": [\"mol_013\", \"mol_014\", \"mol_014\", \"mol_014\"],\n      \"outputs\": [\"mol_005\", \"mol_014\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\"null\"],\n      \"conditions\": {\n        \"temperature\": \"340-360K; acid hydrolysis\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Acidic pH, extended heating\"\n      },\n      \"mechanism\": \"Acid-catalyzed hydrolysis of amidine-rich HCN polymers yields \u03b1-aminonitrile and pentanedioic fragments; water incorporated in hydrolytic cleavage.\",\n      \"reasoning\": \"Reported in Ruiz-Bermejo et al. (2013); although structures in prebiotic mixtures are distributed, release of Glu-relevant aminonitrile units is supported. Water stoichiometry modular to polymer size; simplified here.\"\n    },\n    {\n      \"id\": \"rxn_007\",\n      \"name\": \"Aldol condensation of glyoxylate and pyruvate forming hydroxyketoglutarate\",\n      \"inputs\": [\"mol_008\", \"mol_009\"],\n      \"outputs\": [\"mol_010\", \"mol_007\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Fe2+\"],\n      \"conditions\": {\n        \"temperature\": \"340-343K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"Fe2+\",\n        \"aqueous\": true,\n        \"other\": \"Mildly basic, phosphate buffer (if present)\"\n      },\n      \"mechanism\": \"Fe2+- or phosphate-catalyzed aldol reaction: nucleophilic addition of glyoxylate to pyruvate forms hydroxyketoglutarate, which is dehydrated to oxopentenedioate and then reduced (in situ or by glyoxylate acting as reductant) to \u03b1-ketoglutarate, releasing CO2.\",\n      \"reasoning\": \"Direct kinetics and yields from Muchowska et al. (2019, Nature), Stubbs et al. (2020). Reaction sequence mass-balanced by tracking CO2 loss from the reduction step.\"\n    },\n    {\n      \"id\": \"rxn_008\",\n      \"name\": \"Reductive amination of \u03b1-ketoglutarate to glutamate\",\n      \"inputs\": [\"mol_003\", \"mol_010\", \"mol_014\"],\n      \"outputs\": [\"mol_006\", \"mol_014\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"FeS (freshly precipitated)\"],\n      \"conditions\": {\n        \"temperature\": \"323-350K\",\n        \"pressure\": \"high\",\n        \"catalyst\": \"FeS\",\n        \"aqueous\": true,\n        \"other\": \"Alkaline vent, near-neutral pH, H2 as possible reductant\"\n      },\n      \"mechanism\": \"Nucleophilic addition of ammonia to the \u03b1-keto group forms an imine, which is reduced at the mineral surface/hydride transfer to give glutamate; water is released in the process.\",\n      \"reasoning\": \"Supported by Huber & W\u00e4chtersh\u00e4user (2003), Kitadai et al. (2019) (electrochemically reduced FeS). Mass and charge balanced with explicit H2O loss; FeS favored, other minerals inactive.\"\n    },\n    {\n      \"id\": \"rxn_009\",\n      \"name\": \"Bucherer\u2013Bergs hydantoin synthesis from \u03b1-KG (cyanide addition and cyclization)\",\n      \"inputs\": [\"mol_010\", \"mol_002\", \"mol_003\", \"mol_014\"],\n      \"outputs\": [\"mol_016\", \"mol_014\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\"Diamidophosphate (DAP, catalytic)\"],\n      \"conditions\": {\n        \"temperature\": \"293-303K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"DAP (prebiotically ambiguous)\",\n        \"aqueous\": true,\n        \"other\": \"pH 7\u20138\"\n      },\n      \"mechanism\": \"Addition of ammonia and cyanide to \u03b1-KG, forming glutamate hydantoin via cyclization and loss of water.\",\n      \"reasoning\": \"Reaction and yields from Pulletikurti et al. (2022). Cyanide usage is plausible but debated (see manuscript). Water loss included; DAP a reasonable prebiotic agent but supply rate-limiting.\"\n    },\n    {\n      \"id\": \"rxn_010\",\n      \"name\": \"Hydrolysis of glutamate hydantoin to glutamate\",\n      \"inputs\": [\"mol_016\", \"mol_014\", \"mol_014\"],\n      \"outputs\": [\"mol_006\", \"mol_014\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\"null\"],\n      \"conditions\": {\n        \"temperature\": \"353-358K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Acidic pH; heat\"\n      },\n      \"mechanism\": \"Acid- or heat-promoted hydrolytic ring opening of hydantoin to glutamic acid, with water uptake and release of ammonia as minor byproduct.\",\n      \"reasoning\": \"Supported by Pulletikurti et al. (2022). Two water equivalents for full hydrolysis; mass balanced.\"\n    },\n    {\n      \"id\": \"rxn_011\",\n      \"name\": \"Transamination of \u03b1-ketoglutarate and glycine to glutamate and glyoxylate\",\n      \"inputs\": [\"mol_010\", \"mol_011\"],\n      \"outputs\": [\"mol_006\", \"mol_008\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\"null\"],\n      \"conditions\": {\n        \"temperature\": \"293-318K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"PLP-analogue possible, but not required\"\n      },\n      \"mechanism\": \"Aminotransfer: Transfer of an amino group from glycine to the carbonyl carbon of \u03b1-ketoglutarate, yielding glutamate and glyoxylate.\",\n      \"reasoning\": \"Nonenzymatic transamination under plausible prebiotic conditions demonstrated in Stubbs et al. (2020), Kaur et al. (2024). Mass and charge conserved.\"\n    },\n    {\n      \"id\": \"rxn_012\",\n      \"name\": \"Cyclization of glutamic acid to pyroglutamic acid (reversible dehydration)\",\n      \"inputs\": [\"mol_006\"],\n      \"outputs\": [\"mol_012\", \"mol_014\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\"null\"],\n      \"conditions\": {\n        \"temperature\": \">333K (dry, heat)\",\n        \"pressure\": \"ambient\",\n        \"catalyst\": null,\n        \"aqueous\": false,\n        \"other\": \"pH 2\u20133.5 or dry heat\"\n      },\n      \"mechanism\": \"Intramolecular attack of the amino group on the \u03b3-carboxyl yields a five-membered lactam (pyroglutamic acid), releasing water.\",\n      \"reasoning\": \"Thermodynamically and kinetically supported by Wu et al. (2010), Weiss et al. (2018); this is a documented fate of prebiotic glutamate, especially under hydrothermal or evaporitic cycling. Mass-balanced.\"\n    },\n    {\n      \"id\": \"rxn_013\",\n      \"name\": \"Hydrolytic ring opening of pyroglutamic acid to glutamate\",\n      \"inputs\": [\"mol_012\", \"mol_014\"],\n      \"outputs\": [\"mol_006\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\"null\"],\n      \"conditions\": {\n        \"temperature\": \"353-373K; wet environment\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Acidic or neutral pH, extended heating, hydrolysis\"\n      },\n      \"mechanism\": \"Hydrolytic/lactam ring opening with water to reform glutamic acid.\",\n      \"reasoning\": \"Acid or water hydrolysis of pyroglutamate (as in meteorite extracts/evaporates); kinetics slow but mass-balanced with explicit water input. See Pizzarello & Cooper (2001).\"\n    },\n    {\n      \"id\": \"rxn_014\",\n      \"name\": \"Direct one-step hydrothermal synthesis of glutamate from CO2, NH3, and H2\",\n      \"inputs\": [\"mol_007\", \"mol_003\", \"mol_014\", \"mol_014\", \"mol_014\", \"mol_014\", \"mol_014\"],\n      \"outputs\": [\"mol_006\", \"mol_014\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"null\"],\n      \"conditions\": {\n        \"temperature\": \"373-473K\",\n        \"pressure\": \"high\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Reducing, hydrothermal mix zone\"\n      },\n      \"mechanism\": \"Net thermodynamic reduction and carboxylation/polymerization of CO2, NH3, and H2 to glutamate, releasing water.\",\n      \"reasoning\": \"Amend & Shock (1998) computed exergonicity at hydrothermal conditions, but full kinetic/mechanistic plausibility is debated (Bada & Miller, 1995). Reaction included to represent the thermodynamic possibility; mass and charge strictly tracked. Explicitly noted as mechanistically speculative.\"\n    },\n    {\n      \"id\": \"rxn_015\",\n      \"name\": \"Formation of ammonium carbamate from NH3 and CO2\",\n      \"inputs\": [\"mol_003\", \"mol_007\"],\n      \"outputs\": [\"mol_015\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"null\"],\n      \"conditions\": {\n        \"temperature\": \"variable\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Evaporitic pools\"\n      },\n      \"mechanism\": \"Direct combination of ammonia and CO2 to ammonium carbamate; serves as an ammonia reservoir in surface or evaporative conditions.\",\n      \"reasoning\": \"Common prebiotic ammonium species, included for network hub completeness and ammonia buffering dynamics. Supported by standard prebiotic ammonia chemistry.\"\n    },\n    {\n      \"id\": \"rxn_016\",\n      \"name\": \"Ammonolysis of succinic semialdehyde to \u03b1-ketoglutarate\",\n      \"inputs\": [\"mol_017\", \"mol_003\"],\n      \"outputs\": [\"mol_010\", \"mol_014\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"null\"],\n      \"conditions\": {\n        \"temperature\": \"298-310K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"neutral pH\"\n      },\n      \"mechanism\": \"Nucleophilic attack of ammonia on succinic semialdehyde followed by oxidation and hydration yields \u03b1-ketoglutarate and water.\",\n      \"reasoning\": \"Chemically well-established, experimental prebiotic context less explored; included for network completeness with correct atom balance.\"\n    }\n  ],\n  \"pathways\": [\n    {\n      \"pathway_id\": \"P1\",\n      \"name\": \"Strecker-acrolein pathway to glutamate\",\n      \"description\": \"Acrolein is converted to 3-cyanopropanal via HCN addition, followed by classic Strecker amination and hydrolysis steps to glutamic acid.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_002\", \"rxn_003\"],\n      \"key_intermediates\": [\"mol_004\", \"mol_005\"]\n    },\n    {\n      \"pathway_id\": \"P2\",\n      \"name\": \"Cyanosulfidic photochemical supply route\",\n      \"description\": \"HCN is photoreduced in the presence of H2S and copper under UV, yielding 3-cyanopropanal as the C4 precursor for Strecker chemistry and hydrolysis.\",\n      \"reaction_sequence\": [\"rxn_004\", \"rxn_002\", \"rxn_003\"],\n      \"key_intermediates\": [\"mol_004\", \"mol_005\"]\n    },\n    {\n      \"pathway_id\": \"P3\",\n      \"name\": \"HCN oligomer degradation route\",\n      \"description\": \"Concentrated HCN solution self-condenses to form aminonitrile polymer intermediates, which upon hydrolysis release the \u03b1-aminonitrile, then hydrolyze to glutamate.\",\n      \"reaction_sequence\": [\"rxn_005\", \"rxn_006\", \"rxn_003\"],\n      \"key_intermediates\": [\"mol_013\", \"mol_005\"]\n    },\n    {\n      \"pathway_id\": \"P4\",\n      \"name\": \"Aldol (proto-Krebs) route to \u03b1-ketoglutarate then glutamate\",\n      \"description\": \"Glyoxylate and pyruvate undergo aldol condensation and stepwise redox conversion to \u03b1-ketoglutarate, which is then reductively aminated to glutamate.\",\n      \"reaction_sequence\": [\"rxn_007\", \"rxn_008\"],\n      \"key_intermediates\": [\"mol_010\"]\n    },\n    {\n      \"pathway_id\": \"P5\",\n      \"name\": \"Bucherer\u2013Bergs sequence with hydantoin intermediate\",\n      \"description\": \"\u03b1-ketoglutarate reacts with cyanide and ammonia to make glutamate hydantoin; its hydrolysis yields glutamate.\",\n      \"reaction_sequence\": [\"rxn_007\", \"rxn_009\", \"rxn_010\"],\n      \"key_intermediates\": [\"mol_016\"]\n    },\n    {\n      \"pathway_id\": \"P6\",\n      \"name\": \"Transamination pathway (\u03b1-KG and glycine)\",\n      \"description\": \"\u03b1-ketoglutarate receives an amino group from glycine (non-enzymatic or via PLP analogue), liberating glutamate and glyoxylate.\",\n      \"reaction_sequence\": [\"rxn_007\", \"rxn_011\"],\n      \"key_intermediates\": [\"mol_010\", \"mol_011\"]\n    },\n    {\n      \"pathway_id\": \"P7\",\n      \"name\": \"Pyroglutamate reservoir cycle\",\n      \"description\": \"Glutamate cyclizes irreversibly/depositionally to pyroglutamic acid; hydrolysis under wet, acidic, or heated conditions regenerates glutamic acid.\",\n      \"reaction_sequence\": [\"rxn_012\", \"rxn_013\"],\n      \"key_intermediates\": [\"mol_012\"]\n    },\n    {\n      \"pathway_id\": \"P8\",\n      \"name\": \"Hydrothermal one-step reduction/carboxylation\",\n      \"description\": \"Direct formation of glutamate from CO2, NH3, and H2 under hydrothermal, reducing conditions\u2014thermodynamically favored but mechanistically limited.\",\n      \"reaction_sequence\": [\"rxn_014\"],\n      \"key_intermediates\": []\n    },\n    {\n      \"pathway_id\": \"P9\",\n      \"name\": \"Succinic semialdehyde ammonolysis to \u03b1-KG route\",\n      \"description\": \"Succ