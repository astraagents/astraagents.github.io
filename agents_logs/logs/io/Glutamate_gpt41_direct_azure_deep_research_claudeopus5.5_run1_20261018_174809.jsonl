gents\": [\"Ni/SiO2\u2013Al2O3\"],\n      \"conditions\": {\n        \"temperature\": \"295\u2013295K\",\n        \"pressure\": \"5 bar\",\n        \"catalyst\": \"Ni/SiO2\u2013Al2O3\",\n        \"aqueous\": true,\n        \"other\": \"pH 8, 72 h, 22\u00b0C\"\n      },\n      \"mechanism\": \"Nickel-catalyzed hydrogenation of \u03b1-ketoglutarate with ammonium ion producing glutamate and water.\",\n      \"reasoning\": \"Recent advances (Kaur et al., 2024) show Ni catalyzes efficient conversion at near-ambient temperatures and moderate pressures.\"\n    },\n    {\n      \"id\": \"rxn_009\",\n      \"name\": \"Bucherer-Bergs hydantoin formation from \u03b1-ketoglutarate\",\n      \"inputs\": [\"mol_010\", \"mol_001\", \"mol_003\"],\n      \"outputs\": [\"mol_014\", \"mol_016\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"293\u2013310K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Requires DAP or equivalent, mildly acidic to neutral\"\n      },\n      \"mechanism\": \"Addition of ammonia and cyanide to \u03b1-ketoglutarate forms hydantoin intermediate, with water released.\",\n      \"reasoning\": \"Route demonstrated by Pulletikurti et al. (2022, Nature Chem.); this step is fully mass balanced.\"\n    },\n    {\n      \"id\": \"rxn_010\",\n      \"name\": \"Hydrolysis of hydantoin-glutamate to glutamate\",\n      \"inputs\": [\"mol_014\", \"mol_016\", \"mol_016\"],\n      \"outputs\": [\"mol_006\", \"mol_003\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"340\u2013350K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Moderately high temp, acid-catalyzed\"\n      },\n      \"mechanism\": \"Ring opening of hydantoin with two equivalents water yields glutamate and ammonia.\",\n      \"reasoning\": \"This hydantoin hydrolysis is well balanced and experimentally supported. (Pulletikurti et al., 2022)\"\n    },\n    {\n      \"id\": \"rxn_011\",\n      \"name\": \"Nonenzymatic transamination of \u03b1-ketoglutarate with glycine\",\n      \"inputs\": [\"mol_010\", \"mol_011\"],\n      \"outputs\": [\"mol_006\", \"mol_009\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\"Al(III)\"],\n      \"conditions\": {\n        \"temperature\": \"320\u2013343K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"Al(III)\",\n        \"aqueous\": true,\n        \"other\": \"Neutral to alkaline pH\"\n      },\n      \"mechanism\": \"Imine exchange between glycine and \u03b1-ketoglutarate transfers amino group to form glutamate and pyruvate.\",\n      \"reasoning\": \"Nonenzymatic transamination has been experimentally reported (Stubbs et al., 2020; Kaur et al., 2024), and Al(III) enhances rate. Mass is conserved.\"\n    },\n    {\n      \"id\": \"rxn_012\",\n      \"name\": \"Cyclization of glutamate to pyroglutamate\",\n      \"inputs\": [\"mol_006\"],\n      \"outputs\": [\"mol_015\", \"mol_016\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"340\u2013420K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": false,\n        \"other\": \"Evaporation/drying or >60\u00b0C heating\"\n      },\n      \"mechanism\": \"Intramolecular condensation forms 5-membered lactam ring, releasing water.\",\n      \"reasoning\": \"Cyclization is a characteristic fate of prebiotic glutamate (Seifert et al., 2009; Wu et al., 2010). Path represents a limiting sink or reservoir.\"\n    },\n    {\n      \"id\": \"rxn_013\",\n      \"name\": \"Hydrolysis of pyroglutamate to glutamate\",\n      \"inputs\": [\"mol_015\", \"mol_016\"],\n      \"outputs\": [\"mol_006\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [null],\n      \"conditions\": {\n