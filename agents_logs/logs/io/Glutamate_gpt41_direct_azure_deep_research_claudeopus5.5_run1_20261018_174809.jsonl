eous\": true,\n        \"other\": \"Neutral to slightly alkaline pH, UV exposure optional\"\n      },\n      \"mechanism\": \"Nucleophilic addition of HCN to the \u03b2 position of acrolein yielding 3-cyanopropanal.\",\n      \"reasoning\": \"Van Trump & Miller (1972) proposed acrolein as the C4 precursor for glutamate formation via Strecker. This addition is well grounded in carbonyl/nitrile organic chemistry.\"\n    },\n    {\n      \"id\": \"rxn_002\",\n      \"name\": \"Strecker synthesis on 3-cyanopropanal\",\n      \"inputs\": [\"mol_004\", \"mol_001\", \"mol_003\"],\n      \"outputs\": [\"mol_005\", \"mol_016\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300\u2013330K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Mildly alkaline pH\"\n      },\n      \"mechanism\": \"Classic Strecker reaction: addition of HCN and ammonia to 3-cyanopropanal yields the \u03b1-aminonitrile with H2O as a byproduct.\",\n      \"reasoning\": \"This is a central step in prebiotic chemistry for \u03b1-amino acid backbone assembly. (Miller, 1957; Johnson et al., 2008)\"\n    },\n    {\n      \"id\": \"rxn_003\",\n      \"name\": \"Hydrolysis of glutamate aminonitrile to glutamate\",\n      \"inputs\": [\"mol_005\", \"mol_016\", \"mol_016\"],\n      \"outputs\": [\"mol_006\", \"mol_003\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"310\u2013350K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Mildly acidic to neutral pH\"\n      },\n      \"mechanism\": \"Hydrolysis of the nitrile function with water yields the amino acid, releasing ammonia.\",\n      \"reasoning\": \"This step is fundamental to all Strecker amino acid syntheses. Balancing ensures two water equivalents are needed for complete hydrolysis. Supported by prebiotic experiments (Johnson et al., 2008; Miller, 1957).\"\n    },\n    {\n      \"id\": \"rxn_004\",\n      \"name\": \"Photoreduction of cyanoacetylene via cyanosulfidic chemistry\",\n      \"inputs\": [\"mol_001\", \"mol_001\", \"mol_016\", \"mol_016\"],\n      \"outputs\": [\"mol_004\", \"mol_019\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Cu(I)/Cu(II)\", \"UV\", \"H2S\"],\n      \"conditions\": {\n        \"temperature\": \"295\u2013315K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"Cu(I)/Cu(II)\",\n        \"aqueous\": true,\n        \"other\": \"UV exposure at 254 nm, presence of H2S as photoreductant\"\n      },\n      \"mechanism\": \"Successive reduction and hydration of cyanoacetylene via H2S/Cu-mediated UV photocatalysis yields 3-cyanopropanal (mol_004) and minor C2 amidine byproducts.\",\n      \"reasoning\": \"Patel et al. (2015, Nature Chem.) presented this explicit route from simple feedstocks to C4 nitriles; this step is balanced with water and HCN input.\"\n    },\n    {\n      \"id\": \"rxn_005\",\n      \"name\": \"HCN oligomerization and hydrolysis to glutamate\",\n      \"inputs\": [\"mol_001\", \"mol_001\", \"mol_001\", \"mol_001\", \"mol_016\", \"mol_016\", \"mol_003\"],\n      \"outputs\": [\"mol_006\", \"mol_016\", \"mol_003\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"340\u2013360K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Wet-dry cycles, alkaline conditions\"\n      },\n      \"mechanism\": \"Tetramerization of HCN (with subsequent hydrolysis in presence of ammonia/water) releases glutamate, ammonia, and water.\",\n      \"reasoning\": \"Multiple studies (Ruiz-Bermejo et al., 2013) confirm Glu is a minor product after HCN oligomer acid hydrolysis. Here, explicit hydrolysis steps yield mass balance.\"\n    },\n    {\n      \"id\": \"rxn_006\