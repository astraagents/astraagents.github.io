=1S/S\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    }\n  ],\n  \"reactions\": [\n    {\n      \"id\": \"rxn_001\",\n      \"name\": \"Acrolein ammoniation to 3-aminopropanal\",\n      \"inputs\": [\"mol_011\", \"mol_004\"],\n      \"outputs\": [\"mol_005\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-330K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Anoxic ammoniacal pool or shoreline film; rapid trapping is needed because beta-amino aldehydes are reactive.\"\n      },\n      \"mechanism\": \"Ammonia performs aza-Michael addition to acrolein, followed by proton transfer and tautomerization to the beta-amino aldehyde 3-aminopropanal.\",\n      \"reasoning\": \"The review identifies 3-aminopropanal as a plausible prebiotic product of acrolein plus NH3 and explicitly mentions Michael-type ammoniation as an entry into the proline network. This feeder is chemically reasonable in surface pools, but the low steady-state stability of 3-aminopropanal remains a significant limitation (Patel et al., 2015).\"\n    },\n    {\n      \"id\": \"rxn_002\",\n      \"name\": \"Glycerol dehydration to acrolein\",\n      \"inputs\": [\"mol_012\"],\n      \"outputs\": [\"mol_011\", \"mol_003\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"340-370K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": false,\n        \"other\": \"Hot acidic dry-down on a geothermal apron or evaporitic shoreline; two water equivalents are inferred.\"\n      },\n      \"mechanism\": \"Heating drives sequential dehydration of glycerol to the conjugated aldehyde acrolein under low-water-activity conditions.\",\n      \"reasoning\": \"The literature review notes thermal decomposition/dehydration of glycerol as a plausible prebiotic source of acrolein. This branch is therefore chemically plausible but not part of the experimentally demonstrated proline sequence itself; it requires hotter, drier, and likely more acidic surface microenvironments than the Patel core, and side reactions such as charring or polymerization are expected (Patel et al., 2015; speculative feeder).\"\n    },\n    {\n      \"id\": \"rxn_003\",\n      \"name\": \"3-Hydroxypropanal dehydration to acrolein\",\n      \"inputs\": [\"mol_013\"],\n      \"outputs\": [\"mol_011\", \"mol_003\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"330-360K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": false,\n        \"other\": \"Acidic hot-spring or evaporative dry-down setting with low water activity.\"\n      },\n      \"mechanism\": \"Thermal elimination of water from 3-hydroxypropanal furnishes the alpha,beta-unsaturated aldehyde acrolein.\",\n      \"reasoning\": \"This feeder is speculative because no direct support for it appears in the provided report. It is included on chemical merit: dehydration of a hydroxy aldehyde to acrolein is a conservative C3 entry into the same aminoaldehyde/cyanosulfidic core used downstream. The uncertainty lies in the availability of 3-hydroxypropanal and competition from hydration, oligomerization, and rearrangement (speculative; no direct experimental support in the provided review).\"\n    },\n    {\n      \"id\": \"rxn_004\",\n      \"name\": \"Sulfidic reductive amination of malondialdehyde to 3-aminopropanal\",\n      \"inputs\": [\"mol_014\", \"mol_004\", \"mol_002\"],\n      \"outputs\": [\"mol_005\", \"mol_003\", \"mol_015\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-330K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Anoxic sulf