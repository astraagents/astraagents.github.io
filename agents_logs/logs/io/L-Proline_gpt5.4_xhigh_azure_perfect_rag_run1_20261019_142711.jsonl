s\": [\"mol_006\"],\n      \"outputs\": [\"mol_005\", \"mol_003\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"acidic silica or aluminosilicate surfaces\"],\n      \"conditions\": {\n        \"temperature\": \"340-370K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"acidic silica or aluminosilicate surfaces\",\n        \"aqueous\": \"false\",\n        \"other\": \"drying films at volcanic hot spring or subaerial geothermal margins\"\n      },\n      \"mechanism\": \"Acid-catalyzed dehydration of glycerol removes water and generates the alpha,beta-unsaturated aldehyde acrolein.\",\n      \"reasoning\": \"Speculative upstream feeder. The curated review notes, in the context of the Patel et al. (2015) cyanosulfidic framework, that acrolein can arise from thermal decomposition of glycerol and then feed 3-aminopropanal formation. Acidic mineral surfaces and low-water-activity drying phases make the dehydration chemically plausible, but this step was not experimentally established as part of the Patel et al. (2015) proline sequence.\"\n    },\n    {\n      \"id\": \"rxn_002\",\n      \"name\": \"Ammonia addition to acrolein\",\n      \"inputs\": [\"mol_005\", \"mol_004\"],\n      \"outputs\": [\"mol_008\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-330K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": \"true\",\n        \"other\": \"ammonia-rich evaporitic pool or shoreline film\"\n      },\n      \"mechanism\": \"Ammonia performs conjugate addition to acrolein, followed by proton transfer and tautomerization to furnish 3-aminopropanal.\",\n      \"reasoning\": \"Speculative upstream feeder. The curated review explicitly identifies acrolein plus NH3, via Michael-type addition, as a plausible source of 3-aminopropanal for the proline network. It is included because it gives the exact C3 amino aldehyde required by Patel et al. (2015), but the review also highlights the uncertain availability and stability of 3-aminopropanal in prebiotic pools.\"\n    },\n    {\n      \"id\": \"rxn_003\",\n      \"name\": \"Net reductive amination of malondialdehyde\",\n      \"inputs\": [\"mol_007\", \"mol_004\"],\n      \"outputs\": [\"mol_008\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"FeS/NiS mineral surfaces\"],\n      \"conditions\": {\n        \"temperature\": \"300-350K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"FeS/NiS redox-active surfaces\",\n        \"aqueous\": \"true\",\n        \"other\": \"warm sulfidic pool; overall net transformation with reduction supplied by the local geochemical redox environment\"\n      },\n      \"mechanism\": \"One aldehyde of malondialdehyde forms an imine with ammonia, then surface-mediated reduction and proton transfer collapse the dialdehyde to the beta-amino aldehyde 3-aminopropanal.\",\n      \"reasoning\": \"Speculative upstream feeder. The curated review also identifies reductive amination of malondialdehyde as a plausible source of 3-aminopropanal. FeS/NiS-type reducing surfaces make the net transformation chemically credible, but no direct experimental demonstration was provided in the curated report, and the same 3-aminopropanal stability problem remains (Patel et al., 2015).\"\n    },\n    {\n      \"id\": \"rxn_004\",\n      \"name\": \"Cyanohydrin formation from 3-aminopropanal\",\n      \"inputs\": [\"mol_008\", \"mol_001\"],\n      \"outputs\": [\"mol_009\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"295-310K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": \"true\",\n        \"other\": \"cyanosulfidic aqueous pool\"\n      },\n      \"mechanism\": \"Cyanide adds to the aldehyde carbonyl of 3-aminopropanal, generating the alpha-hydroxynitrile 4-amino-2-hydroxybutanenitrile.\",\n      \"reasoning\": \"Directly supported by the cyanosulfidic proline sequence of Patel et al. (2015). Cyanohydrin formation is the key C-C bond-forming step that converts the C3 amino aldehyde into the C4 aminonitrile needed for subsequent ring closure.\"\n    },\n    {\n      \"id\": \"rxn_005\",\n      \"name\": \"H2S-mediated thiolation-cyclization\",\n      \"inputs\": [\"mol_009\", \"mol_002\"],\n      \"outputs\": [\"mol_010\", \"mol_004\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"295-310K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": \"true\",\n        \"other\": \"sulfidic atmosphere or dissolved HS- in a cyanosulfidic pool\"\n      },\n      \"mechanism\": \"HS- adds to the nitrile carbon to form a thioamide, then the terminal amine attacks intramolecularly to close a five-membered ring and release ammonia.\",\n      \"reasoning\": \"Directly supported by Patel et al. (2015). This H2S-mediated thiolation-cyclization is the proline-specific ring-forming step; the three-carbon tether in 3-aminopropanal gives the correct geometry for five-membered-ring closure. The review notes that real-world H2S recycling efficiency could limit turnover.\"\n    },\n    {\n      \"id\": \"rxn_006\",\n      \"name\": \"Cu/H2S reductive deoxygenation\",\n      \"inputs\": [\"mol_010\"],\n      \"outputs\": [\"mol_011\", \"mol_003\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"native copper (Cu0)\", \"sulfidic acid (H2S)\"],\n      \"conditions\": {\n        \"temperature\": \"295-310K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"Cu0/H2S reducing system\",\n        \"aqueous\": \"true\",\n        \"other\": \"cyanosulfidic pool with native copper precipitates\"\n      },\n      \"mechanism\": \"Reductive deoxygenation removes the C3 hydroxyl group from the thione-bearing ring, producing pyrrolidine-2-thione and water.\",\n      \"reasoning\": \"Directly supported by Patel et al. (2015), which used a Cu0/H2S reducing system to remove the C3 hydroxyl group. Native copper is geochemically plausible in sulfidic surface settings, but the review explicitly identifies sustained Cu0 availability on early Earth as an uncertainty.\"\n    },\n    {\n      \"id\": \"rxn_007\",\n      \"name\": \"Thione-to-nitrile exchange\",\n      \"inputs\": [\"mol_011\", \"mol_001\"],\n      \"outputs\": [\"mol_012\", \"mol_002\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"295-310K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": \"true\",\n        \"other\": \"HCN-rich cyanosulfidic pool\"\n      },\n      \"mechanism\": \"HCN attacks the thioamide carbon of pyrrolidine-2-thione; sulfur is displaced and a nitrile is installed at C2, regenerating H2S.\",\n      \"reasoning\": \"Directly supported by Patel et al. (2015). Thione-to-nitrile exchange converts the sulfur heterocycle into the immediate nitrile precursor of proline and regenerates H2S, embedding the route in a sulfur-recycling loop.\"\n    },\n    {\n      \"id\": \"rxn_008\",\n      \"name\": \"Nitrile hydration to prolinamide\",\n      \"inputs\": [\"mol_012\", \"mol_003\"],\n      \"outputs\": [\"mol_013\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-340K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": \"true\",\n        \"other\": \"warm aqueous pool with prolonged residence time\"\n      },\n      \"mechanism\": \"Water adds to the nitrile carbon to give an imidate or amide sequence, yielding pyrrolidine-2-carboxamide.\",\n      \"reasoning\": \"Mechanistically justified subdivision of Patel et al. (2015) step 5. The curated review describes nitrile hydrolysis as proceeding through a carboxamide intermediate, so this node makes the first hydration event explicit. It is a mechanistic expansion rather than a separately validated standalone prebiotic route.\"\n    },\n    {\n      \"id\": \"rxn_009\",\n      \"name\": \"Amide hydrolysis to rac-proline\",\n      \"inputs\": [\"mol_013\", \"mol_003\"],\n      \"outputs\": [\"mol_014\", \"mol_004\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"320-350K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": \"true\",\n        \"other\": \"geothermal cycling or mild heating in surface pools\"\n      },\n      \"mechanism\": \"Hydrolysis of the carboxamide releases ammonia and furnishes pyrrolidine-2-carboxylic acid as a racemate.\",\n      \"reasoning\": \"Mechanistically justified completion of Patel et al. (2015) step 5. Hydrolysis of the amide yields rac-proline, but the review flags nitrile-derived hydrolysis chemistry as potentially slow under ambient conditions, making this a plausible bottleneck.\"\n    },\n    {\n      \"id\": \"rxn_010\",\n      \"name\": \"Net nitrile hydrolysis to rac-proline\",\n      \"inputs\": [\"mol_012\", \"mol_003\"],\n      \"outputs\": [\"mol_014\", \"mol_004\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Fe2+-bearing clay surfaces\"],\n      \"conditions\": {\n        \"temperature\": \"330-360K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"Fe2+-bearing clay surfaces\",\n        \"aqueous\": \"true\",\n        \"other\": \"one-pot hydrolysis in warm mineral-rich pools; amide does not accumulate detectably\"\n      },\n      \"mechanism\": \"Overall nitrile hydrolysis proceeds through transient amide formation and collapse to rac-proline without isolable buildup of the amide node.\",\n      \"reasoning\": \"Alternative net representation of Patel et al. (2015) step 5. The chemistry still proceeds through transient amide formation, but in warmer mineral-rich pools the amide need not accumulate to detectable levels. Because the review identifies hydrolysis kinetics and metal-ion catalysis as open questions, this branch is plausible but less resolved than the core cyanosulfidic steps.\"\n    },\n    {\n      \"id\": \"rxn_011\",\n      \"name\": \"Chiral mineral surface L-enrichment of proline\",\n      \"inputs\": [\"mol_014\"],\n      \"outputs\": [\"mol_015\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\"chiral mineral surfaces\"],\n      \"conditions\": {\n        \"temperature\": \"300-330K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"chiral mineral surfaces\",\n        \"aqueous\": \"true\",\n        \"other\": \"adsorption and desorption cycles at mineral interfaces in concentrated prebiotic pools\"\n      },\n      \"mechanism\": \"Differential adsorption or desorption of enantiomers on chiral surface sites leaves an L-enriched dissolved proline pool.\",\n      \"reasoning\": \"Explicitly speculative. The curated review states that Patel et al. (2015) chemistry gives racemic proline and mentions chiral mineral surfaces as one possible route to homochirality. This node therefore represents post-synthetic L-enrichment at mineral interfaces rather than a demonstrated asymmetric synthesis.\"\n    },\n    {\n      \"id\": \"rxn_012\",\n      \"name\": \"Asymmetric crystallization L-enrichment of proline\",\n      \"inputs\": [\"mol_014\"],\n      \"outputs\": [\"mol_015\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"273-310K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": \"true\",\n        \"other\": \"evaporation, freeze-thaw, or dissolution-recrystallization cycles in concentrated prebiotic pools\"\n      },\n      \"mechanism\": \"A slight stochastic enantiomeric excess is amplified by preferential crystallization or eutectic partitioning, enriching L-proline relative to D-proline.\",\n      \"reasoning\": \"Explicitly speculative. The review also mentions asymmetric crystallization as a possible origin of amino-acid enantioenrichment. This node models evaporation or freeze-thaw driven preferential crystallization leading to an L-enriched pool, but no proline-specific experimental support was provided in the curated report (Patel et al., 2015).\"\n    }\n  ],\n  \"pathways\": [\n    {\n      \"pathway_id\": \"P1\",\n      \"name\": \"Direct acrolein feeder with stepwise hydrolysis and mineral L-enrichment\",\n      \"description\": \"Acrolein is aminated to 3-aminopropanal, then follows the Patel cyanosulfidic ring-building sequence, stepwise nitrile hydrolysis through prolinamide, and post-synthetic L-enrichment at a biochemical mineral interface.\",\n      \"reaction_sequence\": [\"rxn_002\", \"rxn_004\", \"rxn_005\", \"rxn_006\", \"rxn_007\", \"rxn_008\", \"rxn_009\", \"rxn_011\"],\n      \"key_intermediates\": [\"mol_008\", \"mol_009\", \"mol_010\", \"mol_011\", \"mol_013\", \"mol_014\"]\n    },\n    {\n      \"pathway_id\": \"P2\",\n      \"name\": \"Direct acrolein feeder with stepwise hydrolysis and crystallization L-enrichment\",\n      \"description\": \"The same acrolein-fed cyanosulfidic core is followed by explicit amide formation and hydrolysis, then by asymmetric crystallization to an L-enriched proline pool.\",\n      \"reaction_sequence\": [\"rxn_002\", \"rxn_004\", \"rxn_005\", \"rxn_006\", \"rxn_007\", \"rxn_008\", \"rxn_009\", \"rxn_012\"],\n      \"key_intermediates\": [\"mol_008\", \"mol_009\", \"mol_010\", \"mol_011\", \"mol_013\", \"mol_014\"]\n    },\n    {\n      \"pathway_id\": \"P3\",\n      \"name\": \"Direct acrolein feeder with net hydrolysis and mineral L-enrichment\",\n      \"description\": \"Acrolein enters the core cyanosulfidic sequence, and the proline nitrile is hydrolyzed in one pot before chiral mineral-interface enrichment.\",\n      \"reaction_sequence\": [\"rxn_002\", \"rxn_004\", \"rxn_005\", \"rxn_006\", \"rxn_007\", \"rxn_010\", \"rxn_011\"],\n      \"key_intermediates\": [\"mol_008\", \"mol_009\", \"mol_010\", \"mol_011\", \"mol_012\", \"mol_014\"]\n    },\n    {\n      \"pathway_id\": \"P4\",\n      \"name\": \"Direct acrolein feeder with net hydrolysis and crystallization L-enrichment\",\n      \"description\": \"Acrolein feeds the same ring-forming core, but the nitrile hydrolysis is treated as a one-pot conversion before crystallization-driven L-enrichment.\",\n      \"reaction_sequence\": [\"rxn_002\", \"rxn_004\", \"rxn_005\", \"rxn_006\", \"rxn_007\", \"rxn_010\", \"rxn_012\"],\n      \"key_intermediates\": [\"mol_008\", \"mol_009\", \"mol_010\", \"mol_011\", \"mol_012\", \"mol_014\"]\n    },\n    {\n      \"pathway_id\": \"P5\",\n      \"name\": \"Glycerol dehydration feeder with stepwise hydrolysis and mineral L-enrichment\",\n      \"description\": \"A speculative glycerol-to-acrolein feeder supplies the core Patel sequence; proline nitrile is hydrolyzed through prolinamide, then L-enriched on chiral mineral interfaces.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_002\", \"rxn_004\", \"rxn_005\", \"rxn_006\", \"rxn_007\", \"rxn_008\", \"rxn_009\", \"rxn_011\"],\n      \"key_intermediates\": [\"mol_005\", \"mol_008\", \"mol_010\", \"mol_011\", \"mol_013\", \"mol_014\"]\n    },\n    {\n      \"pathway_id\": \"P6\",\n      \"name\": \"Glycerol dehydration feeder with stepwise hydrolysis and crystallization L-enrichment\",\n      \"description\": \"Glycerol first dehydrates to acrolein, then enters the cyanosulfidic ring-building route and explicit amide hydrolysis branch before asymmetric crystallization.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_002\", \"rxn_004\", \"rxn_005\", \"rxn_006\", \"rxn_007\", \"rxn_008\", \"rxn_009\", \"rxn_012\"],\n      \"key_intermediates\": [\"mol_005\", \"mol_008\", \"mol_010\", \"mol_011\", \"mol_013\", \"mol_014\"]\n    },\n    {\n      \"pathway_id\": \"P7\",\n      \"name\": \"Glycerol dehydration feeder with net hydrolysis and mineral L-enrichment\",\n      \"description\": \"Glycerol is dehydrated to acrolein, the core surface cyanosulfidic sequence builds the pyrrolidine framework, and one-pot nitrile hydrolysis is followed by mineral-interface L-enrichment.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_002\", \"rxn_004\", \"rxn_005\", \"rxn_006\", \"rxn_007\", \"rxn_010\", \"rxn_011\"],\n      \"key_intermediates\": [\"mol_005\", \"mol_008\", \"mol_010\", \"mol_011\", \"mol_012\", \"mol_014\"]\n    },\n    {\n      \"pathway_id\": \"P8\",\n      \"name\": \"Malondialdehyde feeder with stepwise hydrolysis and mineral L-enrichment\",\n      \"description\": \"A speculative malondialdehyde-to-3-aminopropanal feeder enters the experimentally anchored cyanosulfidic core, then proceeds through prolinamide and mineral-interface L-enrichment.\",\n      \"reaction_sequence\": [\"rxn_003\", \"rxn_004\", \"rxn_005\", \"rxn_006\", \"rxn_007\", \"rxn_008\", \"rxn_009\", \"rxn_011\"],\n      \"key_intermediates\": [\"mol_008\", \"mol_010\", \"mol_011\", \"mol_013\", \"mol_014\"]\n    },\n    {\n      \"pathway_id\": \"P9\",\n      \"name\": \"Malondialdehyde feeder with stepwise hydrolysis and crystallization L-enrichment\",\n      \"description\": \"Malondialdehyde feeds 3-aminopropanal by net reductive amination, after which the surface cyanosulfidic core and explicit amide hydrolysis branch deliver rac-proline for crystallization-based L-enrichment.\",\n      \"reaction_sequence\": [\"rxn_003\", \"rxn_004\", \"rxn_005\", \"rxn_006\", \"rxn_007\", \"rxn_008\", \"rxn_009\", \"rxn_012\"],\n      \"key_intermediates\": [\"mol_008\", \"mol_010\", \"mol_011\", \"mol_013\", \"mol_014\"]\n    },\n    {\n      \"pathway_id\": \"P10\",\n      \"name\": \"Malondialdehyde feeder with net hydrolysis and mineral L-enrichment\",\n      \"description\": \"Malondialdehyde enters through net reductive amination to 3-aminopropanal; the cyanosulfidic core constructs the pyrrolidine framework, then one-pot nitrile hydrolysis and mineral-interface partitioning furnish an L-enriched product pool.\",\n      \"reaction_sequence\": [\"rxn_003\", \"rxn_004\", \"rxn_005\", \"rxn_006\", \"rxn_007\", \"rxn_010\", \"rxn_011\"],\n      \"key_intermediates\": [\"mol_008\", \"mol_010\", \"mol_011\", \"mol_012\", \"mol_014\"]\n    }\n  ],\n  \"hub_molecules\": [\"mol_001\", \"mol_002\", \"mol_003\", \"mol_004\", \"mol_005\", \"mol_008\", \"mol_012\", \"mol_014\"],\n  \"convergence_points\": [\n    {\n      \"molecule_id\": \"mol_008\",\n      \"incoming_reactions\": [\"rxn_002\", \"rxn_003\"],\n      \"outgoing_reactions\": [\"rxn_004\"]\n    },\n    {\n      \"molecule_id\": \"mol_012\",\n      \"incoming_reactions\": [\"rxn_007\"],\n      \"outgoing_reactions\": [\"rxn_008\", \"rxn_010\"]\n    },\n    {\n      \"molecule_id\": \"mol_014\",\n      \"incoming_reactions\": [\"rxn_009\", \"rxn_010\"],\n      \"outgoing_reactions\": [\"rxn_011\", \"rxn_012\"]\n    },\n    {\n      \"molecule_id\": \"mol_004\",\n      \"incoming_reactions\": [\"rxn_005\", \"rxn_009\", \"rxn_010\"],\n      \"outgoing_reactions\": [\"rxn_002\", \"rxn_003\"]\n    }\n  ]\n}", "parsed_response": {"target_molecule": "L-Proline", "overall_strategy": "Experimentally grounded synthesis is anchored on the surface cyanosulfidic sequence of Patel et al. (2015), in which 3-aminopropanal is converted to rac-proline by cyanohydrin formation, H2S-driven thiolation-cyclization, Cu0/H2S reductive deoxygenation, thione-to-nitrile exchange, and nitrile hydrolysis. The network therefore focuses on surface chemistry and supplies 3-aminopropanal through three chemically plausible feeder channels: direct acrolein amination, glycerol dehydration followed by amination, or net reductive amination of malondialdehyde. Because the validated chemistry is racemic rather than asymmetric, the requested L-proline target is interpreted as an L-enriched pool reached by explicitly speculative post-synthetic enrichment at biochemical mineral interfaces or by asymmetric crystallization. High-temperature hydrothermal routes are not emphasized because the key amino aldehyde and aminonitrile intermediates are better supported and likely more persistent in milder surface pools. Ten representative pathways are enumerated from these branches.", "molecules": [{"id": "mol_001", "formula": "HCN", "iupac_name": "hydrogen cyanide", "common_name": "hydrogen cyanide", "inchi": "InChI=1S/CHN/c1-2/h1H", "role": "starting", "environment_formed": null}, {"id": "mol_002", "formula": "H2S", "iupac_name": "hydrogen sulfide", "common_name": "hydrogen sulfide", "inchi": "InChI=1S/H2S/h1H2", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_003", "formula": "H2O", "iupac_name": "water", "common_name": "water", "inchi": "InChI=1S/H2O/h1H2", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_004", "formula": "NH3", "iupac_name": "ammonia", "common_name": "ammonia", "inchi": "InChI=1S/H3N/h1H3", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_005", "formula": "C3H4O", "iupac_name": "prop-2-enal", "common_name": "acrolein", "inchi": "InChI=1S/C3H4O/c1-2-3-4/h2-3H,1H2", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_006", "formula": "C3H8O3", "iupac_name": "propane-1,2,3-triol", "common_name": "glycerol", "inchi": "InChI=1S/C3H8O3/c4-1-3(6)2-5/h3-6H,1-2H2", "role": "starting", "environment_formed": null}, {"id": "mol_007", "formula": "C3H4O2", "iupac_name": "propane-1,3-dial", "common_name": "malondialdehyde", "inchi": "InChI=1S/C3H4O2/c4-1-3-2-5/h1-2H,3H2", "role": "starting", "environment_formed": null}, {"id": "mol_008", "formula": "C3H7NO", "iupac_name": "3-aminopropanal", "common_name": "beta-aminopropionaldehyde", "inchi": "InChI=1S/C3H7NO/c4-2-1-3-5/h3H,1-2,4H2", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_009", "formula": "C4H8N2O", "iupac_name": "4-amino-2-hydroxybutanenitrile", "common_name": null, "inchi": "InChI=1S/C4H8N2O/c5-2-1-4(7)3-6/h4,7H,1-2,5H2", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_010", "formula": "C4H7NOS", "iupac_name": "3-hydroxypyrrolidine-2-thione", "common_name": null, "inchi": "InChI=1S/C4H7NOS/c6-3-1-2-5-4(3)7/h3,6H,1-2H2,(H,5,7)", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_011", "formula": "C4H7NS", "iupac_name": "pyrrolidine-2-thione", "common_name": "proline thione", "inchi": "InChI=1S/C4H7NS/c6-4-2-1-3-5-4/h1-3H2,(H,5,6)", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_012", "formula": "C5H8N2", "iupac_name": "pyrrolidine-2-carbonitrile", "common_name": "proline nitrile", "inchi": "InChI=1S/C5H8N2/c6-4-5-2-1-3-7-5/h5,7H,1-3H2", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_013", "formula": "C5H10N2O", "iupac_name": "pyrrolidine-2-carboxamide", "common_name": "prolinamide", "inchi": "InChI=1S/C5H10N2O/c6-5(8)4-2-1-3-7-4/h4,7H,1-3H2,(H2,6,8)", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_014", "formula": "C5H9NO2", "iupac_name": "pyrrolidine-2-carboxylic acid", "common_name": "DL-proline", "inchi": "InChI=1S/C5H9NO2/c7-5(8)4-2-1-3-6-4/h4,6H,1-3H2,(H,7,8)", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_015", "formula": "C5H9NO2", "iupac_name": "(2S)-pyrrolidine-2-carboxylic acid", "common_name": "L-proline", "inchi": "InChI=1S/C5H9NO2/c7-5(8)4-2-1-3-6-4/h4,6H,1-3H2,(H,7,8)/t4-/m0/s1", "role": "target", "environment_formed": "Biochemical"}], "reactions": [{"id": "rxn_001", "name": "Glycerol dehydration to acrolein", "inputs": ["mol_006"], "outputs": ["mol_005", "mol_003"], "environment": "Surface", "agents": ["acidic silica or aluminosilicate surfaces"], "conditions": {"temperature": "340-370K", "pressure": "1 atm", "catalyst": "acidic silica or aluminosilicate surfaces", "aqueous": "false", "other": "drying films at volcanic hot spring or subaerial geothermal margins"}, "mechanism": "Acid-catalyzed dehydration of glycerol removes water and generates the alpha,beta-unsaturated aldehyde acrolein.", "reasoning": "Speculative upstream feeder. The curated review notes, in the context of the Patel et al. (2015) cyanosulfidic framework, that acrolein can arise from thermal decomposition of glycerol and then feed 3-aminopropanal formation. Acidic mineral surfaces and low-water-activity drying phases make the dehydration chemically plausible, but this step was not experimentally established as part of the Patel et al. (2015) proline sequence."}, {"id": "rxn_002", "name": "Ammonia addition to acrolein", "inputs": ["mol_005", "mol_004"], "outputs": ["mol_008"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-330K", "pressure": "1 atm", "catalyst": null, "aqueous": "true", "other": "ammonia-rich evaporitic pool or shoreline film"}, "mechanism": "Ammonia performs conjugate addition to acrolein, followed by proton transfer and tautomerization to furnish 3-aminopropanal.", "reasoning": "Speculative upstream feeder. The curated review explicitly identifies acrolein plus NH3, via Michael-type addition, as a plausible source of 3-aminopropanal for the proline network. It is included because it gives the exact C3 amino aldehyde required by Patel et al. (2015), but the review also highlights the uncertain availability and stability of 3-aminopropanal in prebiotic pools."}, {"id": "rxn_003", "name": "Net reductive amination of malondialdehyde", "inputs": ["mol_007", "mol_004"], "outputs": ["mol_008"], "environment": "Surface", "agents": ["FeS/NiS mineral surfaces"], "conditions": {"temperature": "300-350K", "pressure": "1 atm", "catalyst": "FeS/NiS redox-active surfaces", "aqueous": "true", "other": "warm sulfidic pool; overall net transformation with reduction supplied by the local geochemical redox environment"}, "mechanism": "One aldehyde of malondialdehyde forms an imine with ammonia, then surface-mediated reduction and proton transfer collapse the dialdehyde to the beta-amino aldehyde 3-aminopropanal.", "reasoning": "Speculative upstream feeder. The curated review also identifies reductive amination of malondialdehyde as a plausible source of 3-aminopropanal. FeS/NiS-type reducing surfaces make the net transformation chemically credible, but no direct experimental demonstration was provided in the curated report, and the same 3-aminopropanal stability problem remains (Patel et al., 2015)."}, {"id": "rxn_004", "name": "Cyanohydrin formation from 3-aminopropanal", "inputs": ["mol_008", "mol_001"], "outputs": ["mol_009"], "environment": "Surface", "agents": null, "conditions": {"temperature": "295-310K", "pressure": "1 atm", "catalyst": null, "aqueous": "true", "other": "cyanosulfidic aqueous pool"}, "mechanism": "Cyanide adds to the aldehyde carbonyl of 3-aminopropanal, generating the alpha-hydroxynitrile 4-amino-2-hydroxybutanenitrile.", "reasoning": "Directly supported by the cyanosulfidic proline sequence of Patel et al. (2015). Cyanohydrin formation is the key C-C bond-forming step that converts the C3 amino aldehyde into the C4 aminonitrile needed for subsequent ring closure."}, {"id": "rxn_005", "name": "H2S-mediated thiolation-cyclization", "inputs": ["mol_009", "mol_002"], "outputs": ["mol_010", "mol_004"], "environment": "Surface", "agents": null, "conditions": {"temperature": "295-310K", "pressure": "1 atm", "catalyst": null, "aqueous": "true", "other": "sulfidic atmosphere or dissolved HS- in a cyanosulfidic pool"}, "mechanism": "HS- adds to the nitrile carbon to form a thioamide, then the terminal amine attacks intramolecularly to close a five-membered ring and release ammonia.", "reasoning": "Directly supported by Patel et al. (2015). This H2S-mediated thiolation-cyclization is the proline-specific ring-forming step; the three-carbon tether in 3-aminopropanal gives the correct geometry for five-membered-ring closure. The review notes that real-world H2S recycling efficiency could limit turnover."}, {"id": "rxn_006", "name": "Cu/H2S reductive deoxygenation", "inputs": ["mol_010"], "outputs": ["mol_011", "mol_003"], "environment": "Surface", "agents": ["native copper (Cu0)", "sulfidic acid (H2S)"], "conditions": {"temperature": "295-310K", "pressure": "1 atm", "catalyst": "Cu0/H2S reducing system", "aqueous": "true", "other": "cyanosulfidic pool with native copper precipitates"}, "mechanism": "Reductive deoxygenation removes the C3 hydroxyl group from the thione-bearing ring, producing pyrrolidine-2-thione and water.", "reasoning": "Directly supported by Patel et al. (2015), which used a Cu0/H2S reducing system to remove the C3 hydroxyl group. Native copper is geochemically plausible in sulfidic surface settings, but the review explicitly identifies sustained Cu0 availability on early Earth as an uncertainty."}, {"id": "rxn_007", "name": "Thione-to-nitrile exchange", "inputs": ["mol_011", "mol_001"], "outputs": ["mol_012", "mol_002"], "environment": "Surface", "agents": null, "conditions": {"temperature": "295-310K", "pressure": "1 atm", "catalyst": null, "aqueous": "true", "other": "HCN-rich cyanosulfidic pool"}, "mechanism": "HCN attacks the thioamide carbon of pyrrolidine-2-thione; sulfur is displaced and a nitrile is installed at C2, regenerating H2S.", "reasoning": "Directly supported by Patel et al. (2015). Thione-to-nitrile exchange converts the sulfur heterocycle into the immediate nitrile precursor of proline and regenerates H2S, embedding the route in a sulfur-recycling loop."}, {"id": "rxn_008", "name": "Nitrile hydration to prolinamide", "inputs": ["mol_012", "mol_003"], "outputs": ["mol_013"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-340K", "pressure": "1 atm", "catalyst": null, "aqueous": "true", "other": "warm aqueous pool with prolonged residence time"}, "mechanism": "Water adds to the nitrile carbon to give an imidate or amide sequence, yielding pyrrolidine-2-carboxamide.