iupac_name": "rac-(2R,3S)-2-amino-3-hydroxybutanoic acid", "common_name": "DL-threonine", "inchi": null, "role": "target", "environment_formed": "Surface"}, {"id": "mol_015", "formula": "C4H9NO3", "iupac_name": "rac-(2R,3R)-2-amino-3-hydroxybutanoic acid", "common_name": "DL-allothreonine", "inchi": null, "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_016", "formula": "C4H10NO3+", "iupac_name": "rac-(2R,3S)-2-ammonio-3-hydroxybutanoic acid", "common_name": "DL-threoninium", "inchi": null, "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_017", "formula": "C4H10NO3+", "iupac_name": "rac-(2R,3R)-2-ammonio-3-hydroxybutanoic acid", "common_name": "DL-allothreoninium", "inchi": null, "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_018", "formula": "C4H8NO3-", "iupac_name": "rac-(2R,3S)-2-amino-3-hydroxybutanoate", "common_name": "DL-threoninate", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_019", "formula": "C4H8NO3-", "iupac_name": "rac-(2R,3R)-2-amino-3-hydroxybutanoate", "common_name": "DL-allothreoninate", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_020", "formula": "H+", "iupac_name": "hydron", "common_name": "proton, aqueous acid equivalent", "inchi": "InChI=1S/p+1", "role": "starting", "environment_formed": null}, {"id": "mol_021", "formula": "HO-", "iupac_name": "hydroxide", "common_name": "hydroxide ion", "inchi": "InChI=1S/H2O/h1H2/p-1", "role": "starting", "environment_formed": null}, {"id": "mol_022", "formula": "NH4+", "iupac_name": "azanium", "common_name": "ammonium ion", "inchi": "InChI=1S/H3N/h1H3/p+1", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_023", "formula": "C2H4N2", "iupac_name": "2-aminoacetonitrile", "common_name": "aminoacetonitrile", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_024", "formula": "C2H5NO2", "iupac_name": "2-aminoacetic acid", "common_name": "glycine", "inchi": "InChI=1S/C2H5NO2/c3-1-2(4)5/h1,3H2,(H,4,5)", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_025", "formula": "C2H2O3", "iupac_name": "2-oxoacetic acid", "common_name": "glyoxylic acid", "inchi": "InChI=1S/C2H2O3/c3-1-2(4)5/h1H,(H,4,5)", "role": "starting", "environment_formed": null}, {"id": "mol_026", "formula": "H2", "iupac_name": "dihydrogen", "common_name": "hydrogen", "inchi": "InChI=1S/H2/h1H", "role": "starting", "environment_formed": null}, {"id": "mol_027", "formula": "H3NO", "iupac_name": "hydroxylamine", "common_name": "hydroxylamine", "inchi": "InChI=1S/H3NO/c1-2/h2H,1H2", "role": "starting", "environment_formed": null}, {"id": "mol_028", "formula": "C2H3NO3", "iupac_name": "2-(hydroxyimino)acetic acid", "common_name": "glyoxylic acid oxime, unspecified E/Z composition", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_029", "formula": "Fe", "iupac_name": "iron", "common_name": "zero-valent iron", "inchi": "InChI=1S/Fe", "role": "starting", "environment_formed": null}, {"id": "mol_030", "formula": "Fe2+", "iupac_name": "iron(II)", "common_name": "ferrous ion", "inchi": "InChI=1S/Fe/q+2", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_031", "formula": "Cu2+", "iupac_name": "copper(II)", "common_name": "cupric ion", "inchi": "InChI=1S/Cu/q+2", "role": "starting", "environment_formed": "Surface"}, {"id": "mol_032", "formula": "C4H8CuN2O4", "iupac_name": "bis(2-aminoacetato)copper(II)", "common_name": "bis(glycinato)copper(II)", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_033", "formula": "C8H16CuN2O6", "iupac_name": "bis(2-amino-3-hydroxybutanoato)copper(II)", "common_name": "copper-bound threonine/allothreonine ligand pool", "inchi": null, "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_034", "formula": "CuS", "iupac_name": "copper(II) sulfide", "common_name": "copper sulfide precipitate, CuS bookkeeping end member", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_035", "formula": "CH4", "iupac_name": "methane", "common_name": "methane", "inchi": "InChI=1S/CH4/h1H4", "role": "starting", "environment_formed": null}, {"id": "mol_036", "formula": "N2", "iupac_name": "dinitrogen", "common_name": "nitrogen", "inchi": "InChI=1S/N2/c1-2", "role": "starting", "environment_formed": null}, {"id": "mol_037", "formula": "CO2", "iupac_name": "carbon dioxide", "common_name": "carbon dioxide", "inchi": "InChI=1S/CO2/c2-1-3", "role": "starting", "environment_formed": null}], "reactions": [{"id": "rxn_001", "name": "Formaldehyde capture as glycolonitrile", "inputs": ["mol_003", "mol_002"], "outputs": ["mol_007"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-310 K, proposed operating range", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Proposed pH 7-8.5, millimolar dissolved reactants, and 0.5-24 h equilibration screen. Use a water-filled, weakly ventilated compartment to limit HCN loss. These are design conditions, not a recovered historical protocol."}, "mechanism": "Reversible cyanide addition to hydrated/free formaldehyde followed by proton transfer forms the cyanohydrin.", "reasoning": "Glycolonitrile is an experimentally used entry substrate for cyanide photoredox homologation (Ritson and Sutherland, 2013; Patel et al., 2015). This chemically established capture step does not establish a natural source or concentration mechanism for HCN and formaldehyde. Polymerization, HCN volatilization and subsequent cyanohydrin dissociation must be measured rather than assumed negligible."}, {"id": "rxn_002", "name": "Cyanosulfidic photoreduction of glycolonitrile to glycolaldehyde", "inputs": ["mol_007", "mol_004", "mol_001"], "outputs": ["mol_008", "mol_005", "mol_006"], "environment": "Surface", "agents": ["CuCN-derived copper(I) cyanide photoredox species"], "conditions": {"temperature": "300-310 K, proposed bulk-water range", "pressure": "Approximately 1 atm", "catalyst": "CuCN-derived Cu(I)/Cu(II) photoredox system", "aqueous": true, "other": "Reported platform conditions: 10 mM glycolonitrile, 30 mM H2S, 33 mM phosphate, pH 7, 10 mol% solid CuCN and 254 nm irradiation. The supplied report does not establish a transferable irradiation duration; a proposed 0.5-6 h screen requires measured photon fluence and product sampling."}, "mechanism": "Photochemical electron transfer reduces the nitrile to an imine-level intermediate, followed by hydrolysis to glycolaldehyde. Sulfide supplies reducing equivalents; ammonia and oxidized sulfur are net coproducts.", "reasoning": "The reaction and platform conditions are supported by Ritson and Sutherland (2013). CuCN is a precatalyst/speciation reservoir, not evidence that arbitrary copper sulfides catalyse this transformation. CuS formation, cyanide ligation and UV attenuation can suppress activity. The S8 output represents redox bookkeeping across an unresolved sulfur inventory; its partition into elemental sulfur and polysulfides is not quantified. Sulfidic-anion availability and optical limitations are material constraints (Ranjan et al., 2018)."}, {"id": "rxn_003", "name": "Photoredox deoxygenation of glycolaldehyde to acetaldehyde", "inputs": ["mol_008", "mol_004"], "outputs": ["mol_009", "mol_001", "mol_006"], "environment": "Surface", "agents": ["CuCN-derived copper cyanide photoredox species"], "conditions": {"temperature": "300-310 K, proposed bulk-water range", "pressure": "Approximately 1 atm", "catalyst": "Copper cyanide photoredox system", "aqueous": true, "other": "Use the pH approximately 7, phosphate-buffered, 254 nm cyanosulfidic platform as a starting screen, not an asserted substrate-specific reproduction. Proposed residence screen: 0.5-6 h. Transfer or capture acetaldehyde immediately after illumination; avoid open wet-dry concentration because acetaldehyde is volatile."}, "mechanism": "Net photoredox removal of the alpha-hydroxyl oxygen converts the C2 hydroxyaldehyde into acetaldehyde. This node compresses photochemical intermediates and is not an elementary hydrogenolysis claim.", "reasoning": "Acetaldehyde formation from glycolaldehyde is part of the cyanosulfidic network described by Patel et al. (2015), building on Ritson and Sutherland (2013). The supplied findings do not provide a transferable yield and residence time for this isolated module. Acetaldehyde retention is a key bottleneck. This product can feed the cyanohydrin branch, but no direct transfer of its sulfide/cyanide-containing mixture into the Cu(II)-aldol module is assumed."}, {"id": "rxn_004", "name": "Acetaldehyde capture as lactonitrile", "inputs": ["mol_009", "mol_002"], "outputs": ["mol_010"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-310 K, proposed range", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Proposed pH 7-8.5 and 0.5-24 h equilibration screen. Capture in the same compartment or by short-distance aqueous flow. Use low headspace and exclude prolonged open-air evaporation."}, "mechanism": "Cyanide adds to acetaldehyde, producing racemic 2-hydroxypropanenitrile.", "reasoning": "Lactonitrile is the acetaldehyde cyanohydrin used to obtain lactaldehyde in the experimental cyanosulfidic work (Ritson and Sutherland, 2013). This is supported precursor chemistry, but the proposed environmental capture conditions are not a reported integrated yield. Cyanohydrin reversibility competes with acetaldehyde loss and self-condensation."}, {"id": "rxn_005", "name": "Photoreduction of lactonitrile to lactaldehyde", "inputs": ["mol_010", "mol_004", "mol_001"], "outputs": ["mol_011", "mol_005", "mol_006"], "environment": "Surface", "agents": ["CuCN-derived copper(I) cyanide photoredox species"], "conditions": {"temperature": "300-310 K, proposed bulk-water range", "pressure": "Approximately 1 atm", "catalyst": "CuCN-derived Cu(I)/Cu(II) photoredox system", "aqueous": true, "other": "254 nm irradiation and a near-neutral, phosphate-buffered CuCN/H2S system. The 10 mM substrate, 30 mM H2S, 33 mM phosphate and 10 mol% CuCN values are reference platform conditions, not a verified complete protocol for the reported lactaldehyde yield. Proposed 0.5-6 h time-course screen; quantify substrate-specific fluence and retention."}, "mechanism": "Reduction of the nitrile followed by imine hydrolysis produces lactaldehyde while retaining the pre-existing hydroxyl-bearing carbon.", "reasoning": "Lactaldehyde was reported in 19% yield from lactonitrile, and identified as the Strecker precursor of threonine/allothreonine (Ritson and Sutherland, 2013). That yield applies to this precursor transformation, not the complete amino-acid sequence. Sulfur speciation, soluble copper concentration and intermediate lifetime remain integration uncertainties. The low precursor yield makes this a principal flux bottleneck."}, {"id": "rxn_006", "name": "Lactaldehyde Strecker capture to the threonine aminonitrile pool", "inputs": ["mol_011", "mol_005", "mol_002"], "outputs": ["mol_012", "mol_001"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-310 K, proposed range", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Switch off irradiation before amino-acid-precursor accumulation. Proposed pH 8-9.5, excess ammonia and a 1-48 h sampling series. Settle or filter suspended solids, while recognizing that this does not remove dissolved copper, sulfide or cyanide. Exact concentrations and duration for a quantitative aminonitrile yield are unavailable in the supplied findings."}, "mechanism": "Ammonia forms an imine/iminium equilibrium with lactaldehyde; cyanide addition yields 2-amino-3-hydroxybutanenitrile stereoisomers.", "reasoning": "Conversion of lactaldehyde to the threonine/allothreonine aminonitrile was reported qualitatively as smooth (Ritson and Sutherland, 2013; Patel et al., 2015). No quantitative aminonitrile yield or threo:allo ratio is supplied. An approximately nonselective stereochemical model is a working assumption, not a measurement. This reaction reaches the strongest experimentally supported endpoint of the designed cyanide route."}, {"id": "rxn_007", "name": "Acid-catalysed hydration of threonine aminonitriles", "inputs": ["mol_012", "mol_001"], "outputs": ["mol_013"], "environment": "Surface", "agents": ["Aqueous Br\u00f8nsted acid"], "conditions": {"temperature": "333-363 K, proposed screening range", "pressure": "Approximately 1 atm", "catalyst": "Hydronium ions", "aqueous": true, "other": "Proposed pH 0.5-2 and 1-30 day time course in a shaded acidic pool analogue. These are test conditions, not literature-validated threonine-aminonitrile conditions. Measure amide, residual nitrile, free amino acids and degradation products independently."}, "mechanism": "Nitrile protonation facilitates water addition and tautomerization to an amide; organic acid-base microstates are compressed in this hydration module.", "reasoning": "Speculative for this target under the stated environmental conditions. Conventional Strecker chemistry supports the transformation class, but the supplied target-specific experiments stop at the aminonitrile (Ritson and Sutherland, 2013). The report's discussion of Strecker hydrolysis limitations makes this an explicit bottleneck, not a completed experimental step."}, {"id": "rxn_008", "name": "Acidic amide hydrolysis to threoninium and allothreoninium", "inputs": ["mol_013", "mol_001", "mol_020"], "outputs": ["mol_016", "mol_017", "mol_022"], "environment": "Surface", "agents": ["Aqueous Br\u00f8nsted acid"], "conditions": {"temperature": "333-363 K, proposed screening range", "pressure": "Approximately 1 atm", "catalyst": "Hydronium ions", "aqueous": true, "other": "Proposed pH 0.5-2, monitored over 1-30 days. Proton inputs account for product protonation as well as the acidic medium. Stop on a measured maximum in recovered amino-acid carbon rather than assuming complete conversion."}, "mechanism": "Acid-catalysed amide cleavage gives carboxylic-acid products and ammonium. Both threo and allo pools are retained in the graph without imposing their branching ratio.", "reasoning": "Speculative target-specific completion: neither recovered free-threonine yield nor suitable hydrolysis conditions are established by the supplied cyanosulfidic studies (Ritson and Sutherland, 2013; Patel et al., 2015). Amide cleavage must outcompete decomposition and stereochemical alteration. The reaction is chemically plausible but cannot be assigned a validated yield or guaranteed residence time."}, {"id": "rxn_009", "name": "Base-catalysed hydration of threonine aminonitriles", "inputs": ["mol_012", "mol_001"], "outputs": ["mol_013"], "environment": "Surface", "agents": ["Hydroxide ions"], "conditions": {"temperature": "333-363 K, proposed screening range", "pressure": "Approximately 1 atm", "catalyst": "Hydroxide ions", "aqueous": true, "other": "Proposed pH 11-12.5 and 1-30 day time course. This is a separate alkaline processing branch, not simultaneous operation with the acidic branch. Keep the solution shaded and quantify epimerization and carbon loss."}, "mechanism": "Hydroxide attack on the nitrile, followed by proton transfers, gives the amide pool.", "reasoning": "Speculative for this substrate pool. General nitrile chemistry supports alkaline hydration, but the provided research contains no threonine-aminonitrile conversion or recovered-yield measurement under these conditions. The endpoint established by Ritson and Sutherland (2013) is therefore not extended to a demonstrated alkaline amino-acid synthesis."}, {"id": "rxn_010", "name": "Alkaline amide hydrolysis to threoninate and allothreoninate", "inputs": ["mol_013", "mol_021"], "outputs": ["mol_018", "mol_019", "mol_005"], "environment": "Surface", "agents": null, "conditions": {"temperature": "333-363 K, proposed screening range", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Proposed pH 11-12.5 and 1-30 day monitoring. Hydroxide is a net reactant in the carboxylate-forming equation. Promptly cool and acidify after an analytically established endpoint; no complete-conversion assumption is made."}, "mechanism": "Hydroxide-mediated acyl substitution releases ammonia and produces amino-acid carboxylates.", "reasoning": "Speculative target-specific completion. The reaction class is conventional, but its useful selectivity for this beta-hydroxy substrate is not established by the supplied evidence. Base-dependent threonine/allothreonine changes in preparative aldol chemistry caution against assuming stereochemical preservation (Sato et al., 1957; the 1973 bis(glycinato)copper study summarized in the supplied report). Hydrolysis competes with retro-aldol chemistry and other decomposition."}, {"id": "rxn_011", "name": "Weakly acidic recovery of neutral-form threonine from threoninium", "inputs": ["mol_016", "mol_017"], "outputs": ["mol_014", "mol_015", "mol_020"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-313 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Proposed mixing/dilution into shaded water at pH 3.5-4.0, with 0.5-2 h equilibration sampling. For copper-release branches, dilute total dissolved copper to at most approximately 10 micromolar as an initial test criterion. This criterion requires measured free/bound fractions; it is not a validated universal threshold. Do not reconcentrate without reassessing re-chelation."}, "mechanism": "Carboxyl deprotonation converts amino-acid cations predominantly to their zwitterionic, net-neutral forms.", "reasoning": "This is acid-base equilibration rather than a new carbon-skeleton synthesis. Its inclusion prevents acidic hydrolysis or copper dissociation from being equated automatically with neutral product recovery. No target-specific isolation yield is supplied by Ritson and Sutherland (2013) or the Akabori studies. The proposed dilution-and-pH handling is therefore an unvalidated integration step; it trades concentration for a potentially larger free-amino-acid fraction."}, {"id": "rxn_012", "name": "Protonation and cooling of alkaline amino-acid products", "inputs": ["mol_018", "mol_019", "mol_020"], "outputs": ["mol_014", "mol_015"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-313 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Mix into a shaded acidic receiver to obtain pH 3.5-4.0. Proposed equilibration screen: 0.5-2 h. Measure dissolved copper and the free amino-acid fraction; dilution may be necessary because filtration does not remove soluble metal complexes."}, "mechanism": "Protonation of amino-acid anions gives predominantly net-neutral zwitterions.", "reasoning": "Acid-base recovery is chemically straightforward, but it does not repair low upstream hydrolysis yield or remove dissolved copper automatically. This handling operation is not validated in the supplied target-specific literature. Cooling and shielding are motivated by threonine decomposition and radical sensitivity discussed by Schroeder and Bada (1977) and Wen et al. (2022)."}, {"id": "rxn_013", "name": "Formaldehyde Strecker synthesis of aminoacetonitrile", "inputs": ["mol_003", "mol_005", "mol_002"], "outputs": ["mol_023", "mol_001"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-313 K, proposed range", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Proposed pH 8-9.5, millimolar formaldehyde/HCN, excess ammonia and a 1-48 h screen. Use a separate, non-sulfidic compartment for glycine intended for copper aldol chemistry. Residual free cyanide must be measured before downstream copper addition."}, "mechanism": "Formaldehyde and ammonia establish an imine equilibrium; cyanide addition produces aminoacetonitrile.", "reasoning": "Glycine aminonitrile is among the amino-acid precursor products discussed in the cyanosulfidic framework (Patel et al., 2015), and the underlying formaldehyde Strecker chemistry is established. The proposed operating window is not a reported integrated glycine-to-threonine protocol. Avoiding sulfide here removes one incompatibility, but cyanide carryover remains capable of changing copper speciation."}, {"id": "rxn_014", "name": "Aminoacetonitrile hydrolysis and glycine recovery", "inputs": ["mol_023", "mol_001", "mol_020"], "outputs": ["mol_024", "mol_022"], "environment": "Surface", "agents": ["Aqueous Br\u00f8nsted acid"], "conditions": {"temperature": "333-363 K hydrolysis, followed by cooling to 300-313 K", "pressure": "Approximately 1 atm", "catalyst": "Hydronium ions", "aqueous": true, "other": "Proposed acid phase at pH 1-2 with a 1-30 day time course, followed by adjustment to pH approximately 5-6. This net module includes amide formation, cleavage and acid-base recovery. Confirm aminonitrile depletion and residual cyanide rather than assuming purification by heating."}, "mechanism": "Sequential nitrile hydration and amide hydrolysis produce glycine; the departing nitrile nitrogen is represented as ammonium at the recovery pH.", "reasoning": "Glycine is a well-established Strecker product and is much better supported than target-specific threonine hydrolysis; the supplied network literature identifies its aminonitrile precursor (Patel et al., 2015). Nevertheless, the mild environmental completion window and subsequent transfer proposed here are not quantitatively validated by the supplied findings. Copper-complex formation is conditional on measured glycine availability and tolerable cyanide carryover."}, {"id": "rxn_015", "name": "Nickel-catalysed reductive amination of glyoxylate to glycine", "inputs": ["mol_025", "mol_005", "mol_026"], "outputs": ["mol_024", "mol_001"], "environment": "Biochemical", "agents": ["Ni supported on SiO2-Al2O3, experimental catalyst"], "conditions": {"temperature": "295 K, reported 22 degrees Celsius", "pressure": "5 bar H2 partial pressure", "catalyst": "Ni/SiO2-Al2O3", "aqueous": true, "other": "Reported comparison conditions include pH 8 and ammonium concentrations as low as 6 mM. Proposed screening feed: 5-10 mM glyoxylate, 6-100 mM total ammonia/ammonium and 6-48 h sampling; these concentration/time choices are not a recovered substrate-specific protocol. Model a confined gas-rich pore, not an ambient-pressure open pool. Filter catalyst solids before transfer, then assay dissolved nickel."}, "mechanism": "Ammonia addition gives an imine/iminium equilibrium that is hydrogenated on the nickel surface.", "reasoning": "Glyoxylate reductive amination is supported by Kaur et al. (2024), including metal-catalyst dependence and the approximately 5 bar hydrogen regime. The reaction supplies glycine only; it is not evidence for threonine reductive amination. Maintaining hydrogen pressure, obtaining the supported catalyst or an effective natural analogue, and recovering a copper-compatible glycine solution are unresolved environmental requirements. A stated H2 molecule does not by itself satisfy the required partial pressure."}, {"id": "rxn_016", "name": "Glyoxylic acid oxime formation", "inputs": ["mol_025", "mol_027"], "outputs": ["mol_028", "mol_001"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-323 K, proposed range", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Proposed pH 4-6, 1-2 hydroxylamine equivalents and a 1-24 h time course. Glyoxylate and hydroxylamine are boundary feedstocks; their environmental supply at these concentrations is not established by this network."}, "mechanism": "Hydroxylamine condenses with the aldehyde group of glyoxylic acid to form an oxime.", "reasoning": "Muchowska et al. (2019) provide precedent for hydroxylamine/Fe0 conversion of network keto-acid products into amino acids. This isolated oxime step is a mechanistic decomposition of that chemistry, not a separately demonstrated prebiotic glycine-production protocol in the supplied findings. The stated conditions and oxime accumulation are therefore speculative and require direct analysis."}, {"id": "rxn_017", "name": "Zero-valent iron reduction of glyoxylate oxime to glycine", "inputs": ["mol_028", "mol_029", "mol_020"], "outputs": ["mol_024", "mol_001", "mol_030"], "environment": "Surface", "agents": null, "conditions": {"temperature": "313-343 K, proposed range", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Proposed pH 4-6, at least the stoichiometric reducing capacity of two Fe atoms per oxime, and a 6-72 h screen. Iron is consumed, not catalytic. Competing corrosion can increase actual iron demand. Settle/filter remaining Fe0 before transfer; this does not remove dissolved Fe2+."}, "mechanism": "Four-electron reduction combines C=N reduction with N-O bond cleavage. Oxidation of zero-valent iron produces ferrous ions.", "reasoning": "The mechanistic class is consistent with hydroxylamine/Fe0 amination reported by Muchowska et al. (2019), but isolated glyoxylate-oxime conversion and the proposed conditions are not independently established in the supplied report. This is a speculative module decomposition. The neutral oxime formula is C2H3NO3, and the iron product is explicitly Fe2+ with a matching InChI. Ferrous-ion carryover and proton consumption must be accounted for before Cu(II)-glycinate formation; physical filtration alone is insufficient."}, {"id": "rxn_018", "name": "Assembly of the copper(II) glycinate reactant complex", "inputs": ["mol_024", "mol_031"], "outputs": ["mol_032", "mol_020"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-313 K, proposed range", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Proposed pH 7-8.5, glycine:Cu ratio at least 2:1, and 0.5-4 h speciation sampling. A preparative screening regime might use 20-100 mM glycine and 10-40 mM copper, subject to the ligand ratio. These are proposed laboratory-like concentrations, not demonstrated environmental abundances. Admit an upstream mixture only after assaying cyanide, sulfide, dissolved iron/nickel and copper speciation."}, "mechanism": "Two glycine ligands coordinate Cu(II) through amino nitrogen and carboxylate oxygen, with net proton release.", "reasoning": "Copper glycinate is the experimentally established substrate complex for Akabori-type threonine synthesis (Sato, Okawa and Akabori, 1957). Explicit complex assembly avoids treating unspecified copper minerals as interchangeable catalysts. Cu(II) is a supplied stoichiometric promoter here; no anoxic geochemical regeneration cycle is claimed. Sulfide precipitation, cyanide complexation and competing metal ligands can invalidate this node. Natural access to the proposed copper concentrations is a major limitation."}, {"id": "rxn_019", "name": "Copper-glycinate aldol addition to acetaldehyde", "inputs": ["mol_032", "mol_009"], "outputs": ["mol_033"], "environment": "Surface", "agents": ["Coordinated Cu(II), present in the reactant complex", "Hydroxide as base promoter"], "conditions": {"temperature": "313-333 K, proposed screening range", "pressure": "Approximately 1 atm in a low-headspace compartment", "catalyst": "Cu(II)-glycinate activation with base promotion; catalytic turnover is not assumed", "aqueous": true, "other": "Proposed pH 10-11.5, 50-250 mM acetaldehyde and a 1-48 h time course. These are explicit laboratory-like screening conditions, not a reconstruction of the 1957 protocol. Use independently supplied acetaldehyde for pathways P3-P8. Avoid open drying and monitor acetaldehyde self-condensation, metal precipitation and threo/allo ligand composition."}, "mechanism": "Chelation facilitates glycine alpha-carbon deprotonation; carbon-carbon bond formation with acetaldehyde yields coordinated beta-hydroxy amino-acid ligands. The product node aggregates unresolved threo/allo and mixed-ligand coordination isomers.", "reasoning": "Sato, Okawa and Akabori (1957) reported up to 64% combined threonine/allothreonine in preparative copper-glycinate chemistry. That value is not assigned to the proposed environmental screen. The supplied review reports a roughly 1.6:1 threo:allo ratio under classic conditions, but the ratio is secondary-source and condition-dependent. Concentrated copper complexes, strong base, volatile acetaldehyde, reversibility and competing decomposition prevent this from being accepted as a demonstrated geochemical process."}, {"id": "rxn_020", "name": "Acid-driven dissociation of copper-bound hydroxyamino acids", "inputs": ["mol_033", "mol_020"], "outputs": ["mol_016", "mol_017", "mol_031"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-313 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Proposed acidification to pH 1-2 with 0.5-4 h speciation sampling. Subsequent hydrological dilution is required before rxn_011; the initial test goal is total copper at or below approximately 10 micromolar. Acid dissociation does not physically separate copper. Quantify free ligand, protonated ligand and copper complexes before changing pH."}, "mechanism": "Protonation weakens amino/carboxylate coordination and shifts the equilibrium toward solvated Cu2+ and protonated amino acids.", "reasoning": "This is a chemically plausible but unvalidated environmental recovery module. Sato et al. (1957) establish preparative access to the amino acids, not this particular geochemical dissociation-and-dilution schedule. Explicit Cu2+ release prevents hidden assumptions about product liberation or catalyst recovery. Raising pH or reconcentrating without sufficient dilution can re-form copper complexes, so this route produces a conditional dilute inventory, not purified threonine."}, {"id": "rxn_021", "name": "Sulfide-driven copper removal and amino-acid release", "inputs": ["mol_033", "mol_004"], "outputs": ["mol_014", "mol_015", "mol_034"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-313 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Proposed transfer into a shaded sulfide-containing receiver at pH 5-7, with approximately stoichiometric sulfide relative to copper and a 0.5-24 h screen. Allow settling and physical separation of the precipitate. Determine copper remaining in solution, colloid retention, and amino-acid adsorption losses."}, "mechanism": "Formation of poorly soluble copper sulfide removes copper from amino-acid chelates, releasing protonated-at-nitrogen, net-neutral amino acids.", "reasoning": "Speculative as an integrated prebiotic threonine-recovery operation, although sulfide precipitation provides a chemically strong driving force for copper removal. The supplied Akabori literature supports the preceding synthesis, not a measured yield for this recovery method (Sato et al., 1957). CuS is an idealized precipitate end member; actual solids may have more complex speciation. This branch consumes the copper promoter and cannot be described as a closed catalytic cycle."}, {"id": "rxn_022", "name": "Methane\u2013nitrogen discharge threonine inventory", "inputs": ["mol_035", "mol_036", "mol_005", "mol_001"], "outputs": ["mol_014", "mol_015", "mol_026"], "environment": "Surface", "agents": null, "conditions": {"temperature": "Approximately 300-320 K bulk-water reference; discharge microzones are much hotter", "pressure": "Near-ambient receiver model; exact original gas pressures are not supplied", "catalyst": null, "aqueous": true, "other": "Reported feed class: CH4, N2 and H2O with traces of NH3, energized by electrical discharge. Original residence time, detailed gas ratios and analytical workup conditions are not recoverable from the supplied summary. The bulk-temperature range is a model reference, not an asserted experimental condition. No mineral catalyst is assigned."}, "mechanism": "Lumped experimental inventory: discharge-generated radicals and soluble precursors undergo complex reactions and analytical recovery. No particular lactaldehyde or aminonitrile sequence is inferred from the detected amino acids.", "reasoning": "Threonine and allothreonine were identified in reducing-discharge products (Ring et al., 1972). The approximately equal trace abundances reported through Weber and Miller (1981) are relative analytical values, not absolute synthesis yields. This net target-channel representation is balanceable but is not a full discharge mass balance or an elementary mechanism. It does not establish environmentally available free threonine before workup, selective production, or a reproducible precursor-delivery route."}, {"id": "rxn_023", "name": "Hydrogen-sulfide-rich discharge threonine inventory", "inputs": ["mol_035", "mol_005", "mol_037", "mol_004", "mol_001"], "outputs": ["mol_014", "mol_015", "mol_026", "mol_006"], "environment": "Surface", "agents": null, "conditions": {"temperature": "Bulk-water temperature not supplied; 300-320 K is a receiving-water model range", "pressure": "Reported initial listed dry-gas partial pressures sum to 695 mmHg; water-vapor contribution unspecified", "catalyst": null, "aqueous": true, "other": "Reported feed: CH4 258 mmHg, H2S 100 mmHg, NH3 250 mmHg and CO2 87 mmHg; electrical discharge for 3 days. Sulfur deposits were observed on tungsten electrodes, but catalytic causation was not established. Analytical recovery is included in this inventory module; its full workup conditions are not supplied."}, "mechanism": "Lumped sulfur-influenced discharge chemistry produces a broad organic precursor mixture from which amino acids were recovered. H2 and the representative sulfur reservoir provide admissible net coproduct bookkeeping, not measured product ratios.", "reasoning": "Threonine was detected in the archived H2S-rich experiment and not in the other three archived discharge sets compared by Parker et al. (2011). The allothreonine output is an expected nonselective coproduct supported by the broader discharge record, not a separately quantified Parker yield. Its inclusion is therefore an inference, unlike the threonine detection. Sulfur deposition does not establish a tungsten/sulfur catalyst. This route is an observed trace-product inventory, not proof of a specific aldehyde pathway or a complete natural free-amino-acid synthesis."}, {"id": "rxn_024", "name": "Hydrothermal retro-aldol loss of threonine", "inputs": ["mol_014"], "outputs": ["mol_024", "mol_009"], "environment": "Hydrothermal", "agents": null, "conditions": {"temperature": "394-433 K, corresponding to the 121-160 degrees Celsius regime discussed in the supplied review", "pressure": "10-100 bar, sufficient to retain liquid water", "catalyst": null, "aqueous": true, "other": "Represents accidental entrainment into hot water rather than a required synthetic transfer. Proposed monitoring over hours to days; no rate constant or quantitative loss is assigned. Other decomposition products are outside this particular sink channel."}, "mechanism": "Cleavage of the bond between the alpha and beta carbons yields glycine and acetaldehyde.", "reasoning": "Threonine retro-aldol decomposition and thermal instability are supported by the degradation literature summarized in the supplied report, including Schroeder and Bada (1977); broader hydrothermal survival concerns are discussed by Aubrey, Cleaves and Bada (2009). This reaction is a sink and is not counted as a synthesis pathway. Reported Arrhenius extrapolations are not treated as direct measurements at the proposed conditions."}, {"id": "rxn_025", "name": "Analogous hydrothermal retro-aldol loss of allothreonine", "inputs": ["mol_015"], "outputs": ["mol_024", "mol_009"], "environment": "Hydrothermal", "agents": null, "conditions": {"temperature": "394-433 K, proposed comparison range", "pressure": "10-100 bar", "catalyst": null, "aqueous": true, "other": "Run alongside the threonine stability assay with independent stereoisomer measurements. No equality of threonine and allothreonine degradation rates is assumed."}, "mechanism": "The same beta-hydroxy amino-acid carbon skeleton permits retro-aldol cleavage to glycine and acetaldehyde.", "reasoning": "This is a mechanistically plausible analogue with less direct support in the supplied findings than threonine cleavage. The threonine decomposition and epimerization literature provides context, not a measured allothreonine rate law (Schroeder and Bada, 1977). It is explicitly speculative at the stated conditions and is included only to avoid treating the tracked allo pool as indefinitely stable."}], "pathways": [{"pathway_id": "P1", "name": "Cyanosulfidic precursor synthesis with acidic Strecker completion", "description": "Formaldehyde and HCN supply the carbon skeleton through glycolaldehyde, acetaldehyde and lactaldehyde. The demonstrated precursor sequence is extended through explicitly unvalidated acidic aminonitrile/amide hydrolysis and weakly acidic recovery. The 19% lactaldehyde result is not an overall threonine yield.", "reaction_sequence": ["rxn_001", "rxn_002", "rxn_003", "rxn_004", "rxn_005", "rxn_006", "rxn_007", "rxn_008", "rxn_011"], "key_intermediates": ["mol_007", "mol_009", "mol_010", "mol_011", "mol_012", "mol_013"]}, {"pathway_id": "P2", "name": "Cyanosulfidic precursor synthesis with alkaline Strecker completion", "description": "Shares the supported carbon-skeleton construction with P1 but uses hydroxide-mediated nitrile/amide conversion and subsequent protonation. This is a genuinely different completion schedule, not independent evidence for the shared precursor chemistry. Hydrolysis efficiency and competing epimerization/decomposition are unresolved.", "reaction_sequence": ["rxn_001", "rxn_002", "rxn_003", "rxn_004", "rxn_005", "rxn_006", "rxn_009", "rxn_010", "rxn_012"], "key_intermediates": ["mol_011", "mol_012", "mol_013", "mol_018", "mol_019"]}, {"pathway_id": "P3", "name": "Strecker-derived glycine, copper aldol and acidic release", "description": "Make glycine from formaldehyde, ammonia and HCN, then combine its copper complex with independently supplied acetaldehyde. Recover a dilute weakly acidic threonine/allothreonine inventory through acid dissociation and dilution. Cyanide carryover and copper re-chelation must be measured; purified product isolation is not claimed.", "reaction_sequence": ["rxn_013", "rxn_014", "rxn_018", "rxn_019", "rxn_020", "rxn_011"], "key_intermediates": ["mol_023", "mol_024", "mol_032", "mol_033", "mol_016"]}, {"pathway_id": "P4", "name": "Strecker-derived glycine, copper aldol and sulfide release", "description": "Use the same glycine source and independent acetaldehyde boundary feed as P3, but liberate amino acids by precipitating copper sulfide. This avoids relying on reversible acid dissociation alone, while consuming the copper promoter and introducing adsorption/colloid losses that require measurement.", "reaction_sequence": ["rxn_013", "rxn_014", "rxn_018", "rxn_019", "rxn_021"], "key_intermediates": ["mol_023", "mol_024", "mol_032", "mol_033"]}, {"pathway_id": "P5", "name": "Nickel/hydrogen-derived glycine, copper aldol and acidic release", "description": "Supply glycine by the experimentally supported glyoxylate reductive-amination class at approximately 295 K and 5 bar H2. After catalyst removal and dissolved-metal assessment, use independent acetaldehyde in the copper aldol module. Finish by acid dissociation and dilution. Pressure maintenance, catalyst availability and mixture compatibility remain conditional.", "reaction_sequence": ["rxn_015", "rxn_018", "rxn_019", "rxn_020", "rxn_011"], "key_intermediates": ["mol_024", "mol_032", "mol_033", "mol_016"]}, {"pathway_id": "P6"