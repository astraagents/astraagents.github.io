_029\",\n      \"formula\": \"C4H10ClNO3\",\n      \"iupac_name\": \"(2RS,3RS)-2-Amino-3-hydroxybutanoic acid hydrochloride\",\n      \"common_name\": \"DL-Allothreonine hydrochloride\",\n      \"inchi\": null,\n      \"role\": \"hub_intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_030\",\n      \"formula\": \"CuS\",\n      \"iupac_name\": \"Copper sulfide\",\n      \"common_name\": \"Copper sulfide precipitate, formal CuS endpoint\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_031\",\n      \"formula\": \"CH4\",\n      \"iupac_name\": \"Methane\",\n      \"common_name\": \"Methane\",\n      \"inchi\": \"InChI=1S/CH4/h1H4\",\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_032\",\n      \"formula\": \"N2\",\n      \"iupac_name\": \"Dinitrogen\",\n      \"common_name\": \"Nitrogen\",\n      \"inchi\": \"InChI=1S/N2/c1-2\",\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_033\",\n      \"formula\": \"CO2\",\n      \"iupac_name\": \"Carbon dioxide\",\n      \"common_name\": \"Carbon dioxide\",\n      \"inchi\": \"InChI=1S/CO2/c2-1-3\",\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_034\",\n      \"formula\": \"NaOH\",\n      \"iupac_name\": \"Sodium hydroxide\",\n      \"common_name\": \"Sodium-associated aqueous alkalinity\",\n      \"inchi\": null,\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_035\",\n      \"formula\": \"NaCl\",\n      \"iupac_name\": \"Sodium chloride\",\n      \"common_name\": \"Sodium chloride\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_036\",\n      \"formula\": \"C4H8NNaO3\",\n      \"iupac_name\": \"Sodium (2RS,3SR)-2-amino-3-hydroxybutanoate\",\n      \"common_name\": \"Sodium DL-threoninate\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_037\",\n      \"formula\": \"C4H8NNaO3\",\n      \"iupac_name\": \"Sodium (2RS,3RS)-2-amino-3-hydroxybutanoate\",\n      \"common_name\": \"Sodium DL-allothreoninate\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_038\",\n      \"formula\": \"NH4Cl\",\n      \"iupac_name\": \"Ammonium chloride\",\n      \"common_name\": \"Ammonium chloride\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_039\",\n      \"formula\": \"C2H6ClNO2\",\n      \"iupac_name\": \"2-Aminoacetic acid hydrochloride\",\n      \"common_name\": \"Glycine hydrochloride\",\n      \"inchi\": null,\n      \"role\": \"hub_intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_040\",\n      \"formula\": \"FeH2O2\",\n      \"iupac_name\": \"Iron(II) hydroxide\",\n      \"common_name\": \"Ferrous hydroxide\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Biochemical\"\n    }\n  ],\n  \"reactions\": [\n    {\n      \"id\": \"rxn_001\",\n      \"name\": \"Photoredox entry from hydrogen cyanide to formaldehyde\",\n      \"inputs\": [\"mol_001\", \"mol_002\", \"mol_004\"],\n      \"outputs\": [\"mol_006\", \"mol_003\", \"mol_005\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"CuCN-derived cyanocuprate photoredox species\", \"Phosphate buffer\"],\n      \"conditions\": {\n        \"temperature\": \"300-310 K, proposed near-room-temperature operating window\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": \"CuCN-derived Cu(I)/Cu(II) photoredox system\",\n        \"aqueous\": true,\n        \"other\": \"Anoxic, 254 nm irradiation. Proposed starting screen: 10 mM total cyanide, 30 mM total sulfide, 33 mM phosphate, pH approximately 7 and CuCN at 10 mol% relative to carbon substrate. These concentrations adapt the reported glycolonitrile protocol rather than reproduce a separately established HCN-only recipe. Proposed exposure: 1-24 h with time-course sampling. A shallow illuminated layer and continuing volatile-feed retention are required.\"\n      },\n      \"mechanism\": \"A coarse-grained reduction of HCN through reduced C1 nitrogen intermediates, followed by hydrolysis to formaldehyde. Sulfide supplies reducing equivalents and is represented as ending in zero-valent sulfur.\",\n      \"reasoning\": \"HCN reductive homologation supplies the C1 entry to the cyanosulfidic framework (Ritson and Sutherland, 2013; Patel et al., 2015). This is a network-level transformation, not an established selective one-step preparation at the proposed concentrations. Natural photon flux, cyanide retention and CuCN/cyanocuprate speciation must be measured. Sulfide and sulfur precipitates can attenuate UV or remove copper from the active pool; the supplied evidence does not quantify these integrated losses (Ranjan et al., 2018).\"\n    },\n    {\n      \"id\": \"rxn_002\",\n      \"name\": \"Formaldehyde cyanohydrin formation\",\n      \"inputs\": [\"mol_006\", \"mol_001\"],\n      \"outputs\": [\"mol_007\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-310 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Proposed pH 7-9, millimolar formaldehyde and total cyanide, and 1-24 h equilibration. Keep ammonia relatively low when directing carbon toward glycolonitrile rather than aminoacetonitrile. Avoid extended drying because HCN loss would change the reaction balance.\"\n      },\n      \"mechanism\": \"Cyanide adds to formaldehyde and proton transfer produces glycolonitrile.\",\n      \"reasoning\": \"Cyanohydrin capture connects formaldehyde to the experimentally studied glycolonitrile photochemistry (Ritson and Sutherland, 2013; Patel et al., 2015). No mineral is necessary for this carbon-carbon bond formation. Hydrated formaldehyde, competing ammonia chemistry and cyanide volatility affect the usable glycolonitrile concentration.\"\n    },\n    {\n      \"id\": \"rxn_003\",\n      \"name\": \"Glycolonitrile photoreduction to glycolaldehyde\",\n      \"inputs\": [\"mol_007\", \"mol_002\", \"mol_004\"],\n      \"outputs\": [\"mol_008\", \"mol_003\", \"mol_005\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"CuCN-derived cyanocuprate photoredox species\", \"Phosphate buffer\"],\n      \"conditions\": {\n        \"temperature\": \"300-310 K, proposed operating window\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": \"CuCN-derived copper photoredox system\",\n        \"aqueous\": true,\n        \"other\": \"Reported reference mixture: glycolonitrile 10 mM, H2S 30 mM, phosphate 33 mM at pH 7, solid CuCN at 10 mol%, and 254 nm UV. Proposed time-course window: 1-24 h; an irradiation duration or solar-equivalent fluence is not established here. Characterize dissolved copper, precipitated copper and sulfur speciation rather than assuming constant catalyst loading.\"\n      },\n      \"mechanism\": \"Photochemical reduction of the nitrile gives an imine-level intermediate whose hydrolysis yields glycolaldehyde and ammonia.\",\n      \"reasoning\": \"This is directly grounded in the glycolonitrile experiments summarized in the supplied report (Ritson and Sutherland, 2013), and is incorporated in the later systems network (Patel et al., 2015). S8 is only an electron-balance endpoint; actual sulfur products need analytical resolution. Laboratory catalyst loading does not establish a naturally available dissolved copper concentration.\"\n    },\n    {\n      \"id\": \"rxn_004\",\n      \"name\": \"Net photochemical reductive deoxygenation of glycolaldehyde\",\n      \"inputs\": [\"mol_008\", \"mol_002\"],\n      \"outputs\": [\"mol_009\", \"mol_004\", \"mol_005\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"CuCN-derived copper photoredox species\"],\n      \"conditions\": {\n        \"temperature\": \"300-310 K\",\n        \"pressure\": \"Approximately 1 atm in a vapor-retaining illuminated compartment\",\n        \"catalyst\": \"Copper-cyanide photoredox system\",\n        \"aqueous\": true,\n        \"other\": \"Proposed pH approximately 7 with millimolar glycolaldehyde, sulfide in reducing excess and 254 nm irradiation. Screen over 1-24 h rather than assigning an unsupported conversion. Trap acetaldehyde promptly in rxn_005. Transfer of this crude photolysate into copper(II)-glycinate chemistry is not permitted without a separately demonstrated cyanide/sulfide removal process.\"\n      },\n      \"mechanism\": \"A lumped photoredox deoxygenation module converts the hydroxy-substituted aldehyde to acetaldehyde; water is the formal oxygen-containing coproduct.\",\n      \"reasoning\": \"Acetaldehyde supply from glycolaldehyde reduction is part of the cyanosulfidic precursor network described in the research (Patel et al., 2015). This assignment is not an elementary mechanism or a claim of selective acetaldehyde production. Volatility, competing reduction and condensation make recoverable acetaldehyde a bottleneck. P3-P8 therefore use an independently supplied acetaldehyde boundary pool, not assumed clean output from this reaction.\"\n    },\n    {\n      \"id\": \"rxn_005\",\n      \"name\": \"Acetaldehyde capture as lactonitrile\",\n      \"inputs\": [\"mol_009\", \"mol_001\"],\n      \"outputs\": [\"mol_010\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-310 K\",\n        \"pressure\": \"Approximately 1 atm with restricted gas exchange\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Proposed pH 7-9, millimolar acetaldehyde and total cyanide, and equilibration over minutes to hours. Keep the solution cool and avoid prolonged strongly alkaline storage, which favors acetaldehyde self-condensation.\"\n      },\n      \"mechanism\": \"Cyanide addition to acetaldehyde produces racemic 2-hydroxypropanenitrile.\",\n      \"reasoning\": \"Lactonitrile is the experimentally used precursor of lactaldehyde in the designed threonine route (Ritson and Sutherland, 2013; Patel et al., 2015). Cyanohydrin formation is chemically justified without a mineral catalyst. The reaction does not introduce enantioselectivity, and the equilibrium must compete with aldehyde volatilization.\"\n    },\n    {\n      \"id\": \"rxn_006\",\n      \"name\": \"Lactonitrile photoreduction to lactaldehyde\",\n      \"inputs\": [\"mol_010\", \"mol_002\", \"mol_004\"],\n      \"outputs\": [\"mol_011\", \"mol_003\", \"mol_005\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"CuCN-derived cyanocuprate photoredox species\", \"Phosphate buffer\"],\n      \"conditions\": {\n        \"temperature\": \"300-310 K, proposed near-room-temperature window\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": \"CuCN-derived copper photoredox system\",\n        \"aqueous\": true,\n        \"other\": \"254 nm irradiation, approximately neutral phosphate-buffered water and a sulfide reductant. The 10 mM substrate, 30 mM sulfide, 33 mM phosphate and 10 mol% CuCN mixture is a reference screening composition, not an independently verified optimal lactonitrile protocol. Follow substrate disappearance and lactaldehyde appearance; stop or trap the aldehyde before secondary photochemistry dominates.\"\n      },\n      \"mechanism\": \"Nitrile reduction followed by imine hydrolysis converts lactonitrile to lactaldehyde and ammonia.\",\n      \"reasoning\": \"Lactaldehyde was reported in 19% yield from lactonitrile under the photoreduction chemistry (Ritson and Sutherland, 2013). This is direct support for the crucial C3 aldehyde, but 19% is not a threonine yield and cannot be multiplied through unspecified downstream conversions. Catalyst precipitation, sulfur speciation and aldehyde survival remain integration measurements rather than established efficiencies (Patel et al., 2015; Ranjan et al., 2018).\"\n    },\n    {\n      \"id\": \"rxn_007\",\n      \"name\": \"Lactaldehyde Strecker aminonitrile formation\",\n      \"inputs\": [\"mol_011\", \"mol_001\", \"mol_003\"],\n      \"outputs\": [\"mol_012\", \"mol_004\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-320 K\",\n        \"pressure\": \"Approximately 1 atm with limited volatile loss\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Proposed pH 8-9, millimolar lactaldehyde and cyanide, and ammonia in excess. Screen over 1-24 h. Stop irradiation during aminonitrile accumulation. Before subsequent acidification, characterize residual cyanide, sulfide and copper; settling removes particles but does not establish removal of dissolved complexes.\"\n      },\n      \"mechanism\": \"Ammonia forms a reversible imine with lactaldehyde, and cyanide addition produces 2-amino-3-hydroxybutanenitrile.\",\n      \"reasoning\": \"The supplied research reports smooth conversion of lactaldehyde to the corresponding aminonitrile after adding HCN and ammonia (Ritson and Sutherland, 2013), with the precursor included in Patel et al. (2015). No numerical aminonitrile yield or threo:allo ratio was reported. The unresolved intermediate node therefore carries no stereochemical yield assumption.\"\n    },\n    {\n      \"id\": \"rxn_008\",\n      \"name\": \"Proposed acidic hydration of the threonine aminonitrile\",\n      \"inputs\": [\"mol_012\", \"mol_004\"],\n      \"outputs\": [\"mol_013\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Acidic aqueous medium supplied by hydrogen chloride\"],\n      \"conditions\": {\n        \"temperature\": \"353-370 K, proposed screening range\",\n        \"pressure\": \"Approximately 1 atm, below bulk boiling\",\n        \"catalyst\": \"Hydrogen ions\",\n        \"aqueous\": true,\n        \"other\": \"Proposed pH 1-2 and 1-30 days in a separate dark acidic compartment. These are candidate conditions, not a reported threonine-aminonitrile protocol. Begin only after the photolysate has been characterized and a tolerable precursor recovery established. Monitor amide, amino acid, retro-aldol products and total carbon recovery.\"\n      },\n      \"mechanism\": \"Acid activation of the nitrile permits water addition and tautomerization to the carboxamide.\",\n      \"reasoning\": \"Speculative target-specific completion step. The provided experiments stop at the aminonitrile and do not demonstrate its hydration under this environmental window (Ritson and Sutherland, 2013; Patel et al., 2015). Ordinary nitrile chemistry justifies testing the transformation, but it does not establish a rate or recovered yield for this beta-hydroxy substrate.\"\n    },\n    {\n      \"id\": \"rxn_009\",\n      \"name\": \"Proposed acidic amide hydrolysis to threonine and allothreonine salts\",\n      \"inputs\": [\"mol_013\", \"mol_004\", \"mol_023\"],\n      \"outputs\": [\"mol_028\", \"mol_029\", \"mol_038\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"353-370 K, proposed screening range\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": \"Acid-promoted hydrolysis; hydrogen chloride also supplies product counterions\",\n        \"aqueous\": true,\n        \"other\": \"Proposed pH 0.5-1.5 and time-course sampling over 1-30 days. Hydrogen chloride is included as a consumed reagent because amino-acid hydrochlorides and ammonium chloride are explicitly represented. Cool immediately after net amino-acid accumulation peaks. No completion time or survival fraction is established.\"\n      },\n      \"mechanism\": \"Water attacks the activated amide; carbon-nitrogen bond cleavage gives the amino acid and ammonia, represented as their chloride salts in strongly acidic solution.\",\n      \"reasoning\": \"Speculative target-specific hydrolysis. The supplied Strecker literature establishes precursor connectivity but not free-threonine yield, product survival or diastereomer distribution after hydrolysis (Ritson and Sutherland, 2013; Patel et al., 2015). Listing both stereoisomer salts does not assert equal yields. Hydrolysis must outcompete decomposition, and acid availability at the proposed concentration is a separate geochemical requirement.\"\n    },\n    {\n      \"id\": \"rxn_010\",\n      \"name\": \"Recovery of free threonine from its hydrochloride\",\n      \"inputs\": [\"mol_028\", \"mol_034\"],\n      \"outputs\": [\"mol_014\", \"mol_035\", \"mol_004\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-310 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Mix acid product water with a separately available alkaline stream to reach pH 5-6; NaOH represents its sodium-associated hydroxide equivalents, not a presumed deposit of pure caustic. Neutralization takes minutes to hours. For copper-derived material, perform rxn_026 and physical solid separation first. A proposed acceptance gate is dissolved copper below 0.01 mol per mol total amino acids, together with a measured free-threonine fraction. Store under opaque cover.\"\n      },\n      \"mechanism\": \"One equivalent of base removes the excess acid proton, leaving predominantly zwitterionic threonine near pH 5-6.\",\n      \"reasoning\": \"Speculative environmental workup, although the acid-base transformation itself is routine. Neither the cyanosulfidic reports nor the preparative aldol result establishes this integrated recovery operation (Ritson and Sutherland, 2013; Sato, Okawa and Akabori, 1957). Neutralization is not a chiral separation and does not remove copper by itself. The defined metal-removal gate prevents acid dissociation from being misrepresented as metal-free product isolation.\"\n    },\n    {\n      \"id\": \"rxn_011\",\n      \"name\": \"Recovery of free allothreonine from its hydrochloride\",\n      \"inputs\": [\"mol_029\", \"mol_034\"],\n      \"outputs\": [\"mol_015\", \"mol_035\", \"mol_004\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-310 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"The same pH 5-6 neutralization and prior copper-removal requirements as rxn_010 apply. Resolve threonine and allothreonine analytically rather than assigning the entire recovered beta-hydroxy amino-acid pool to the target.\"\n      },\n      \"mechanism\": \"Neutralization of the hydrochloride produces the predominantly zwitterionic allothreonine pool.\",\n      \"reasoning\": \"Speculative environmental workup included to preserve explicit diastereomer accounting. Nonselective formation of both threonine and allothreonine is consistent with the discharge and aldol evidence (Ring et al., 1972; Sato, Okawa and Akabori, 1957). This operation does not convert allothreonine into threonine.\"\n    },\n    {\n      \"id\": \"rxn_012\",\n      \"name\": \"Proposed alkaline hydration of the threonine aminonitrile\",\n      \"inputs\": [\"mol_012\", \"mol_004\"],\n      \"outputs\": [\"mol_013\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Hydroxide ions supplied by an alkaline aqueous stream\"],\n      \"conditions\": {\n        \"temperature\": \"333-370 K, proposed screening range\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": \"Hydroxide ions\",\n        \"aqueous\": true,\n        \"other\": \"Proposed pH 11.5-12.5, quoted for a cooled approximately 300 K aliquot, and 1-30 days of time-course sampling. This requires unusually alkaline surface water and is not interchangeable with the neutral photochemical compartment. Keep the solution dark and monitor carbon-skeleton cleavage as well as nitrile disappearance.\"\n      },\n      \"mechanism\": \"Hydroxide addition to the nitrile and subsequent proton transfers produce the amide.\",\n      \"reasoning\": \"Speculative alternative completion chemistry, not a second experimentally demonstrated threonine synthesis. The supplied cyanosulfidic studies do not validate alkaline hydrolysis of this aminonitrile (Ritson and Sutherland, 2013; Patel et al., 2015). Base may promote unwanted decomposition and stereochemical redistribution, so conversion cannot be inferred from a generic nitrile-hydrolysis mechanism.\"\n    },\n    {\n      \"id\": \"rxn_013\",\n      \"name\": \"Proposed alkaline amide hydrolysis to amino-acid carboxylates\",\n      \"inputs\": [\"mol_013\", \"mol_034\"],\n      \"outputs\": [\"mol_036\", \"mol_037\", \"mol_003\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"333-370 K, proposed screening range\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Maintain proposed cooled-aliquot pH 11.5-12.5 while measuring base consumption. Hydroxide is a stoichiometric reagent in the represented amide-to-carboxylate transformation. Screen over 1-30 days and terminate if amino-acid destruction exceeds production. Product ratios must be measured.\"\n      },\n      \"mechanism\": \"Nucleophilic acyl substitution converts the amide to its carboxylate salt and releases ammonia.\",\n      \"reasoning\": \"Speculative target-specific step. The atom-balanced transformation is chemically reasonable, but the provided research contains no validated alkaline completion yield for this substrate pool (Ritson and Sutherland, 2013; Patel et al., 2015). Threonine's known cleavage and epimerization chemistry makes prolonged strong-base exposure an uncertain tradeoff rather than an established solution (Schroeder and Bada, 1977).\"\n    },\n    {\n      \"id\": \"rxn_014\",\n      \"name\": \"Protonation of sodium threoninate to recover threonine\",\n      \"inputs\": [\"mol_036\", \"mol_023\"],\n      \"outputs\": [\"mol_014\", \"mol_035\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-310 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Cool first, then mix with acidic chloride-bearing water to reach pH 5-6 without prolonged residence at extreme pH. Allow minutes to hours for equilibration and place the product in a shaded compartment. Quantify surviving threonine rather than assuming complete recovery.\"\n      },\n      \"mechanism\": \"Protonation of the amino-acid anion gives the net-neutral, predominantly zwitterionic amino acid.\",\n      \"reasoning\": \"Speculative environmental workup based on ordinary acid-base chemistry. It completes the represented salt balance but does not validate the preceding hydrolysis or restore destroyed threonine (Ritson and Sutherland, 2013; Schroeder and Bada, 1977).\"\n    },\n    {\n      \"id\": \"rxn_015\",\n      \"name\": \"Protonation of sodium allothreoninate\",\n      \"inputs\": [\"mol_037\", \"mol_023\"],\n      \"outputs\": [\"mol_015\", \"mol_035\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-310 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Use the pH 5-6 recovery window of rxn_014. Determine the threonine/allothreonine ratio by a method that resolves the two diastereomeric pairs.\"\n      },\n      \"mechanism\": \"Acid-base equilibration converts the sodium salt to net-neutral allothreonine.\",\n      \"reasoning\": \"Speculative environmental workup; no new carbon-skeleton chemistry is claimed. Separate accounting is necessary because nonenzymatic routes produce allothreonine and subsequent processing can alter its abundance (Ring et al., 1972; Schroeder and Bada, 1977).\"\n    },\n    {\n      \"id\": \"rxn_016\",\n      \"name\": \"Formaldehyde Strecker formation of aminoacetonitrile\",\n      \"inputs\": [\"mol_006\", \"mol_001\", \"mol_003\"],\n      \"outputs\": [\"mol_016\", \"mol_004\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-320 K\",\n        \"pressure\": \"Approximately 1 atm with limited gas exchange\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Proposed pH 8-9, formaldehyde and total cyanide each 10-100 mM, and ammonia 10-200 mM. Sample over 1-24 h. This branch can begin with independently supplied formaldehyde and therefore does not require copper or sulfide photochemistry.\"\n      },\n      \"mechanism\": \"Formaldehyde and ammonia form imine-like intermediates that undergo cyanide addition to aminoacetonitrile.\",\n      \"reasoning\": \"Glycine aminonitrile is a supported product of the HCN/aldehyde/ammonia network (Patel et al., 2015). The proposed concentration window is not presented as a measured optimum. Using formaldehyde as a small-molecule boundary feedstock avoids attributing an unmeasured aldehyde inventory to a particular spark experiment.\"\n    },\n    {\n      \"id\": \"rxn_017\",\n      \"name\": \"Acidic aminoacetonitrile hydrolysis to glycine hydrochloride\",\n      \"inputs\": [\"mol_016\", \"mol_004\", \"mol_023\"],\n      \"outputs\": [\"mol_039\", \"mol_038\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"353-370 K, proposed environmental window\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": \"Acid-promoted hydrolysis; hydrochloric acid also supplies salt counterions\",\n        \"aqueous\": true,\n        \"other\": \"Proposed pH 0.5-1.5 and 1-30 days, with nitrile and amide intermediates followed analytically. The amide stage is lumped into this net module. Residual cyanide must be characterized before acidic processing. Ammonium chloride remains in solution and is not assumed to disappear during glycine recovery.\"\n      },\n      \"mechanism\": \"Nitrile hydration and subsequent amide hydrolysis give glycine and ammonia, represented as hydrochloride and ammonium salts.\",\n      \"reasoning\": \"General Strecker chemistry supports this glycine supply route, and aminoacetonitrile is part of the cited prebiotic network (Patel et al., 2015). The particular mild-temperature residence window is a speculative environmental implementation, not a glycine yield reported by that paper. Glycine is less structurally fragile than threonine, but mixture compatibility with the later copper reaction still requires testing.\"\n    },\n    {\n      \"id\": \"rxn_018\",\n      \"name\": \"Neutralization and conditioning of glycine hydrochloride\",\n      \"inputs\": [\"mol_039\", \"mol_034\"],\n      \"outputs\": [\"mol_017\", \"mol_035\", \"mol_004\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-310 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"First neutralize to pH 6-8. Before copper addition, characterize cyanide, sulfide, ammonia, hydroxylamine and dissolved metals. Ammonia-rich solutions may require a separate alkaline degassing interval followed by pH readjustment; quantitative ammonia removal is not assumed. Iron-derived material must also pass rxn_022 and particle separation.\"\n      },\n      \"mechanism\": \"Base neutralization yields predominantly zwitterionic glycine.\",\n      \"reasoning\": \"Speculative integration workup based on ordinary acid-base chemistry. Glycine availability alone does not establish that a Strecker or iron-reduction mixture is compatible with copper-glycinate aldol chemistry (Patel et al., 2015; Muchowska et al., 2019; Sato, Okawa and Akabori, 1957). In particular, ammonia can alter copper ligation and hydroxylamine can alter copper oxidation state.\"\n    },\n    {\n      \"id\": \"rxn_019\",\n      \"name\": \"Nickel-catalyzed reductive amination of glyoxylic acid to glycine\",\n      \"inputs\": [\"mol_018\", \"mol_003\", \"mol_019\"],\n      \"outputs\": [\"mol_017\", \"mol_004\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\"Nickel supported on silica-alumina\"],\n      \"conditions\": {\n        \"temperature\": \"295 K, corresponding to the reported 22 degrees Celsius\",\n        \"pressure\": \"Hydrogen partial pressure approximately 5 bar\",\n        \"catalyst\": \"Ni/SiO2-Al2O3 laboratory catalyst\",\n        \"aqueous\": true,\n        \"other\": \"Reported reference conditions include pH 8 and 5 bar H2. Proposed screening feed: glyoxylate 1-10 mM and total ammonia/ammonium 10-100 mM, monitored over 24-72 h; these concentrations and residence times are not assigned reported glycine yields. Physically, this requires a confined cool water-rock cavity or a laboratory analogue, not an open ambient-pressure pool. Retain catalyst particles upstream, depressurize without admitting oxygen, and verify residual glyoxylate, nickel, reducing capacity and ammonia before copper-glycinate formation.\"\n      },\n      \"mechanism\": \"Metal-catalyzed hydrogenation of an imine/iminium intermediate formed from glyoxylate and ammonia produces glycine.\",\n      \"reasoning\": \"Glyoxylate reductive amination is supported by the metal/H2 study (Kaur et al., 2024), which used 5 bar H2, pH 8 and 22 degrees Celsius and examined low ammonium concentrations. This is glycine synthesis, not evidence for direct threonine reductive amination. The supported nickel material is a laboratory catalyst, not an asserted ubiquitous mineral, and its geochemical availability and successful handoff to copper chemistry remain conditional.\"\n    },\n    {\n      \"id\": \"rxn_020\",\n      \"name\": \"Formation of glyoxylic acid oxime\",\n      \"inputs\": [\"mol_018\", \"mol_020\"],\n      \"outputs\": [\"mol_021\", \"mol_004\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\"Mildly acidic aqueous medium\"],\n      \"conditions\": {\n        \"temperature\": \"300-323 K, proposed screening range\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": \"General acid catalysis\",\n        \"aqueous\": true,\n        \"other\": \"Proposed pH 3-6 and millimolar reactants, with hydroxylamine limiting and reaction progress followed over 1-24 h. No E/Z selectivity is assumed. Hydroxylamine supply is an explicit boundary assumption; it is not generated elsewhere in this network.\"\n      },\n      \"mechanism\": \"Hydroxylamine condenses with the aldehyde group of glyoxylic acid to form an oxime.\",\n      \"reasoning\": \"The hydroxylamine/iron amino-acid chemistry motivates this mechanistic decomposition (Muchowska et al., 2019). Isolation of this exact oxime stage under the stated conditions is a speculative representation rather than a reported result from that network. Limiting residual hydroxylamine matters because carryover can consume or reduce downstream copper(II).\"\n    },\n    {\n      \"id\": \"rxn_021\",\n      \"name\": \"Proposed native-iron reduction of glyoxylic acid oxime\",\n      \"inputs\": [\"mol_021\", \"mol_022\", \"mol_023\"],\n      \"outputs\": [\"mol_039\", \"mol_024\", \"mol_004\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"323-343 K, proposed screening range\",\n        \"pressure\": \"Approximately 1 atm with anoxic gas release\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Proposed acidic chloride medium, pH approximately 1.5-2.5, native iron in electron-equivalent excess, and 1-96 h time-course sampling. Iron is a consumed reductant, not a catalyst. Acid corrosion competes by producing H2. Remove residual Fe(0) particles before any copper addition, neutralize through rxn_018, and remove dissolved iron through rxn_022. Proceed only if residual hydroxylamine and reducing capacity are below experimentally established interference thresholds.\"\n      },\n      \"mechanism\": \"Four-electron reduction of the oxime cleaves its N-O bond and reduces C=N to the amino-acid skeleton. Iron is oxidized to iron(II), represented as neutral FeCl2 formula units.\",\n      \"reasoning\": \"Speculative isolated-step implementation motivated by iron/hydroxylamine amino-acid formation (Muchowska et al., 2019). The cited work does not establish this exact acidic oxime protocol or its recovery yield. The reaction is atom-balanceable with iron as a stoichiometric reductant; FeCl2 is used to avoid ambiguous ferrous-ion formula notation. Particle removal alone would not remove dissolved iron or hydroxylamine.\"\n    },\n    {\n      \"id\": \"rxn_022\",\n      \"name\": \"Precipitation of ferrous hydroxide before copper chemistry\",\n      \"inputs\": [\"mol_024\", \"mol_034\"],\n      \"outputs\": [\"mol_040\", \"mol_035\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-310 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Raise the cooled solution to pH approximately 8.5-9.5 under anoxia, then allow 1-24 h for settling or retention in a porous bed. Measure residual dissolved iron and glycine adsorbed to the precipitate. Glycine complexation can inhibit complete iron removal. This operation does not destroy residual hydroxylamine and is not a substitute for measuring it.\"\n      },\n      \"mechanism\": \"Hydroxide precipitates dissolved iron(II) as ferrous hydroxide without requiring molecular oxygen.\",\n      \"reasoning\": \"Speculative integration step based on standard iron(II) solubility chemistry. It specifically addresses carryover from the iron-mediated amino-acid module motivated by Muchowska et al. (2019); that paper does not establish the downstream separation and copper handoff. No quantitative purification or amino-acid recovery is assumed.\"\n    },\n    {\n      \"id\": \"rxn_023\",\n      \"name\": \"Formation of copper(II) bisglycinate\",\n      \"inputs\": [\"mol_017\", \"mol_025\", \"mol_034\"],\n      \"outputs\": [\"mol_026\", \"mol_035\", \"mol_004\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-313 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Proposed pH 8-9, copper 1-10 mM and glycine at least two equivalents per copper, preferably in excess. Add copper to glycine before increasing alkalinity to limit copper hydroxide precipitation. The copper is stoichiometrically represented in the complex. Accept only characterized feeds with low cyanide, sulfide, hydroxylamine and residual Fe(0); a screening limit of less than 0.01 equivalent of strong copper poisons per copper is proposed, not validated.\"\n      },\n      \"mechanism\": \"Glycinate binds copper(II) through nitrogen and carboxylate oxygen, forming the chelate used for alpha-carbon activation.\",\n      \"reasoning\": \"Copper glycinate is the relevant precursor in the experimentally demonstrated preparative aldol synthesis (Sato, Okawa and Akabori, 1957). Its availability at useful concentrations in an anoxic, sulfide-bearing, iron-rich environment is not established. A separately supplied chloride-bearing Cu(II) inventory is an explicit conditional input; no molecular oxygen is introduced or assumed to regenerate copper.\"\n    },\n    {\n      \"id\": \"rxn_024\",\n      \"name\": \"Copper-glycinate aldol addition to acetaldehyde\",\n      \"inputs\": [\"mol_026\", \"mol_009\"],\n      \"outputs\": [\"mol_027\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Hydroxide base promoter\"],\n      \"conditions\": {\n        \"temperature\": \"313-333 K, proposed preparative-analogue screening range\",\n        \"pressure\": \"Approximately 1 atm in a vapor-retaining aqueous compartment\",\n        \"catalyst\": \"Base promotion of stoichiometric copper-glycinate complexes\",\n        \"aqueous\": true,\n        \"other\": \"Proposed copper-glycinate concentration 5-20 mM, acetaldehyde 0.05-0.5 M, cooled-aliquot pH 10-12, and 1-24 h sampling. These are screening conditions, not a reconstruction of the reported 64% experiment. Acetaldehyde is independently supplied in P3-P8. Restrict volatilization, monitor acetaldehyde self-condensation, and release product before retro-aldol loss dominates.\"\n      },\n      \"mechanism\": \"Copper coordination facilitates glycine alpha-carbon deprotonation; the carbon nucleophile adds to acetaldehyde. The net node combines ligand additions into a formal bis-product complex.\",\n      \"reasoning\": \"Sato, Okawa and Akabori (1957) reported up to 64% combined threonine/allothreonine in preparative copper-glycinate chemistry. That result does not validate geochemical concentrations, the proposed conditions or untreated upstream mixtures. The represented bis-ligand complex is bookkeeping for a coordination pool that can also contain partially converted and mixed-ligand species. Diastereomer ratios are base- and time-dependent; neither 64% yield nor a fixed threo:allo ratio is assigned to this network.\"\n    },\n    {\n      \"id\": \"rxn_025\",\n      \"name\": \"Acid dissociation of copper-bound hydroxy amino acids\",\n      \"inputs\": [\"mol_027\", \"mol_023\"],\n      \"outputs\": [\"mol_028\", \"mol_029\", \"mol_025\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-310 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Proposed pH 0.5-1.5 for minutes to a few hours, sufficient to favor protonated amino-acid salts and dissociation of their copper complexes. Immediately follow with rxn_026 before neutralizing. Acidification alone neither removes copper nor guarantees complete decomplexation.\"\n      },\n      \"mechanism\": \"Ligand protonation weakens copper binding, transferring the amino acids into an acidic salt pool and copper into dissolved chloride-bearing species.\",\n      \"reasoning\": \"Speculative recovery step based on established coordination and acid-base chemistry. The cited preparative aldol result supports formation of the amino-acid skeleton, not this specific environmental isolation sequence (Sato, Okawa and Akabori, 1957). Unlike simple acid release followed by dilution, this pathway explicitly requires a subsequent copper-removal operation.\"\n    },\n    {\n      \"id\": \"rxn_026\",\n      \"name\": \"Copper removal from the acidic amino-acid fraction\",\n      \"inputs\": [\"mol_025\", \"mol_002\"],\n      \"outputs\": [\"mol_030\", \"mol_023\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-310 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Proposed pH 1-2, sulfide approximately 1-3 equivalents per dissolved copper, dark anoxic conditions, and 1-24 h settling or porous-bed retention. Separate the precipitate before rxn_010 and rxn_011. Measure residual copper and amino-acid adsorption losses. CuS is a formal endpoint; actual sulfide solids can have variable stoichiometry and electronic structure.\"\n      },\n      \"mechanism\": \"Formation of a poorly soluble copper sulfide phase removes dissolved copper and releases acid into the remaining amino-acid solution.\",\n      \"reasoning\": \"Speculative integration step based on standard copper-sulfide precipitation chemistry. Neither Sato, Okawa and Akabori (1957) nor the supplied cyanosulfidic studies demonstrate quantitative threonine recovery through this operation. It provides a chemically explicit removal mechanism, but adsorption, colloid passage, residual copper and sulfide demand must be measured. Copper is consumed into a sink rather than assumed catalytically recycled.\"\n    },\n    {\n      \"id\": \"rxn_027\",\n      \"name\": \"Direct sulfide-driven release from copper-bound hydroxy amino acids\",\n      \"inputs\": [\"mol_027\", \"mol_002\"],\n      \"outputs\": [\"mol_014\", \"mol_015\", \"mol_030\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-310 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Proposed pH 5-7, sulfide approximately 1-3 equivalents per copper, and 1-24 h in a dark anoxic compartment. Separate copper-sulfide solids and assay free amino acid, dissolved copper and adsorbed product. Keep sulfide away from the upstream Cu(II)-glycinate reaction; addition occurs only after aldol formation.\"\n      },\n      \"mechanism\": \"Copper-sulfide precipitation displaces the amino-acid ligands while sulfide-associated proton transfer gives net-neutral threonine and allothreonine.\",\n      \"reasoning\": \"Speculative product-release alternative to acid dissociation followed by copper scavenging. Strong copper-sulfide formation makes the displacement chemically credible, but the supplied aldol study does not establish its yield or environmental operation (Sato, Okawa and Akabori, 1957). This is a genuinely different workup sequence, not a new carbon-skeleton synthesis mechanism. It consumes the copper inventory.\"\n    },\n    {\n      \"id\": \"rxn_028\",\n      \"name\": \"Reducing methane-nitrogen discharge inventory with conditional acidic recovery\",\n      \"inputs\": [\"mol_031\", \"mol_032\", \"mol_003\", \"mol_004\", \"mol_023\"],\n      \"outputs\": [\"mol_028\", \"mol_029\", \"mol_039\", \"mol_019\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-330 K proposed bulk collector; 353-370 K proposed subsequent recovery\",\n        \"pressure\": \"Approximately 1 atm in the proposed analogue\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Methane/nitrogen/water discharge with trace ammonia, following the reported reducing-gas framework. Proposed discharge exposure: 1-3 days; the plasma is not at the collector temperature. The represented recovery uses added HCl at pH 1-2 for 1-30 days, followed by rxn_010 and rxn_011. This mild recovery is a proposed environmental substitute, not a claim to reproduce the original analytical hydrolysis. Determine free and hydrolysis-released fractions separately.\"\n      },\n      \"mechanism\": \"An empirical net inventory module for radical gas chemistry, aqueous capture and hydrolysis-dependent recovery. No unique aldehyde or aminonitrile mechanism is assigned.\",\n      \"reasoning\": \"Threonine and allothreonine were detected in reducing discharge products (Ring et al., 1972), with low relative abundance summarized by Weber and Miller (1981). The reported approximately equal threo/allo abundance is qualitative support for nonselectivity, not a stoichiometric requirement. This node does not claim measured delivery of acetaldehyde or lactaldehyde. Detection supports the inventory, whereas completion under the proposed lower-temperature recovery conditions remains speculative. The equation is an atom-balanceable projection of a much larger product mixture, not an exclusive reaction or yield model.\"\n    },\n    {\n      \"id\": \"rxn_029\",\n      \"name\": \"Hydrogen-sulfide-rich discharge inventory with conditional acidic recovery\",\n      \"inputs\": [\"mol_031\", \"mol_002\", \"mol_003\", \"mol_033\", \"mol_004\", \"mol_023\"],\n      \"outputs\": [\"mol_028\", \"mol_039\", \"mol_019\", \"mol_005\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-330 K proposed bulk collector; 353-370 K proposed subsequent recovery\",\n        \"pressure\": \"Reported charged-gas partial pressures total 695 mmHg before accounting for water vapor\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Reported 1958 charge: CH4 258 mmHg, H2S 100 mmHg, NH3 250 mmHg and CO2 87 mmHg; spark exposure 3 days. Sulfur deposition on tungsten electrodes was observed and its chemical influence remains unresolved. The graph's acidic recovery at pH 1-2 for 1-30 days is proposed, not the archived analytical protocol. Use blanks and diastereomer-resolving mass spectrometry, and distinguish free from hydrolysable product.\"\n      },\n      \"mechanism\": \"An empirical module for sulfur-influenced discharge chemistry, capture of a complex organic inventory and conditional recovery of threonine as an acid salt.\",\n      \"reasoning\": \"Threonine was reported in the H2S-rich archived experiment and not in the other reanalyzed Miller experiment types discussed in the supplied research (Parker et al., 2011). A separately quantified allothreonine inventory is not assigned to this experiment. Sulfur and H2 outputs are formal bookkeeping endpoints, not a complete measured product distribution. Electrode effects, contamination controls and the analytical-hydrolysis distinction limit interpretation. Environmental free-threonine recovery through the proposed milder workup remains speculative.\"\n    },\n    {\n      \"id\": \"rxn_030\",\n      \"name\": \"Hydrothermal retro-aldol destruction of threonine\",\n      \"inputs\": [\"mol_014\"],\n      \"outputs\": [\"mol_017\", \"mol_009\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"394-433 K\",\n        \"pressure\": \"10-100 bar or greater, sufficient to maintain liquid water\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Represents accidental transport into warm subsurface or hydrothermal water, not an intended synthesis stage. Follow decomposition over hours to days as appropriate to measured kinetics. No extrapolated room-temperature lifetime is treated as an observation. Intended accumulation instead occurs below approximately 323 K in shaded surface water.\"\n      },\n      \"mechanism\": \"Cleavage of the alpha-beta carbon-carbon bond regenerates glycine and acetaldehyde through retro-aldol chemistry.\",\n      \"reasoning\": \"Threonine decomposition and epimerization are established limitations, and high-temperature amino-acid survival is problematic (Schroeder and Bada, 1977; Aubrey, Cleaves and Bada, 2009). This reaction is an atom-balanced degradation sink and is not counted among the ten target-producing schedules. It does not imply that hydrothermal systems have demonstrated threonine synthesis.\"\n    }\n  ],\n  \"pathways\": [\n    {\n      \"pathway_id\": \"P1\",\n      \"name\": \"HCN homologation followed by acidic Strecker completion\",\n      \"description\": \"Conditional designed synthesis from HCN, sulfide, ammonia and water through the documented lactaldehyde/aminonitrile sequence. Acidic nitrile and amide hydrolysis are proposed completion steps, followed by explicit salt neutralization. The 19% literature result applies only to lactaldehyde formation. Product survival, photolysate conditioning and free-threonine yield remain unvalidated.\",\n      \"reaction_sequence\": [\n        \"rxn_001\",\n        \"rxn_002\",\n        \"rxn_003\",\n        \"rxn_004\",\n        \"rxn_005\",\n        \"rxn_006\",\n        \"rxn_007\",\n        \"rxn_008\",\n        \"rxn_009\",\n        \"rxn_010\",\n        \"rxn_011\"\n      ],\n      \"key_intermediates\": [\n        \"mol_007\",\n        \"mol_008\",\n        \"mol_009\",\n        \"mol_010\",\n        \"mol_011\",\n        \"mol_012\",\n        \"mol_013\",\n        \"mol_028\"\n      ]\n    },\n    {\n      \"pathway_id\": \"P2\",\n      \"name\": \"HCN homologation followed by alkaline Strecker completion\",\n      \"description\": \"Shares the supported carbon-skeleton construction of P1 but uses hydroxide-promoted nitrile hydration, stoichiometric amide hydrolysis and subsequent protonation of amino-acid carboxylates. This is an alternative reaction schedule, not independent evidence for precursor formation. Alkaline completion and product survival require target-specific validation.\",\n      \"reaction_sequence\": [\n        \"rxn_001\",\n        \"rxn_002\",\n        \"rxn_003\",\n        \"rxn_004\",\n        \"rxn_005\",\n        \"rxn_006\",\n        \"rxn_007\",\n        \"rxn_012\",\n        \"rxn_013\",\n        \"rxn_014\",\n        \"rxn_015\"\n      ],\n      \"key_intermediates\": [\n        \"mol_010\",\n        \"mol_011\",\n        \"mol_012\",\n        \"mol_013\",\n        \"mol_036\",\n        \"mol_037\"\n      ]\n    },\n    {\n      \"pathway_id\": \"P3\",\n      \"name\": \"Strecker glycine plus copper aldol with acid-assisted copper removal\",\n      \"description\": \"Begins with independently supplied formaldehyde and acetaldehyde. Glycine is prepared through aminoacetonitrile, conditioned, chelated to copper and added to acetaldehyde. Acid dissociation is followed by copper-sulfide precipitation, physical solid separation and neutralization. Neither crude Strecker-mixture compatibility nor quantitative amino-acid recovery is assumed.\",\n      \"reaction_sequence\": [\n        \"rxn_016\",\n        \"rxn_017\",\n        \"rxn_018\",\n        \"rxn_023\",\n        \"rxn_024\",\n        \"rxn_025\",\n        \"rxn_026\",\n        \"rxn_010\",\n        \"rxn_011\"\n      ],\n      \"key_intermediates\": [\n        \"mol_016\",\n        \"mol_039\",\n        \"mol_017\",\n        \"mol_026\",\n        \"mol_027\",\n        \"mol_028\"\n      ]\n    },\n    {\n      \"pathway_id\": \"P4\",\n      \"name\": \"Strecker glycine plus copper aldol with direct sulfide release\",\n      \"description\": \"Uses the same small-molecule boundary feeds and glycine construction as P3, but releases the amino acids directly from their copper complexes by sulfide precipitation near neutral pH. This avoids the strongly acidic product-release interval but still requires measured copper removal, adsorption recovery and control of upstream cyanide/ammonia carryover.\",\n      \"reaction_sequence\": [\n        \"rxn_016\",\n        \"rxn_017\",\n        \"rxn_018\",\n        \"rxn_023\",\n        \"rxn_024\",\n        \"rxn_027\"\n      ],\n      \"key_intermediates\": [\n        \"mol_016\",\n        \"mol_017\",\n        \"mol_026\",\n        \"mol_027\"\n      ]\n    },\n    {\n      \"pathway_id\": \"P5\",\n      \"name\": \"Nickel-hydrogen glycine supply with acid-assisted aldol recovery\",\n      \"description\": \"Glyoxylic acid undergoes nickel/H2 reductive amination before copper-glycinate aldol reaction with independently supplied acetaldehyde. Catalyst retention, anoxic depressurization and characterization of residual ammonia, glyoxylate and nickel are mandatory handoff gates. Acid release is followed by actual copper precipitation rather than assumed purification by dilution.\",\n      \"reaction_sequence\": [\n        \"rxn_019\",\n        \"rxn_023\",\n        \"rxn_024\",\n        \"rxn_025\",\n        \"rxn_026\",\n        \"rxn_010\",\n        \"rxn_011\"\n      ],\n      \"key_intermediates\": [\n        \"mol_017\",\n        \"mol_026\",\n        \"mol_027\",\n        \"mol_028\"\n      ]\n    },\n    {\n      \"pathway_id\": \"P6\",\n      \"name\": \"Nickel-hydrogen glycine supply with direct sulfide aldol recovery\",\n      \"description\": \"Uses the experimentally supported glyoxylate reductive-amination module as a glycine source, not as direct threonine synthesis. The downstream copper aldol uses an independent acetaldehyde pool and direct sulfide-driven ligand release. Maintaining 5 bar H2, obtaining the supported nickel catalyst and integrating the two metal chemistries remain conditional.\",\n      \"reaction_sequence\": [\n        \"rxn_019\",\n        \"rxn_023\",\n        \"rxn_024\",\n        \"rxn_027\"\n      ],\n      \"key_intermediates\": [\n        \"mol_017\",\n        \"mol_026\",\n        \"mol_027\"\n      ]\n    },\n    {\n      \"pathway_id\": \"P7\",\n      \"name\": \"Oxime-iron glycine supply with acid-assisted aldol recovery\",\n      \"description\": \"Glyoxylic acid and hydroxylamine form an oxime, which is reduced by consumed native iron. Glycine neutralization, ferrous-hydroxide precipitation and physical solid removal precede copper chelation and acetaldehyde addition. Residual hydroxylamine and Fe(0) must be excluded before copper addition. Final acid dissociation, copper-sulfide precipitation and neutralization provide an explicit but unvalidated free-product recovery sequence.\",\n      \"reaction_sequence\": [\n        \"rxn_020\",\n        \"rxn_021\",\n        \"rxn_018\",\n        \"rxn_022\",\n        \"rxn_023\",\n        \"rxn_024\",\n        \"rxn_025\",\n        \"rxn_026\",\n        \"rxn_010\",\n        \"rxn_011\"\n      ],\n      \"key_intermediates\": [\n        \"mol_021\",\n        \"mol_039\",\n        \"mol_017\",\n        \"mol_026\",\n        \"mol_027\",\n        \"mol_028\"\n      ]\n    },\n    {\n      \"pathway_id\": \"P8\",\n      \"name\": \"Oxime-iron glycine supply with direct sulfide aldol recovery\",\n      \"description\": \"Uses the same proposed oxime/iron glycine supply and explicit iron-removal gate as P7, followed by copper-glycinate aldol chemistry and direct sulfide release. The distinct terminal workup avoids acid dissociation but does not solve hydroxylamine supply, iron-mixture compatibility or product adsorption without measurements.\",\n      \"reaction_sequence\": [\n        \"rxn_020\",\n        \"rxn_021\",\n        \"rxn_018\",\n        \"rxn_022\",\n        \"rxn_023\",\n        \"rxn_024\",\n        \"rxn_027\"\n      ],\n      \"key_intermediates\": [\n        \"mol_021\",\n        \"mol_039\",\n        \"mol_017\",\n        \"mol_026\",\n        \"mol_027\"\n      ]\n    },\n    {\n      \"pathway_id\": \"P9\",\n      \"name\": \"Sulfur-free reducing-discharge inventory and conditional recovery\",\n      \"description\": \"Empirical benchmark based on threonine and allothreonine detection in methane/nitrogen/water discharge chemistry. The graph does not infer an unmeasured aldehyde delivery pathway. Its proposed lower-temperature acidic recovery and subsequent neutralization make free-target completion conditional rather than an established environmentally integrated synthesis.\",\n      \"reaction_sequence\": [\n        \"rxn_028\",\n        \"rxn_010\",\n        \"rxn_011\"\n      ],\n      \"key_intermediates\": [\n        \"mol_028\",\n        \"mol_029\"\n      ]\n    },\n    {\n      \"pathway_id\": \"P10\",\n      \"name\": \"H2S-rich reducing-discharge inventory and conditional recovery\",\n      \"description\": \"Empirical benchmark using the reported H2S-rich Miller gas charge and three-day discharge. Threonine detection is supported, but a separate allothreonine inventory is not invented. Sulfur-electrode effects, analytical hydrolysis, contamination controls and recovery under the proposed milder conditions remain explicit limitations.\",\n      \"reaction_sequence\": [\n        \"rxn_029\",\n        \"rxn_010\"\n      ],\n      \"key_intermediates\": [\n        \"mol_028\"\n      ]\n    }\n  ],\n  \"hub_molecules\": [\n    \"mol_001\",\n    \"mol_006\",\n    \"mol_009\",\n    \"mol_012\",\n    \"mol_013\",\n    \"mol_014\",\n    \"mol_017\",\n    \"mol_025\",\n    \"mol_027\",\n    \"mol_028\",\n    \"mol_029\",\n    \"mol_039\"\n  ],\n  \"convergence_points\": [\n    {\n      \"molecule_id\": \"mol_009\",\n      \"incoming_reactions\": [\"rxn_004\", \"rxn_030\"],\n      \"outgoing_reactions\": [\"rxn_005\", \"rxn_024\"]\n    },\n    {\n      \"molecule_id\": \"mol_012\",\n      \"incoming_reactions\": [\"rxn_007\"],\n      \"outgoing_reactions\": [\"rxn_008\", \"rxn_012\"]\n    },\n    {\n      \"molecule_id\": \"mol_013\",\n      \"incoming_reactions\": [\"rxn_008\", \"rxn_012\"],\n      \"outgoing_reactions\": [\"rxn_009\", \"rxn_013\"]\n    },\n    {\n      \"molecule_id\": \"mol_017\",\n      \"incoming_reactions\": [\"rxn_018\", \"rxn_019\", \"rxn_030\"],\n      \"outgoing_reactions\": [\"rxn_023\"]\n    },\n    {\n      \"molecule_id\": \"mol_025\",\n      \"incoming_reactions\": [\"rxn_025\"],\n      \"outgoing_reactions\": [\"rxn_023\", \"rxn_026\"]\n    },\n    {\n      \"molecule_id\": \"mol_027\",\n      \"incoming_reactions\": [\"rxn_024\"],\n      \"outgoing_reactions\": [\"rxn_025\", \"rxn_027\"]\n    },\n    {\n      \"molecule_id\": \"mol_028\",\n      \"incoming_reactions\": [\"rxn_009\", \"rxn_025\", \"rxn_028\", \"rxn_029\"],\n      \"outgoing_reactions\": [\"rxn_010\"]\n    },\n    {\n      \"molecule_id\": \"mol_029\",\n      \"incoming_reactions\": [\"rxn_009\", \"rxn_025\", \"rxn_028\"],\n      \"outgoing_reactions\": [\"rxn_011\"]\n    },\n    {\n      \"molecule_id\": \"mol_039\",\n      \"incoming_reactions\": [\"rxn_017\", \"rxn_021\", \"rxn_028\", \"rxn_029\"],\n      \"outgoing_reactions\": [\"rxn_018\"]\n    },\n    {\n      \"molecule_id\": \"mol_014\",\n      \"incoming_reactions\": [\"rxn_010\", \"rxn_014\", \"rxn_027\"],\n      \"outgoing_reactions\": [\"rxn_030\"]\n    }\n  ]\n}", "parsed_response": {"target_molecule": "Threonine, represented as racemic threo-threonine rather than selectively L-threonine", "overall_strategy": "This evidence-qualified network contains 40 molecule nodes, 30 reaction nodes and 10 distinct reaction schedules. These are not ten independently demonstrated prebiotic syntheses: P1-P2 are cyanosulfidic/Strecker routes with unvalidated target-specific hydrolysis; P3-P8 combine three glycine sources with preparative copper-glycinate aldol chemistry and two different product-release sequences; P9-P10 represent experimentally observed discharge inventories with explicitly conditional environmental recovery. Formaldehyde, acetaldehyde and glyoxylic acid are permissible small-organic boundary feedstocks. Their external supply and concentration are not claimed to have been demonstrated by the discharge experiments. Consequently, P3-P8 do not silently transfer sulfide/cyanide-containing photolysates into copper(II) chemistry. Internally generated acetaldehyde is an additional supply possibility, but its purification for the aldol branch remains unresolved. Reported experimental conditions are distinguished from proposed screening conditions in individual reactions. The network does not demonstrate integrated throughput, free-product yield or geochemical availability of concentrated copper(II), hydroxylamine, acid or alkalinity. Copper removal, iron removal, volatile retention and precursor survival are explicit handoff gates, not assumed quantitative operations. Threonine and allothreonine are tracked separately; neither enantioselection nor a fixed diastereomer ratio is asserted. Neutral parent formulas describe constitutional intermediates whose aqueous protonation equilibria are implicit; explicit salt nodes represent chemically important workup states. Salts are electrically neutral formula units, avoiding ambiguous ionic formulas. Unresolved stereochemical or coordination mixtures have null InChI values. The schema's intermediate role also covers coproducts and precipitated sinks. Sulfur is represented by S8 as a formal zero-valent endpoint, although actual photolysates can contain polysulfides and metal sulfides. Inferred coefficients describe atom-balanceable net modules, not yields, stereoisomer ratios or elementary molecularity. Product accumulation requires cool, shaded water; the hydrothermal reaction is a degradation sink only.", "molecules": [{"id": "mol_001", "formula": "HCN", "iupac_name": "Hydrogen cyanide", "common_name": "Hydrocyanic acid", "inchi": "InChI=1S/CHN/c1-2/h1H", "role": "starting", "environment_formed": null}, {"id": "mol_002", "formula": "H2S", "iupac_name": "Hydrogen sulfide", "common_name": "Hydrogen sulfide", "inchi": "InChI=1S/H2S/h1H2", "role": "starting", "environment_formed": null}, {"id": "mol_003", "formula": "NH3", "iupac_name": "Ammonia", "common_name": "Ammonia", "inchi": "InChI=1S/H3N/h1H3", "role": "starting", "environment_formed": null}, {"id": "mol_004", "formula": "H2O", "iupac_name": "Water", "common_name": "Water", "inchi": "InChI=1S/H2O/h1H2", "role": "starting", "environment_formed": null}, {"id": "mol_005", "formula": "S8", "iupac_name": "Cyclooctasulfur", "common_name": "Elemental sulfur", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_006", "formula": "CH2O", "iupac_name": "Methanal", "common_name": "Formaldehyde", "inchi": "InChI=1S/CH2O/c1-2/h1H2", "role": "starting", "environment_formed": "Surface"}, {"id": "mol_007", "formula": "C2H3NO", "iupac_name": "2-Hydroxyacetonitrile", "common_name": "Glycolonitrile", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_008", "formula": "C2H4O2", "iupac_name": "2-Hydroxyethanal", "common_name": "Glycolaldehyde", "inch