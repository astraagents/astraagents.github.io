e": "Glyoxylic acid", "inchi": "InChI=1S/C2H2O3/c3-1-2(4)5/h1H,(H,4,5)", "role": "starting", "environment_formed": null}, {"id": "mol_019", "formula": "H2", "iupac_name": "Dihydrogen", "common_name": "Hydrogen", "inchi": "InChI=1S/H2/h1H", "role": "starting", "environment_formed": null}, {"id": "mol_020", "formula": "H3NO", "iupac_name": "Hydroxylamine", "common_name": "Hydroxylamine", "inchi": "InChI=1S/H3NO/c1-2/h2H,1H2", "role": "starting", "environment_formed": null}, {"id": "mol_021", "formula": "C2H3NO3", "iupac_name": "2-(Hydroxyimino)acetic acid", "common_name": "Glyoxylic acid oxime", "inchi": null, "role": "intermediate", "environment_formed": "Biochemical"}, {"id": "mol_022", "formula": "Fe", "iupac_name": "Iron", "common_name": "Native iron", "inchi": "InChI=1S/Fe", "role": "starting", "environment_formed": null}, {"id": "mol_023", "formula": "HCl", "iupac_name": "Hydrogen chloride", "common_name": "Hydrochloric acid", "inchi": "InChI=1S/ClH/h1H", "role": "starting", "environment_formed": null}, {"id": "mol_024", "formula": "FeCl2", "iupac_name": "Iron(II) chloride", "common_name": "Ferrous chloride", "inchi": null, "role": "intermediate", "environment_formed": "Biochemical"}, {"id": "mol_025", "formula": "CuCl2", "iupac_name": "Copper(II) chloride", "common_name": "Cupric chloride", "inchi": null, "role": "starting", "environment_formed": null}, {"id": "mol_026", "formula": "C4H8CuN2O4", "iupac_name": "Bis(2-aminoacetato)copper(II)", "common_name": "Copper(II) bisglycinate", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_027", "formula": "C8H16CuN2O6", "iupac_name": "Bis(2-amino-3-hydroxybutanoato)copper(II)", "common_name": "Copper-bound threoninate/allothreoninate pool", "inchi": null, "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_028", "formula": "C4H10ClNO3", "iupac_name": "(2RS,3SR)-2-Amino-3-hydroxybutanoic acid hydrochloride", "common_name": "DL-Threonine hydrochloride", "inchi": null, "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_029", "formula": "C4H10ClNO3", "iupac_name": "(2RS,3RS)-2-Amino-3-hydroxybutanoic acid hydrochloride", "common_name": "DL-Allothreonine hydrochloride", "inchi": null, "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_030", "formula": "CuS", "iupac_name": "Copper sulfide", "common_name": "Copper sulfide precipitate, formal CuS endpoint", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_031", "formula": "CH4", "iupac_name": "Methane", "common_name": "Methane", "inchi": "InChI=1S/CH4/h1H4", "role": "starting", "environment_formed": null}, {"id": "mol_032", "formula": "N2", "iupac_name": "Dinitrogen", "common_name": "Nitrogen", "inchi": "InChI=1S/N2/c1-2", "role": "starting", "environment_formed": null}, {"id": "mol_033", "formula": "CO2", "iupac_name": "Carbon dioxide", "common_name": "Carbon dioxide", "inchi": "InChI=1S/CO2/c2-1-3", "role": "starting", "environment_formed": null}, {"id": "mol_034", "formula": "NaOH", "iupac_name": "Sodium hydroxide", "common_name": "Sodium-associated aqueous alkalinity", "inchi": null, "role": "starting", "environment_formed": null}, {"id": "mol_035", "formula": "NaCl", "iupac_name": "Sodium chloride", "common_name": "Sodium chloride", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_036", "formula": "C4H8NNaO3", "iupac_name": "Sodium (2RS,3SR)-2-amino-3-hydroxybutanoate", "common_name": "Sodium DL-threoninate", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_037", "formula": "C4H8NNaO3", "iupac_name": "Sodium (2RS,3RS)-2-amino-3-hydroxybutanoate", "common_name": "Sodium DL-allothreoninate", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_038", "formula": "NH4Cl", "iupac_name": "Ammonium chloride", "common_name": "Ammonium chloride", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_039", "formula": "C2H6ClNO2", "iupac_name": "2-Aminoacetic acid hydrochloride", "common_name": "Glycine hydrochloride", "inchi": null, "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_040", "formula": "FeH2O2", "iupac_name": "Iron(II) hydroxide", "common_name": "Ferrous hydroxide", "inchi": null, "role": "intermediate", "environment_formed": "Biochemical"}], "reactions": [{"id": "rxn_001", "name": "Photoredox entry from hydrogen cyanide to formaldehyde", "inputs": ["mol_001", "mol_002", "mol_004"], "outputs": ["mol_006", "mol_003", "mol_005"], "environment": "Surface", "agents": ["CuCN-derived cyanocuprate photoredox species", "Phosphate buffer"], "conditions": {"temperature": "300-310 K, proposed near-room-temperature operating window", "pressure": "Approximately 1 atm", "catalyst": "CuCN-derived Cu(I)/Cu(II) photoredox system", "aqueous": true, "other": "Anoxic, 254 nm irradiation. Proposed starting screen: 10 mM total cyanide, 30 mM total sulfide, 33 mM phosphate, pH approximately 7 and CuCN at 10 mol% relative to carbon substrate. These concentrations adapt the reported glycolonitrile protocol rather than reproduce a separately established HCN-only recipe. Proposed exposure: 1-24 h with time-course sampling. A shallow illuminated layer and continuing volatile-feed retention are required."}, "mechanism": "A coarse-grained reduction of HCN through reduced C1 nitrogen intermediates, followed by hydrolysis to formaldehyde. Sulfide supplies reducing equivalents and is represented as ending in zero-valent sulfur.", "reasoning": "HCN reductive homologation supplies the C1 entry to the cyanosulfidic framework (Ritson and Sutherland, 2013; Patel et al., 2015). This is a network-level transformation, not an established selective one-step preparation at the proposed concentrations. Natural photon flux, cyanide retention and CuCN/cyanocuprate speciation must be measured. Sulfide and sulfur precipitates can attenuate UV or remove copper from the active pool; the supplied evidence does not quantify these integrated losses (Ranjan et al., 2018)."}, {"id": "rxn_002", "name": "Formaldehyde cyanohydrin formation", "inputs": ["mol_006", "mol_001"], "outputs": ["mol_007"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-310 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Proposed pH 7-9, millimolar formaldehyde and total cyanide, and 1-24 h equilibration. Keep ammonia relatively low when directing carbon toward glycolonitrile rather than aminoacetonitrile. Avoid extended drying because HCN loss would change the reaction balance."}, "mechanism": "Cyanide adds to formaldehyde and proton transfer produces glycolonitrile.", "reasoning": "Cyanohydrin capture connects formaldehyde to the experimentally studied glycolonitrile photochemistry (Ritson and Sutherland, 2013; Patel et al., 2015). No mineral is necessary for this carbon-carbon bond formation. Hydrated formaldehyde, competing ammonia chemistry and cyanide volatility affect the usable glycolonitrile concentration."}, {"id": "rxn_003", "name": "Glycolonitrile photoreduction to glycolaldehyde", "inputs": ["mol_007", "mol_002", "mol_004"], "outputs": ["mol_008", "mol_003", "mol_005"], "environment": "Surface", "agents": ["CuCN-derived cyanocuprate photoredox species", "Phosphate buffer"], "conditions": {"temperature": "300-310 K, proposed operating window", "pressure": "Approximately 1 atm", "catalyst": "CuCN-derived copper photoredox system", "aqueous": true, "other": "Reported reference mixture: glycolonitrile 10 mM, H2S 30 mM, phosphate 33 mM at pH 7, solid CuCN at 10 mol%, and 254 nm UV. Proposed time-course window: 1-24 h; an irradiation duration or solar-equivalent fluence is not established here. Characterize dissolved copper, precipitated copper and sulfur speciation rather than assuming constant catalyst loading."}, "mechanism": "Photochemical reduction of the nitrile gives an imine-level intermediate whose hydrolysis yields glycolaldehyde and ammonia.", "reasoning": "This is directly grounded in the glycolonitrile experiments summarized in the supplied report (Ritson and Sutherland, 2013), and is incorporated in the later systems network (Patel et al., 2015). S8 is only an electron-balance endpoint; actual sulfur products need analytical resolution. Laboratory catalyst loading does not establish a naturally available dissolved copper concentration."}, {"id": "rxn_004", "name": "Net photochemical reductive deoxygenation of glycolaldehyde", "inputs": ["mol_008", "mol_002"], "outputs": ["mol_009", "mol_004", "mol_005"], "environment": "Surface", "agents": ["CuCN-derived copper photoredox species"], "conditions": {"temperature": "300-310 K", "pressure": "Approximately 1 atm in a vapor-retaining illuminated compartment", "catalyst": "Copper-cyanide photoredox system", "aqueous": true, "other": "Proposed pH approximately 7 with millimolar glycolaldehyde, sulfide in reducing excess and 254 nm irradiation. Screen over 1-24 h rather than assigning an unsupported conversion. Trap acetaldehyde promptly in rxn_005. Transfer of this crude photolysate into copper(II)-glycinate chemistry is not permitted without a separately demonstrated cyanide/sulfide removal process."}, "mechanism": "A lumped photoredox deoxygenation module converts the hydroxy-substituted aldehyde to acetaldehyde; water is the formal oxygen-containing coproduct.", "reasoning": "Acetaldehyde supply from glycolaldehyde reduction is part of the cyanosulfidic precursor network described in the research (Patel et al., 2015). This assignment is not an elementary mechanism or a claim of selective acetaldehyde production. Volatility, competing reduction and condensation make recoverable acetaldehyde a bottleneck. P3-P8 therefore use an independently supplied acetaldehyde boundary pool, not assumed clean output from this reaction."}, {"id": "rxn_005", "name": "Acetaldehyde capture as lactonitrile", "inputs": ["mol_009", "mol_001"], "outputs": ["mol_010"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-310 K", "pressure": "Approximately 1 atm with restricted gas exchange", "catalyst": null, "aqueous": true, "other": "Proposed pH 7-9, millimolar acetaldehyde and total cyanide, and equilibration over minutes to hours. Keep the solution cool and avoid prolonged strongly alkaline storage, which favors acetaldehyde self-condensation."}, "mechanism": "Cyanide addition to acetaldehyde produces racemic 2-hydroxypropanenitrile.", "reasoning": "Lactonitrile is the experimentally used precursor of lactaldehyde in the designed threonine route (Ritson and Sutherland, 2013; Patel et al., 2015). Cyanohydrin formation is chemically justified without a mineral catalyst. The reaction does not introduce enantioselectivity, and the equilibrium must compete with aldehyde volatilization."}, {"id": "rxn_006", "name": "Lactonitrile photoreduction to lactaldehyde", "inputs": ["mol_010", "mol_002", "mol_004"], "outputs": ["mol_011", "mol_003", "mol_005"], "environment": "Surface", "agents": ["CuCN-derived cyanocuprate photoredox species", "Phosphate buffer"], "conditions": {"temperature": "300-310 K, proposed near-room-temperature window", "pressure": "Approximately 1 atm", "catalyst": "CuCN-derived copper photoredox system", "aqueous": true, "other": "254 nm irradiation, approximately neutral phosphate-buffered water and a sulfide reductant. The 10 mM substrate, 30 mM sulfide, 33 mM phosphate and 10 mol% CuCN mixture is a reference screening composition, not an independently verified optimal lactonitrile protocol. Follow substrate disappearance and lactaldehyde appearance; stop or trap the aldehyde before secondary photochemistry dominates."}, "mechanism": "Nitrile reduction followed by imine hydrolysis converts lactonitrile to lactaldehyde and ammonia.", "reasoning": "Lactaldehyde was reported in 19% yield from lactonitrile under the photoreduction chemistry (Ritson and Sutherland, 2013). This is direct support for the crucial C3 aldehyde, but 19% is not a threonine yield and cannot be multiplied through unspecified downstream conversions. Catalyst precipitation, sulfur speciation and aldehyde survival remain integration measurements rather than established efficiencies (Patel et al., 2015; Ranjan et al., 2018)."}, {"id": "rxn_007", "name": "Lactaldehyde Strecker aminonitrile formation", "inputs": ["mol_011", "mol_001", "mol_003"], "outputs": ["mol_012", "mol_004"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-320 K", "pressure": "Approximately 1 atm with limited volatile loss", "catalyst": null, "aqueous": true, "other": "Proposed pH 8-9, millimolar lactaldehyde and cyanide, and ammonia in excess. Screen over 1-24 h. Stop irradiation during aminonitrile accumulation. Before subsequent acidification, characterize residual cyanide, sulfide and copper; settling removes particles but does not establish removal of dissolved complexes."}, "mechanism": "Ammonia forms a reversible imine with lactaldehyde, and cyanide addition produces 2-amino-3-hydroxybutanenitrile.", "reasoning": "The supplied research reports smooth conversion of lactaldehyde to the corresponding aminonitrile after adding HCN and ammonia (Ritson and Sutherland, 2013), with the precursor included in Patel et al. (2015). No numerical aminonitrile yield or threo:allo ratio was reported. The unresolved intermediate node therefore carries no stereochemical yield assumption."}, {"id": "rxn_008", "name": "Proposed acidic hydration of the threonine aminonitrile", "inputs": ["mol_012", "mol_004"], "outputs": ["mol_013"], "environment": "Surface", "agents": ["Acidic aqueous medium supplied by hydrogen chloride"], "conditions": {"temperature": "353-370 K, proposed screening range", "pressure": "Approximately 1 atm, below bulk boiling", "catalyst": "Hydrogen ions", "aqueous": true, "other": "Proposed pH 1-2 and 1-30 days in a separate dark acidic compartment. These are candidate conditions, not a reported threonine-aminonitrile protocol. Begin only after the photolysate has been characterized and a tolerable precursor recovery established. Monitor amide, amino acid, retro-aldol products and total carbon recovery."}, "mechanism": "Acid activation of the nitrile permits water addition and tautomerization to the carboxamide.", "reasoning": "Speculative target-specific completion step. The provided experiments stop at the aminonitrile and do not demonstrate its hydration under this environmental window (Ritson and Sutherland, 2013; Patel et al., 2015). Ordinary nitrile chemistry justifies testing the transformation, but it does not establish a rate or recovered yield for this beta-hydroxy substrate."}, {"id": "rxn_009", "name": "Proposed acidic amide hydrolysis to threonine and allothreonine salts", "inputs": ["mol_013", "mol_004", "mol_023"], "outputs": ["mol_028", "mol_029", "mol_038"], "environment": "Surface", "agents": null, "conditions": {"temperature": "353-370 K, proposed screening range", "pressure": "Approximately 1 atm", "catalyst": "Acid-promoted hydrolysis; hydrogen chloride also supplies product counterions", "aqueous": true, "other": "Proposed pH 0.5-1.5 and time-course sampling over 1-30 days. Hydrogen chloride is included as a consumed reagent because amino-acid hydrochlorides and ammonium chloride are explicitly represented. Cool immediately after net amino-acid accumulation peaks. No completion time or survival fraction is established."}, "mechanism": "Water attacks the activated amide; carbon-nitrogen bond cleavage gives the amino acid and ammonia, represented as their chloride salts in strongly acidic solution.", "reasoning": "Speculative target-specific hydrolysis. The supplied Strecker literature establishes precursor connectivity but not free-threonine yield, product survival or diastereomer distribution after hydrolysis (Ritson and Sutherland, 2013; Patel et al., 2015). Listing both stereoisomer salts does not assert equal yields. Hydrolysis must outcompete decomposition, and acid availability at the proposed concentration is a separate geochemical requirement."}, {"id": "rxn_010", "name": "Recovery of free threonine from its hydrochloride", "inputs": ["mol_028", "mol_034"], "outputs": ["mol_014", "mol_035", "mol_004"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-310 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Mix acid product water with a separately available alkaline stream to reach pH 5-6; NaOH represents its sodium-associated hydroxide equivalents, not a presumed deposit of pure caustic. Neutralization takes minutes to hours. For copper-derived material, perform rxn_026 and physical solid separation first. A proposed acceptance gate is dissolved copper below 0.01 mol per mol total amino acids, together with a measured free-threonine fraction. Store under opaque cover."}, "mechanism": "One equivalent of base removes the excess acid proton, leaving predominantly zwitterionic threonine near pH 5-6.", "reasoning": "Speculative environmental workup, although the acid-base transformation itself is routine. Neither the cyanosulfidic reports nor the preparative aldol result establishes this integrated recovery operation (Ritson and Sutherland, 2013; Sato, Okawa and Akabori, 1957). Neutralization is not a chiral separation and does not remove copper by itself. The defined metal-removal gate prevents acid dissociation from being misrepresented as metal-free product isolation."}, {"id": "rxn_011", "name": "Recovery of free allothreonine from its hydrochloride", "inputs": ["mol_029", "mol_034"], "outputs": ["mol_015", "mol_035", "mol_004"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-310 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "The same pH 5-6 neutralization and prior copper-removal requirements as rxn_010 apply. Resolve threonine and allothreonine analytically rather than assigning the entire recovered beta-hydroxy amino-acid pool to the target."}, "mechanism": "Neutralization of the hydrochloride produces the predominantly zwitterionic allothreonine pool.", "reasoning": "Speculative environmental workup included to preserve explicit diastereomer accounting. Nonselective formation of both threonine and allothreonine is consistent with the discharge and aldol evidence (Ring et al., 1972; Sato, Okawa and Akabori, 1957). This operation does not convert allothreonine into threonine."}, {"id": "rxn_012", "name": "Proposed alkaline hydration of the threonine aminonitrile", "inputs": ["mol_012", "mol_004"], "outputs": ["mol_013"], "environment": "Surface", "agents": ["Hydroxide ions supplied by an alkaline aqueous stream"], "conditions": {"temperature": "333-370 K, proposed screening range", "pressure": "Approximately 1 atm", "catalyst": "Hydroxide ions", "aqueous": true, "other": "Proposed pH 11.5-12.5, quoted for a cooled approximately 300 K aliquot, and 1-30 days of time-course sampling. This requires unusually alkaline surface water and is not interchangeable with the neutral photochemical compartment. Keep the solution dark and monitor carbon-skeleton cleavage as well as nitrile disappearance."}, "mechanism": "Hydroxide addition to the nitrile and subsequent proton transfers produce the amide.", "reasoning": "Speculative alternative completion chemistry, not a second experimentally demonstrated threonine synthesis. The supplied cyanosulfidic studies do not validate alkaline hydrolysis of this aminonitrile (Ritson and Sutherland, 2013; Patel et al., 2015). Base may promote unwanted decomposition and stereochemical redistribution, so conversion cannot be inferred from a generic nitrile-hydrolysis mechanism."}, {"id": "rxn_013", "name": "Proposed alkaline amide hydrolysis to amino-acid carboxylates", "inputs": ["mol_013", "mol_034"], "outputs": ["mol_036", "mol_037", "mol_003"], "environment": "Surface", "agents": null, "conditions": {"temperature": "333-370 K, proposed screening range", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Maintain proposed cooled-aliquot pH 11.5-12.5 while measuring base consumption. Hydroxide is a stoichiometric reagent in the represented amide-to-carboxylate transformation. Screen over 1-30 days and terminate if amino-acid destruction exceeds production. Product ratios must be measured."}, "mechanism": "Nucleophilic acyl substitution converts the amide to its carboxylate salt and releases ammonia.", "reasoning": "Speculative target-specific step. The atom-balanced transformation is chemically reasonable, but the provided research contains no validated alkaline completion yield for this substrate pool (Ritson and Sutherland, 2013; Patel et al., 2015). Threonine's known cleavage and epimerization chemistry makes prolonged strong-base exposure an uncertain tradeoff rather than an established solution (Schroeder and Bada, 1977)."}, {"id": "rxn_014", "name": "Protonation of sodium threoninate to recover threonine", "inputs": ["mol_036", "mol_023"], "outputs": ["mol_014", "mol_035"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-310 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Cool first, then mix with acidic chloride-bearing water to reach pH 5-6 without prolonged residence at extreme pH. Allow minutes to hours for equilibration and place the product in a shaded compartment. Quantify surviving threonine rather than assuming complete recovery."}, "mechanism": "Protonation of the amino-acid anion gives the net-neutral, predominantly zwitterionic amino acid.", "reasoning": "Speculative environmental workup based on ordinary acid-base chemistry. It completes the represented salt balance but does not validate the preceding hydrolysis or restore destroyed threonine (Ritson and Sutherland, 2013; Schroeder and Bada, 1977)."}, {"id": "rxn_015", "name": "Protonation of sodium allothreoninate", "inputs": ["mol_037", "mol_023"], "outputs": ["mol_015", "mol_035"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-310 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Use the pH 5-6 recovery window of rxn_014. Determine the threonine/allothreonine ratio by a method that resolves the two diastereomeric pairs."}, "mechanism": "Acid-base equilibration converts the sodium salt to net-neutral allothreonine.", "reasoning": "Speculative environmental workup; no new carbon-skeleton chemistry is claimed. Separate accounting is necessary because nonenzymatic routes produce allothreonine and subsequent processing can alter its abundance (Ring et al., 1972; Schroeder and Bada, 1977)."}, {"id": "rxn_016", "name": "Formaldehyde Strecker formation of aminoacetonitrile", "inputs": ["mol_006", "mol_001", "mol_003"], "outputs": ["mol_016", "mol_004"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-320 K", "pressure": "Approximately 1 atm with limited gas exchange", "catalyst": null, "aqueous": true, "other": "Proposed pH 8-9, formaldehyde and total cyanide each 10-100 mM, and ammonia 10-200 mM. Sample over 1-24 h. This branch can begin with independently supplied formaldehyde and therefore does not require copper or sulfide photochemistry."}, "mechanism": "Formaldehyde and ammonia form imine-like intermediates that undergo cyanide addition to aminoacetonitrile.", "reasoning": "Glycine aminonitrile is a supported product of the HCN/aldehyde/ammonia network (Patel et al., 2015). The proposed concentration window is not presented as a measured optimum. Using formaldehyde as a small-molecule boundary feedstock avoids attributing an unmeasured aldehyde inventory to a particular spark experiment."}, {"id": "rxn_017", "name": "Acidic aminoacetonitrile hydrolysis to glycine hydrochloride", "inputs": ["mol_016", "mol_004", "mol_023"], "outputs": ["mol_039", "mol_038"], "environment": "Surface", "agents": null, "conditions": {"temperature": "353-370 K, proposed environmental window", "pressure": "Approximately 1 atm", "catalyst": "Acid-promoted hydrolysis; hydrochloric acid also supplies salt counterions", "aqueous": true, "other": "Proposed pH 0.5-1.5 and 1-30 days, with nitrile and amide intermediates followed analytically. The amide stage is lumped into this net module. Residual cyanide must be characterized before acidic processing. Ammonium chloride remains in solution and is not assumed to disappear during glycine recovery."}, "mechanism": "Nitrile hydration and subsequent amide hydrolysis give glycine and ammonia, represented as hydrochloride and ammonium salts.", "reasoning": "General Strecker chemistry supports this glycine supply route, and aminoacetonitrile is part of the cited prebiotic network (Patel et al., 2015). The particular mild-temperature residence window is a speculative environmental implementation, not a glycine yield reported by that paper. Glycine is less structurally fragile than threonine, but mixture compatibility with the later copper reaction still requires testing."}, {"id": "rxn_018", "name": "Neutralization and conditioning of glycine hydrochloride", "inputs": ["mol_039", "mol_034"], "outputs": ["mol_017", "mol_035", "mol_004"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-310 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "First neutralize to pH 6-8. Before copper addition, characterize cyanide, sulfide, ammonia, hydroxylamine and dissolved metals. Ammonia-rich solutions may require a separate alkaline degassing interval followed by pH readjustment; quantitative ammonia removal is not assumed. Iron-derived material must also pass rxn_022 and particle separation."}, "mechanism": "Base neutralization yields predominantly zwitterionic glycine.", "reasoning": "Speculative integration workup based on ordinary acid-base chemistry. Glycine availability alone does not establish that a Strecker or iron-reduction mixture is compatible with copper-glycinate aldol chemistry (Patel et al., 2015; Muchowska et al., 2019; Sato, Okawa and Akabori, 1957). In particular, ammonia can alter copper ligation and hydroxylamine can alter copper oxidation state."}, {"id": "rxn_019", "name": "Nickel-catalyzed reductive amination of glyoxylic acid to glycine", "inputs": ["mol_018", "mol_003", "mol_019"], "outputs": ["mol_017", "mol_004"], "environment": "Biochemical", "agents": ["Nickel supported on silica-alumina"], "conditions": {"temperature": "295 K, corresponding to the reported 22 degrees Celsius", "pressure": "Hydrogen partial pressure approximately 5 bar", "catalyst": "Ni/SiO2-Al2O3 laboratory catalyst", "aqueous": true, "other": "Reported reference conditions include pH 8 and 5 bar H2. Proposed screening feed: glyoxylate 1-10 mM and total ammonia/ammonium 10-100 mM, monitored over 24-72 h; these concentrations and residence times are not assigned reported glycine yields. Physically, this requires a confined cool water-rock cavity or a laboratory analogue, not an open ambient-pressure pool. Retain catalyst particles upstream, depressurize without admitting oxygen, and verify residual glyoxylate, nickel, reducing capacity and ammonia before copper-glycinate formation."}, "mechanism": "Metal-catalyzed hydrogenation of an imine/iminium intermediate formed from glyoxylate and ammonia produces glycine.", "reasoning": "Glyoxylate reductive amination is supported by the metal/H2 study (Kaur et al., 2024), which used 5 bar H2, pH 8 and 22 degrees Celsius and examined low ammonium concentrations. This is glycine synthesis, not evidence for direct threonine reductive amination. The supported nickel material is a laboratory catalyst, not an asserted ubiquitous mineral, and its geochemical availability and successful handoff to copper chemistry remain conditional."}, {"id": "rxn_020", "name": "Formation of glyoxylic acid oxime", "inputs": ["mol_018", "mol_020"], "outputs": ["mol_021", "mol_004"], "environment": "Biochemical", "agents": ["Mildly acidic aqueous medium"], "conditions": {"temperature": "300-323 K, proposed screening range", "pressure": "Approximately 1 atm", "catalyst": "General acid catalysis", "aqueous": true, "other": "Proposed pH 3-6 and millimolar reactants, with hydroxylamine limiting and reaction progress followed over 1-24 h. No E/Z selectivity is assumed. Hydroxylamine supply is an explicit boundary assumption; it is not generated elsewhere in this network."}, "mechanism": "Hydroxylamine condenses with the aldehyde group of glyoxylic acid to form an oxime.", "reasoning": "The hydroxylamine/iron amino-acid chemistry motivates this mechanistic decomposition (Muchowska et al., 2019). Isolation of this exact oxime stage under the stated conditions is a speculative representation rather than a reported result from that network. Limiting residual hydroxylamine matters because carryover can consume or reduce downstream copper(II)."}, {"id": "rxn_021", "name": "Proposed native-iron reduction of glyoxylic acid oxime", "inputs": ["mol_021", "mol_022", "mol_023"], "outputs": ["mol_039", "mol_024", "mol_004"], "environment": "Biochemical", "agents": null, "conditions": {"temperature": "323-343 K, proposed screening range", "pressure": "Approximately 1 atm with anoxic gas release", "catalyst": null, "aqueous": true, "other": "Proposed acidic chloride medium, pH approximately 1.5-2.5, native iron in electron-equivalent excess, and 1-96 h time-course sampling. Iron is a consumed reductant, not a catalyst. Acid corrosion competes by producing H2. Remove residual Fe(0) particles before any copper addition, neutralize through rxn_018, and remove dissolved iron through rxn_022. Proceed only if residual hydroxylamine and reducing capacity are below experimentally established interference thresholds."}, "mechanism": "Four-electron reduction of the oxime cleaves its N-O bond and reduces C=N to the amino-acid skeleton. Iron is oxidized to iron(II), represented as neutral FeCl2 formula units.", "reasoning": "Speculative isolated-step implementation motivated by iron/hydroxylamine amino-acid formation (Muchowska et al., 2019). The cited work does not establish this exact acidic oxime protocol or its recovery yield. The reaction is atom-balanceable with iron as a stoichiometric reductant; FeCl2 is used to avoid ambiguous ferrous-ion formula notation. Particle removal alone would not remove dissolved iron or hydroxylamine."}, {"id": "rxn_022", "name": "Precipitation of ferrous hydroxide before copper chemistry", "inputs": ["mol_024", "mol_034"], "outputs": ["mol_040", "mol_035"], "environment": "Biochemical", "agents": null, "conditions": {"temperature": "300-310 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Raise the cooled solution to pH approximately 8.5-9.5 under anoxia, then allow 1-24 h for settling or retention in a porous bed. Measure residual dissolved iron and glycine adsorbed to the precipitate. Glycine complexation can inhibit complete iron removal. This operation does not destroy residual hydroxylamine and is not a substitute for measuring it."}, "mechanism": "Hydroxide precipitates dissolved iron(II) as ferrous hydroxide without requiring molecular oxygen.", "reasoning": "Speculative integration step based on standard iron(II) solubility chemistry. It specifically addresses carryover from the iron-mediated amino-acid module motivated by Muchowska et al. (2019); that paper does not establish the downstream separation and copper handoff. No quantitative purification or amino-acid recovery is assumed."}, {"id": "rxn_023", "name": "Formation of copper(II) bisglycinate", "inputs": ["mol_017", "mol_025", "mol_034"], "outputs": ["mol_026", "mol_035", "mol_004"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-313 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Proposed pH 8-9, copper 1-10 mM and glycine at least two equivalents per copper, preferably in excess. Add copper to glycine before increasing alkalinity to limit copper hydroxide precipitation. The copper is stoichiometrically represented in the complex. Accept only characterized feeds with low cyanide, sulfide, hydroxylamine and residual Fe(0); a screening limit of less than 0.01 equivalent of strong copper poisons per copper is proposed, not validated."}, "mechanism": "Glycinate binds copper(II) through nitrogen and carboxylate oxygen, forming the chelate used for alpha-carbon activation.", "reasoning": "Copper glycinate is the relevant precursor in the experimentally demonstrated preparative aldol synthesis (Sato, Okawa and Akabori, 1957). Its availability at useful concentrations in an anoxic, sulfide-bearing, iron-rich environment is not established. A separately supplied chloride-bearing Cu(II) inventory is an explicit conditional input; no molecular oxygen is introduced or assumed to regenerate copper."}, {"id": "rxn_024", "name": "Copper-glycinate aldol addition to acetaldehyde", "inputs": ["mol_026", "mol_009"], "outputs": ["mol_027"], "environment": "Surface", "agents": ["Hydroxide base promoter"], "conditions": {"temperature": "313-333 K, proposed preparative-analogue screening range", "pressure": "Approximately 1 atm in a vapor-retaining aqueous compartment", "catalyst": "Base promotion of stoichiometric copper-glycinate complexes", "aqueous": true, "other": "Proposed copper-glycinate concentration 5-20 mM, acetaldehyde 0.05-0.5 M, cooled-aliquot pH 10-12, and 1-24 h sampling. These are screening conditions, not a reconstruction of the reported 64% experiment. Acetaldehyde is independently supplied in P3-P8. Restrict volatilization, monitor acetaldehyde self-condensation, and release product before retro-aldol loss dominates."}, "mechanism": "Copper coordination facilitates glycine alpha-carbon deprotonation; the carbon nucleophile adds to acetaldehyde. The net node combines ligand additions into a formal bis-product complex.", "reasoning": "Sato, Okawa and Akabori (1957) reported up to 64% combined threonine/allothreonine in preparative copper-glycinate chemistry. That result does not validate geochemical concentrations, the proposed conditions or untreated upstream mixtures. The represented bis-ligand complex is bookkeeping for a coordination pool that can also contain partially converted and mixed-ligand species. Diastereomer ratios are base- and time-dependent; neither 64% yield nor a fixed threo:allo ratio is assigned to this network."}, {"id": "rxn_025", "name": "Acid dissociation of copper-bound hydroxy amino acids", "inputs": ["mol_027", "mol_023"], "outputs": ["mol_028", "mol_029", "mol_025"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-310 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Proposed pH 0.5-1.5 for minutes to a few hours, sufficient to favor protonated amino-acid salts and dissociation of their copper complexes. Immediately follow with rxn_026 before neutralizing. Acidification alone neither removes copper nor guarantees complete decomplexation."}, "mechanism": "Ligand protonation weakens copper binding, transferring the amino acids into an acidic salt pool and copper into dissolved chloride-bearing species.", "reasoning": "Speculative recovery step based on established coordination and acid-base chemistry. The cited preparative aldol result supports formation of the amino-acid skeleton, not this specific environmental isolation sequence (Sato, Okawa and Akabori, 1957). Unlike simple acid release followed by dilution, this pathway explicitly requires a subsequent copper-removal operation."}, {"id": "rxn_026", "name": "Copper removal from the acidic amino-acid fraction", "inputs": ["mol_025", "mol_002"], "outputs": ["mol_030", "mol_023"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-310 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Proposed pH 1-2, sulfide approximately 1-3 equivalents per dissolved copper, dark anoxic conditions, and 1-24 h settling or porous-bed retention. Separate the precipitate before rxn_010 and rxn_011. Measure residual copper and amino-acid adsorption losses. CuS is a formal endpoint; actual sulfide solids can have variable stoichiometry and electronic structure."}, "mechanism": "Formation of a poorly soluble copper sulfide phase removes dissolved copper and releases acid into the remaining amino-acid solution.", "reasoning": "Speculative integration step based on standard copper-sulfide precipitation chemistry. Neither Sato, Okawa and Akabori (1957) nor the supplied cyanosulfidic studies demonstrate quantitative threonine recovery through this operation. It provides a chemically explicit removal mechanism, but adsorption, colloid passage, residual copper and sulfide demand must be measured. Copper is consumed into a sink rather than assumed catalytically recycled."}, {"id": "rxn_027", "name": "Direct sulfide-driven release from copper-bound hydroxy amino acids", "inputs": ["mol_027", "mol_002"], "outputs": ["mol_014", "mol_015", "mol_030"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-310 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Proposed pH 5-7, sulfide approximately 1-3 equivalents per copper, and 1-24 h in a dark anoxic compartment. Separate copper-sulfide solids and assay free amino acid, dissolved copper and adsorbed product. Keep sulfide away from the upstream Cu(II)-glycinate reaction; addition occurs only after aldol formation."}, "mechanism": "Copper-sulfide precipitation displaces the amino-acid ligands while sulfide-associated proton transfer gives net-neutral threonine and allothreonine.", "reasoning": "Speculative product-release alternative to acid dissociation followed by copper scavenging. Strong copper-sulfide formation makes the displacement chemically credible, but the supplied aldol study does not establish its yield or environmental operation (Sato, Okawa and Akabori, 1957). This is a genuinely different workup sequence, not a new carbon-skeleton synthesis mechanism. It consumes the copper inventory."}, {"id": "rxn_028", "name": "Reducing methane-nitrogen discharge inventory with conditional acidic recovery", "inputs": ["mol_031", "mol_032", "mol_003", "mol_004", "mol_023"], "outputs": ["mol_028", "mol_029", "mol_039", "mol_019"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-330 K proposed bulk collector; 353-370 K proposed subsequent recovery", "pressure": "Approximately 1 atm in the proposed analogue", "catalyst": null, "aqueous": true, "other": "Methane/nitrogen/water discharge with trace ammonia, following the reported reducing-gas framework. Proposed discharge exposure: 1-3 days; the plasma is not at the collector temperature. The represented recovery uses added HCl at pH 1-2 for 1-30 days, followed by rxn_010 and rxn_011. This mild recovery is a proposed environmental substitute, not a claim to reproduce the original analytical hydrolysis. Determine free and hydrolysis-released fractions separately."}, "mechanism": "An empirical net inventory module for radical gas chemistry, aqueous capture and hydrolysis-dependent recovery. No unique aldehyde or aminonitrile mechanism is assigned.", "reasoning": "Threonine and allothreonine were detected in reducing discharge products (Ring et al., 1972), with low relative abundance summarized by Weber and Miller (1981). The reported approximately equal threo/allo abundance is qualitative support for nonselectivity, not a stoichiometric requirement. This node does not claim measured delivery of acetaldehyde or lactaldehyde. Detection supports the inventory, whereas completion under the proposed lower-temperature recovery conditions remains speculative. The equation is an atom-balanceable projection of a much larger product mixture, not an exclusive reaction or yield model."}, {"id": "rxn_029", "name": "Hydrogen-sulfide-rich discharge inventory with conditional acidic recovery", "inputs": ["mol_031", "mol_002", "mol_003", "mol_033", "mol_004", "mol_023"], "outputs": ["mol_028", "mol_039", "mol_019", "mol_005"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-330 K proposed bulk collector; 353-370 K proposed subsequent recovery", "pressure": "Reported charged-gas partial pressures total 695 mmHg before accounting for water vapor", "catalyst": null, "aqueous": true, "other": "Reported 1958 charge: CH4 258 mmHg, H2S 100 mmHg, NH3 250 mmHg and CO2 87 mmHg; spark exposure 3 days. Sulfur deposition on tungsten electrodes was observed and its chemical influence remains unresolved. The graph's acidic recovery at pH 1-2 for 1-30 days is proposed, not the archived analytical protocol. Use blanks and diastereomer-resolving mass spectrometry, and distinguish free from hydrolysable product."}, "mechanism": "An empirical module for sulfur-influenced discharge chemistry, capture of a complex organic inventory and conditional recovery of threonine as an acid salt.", "reasoning": "Threonine was reported in the H2S-rich archived experiment and not in the other reanalyzed Miller experiment types discussed in the supplied research (Parker et al., 2011). A separately quantified allothreonine inventory is not assigned to this experiment. Sulfur and H2 outputs are formal bookkeeping endpoints, not a complete measured product distribution. Electrode effects, contamination controls and the analytical-hydrolysis distinction limit interpretation. Environmental free-threonine recovery through the proposed milder workup remains speculative."}, {"id": "rxn_030", "name": "Hydrothermal retro-aldol destruction of threonine", "inputs": ["mol_014"], "outputs": ["mol_017", "mol_009"], "environment": "Hydrothermal", "agents": null, "conditions": {"temperature": "394-433 K", "pressure": "10-100 bar or greater, sufficient to maintain liquid water", "catalyst": null, "aqueous": true, "other": "Represents accidental transport into warm subsurface or hydrothermal water, not an intended synthesis stage. Follow decomposition over hours to days as appropriate to measured kinetics. No extrapolated room-temperature lifetime is treated as an observation. Intended accumulation instead occurs below approximately 323 K in shaded surface water."}, "mechanism": "Cleavage of the alpha-beta carbon-carbon bond regenerates glycine and acetaldehyde through retro-aldol chemistry.", "reasoning": "Threonine decomposition and epimerization are established limitations, and high-temperature amino-acid survival is problematic (Schroeder and Bada, 1977; Aubrey, Cleaves and Bada, 2009). This reaction is an atom-balanced degradation sink and is not counted among the ten target-producing schedules. It does not imply that hydrothermal systems have demonstrated threonine synthesis."}], "pathways": [{"pathway_id": "P1", "name": "HCN homologation followed by acidic Strecker completion", "description": "Conditional designed synthesis from HCN, sulfide, ammonia and water through the documented lactaldehyde/aminonitrile sequence. Acidic nitrile and amide hydrolysis are proposed completion steps, followed by explicit salt neutralization. The 19% literature result applies only to lactaldehyde formation. Product survival, photolysate conditioning and free-threonine yield remain unvalidated.", "reaction_sequence": ["rxn_001", "rxn_002", "rxn_003", "rxn_004", "rxn_005", "rxn_006", "rxn_007", "rxn_008", "rxn_009", "rxn_010", "rxn_011"], "key_intermediates": ["mol_007", "mol_008", "mol_009", "mol_010", "mol_011", "mol_012", "mol_013", "mol_028"]}, {"pathway_id": "P2", "name": "HCN homologation followed by alkaline Strecker completion", "description": "Shares the supported carbon-skeleton construction of P1 but uses hydroxide-promoted nitrile hydration, stoichiometric amide hydrolysis and subsequent protonation of amino-acid carboxylates. This is an alternative reaction schedule, not independent evidence for precursor formation. Alkaline completion and product survival require target-specific validation.", "reaction_sequence": ["rxn_001", "rxn_002", "rxn_003", "rxn_004", "rxn_005", "rxn_006", "rxn_007", "rxn_012", "rxn_013", "rxn_014", "rxn_015"], "key_intermediates": ["mol_010", "mol_011", "mol_012", "mol_013", "mol_036", "mol_037"]}, {"pathway_id": "P3", "name": "Strecker glycine plus copper aldol with acid-assisted copper removal", "description": "Begins with independently supplied formaldehyde and acetaldehyde. Glycine is prepared through aminoacetonitrile, conditioned, chelated to copper and added to acetaldehyde. Acid dissociation is followed by copper-sulfide precipitation, physical solid separation and neutralization. Neither crude Strecker-mixture compatibility nor quantitative amino-acid recovery is assumed.", "reaction_sequence": ["rxn_016", "rxn_017", "rxn_018", "rxn_023", "rxn_024", "rxn_025", "rxn_026", "rxn_010", "rxn_011"], "key_intermediates": ["mol_016", "mol_039", "mol_017", "mol_026", "mol_027", "mol_028"]}, {"pathway_id": "P4", "name": "Strecker glycine plus copper aldol with direct sulfide release", "description": "Uses the same small-molecule boundary feeds and glycine construction as P3, but releases the amino acids directly from their copper complexes by sulfide precipitation near neutral pH. This avoids the strongly acidic product-release interval but still requires measured copper removal, adsorption recovery and control of upstream cyanide/ammonia carryover.", "reaction_sequence": ["rxn_016", "rxn_017", "rxn_018", "rxn_023", "rxn_024", "rxn_027"], "key_intermediates": ["mol_016", "mol_017", "mol_026", "mol_027"]}, {"pathway_id": "P5", "name": "Nickel-hydrogen glycine supply with acid-assisted aldol recovery", "description": "Glyoxylic acid undergoes nickel/H2 reductive amination before copper-glycinate aldol reaction with independently supplied acetaldehyde. Catalyst retention, anoxic depressurization and characterization of residual ammonia, glyoxylate and nickel are mandatory handoff gates. Acid release is followed by actual copper precipitation rather than assumed purification by dilution.", "reaction_sequence": ["rxn_019", "rxn_023", "rxn_024", "rxn_025", "rxn_026", "rxn_010", "rxn_011"], "key_intermediates": ["mol_017", "mol_026", "mol_027", "mol_028"]}, {"pathway_id": "P6", "name": "Nickel-hydrogen glycine supply with direct sulfide aldol recovery", "description": "Uses the experimentally supported glyoxylate reductive-amination module as a glycine source, not as direct threonine synthesis. The downstream copper aldol uses an independent acetaldehyde pool and direct sulfide-driven ligand release. Maintaining 5 bar H2, obtaining the supported nickel catalyst and integrating the two metal chemistries remain conditional.", "reaction_sequence": ["rxn_019", "rxn_023", "rxn_024", "rxn_027"], "key_intermediates": ["mol_017", "mol_026", "mol_027"]}, {"pathway_id": "P7", "name": "Oxime-iron glycine supply with acid-assisted aldol recovery", "description": "Glyoxylic acid and hydroxylamine form an oxime, which is reduced by consumed native iron. Glycine neutralization, ferrous-hydroxide precipitation and physical solid removal precede copper chelation and acetaldehyde addition. Residual hydroxylamine and Fe(0) must be excluded before copper addition. Final acid dissociation, copper-sulfide precipitation and neutralization provide an explicit but unvalidated free-product recovery sequence.", "reaction_sequence": ["rxn_020", "rxn_021", "rxn_018", "rxn_022", "rxn_023", "rxn_024", "rxn_025", "rxn_026", "rxn_010", "rxn_011"], "key_intermediates": ["mol_021", "mol_039", "mol_017", "mol_026", "mol_027", "mol_028"]}, {"pathway_id": "P8", "name": "Oxime-iron glycine supply with direct sulfide aldol recovery", "description": "Uses the same proposed oxime/iron glycine supply and explicit iron-removal gate as P7, followed by copper-glycinate aldol chemistry and direct sulfide release. The distinct terminal workup avoids acid dissociation but does not solve hydroxylamine supply, iron-mixture compatibility or product adsorption without measurements.", "reaction_sequence": ["rxn_020", "rxn_021", "rxn_018", "rxn_022", "rxn_023", "rxn_024", "rxn_027"], "key_intermediates": ["mol_021", "mol_039", "mol_017", "mol_026", "mol_027"]}, {"pathway_id": "P9", "name": "Sulfur-free reducing-discharge inventory and conditional recovery", "description": "Empirical benchmark based on threonine and allothreonine detection in methane/nitrogen/water discharge chemistry. The graph does not infer an unmeasured aldehyde delivery pathway. Its proposed lower-temperature acidic recovery and subsequent neutralization make free-target completion conditional rather than an established environmentally integrated synthesis.", "reaction_sequence": ["rxn_028", "rxn_010", "rxn_011"], "key_intermediates": ["mol_028", "mol_029"]}, {"pathway_id": "P10", "name": "H2S-rich reducing-discharge inventory and conditional recovery", "description": "Empirical benchmark using the reported H2S-rich Miller gas charge and three-day discharge. Threonine detection is supported, but a separate allothreonine inventory is not invented. Sulfur-electrode effects, analytical hydrolysis, contamination controls and recovery under the proposed milder conditions remain explicit limitations.", "reaction_sequence": ["rxn_029", "rxn_010"], "key_intermediates": ["mol_028"]}], "hub_molecules": ["mol_001", "mol_006", "mol_009", "mol_012", "mol_013", "mol_014", "mol_017", "mol_025", "mol_027", "mol_028", "mol_029", "mol_039"], "convergence_points": [{"molecule_id": "mol_009", "incoming_reactions": ["rxn_004", "rxn_030"], "outgoing_reactions": ["rxn_005", "rxn_024"]}, {"molecule_id": "mol_012", "incoming_re