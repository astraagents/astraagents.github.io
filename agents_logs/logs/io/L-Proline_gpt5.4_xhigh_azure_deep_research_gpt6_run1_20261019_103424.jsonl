rile\",\n      \"common_name\": \"beta-aminopropionitrile\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_012\",\n      \"formula\": \"C3H7NO\",\n      \"iupac_name\": \"3-aminopropanal\",\n      \"common_name\": \"beta-aminopropionaldehyde\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_013\",\n      \"formula\": \"C5H8N2\",\n      \"iupac_name\": \"pyrrolidine-2-carbonitrile\",\n      \"common_name\": null,\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_014\",\n      \"formula\": \"C5H9NO2\",\n      \"iupac_name\": \"pyrrolidine-2-carboxylic acid\",\n      \"common_name\": \"proline\",\n      \"inchi\": \"InChI=1S/C5H9NO2/c7-5(8)4-2-1-3-6-4/h4,6H,1-3H2,(H,7,8)\",\n      \"role\": \"hub_intermediate\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_015\",\n      \"formula\": \"C5H9NO2\",\n      \"iupac_name\": \"(2S)-pyrrolidine-2-carboxylic acid\",\n      \"common_name\": \"L-proline\",\n      \"inchi\": null,\n      \"role\": \"target\",\n      \"environment_formed\": \"Biochemical\"\n    }\n  ],\n  \"reactions\": [\n    {\n      \"id\": \"rxn_001\",\n      \"name\": \"Electric-discharge generation of hydrogen cyanide and ammonia\",\n      \"inputs\": [\"mol_001\", \"mol_002\"],\n      \"outputs\": [\"mol_005\", \"mol_004\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"silicate surface\"],\n      \"conditions\": {\n        \"temperature\": \"localized plasma; bulk 300-350K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"silicate surface effects possible\",\n        \"aqueous\": false,\n        \"other\": \"electrical discharge; strongly reducing local gas mixture; water vapor or condensed water may be present experimentally but is omitted from the minimal balanced bookkeeping\"\n      },\n      \"mechanism\": \"Plasma fragmentation of methane and dinitrogen generates CN-bearing radicals and reduced nitrogen species that recombine to hydrogen cyanide and ammonia.\",\n      \"reasoning\": \"Net source module for the HCN and NH3 inventory used elsewhere in the network. Ring et al. detected proline and many simpler nitrogen-bearing organics in CH4/N2/H2O/trace-NH3 discharge mixtures, implying abundant HCN-type intermediates, and vessel surfaces can materially change product distributions (Ring et al., 1972; Criado-Reyes et al., 2021). Atmospheric modeling also supports HCN production in some N2-rich atmospheres even without a globally methane-dominated atmosphere (Rugheimer and Rimmer, 2019). Because a globally CH4-rich atmosphere is contested, this reaction is assigned only to localized or transient reducing surface settings rather than global average Hadean air (Trail et al., 2011).\"\n    },\n    {\n      \"id\": \"rxn_002\",\n      \"name\": \"Energetic methane-water conversion to formaldehyde and reducing power\",\n      \"inputs\": [\"mol_001\", \"mol_003\"],\n      \"outputs\": [\"mol_006\", \"mol_008\"],\n      \"environment\": \"Surface\",\n      \"agents\": [],\n      \"conditions\": {\n        \"temperature\": \"280-350K bulk with energetic hot spots\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": false,\n        \"other\": \"energetic UV or discharge processing at gas-water interfaces; speculative bookkeeping source module for C1 carbonyls and H2\"\n      },\n      \"mechanism\": \"Energetic oxidation of methane-derived radicals by water-derived oxidants yields formaldehyde overall; excess reducing equivalents are represented as H2.\",\n      \"reasoning\": \"Speculative balanced source module included to connect methane-rich energetic chemistry to formaldehyde-dependent routes. Formaldehyde is a recurrent feedstock in experimentally supported proline 