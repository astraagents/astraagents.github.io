": "mol_025", "formula": "C5H8O3", "iupac_name": "methyl 3-oxobutanoate", "common_name": "Methyl acetoacetate", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_026", "formula": "HNO2", "iupac_name": "nitrous acid", "common_name": "Nitrous acid", "inchi": null, "role": "starting", "environment_formed": null}, {"id": "mol_027", "formula": "C5H7NO4", "iupac_name": "methyl 2-(hydroxyimino)-3-oxobutanoate", "common_name": "Methyl isonitrosoacetoacetate", "inchi": null, "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_028", "formula": "C5H9NO4", "iupac_name": "methyl 3-hydroxy-2-(hydroxyimino)butanoate", "common_name": "Methyl hydroxybutanoate oxime", "inchi": null, "role": "intermediate", "environment_formed": "Hydrothermal"}, {"id": "mol_029", "formula": "C5H9NO3", "iupac_name": "methyl 2-amino-3-oxobutanoate", "common_name": "Methyl 2-aminoacetoacetate", "inchi": null, "role": "intermediate", "environment_formed": "Hydrothermal"}, {"id": "mol_030", "formula": "C5H11NO3", "iupac_name": "methyl 2-amino-3-hydroxybutanoate", "common_name": "Methyl threoninate", "inchi": null, "role": "hub_intermediate", "environment_formed": "Hydrothermal"}, {"id": "mol_031", "formula": "C4H5NO4", "iupac_name": "2-(hydroxyimino)-3-oxobutanoic acid", "common_name": "Isonitrosoacetoacetic acid", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_032", "formula": "C4H7NO4", "iupac_name": "3-hydroxy-2-(hydroxyimino)butanoic acid", "common_name": "Hydroxybutanoic acid oxime", "inchi": null, "role": "intermediate", "environment_formed": "Hydrothermal"}], "reactions": [{"id": "rxn_001", "name": "Formaldehyde Strecker assembly of aminoacetonitrile", "inputs": ["mol_005", "mol_003", "mol_004"], "outputs": ["mol_008", "mol_001"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-325 K", "pressure": "Approximately 1 bar, restricted gas exchange", "catalyst": null, "aqueous": true, "other": "Ammonia/cyanide-bearing pool, pH 8-9.5; millimolar-to-tens-of-millimolar reactant screening range. Restricted headspace limits HCN and ammonia loss; shaded pores limit photodestruction."}, "mechanism": "Reversible formaldehyde-ammonia condensation followed by cyanide addition to the imine/iminium pool gives the aminonitrile.", "reasoning": "Strecker chemistry is an established amino-acid precursor reaction class (Strecker, 1850); that historical citation does not establish the proposed environmental concentrations. Formaldehyde hydration, cyanohydrin formation, and ammonia-formaldehyde oligomerization compete. Productive flux requires measured aminonitrile accumulation rather than assuming quantitative conversion."}, {"id": "rxn_002", "name": "Aminoacetonitrile hydration to glycinamide", "inputs": ["mol_008", "mol_001"], "outputs": ["mol_009"], "environment": "Surface", "agents": ["Hydronium from volcanic chloride acidity"], "conditions": {"temperature": "340-365 K", "pressure": "Approximately 1 bar", "catalyst": "Hydronium", "aqueous": true, "other": "Separate acidic pool, nominal pH 1-2; hours-to-weeks kinetic screening. Ammonia-rich synthesis solution must encounter sufficient acid capacity; intermediate amide accumulation is not assumed."}, "mechanism": "Protonation and water addition to the nitrile, followed by tautomerization, produce the amide.", "reasoning": "Nitrile-to-amide hydration is established chemistry. The proposed window requires substrate-specific rate measurements, including aminonitrile decomposition and subsequent amide hydrolysis. An acidic surface compartment is specified rather than treating all surface water as equivalent."}, {"id": "rxn_003", "name": "Glycinamide hydrolysis to glycine", "inputs": ["mol_009", "mol_001"], "outputs": ["mol_010", "mol_003"], "environment": "Surface", "agents": ["Hydronium from volcanic chloride acidity"], "conditions": {"temperature": "350-370 K", "pressure": "Approximately 1 bar", "catalyst": "Hydronium", "aqueous": true, "other": "Approximately 0.1-1 M acid, with days-to-weeks kinetic screening. Subsequent glycine aldol chemistry requires transport into a different, alkaline compartment."}, "mechanism": "Acid-catalyzed addition-elimination at the amide carbonyl releases the carboxylic acid and ammonia, present predominantly as ammonium in this compartment.", "reasoning": "Amide hydrolysis is established, but environmental acid supply and residence time must be sufficient. Glycine is considerably less structurally vulnerable than the later unsaturated or beta-hydroxy intermediates; this does not establish the downstream aldol reaction."}, {"id": "rxn_004", "name": "Alternative glycine supply by glyoxylate reductive amination", "inputs": ["mol_007", "mol_003", "mol_002"], "outputs": ["mol_010", "mol_001"], "environment": "Hydrothermal", "agents": ["Exposed native Ni-Fe alloy surfaces"], "conditions": {"temperature": "350-390 K", "pressure": "20-100 bar total; proposed H2 partial pressure 1-20 bar", "catalyst": "Native Ni-Fe alloy", "aqueous": true, "other": "Proposed screening window: pH 6.5-8.5, ammonia in excess, millimolar glyoxylate, sulfide-poor rock-water interface. Product must cool before surface concentration."}, "mechanism": "Ammonia forms an imine/hemiaminal ensemble with glyoxylate; metal-activated hydrogen reduces the carbon-nitrogen unsaturation.", "reasoning": "Reductive amination is established chemistry, and native Ni-Fe can activate hydrogen. This exact glyoxylate/alloy operating window is an unvalidated geochemical implementation, not a demonstrated yield claim. Direct carbonyl reduction, catalyst passivation, and limited native-alloy exposure compete. This pathway supplies glycine independently of cyanide but still shares the speculative aldol finish."}, {"id": "rxn_005", "name": "Candidate carbonyl-assisted glycine-acetaldehyde aldol addition", "inputs": ["mol_010", "mol_006"], "outputs": ["mol_018"], "environment": "Surface", "agents": ["Glyoxylate as a proposed reversible imine-forming catalyst", "Ligand-bound Fe2+ as a proposed Lewis-acid cocatalyst"], "conditions": {"temperature": "300-335 K", "pressure": "Approximately 1 bar, restricted headspace", "catalyst": "Proposed glyoxylate/Fe2+ carbonyl-catalysis system", "aqueous": true, "other": "Unvalidated screening window: pH 8.5-10, 10-100 mM glycine, 1-100 mM acetaldehyde, substoichiometric glyoxylate and Fe2+. Sulfide-poor shaded pool; Fe precipitation and aldehyde loss must be measured."}, "mechanism": "A transient glycine-derived imine would undergo alpha-carbon deprotonation, addition to acetaldehyde, and imine hydrolysis, regenerating the carbonyl catalyst.", "reasoning": "SPECULATIVE and a major bottleneck. The carbon-carbon bond construction is constitutionally correct, but no evidence supplied here establishes that glyoxylate/Fe2+ sufficiently activates free glycine under these conditions. Alpha-deprotonation may be too slow, and competing imine chemistry may dominate. This branch tests a direct skeleton-building alternative without assuming a pre-existing pyridoxal cofactor; it must not be presented as an established prebiotic threonine synthesis."}, {"id": "rxn_006", "name": "Candidate glycinamide-acetaldehyde aldol addition", "inputs": ["mol_009", "mol_006"], "outputs": ["mol_017"], "environment": "Surface", "agents": ["Glyoxylate as a proposed reversible imine-forming catalyst", "Ligand-bound Fe2+ as a proposed Lewis-acid cocatalyst"], "conditions": {"temperature": "300-335 K", "pressure": "Approximately 1 bar, restricted headspace", "catalyst": "Proposed glyoxylate/Fe2+ carbonyl-catalysis system", "aqueous": true, "other": "Unvalidated screening window: pH 8.5-10, concentrated glycinamide and acetaldehyde in a sulfide-poor pool. Acidic glycinamide-production solution must first be neutralized by a separate geological compartment."}, "mechanism": "Proposed imine-mediated alpha-carbon activation of glycinamide permits acetaldehyde addition; hydrolysis of the catalytic imine releases threoninamide.", "reasoning": "SPECULATIVE. Performing carbon-carbon bond formation before amide hydrolysis gives a chemically distinct intermediate sequence, but free glycinamide cannot simply be assumed to have adequate carbon nucleophilicity. Catalyst turnover, competing N-addition, aldol reversibility, and stereoisomer distribution require measurement. This is not independent validation of rxn_005."}, {"id": "rxn_007", "name": "Candidate aminoacetonitrile-acetaldehyde aldol addition", "inputs": ["mol_008", "mol_006"], "outputs": ["mol_016"], "environment": "Surface", "agents": ["Glyoxylate as a proposed reversible imine-forming catalyst", "Ligand-bound Fe2+ as a proposed Lewis-acid cocatalyst"], "conditions": {"temperature": "300-330 K", "pressure": "Approximately 1 bar, restricted headspace", "catalyst": "Proposed glyoxylate/Fe2+ carbonyl-catalysis system", "aqueous": true, "other": "Unvalidated screening window: pH 8.5-10; millimolar-to-tens-of-millimolar aminoacetonitrile and acetaldehyde. Avoid prolonged strong acid exposure before carbon-carbon coupling."}, "mechanism": "Proposed alpha-deprotonation of an aminoacetonitrile-derived imine, acetaldehyde addition, and imine hydrolysis give the beta-hydroxy aminonitrile.", "reasoning": "SPECULATIVE. The nitrile provides an electron-withdrawing group, but that does not demonstrate useful carbon-carbon coupling under weakly alkaline prebiotic conditions. Competing N-condensation and aminonitrile decomposition may dominate. This route evaluates skeleton assembly before carboxyl-group formation rather than introducing lactaldehyde as an unsupported common precursor."}, {"id": "rxn_008", "name": "Beta-hydroxy aminonitrile hydration", "inputs": ["mol_016", "mol_001"], "outputs": ["mol_017"], "environment": "Surface", "agents": ["Hydronium from volcanic chloride acidity"], "conditions": {"temperature": "335-360 K", "pressure": "Approximately 1 bar", "catalyst": "Hydronium", "aqueous": true, "other": "Proposed pH 1-2 screening window; time-resolved sampling is required over hours to weeks. Acid contact occurs only after aminonitrile-forming chemistry."}, "mechanism": "Acid-catalyzed nitrile hydration forms the corresponding carboxamide without changing the carbon skeleton.", "reasoning": "The reaction class is established, but recoverable conversion of this beta-hydroxy aminonitrile is not established by the network. Retro-Strecker chemistry, dehydration, and further hydrolysis must be quantified. A valid atom balance does not demonstrate survival of the substrate."}, {"id": "rxn_009", "name": "Threoninamide hydrolysis", "inputs": ["mol_017", "mol_001"], "outputs": ["mol_018", "mol_003"], "environment": "Surface", "agents": ["Hydronium from volcanic chloride acidity"], "conditions": {"temperature": "345-365 K", "pressure": "Approximately 1 bar", "catalyst": "Hydronium", "aqueous": true, "other": "Proposed 0.1-1 M acid window; days-to-weeks screening with simultaneous amino-acid recovery measurements. Cool and dilute after conversion rather than maintaining indefinite hot-acid exposure."}, "mechanism": "Amide hydrolysis releases the amino acid and ammonia/ammonium.", "reasoning": "Amide-to-acid conversion is chemically sound, but its useful operating window must be determined against beta-hydroxy amino-acid degradation. Neither complete conversion nor unchanged stereochemistry is assumed. This explicitly exposes the hydrolysis/survival requirement omitted by a generic environmental label."}, {"id": "rxn_010", "name": "Cross-aldol construction of 3-hydroxypropanal", "inputs": ["mol_005", "mol_006"], "outputs": ["mol_011"], "environment": "Surface", "agents": ["Hydroxide generated by alkaline water-rock buffering"], "conditions": {"temperature": "300-325 K", "pressure": "Approximately 1 bar, restricted gas exchange", "catalyst": "Hydroxide", "aqueous": true, "other": "Proposed pH 9.5-11 window; formaldehyde in excess over acetaldehyde; dilute-to-moderately concentrated shaded pool. Reaction mixture is transferred rather than assumed to contain pure product."}, "mechanism": "An acetaldehyde enolate adds to formaldehyde, giving the beta-hydroxy aldehyde.", "reasoning": "This is the correct aldol connectivity: the product is 3-hydroxypropanal, not lactaldehyde. Acetaldehyde self-aldol chemistry and further condensation compete, so environmental mixtures and actual selectivity must be measured. No mineral is added without a necessary catalytic role."}, {"id": "rxn_011", "name": "3-Hydroxypropanal dehydration to acrolein", "inputs": ["mol_011"], "outputs": ["mol_012", "mol_001"], "environment": "Surface", "agents": ["Hydronium from volcanic chloride acidity"], "conditions": {"temperature": "330-365 K", "pressure": "Approximately 1 bar", "catalyst": "Hydronium", "aqueous": true, "other": "Proposed pH 2-4 window during partial drying; short heated residence followed by cooling. Acrolein volatilization and polymerization preclude assuming quantitative transfer."}, "mechanism": "Acid-promoted elimination from the beta-hydroxy aldehyde gives the conjugated enal.", "reasoning": "Beta-hydroxy carbonyl dehydration is established chemistry. The stated sequence requires a real pH change from the preceding alkaline pool, plus acrolein retention. Hydration equilibrium and polymerization determine whether a usable acrolein flux exists."}, {"id": "rxn_012", "name": "Candidate acrolein Strecker assembly", "inputs": ["mol_012", "mol_003", "mol_004"], "outputs": ["mol_013", "mol_001"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-320 K", "pressure": "Approximately 1 bar, restricted headspace", "catalyst": null, "aqueous": true, "other": "Proposed pH 7.5-9 window; low acrolein concentration with continuous or pulsed delivery into ammonia/cyanide solution. Avoid storing concentrated acrolein."}, "mechanism": "Desired carbonyl imination followed by cyanide 1,2-addition gives an aminonitrile while retaining the alkene.", "reasoning": "SPECULATIVE substrate-specific implementation. Strecker chemistry supplies the reaction-class precedent (Strecker, 1850), not evidence for selective reaction of acrolein. Conjugate cyanide/ammonia addition and oligomerization are major competitors. Demonstrating useful yield of the specified unsaturated aminonitrile is a separate bottleneck before considering alkene hydration."}, {"id": "rxn_013", "name": "Unsaturated aminonitrile hydration to vinylglycinamide", "inputs": ["mol_013", "mol_001"], "outputs": ["mol_014"], "environment": "Surface", "agents": ["Hydronium from volcanic chloride acidity"], "conditions": {"temperature": "335-360 K", "pressure": "Approximately 1 bar", "catalyst": "Hydronium", "aqueous": true, "other": "Proposed pH 1-2 window; time-resolved screening must distinguish nitrile hydration, alkene reaction, and aminonitrile destruction."}, "mechanism": "Nitrile hydration gives the amide while the desired branch retains the carbon-carbon double bond.", "reasoning": "Nitrile hydration is established, but selective preservation of this unsaturated aminonitrile framework is unverified here. This edge denotes one possible reaction channel, not an assumption that the amide can be isolated cleanly under the stated conditions."}, {"id": "rxn_014", "name": "Vinylglycinamide hydrolysis", "inputs": ["mol_014", "mol_001"], "outputs": ["mol_015", "mol_003"], "environment": "Surface", "agents": ["Hydronium from volcanic chloride acidity"], "conditions": {"temperature": "345-365 K", "pressure": "Approximately 1 bar", "catalyst": "Hydronium", "aqueous": true, "other": "Proposed 0.1-1 M acid window; days-to-weeks screening. Analyze alkene retention, cyclization products, and amino-acid recovery concurrently."}, "mechanism": "Amide hydrolysis releases vinylglycine and ammonia/ammonium.", "reasoning": "The hydrolysis transformation is conventional, but a productive substrate-specific window has not been demonstrated here