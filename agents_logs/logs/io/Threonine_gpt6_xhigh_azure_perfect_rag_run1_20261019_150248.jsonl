on_name": "Threonine, stereochemistry unresolved", "inchi": "InChI=1S/C4H9NO3/c1-2(6)3(5)4(7)8/h2-3,6H,5H2,1H3,(H,7,8)", "role": "target", "environment_formed": "Surface"}], "reactions": [{"id": "rxn_001", "name": "Acetaldehyde cyanohydrin formation", "inputs": ["mol_006", "mol_003"], "outputs": ["mol_009"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-315 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Proposed mildly alkaline pool, approximately pH 8-9; cyanide is supplied by HCN dissociation. Replenishment or restricted gas exchange is needed to limit volatile-feedstock loss."}, "mechanism": "Cyanide adds to the acetaldehyde carbonyl, followed by proton transfer to form lactonitrile. The reaction is reversible and introduces one carbon.", "reasoning": "Cyanohydrin chemistry is consistent with the cyanosulfidic framework of Patel et al. (2015). The supplied review does not establish this particular upstream reaction under these conditions, so its environmental implementation is a speculative extension of established carbonyl chemistry. It supplies the correct C3 skeleton without invoking the review's incorrect suggestion that glycolaldehyde plus formaldehyde directly gives lactaldehyde."}, {"id": "rxn_002", "name": "Candidate photoreductive homologation of lactonitrile to lactaldehyde", "inputs": ["mol_009", "mol_004", "mol_001"], "outputs": ["mol_010", "mol_002", "mol_018"], "environment": "Surface", "agents": ["Soluble copper(I)-cyanide complexes as candidate photoredox catalysts"], "conditions": {"temperature": "300-315 K", "pressure": "Approximately 1 atm", "catalyst": "Copper(I)-cyanide complexes", "aqueous": true, "other": "Proposed anoxic UV-irradiated pool, approximately pH 7-9. Sulfide supplies reducing equivalents. Subsequent transfer into shaded water limits further photochemical destruction."}, "mechanism": "Proposed two-electron reduction of the nitrile to an imine followed by hydrolysis releases lactaldehyde and ammonia. Sulfide oxidation supplies the reducing equivalents; elemental sulfur closes the idealized net redox balance.", "reasoning": "Speculative substrate extension of the photoredox homologation chemistry associated with Patel et al. (2015), not a verified lactonitrile-to-lactaldehyde yield from the supplied material. Copper complexes are included for electron-transfer chemistry, not as generic mineral promoters. Copper-sulfide precipitation, cyanohydrin dissociation, overreduction, and photodecomposition may suppress the route. S8 represents an idealized zero-valent-sulfur endpoint; actual sulfur products could include polysulfides. Selectivity and the net sulfur balance require experimental verification."}, {"id": "rxn_003", "name": "Candidate hydroxyacetone-lactaldehyde isomerization", "inputs": ["mol_007"], "outputs": ["mol_010"], "environment": "Surface", "agents": ["Hydroxide ions as general-base catalysts"], "conditions": {"temperature": "300-330 K", "pressure": "Approximately 1 atm", "catalyst": "Hydroxide ions", "aqueous": true, "other": "Proposed pH 9-10.5. A separate, subsequently adjusted reaction zone would trap lactaldehyde with cyanide or ammonia. No favorable equilibrium or useful yield is assumed."}, "mechanism": "Base-catalyzed enediol or enediolate formation permits carbonyl migration between hydroxyacetone and lactaldehyde without changing molecular formula or carbon number.", "reasoning": "Speculative: the supplied literature does not demonstrate this substrate-specific prebiotic step. Alpha-hydroxycarbonyl isomerization provides a chemically valid alternative to introducing an unexplained lactaldehyde feedstock. The equilibrium may strongly favor hydroxyacetone, and competing aldol chemistry or degradation may dominate. This route is included as a testable low-confidence precursor alternative, not as evidence that lactaldehyde was abundant."}, {"id": "rxn_004", "name": "Carbon-correct lactaldehyde cyanohydrin formation", "inputs": ["mol_010", "mol_003"], "outputs": ["mol_011"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-315 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Proposed pH 8-9; sufficient dissolved cyanide and protection from prolonged destructive UV exposure. Lactaldehyde hydration and oligomerization affect available carbonyl concentration."}, "mechanism": "Cyanide adds to the aldehyde carbonyl of lactaldehyde, and proton transfer forms CH3-CH(OH)-CH(OH)-CN.", "reasoning": "The review attributes this reaction class to Patel et al. (2015), but its C5 product is structurally impossible for C3 lactaldehyde plus C1 HCN. The correct cyanohydrin is C4H7NO2, not C5H9NO2. This correction also removes the need for the alleged carbon-skeleton rearrangement in the subsequent step. Exact threonine-specific yields and stereoselectivity are not established by the supplied account."}, {"id": "rxn_005", "name": "Cyanohydrin-reservoir entry into threonine Strecker chemistry", "inputs": ["mol_011", "mol_002"], "outputs": ["mol_012", "mol_001"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-330 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Proposed ammonia-rich solution, approximately pH 8-10; sufficient residence time for reversible carbonyl, cyanohydrin, and imine equilibration."}, "mechanism": "The cyanohydrin can dissociate to lactaldehyde and HCN. Ammonia forms a transient imine or iminium species with the aldehyde, and cyanide addition gives the aminonitrile. The equation is the net conversion, not direct displacement of an unactivated hydroxyl group.", "reasoning": "This is the chemically defensible interpretation of the cyanohydrin-to-aminonitrile step attributed to Patel et al. (2015). No carbon is lost, and no skeletal rearrangement is required. The route shares imine chemistry with rxn_006 and therefore is an alternative reservoir-fed sequence rather than an independent reaction family. Competition between cyanohydrin reformation, imine hydrolysis, and aminonitrile degradation remains unresolved for this substrate."}, {"id": "rxn_006", "name": "Direct lactaldehyde Strecker assembly", "inputs": ["mol_010", "mol_002", "mol_003"], "outputs": ["mol_012", "mol_001"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-330 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Proposed ammonia-rich pool, approximately pH 8-9.5; controlled concentration rather than complete drying. This net node does not require accumulation of a separate cyanohydrin reservoir."}, "mechanism": "Lactaldehyde and ammonia reversibly form an imine or iminium species; cyanide addition supplies the future carboxyl carbon and produces 2-amino-3-hydroxybutanenitrile.", "reasoning": "General Strecker chemistry is consistent with the amino-acid precursor framework discussed by Patel et al. (2015). This direct-entry representation is chemically standard, but the supplied material does not independently verify its operating window or threonine-specific yield. Achiral reagents do not establish L selectivity, and both relative configurations of the adjacent stereocenters may form."}, {"id": "rxn_007", "name": "Hydration of threonine aminonitrile to threoninamide", "inputs": ["mol_012", "mol_001"], "outputs": ["mol_013"], "environment": "Surface", "agents": ["Hydronium ions as acid catalysts"], "conditions": {"temperature": "340-365 K", "pressure": "Approximately 1 atm", "catalyst": "Hydronium ions", "aqueous": true, "other": "Proposed anoxic acidic volcanic pool, approximately pH 1-2, for example supplied by volcanic chloride acidity. Free ammonia and cyanide formation stages must be temporally or spatially separated."}, "mechanism": "Acid-assisted water addition to the nitrile followed by proton transfers gives the primary amide while retaining the alpha-amino and beta-hydroxy groups.", "reasoning": "Stepwise aminonitrile hydrolysis is the reaction class invoked in the review's discussion of Patel et al. (2015). It does not justify assuming rapid hydrolysis at ambient temperature and neutral pH. The elevated temperature and acidity here are proposed acceleration conditions, not a verified substrate-specific protocol. Aminonitrile survival, competing hydrolysis pathways, and residence time are important bottlenecks."}, {"id": "rxn_008", "name": "Threoninamide hydrolysis to the threonine stereoisomer pool", "inputs": ["mol_013", "mol_001"], "outputs": ["mol_019", "mol_002"], "environment": "Surface", "agents": ["Hydronium ions as acid catalysts"], "conditions": {"temperature": "350-370 K", "pressure": "Approximately 1 atm", "catalyst": "Hydronium ions", "aqueous": true, "other": "Proposed pH 1-2 with prolonged aqueous residence, followed by cooling and dilution or neutralization. Released ammonia is predominantly ammonium under reaction conditions."}, "mechanism": "Water attacks the protonated amide carbonyl; collapse of the tetrahedral intermediate cleaves the carbon-nitrogen bond and produces the amino acid plus ammonia in neutral-form bookkeeping.", "reasoning": "This completes the general Strecker hydrolysis sequence discussed in connection with Patel et al. (2015). The amide is represented explicitly because its hydrolysis can be slower than initial nitrile hydration. The supplied literature does not establish useful rates at these proposed conditions. Thermal degradation and stereochemical changes must be measured; the thermal-instability concerns summarized from Vallentyne (1964) and Bada et al. (1978) argue against unnecessary heating."}, {"id": "rxn_009", "name": "Candidate carbon-dioxide trapping of threonine aminonitrile as a hydantoin", "inputs": ["mol_012", "mol_005"], "outputs": ["mol_014"], "environment": "Surface", "agents": null, "conditions": {"temperature": "320-355 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Proposed ammonia/ammonium-bicarbonate-rich solution, approximately pH 8-9.5, with sufficient dissolved inorganic carbon. CO2 represents the equilibrating inorganic-carbon pool."}, "mechanism": "Bucherer-Bergs-type carbamate formation, intramolecular cyclization involving the nitrile, and rearrangement yield 5-(1-hydroxyethyl)hydantoin. The added carbon becomes the removable ureide carbonyl, not part of the final threonine skeleton.", "reasoning": "Speculative relative to the supplied literature: no threonine-specific Bucherer-Bergs experiment is documented there. Standard hydantoin-forming chemistry nevertheless supplies a chemically grounded alternative fate for an alpha-aminonitrile, potentially changing storage stability and hydrolysis requirements. The beta-hydroxyl substituent may introduce competing cyclizations, and neither improved survival nor favorable yield is assumed."}, {"id": "rxn_010", "name": "Candidate hydrothermal hydrolysis and decarbamoylation of threonine hydantoin", "inputs": ["mol_014", "mol_001"], "outputs": ["mol_019", "mol_002", "mol_005"], "environment": "Hydrothermal", "agents": ["Hydroxide-rich alkaline fluid as a hydrolysis promoter"], "conditions": {"temperature": "390-420 K", "pressure": "Approximately 1-10 MPa; liquid water maintained", "catalyst": "General-base promotion by hydroxide; net base demand depends on product protonation", "aqueous": true, "other": "Proposed alkaline circulation zone, nominal pH 10-11 measured after cooling. The surface-formed hydantoin requires transport into heated water and prompt cooling afterward. The reaction node aggregates ring opening and subsequent decarbamoylation."}, "mechanism": "Hydantoin ring opening gives an N-carbamoyl amino-acid intermediate; subsequent hydrolysis and decarbamoylation release threonine, ammonia, and carbon dioxide. Two waters are required by the inferred neutral-form stoichiometry.", "reasoning": "Speculative: the supplied studies do not demonstrate this threonine-hydantoin hydrolysis under geochemical conditions. Hydantoin cleavage is chemically established as a reaction class but may require harsher conditions than an alkaline vent can provide efficiently. The extra heating step creates a serious competition between product formation and destruction, consistent with the thermal-instability concerns summarized from Vallentyne (1964) and Bada et al. (1978). The environmental transfer is included because this branch requires accelerated hydrolysis, not simply to connect settings."}, {"id": "rxn_011", "name": "Formaldehyde cyanohydrin formation", "inputs": ["mol_008", "mol_003"], "outputs": ["mol_015"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-315 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Mildly alkaline anoxic solution, approximately pH 8-9. Formaldehyde hydration is included implicitly in its aqueous speciation."}, "mechanism": "Cyanide addition to formaldehyde followed by proton transfer gives glycolonitrile.", "reasoning": "Formaldehyde-cyanide chemistry is consistent with the experimentally grounded cyanosulfidic framework of Patel et al. (2015). This branch supplies a C2 glycine precursor rather than assuming glycine as an unexplained input. Its inclusion does not validate the subsequent glycine-acetaldehyde aldol step, which remains explicitly speculative."}, {"id": "rxn_012", "name": "Glycolonitrile-reservoir entry into glycine Strecker chemistry", "inputs": ["mol_015", "mol_002"], "outputs": ["mol_016", "mol_001"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-330 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Proposed ammonia-rich aqueous solution, approximately pH 8-10, permitting cyanohydrin-carbonyl-imine equilibration."}, "mechanism": "Reversible glycolonitrile dissociation supplies formaldehyde and HCN. Imine formation with ammonia followed by cyanide addition produces aminoacetonitrile. Water is released in the net equation.", "reasoning": "This follows the general cyanohydrin/Strecker relationships associated with the amino-acid precursor chemistry discussed by Patel et al. (2015). As with rxn_005, the mechanism is not assumed to be direct substitution of hydroxide. The supplied review does not establish a quantitative rate or yield for this reservoir-fed conversion under the stated conditions."}, {"id": "rxn_013", "name": "Direct formaldehyde Strecker assembly of aminoacetonitrile", "inputs": ["mol_008", "mol_002", "mol_003"], "outputs": ["mol_016", "mol_001"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-330 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Ammonia-rich solution, approximately pH 8-9.5; excessive formaldehyde is avoided because oligomeric nitrogen-containing products can compete."}, "mechanism": "Formaldehyde and ammonia generate transient methanimine or methaniminium species; cyanide addition produces aminoacetonitrile.", "reasoning": "This is general Strecker chemistry consistent with the glycine-precursor framework discussed by Patel et al. (2015). It differs from rxn_011 followed by rxn_012 in precursor handling and reservoir formation, not in its fundamental imine-cyanide chemistry. The chosen environmental window is proposed rather than a verified end-to-end protocol."}, {"id": "rxn_014", "name": "Aminoacetonitrile hydrolysis to glycine", "inputs": ["mol_016", "mol_001"], "outputs": ["mol_017", "mol_002"], "environment": "Surface", "agents": ["Hydronium ions as acid catalysts"], "conditions": {"temperature": "350-370 K", "pressure": "Approximately 1 atm", "catalyst": "Hydronium ions", "aqueous": true, "other": "Proposed acidic volcanic pool, approximately pH 1-2, followed by cooling and pH adjustment before the aldol branch. This net node includes nitrile hydration and amide hydrolysis."}, "mechanism": "Sequential hydrolysis through glycinamide converts the nitrile carbon into the glycine carboxyl group and releases ammonia. Two waters are required by the inferred stoichiometry.", "reasoning": "Aminonitrile-to-amino-acid hydrolysis is consistent with the framework described by Patel et al. (2015). A warm acidic stage is specified rather than assuming rapid conversion in a cool neutral pond. Glycinamide is a transient mechanistic intermediate in this aggregated node; the endpoint still requires experimental residence-time and side-product measurements."}, {"id": "rxn_015", "name": "Exploratory glycine-acetaldehyde aldol addition", "inputs": ["mol_017", "mol_006"], "outputs": ["mol_019"], "environment": "Surface", "agents": ["Hydroxide ions as a candidate general-base promoter; effectiveness unestablished"], "conditions": {"temperature": "320-365 K", "pressure": "Approximately 1 atm", "catalyst": "Candidate hydroxide-assisted, transient-imine chemistry; no effective prebiotic catalyst established", "aqueous": true, "other": "Exploratory concentrated, anoxic, mildly alkaline solution, approximately pH 9-11, with acetaldehyde replenishment. No enzyme, pyridoxal cofactor, or unjustified metal catalyst is assumed. Useful flux is not established."}, "mechanism": "Hypothesized transient-imine-assisted activation of the glycine alpha carbon permits carbon-carbon bond formation with acetaldehyde; hydrolysis restores the amino group. This supplies the correct beta-hydroxy, alpha-amino C4 connectivity. Alpha-carbon activation is the unresolved mechanistic bottleneck.", "reasoning": "Speculative and low confidence. Glycine plus acetaldehyde is the connectivity-correct aldol pairing for threonine, but the supplied literature does not demonstrate useful nonenzymatic synthesis from this pair under these conditions. The retro-aldol instability discussed in the review, citing Vallentyne (1964) and Bada et al. (1978), motivates testing the reverse direction without proving it feasible. The review's alanine-plus-formaldehyde assignment to Aubrey et al. (2008) is not adopted: alpha-hydroxymethylation of alanine would instead give 2-amino-2-methyl-3-hydroxypropanoic acid. Weak glycine carbon nucleophilicity, decarboxylation, acetaldehyde self-reaction, and retro-aldol loss may make this proposed edge negligible."}], "pathways": [{"pathway_id": "P1", "name": "Photoreductive lactaldehyde supply, cyanohydrin reservoir, direct hydrolysis", "description": "Acetaldehyde supplies lactonitrile, candidate photoreduction supplies lactaldehyde, and the cyanohydrin-reservoir Strecker sequence reaches threonine through threoninamide. The substrate-specific photoreduction and overall yield remain unverified.", "reaction_sequence": ["rxn_001", "rxn_002", "rxn_004", "rxn_005", "rxn_007", "rxn_008"], "key_intermediates": ["mol_009", "mol_010", "mol_011", "mol_012", "mol_013"]}, {"pathway_id": "P2", "name": "Photoreductive lactaldehyde supply, direct Strecker entry, direct hydrolysis", "description": "The same candidate lactaldehyde supply enters Strecker chemistry without requiring accumulation of its cyanohydrin reservoir. Aminonitrile hydration and amide cleavage complete the target connectivity.", "reaction_sequence": ["rxn_001", "rxn_002", "rxn_006", "rxn_007", "rxn_008"], "key_intermediates": ["mol_009", "mol_010", "mol_012", "mol_013"]}, {"pathway_id": "P3", "name": "Photoreductive supply and cyanohydrin entry with hydantoin trapping", "description": "The cyanohydrin-fed aminonitrile is trapped using inorganic carbon before proposed hydrothermal hydantoin cleavage. Both the threonine-specific trapping step and useful hydrolysis under vent-compatible conditions are speculative.", "reaction_sequence": ["rxn_001", "rxn_002", "rxn_004", "rxn_005", "rxn_009", "rxn_010"], "key_intermediates": ["mol_009", "mol_010", "mol_011", "mol_012", "mol_014"]}, {"pathway_id": "P4", "name": "Photoreductive supply and direct Strecker entry with hydantoin trapping", "description": "Direct Strecker assembly follows candidate lactonitrile photoreduction. Hydantoin formation replaces direct aminonitrile hydrolysis, introducing an uncertain storage benefit and a substantial thermal-release bottleneck.", "reaction_sequence": ["rxn_001", "rxn_002", "rxn_006", "rxn_009", "rxn_010"], "key_intermediates": ["mol_009", "mol_010", "mol_012", "mol_014"]}, {"pathway_id": "P5", "name": "Carbonyl-isomerization supply, cyanohydrin reservoir, direct hydrolysis", "description": "Candidate hydroxyacetone isomerization supplies a potentially minor lactaldehyde fraction, which is captured through the cyanohydrin-reservoir sequence and hydrolyzed through threoninamide. Lactaldehyde availability is the upstream bottleneck.", "reaction_sequence": ["rxn_003", "rxn_004", "rxn_005", "rxn_007", "rxn_008"], "key_intermediates": ["mol_010", "mol_011", "mol_012", "mol_013"]}, {"pathway_id": "P6", "name": "Carbonyl-isomerization supply, direct Strecker entry, direct hydrolysis", "description": "Lactaldehyde generated by the speculative carbonyl-isomerization branch is intercepted directly by ammonia and cyanide, followed by sequential nitrile and amide hydrolysis.", "reaction_sequence": ["rxn_003", "rxn_006", "rxn_007", "rxn_008"], "key_intermediates": ["mol_010", "mol_012", "mol_013"]}, {"pathway_id": "P7", "name": "Carbonyl-isomerization supply and cyanohydrin entry with hydantoin trapping", "description": "The speculative isomerization supply feeds the cyanohydrin-reservoir route, followed by candidate hydantoin formation and heated cleavage. Multiple unresolved bottlenecks make this a hypothesis rather than an established synthesis.", "reaction_sequence": ["rxn_003", "rxn_004", "rxn_005", "rxn_009", "rxn_010"], "key_intermediates": ["mol_010", "mol_011", "mol_012", "mol_014"]}, {"pathway_id": "P8", "name": "Carbonyl-isomerization supply and direct Strecker entry with hydantoin trapping", "description": "Direct Strecker chemistry intercepts candidate isomerization-derived lactaldehyde. Inorganic-carbon trapping and subsequent hydantoin hydrolysis provide the alternative terminal processing sequence.", "reaction_sequence": ["rxn_003", "rxn_006", "rxn_009", "rxn_010"], "key_intermediates": ["mol_010", "mol_012", "mol_014"]}, {"pathway_id": "P9", "name": "Glycolonitrile-derived glycine followed by exploratory acetaldehyde addition", "description": "Formaldehyde is captured as glycolonitrile, converted into aminoacetonitrile, and hydrolyzed to glycine. The final glycine-acetaldehyde reaction is a connectivity-correct but kinetically unresolved aldol hypothesis; this is not a demonstrated threonine route.", "reaction_sequence": ["rxn_011", "rxn_012", "rxn_014", "rxn_015"], "key_intermediates": ["mol_015", "mol_016", "mol_017"]}, {"pathway_id": "P10", "name": "Direct-Strecker-derived glycine followed by exploratory acetaldehyde addition", "description": "Direct formaldehyde Strecker chemistry supplies the glycine precursor without a separate glycolonitrile-reservoir stage. The pathway shares the same unverified, potentially negligible-flux aldol endpoint as P9.", "reaction_sequence": ["rxn_013", "rxn_014", "rxn_015"], "key_intermediates": ["mol_016", "mol_017"]}], "hub_molecules": ["mol_010", "mol_012", "mol_016", "mol_019"], "convergence_points": [{"molecule_id": "mol_010", "incoming_reactions": ["rxn_002", "rxn_003"], "outgoing_reactions": ["rxn_004", "rxn_006"]}, {"molecule_id": "mol_012", "incoming_reactions": ["rxn_005", "rxn_006"], "outgoing_reactions": ["rxn_007", "rxn_009"]}, {"molecule_id": "mol_016", "incoming_reactions": ["rxn_012", "rxn_013"], "outgoing_reactions": ["rxn_014"]}, {"molecule_id": "mol_019", "incoming_reactions": ["rxn_008", "rxn_010", "rxn_015"], "outgoing_reactions": []}]}, "reasoning": "", "duration_ms": 415977.9818058014, "success": true, "error_message": null}
