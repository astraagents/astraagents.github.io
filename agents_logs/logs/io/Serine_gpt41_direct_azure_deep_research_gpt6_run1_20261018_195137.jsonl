ions\": {\n        \"temperature\": \"310\u2013360K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Neutral/slightly acidic; slow unless heated; possibly mineral surfaces\"\n      },\n      \"mechanism\": \"Nitrile hydrolyzed first to amide then to carboxylic acid.\",\n      \"reasoning\": \"Nitrile-to-amino acid hydrolysis directly established for this class (Miller 1957, kinetic studies; Sutherland et al. 2018); slow but spontaneous under prebiotic conditions.\"\n    },\n    {\n      \"id\": \"rxn_005\",\n      \"name\": \"Glycine formation via hydrothermal/photochemical routes\",\n      \"inputs\": [\"mol_001\", \"mol_002\", \"mol_003\"],\n      \"outputs\": [\"mol_008\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"370-420K\",\n        \"pressure\": \"high\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Moderate pH; possible metal ions\"\n      },\n      \"mechanism\": \"Strecker-type formation from formaldehyde, ammonia, and HCN; or photoreduction via HCN and formaldehyde.\",\n      \"reasoning\": \"Supported by atmospheric discharge and hydrothermal experiment (Miller 1957; Hennet et al. 1992 Naturwissenschaften; Patel et al. 2015).\"\n    },\n    {\n      \"id\": \"rxn_006\",\n      \"name\": \"Glycine + formaldehyde (hydroxymethylation) to serine\",\n      \"inputs\": [\"mol_008\", \"mol_001\"],\n      \"outputs\": [\"mol_007\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"330\u2013350K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"pH 3.3\u20133.7 or pH 6\u20138; no mineral required\"\n      },\n      \"mechanism\": \"C\u03b1 hydroxymethylation of glycine by formaldehyde.\",\n      \"reasoning\": \"Exp. demonstrated at both pH 3.3\u20133.7 a