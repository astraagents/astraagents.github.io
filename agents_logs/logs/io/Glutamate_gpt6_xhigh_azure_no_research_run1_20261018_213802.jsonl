emical"}, {"id": "mol_013", "formula": "CH2O", "iupac_name": "methanal", "common_name": "formaldehyde", "inchi": "InChI=1S/CH2O/c1-2/h1H2", "role": "starting", "environment_formed": null}, {"id": "mol_014", "formula": "CHN", "iupac_name": "hydrogen cyanide", "common_name": "hydrogen cyanide", "inchi": "InChI=1S/CHN/c1-2/h1H", "role": "starting", "environment_formed": null}, {"id": "mol_015", "formula": "C2H4N2", "iupac_name": "2-aminoacetonitrile", "common_name": "aminoacetonitrile", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_016", "formula": "C2H6N2O", "iupac_name": "2-aminoacetamide", "common_name": "glycinamide", "inchi": null, "role": "intermediate", "environment_formed": "Hydrothermal"}, {"id": "mol_017", "formula": "C2H5NO2", "iupac_name": "2-aminoacetic acid", "common_name": "glycine", "inchi": "InChI=1S/C2H5NO2/c3-1-2(4)5/h1,3H2,(H,4,5)", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_018", "formula": "C2H2O3", "iupac_name": "2-oxoacetic acid", "common_name": "glyoxylic acid", "inchi": "InChI=1S/C2H2O3/c3-1-2(4)5/h1H,(H,4,5)", "role": "starting", "environment_formed": null}, {"id": "mol_019", "formula": "C2H4O", "iupac_name": "ethanal", "common_name": "acetaldehyde", "inchi": "InChI=1S/C2H4O/c1-2-3/h2H,1H3", "role": "starting", "environment_formed": null}, {"id": "mol_020", "formula": "C3H6N2", "iupac_name": "2-aminopropanenitrile", "common_name": "alanine nitrile", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_021", "formula": "C3H8N2O", "iupac_name": "2-aminopropanamide", "common_name": "alaninamide", "inchi": null, "role": "intermediate", "environment_formed": "Hydrothermal"}, {"id": "mol_022", "formula": "C3H7NO2", "iupac_name": "2-aminopropanoic acid", "common_name": "DL-alanine", "inchi": "InChI=1S/C3H7NO2/c1-2(4)3(5)6/h2H,4H2,1H3,(H,5,6)", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_023", "formula": "C3H4O3", "iupac_name": "2-oxopropanoic acid", "common_name": "pyruvic acid", "inchi": "InChI=1S/C3H4O3/c1-2(4)3(5)6/h1H3,(H,5,6)", "role": "starting", "environment_formed": null}, {"id": "mol_024", "formula": "C4H4O5", "iupac_name": "2-oxobutanedioic acid", "common_name": "oxaloacetic acid", "inchi": null, "role": "starting", "environment_formed": null}, {"id": "mol_025", "formula": "C4H5NO5", "iupac_name": "2-(hydroxyimino)butanedioic acid", "common_name": "oxaloacetate oxime", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_026", "formula": "C4H7NO4", "iupac_name": "2-aminobutanedioic acid", "common_name": "DL-aspartic acid", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_027", "formula": "C4H6O3", "iupac_name": "4-oxobutanoic acid", "common_name": "succinic semialdehyde", "inchi": null, "role": "starting", "environment_formed": null}, {"id": "mol_028", "formula": "C5H8N2O2", "iupac_name": "4-amino-4-cyanobutanoic acid", "common_name": "glutamic acid alpha-aminonitrile", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_029", "formula": "C5H10N2O3", "iupac_name": "4,5-diamino-5-oxopentanoic acid", "common_name": "DL-isoglutamine, the alpha-amide of glutamic acid", "inchi": null, "role": "intermediate", "environment_formed": "Hydrothermal"}, {"id": "mol_030", "formula": "CH3N", "iupac_name": "methanimine", "common_name": "formaldimine", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_031", "formula": "C2H5N", "iupac_name": "ethanimine", "common_name": "acetaldimine", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_032", "formula": "C4H7NO2", "iupac_name": "4-iminobutanoic acid", "common_name": "succinic semialdehyde imine", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_033", "formula": "FeH2O2", "iupac_name": "iron(II) hydroxide", "common_name": "ferrous hydroxide", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_034", "formula": "CO2", "iupac_name": "carbon dioxide", "common_name": "carbon dioxide", "inchi": "InChI=1S/CO2/c2-1-3", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_035", "formula": "NH4+", "iupac_name": "azanium", "common_name": "ammonium", "inchi": "InChI=1S/H3N/h1H3/p+1", "role": "intermediate", "environment_formed": "Hydrothermal"}], "reactions": [{"id": "rxn_001", "name": "Reversible ammonia condensation with 2-oxoglutarate", "inputs": ["mol_001", "mol_002"], "outputs": ["mol_009", "mol_007"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-330 K", "pressure": "Approximately 1 atm in a retained aqueous compartment", "catalyst": null, "aqueous": true, "other": "Proposed pH 8.0-9.0; 1-10 mM ketoacid and 0.1-0.5 M total NH3/NH4+. Examine minutes-to-hours equilibration. Keep coupled to reduction rather than transferring an isolated imine; avoid evaporative ammonia loss."}, "mechanism": "Reference equation: C5H6O5 + NH3 -> C5H7NO4 + H2O. Ammonia addition gives a carbinolamine, followed by reversible dehydration. The imine is a transient equilibrium species, not an assumed accumulated feedstock.", "reasoning": "Abiotic reductive amination has reaction-class precedent in Huber and Wachtershauser (2003). That precedent does not establish the imine concentration in this proposed fluid. Hydration, imine hydrolysis and ammonium speciation must be measured; high total ammonia alone does not establish productive nitrogen incorporation."}, {"id": "rxn_002", "name": "Native-iron reduction of the 2-oxoglutarate imine", "inputs": ["mol_009", "mol_005", "mol_006"], "outputs": ["mol_011", "mol_008"], "environment": "Surface", "agents": ["Native iron, Fe(0), as a stoichiometric electron donor rather than a catalyst"], "conditions": {"temperature": "320-350 K", "pressure": "Approximately 1 atm under anoxic gas", "catalyst": null, "aqueous": true, "other": "Screen pH 6.5-8.0, 1-10 mM ketoacid-equivalent and 0.1-0.5 M total ammonia with freshly exposed Fe surfaces for 1-72 h. Maintain the imine-forming equilibrium in the same compartment. Quantify Fe dissolution, H2 evolution, soluble Fe(II), hydroxide precipitation and carbonyl-reduction products."}, "mechanism": "Reference equation: C5H7NO4 + Fe + 2 H+ -> C5H9NO4 + Fe2+. Iron supplies two electrons for C=N reduction. No stereoselective surface is assumed.", "reasoning": "Huber and Wachtershauser (2003) provide abiotic reductive-amination precedent; Muchowska, Varma and Moran (2019) support iron-based ketoacid-to-amino-acid chemistry more generally. The exact selectivity and operating window here remain conditional. Explicit Fe(0)/Fe(II) accounting replaces an unspecified reducing mineral, while rxn_027 represents a possible anoxic corrosion-product sink."}, {"id": "rxn_003", "name": "Candidate awaruite-catalyzed hydrogenation of the ketoacid imine", "inputs": ["mol_009", "mol_004"], "outputs": ["mol_011"], "environment": "Hydrothermal", "agents": ["Awaruite, approximately Ni3Fe, as a proposed heterogeneous hydrogenation catalyst"], "conditions": {"temperature": "350-390 K", "pressure": "5-10 MPa total; proposed H2 partial pressure 1-3 MPa", "catalyst": "Awaruite", "aqueous": true, "other": "Proposed room-temperature-equivalent pH 8-9; 1-10 mM ketoacid-equivalent, 0.1-0.5 M total ammonia and 0.1-1 g/L characterized mineral. Retained pore-water residence 1-48 h. Exclude sulfide-rich or strongly passivating coatings from the tested catalyst surface."}, "mechanism": "Reference equation: C5H7NO4 + H2 -> C5H9NO4. Proposed dissociative H2 activation and surface hydrogen transfer to an adsorbed imine.", "reasoning": "Exploratory. Preiner et al. (2020) support H2-driven geochemical catalysis involving awaruite, not this substrate-specific glutamate synthesis. Naming a hydrogen-activating mineral addresses catalyst identity but does not establish selective imine hydrogenation. Competing ketoacid hydrogenation, adsorption losses, sulfide poisoning and dilution require direct tests."}, {"id": "rxn_004", "name": "2-Oxoglutarate oxime formation", "inputs": ["mol_001", "mol_003"], "outputs": ["mol_010", "mol_007"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-330 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Proposed pH 4.5-6.5; 1-20 mM ketoacid and 1-3 molar equivalents hydroxylamine; sample over 0.5-24 h. Use a shaded pore or subsurface pool to limit photochemical destruction."}, "mechanism": "Reference equation: C5H6O5 + NH3O -> C5H7NO5 + H2O. Hydroxylamine addition and dehydration replace the keto oxygen with an oxime group.", "reasoning": "Oxime capture is chemically better defined than assuming a large aqueous ammonia-imine pool. Muchowska, Varma and Moran (2019) support the hydroxylamine/native-iron amino-acid synthesis strategy. The separated oxime node is a mechanistic representation, not a claim that it was isolated under the proposed conditions. Hydroxylamine supply remains a boundary assumption."}, {"id": "rxn_005", "name": "Native-iron reduction of 2-oxoglutarate oxime", "inputs": ["mol_010", "mol_005", "mol_006"], "outputs": ["mol_011", "mol_007", "mol_008"], "environment": "Surface", "agents": ["Native iron, Fe(0), as a stoichiometric reductant"], "conditions": {"temperature": "320-350 K", "pressure": "Approximately 1 atm under anoxic gas", "catalyst": null, "aqueous": true, "other": "Proposed pH 3.5-6.0 with an acidic chloride-bearing fluid; 1-20 mM oxime. At least two electron-donor equivalents of Fe are required per oxime, with excess needed if corrosion evolves H2. Screen 1-72 h and quench by cooling and mineral separation."}, "mechanism": "Reference equation: C5H7NO5 + 2 Fe + 4 H+ -> C5H9NO4 + H2O + 2 Fe2+. Four-electron reduction combines N-O bond cleavage with reduction of the C=N functionality.", "reasoning": "This is among the better-supported reaction classes in the network: Muchowska, Varma and Moran (2019) used hydroxylamine and metallic iron to access amino acids from ketoacid chemistry. Nevertheless, the proposed pH, residence time and environmental recovery are not validated here. Oxime disappearance must not be equated with glutamate yield."}, {"id": "rxn_006", "name": "Candidate awaruite-catalyzed oxime hydrogenation", "inputs": ["mol_010", "mol_004"], "outputs": ["mol_011", "mol_007"], "environment": "Hydrothermal", "agents": ["Awaruite, approximately Ni3Fe, as a proposed hydrogenation catalyst"], "conditions": {"temperature": "350-390 K", "pressure": "5-10 MPa total; proposed H2 partial pressure 1-3 MPa", "catalyst": "Awaruite", "aqueous": true, "other": "Proposed pH 6-8; 1-10 mM oxime and 0.1-1 g/L mineral; 1-48 h screening. Determine dissolved Ni/Fe and distinguish heterogeneous activity from leached-metal effects."}, "mechanism": "Reference equation: C5H7NO5 + 2 H2 -> C5H9NO4 + H2O. Proposed sequential N-O hydrogenolysis and C=N hydrogenation.", "reasoning": "Exploratory. Nickel-based oxime hydrogenation is a synthetic reaction class, but an engineered nickel catalyst cannot be treated as equivalent to natural awaruite. Preiner et al. (2020) support mineral H2 activation only at the broader reaction-class level. This branch requires substrate-specific proof of glutamate formation and catalyst survival."}, {"id": "rxn_007", "name": "Transient methanimine formation for glycine synthesis", "inputs": ["mol_013", "mol_002"], "outputs": ["mol_030", "mol_007"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-315 K", "pressure": "Approximately 1 atm in a closed or diffusion-restricted compartment", "catalyst": null, "aqueous": true, "other": "Proposed pH 8.5-9.3; 1-20 mM formaldehyde and 0.05-0.2 M total ammonia. Couple immediately to rxn_008 rather than isolating methanimine; examine minutes-to-hours residence."}, "mechanism": "Reference equation: CH2O + NH3 -> CH3N + H2O. Reversible carbinolamine formation and dehydration generate a low-abundance imine that can be trapped by cyanide.", "reasoning": "The Strecker reaction provides reaction-class precedent (Strecker, 1850). Formaldehyde hydration and ammonia-formaldehyde oligomerization compete strongly. Methanimine is included as a transient mechanistic species, not as a stable concentrated aqueous reservoir."}, {"id": "rxn_008", "name": "Cyanide capture of methanimine", "inputs": ["mol_030", "mol_014"], "outputs": ["mol_015"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-315 K", "pressure": "Approximately 1 atm in a retained liquid/headspace system", "catalyst": null, "aqueous": true, "other": "Same compartment as rxn_007; proposed pH 8.5-9.3 and 1-3 cyanide equivalents relative to initial formaldehyde. Screen 1-48 h. Avoid Fe-rich inflow, drying and uncontrolled HCN escape."}, "mechanism": "Reference equation: CH3N + HCN -> C2H4N2. Cyanide attack on the imine/iminium carbon forms the aminonitrile C-C bond.", "reasoning": "Supported at the Strecker reaction-class level (Strecker, 1850). Cyanide adds the carbon that becomes the glycine carboxyl group. Geochemical operation still depends on volatile retention and competition from cyanohydrin formation and cyanide polymerization."}, {"id": "rxn_009", "name": "Aminoacetonitrile hydration to glycinamide", "inputs": ["mol_015", "mol_007"], "outputs": ["mol_016"], "environment": "Hydrothermal", "agents": ["Hydronium from an acidic fluid"], "conditions": {"temperature": "380-410 K", "pressure": "2-5 MPa", "catalyst": "H+", "aqueous": true, "other": "Proposed room-temperature-equivalent pH 1-2; 1-20 mM aminonitrile; 6-72 h screening in a retained acidic pore. Remove or account for unreacted free cyanide before acidification. Measure both aminonitrile and amide."}, "mechanism": "Reference equation: C2H4N2 + H2O -> C2H6N2O. Acid-catalyzed nitrile hydration yields the primary amide.", "reasoning": "Nitrile hydrolysis is established Strecker chemistry (Strecker, 1850), but productive residence times in this proposed setting are unmeasured. The amide is explicit so that incomplete hydrolysis is not hidden in a single assumed conversion."}, {"id": "rxn_010", "name": "Glycinamide hydrolysis", "inputs": ["mol_016", "mol_007", "mol_006"], "outputs": ["mol_017", "mol_035"], "environment": "Hydrothermal", "agents": ["Hydronium from an acidic fluid"], "conditions": {"temperature": "390-410 K", "pressure": "2-5 MPa", "catalyst": "H+", "aqueous": true, "other": "Proposed room-temperature-equivalent pH 1-2; screen 1-7 days without assuming complete conversion. Cool below 330 K, neutralize through controlled rock-water mixing, and quantify dilution before transamination."}, "mechanism": "Reference equation: C2H6N2O + H2O + H+ -> C2H5NO2 + NH4+. Amide hydrolysis yields glycine and ammonium.", "reasoning": "Established amide-hydrolysis chemistry completes the Strecker sequence (Strecker, 1850, reaction-class precedent). The explicit ammonium product closes nitrogen and charge bookkeeping. Environmental acid capacity and retention time remain integration requirements."}, {"id": "rxn_011", "name": "Alternative glycine supply by glyoxylate reductive amination", "inputs": ["mol_018", "mol_002", "mol_005", "mol_006"], "outputs": ["mol_017", "mol_007", "mol_008"], "environment": "Surface", "agents": ["Native iron, Fe(0), as a stoichiometric reductant"], "conditions": {"temperature": "320-350 K", "pressure": "Approximately 1 atm under anoxic gas", "catalyst": null, "aqueous": true, "other": "Proposed pH 6.5-8.0; 1-20 mM glyoxylate and 0.1-0.5 M total ammonia; 1-72 h screening. Use fresh iron surfaces and distinguish glycine from glycolate. Separate residual metal before donor transfer."}, "mechanism": "Reference equation: C2H2O3 + NH3 + Fe + 2 H+ -> C2H5NO2 + H2O + Fe2+. A coupled condensation/reduction proceeds through a nonaccumulating imine; the node represents one-pot reductive amination rather than carbon-skeleton assembly.", "reasoning": "Huber and Wachtershauser (2003) provide abiotic reductive-amination precedent. This alternative avoids cyanide and hot nitrile hydrolysis, but substrate hydration, direct aldehyde reduction and iron passivation require measurement. Its use is conditional rather than a demonstrated improvement over the Strecker donor supply."}, {"id": "rxn_012", "name": "Candidate Fe(II)-assisted glycine-to-2-oxoglutarate transamination", "inputs": ["mol_017", "mol_001", "mol_008"], "outputs": ["mol_011", "mol_018", "mol_008"], "environment": "Surface", "agents": ["Soluble Fe2+ as a proposed Lewis-acid catalyst; no pyridoxal cofactor"], "conditions": {"temperature": "330-350 K", "pressure": "Approximately 1 atm under anoxic gas", "catalyst": "Fe2+", "aqueous": true, "other": "Proposed pH 6.5-7.5; 1-5 mM 2-oxoglutarate, 10-100 mM glycine and 0.1-1 mM measured soluble Fe(II); 6 h to 7 days. Measure forward and reverse rates, dissolved iron and rxn_027 precipitation. Strongly sulfide- or phosphate-rich fluids are incompatible with the assumed soluble catalyst."}, "mechanism": "Net reference equation: C2H5NO2 + C5H6O5 -> C2H2O3 + C5H9NO4. Proposed metal-bound Schiff-base formation, ketimine/aldimine proton transfer and hydrolysis transfer nitrogen without net redox. Fe2+ is explicitly conserved.", "reasoning": "Exploratory: no substrate-specific, PLP-free Fe(II) dataset is supplied here. A Lewis-acid-assisted mechanism is conceivable, but Fe(II) abundance alone does not establish a useful transamination rate. Glycine excess supplies a possible thermodynamic bias, not proof of glutamate flux. This is a bottleneck in P5 and P6."}, {"id": "rxn_013", "name": "Transient ethanimine formation for alanine synthesis", "inputs": ["mol_019", "mol_002"], "outputs": ["mol_031", "mol_007"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-315 K", "pressure": "Approximately 1 atm in a closed or diffusion-restricted compartment", "catalyst": null, "aqueous": true, "other": "Proposed pH 8.5-9.3; 1-20 mM acetaldehyde and 0.05-0.2 M total ammonia. Couple directly to rxn_014 over minutes to hours. Avoid prolonged alkaline storage and volatile loss."}, "mechanism": "Reference equation: C2H4O + NH3 -> C2H5N + H2O. Reversible aldehyde condensation gives ethanimine.", "reasoning": "The acetaldehyde-ammonia-cyanide sequence is the classical alanine Strecker framework (Strecker, 1850). The imine need not accumulate. Acetaldehyde aldol reactions and imine hydrolysis are competing processes that the proposed staging does not automatically eliminate."}, {"id": "rxn_014", "name": "Cyanide capture of ethanimine", "inputs": ["mol_031", "mol_014"], "outputs": ["mol_020"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-315 K", "pressure": "Approximately 1 atm in a retained liquid/headspace system", "catalyst": null, "aqueous": true, "other": "Proposed pH 8.5-9.3 with 1-3 cyanide equivalents relative to acetaldehyde; 1-48 h screening. Keep separate from Fe-rich fluids. Quantify cyanohydrin and oligomer formation."}, "mechanism": "Reference equation: C2H5N + HCN -> C3H6N2. Cyanide addition to the imine/iminium gives racemic alanine nitrile.", "reasoning": "This has direct reaction-class precedent in Strecker (1850). No enantioenrichment is expected. Feedstock retention and environmental concentrations, rather than carbon-skeleton ambiguity, are the main geochemical assumptions."}, {"id": "rxn_015", "name": "Alanine nitrile hydration", "inputs": ["mol_020", "mol_007"], "outputs": ["mol_021"], "environment": "Hydrothermal", "agents": ["Hydronium from an acidic fluid"], "conditions": {"temperature": "380-410 K", "pressure": "2-5 MPa", "catalyst": "H+", "aqueous": true, "other": "Proposed room-temperature-equivalent pH 1-2; 1-20 mM aminonitrile; 6-72 h screening. Do not acidify a stream containing unaccounted free cyanide."}, "mechanism": "Reference equation: C3H6N2 + H2O -> C3H8N2O. Acid-catalyzed nitrile hydration yields alaninamide.", "reasoning": "Established nitrile-hydrolysis chemistry in the alanine Strecker sequence (Strecker, 1850). Separating amide formation from its hydrolysis makes incomplete conversion experimentally visible rather than assigning quantitative amino-acid production to a hydrothermal label."}, {"id": "rxn_016", "name": "Alaninamide hydrolysis", "inputs": ["mol_021", "mol_007", "mol_006"], "outputs": ["mol_022", "mol_035"], "environment": "Hydrothermal", "agents": ["Hydronium from an acidic fluid"], "conditions": {"temperature": "390-410 K", "pressure": "2-5 MPa", "catalyst": "H+", "aqueous": true, "other": "Proposed room-temperature-equivalent pH 1-2; 1-7 days screening. Cool and neutralize before introducing Fe(II) or 2-oxoglutarate; measure recovered alanine after transport rather than using reactor yield alone."}, "mechanism": "Reference equation: C3H8N2O + H2O + H+ -> C3H7NO2 + NH4+. Acid-catalyzed amide cleavage yields alanine.", "reasoning": "Established amide-hydrolysis chemistry completes the classical Strecker transformation (Strecker, 1850, reaction-class precedent). Long retention, acid supply and recovery are environmental assumptions. No biological hydrolytic enzyme is invoked."}, {"id": "rxn_017", "name": "Alternative alanine supply by pyruvate reductive amination", "inputs": ["mol_023", "mol_002", "mol_005", "mol_006"], "outputs": ["mol_022", "mol_007", "mol_008"], "environment": "Surface", "agents": ["Native iron, Fe(0), as a stoichiometric reductant"], "conditions": {"temperature": "320-350 K", "pressure": "Approximately 1 atm under anoxic gas", "catalyst": null, "aqueous": true, "other": "Proposed pH 6.5-8.0; 1-20 mM pyruvate and 0.1-0.5 M total ammonia; 1-72 h screening. Quantify alanine against lactate and pyruvate-condensation products. Remove residual metal before donor transfer."}, "mechanism": "Reference equation: C3H4O3 + NH3 + Fe + 2 H+ -> C3H7NO2 + H2O + Fe2+. One-pot imine formation and reduction furnish racemic alanine.", "reasoning": "Abiotic ketoacid reductive amination has precedent in Huber and Wachtershauser (2003). This donor-supply branch avoids cyanide but not the ammonia-speciation and corrosion problems of reductive amination. The proposed numerical window requires testing and is not attributed to that paper."}, {"id": "rxn_018", "name": "Candidate Fe(II)-assisted alanine-to-2-oxoglutarate transamination", "inputs": ["mol_022", "mol_001", "mol_008"], "outputs": ["mol_011", "mol_023", "mol_008"], "environment": "Surface", "agents": ["Soluble Fe2+ as a proposed Lewis-acid catalyst; no pyridoxal cofactor"], "conditions": {"temperature": "330-350 K", "pressure": "Approximately 1 atm under anoxic gas", "catalyst": "Fe2+", "aqueous": true, "other": "Proposed pH 6.5-7.5; 1-5 mM 2-oxoglutarate, 10-100 mM alanine and 0.1-1 mM measured soluble Fe(II); 6 h to 7 days. Test reverse transfer and quantify pyruvate and glutamate simultaneously."}, "mechanism": "Net reference equation: C3H7NO2 + C5H6O5 -> C3H4O3 + C5H9NO4. Proposed metal-chelated Schiff-base formation, proton transfer and hydrolysis exchange amino and keto functionalities. Fe2+ is conserved.", "reasoning": "Exploratory: no validated PLP-free Fe(II) operating window for this exact pair is supplied. Pyruvate regeneration makes the material balance coherent but does not establish catalytic donor recycling. This is the principal unvalidated endpoint in P7 and P8, independent of how alanine is prepared."}, {"id": "rxn_019", "name": "Rapid oxaloacetate capture as its oxime", "inputs": ["mol_024", "mol_003"], "outputs": ["mol_025", "mol_007"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-310 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Proposed pH 4.5-6.0; freshly supplied 1-10 mM oxaloacetate and 2-5 equivalents hydroxylamine. Sample within minutes and over the first 2 h. Do not store or heat the untrapped ketoacid."}, "mechanism": "Reference equation: C4H4O5 + NH3O -> C4H5NO5 + H2O. Carbonyl condensation forms an oxime, competing with oxaloacetate decarboxylation.", "reasoning": "The hydroxylamine-capture strategy has reaction-class support in Muchowska, Varma and Moran (2019), but capture must outrun rxn_028. This network therefore does not assume oxaloacetate survives an unspecified hydrothermal transfer. Substrate-specific capture efficiency remains a required measurement."}, {"id": "rxn_020", "name": "Native-iron reduction of oxaloacetate oxime", "inputs": ["mol_025", "mol_005", "mol_006"], "outputs": ["mol_026", "mol_007", "mol_008"], "environment": "Surface", "agents": ["Native iron, Fe(0), as a stoichiometric reductant"], "conditions": {"temperature": "310-340 K", "pressure": "Approximately 1 atm under anoxic gas", "catalyst": null, "aqueous": true, "other": "Proposed pH 3.5-6.0; 1-10 mM trapped oxime with at least two Fe equivalents; 1-48 h screening. Monitor decarboxylation and verify aspartate independently of oxime consumption."}, "mechanism": "Reference equation: C4H5NO5 + 2 Fe + 4 H+ -> C4H7NO4 + H2O + 2 Fe2+. Four-electron oxime reduction gives racemic aspartate.", "reasoning": "Muchowska, Varma and Moran (2019) provide reaction-class support for hydroxylamine/native-iron amino-acid synthesis. The equation establishes electron balance, not yield. Preservation of the dicarboxylate skeleton and recovery of an effective donor concentration remain conditional."}, {"id": "rxn_021", "name": "Candidate Fe(II)-assisted aspartate-to-2-oxoglutarate transamination", "inputs": ["mol_026", "mol_001", "mol_008"], "outputs": ["mol_011", "mol_024", "mol_008"], "environment": "Surface", "agents": ["Soluble Fe2+ as a proposed Lewis-acid catalyst; no pyridoxal cofactor"], "conditions": {"temperature": "320-340 K", "pressure": "Approximately 1 atm under anoxic gas", "catalyst": "Fe2+", "aqueous": true, "other": "Proposed pH 6.5-7.5; 1-5 mM 2-oxoglutarate, 10-50 mM aspartate and 0.1-1 mM soluble Fe(II); 6 h to 7 days. Measure oxaloacetate, pyruvate, CO2 and glutamate, including rxn_028."}, "mechanism": "Net reference equation: C4H7NO4 + C5H6O5 -> C4H4O5 + C5H9NO4. Proposed Schiff-base-mediated nitrogen transfer regenerates oxaloacetate; Fe2+ is conserved.", "reasoning": "Exploratory: an exact, useful PLP-free Fe(II) transamination rate is not established here. Oxaloacetate decay could favor net transfer, but then the aspartate precursor is not sustainably recycled. Explicit rxn_028 prevents treating that possible thermodynamic pull as a loss-free donor shuttle."}, {"id": "rxn_022", "name": "Succinic semialdehyde imine formation", "inputs": ["mol_027", "mol_002"], "outputs": ["mol_032", "mol_007"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-315 K", "pressure": "Approximately 1 atm in a retained aqueous compartment", "catalyst": null, "aqueous": true, "other": "Proposed pH 8.5-9.3; 1-10 mM freshly supplied aldehyde and 0.05-0.2 M total ammonia. Couple directly to rxn_023 over minutes to hours; avoid warm aldehyde storage."}, "mechanism": "Reference equation: C4H6O3 + NH3 -> C4H7NO2 + H2O. Reversible aldehyde condensation creates the imine needed for Strecker carbon-carbon bond formation.", "reasoning": "Strecker (1850) supports the reaction class, not an integrated succinic-semialdehyde geochemical route. The C4 feedstock is explicitly supplied rather than produced by unvalidated conjugate hydrocyanation. Aldehyde hydration, oligomerization and availability remain substrate-specific constraints."}, {"id": "rxn_023", "name": "Strecker formation of the glutamic acid aminonitrile", "inputs": ["mol_032", "mol_014"], "outputs": ["mol_028"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-315 K", "pressure": "Approximately 1 atm in a retained liquid/headspace system", "catalyst": null, "aqueous": true, "other": "Proposed pH 8.5-9.3; 1-3 cyanide equivalents relative to the C4 aldehyde; 1-48 h screening. Keep Fe-rich waters separate and account for free cyanide before hydrolysis."}, "mechanism": "Reference equation: C4H7NO2 + HCN -> C5H8N2O2. Cyanide attacks the imine carbon. Its carbon becomes the alpha-carboxyl carbon of glutamate after hydrolysis; the original aldehyde carbon becomes the alpha-amino carbon.", "reasoning": "This is structurally standard Strecker chemistry, with reaction-class precedent in Strecker (1850). It does not require selective conjugate cyanide addition or preservation of an aldehyde during nitrile hydrolysis. Exact substrate-specific yield and environmental selectivity are not established by the supplied evidence."}, {"id": "rxn_024", "name": "Glutamic acid aminonitrile hydration to the alpha-amide", "inputs": ["mol_028", "mol_007"], "outputs": ["mol_029"], "environment": "Hydrothermal", "agents": ["Hydronium from an acidic fluid"], "conditions": {"temperature": "380-400 K", "pressure": "2-5 MPa", "catalyst": "H+", "aqueous": true, "other": "Proposed room-temperature-equivalent pH 1-2; 1-10 mM aminonitrile; 6-72 h screening. Remove or separately account for free cyanide before acidification. Measure aminonitrile, alpha-amide and cyclic products."}, "mechanism": "Reference equation: C5H8N2O2 + H2O -> C5H10N2O3. Nitrile hydration gives the alpha-carboxamide, isoglutamine, not the gamma-carboxamide glutamine.", "reasoning": "Established nitrile-hydrolysis chemistry supports the functional-group conversion, but a productive substrate-specific window remains conditional. The explicit alpha-amide prevents a formula-identical glutamine/isoglutamine identity error. Aldehyde retention is no longer required because the aldehyde was consumed in rxn_022."}, {"id": "rxn_025", "name": "Glutamic acid alpha-amide hydrolysis", "inputs": ["mol_029", "mol_007", "mol_006"], "outputs": ["mol_011", "mol_035"], "environment": "Hydrothermal", "agents": ["Hydronium from an acidic fluid"], "conditions": {"temperature": "380-400 K", "pressure": "2-5 MPa", "catalyst": "H+", "aqueous": true, "other": "Proposed room-temperature-equivalent pH 1-2; sample from 12 h to 7 days. Use the shortest productive residence, then cool below 330 K. Quantify pyroglutamate and other losses; no complete or selective conversion is assumed."}, "mechanism": "Reference equation: C5H10N2O3 + H2O + H+ -> C5H9NO4 + NH4+. Acid-catalyzed alpha-amide hydrolysis releases glutamic acid.", "reasoning": "The hydrolysis is chemically conventional, but glutamate-family substrates can undergo competing lactam formation during heating. No substrate-specific integrated dataset is supplied. This is an explicit endpoint bottleneck requiring product-resolved kinetics, rather than an asserted consequence of hydrothermal exposure."}, {"id": "rxn_026", "name": "Equilibration to predominantly monoanionic glutamate", "inputs": ["mol_011"], "outputs": ["mol_012", "mol_006"], "environment": "Biochemical", "agents": null, "conditions": {"temperature": "300-320 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Final pH 6.5-8 after cooling and finite-capacity neutralization by characterized mineral-water buffering. Assess free and metal-bound glutamate separately. No membrane, enzyme or biological machinery is required."}, "mechanism": "Reference equation: C5H9NO4 -> C5H8NO4- + H+. Acid-base equilibration gives predominantly two carboxylates and one protonated amino group, with net charge -1.", "reasoning": "This is ordinary acid-base chemistry, not a speculative synthesis step. It does not confer enantiomeric enrichment or reverse upstream product losses. The Biochemical label denotes the receiving prebiotic pool, not biological catalysis."}, {"id": "rxn_027", "name": "Competing anoxic ferrous hydroxide precipitation", "inputs": ["mol_008", "mol_007"], "outputs": ["mol_033", "mol_006"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-350 K", "pressure": "Approximately 1 atm under anoxic gas", "catalyst": null, "aqueous": true, "other": "Possible when free Fe(II) and hydroxide exceed saturation, particularly toward alkaline pH. Calculate saturation from measured activities and complexation. Carbonate-, sulfide- or phosphate-rich waters would require additional competing solid phases not represented here."}, "mechanism": "Reference equation: Fe2+ + 2 H2O -> FeH2O2(s) + 2 H+. Hydrolysis and precipitation remove soluble Fe(II); iron remains in oxidation state +2.", "reasoning": "This competing process explicitly addresses passivation and catalyst depletion without assigning an unsupported Fe(III) oxyhydroxide product under anoxic conditions. Ferrous hydroxide is a conditional corrosion-product sink, not a required organic-synthesis intermediate. Precipitation is not assumed quantitative."}, {"id": "rxn_028", "name": "Competing oxaloacetate decarboxylation", "inputs": ["mol_024"], "outputs": ["mol_023", "mol_034"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-350 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Competes during storage, oxime trapping and transamination. Rates depend strongly on pH, temperature and metal binding. Measure on the actual minutes-to-days residence times rather than assuming precursor stability."}, "mechanism": "Reference equation: C4H4O5 -> C3H4O3 + CO2. Beta-ketoacid decarboxylation followed by tautomerization produces pyruvate.", "reasoning": "Established beta-ketoacid chemistry accounts for the principal oxaloacetate stability problem. This edge closes the possible donor-loss route in P9 and makes clear that thermodynamic pulling by decarboxylation would consume the regenerable C4 precursor."}, {"id": "rxn_029", "name": "Ammonium-ammonia equilibration after hydrolysis", "inputs": ["mol_035"], "outputs": ["mol_002", "mol_006"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-330 K", "pressure": "Approximately 1 atm in a retained liquid/headspace system", "catalyst": null, "aqueous": true, "other": "Equilibration following cooling and pH adjustment. At pH below approximately 9, much of the total ammonia remains ammonium. Alkalinization increases NH3 availability and volatilization simultaneously; recovery is not assumed quantitative."}, "mechanism": "Reference equation: NH4+ -> NH3 + H+. Reversible acid-base dissociation is drawn toward the reactive neutral ammonia species.", "reasoning": "This established equilibrium prevents treating ammonium generated during acidic hydrolysis as automatically available free ammonia. It is a nitrogen-speciation connection, not an independent pathway counted toward the requested ten."}], "pathways": [{"pathway_id": "P1", "name": "Ammonia and native-iron reductive amination", "description": "Supplied 2-oxoglutarate undergoes ammonia condensation and Fe(0)-driven imine reduction. This avoids speculative carbon-skeleton construction, but integrated imine availability, selectivity and iron passivation remain conditional.", "reaction_sequence": ["rxn_001", "rxn_002", "rxn_026"], "key_intermediates": ["mol_009", "mol_011"]}, {"pathway_id": "P2", "name": "Ammonia and mineral-activated hydrogen", "description": "The ammonia-derived imine is hydrogenated over specified awaruite. Exploratory: mineral H2 activation has precedent, but selective glutamate formation from this imine is not established.", "reaction_sequence": ["rxn_001", "rxn_003", "rxn_026"], "key_intermediates": ["mol_009", "mol_011"]}, {"pathway_id": "P3", "name": "Hydroxylamine capture followed by native-iron reduction", "description": "Supplied 2-oxoglutarate is trapped as an oxime and reduced with explicitly balanced Fe(0) equivalents. This is among the better-supported reaction-class routes, conditional on hydroxylamine supply and environmental recovery.", "reaction_sequence": ["rxn_004", "rxn_005", "rxn_026"], "key_intermediates": ["mol_010", "mol_011"]}, {"pathway_id": "P4", "name": "Hydroxylamine capture followed by mineral hydrogenation", "description": "The oxime is reduced using H2 and awaruite rather than consumable native iron. Exploratory: N-O hydrogenolysis and amine selectivity on the natural mineral require direct demonstration.", "reaction_sequence": ["rxn_004", "rxn_006", "rxn_026"], "key_intermediates": ["mol_010", "mol_011"]}, {"pathway_id": "P5", "name": "Formaldehyde Strecker glycine donor route", "description": "Formaldehyde, ammonia and cyanide generate glycine through explicit nitrile and amide intermediates. Glycine then donates nitrogen to supplied 2-oxoglutarate. The donor synthesis has strong reaction-class precedent; the Fe(II)-assisted transamination endpoint remains exploratory.", "reaction_sequence": ["rxn_007", "rxn_008", "rxn_009", "rxn_010", "rxn_012", "rxn_026"], "key_intermediates": ["mol_030", "mol_015", "mol_016", "mol_017", "mol_011"]}, {"pathway_id": "P6", "name": "Glyoxylate reductive-amination donor route", "description": "Glyoxylate is reductively aminated to glycine without cyanide, followed by the same candidate nitrogen transfer to 2-oxoglutarate. This is distinct from P5 in donor preparation, not an independent C5-skeleton synthesis.", "reaction_sequence": ["rxn_011", "rxn_012", "rxn_026"], "key_intermediates": ["mol_017", "mol_011"]}, {"pathway_id": "P7", "name": "Acetaldehyde Strecker alanine donor route", "description": "Acetaldehyde undergoes Strecker conversion and stepwise hydrolysis to alanine. Candidate Fe(II)-assisted transamination then produces glutamate and pyruvate. The endpoint, not the classical donor skeleton construction, is the main unresolved step.", "reaction_sequence": ["rxn_013", "rxn_014", "rxn_015", "rxn_016", "rxn_018", "rxn_026"], "key_intermediates": ["mol_031", "mol_020", "mol_021", "mol_022", "mol_011"]}, {"pathway_id": "P8", "name": "Pyruvate reductive-amination alanine donor route", "description": "Pyruvate is reductively aminated to alanine, which transfers nitrogen to 2-oxoglutarate in a 