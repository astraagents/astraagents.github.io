cid", "common_name": "isocitrate", "inchi": null, "role": "starting", "environment_formed": "Surface"}, {"id": "mol_015", "formula": "C6H6O7", "iupac_name": "oxalosuccinic acid", "common_name": "oxalosuccinate", "inchi": null, "role": "starting", "environment_formed": "Surface"}], "reactions": [{"id": "rxn_001", "name": "Citrate dehydration to cis-aconitate", "inputs": ["mol_012"], "outputs": ["mol_013", "mol_002"], "environment": "Surface", "agents": ["Fe2+", "silica surface"], "conditions": {"temperature": "340-370K", "pressure": "1 atm", "catalyst": "Fe2+ on silica-rich mineral surfaces", "aqueous": true, "other": "anoxic, UV-shielded geothermal film; partial drying favors dehydration"}, "mechanism": "Mineral-assisted elimination of water from citrate to form the unsaturated tricarboxylate cis-aconitate.", "reasoning": "Citrate dehydration is one of the simpler non-enzymatic TCA-like interconversions under hot, mineral-rich conditions. Writing this as a separate node keeps water bookkeeping explicit and avoids hiding dehydration inside a later rearrangement."}, {"id": "rxn_002", "name": "cis-Aconitate hydration to isocitrate", "inputs": ["mol_013", "mol_002"], "outputs": ["mol_014"], "environment": "Surface", "agents": ["Fe2+", "silica surface"], "conditions": {"temperature": "320-350K", "pressure": "1 atm", "catalyst": "Fe2+ on silica-rich mineral surfaces", "aqueous": true, "other": "anoxic rewetting phase in the same geothermal setting"}, "mechanism": "Mineral-surface hydration of the C=C bond of cis-aconitate to regenerate a C6 tricarboxylate alcohol, tracked here as isocitrate.", "reasoning": "Aconitate can rehydrate non-enzymatically; the key limitation is regioselectivity because citrate is a plausible competing product. This branch is retained because some isocitrate formation is chemically reasonable in a mineral-controlled setting and it provides a transparent route to oxalosuccinate."}, {"id": "rxn_003", "name": "Isocitrate dehydrogenation to oxalosuccinate", "inputs": ["mol_014"], "outputs": ["mol_015", "mol_001"], "environment": "Surface", "agents": ["NiFe sulfide", "magnetite"], "conditions": {"temperature": "340-370K", "pressure": "1 atm", "catalyst": "NiFe sulfide and magnetite surfaces", "aqueous": true, "other": "anoxic mineral film or pore water; evolved H2 can escape locally"}, "mechanism": "Surface-mediated alcohol-to-ketone dehydrogenation of isocitrate, with H2 as the explicit electron sink, giving oxalosuccinate.", "reasoning": "This step makes the redox partner explicit rather than leaving oxidation unspecified. Dehydrogenation on H2-activating metal or sulfide surfaces is chemically plausible, though less secure than simple hydration or dehydration steps; it is included because oxalosuccinate is the correct beta-keto precursor to alpha-ketoglutarate."}, {"id": "rxn_004", "name": "Oxalosuccinate decarboxylation to alpha-ketoglutarate", "inputs": ["mol_015"], "outputs": ["mol_007", "mol_003"], "environment": "Surface", "agents": [], "conditions": {"temperature": "330-360K", "pressure": "1 atm", "catalyst": null, "aqueous": true, "other": "warm anoxic geothermal pore water; decarboxylation aided by heating"}, "mechanism": "Thermal decarboxylation of a beta-keto tricarboxylic acid equivalent to yield the C5 alpha-keto diacid alpha-ketoglutarate.", "reasoning": "Once oxalosuccinate is present, decarboxylation to alpha-ketoglutarate is the strongest step in the C6 lineage. The beta-ketoacid-like motif makes CO2 loss mechanistically straightforward and thermodynamically favorable."}, {"id": "rxn_005", "name": "Pyruvate-glyoxylate aldol addition to 4-hydroxy-2-oxoglutarate", "inputs": ["mol_008", "mol_009"], "outputs": ["mol_010"], "environment": "Surface", "agents": ["Fe2+"], "conditions": {"temperature": "320-350K", "pressure": "1 atm", "catalyst": "dissolved Fe2+", "aqueous": true, "other": "anoxic, Fe2+-rich geothermal water; mineral films provide UV shielding"}, "mechanism": "Fe2+-promoted aldol-type C-C bond formation between pyruvate and glyoxylate to give a C5 beta-hydroxy alpha-keto diacid.", "reasoning": "This is among the better-supported prebiotic entries into metabolism-like C5 chemistry. Making 4-hydroxy-2-oxoglutarate explicit avoids the earlier over-compressed pyruvate-plus-glyoxylate-to-alpha-ketoglutarate shortcut and keeps atom balance transparent."}, {"id": "rxn_006", "name": "4-Hydroxy-2-oxoglutarate dehydration to 2-oxopent-3-enedioate", "inputs": ["mol_010"], "outputs": ["mol_011", "mol_002"], "environment": "Surface", "agents": ["silica surface", "Fe2+"], "conditions": {"temperature": "340-370K", "pressure": "1 atm", "catalyst": "silica-rich mineral surfaces with Fe2+", "aqueous": true, "other": "partial drying on hot mineral surfaces under anoxic conditions"}, "mechanism": "Dehydration of the beta-hydroxy alpha-keto diacid to an unsaturated alpha-keto diacid.", "reasoning": "Beta-hydroxy keto diacids should dehydrate more readily than they should undergo direct one-step deoxygenation. This explicit dehydration step is included to avoid hiding the water loss and to make the downstream hydrogenation chemically more credible."}, {"id": "rxn_007", "name": "2-Oxopent-3-enedioate hydrogenation to alpha-ketoglutarate", "inputs": ["mol_011", "mol_001"], "outputs": ["mol_007"], "environment": "Surface", "agents": ["NiFe sulfide"], "conditions": {"temperature": "340-370K", "pressure": "1 atm", "catalyst": "NiFe sulfide", "aqueous": true, "other": "H2-rich geothermal gas input over metal-sulfide grains"}, "mechanism": "Mineral-catalyzed hydrogenation of the C=C bond in the unsaturated alpha-keto diacid to produce alpha-ketoglutarate.", "reasoning": "Hydrogenation of an alkene on H2-activating sulfide surfaces is chemically cleaner than invoking an unspecified deoxygenation. This step provides explicit redox bookkeeping for the pyruvate-glyoxylate branch, though it remains less directly demonstrated than the initial aldol addition."}, {"id": "rxn_008", "