e": "2-oxoacetic acid", "common_name": "glyoxylate", "inchi": null, "role": "starting", "environment_formed": null}, {"id": "mol_006", "formula": "C3H4O3", "iupac_name": "2-oxopropanoic acid", "common_name": "pyruvate", "inchi": null, "role": "hub_intermediate", "environment_formed": "Hydrothermal"}, {"id": "mol_007", "formula": "C5H6O5", "iupac_name": "2-oxopentanedioic acid", "common_name": "alpha-ketoglutarate", "inchi": null, "role": "hub_intermediate", "environment_formed": "Hydrothermal"}, {"id": "mol_008", "formula": "NH3", "iupac_name": "azane", "common_name": "ammonia", "inchi": null, "role": "starting", "environment_formed": null}, {"id": "mol_009", "formula": "H2", "iupac_name": "dihydrogen", "common_name": "hydrogen", "inchi": null, "role": "starting", "environment_formed": null}, {"id": "mol_010", "formula": "C5H9NO4", "iupac_name": "2-aminopentanedioic acid", "common_name": "glutamate", "inchi": null, "role": "target", "environment_formed": null}], "reactions": [{"id": "rxn_001", "name": "Succinate dehydrogenation to fumarate", "inputs": ["mol_001"], "outputs": ["mol_002"], "environment": "Hydrothermal", "agents": ["magnetite"], "conditions": {"temperature": "380-430K", "pressure": "high", "catalyst": "magnetite", "aqueous": true, "other": "anoxic subseafloor pores with mixed-valence iron redox cycling"}, "mechanism": "Mineral-mediated dehydrogenation of the saturated dicarboxylate to the trans-unsaturated dicarboxylate.", "reasoning": "Succinate and fumarate form a chemically credible redox pair in iron-rich vent systems. The oxidation is slower than neighboring hydration chemistry and is a plausible upstream bottleneck, but mixed-valence iron oxides provide a realistic anoxic electron sink."}, {"id": "rxn_002", "name": "Fumarate hydration to malate", "inputs": ["mol_002"], "outputs": ["mol_003"], "environment": "Hydrothermal", "agents": ["Fe2+"], "conditions": {"temperature": "340-390K", "pressure": "high", "catalyst": "Fe2+", "aqueous": true, "other": "hot vent fluids after partial cooling"}, "mechanism": "Water adds across the activated C=C bond of fumarate to give malate.", "reasoning": "Hydration of fumarate is one of the more straightforward members of prebiotic dicarboxylate chemistry. Hot aqueous conditions are sufficient, and dissolved ferrous iron can assist by coordinating the dicarboxylate."}, {"id": "rxn_003", "name": "Malate oxidation to oxaloacetate", "inputs": ["mol_003"], "outputs": ["mol_004"], "environment": "Hydrothermal", "agents": ["magnetite"], "conditions": {"temperature": "380-430K", "pressure": "high", "catalyst": "magnetite", "aqueous": true, "other": "anoxic vent-wall mineral surfaces with Fe2+/Fe3+ cycling"}, "mechanism": "Iron-coordinated oxidation converts the alpha-hydroxy dicarboxylate to the corresponding alpha-keto dicarboxylate.", "reasoning": "Malate/oxaloacetate is a standard hydroxy-acid/keto-acid pair. Iron minerals are well suited to mediate such interconversions under anoxic hydrothermal redox cycling, even if oxaloacetate remains transient because of its lability."}, {"id": "rxn_004", "name": "Thermal decarboxylation of oxaloacetate to pyruvate", "inputs": ["mol_004"], "outputs": ["mol_006"], "environment": "Hydrothermal", "agents": ["Fe2+"], "conditions": {"temperature": "330-380K", "pressure": "high", "catalyst": "Fe2+", "aqueous": true, "other": "rapid turnover of unstable oxaloacetate in heated vent fluids"}, "mechanism": "Oxaloacetate undergoes beta-keto-acid-type decarboxylation after keto-enol tautomerization to furnish pyruvate.", "reasoning": "Oxaloacetate is intrinsically decarboxylation-prone under heating. This funnels unstable C4 keto-acid pools into the better-supported pyruvate/glyoxylate network instead of requiring long-lived oxaloacetate accumulation."}, {"id": "rxn_005", "name": "Fe2+-promoted pyruvate-glyoxylate coupling to 2-oxoglutarate", "inputs": ["mol_006", "mol_005"], "outputs": ["mol_007"], "environment": "Hydrothermal", "agents": ["Fe2+"], "conditions": {"temperature": "350-400K", "pressure": "high", "catalyst": "Fe2+", "aqueous": true, "other": "Fe2+-rich hydrothermal mixing zone; carbonyls kept below destructive temperatures"}, "mechanism": "Pyruvate enolization and aldol addition to glyoxylate are followed by oxidation/dehydration steps that net to the C5 alpha-keto diacid.", "reasoning": "Pyruvate-glyoxylate chemistry is among the strongest experimentally supported nonenzymatic entries into metabolism-like C5 products. Represented here as a net step, it plausibly proceeds through transient hydroxy-keto intermediates before giving 2-oxoglutarate."}, {"id": "rxn_006", "name": "Hydrothermal H2-driven reductive amination of 2-oxoglutarate", "inputs": ["mol_007", "mol_008", "mol_009"], "outputs": ["mol_010"], "environment": "Hydrothermal", "agents": ["mackinawite", "greigite"], "conditions": {"temperature": "370-430K", "pressure": "high", "catalyst": "mackinawite/greigite", "aqueous": true, "other": "H2-rich alkaline vent conditions with dissolved ammonia and strong redox gradients"}, "mechanism": "Ammonia forms an imine or iminium equivalent with 2-oxoglutarate, which is then reduced on Fe-S mineral surfaces by vent-derived hydrogen.", "reasoning": "2-Oxoglutarate is the exact alpha-keto precursor of glutamate, so reductive amination is the most direct carbon-conserving terminal step. H2-rich vents and Fe-S minerals provide a geochemically strong setting for this transformation."}, {"id": "rxn_007", "name": "UV-driven ZnS photoreductive amination of 2-oxoglutarate", "inputs": ["mol_007", "mol_008"], "outputs": ["mol_010"], "environment": "Surface", "agents": ["ZnS"], "conditions": {"temperature": "300-340K", "pressure": "1 atm", "catalyst": "ZnS", "aqueous": true, "other": "UV-irradiated sulfur-rich hot spring or evaporitic pool; ammonium concentrated during drying-rewetting cycles"}, "mechanism": "A 2-oxoglutarate-ammonia imine is reduced by photoexcited sulfide-semiconductor electrons and then protonated to release glutamate.", "reasoning": "Early Earth surface UV and sulfide semiconductors offer a distinct non-vent source of reducing power. This photoreductive amination is more speculative than hydrothermal H2-driven reduction, but it is chemically defensible because imines are more readily reduced than the parent keto acid."}], "pathways": [{"pathway_id": "P1", "name": "Succinate lineage with hydrothermal amination", "description": "Entry from succinate; oxidation and hydration give malate and oxaloacetate, oxaloacetate decarboxylates to pyruvate, pyruvate couples with glyoxylate to 2-oxoglutarate, and vent H2/NH3 chemistry yields glutamate.", "reaction_sequence": ["rxn_001", "rxn_002", "rxn_003", "rxn_004", "rxn_005", "rxn_006"], "key_intermediates": ["mol_002", "mol_003", "mol_004", "mol_006", "mol_007"]}, {"pathway_id": "P2", "name": "Fumarate lineage with hydrothermal amination", "description": "Entry from exogenous fumarate; hydration, oxidation, decarboxylation, and pyruvate-glyoxylate coupling build 2-oxoglutarate, followed by hydrothermal reductive amination to glutamate.", "reaction_sequence": ["rxn_002", "rxn_003", "rxn_004", "rxn_005", "rxn_006"], "key_intermediates": ["mol_003", "mol_004", "mol_006", "mol_007"]}, {"pathway_id": "P3", "name": "Malate lineage with hydrothermal amination", "description": "Entry from exogenous malate; oxidation to oxaloacetate and decarboxylation to pyruvate feed the pyruvate-glyoxylate route to 2-oxoglutarate, then hydrothermal amination gives glutamate.", "reaction_sequence": ["rxn_003", "rxn_004", "rxn_005", "rxn_006"], "key_intermediates": ["mol_004", "mol_006", "mol_007"]}, {"pathway_id": "P4", "name": "Oxaloacetate lineage with hydrothermal amination", "description": "Entry from exogenous oxaloacetate; thermal decarboxylation gives pyruvate, Fe2+-mediated coupling with glyoxylate gives 2-oxoglutarate, and hydrothermal H2-driven amination yields glutamate.", "reaction_sequence": ["rxn_004", "rxn_005", "rxn_006"], 