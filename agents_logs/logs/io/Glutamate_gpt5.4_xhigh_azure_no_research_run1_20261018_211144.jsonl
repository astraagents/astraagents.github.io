h formate amination", "description": "Direct beta-ketoacid decarboxylation entry from oxalosuccinate, then formate-driven amination.", "reaction_sequence": ["rxn_004", "rxn_009"], "key_intermediates": ["mol_007"]}, {"pathway_id": "P9", "name": "Pyruvate-glyoxylate route with H2 amination", "description": "A C2+C3 condensation branch: aldol addition, dehydration, hydrogenation to alpha-ketoglutarate, then H2-driven amination.", "reaction_sequence": ["rxn_005", "rxn_006", "rxn_007", "rxn_008"], "key_intermediates": ["mol_010", "mol_011", "mol_007"]}, {"pathway_id": "P10", "name": "Pyruvate-glyoxylate route with formate amination", "description": "The pyruvate-glyoxylate branch paired with formate-driven terminal amination to glutamate.", "reaction_sequence": ["rxn_005", "rxn_006", "rxn_007", "rxn_009"], "key_intermediates": ["mol_010", "mol_011", "mol_007"]}], "hub_molecules": ["mol_007"], "convergence_points": [{"molecule_id": "mol_007", "incoming_reactions": ["rxn_004", "rxn_007"], "outgoing_reactions": ["rxn_008", "rxn_009"]}]}, "reasoning": "", "duration_ms": 681919.8217391968, "success": true, "error_message": null}
