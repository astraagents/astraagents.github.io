ntanedinitrile\",\n      \"common_name\": null,\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_015\",\n      \"formula\": \"C5H9NO4\",\n      \"iupac_name\": \"2-aminopentanedioic acid\",\n      \"common_name\": \"glutamate\",\n      \"inchi\": \"InChI=1S/C5H9NO4/c6-3-1-2-4(7)5(8)9/h1-3,6H2,(H,7,8,9)\",\n      \"role\": \"target\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_016\",\n      \"formula\": \"C6H7N3O3\",\n      \"iupac_name\": \"5-carboxyethylhydantoin\",\n      \"common_name\": null,\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_017\",\n      \"formula\": \"NH2OH\",\n      \"iupac_name\": \"hydroxylamine\",\n      \"common_name\": null,\n      \"inchi\": \"InChI=1S/H3NO/c1-2/h2H,1H2\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Hydrothermal\"\n    },\n    {\n      \"id\": \"mol_018\",\n      \"formula\": \"NADH\",\n      \"iupac_name\": \"reduced nicotinamide adenine dinucleotide\",\n      \"common_name\": null,\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Biochemical\"\n    },\n    {\n      \"id\": \"mol_019\",\n      \"formula\": \"C6H10NO3\",\n      \"iupac_name\": \"N-succinyl-L-glutamic acid\",\n      \"common_name\": \"N-succinylglutamate\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_020\",\n      \"formula\": \"C5H10N2O2\",\n      \"iupac_name\": \"5-aminopentanamide\",\n      \"common_name\": \"glutamine (if fully hydrolyzed); here, generalized amide intermediate\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_021\",\n      \"formula\": \"C5H8O3\",\n      \"iupac_name\": \"glutaric acid\",\n      \"common_name\": \"glutarate\",\n      \"inchi\": \"InChI=1S/C5H8O4/c6-4(7)2-1-3-5(8)9/h1-3H2,(H,6,7)(H,8,9)\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Hydrothermal\"\n    },\n    {\n      \"id\": \"mol_022\",\n      \"formula\": \"C5H10O5\",\n      \"iupac_name\": \"2-hydroxypentanedioic acid\",\n      \"common_name\": \"2-hydroxyglutarate\",\n      \"inchi\": \"InChI=1S/C5H10O5/c6-2-1-4(7)5(8)3-9/h2,6H,1,3H2,(H,7,8,9)\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Hydrothermal\"\n    },\n    {\n      \"id\": \"mol_023\",\n      \"formula\": \"C5H9NO3\",\n      \"iupac_name\": \"2-aminopentanedioic acid amide\",\n      \"common_name\": \"glutamic acid amide\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    }\n  ],\n  \"reactions\": [\n    {\n      \"id\": \"rxn_001\",\n      \"name\": \"Iron-sulfide-mediated reductive amination of alpha-KG\",\n      \"inputs\": [\"mol_008\", \"mol_002\", \"mol_005\"],\n      \"outputs\": [\"mol_015\", \"mol_005\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"FeS (freshly precipitated)\"],\n      \"conditions\": {\n        \"temperature\": \"355-370K\",\n        \"pressure\": \"high\",\n        \"catalyst\": \"FeS\",\n        \"aqueous\": true,\n        \"other\": \"pH 8.8-9.1; FeS in large excess; anoxic\"\n      },\n      \"mechanism\": \"Imine formation between NH3 and alpha-KG, reduction by FeS, hydrolytic work-up; side-production of water.\",\n      \"reasoning\": \"Experimentally supported by Huber & W\u00e4chtersh\u00e4user (2003, Tetrahedron Letters); balance adjusted per mechanistic mass conservation (Mayer & Moran, 2022; Kitadai et al. 2019).\"\n    },\n    {\n      \"id\": \"rxn_002\",\n      \"name\": \"Reductive amination with H2/Ni catalysis\",\n      \"inputs\": [\"mol_008\", \"mol_002\", \"mol_005\"],\n      \"outputs\": [\"mol_015\", \"mol_005\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"H2\", \"Ni/SiO2-Al2O3\"],\n      \"conditions\": {\n        \"temperature\": \"295-330K\",\n        \"pressure\": \"moderate-high (5 bar H2)\",\n        \"catalyst\": \"Ni on SiO2-Al2O3\",\n        \"aqueous\": true,\n        \"other\": \"pH 8; H2 flow\"\n      },\n      \"mechanism\": \"Imine formation, hydrogenation by Ni-catalyzed H2; water is produced by imine hydrolysis.\",\n      \"reasoning\": \"Supported by Kaur et al. (2024, Chem); reaction mass balance is addressed by inclusion of water side product.\"\n    },\n    {\n      \"id\": \"rxn_003\",\n      \"name\": \"Photocatalytic ZnS amination of alpha-KG\",\n      \"inputs\": [\"mol_008\", \"mol_002\", \"mol_005\"],\n      \"outputs\": [\"mol_015\", \"mol_005\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"ZnS (illuminated)\", \"sulfite (hole scavenger)\"],\n      \"conditions\": {\n        \"temperature\": \"290-310K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"ZnS minerals, light (UV)\",\n        \"aqueous\": true,\n        \"other\": \"Illumination 200-400 nm; pH \u22489\"\n      },\n      \"mechanism\": \"NH3 addition/Schiff base formation, photochemical electron transfer/reduction on ZnS, regeneration/hydrolysis; water released.\",\n      \"reasoning\": \"Supported by Wang et al. (2012, ChemComm) and Guzman & Martin (2009); balanced for C/H/N/O including water.\"\n    },\n    {\n      \"id\": \"rxn_004\",\n      \"name\": \"Hydroxylamine/Fe-driven reduction via oxime intermediate\",\n      \"inputs\": [\"mol_008\", \"mol_017\", \"mol_005\"],\n      \"outputs\": [\"mol_015\", \"mol_005\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"Fe0\", \"Fe2+\"],\n      \"conditions\": {\n        \"temperature\": \"340-350K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"Fe2+/Fe0\",\n        \"aqueous\": true,\n        \"other\": \"70\u00b0C; Fe0 stoichiometric\"\n      },\n      \"mechanism\": \"Oxime formation from alpha-KG and NH2OH, reduction by Fe0, hydrolytic work-up; water balance shown.\",\n      \"reasoning\": \"Supported by Muchowska et al. (2019, Nature); Kitadai et al. (2019) notes open questions on NH2OH supply.\"\n    },\n    {\n      \"id\": \"rxn_005\",\n      \"name\": \"NADH-mediated reductive amination of alpha-KG\",\n      \"inputs\": [\"mol_008\", \"mol_002\", \"mol_018\", \"mol_005\"],\n      \"outputs\": [\"mol_015\", \"mol_005\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\"NADH\"],\n      \"conditions\": {\n        \"temperature\": \"295-300K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"pH 8\"\n      },\n      \"mechanism\": \"Imine formation with NH3, hydride transfer from NADH, product hydrolysis; NAD is oxidized (not tracked separately here); water formed.\",\n      \"reasoning\": \"Supported by Nogal et al. (2024, Org. Chem. Frontiers); mass balance by inclusion of water.\"\n    },\n    {\n      \"id\": \"rxn_006\",\n      \"name\": \"Simple dihydropyridine cofactor reduction of alpha-KG\",\n      \"inputs\": [\"mol_008\", \"mol_002\", \"mol_005\"],\n      \"outputs\": [\"mol_015\", \"mol_005\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\"reduced dihydropyridine cofactor\"],\n      \"conditions\": {\n        \"temperature\": \"295-300K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"pH 8, 30 mM substrate\"\n      },\n      \"mechanism\": \"Cofactor hydride transfer to iminium of alpha-KG/NH3; hydrolysis releases water.\",\n      \"reasoning\": \"Supported by Gonz\u00e1lez-Mart\u00ednez et al. (2026, Nat. Comm.); prebiotic cofactor regeneration open, water accounted.\"\n    },\n    {\n      \"id\": \"rxn_007\",\n      \"name\": \"Transamination: Alpha-KG + Glycine\",\n      \"inputs\": [\"mol_008\", \"mol_011\", \"mol_005\"],\n      \"outputs\": [\"mol_015\", \"mol_010\"],