_014\", \"mol_005\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"295-315K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Ammonia/cyanide present; hydrolytic elimination\"\n      },\n      \"mechanism\": \"Aldehyde undergoes Strecker addition: imine formation, cyanide addition, release water; yields dinitrile.\",\n      \"reasoning\": \"Classic Strecker logic; supported by Fern\u00e1ndez-Garc\u00eda et al. (2017).\"\n    },\n    {\n      \"id\": \"rxn_018\",\n      \"name\": \"Hydrolysis of dinitrile to glutamate (stepwise)\",\n      \"inputs\": [\"mol_014\", \"mol_005\"],\n      \"outputs\": [\"mol_020\", \"mol_012\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"350-370K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Prolonged acidic hydrolysis (often in wet/dry/evaporative cycles)\"\n      },\n      \"mechanism\": \"Hydrolysis of terminal nitriles to carboxylic acid and amide; splits off ammonia.\",\n      \"reasoning\": \"Partial hydrolysis gives amides; complete yields the acid (mol_015). Well supported but slow under prebiotic conditions.\"\n    },\n    {\n      \"id\": \"rxn_019\",\n      \"name\": \"Final amide hydrolysis to glutamate\",\n      \"inputs\": [\"mol_020\", \"mol_005\"],\n      \"outputs\": [\"mol_015\", \"mol_002\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"360-380K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Acid/base hydrolysis, wet-dry cycling\"\n      },\n      \"mechanism\": \"Secondary amide hydrolysis to glutamic acid, liberates ammonia.\",\n      \"reasoning\": \"Classic hydrolysis logic; observed in many Strecker