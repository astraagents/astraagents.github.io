": \"C2H5NO2\",\n      \"iupac_name\": \"2-aminoacetic acid\",\n      \"common_name\": \"glycine\",\n      \"inchi\": \"InChI=1S/C2H5NO2/c3-1-2(4)5/h1,3H2,(H,4,5)\",\n      \"role\": \"hub_intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_010\",\n      \"formula\": \"C3H7NO\",\n      \"iupac_name\": \"2-amino-3-hydroxypropanal\",\n      \"common_name\": \"aminohydroxypropanal\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_011\",\n      \"formula\": \"CH3CH(OH)CH(NH2)CN\",\n      \"iupac_name\": \"2-amino-3-hydroxybutanenitrile\",\n      \"common_name\": \"threonine aminonitrile\",\n      \"inchi\": null,\n      \"role\": \"hub_intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_012\",\n      \"formula\": \"C4H9NO3\",\n      \"iupac_name\": \"2-amino-3-hydroxybutanoic acid\",\n      \"common_name\": \"threonine (racemic; with allothreonine)\",\n      \"inchi\": \"InChI=1S/C4H9NO3/c1-2(6)3(5)4(7)8/h2-3,6H,5H2,1H3,(H,7,8)\",\n      \"role\": \"target\",\n      \"environment_formed\": \"Biochemical\"\n    },\n    {\n      \"id\": \"mol_013\",\n      \"formula\": \"C4H7NO3\",\n      \"iupac_name\": \"3-hydroxy-2-oxobutanoic acid\",\n      \"common_name\": \"2-oxo-3-hydroxybutyrate\",\n      \"inchi\": \"InChI=1S/C4H7NO3/c1-3(6)2(5)4(7)8/h2,6H,1H3,(H,7,8)\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_014\",\n      \"formula\": \"H2O\",\n      \"iupac_name\": \"water\",\n      \"common_name\": \"water\",\n      \"inchi\": \"InChI=1S/H2O/h1H2\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_015\",\n      \"formula\": \"NH4+\",\n      \"iupac_name\": \"azanium\",\n      \"common_name\": \"ammonium ion\",\n      \"inchi\": \"InChI=1S/H3N/h1H3/p+1\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": null\n    }\n  ],\n  \"reactions\": [\n    {\n      \"id\": \"rxn_001\",\n      \"name\": \"Formose-type homologation of formaldehyde to glycolaldehyde\",\n      \"inputs\": [\"mol_003\", \"mol_003\"],\n      \"outputs\": [\"mol_004\", \"mol_014\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Ca(OH)2 (clay, phosphate minerals)\"],\n      \"conditions\": {\n        \"temperature\": \"310-340K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"Ca(OH)2, clays\",\n        \"aqueous\": true,\n        \"other\": \"repeated wet-dry cycles\"\n      },\n      \"mechanism\": \"Aldol dimerization of formaldehyde to form glycolaldehyde, with water as byproduct.\",\n      \"reasoning\": \"Well-established formose-type chemistry under surface conditions; supported by Kebukawa et al. 2017. Atom balance: 2 x CH2O \u2192 HOCH2CHO + H2O.\"\n    },\n    {\n      \"id\": \"rxn_002\",\n      \"name\": \"Cyanohydrin formation: glycolaldehyde to lactonitrile\",\n      \"inputs\": [\"mol_004\", \"mol_001\"],\n      \"outputs\": [\"mol_006\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300-320K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"mildly alkaline\"\n      },\n      \"mechanism\": \"Nucleophilic addition of HCN to aldehyde group of glycolaldehyde, yielding the cyanohydrin (lactonitrile).\",\n      \"reasoning\": \"Supported as a necessary step in cyanosulfidic prebiotic networks (Ritson & Sutherland 2013); atom balance verified.\"\n    },\n    {\n      \"id\": \"rxn_003\",\n      \"name\": \"Photoreduction of lactonitrile to lactaldehyde\",\n      \"inputs\": [\"mol_006\", \"mol_002\"],\n      \"outputs\": [\"mol_008\", \"mol_015\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"CuCN (mineral, photoredox)\"],\n      \"conditions\": {\n        \"temperature\": \"300-320K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"CuCN\",\n        \"aqueous\": true,\n        \"other\": \"254 nm UV irradiation\"\n      },\n      \"mechanism\": \"Photoreduction under UV light with ammonia as reductant and Cu(I) as a photoredox catalyst; nitrile reduced to aldehyde and NH4+ generated.\",\n      \"reasoning\": \"Directly supported by Ritson & Sutherland 2013 for conversion of lactonitrile to lactaldehyde in cyanosulfidic photoredox cycles. Atom balance: C3H5NO + NH3 \u2192 C3H6O2 + NH4+.\"\n    },\n    {\n      \"id\": \"rxn_004\",\n      \"name\": \"Strecker synthesis from lactaldehyde: aminonitrile formation\",\n      \"inputs\": [\"mol_008\", \"mol_002\", \"mol_001\"],\n      \"outputs\": [\"mol_011\", \"mol_014\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300-320K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"homogeneous, mildly basic\"\n      },\n      \"mechanism\": \"Lactaldehyde reacts with ammonia to form imine, then with HCN to give aminonitrile; water released in imine formation.\",\n      \"reasoning\": \"The classical Strecker route for threonine aminonitrile as described by Ritson & Sutherland 2013. Chemistry and balance confirmed: C3H6O2 + NH3 + HCN \u2192 C4H8N2O2 \u2192 C4H7NO + NH4+ + H2O, simplified as per conditions.\"\n    },\n    {\n      \"id\": \"rxn_005\",\n      \"name\": \"Hydrolysis of threonine aminonitrile to threonine/allothreonine\",\n      \"inputs\": [\"mol_011\", \"mol_014\", \"mol_014\"],\n      \"outputs\": [\"mol_012\", \"mol_002\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"montmorillonite clay\"],\n      \"conditions\": {\n        \"temperature\": \"320-350K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"montmorillonite clay\",\n        \"aqueous\": true,\n        \"other\": \"extended hydrolysis time\"\n  