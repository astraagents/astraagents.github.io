ntermediates\": []\n    },\n    {\n      \"pathway_id\": \"P6\",\n      \"name\": \"Metabolism-like reductive amination to glutamate then speculative extension\",\n      \"description\": \"Sequential Ni/mineral-catalyzed H2-driven reductive amination yields glutamate, then conjectured conversion (not yet prebiotically demonstrated) to ornithine and onward guanidination to arginine.\",\n      \"reaction_sequence\": [\"rxn_012\", \"rxn_011\", \"rxn_016\", \"rxn_010\"],\n      \"key_intermediates\": [\"mol_018\", \"mol_015\", \"mol_023\"]\n    },\n    {\n      \"pathway_id\": \"P7\",\n      \"name\": \"Hybrid: Volcanic ornithine, then cyanosulfidic guanidination\",\n      \"description\": \"Ornithine formed in spark/volcanic settings later encounters surface cyanamide for straightforward conversion to arginine, without involvement of peptides.\",\n      \"reaction_sequence\": [\"rxn_017\", \"rxn_016\", \"rxn_010\"],\n      \"key_intermediates\": [\"mol_015\", \"mol_023\"]\n    },\n    {\n      \"pathway_id\": \"P8\",\n      \"name\": \"Hybrid: CO/H2/NH3 \u2192 ornithine-rich mixture, then cyanamide guanidination\",\n      \"description\": \"CO/H2/NH3 catalytic mixture accumulates ornithine among amino-acid products, which is then selectively guanidinated by cyanamide to arginine.\",\n      \"reaction_sequence\": [\"rxn_013\", \"rxn_016\", \"rxn_010\"],\n      \"key_intermediates\": [\"mol_015\", \"mol_023\"]\n    },\n    {\n      \"pathway_id\": \"P9\",\n      \"name\": \"Direct ornithine pathway via hydrothermal glutamate (all hydrothermal/transition-metal route)\",\n      \"description\": \"Hydrothermal Ni-catalyzed formation of glutamate and (speculative) ornithine, followed by surface-supplied cyanamide guanidination.\",\n      \"reaction_sequence\": [\"rxn_012\", \"rxn_011\", \"rxn_016\", \"rxn_010\"],\n      \"key_intermediates\": [\"mol_018\", \"mol_015\", \"mol_023\"]\n    },\n    {\n      \"pathway_id\": \"P10\",\n      \"name\": \"Ornithine guanidination (pep