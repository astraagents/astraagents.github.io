 and convergence points reflect recognized shared intermediates. Pathways highlight both fundamentally photochemical (surface UV) and catalyzed (hydrothermal, volcanic) origins.", "molecules": [{"id": "mol_001", "formula": "HCN", "iupac_name": "hydrogen cyanide", "common_name": "hydrogen cyanide", "inchi": "InChI=1S/CHN/c1-2/h1H", "role": "starting", "environment_formed": "Surface"}, {"id": "mol_002", "formula": "C2H2", "iupac_name": "ethyne", "common_name": "acetylene", "inchi": "InChI=1S/C2H2/c1-2/h1-2H", "role": "starting", "environment_formed": "Surface"}, {"id": "mol_003", "formula": "Cu2O", "iupac_name": "dicopper oxide", "common_name": "cuprous oxide", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_004", "formula": "CH2=CHCN", "iupac_name": "prop-2-enenitrile", "common_name": "acrylonitrile", "inchi": "InChI=1S/C3H3N/c1-2-3-4/h2H,1H2", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_005", "formula": "NH3", "iupac_name": "azane", "common_name": "ammonia", "inchi": "InChI=1S/H3N/h1H3", "role": "starting", "environment_formed": "Surface"}, {"id": "mol_006", "formula": "NH2CH2CH2CN", "iupac_name": "3-aminopropanenitrile", "common_name": "\u03b2-aminopropionitrile", "inchi": "InChI=1S/C3H6N2/c4-2-1-3-5/h1-2,4H2", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_007", "formula": "H2S", "iupac_name": "sulfane", "common_name": "hydrogen sulfide", "inchi": "InChI=1S/H2S/h1H2", "role": "starting", "environment_formed": "Surface"}, {"id": "mol_008", "formula": "NH2CH2CH2CHO", "iupac_name": "3-aminopropanal", "common_name": "\u03b2-aminopropionaldehyde", "inchi": "InChI=1S/C3H7NO/c4-2-1-3-5/h3H,1-2,4H2", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_009", "formula": "CH2N2", "iupac_name": "cyanamide", "common_name": "cyanamide", "inchi": "InChI=1S/CH2N2/c2-1-3/h1H2", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_010", "formula":