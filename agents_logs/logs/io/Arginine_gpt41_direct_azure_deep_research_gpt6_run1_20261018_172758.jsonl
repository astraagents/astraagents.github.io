\": \"HCN addition to guanidinated aldehyde (cyanohydrin formation)\",\n      \"inputs\": [\"mol_010\", \"mol_001\"],\n      \"outputs\": [\"mol_011\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300\u2013320K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"cyanide present after guanidination step\"\n      },\n      \"mechanism\": \"HCN attacks carbonyl carbon to form cyanohydrin.\",\n      \"reasoning\": \"Described in mechanistic sequence by Patel et al. (2015).\"\n    },\n    {\n      \"id\": \"rxn_006\",\n      \"name\": \"Thioamide formation via H2S reaction of guanidinated cyanohydrin\",\n      \"inputs\": [\"mol_011\", \"mol_007\"],\n      \"outputs\": [\"mol_012\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"H2S\"],\n      \"conditions\": {\n        \"temperature\": \"300\u2013320K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"ongoing UV irradiation\"\n      },\n      \"mechanism\": \"Sulfur incorporates into cyanohydrin, producing thioamide functionality.\",\n      \"reasoning\": \"Patel et al. (2015), with mechanistic intermediates confirmed.\"\n    },\n    {\n      \"id\": \"rxn_007\",\n      \"name\": \"Photodeoxygenation and homologation to form arginine \u03b1-aminonitrile\",\n      \"inputs\": [\"mol_012\", \"mol_001\", \"mol_005\"],\n      \"outputs\": [\"mol_013\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"UV light\"],\n      \"conditions\": {\n        \"temperature\": \"300\u2013320K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"UV irradiation, H2S carries through, with NH3\",\n        \"aqueous\": true,\n        \"other\": \"staged reagent addition\"\n      },\n      \"mechanism\": \"Combined UV-driven transformations, additional HCN and NH3 addition yield the C5 \u03b1-aminonitrile precursor.\",\n      \"reasoning\": \"Directly evidenced by Patel et al. (2015); compound 46 is the structurally identified Arg precursor.\"\n    },\n    {\n      \"id\": \"rxn_008\",\n      \"name\": \"Hydrolytic release of arginine from \u03b1-aminonitrile\",\n      \"inputs\": [\"mol_013\", \"mol_023\"],\n      \"outputs\": [\"mol_016\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"330\u2013350K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"mild heating, hydrolytic environment\"\n      },\n      \"mechanism\": \"Classical Strecker hydrolysis converts the C5 \u03b1-aminonitrile to arginine.\",\n      \"reasoning\": \"Expected hydrolytic product of aminonitrile (Strecker); endpoint for the network as supported in Patel et al. (2015); direct Arg yield with all molecule conservation.\"\n    },\n    {\n      \"id\": \"rxn_009\",\n      \"name\": \"Prebiotic ornithine formation in volcanic discharge\",\n      \"inputs\": [\"mol_017\", \"mol_018\", \"mol_019\"],\n      \"outputs\": [\"mol_014\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Ni surface, spark discharge, steam\"],\n      \"conditions\": {\n        \"temperature\": \"500\u2013700K (transient)\",\n        \"pressure\": \"variable, atmospheric/volcanic plume\",\n        \"catalyst\": \"Ni, alumina, volcanic minerals\",\n        \"aqueous\": true,\n        \"other\": \"reducing gas mix, electrical discharge, steam\"\n      },\n      \"mechanism\": \"Surface-catalyzed Fischer\u2013Tropsch-type synthesis, with carbon-nitrogen coupling yielding complex amino acids including ornithine.\",\n      \"reasoning\": \"Supported (with caveats re: selectivity) by Johnson et al. (2008, Science); Yoshino et al. (1971); arginine itself not confirmed in isotope study.\"\n    },\n    {\n      \"id\": \"rxn_010\",\n      \"name\": \"Cyanamide guanidination of free ornithine\",\n 