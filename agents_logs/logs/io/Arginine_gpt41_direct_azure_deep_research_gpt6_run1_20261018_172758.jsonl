 \"CH2O\",\n      \"iupac_name\": \"methanal\",\n      \"common_name\": \"formaldehyde\",\n      \"inchi\": \"InChI=1S/CH2O/c1-2/h1H2\",\n      \"role\": \"starting\",\n      \"environment_formed\": \"Surface\"\n    }\n  ],\n  \"reactions\": [\n    {\n      \"id\": \"rxn_001\",\n      \"name\": \"Cu(I)-catalyzed photochemical coupling of HCN and acetylene to acrylonitrile\",\n      \"inputs\": [\"mol_001\", \"mol_002\", \"mol_003\"],\n      \"outputs\": [\"mol_004\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Cu+\"],\n      \"conditions\": {\n        \"temperature\": \"300-340K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"Cu(I) salts (e.g., CuCN)\",\n        \"aqueous\": true,\n        \"other\": \"UV irradiation (254 nm)\"\n      },\n      \"mechanism\": \"Cu(I)-mediated oxidative coupling forms a C\u2013C bond, generating acrylonitrile from HCN and acetylene under UV light.\",\n      \"reasoning\": \"Patel et al. (2015, Nature Chemistry); Cu(I)-catalyzed, UV-driven coupling is strictly required for cyanosulfidic amino-acid synthesis.\"\n    },\n    {\n      \"id\": \"rxn_002\",\n      \"name\": \"Nucleophilic addition of NH3 to acrylonitrile (Strecker-type) to form \u03b2-aminopropionitrile\",\n      \"inputs\": [\"mol_004\", \"mol_005\"],\n      \"outputs\": [\"mol_006\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300-340K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"mildly alkaline conditions\"\n      },\n      \"mechanism\": \"NH3 attacks the electrophilic beta carbon of acrylonitrile; proton transfer and electron rearrangement yield \u03b2-aminopropionitrile.\",\n      \"reasoning\": \"Patel et al. (2015, Nature Chemistry); standard Strecker chemistry, supported experimentally.\"\n    },\n    {\n      \"id\": \"rxn_003\",\n      \"name\": \"UV/H2S photoreduction of \u03b2-aminopropionitrile to \u03b2-aminopropionaldehyde\",\n      \"inputs\": [\"mol_006\", \"mol_007\"],\n      \"outputs\": [\"mol_008\", \"mol_013\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300-340K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"UV irradiation, photochemical S reduction\"\n      },\n      \"mechanism\": \"Photochemically generated reducing equivalents from H2S reduce the C\u2261N of \u03b2-aminopropionitrile to an aldehyde; sulfur returns as H2S byproduct.\",\n      \"reasoning\": \"Patel et al. (2015); atom and charge flow checked: C3H6N2 (mol_006) + H2S (mol_007) \u2192 C3H7NO (mol_008) + H2S (mol_013) through paired reduction\u2013protonation.\"\n    },\n    {\n      \"id\": \"rxn_004\",\n      \"name\": \"Cyanamide guanidination of \u03b2-aminopropionaldehyde to guanidinated aminopropionaldehyde\",\n      \"inputs\": [\"mol_008\", \"mol_009\"],\n      \"outputs\": [\"mol_010\", \"mol_017\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300-330K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"rapid addition after aldehyde formation\"\n      },\n      \"mechanism\": \"Nucleophilic attack of the \u03b2-amine on cyanamide, trapping the aldehyde as a guanidino hemiaminal; water eliminated.\",\n      \"reasoning\": \"Patel et al. (2015); cyanamide addition is most efficient at the aldehyde stage.\"\n    },\n    {\n      \"id\": \"rxn_005\",\n      \"name\": \"HCN addition to guanidinated aminopropionaldehyde (cyanohydrin formation)\",\n      \"inputs\": [\"mol_010\", \"mol_011\"],\n      \"outputs\": [\"mol_012\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300-320K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Standard cyanohydrin chemistry\"\n      },\n      \"mechanism\": \"HCN nucleophilically adds to aldehyde, forming the C5 cyanohydrin.\",\n      \"reasoning\": \"Patel et al. (2015); straightforward addition, mass conserved.\"\n    },\n    {\n      \"id\": \"rxn_006\",\n      \"name\": \"H2S thionation: C5 cyanohydrin to thioamide\",\n      \"inputs\": [\"mol_012\", \"mol_013\"],\n      \"outputs\": [\"mol_014\", \"mol_017\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300-320K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"UV and excess H2S\"\n      },\n      \"mechanism\": \"Replacement of carbonyl oxygen with sulfhydryl group, generating thioamide and water.\",\n      \"reasoning\": \"Patel et al. (2015); thioamide formation is photochemical.\"\n    },\n    {\n      \"id\": \"rxn_007\",\n      \"name\": \"UV/H2S photoreduction of C5 thioamide, HCN addition, and NH3 imine formation to arginine \u03b1-aminonitrile\",\n      \"inputs\": [\"mol_014\", \"mol_011\", \"mol_015\", \"mol_007\"],\n      \"outputs\": [\"mol_016\", \"mol_017\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300-320K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"UV-induced transformation, sequential HCN and NH3 addition\"\n      },\n      \"mechanism\": \"Photoreduction eliminates S, stretches chain; HCN homologates; NH3 amination forms \u03b1-aminonitrile; water produced.\",\n      \"reasoning\": \"Patel et al. (2015); full sequence carefully balanced for atom conservation.\"\n    },\n    {\n      \"id\": \"rxn_008\",\n      \"name\": \"Hydrolysis of arginine \u03b1-aminonitrile to arginine\",\n      \"inputs\": [\"mol_016\", \"mol_017\"],\n      \"outputs\": [\"mol_018\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"340-360K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Slightly acidic or neutral hydrolysis\"\n      },\n      \"mechanism\": \"Standard Strecker-type hydrolysis transforms \u03b1-aminonitrile to \u03b1-amino acid.\",\n      \"reasoning\": \"Classical Strecker chemistry; see Patel et al. (2015) and prior amino acid literature.\"\n    },\n    {\n      \"id\": \"rxn_009\",\n      \"name\": \"Volcanogenic spark synthesis of ornithine from CO, H2, NH3\",\n      \"inputs\": [\"mol_020\", \"mol_021\", \"mol_022\", \"mol_023\"],\n      \"outputs\": [\"mol_019\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"Ni/Al2O3\"],\n      \"conditions\": {\n        \"temperature\": \"700-800K\",\n        \"pressure\": \"1-10 atm\",\n        \"catalyst\": \"nickel on alumina\",\n        \"aqueous\": false,\n        \"other\": \"Discharge (lightning analogue), rapid cooling/condensation\"\n      },\n      \"mechanism\": \"High-temperature Fischer-Tropsch-type catalysis forms amino acids, including ornithine, via surface C\u2013C/N coupling.\",\n      \"reasoning\": \"Johnson et al. (2008, Science); Yoshino et al. (1971) and Hayatsu et al. (1971, GCA); ornithine detected in lava-discharge products, atom balance simplified as generic product-forming process.\"\n    },\n    {\n      \"id\": \"rxn_010\",\n      \"name\": \"Chemical guanidination of ornithine to arginine by cyanamide\",\n      \"inputs\": [\"mol_019\", \"mol_026\"],\n      \"outputs\": [\"mol_018\", \"mol_017\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"295-310K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Mildly alkaline; standard aqueous solution\"\n      },\n      \"mechanism\": \"Nucleophilic attack of terminal Orn amine on cyanamide; water eliminated; guanidino group installed.\",\n      \"reasoning\": \"Longo et al. (2020, PNAS); Steinman et al. (1964); reaction robust for both free and peptide-bound Orn.\"\n    },\n    {\n      \"id\": \"rxn_011\",\n      \"name\": \"Direct guanidination of peptide-bound ornithine residues by cyanamide\",\n      \"inputs\": [\"mol_024\", \"mol_026\"],\n      \"outputs\": [\"mol_025\", \"mol_017\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"295-310K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"model primordial polypeptide, open water\"\n      },\n      \"mechanism\": \"Cyanamide converts Orn side chains in the peptide to Arg residues, eliminating water.\",\n      \"reasoning\": \"Longo et al. (2020, PNAS); complete and partial conversion demonstrated experimentally on model peptides.\"\n    },\n    {\n      \"id\": \"rxn_012\",\n      \"name\": \"Reductive amination of \u03b1-ketoglutarate to glutamate with H2/Ni\",\n      \"inputs\": [\"mol_027\", \"mol_005\", \"mol_021\"],\n      \"outputs\": [\"mol_028\", \"mol_017\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"Ni/Al2O3\"],\n      \"conditions\": {\n        \"temperature\": \"295-315K\",\n        \"pressure\": \"5 bar\",\n        \"catalyst\": \"Ni/alumina or meteoritic Ni\",\n        \"aqueous\": true,\n        \"other\": \"Mildly alkaline\"\n      },\n      \"mechanism\": \"Ni-catalyzed reduction of keto group by H2, imine formation with NH3, hydrolytic rearrangement creates glutamate.\",\n      \"reasoning\": \"Kaur et al. (2024, Chem); up to 88% yield, robust prebiotically on hydrothermal Ni surfaces.\"\n    },\n    {\n      \"id\": \"rxn_013\",\n      \"name\": \"Speculative nonenzymatic Glu to Orn decarboxylation and side-chain amination\",\n      \"inputs\": [\"mol_028\", \"mol_005\"],\n      \"outputs\": [\"mol_019\", \"mol_017\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300-350K\",\n        \"pressure\": \"1-5 bar\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"mildly alkaline\"\n      },\n      \"mechanism\": \"A speculative nonenzymatic transamination/decarboxylation: -CO2 and +NH2 via hydrolysis/ammonolysis, generating Orn and water.\",\n      \"reasoning\": \"No published nonenzymatic demonstration; included as a plausible but unconfirmed mass- and charge-balanced step from glutamate to ornithine.\"\n    },\n    {\n      \"id\": \"rxn_014\",\n      \"name\": \"Direct surface-catalyzed synthesis of arginine from CO, H2, NH3 (FTT-like)\",\n      \"inputs\": [\"mol_020\", \"mol_021\", \"mol_022\", \"mol_023\"],\n      \"outputs\": [\"mol_018\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"Ni/Al2O3\"],\n      \"conditions\": {\n        \"temperature\": \"800 K\",\n        \"pressure\": \"1-10 atm\",\n        \"catalyst\": \"nickel/alumina or clay\",\n        \"aqueous\": false,\n        \"other\": \"Continuous gas flow, heterogenous catalysis\"\n      },\n      \"mechanism\": \"Generic surface Fischer\u2013Tropsch catalysis, low-yield formation of Arg among the complex amino acid mixture.\",\n      \"reasoning\": \"Yoshino et al. (1971, GCA); Hayatsu, Studier, Anders (1971): Arg originally reported, not MS-confirmed; included as a historical, low-confidence module as recommended.\"\n    },\n    {\n      \"id\": \"rxn_015\",\n      \"name\": \"Historical photochemical synthesis of arginine from nitrate and formaldehyde\",\n      \"inputs\": [\"mol_029\", \"mol_030\"],\n      \"outputs\": [\"mol_018\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"TiO2\"],\n      \"conditions\": {\n        \"temperature\": \"290-310K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"TiO2\",\n        \"aqueous\": true,\n        \"other\": \"Sunlight/UV\"\n      },\n      \"mechanism\": \"Photochemically driven nitrogen fixation and carbon coupling forms amino acids.\",\n      \"reasoning\": \"Dhar and Mukherjee (1934, Nature); Bahadur (1954): Low-confidence, atom flow simplified due to analytic uncertainty in historical product assignment; included for completeness only.\"\n    },\n    {\n      \"id\": \"rxn_016\",\n      \"name\": \"Surface accumulation of cyanamide via thermal decomposition or nitrile hydrolysis\",\n      \"inputs\": [\"mol_001\", \"mol_017\"],\n      \"outputs\": [\"mol_026\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"310-350K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": false,\n        \"other\": \"Evaporitic pool, thermal cycling\"\n      },\n      \"mechanism\": \"HCN and H2O interact (or via HCN polymer intermediate) to form cyanamide under mild heating.\",\n      \"reasoning\": \"Steinman et al. (1964, PNAS) and Patel et al.; cyanamide forms as a byproduct in cyanosulfidic and thermal/photolytic scenarios.\"\n    },\n    {\n      \"id\": \"rxn_017\",\n      \"name\": \"Competing cyclization/lactamization of ornithine under drying conditions\",\n      \"inputs\": [\"mol_019\"],\n      \"outputs\": [],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300-340K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": false,\n        \"other\": \"Wet-dry cycles\"\n      },\n      \"mechanism\": \"Side-chain cyclization during dry-down can yield ornithine lactam or short peptides instead of free Orn.\",\n      \"reasoning\": \"Frenkel-Pinter et al. (2019, PNAS); included as a known kinetic sink for ornithine in oligomerizing mixtures.\"\n    },\n    {\n      \"id\": \"rxn_018\",\n      \"name\": \"Direct guanidination of \u03b2-aminopropionitrile by cyanamide (inefficient pathway)\",\n      \"inputs\": [\"mol_006\", \"mol_026\"],\n      \"outputs\": [\"mol_016\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300-320K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"One-pot addition of cyanamide\"\n      },\n      \"mechanism\": \"Cyanamide reacts directly with \u03b2-aminopropionitrile's amine; forms guanidinated \u03b1-aminonitrile with side products.\",\n      \"reasoning\": \"Patel et al. (2015); reported as low-yield, competitive network path, less favored than aldehyde guanidination.\"\n    }\n  ],\n  \"pathways\": [\n    {\n      \"pathway_id\": \"P1\",\n      \"name\": \"Cyanosulfidic sequential C3\u2192C5 pathway\",\n      \"description\": \"Full Patel et al. (2015) stepwise UV-driven sequence from HCN and acetylene to arginine via acrylonitrile, \u03b2-aminopropionitrile, aldehyde, cyanamide guanidination, C5 thioamide, and Strecker hydrolysis.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_002\", \"rxn_003\", \"rxn_004\", \"rxn_005\", \"rxn_006\", \"rxn_007\", \"rxn_008\"],\n      \"key_intermediates\": [\"mol_004\", \"mol_006\", \"mol_008\", \"mol_010\", \"mol_012\", \"mol_014\", \"mol_016\"]\n    },\n    {\n      \"pathway_id\": \"P2\",\n      \"name\": \"Ornithine-to-arginine (guanidination) route from volcanic Ornithine\",\n      \"description\": \"Volcanic spark or FTT-type ornithine formation; chemical guanidination by cyanamide; Strecker hydrolysis to Arg.\",\n      \"reaction_sequence\": [\"rxn_009\", \"rxn_016\", \"rxn_010\"],\n      \"key_intermediates\": [\"mol_019\"]\n    },\n    {\n      \"pathway_id\": \"P3\",\n      \"name\": \"Peptide-bound Ornithine guanidination (Longo polypeptide scenario)\",\n      \"description\": \"Abiotic peptide formation with Orn incorporated; postsynthetic