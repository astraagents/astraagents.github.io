 {\n        \"temperature\": \"320\u2013340K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"montmorillonite/clay\",\n        \"aqueous\": false,\n        \"other\": \"dry-down and thermal cycling\"\n      },\n      \"mechanism\": \"Competing intramolecular cyclization of Orn side-chain during oligomerization.\",\n      \"reasoning\": \"Directly observed as a competing pathway for Orn under prebiotic dry-down (Frenkel-Pinter et al., 2019, PNAS).\"\n    },\n    {\n      \"id\": \"rxn_018\",\n      \"name\": \"Nitrate/formaldehyde type photochemical amino acid production (very low confidence)\",\n      \"inputs\": [\"mol_024\", \"mol_001\"],\n      \"outputs\": [\"mol_016\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"TiO2 (photo-catalyst)\"],\n      \"conditions\": {\n        \"temperature\": \"310\u2013320K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"TiO2\",\n        \"aqueous\": true,\n        \"other\": \"UV illumination, historical experiment\"\n      },\n      \"mechanism\": \"Sunlight-driven, nitrate-assisted oxidation of simple C and N species to amino acids.\",\n      \"reasoning\": \"Observed historically (Dhar & Mukherjee, 1934; Bahadur, 1954), but identification of Arg is unconfirmed and methodologically weak; included for completeness with low confidence.\"\n    },\n    {\n      \"id\": \"rxn_019\",\n      \"name\": \"Guanidination of surface-formed ornithine (hybrid, volcanic + cyanosulfidic)\",\n      \"inputs\": [\"mol_014\", \"mol_009\"],\n      \"outputs\": [\"mol_026\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300\u2013320K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"cyanamide availability in same setting as Orn\"\n      },\n      \"mechanism\": \"Combination of volcanic Orn formation and surface cyanamide guanidination.\",\n      \"reasoning\": \"Chemically elementary, plausible environmental convergence; Orn source is still upstream-limited in concentration, but both steps supported individually (Johnson et al., 2008; Steinman et al., 1964).\"\n    }\n  ],\n  \"pathways\": [\n    {\n      \"pathway_id\": \"P1\",\n      \"name\": \"Cyanosulfidic surface UV pathway (Patel/Sutherland)\",\n      \"description\": \"Constructs arginine via UV-driven, sulfur/HCN/acetylene/cyanamide sequential chemistry through \u03b1-aminonitrile.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_002\", \"rxn_003\", \"rxn_004\", \"rxn_005\", \"rxn_006\", \"rxn_007\", \"rxn_008\"],\n      \"key_intermediates\": [\"mol_004\", \"mol_006\", \"mol_008\", \"mol_009\", \"mol_013\"]\n    },\n    {\n      \"pathway_id\": \"P2\",\n      \"name\": \"Direct guanidination of ornithine (Orn\u2192Arg) after volcanic formation\",\n      \"description\": \"Volcanic-spark/FTT synthesis of Orn, followed by aqueous cyanamide guanidination.\",\n      \"reaction_sequence\": [\"rxn_009\", \"rxn_016\", \"rxn_010\"],\n      \"key_intermediates\": [\"mol_014\", \"mol_009\"]\n    },\n    {\n      \"pathway_id\": \"P3\",\n      \"name\": \"Ornithine incorporation then post-polymerization guanidination in peptides\",\n      \"description\": \"Oligomerizes Orn, then uses cyanamide to convert Orn to Arg in peptide.\",\n      \"reaction_sequence\": [\"rxn_009\", \"rxn_011\", \"rxn_016\", \"rxn_012\"],\n      \"key_intermediates\": [\"mol_015\", \"mol_009\"]\n    },\n    {\n      \"pathway_id\": \"P4\",\n      \"name\": \"Metabolic-like hydrothermal Glu\u2192Orn\u2192Arg route\",\n      \"description\": \"Proto-metabolic synthesis of Glu from \u03b1-KG, then (speculative) non-enzymatic Orn formation, followed by guanidination.\",\n      \"reaction_sequence\": [\"rxn_013\", \"rxn_014\", \"rxn_016\", \"rxn_010\"],\n      \"key_intermediates\": [\"mol_022\", \"mol_014\", \"mol_009\"]\n    },\n    {\n      \"pathway_id\": \"P5\",\n      \"name\": \"High-T Fischer\u2013Tropsch-type catalysis to Arg\",\n      \"description\": \"CO/H2/NH3 surface catalysis yields complex amino acid mixture, including low-yield Arg.\",\n      \"reaction_sequence\": [\"rxn_015\"],\n      \"key_intermediates\": []\n    },\n    {\n      \"pathway_id\": \"P6\",\n      \"name\": \"Hybrid Orn formed by FTT followed by guanidination\",\n      \"description\": \"FTT-type Orn generates Orn, then reacts with cyanamide to form Arg.\",\n      \"reaction_sequence\": [\"rxn_009\", \"rxn_016\", \"rxn_010\"],\n      \"key_intermediates\": [\"mol_014\", \"mol_009\"]\n    },\n    {\n      \"pathway_id\": \"P7\",\n      \"name\": \"Nitrate/carbohydrate photochemical amino acid route (historical)\",\n      \"description\": \"Nitrate and simple carbon under sunlight/TiO2 yields Arg among other amino acids (low evidence).\",\n      \"reaction_sequence\": [\"rxn_018\"],\n      \"key_intermediates\": []\n    },\n    {\n      \"pathway_id\": \"P8\",\n      \"name\": \"Direct cyanosulfidic guanidination of \u03b2-aminopropionitrile (inefficient Patel route)\",\n      \"description\": \"Attempts direct guanidination of \u03b2-aminopropionitrile by cyanamide, then photochemical homologation to Arg-intermediate.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_002\", \"rxn_016\", \"rxn_004\", \"rxn_005\", \"rxn_006\", \"rxn_007\", \"rxn_008\"],\n      \"key_intermediates\": [\"mol_006\", \"mol_009\", \"mol_010\"]\n    },\n    {\n      \"pathway_id\": \"P9\",\n      \"name\": \"Wet-dry cycling Orn cyclization and guanidination competition\",\n      \"description\": \"Incorporation and cyclization of Orn in peptide dry-down, followed by guanidination (competing side reactions).\",\n      \"reaction_sequence\": [\"rxn_009\", \"rxn_011\", \"rxn_017\", \"rxn_012\"],\n      \"key_intermediates\": [\"mol_015\", \"mol_025\"]\n    },\n    {\n      \"pathway_id\": \"P10\",\n      \"name\": \"Hybrid volcanic Orn formation and surface guanidination\",\n      \"description\": \"Ornithine fr