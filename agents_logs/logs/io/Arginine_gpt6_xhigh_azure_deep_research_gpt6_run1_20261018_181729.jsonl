nidinated C3-aldehyde hemiaminal", "inchi": null, "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_015", "formula": "C4H9N3O", "iupac_name": "3-(Carbamimidamido)propanal", "common_name": "3-Guanidinopropanal", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_016", "formula": "C5H10N4O", "iupac_name": "4-(Carbamimidamido)-2-hydroxybutanenitrile", "common_name": "Guanidinated first-homologation cyanohydrin", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_017", "formula": "C5H12N4OS", "iupac_name": "4-(Carbamimidamido)-2-hydroxybutanethioamide", "common_name": "Guanidinated alpha-hydroxythioamide", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_018", "formula": "C5H12N4S", "iupac_name": "4-(Carbamimidamido)butanethioamide", "common_name": "Guanidinated deoxygenated thioamide", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_019", "formula": "C5H11N3O", "iupac_name": "4-(Carbamimidamido)butanal", "common_name": "4-Guanidinobutanal", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_020", "formula": "C6H12N4O", "iupac_name": "5-(Carbamimidamido)-2-hydroxypentanenitrile", "common_name": "Arginine-branch terminal cyanohydrin", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_021", "formula": "C6H13N5", "iupac_name": "2-Amino-5-(carbamimidamido)pentanenitrile", "common_name": "Arginine alpha-aminonitrile", "inchi": null, "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_022", "formula": "C6H15N5O", "iupac_name": "2-Amino-5-(carbamimidamido)pentanamide", "common_name": "Argininamide", "inchi": null, "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_023", "formula": "C6H15N5S", "iupac_name": "2-Amino-5-(carbamimidamido)pentanethioamide", "common_name": "Arginine thioamide", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_024", "formula": "C6H14N4O2", "iupac_name": "2-Amino-5-(diaminomethylideneamino)pentanoic acid", "common_name": "Arginine", "inchi": "InChI=1S/C6H14N4O2/c7-4(5(11)12)2-1-3-10-6(8)9/h4H,1-3,7H2,(H,11,12)(H4,8,9,10)", "role": "target", "environment_formed": "Surface"}, {"id": "mol_025", "formula": "CH4", "iupac_name": "Methane", "common_name": "Methane", "inchi": "InChI=1S/CH4/h1H4", "role": "starting", "environment_formed": null}, {"id": "mol_026", "formula": "H2", "iupac_name": "Dihydrogen", "common_name": "Hydrogen", "inchi": "InChI=1S/H2/h1H", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_027", "formula": "C5H12N2O2", "iupac_name": "2,5-Diaminopentanoic acid", "common_name": "Ornithine", "inchi": "InChI=1S/C5H12N2O2/c6-3-1-2-4(7)5(8)9/h4H,1-3,6-7H2,(H,8,9)", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_028", "formula": "C10H22N4O3", "iupac_name": "2-[(2,5-Diaminopentanoyl)amino]-5-aminopentanoic acid", "common_name": "Alpha-linked ornithylornithine", "inchi": null, "role": "intermediate", "environment_formed": "Biochemical"}, {"id": "mol_029", "formula": "C12H26N8O3", "iupac_name": "2-[[2-Amino-5-(carbamimidamido)pentanoyl]amino]-5-(carbamimidamido)pentanoic acid", "common_name": "Alpha-linked arginylarginine", "inchi": null, "role": "intermediate", "environment_formed": "Biochemical"}, {"id": "mol_030", "formula": "CH4N2O", "iupac_name": "Urea", "common_name": "Urea", "inchi": "InChI=1S/CH4N2O/c2-1(3)4/h(H4,2,3,4)", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_031", "formula": "C2H4N4", "iupac_name": "2-Cyanoguanidine", "common_name": "Dicyandiamide", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_032", "formula": "C5H10N2O", "iupac_name": "3-Aminopiperidin-2-one", "common_name": "Ornithine delta-lactam", "inchi": null, "role": "intermediate", "environment_formed": "Biochemical"}], "reactions": [{"id": "rxn_001", "name": "Copper-mediated hydrocyanation of acetylene", "inputs": ["mol_001", "mol_002"], "outputs": ["mol_010"], "environment": "Surface", "agents": ["Cu(I) cyanide complexes"], "conditions": {"temperature": "300-350 K; proposed surface window", "pressure": "Approximately 1 atm", "catalyst": "Cu(I)", "aqueous": true, "other": "Anoxic acetylene-bearing water; cyanide and copper availability required; perform before introducing sulfide that could precipitate copper."}, "mechanism": "Copper-assisted addition of hydrogen cyanide across acetylene produces acrylonitrile.", "reasoning": "This supplies the C3 entry substrate used in the arginine branch of Patel et al. (2015). Cu(I) is chemically justified for this coupling rather than added as a generic mineral catalyst. Cyanide storage and subsequent concentration have environmental support from Toner and Catling (2019), but acetylene delivery, copper speciation, and useful natural reaction rates remain requirements."}, {"id": "rxn_002", "name": "Ammonia conjugate addition to acrylonitrile", "inputs": ["mol_010", "mol_003"], "outputs": ["mol_011"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-330 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Ammonia-rich solution; approximately pH 8-10; control residence time and substrate concentration."}, "mechanism": "Aza-Michael addition places an amino group at the terminal carbon of acrylonitrile.", "reasoning": "Patel et al. (2015) use beta-aminopropionitrile as the shared entry intermediate for the arginine/proline chemistry. No mineral catalyst is intrinsically needed. Further cyanoethylation and other acrylonitrile reactions can reduce selectivity, so this is not assumed to be quantitative."}, {"id": "rxn_003", "name": "Sulfide-driven photoreduction of beta-aminopropionitrile", "inputs": ["mol_011", "mol_005", "mol_006"], "outputs": ["mol_012", "mol_003", "mol_009"], "environment": "Surface", "agents": ["Cu(I)/Cu(II) photoredox complexes"], "conditions": {"temperature": "300-320 K", "pressure": "Approximately 1 atm", "catalyst": "Cu(I)/Cu(II) photoredox system", "aqueous": true, "other": "Anoxic UV irradiation; laboratory precedent near 254 nm; mildly neutral-to-alkaline water; rapid downstream cyanamide trapping."}, "mechanism": "Photogenerated reducing equivalents reduce the nitrile to an imine-level intermediate, whose hydrolysis gives the aldehyde and ammonia.", "reasoning": "The transformation is part of Patel et al. (2015). Sulfide is a reagent, not merely a mineral agent. Ranjan et al. (2018) identify sulfide abundance as a limitation, and dissolved Fe2+ and copper can further sequester it. Elemental sulfur represents a balanced terminal oxidation sink; actual sulfur photoproducts need not be exclusively S8."}, {"id": "rxn_004", "name": "Proposed sulfite-driven photoreduction of beta-aminopropionitrile", "inputs": ["mol_011", "mol_007", "mol_006"], "outputs": ["mol_012", "mol_003", "mol_008"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-320 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Anoxic UV-exposed sulfite-bearing solution; approximately pH 7.5-9; no molecular oxygen; substrate-specific performance unmeasured."}, "mechanism": "Proposed sulfite photoionization supplies reducing equivalents for nitrile reduction and hydrolysis; sulfate is the formal fully oxidized sulfur endpoint.", "reasoning": "Speculative for this substrate. Ranjan et al. (2018) motivate more available SO2-derived sulfur species as alternatives where sulfur only supplies electrons, while Patel et al. (2015) establish the sulfide-based substrate transformation. Neither source establishes this particular substitution, its selectivity, or exclusive sulfate formation. It tests a real sulfur-supply constraint rather than assuming sulfite can replace sulfur-incorporation steps."}, {"id": "rxn_005", "name": "Aldehyde-stage cyanamide trapping and guanidine-ring formation", "inputs": ["mol_012", "mol_004"], "outputs": ["mol_014"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-320 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Cyanamide available during or immediately after aldehyde generation; proposed pH 7-9; avoid prolonged storage of the untrapped aminoaldehyde."}, "mechanism": "Cyanamide capture at the aldehyde, followed by intramolecular addition involving the pendant amine, generates a cyclic guanidinated hemiaminal.", "reasoning": "Patel et al. (2015) identify efficient aldehyde-stage capture as more effective than direct aminonitrile guanidination. The six-membered hemiaminal is the structural representation used here; its environmental microstate distribution is not supplied by the research summary. Cyanamide hydrolysis and other competing reactions prevent treating its concentration as fixed."}, {"id": "rxn_006", "name": "Early guanidination of beta-aminopropionitrile", "inputs": ["mol_011", "mol_004"], "outputs": ["mol_013"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-330 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Concentrated cyanamide and aminonitrile; mildly alkaline conditions; unreacted feedstocks expected."}, "mechanism": "The terminal amino group attacks cyanamide's electrophilic carbon, followed by proton transfers to the substituted guanidine.", "reasoning": "Patel et al. (2015) explicitly describe this guanidination as relatively inefficient. It is retained as a genuine chemical alternative, not assigned equal performance to aldehyde-stage capture. Cyanamide persistence and competing reactivity are consistent with Steinman et al. (1964), but useful environmental conversion is not established."}, {"id": "rxn_007", "name": "Sulfide photoreduction of the early-guanidinated nitrile", "inputs": ["mol_013", "mol_005", "mol_006"], "outputs": ["mol_014", "mol_003", "mol_009"], "environment": "Surface", "agents": ["Cu(I)/Cu(II) photoredox complexes"], "conditions": {"temperature": "300-320 K", "pressure": "Approximately 1 atm", "catalyst": "Cu(I)/Cu(II) photoredox system", "aqueous": true, "other": "Anoxic UV irradiation; staged sulfide addition; copper must remain photochemically available."}, "mechanism": "Nitrile photoreduction and imine hydrolysis generate a guanidinated aldehyde that cyclizes to its hemiaminal reservoir.", "reasoning": "This encodes the early-guanidination branch described in the reaction logic of Patel et al. (2015). Its environmental yield is not independently established, especially because the preceding guanidination is inefficient. Ranjan et al. (2018) provide the same sulfur-availability caution as for the unguanidinated reduction."}, {"id": "rxn_008", "name": "Proposed sulfite photoreduction of the early-guanidinated nitrile", "inputs": ["mol_013", "mol_007", "mol_006"], "outputs": ["mol_014", "mol_003", "mol_008"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-320 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Anoxic UV irradiation of sulfite-bearing water; approximately pH 7.5-9; guanidino-group survival must be measured."}, "mechanism": "Proposed sulfite-derived reducing equivalents reduce the nitrile, followed by hydrolysis and intramolecular hemiaminal formation.", "reasoning": "Speculative substrate-specific extension of the sulfur-source argument in Ranjan et al. (2018), using the sulfide-route scaffold of Patel et al. (2015). Guanidinium effects on electron capture, competing reduction, and product partitioning are unresolved. This edge does not claim experimentally demonstrated arginine chemistry with sulfite."}, {"id": "rxn_009", "name": "Ring opening of the guanidinated hemiaminal", "inputs": ["mol_014"], "outputs": ["mol_015"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-330 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Reversible ring-chain equilibrium; subsequent cyanide capture can consume the open-chain fraction."}, "mechanism": "Hemiaminal C-N bond cleavage restores the aldehyde without changing molecular composition.", "reasoning": "This is a mechanistic resolution of aldehyde-equivalent reactivity in Patel et al. (2015), not a claim of an independently isolated open-chain aldehyde or a measured equilibrium constant. Separating the isomers makes the carbonyl chemistry explicit without treating a cyclic hemiaminal as a permanently free aldehyde."}, {"id": "rxn_010", "name": "First cyanide homologation of the guanidinated aldehyde", "inputs": ["mol_015", "mol_001"], "outputs": ["mol_016"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-320 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Cyanide introduced after aldehyde formation; approximately pH 7-9; reversible cyanohydrin formation."}, "mechanism": "Cyanide addition to the aldehyde carbonyl produces an alpha-hydroxynitrile and adds one carbon to the future amino-acid backbone.", "reasoning": "This homologation belongs to the explicit arginine-precursor sequence of Patel et al. (2015). It requires an accessible aldehyde fraction and adequate cyanide activity; mineral-mediated cyanide concentration is environmentally plausible but not demonstrated as an integrated operation with this branch (Toner and Catling, 2019)."}, {"id": "rxn_011", "name": "Sulfide addition to the first cyanohydrin nitrile", "inputs": ["mol_016", "mol_005"], "outputs": ["mol_017"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-330 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "HS-/H2S available; mildly alkaline water; limit sulfide loss to volatilization and FeS precipitation."}, "mechanism": "Nucleophilic sulfide addition to the nitrile and proton transfers form an alpha-hydroxythioamide.", "reasoning": "Patel et al. (2015) use thioamide chemistry in this homologation sequence. Here sulfur is incorporated into the substrate, so sulfite cannot simply replace sulfide as an electron donor. The sulfide-concentration limitations emphasized by Ranjan et al. (2018) therefore remain even in pathways using an earlier sulfite photoreduction."}, {"id": "rxn_012", "name": "Photochemical deoxygenation of the alpha-hydroxythioamide", "inputs": ["mol_017", "mol_005"], "outputs": ["mol_018", "mol_006", "mol_009"], "environment": "Surface", "agents": ["Cu(I)/Cu(II) photoredox complexes"], "conditions": {"temperature": "300-320 K", "pressure": "Approximately 1 atm", "catalyst": "Cu(I)/Cu(II) photoredox system", "aqueous": true, "other": "Anoxic UV exposure with sulfide-derived reducing equivalents; irradiation and reagent additions staged."}, "mechanism": "Net reductive replacement of the alpha-hydroxyl group by hydrogen produces the deoxygenated thioamide.", "reasoning": "This is a key backbone-building transformation in Patel et al. (2015), not ordinary thermal dehydration. UV availability is physically plausible at suitable early-Earth surfaces (Ranjan and Sasselov, 2017), but sulfur loading can also suppress the radiation required for the reaction (Ranjan et al., 2018)."}, {"id": "rxn_013", "name": "Photoreductive conversion of the thioamide to a homologated aldehyde", "inputs": ["mol_018", "mol_005", "mol_006"], "outputs": ["mol_019", "mol_003", "mol_005", "mol_009"], "environment": "Surface", "agents": ["Cu(I)/Cu(II) photoredox complexes"], "conditions": {"temperature": "300-320 K", "pressure": "Approximately 1 atm", "catalyst": "Cu(I)/Cu(II) photoredox system", "aqueous": true, "other": "Anoxic sulfide-assisted UV chemistry; water participates in hydrolytic workup of reduced intermediates."}, "mechanism": "Net thioamide photoreduction and hydrolytic processing generate the aldehyde, ammonia, and sulfur products.", "reasoning": "The thioamide-to-aldehyde continuation is part of Patel et al. (2015). This node is a net transformation rather than an elementary mechanism. H2S appears on both sides because photodonor oxidation and release of substrate-bound sulfur can offset in the net balance; its experimental presence is still required. S8 is a formal sulfur sink, not a uniquely characterized coproduct."}, {"id": "rxn_014", "name": "Second cyanide homologation to the terminal cyanohydrin", "inputs": ["mol_019", "mol_001"], "outputs": ["mol_020"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-320 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Fresh cyanide addition after the preceding photoreduction; approximately pH 7-9."}, "mechanism": "Cyanide adds to the aldehyde, installing the carbon that will become arginine's carboxyl carbon.", "reasoning": "Patel et al. (2015) support this second homologation in the arginine branch. The product has six total carbons: five in the eventual amino-acid backbone and one in the guanidino group. Reagent sequencing is necessary; simultaneous exposure of all feedstocks to every earlier step is not assumed."}, {"id": "rxn_015", "name": "Strecker-type conversion of the terminal cyanohydrin to arginine aminonitrile", "inputs": ["mol_020", "mol_003"], "outputs": ["mol_021", "mol_006"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-330 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Ammonia-rich stage after photochemical homologation; approximately pH 8-10; avoid unnecessary further irradiation."}, "mechanism": "Cyanohydrin dissociation permits aldehyde-imine equilibration; cyanide capture of the imine produces the alpha-aminonitrile. This is not direct displacement of hydroxide.", "reasoning": "Patel et al. (2015) identify compound 46 as the arginine alpha-aminonitrile precursor. This is the strongest experimentally supported arginine-specific endpoint in the supplied de novo sequence. It must not be represented as an isolated, quantitatively established yield of free arginine."}, {"id": "rxn_016", "name": "Hydration of arginine aminonitrile to argininamide", "inputs": ["mol_021", "mol_006"], "outputs": ["mol_022"], "environment": "Surface", "agents": ["Br\u00f8nsted acid"], "conditions": {"temperature": "330-370 K", "pressure": "Approximately 1 atm", "catalyst": "H+", "aqueous": true, "other": "Candidate acidic pool or later acidic episode; approximately pH 1-3; extended residence may be necessary; protect from continued strong UV."}, "mechanism": "Acid-assisted water addition to the nitrile followed by tautomerization produces the carboxamide.", "reasoning": "Chemically expected Strecker-product processing, but speculative as an environmentally validated step for this exact substrate. Patel et al. (2015) establish the aminonitrile rather than an end-to-end free-arginine yield. Hydration rate, aminonitrile decomposition, and guanidino-group survival must be measured under the proposed conditions."}, {"id": "rxn_017", "name": "Hydrolysis of argininamide to free arginine", "inputs": ["mol_022", "mol_006"], "outputs": ["mol_024", "mol_003"], "environment": "Surface", "agents": ["Br\u00f8nsted acid"], "conditions": {"temperature": "350-370 K", "pressure": "Approximately 1 atm", "catalyst": "H+", "aqueous": true, "other": "Candidate pH 1-2; prolonged hydrolysis followed by cooling; product represented without its protonation-state counterions."}, "mechanism": "Water attacks the activated amide carbonyl; C-N cleavage releases ammonia/ammonium and forms the carboxylic acid.", "reasoning": "This is the chemically expected final hydrolysis, but its useful rate and selectivity within the stated prebiotic window are not established by Patel et al. (2015). It is a bottleneck, not an assumed quantitative workup. Harsh laboratory hydrolysis