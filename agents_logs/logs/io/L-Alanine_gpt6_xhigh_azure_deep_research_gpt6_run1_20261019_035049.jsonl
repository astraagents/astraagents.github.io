e\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_020\",\n      \"formula\": \"FeS\",\n      \"iupac_name\": \"Iron(II) sulfide\",\n      \"common_name\": \"Freshly precipitated ferrous sulfide\",\n      \"inchi\": null,\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_021\",\n      \"formula\": \"FeS2\",\n      \"iupac_name\": \"Iron(II) disulfide\",\n      \"common_name\": \"Pyrite; speculative mineral-redox coproduct\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_022\",\n      \"formula\": \"FeH2O2\",\n      \"iupac_name\": \"Iron(II) hydroxide\",\n      \"common_name\": \"Ferrous hydroxide\",\n      \"inchi\": null,\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_023\",\n      \"formula\": \"FeHO2\",\n      \"iupac_name\": \"Iron(III) oxide hydroxide\",\n      \"common_name\": \"Ferric oxyhydroxide equivalent\",\n      \"inchi\": null,\n      \"role\": \"hub_intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_024\",\n      \"formula\": \"SO3^2-\",\n      \"iupac_name\": \"Sulfite\",\n      \"common_name\": \"Sulfite ion\",\n      \"inchi\": null,\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_025\",\n      \"formula\": \"SO4^2-\",\n      \"iupac_name\": \"Sulfate\",\n      \"common_name\": \"Sulfate ion\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_026\",\n      \"formula\": \"C2H4N2\",\n      \"iupac_name\": \"2-Aminoacetonitrile\",\n      \"common_name\": \"Aminoacetonitrile\",\n      \"inchi\": \"InChI=1S/C2H4N2/c3-1-2-4/h1,3H2\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_027\",\n      \"formula\": \"C2H5NO2\",\n      \"iupac_name\": \"2-Aminoacetic acid\",\n      \"common_name\": \"Glycine\",\n      \"inchi\": \"InChI=1S/C2H5NO2/c3-1-2(4)5/h1,3H2,(H,4,5)\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_028\",\n      \"formula\": \"C2H2O3\",\n      \"iupac_name\": \"2-Oxoacetic acid\",\n      \"common_name\": \"Glyoxylic acid; reference form of glyoxylate\",\n      \"inchi\": \"InChI=1S/C2H2O3/c3-1-2(4)5/h1H,(H,4,5)\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_029\",\n      \"formula\": \"C3H5NO\",\n      \"iupac_name\": \"2-Hydroxypropanenitrile\",\n      \"common_name\": \"Racemic lactonitrile\",\n      \"inchi\": \"InChI=1S/C3H5NO/c1-3(5)2-4/h3,5H,1H3\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Hydrothermal\"\n    },\n    {\n      \"id\": \"mol_030\",\n      \"formula\": \"C3H6O3\",\n      \"iupac_name\": \"(2RS)-2-Hydroxypropanoic acid\",\n      \"common_name\": \"DL-Lactic acid; reference form of lactate\",\n      \"inchi\": \"InChI=1S/C3H6O3/c1-2(4)3(5)6/h2,4H,1H3,(H,5,6)\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_031\",\n      \"formula\": \"CH2O2\",\n      \"iupac_name\": \"Methanoic acid\",\n      \"common_name\": \"Formic acid; reference form of formate\",\n      \"inchi\": \"InChI=1S/CH2O2/c2-1-3/h1H,(H,2,3)\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Biochemical\"\n    },\n    {\n      \"id\": \"mol_032\",\n      \"formula\": \"C2H4O2\",\n      \"iupac_name\": \"Ethanoic acid\",\n      \"common_name\": \"Acetic acid; reference form of acetate\",\n      \"inchi\": \"InChI=1S/C2H4O2/c1-2(3)4/h1H3,(H,3,4)\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Biochemical\"\n    }\n  ],\n  \"reactions\": [\n    {\n      \"id\": \"rxn_001\",\n      \"name\": \"Electrical-discharge generation of aldehydes and cyanide\",\n      \"inputs\": [\"mol_005\", \"mol_004\", \"mol_001\"],\n      \"outputs\": [\"mol_006\", \"mol_007\", \"mol_008\", \"mol_003\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-330 K bulk gas and condensate; transient discharge channels are much hotter\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Anoxic, locally reducing methane/ammonia/water gas mixture; repeated electrical discharge and capture in aqueous condensate. Hydrogen represents the reduced-gas reservoir and possible discharge coproduct, not a specified experimental yield.\"\n      },\n      \"mechanism\": \"Energetic gas-phase radical chemistry generates HCN and carbonyl compounds, which dissolve in condensate. This node summarizes a product network rather than one elementary reaction.\",\n      \"reasoning\": \"Miller (1955, 1957) identified aldehydes and HCN as precursors explaining amino-acid formation through Strecker chemistry. Johnson et al. (2008) and Parker et al. (2011) support localized volcanic-discharge variants. Trail et al. (2011) argue against assuming a permanently methane/ammonia-dominated global atmosphere, so this node requires a local or episodic reducing gas source. No iron catalyst is assigned because Miller (1957) found no substantial benefit from added ferrous salt.\"\n    },\n    {\n      \"id\": \"rxn_002\",\n      \"name\": \"NiS-mediated acetylene hydration to acetaldehyde\",\n      \"inputs\": [\"mol_009\", \"mol_001\", \"mol_010\"],\n      \"outputs\": [\"mol_007\", \"mol_010\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\n        \"Freshly precipitated nickel(II) sulfide; heterogeneous hydration catalyst\"\n      ],\n      \"conditions\": {\n        \"temperature\": \"378 K\",\n        \"pressure\": \"Sealed vessel; sufficient pressure to retain liquid water and the acetylene/CO gas charge\",\n        \"catalyst\": \"Nickel(II) sulfide\",\n        \"aqueous\": true,\n        \"other\": \"Anoxic acetylene/CO/water system. CO is retained on both sides as an experimental cofeed, not assigned net consumption in the hydration step. Subsequent Strecker chemistry requires a different pH regime.\"\n      },\n      \"mechanism\": \"Surface-assisted hydration of acetylene gives an enol that tautomerizes to acetaldehyde.\",\n      \"reasoning\": \"The acetylene-NiS study in Communications Chemistry (2023; author names were not supplied in the research report) demonstrated millimolar acetaldehyde at 105 degrees Celsius. FeS alone did not give detectable free acetaldehyde, supporting the specific use of NiS rather than a generic sulfide. Added cyanide and ammonium subsequently gave only about 180 micromolar alanine after seven days, so acetaldehyde production does not establish an efficient complete alanine synthesis.\"\n    },\n    {\n      \"id\": \"rxn_003\",\n      \"name\": \"Acetaldehyde Strecker formation of alaninonitrile\",\n      \"inputs\": [\"mol_007\", \"mol_004\", \"mol_008\"],\n      \"outputs\": [\"mol_011\", \"mol_001\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-330 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Proposed concentrated receiving pool at pH approximately 8-10; sufficient free ammonia and cyanide activity; limit HCN volatilization. Acetaldehyde may arrive from discharge condensate or a cooled NiS reactor.\"\n      },\n      \"mechanism\": \"Ammonia adds to acetaldehyde to form a carbinolamine; dehydration generates an imine/iminium species, followed by cyanide addition to either face.\",\n      \"reasoning\": \"Miller (1957) supports the aldehyde/HCN/aminonitrile mechanism. The Communications Chemistry acetylene-NiS study (2023; authors not supplied) detected aminoethanol and alaninonitrile after alkaline adjustment. Achiral reagents provide no intrinsic L preference. The proposed mild receiving-pool conditions should not be interpreted as a demonstrated optimum, and competition with lactonitrile depends strongly on pH and ammonia availability.\"\n    },\n    {\n      \"id\": \"rxn_004\",\n      \"name\": \"Alaninonitrile hydrolysis to racemic alanine\",\n      \"inputs\": [\"mol_011\", \"mol_001\"],\n      \"outputs\": [\"mol_013\", \"mol_004\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\n        \"Aqueous acidity supplied by an acidic geothermal pool\"\n      ],\n      \"conditions\": {\n        \"temperature\": \"350-370 K proposed hydrolysis window\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": \"Hydronium ions\",\n        \"aqueous\": true,\n        \"other\": \"Separate acidic stage, approximately pH 1-3; extended residence, potentially days to weeks or longer. The required conversion time at natural acid activity remains to be established.\"\n      },\n      \"mechanism\": \"Sequential hydration and hydrolysis of the nitrile through an amide gives the carboxylic acid and releases ammonia, predominantly ammonium at the stated pH.\",\n      \"reasoning\": \"Miller (1957) experimentally supported aminonitrile hydrolysis as an explanation for amino-acid accumulation. The exact environmental temperature, acidity, and residence-time combination proposed here is an integration hypothesis rather than a quoted optimum. Hydrolysis preserves the racemic carbon-center distribution; it does not create L selectivity. This step can be a bottleneck when strong laboratory acid hydrolysis is replaced by natural aqueous conditions.\"\n    },\n    {\n      \"id\": \"rxn_005\",\n      \"name\": \"Ni3Fe-mediated carbon dioxide reduction supplying pyruvate\",\n      \"inputs\": [\"mol_002\", \"mol_003\"],\n      \"outputs\": [\"mol_012\", \"mol_031\", \"mol_032\", \"mol_001\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\n        \"Awaruite-like Ni3Fe nanoparticles; heterogeneous carbon-fixation catalyst\"\n      ],\n      \"conditions\": {\n        \"temperature\": \"298 K\",\n        \"pressure\": \"25 bar total CO2/H2 pressure\",\n        \"catalyst\": \"Ni3Fe\",\n        \"aqueous\": true,\n        \"other\": \"Approximately pH 6, CO2:H2 gas ratio 3:2, 24 hours. Classified as a cool pressurized prebiotic mineral interface, not a 350-600 K hot vent. No enzyme or molecular oxygen is involved.\"\n      },\n      \"mechanism\": \"Metal-surface CO2 reduction and carbon-carbon coupling generate a mixed carboxylate inventory containing a small pyruvate fraction.\",\n      \"reasoning\": \"Beyazay et al. (2023) reported approximately 26.72 mM formate, 0.04 mM acetate, and 0.02 mM pyruvate under these conditions. Formate and acetate are included because they dominate or compete with the target-directed carbon flux. The detailed elementary coupling sequence is not established here. Downstream Kaur et al. (2024) experiments used 30 mM pyruvate, roughly 1500 times the reported upstream concentration; concentration or sustained accumulation is therefore an unresolved integration requirement, not an assumed successful transfer.\"\n    },\n    {\n      \"id\": \"rxn_006\",\n      \"name\": \"Fresh FeS-promoted pyruvate reductive amination\",\n      \"inputs\": [\"mol_012\", \"mol_004\", \"mol_020\", \"mol_019\"],\n      \"outputs\": [\"mol_013\", \"mol_001\", \"mol_021\", \"mol_018\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\n        \"Freshly precipitated FeS; consumed redox-active promoter, not a demonstrated recyclable catalyst\"\n      ],\n      \"conditions\": {\n        \"temperature\": \"323 K\",\n        \"pressure\": \"Approximately 1 atm in a sealed anoxic vessel\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Approximately pH 8.8; about 17 hours in the reported reaction series; large ammonium excess and approximately 20 molar equivalents of FeS relative to keto acid. Hydron inputs represent buffered proton equivalents, not an acidic bulk pH.\"\n      },\n      \"mechanism\": \"Pyruvate condenses with ammonia and the resulting C=N functionality is reduced by a sacrificial FeS-associated redox process.\",\n      \"reasoning\": \"Huber and Wachtershauser (2003) reported up to approximately 52 mol% alanine from supplied pyruvate. FeS must be treated as a large-excess reducing material. IMPORTANT: the FeS2 and Fe2+ outputs are a SPECULATIVE formal redox closure corresponding to sulfide oxidation during conversion of FeS to disulfide; the supplied research does not identify these as the measured final mineral products. The organic conversion is supported, but this solid-phase mass balance requires validation. Keefe et al. (1995) caution against extending such a result into an established CO2/FeS/H2S autotrophic network.\"\n    },\n    {\n      \"id\": \"rxn_007\",\n      \"name\": \"Ferrous-hydroxide-promoted pyruvate reductive amination\",\n      \"inputs\": [\"mol_012\", \"mol_004\", \"mol_022\"],\n      \"outputs\": [\"mol_013\", \"mol_023\", \"mol_001\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\n        \"Freshly precipitated iron(II) hydroxide; sacrificial reducing phase\"\n      ],\n      \"conditions\": {\n        \"temperature\": \"323-348 K; range represented in the reported reaction series\",\n        \"pressure\": \"Approximately 1 atm in a sealed anoxic vessel\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Alkaline ammonia-containing solution, approximately pH 9; long mineral contact and excess freshly prepared ferrous material. This range is not asserted to be a separately measured alanine optimum for Fe(OH)2.\"\n      },\n      \"mechanism\": \"Ammonia-derived imine formation is followed by reduction coupled to oxidation of ferrous mineral equivalents.\",\n      \"reasoning\": \"Huber and Wachtershauser (2003) demonstrated alpha-keto-acid reductive amination with freshly precipitated Fe(OH)2 as well as FeS. The approximately 52% alanine value quoted for the FeS experiment is not transferred to this variant. FeOOH is a formal ferric solid equivalent that closes electron and atom bookkeeping, not an experimentally established assignment of the final crystal phase. No oxygen is required: the organic imine is the electron acceptor.\"\n    },\n    {\n      \"id\": \"rxn_008\",\n      \"name\": \"Mixed-valence iron-precipitate reductive amination\",\n      \"inputs\": [\"mol_012\", \"mol_004\", \"mol_022\", \"mol_023\"],\n      \"outputs\": [\"mol_013\", \"mol_023\", \"mol_001\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\n        \"Fresh mixed Fe(II)/Fe(III) hydroxide-oxyhydroxide precipitate; redox-active surface\"\n      ],\n      \"conditions\": {\n        \"temperature\": \"343 K\",\n        \"pressure\": \"Approximately 1 atm in a closed anoxic batch\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Approximately pH 10, initial Fe(II):Fe(III) ratio 1:1, excess ammonia, and 48-72 hours residence. Initial ferric material must already be available without introducing molecular oxygen into the reaction.\"\n      },\n      \"mechanism\": \"Mixed-valence surface chemistry favors reduction of the pyruvate/ammonia condensation product over direct carbonyl reduction; ferrous equivalents supply reducing power.\",\n      \"reasoning\": \"Barge et al. (2019) observed liquid products approaching approximately 70% alanine and 30% lactate under favorable batch conditions. These are product-distribution figures, not an isolated L-alanine yield. Fe(OH)2 and FeOOH represent formal Fe(II) and Fe(III) components, not a claim that the precipitate consists of two pure crystalline phases. FeOOH occurs on both sides because an initial ferric surface component is present while additional ferric equivalents can form. No alanine was detected in the study's flowing chimney experiments, making long residence and excess ammonia critical limitations.\"\n    },\n    {\n      \"id\": \"rxn_009\",\n      \"name\": \"Hydrogen-driven reductive amination on metallic nickel\",\n      \"inputs\": [\"mol_012\", \"mol_004\", \"mol_003\"],\n      \"outputs\": [\"mol_013\", \"mol_001\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\n        \"Metallic nickel; heterogeneous H2-activation catalyst\"\n      ],\n      \"conditions\": {\n        \"temperature\": \"295 K\",\n        \"pressure\": \"5 bar H2\",\n        \"catalyst\": \"Nickel\",\n        \"aqueous\": true,\n        \"other\": \"Approximately pH 7-8, 24 hours, 30 mM pyruvate; ammonium concentrations of 6-150 mM were investigated. Cool pressurized mineral-interface chemistry rather than hot-zone vent chemistry.\"\n      },\n      \"mechanism\": \"Nickel activates molecular hydrogen and hydrogenates the imine/iminium formed from pyruvate and ammonia.\",\n      \"reasoning\": \"Kaur et al. (2024) demonstrated H2-dependent alanine formation, including up to approximately 17% yield relative to ammonia with Ni in the low-ammonia assay. Hydrogen removal abolished product formation, supporting genuine catalysis rather than consumption of the metal as the principal electron donor. Ni and serpentinization-derived H2 are geochemically plausible, but metallic-surface accessibility, poisoning, ammonia supply, and the upstream pyruvate concentration gap remain unresolved. No L-selective catalyst is present.\"\n    },\n    {\n      \"id\": \"rxn_010\",\n      \"name\": \"Hydrogen-driven reductive amination on meteoritic Fe-Ni alloy\",\n      \"inputs\": [\"mol_012\", \"mol_004\", \"mol_003\"],\n      \"outputs\": [\"mol_013\", \"mol_001\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\n        \"Exposed Fe-Ni meteoritic alloy; Aletai meteorite powder was the experimental analogue\"\n      ],\n      \"conditions\": {\n        \"temperature\": \"295 K\",\n        \"pressure\": \"5 bar H2\",\n        \"catalyst\": \"Fe-Ni meteoritic alloy\",\n        \"aqueous\": true,\n        \"other\": \"Approximately pH 7-8 and 24 hours; pyruvate and ammonium supplied. Laboratory powdered meteorite provides substantially more accessible surface than intact meteoritic metal.\"\n      },\n      \"mechanism\": \"Ni-containing alloy sites activate H2 and reduce ammonia-derived pyruvate imines, while competing sites also hydrogenate pyruvate to lactate.\",\n      \"reasoning\": \"Kaur et al. (2024) reported approximately 24% alanine and 43% lactate with powdered Aletai meteorite containing about 18 mol% Ni. These values are not asserted to apply to every ammonia loading or natural alloy surface. This is a distinct catalyst-access pathway within the same H2-driven reaction family, not a separate fundamental amination mechanism. Episodic delivery, weathering, surface area, and competition from lactate constrain its environmental importance.\"\n    },\n    {\n      \"id\": \"rxn_011\",\n      \"name\": \"ZnS-photocatalytic reductive amination with sulfite oxidation\",\n      \"inputs\": [\"mol_012\", \"mol_004\", \"mol_024\"],\n      \"outputs\": [\"mol_013\", \"mol_025\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\n        \"Sphalerite ZnS; semiconductor photocatalyst\"\n      ],\n      \"conditions\": {\n        \"temperature\": \"303 K\",\n        \"pressure\": \"Approximately 1 atm under anoxic conditions\",\n        \"catalyst\": \"Zinc sulfide\",\n        \"aqueous\": true,\n        \"other\": \"Approximately pH 9; several hours of suitable UV illumination; sulfite acts as a sacrificial hole scavenger. Requires an illuminated shallow pool or exposed mineral interface.\"\n      },\n      \"mechanism\": \"Photoexcited ZnS supplies conduction-band electrons for reduction of the pyruvate/ammonia condensation product. Sulfite consumes oxidative holes; sulfate is the formal fully oxidized sulfur endpoint.\",\n      \"reasoning\": \"Wang et al. (2012) demonstrated light- and ZnS-dependent keto-acid amination, including pyruvate to alanine, with sulfite available as a hole scavenger. Explicit sulfite oxidation prevents treating light as an electron source without an accompanying donor. Sulfate is used for net redox bookkeeping rather than as a claimed exclusive measured sulfur product. As emphasized by Novikov and Copley (2013), this mechanism cannot operate in a dark deep-ocean vent. No L preference was established.\"\n    },\n    {\n      \"id\": \"rxn_012\",\n      \"name\": \"Hydroxylamine and metallic-iron reductive nitrogen incorporation\",\n      \"inputs\": [\"mol_012\", \"mol_016\", \"mol_017\", \"mol_019\"],\n      \"outputs\": [\"mol_013\", \"mol_018\", \"mol_001\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\n        \"Metallic iron powder; consumed electron donor rather than a recyclable catalyst\"\n      ],\n      \"conditions\": {\n        \"temperature\": \"300-343 K proposed integration window; the supplied summary does not specify the exact amination-stage temperature\",\n        \"pressure\": \"Approximately 1 atm in an anoxic closed vessel\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Hydroxylamine hydrochloride at approximately six equivalents and Fe0 at approximately ten equivalents in the reported network. Proton availability and iron dissolution must be maintained; exact natural pH and residence time remain unvalidated.\"\n      },\n      \"mechanism\": \"Hydroxylamine forms an N-O-containing carbonyl adduct, plausibly an oxime, followed by reduction and N-O bond cleavage driven by Fe0 oxidation.\",\n      \"reasoning\": \"Muchowska, Varma and Moran (2019) obtained alanine after adding hydroxylamine and Fe0 to keto-acid-containing mixtures, and related substrate tests supported reductive nitrogen incorporation. The net Fe0-to-Fe2+ balance supplies the electrons needed for reduction of an N-O precursor. This does not establish a freely accumulated oxime intermediate or the proposed environmental temperature window. Hydroxylamine production and persistence, unusually reducing metal sources, competing hydrogen evolution, and large reagent excesses are major unresolved requirements.\"\n    },\n    {\n      \"id\": \"rxn_013\",\n      \"name\": \"Formaldehyde Strecker synthesis of aminoacetonitrile\",\n      \"inputs\": [\"mol_006\", \"mol_004\", \"mol_008\"],\n      \"outputs\": [\"mol_026\", \"mol_001\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-330 K proposed receiving-pool window\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Concentrated aldehyde, ammonia, and cyanide inventory; approximately pH 8-10. Competing formaldehyde condensations and HCN loss can reduce glycine-precursor accumulation.\"\n      },\n      \"mechanism\": \"Formaldehyde and ammonia form an imine-equivalent that is trapped by cyanide, giving aminoacetonitrile.\",\n      \"reasoning\": \"Miller (1957) supports aldehyde/HCN Strecker chemistry as a source of glycine and related amino acids; Patel et al. (2015) also demonstrated access to glycine aminonitrile within a broader precursor network. This edge supplies the otherwise pre-existing organic nitrogen donor required by the transamination pathway. It does not import the complete cyanosulfidic network or claim that all its upstream chemistry is represented here.\"\n    },\n    {\n      \"id\": \"rxn_014\",\n      \"name\": \"Aminoacetonitrile hydrolysis supplying glycine\",\n      \"inputs\": [\"mol_026\", \"mol_001\"],\n      \"outputs\": [\"mol_027\", \"mol_004\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\n        \"Aqueous acidity supplied by an acidic geothermal pool\"\n      ],\n      \"conditions\": {\n        \"temperature\": \"350-370 K proposed hydrolysis window\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": \"Hydronium ions\",\n        \"aqueous\": true,\n        \"other\": \"Separate acidic stage at approximately pH 1-3; prolonged residence. Subsequent accumulation or evaporation is needed before high-concentration transamination.\"\n      },\n      \"mechanism\": \"Nitrile hydration followed by amide hydrolysis produces glycine and releases ammonia/ammonium.\",\n      \"reasoning\": \"Miller (1957) established the relevance of aminonitrile hydrolysis to amino-acid accumulation. The proposed mild geothermal implementation and its rate are not separately demonstrated by the supplied research. Generating some glycine is substantially less demanding than accumulating the approximately 350 mM glycine used in Stubbs et al. (2020), so this network does not assume that hydrolysis automatically supplies the downstream experimental concentration.\"\n    },\n    {\n      \"id\": \"rxn_015\",\n      \"name\": \"Alum-promoted transamination from glycine to pyruvate\",\n      \"inputs\": [\"mol_012\", \"mol_027\"],\n      \"outputs\": [\"mol_013\", \"mol_028\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\n        \"Potassium alum; source of catalytically active aqueous aluminium species\"\n      ],\n      \"conditions\": {\n        \"temperature\": \"353 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": \"Potassium alum-derived aluminium species\",\n        \"aqueous\": true,\n        \"other\": \"pH 5, approximately 350 mM glycine, 1.2 equivalents pyruvate, 0.1 equivalent potassium alum, 24 hours. Requires a concentrated, mildly acidic setting distinct from alkaline amination pools.\"\n      },\n      \"mechanism\": \"Schiff-base formation, proton transfers, and hydrolysis transfer the glycine amino group to pyruvate, producing alanine and glyoxylate without fixing additional nitrogen.\",\n      \"reasoning\": \"Stubbs et al. (2020) reported approximately 19% alanine under these conditions. The alanine-forming experiment used alum and therefore should not be called metal-free. Upstream glycine synthesis is explicitly included, but its concentration and delivery remain bottlenecks. Similarity to biological transamination does not establish historical ancestry or L stereoselectivity; the achiral reaction is represented as producing a racemic alanine pool.\"\n    },\n    {\n      \"id\": \"rxn_016\",\n      \"name\": \"Competing acetaldehyde cyanohydrin formation\",\n      \"inputs\": [\"mol_007\", \"mol_008\"],\n      \"outputs\": [\"mol_029\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"378 K experimental acetylene-NiS system\",\n        \"pressure\": \"Sealed aqueous vessel\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Acidic stage near pH 3, with little available free ammonia. NiS is not assigned an independent catalytic role in this carbonyl-addition step.\"\n      },\n      \"mechanism\": \"Cyanide addition to acetaldehyde and proton transfer form lactonitrile rather than the nitrogen-substituted alanine precursor.\",\n      \"reasoning\": \"Miller (1957) identified competing amino- and hydroxynitrile chemistry. The Communications Chemistry acetylene-NiS study (2023; authors not supplied) reported approximately 10.2 mM lactonitrile at pH 3 with no alanine. This sink is included because acetaldehyde production alone does not determine alanine yield; ammonia speciation and pH control carbon partitioning.\"\n    },\n    {\n      \"id\": \"rxn_017\",\n      \"name\": \"Lactonitrile hydrolysis to lactic acid\",\n      \"inputs\": [\"mol_029\", \"mol_001\"],\n      \"outputs\": [\"mol_030\", \"mol_004\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\n        \"Aqueous acidity\"\n      ],\n      \"conditions\": {\n        \"temperature\": \"350-370 K proposed downstream hydrolysis window\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": \"Hydronium ions\",\n        \"aqueous\": true,\n        \"other\": \"Acidic geothermal receiving pool with prolonged residence; actual environmental conversion rate requires measurement.\"\n      },\n      \"mechanism\": \"Hydrolysis converts the nitrile group to a carboxyl group while retaining the alpha-hydroxyl substituent.\",\n      \"reasoning\": \"Miller (1957) supports the hydroxynitrile-to-hydroxy-acid branch competing with amino-acid formation. The specific natural hydrolysis conditions are an integration proposal, not a quoted rate measurement. This edge records irreversible loss of useful precursor carbon into lactate on the timescale of the modeled alanine pathways.\"\n    },\n    {\n      \"id\": \"rxn_018\",\n      \"name\": \"Competing hydrogenation of pyruvate to lactate\",\n      \"inputs\": [\"mol_012\", \"mol_003\"],\n      \"outputs\": [\"mol_030\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\n        \"Ni-containing Fe-Ni alloy surface\"\n      ],\n      \"conditions\": {\n        \"temperature\": \"295 K\",\n        \"pressure\": \"5 bar H2\",\n        \"catalyst\": \"Fe-Ni alloy\",\n        \"aqueous\": true,\n        \"other\": \"Approximately pH 7-8 and 24 hours; competes in the same ammonia-containing mineral-contact system used for reductive amination.\"\n      },\n      \"mechanism\": \"Surface-activated hydrogen reduces the pyruvate carbonyl directly, bypassing nitrogen incorporation.\",\n      \"reasoning\": \"Kaur et al. (2024) reported substantial lactate alongside alanine, including approximately 43% lactate with the Aletai meteorite preparation. Novikov and Copley (2013) likewise showed that mineral identity changes the entire pyruvate reaction landscape. This sink prevents interpreting pyruvate consumption as equivalent to alanine production.\"\n    },\n    {\n      \"id\": \"rxn_019\",\n      \"name\": \"SPECULATIVE physical resolution of racemic alanine\",\n      \"inputs\": [\"mol_013\"],\n      \"outputs\": [\"mol_014\", \"mol_015\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\n        \"Single-handed alpha-quartz faces as a hypothetical resolving adsorbent; alanine discrimination and its sign are unvalidated\"\n      ],\n      \"conditions\": {\n        \"temperature\": \"300-320 K proposed separation window\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Hypothetical repeated adsorption, washing, and fractional desorption at approximately pH 5-7 on an exposed handed surface. Requires experimentally verified differential adsorption and natural spatial separation. UV shielding may be needed for product survival. No L-alanine seed is assumed.\"\n      },\n      \"mechanism\": \"A genuinely enantiodiscriminating surface could partition L- and D-alanine into different fractions. The outputs represent ideal separated enantiomer inventories; achievable enrichment, purity, recovery, and number of cycles are unknown. This is physical separation, not D-to-L conversion.\",\n      \"reasoning\": \"SPECULATIVE and not established by any supplied study. Intrinsically chiral quartz motivates testing unequal adsorption free energies, but the supplied evidence does not demonstrate alanine resolution on quartz or identify an L-preferring face. Miller (1955) and Parker et al. (2011) support racemic synthesis, while Li et al. (2024) found a D-alanine excess on natural pyrite, not an explanation for L selection. That result motivates investigating surface discrimination but cannot validate this separator. Without racemization or asymmetric synthesis, separation cannot recover more L-alanine than the initial L fraction, approximately half of a racemate before losses. All ten isolated-L pathways remain conditional on this unresolved node.\"\n    }\n  ],\n  \"pathways\": [\n    {\n      \"pathway_id\": \"P1\",\n      \"name\": \"Atmospheric-discharge Strecker pathway\",\n      \"description\": \"Discharge produces both acetaldehyde and HCN. Aqueous Strecker chemistry and nitrile hydrolysis generate DL-alanine. Reaching separated L-alanine additionally requires the speculative resolution node.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_003\", \"rxn_004\", \"rxn_019\"],\n      \"key_intermediates\": [\"mol_007\", \"mol_008\", \"mol_011\", \"mol_013\"]\n    },\n    {\n      \"pathway_id\": \"P2\",\n      \"name\": \"Acetylene-NiS carbonyl supply followed by Strecker chemistry\",\n      \"description\": \"NiS hydration supplies the acetaldehyde used in this pathway; discharge supplies the required HCN. The acetaldehyde coproduct of the discharge is not the selected carbonyl source here. Cooling and pH evolution connect the demonstrated but low-yield chemistry to nitrile hydrolysis and conditional L resolution.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_002\", \"rxn_003\", \"rxn_004\", \"rxn_019\"],\n      \"key_intermediates\": [\"mol_007\", \"mol_008\", \"mol_011\", \"mol_013\"]\n    },\n    {\n      \"pathway_id\": \"P3\",\n      \"name\": \"CO2 fixation followed by sacrificial FeS reductive amination\",\n      \"description\": \"Ni3Fe supplies a dilute pyruvate inventory that must accumulate before FeS-promoted amination. Organic alanine formation is supported, but the encoded mineral oxidation endpoint and subsequent L resolution are explicitly unresolved.\",\n      \"reaction_sequence\": [\"rxn_005\", \"rxn_006\", \"rxn_019\"],\n      \"key_intermediates\": [\"mol_012\", \"mol_013\"]\n    },\n    {\n      \"pathway_id\": \"P4\",\n      \"name\": \"CO2 fixation followed by ferrous-hydroxide amination\",\n      \"description\": \"Pyruvate from Ni3Fe carbon fixation undergoes ammonia incorporation driven by fresh Fe(OH)2. This is a distinct sacrificial mineral variant, not an independently demonstrated L-selective reaction.\",\n      \"reaction_sequence\": [\"rxn_005\", \"rxn_007\", \"rxn_019\"],\n      \"key_intermediates\": [\"mol_012\", \"mol_013\"]\n    },\n    {\n      \"pathway_id\": \"P5\",\n      \"name\": \"CO2 fixation followed by mixed-valence iron batch chemistry\",\n      \"description\": \"Pyruvate is delivered to a long-residence alkaline mixed-iron precipitate system. Batch alanine formation is supported, but natural concentration, ferric-phase availability, and transfer performance are unresolved. L isolation remains conditional.\",\n      \"reaction_sequence\": [\"rxn_005\", \"rxn_008\", \"rxn_019\"],\n      \"key_intermediates\": [\"mol_012\", \"mol_023\", \"mol_013\"]\n    },\n    {\n      \"pathway_id\": \"P6\",\n      \"name\": \"CO2 fixation followed by H2-nickel reductive amination\",\n      \"description\": \"Ni3Fe carbon fixation supplies pyruvate, followed by H2-driven amination on metallic Ni. Both transformations are demonstrated separately, but the roughly three-order-of-magnitude precursor concentration mismatch is not solved by this graph.\",\n      \"reaction_sequence\": [\"rxn_005\", \"rxn_009\", \"rxn_019\"],\n      \"key_intermediates\": [\"mol_012\", \"mol_013\"]\n    },\n    {\n      \"pathway_id\": \"P7\",\n      \"name\": \"CO2 fixation followed by H2-meteoritic-alloy amination\",\n      \"description\": \"An exposed Fe-Ni meteoritic catalyst replaces pure nickel in the H2-driven terminal conversion. This is a distinct catalyst-supply pathway within the same reductive-amination family; lactate competes strongly and L resolution is unvalidated.\",\n      \"reaction_sequence\": [\"rxn_005\", \"rxn_010\", \"rxn_019\"],\n      \"key_intermediates\": [\"mol_012\", \"mol_013\"]\n    },\n    {\n      \"pathway_id\": \"P8\",\n      \"name\": \"CO2 fixation followed by illuminated ZnS amination\",\n      \"description\": \"Pyruvate reaches a UV-exposed ZnS-bearing pool where sulfite supplies sacrificial reducing equivalents through the photocatalytic cycle. This requires an illuminated surface setting rather than a dark vent, followed by hypothetical L resolution.\",\n      \"reaction_sequence\": [\"rxn_005\", \"rxn_011\", \"rxn_019\"],\n      \"key_intermediates\": [\"mol_012\", \"mol_013\"]\n    },\n    {\n      \"pathway_id\": \"P9\",\n      \"name\": \"CO2 fixation followed by hydroxylamine-iron nitrogen incorporation\",\n      \"description\": \"Pyruvate reacts with hydroxylamine using metallic iron as the consumed reductant. This nitrogen-entry route avoids requiring ammonia for the alanine-forming step but requires independently available hydroxylamine and native metal. Its L endpoint remains conditional.\",\n      \"reaction_sequence\": [\"rxn_005\", \"rxn_012\", \"rxn_019\"],\n      \"key_intermediates\": [\"mol_012\", \"mol_013\"]\n    },\n    {\n      \"pathway_id\": \"P10\",\n      \"name\": \"Strecker-derived glycine coupled to pyruvate transamination\",\n      \"description\": \"Discharge-derived formaldehyde and HCN supply glycine through aminoacetonitrile. Independently formed pyruvate receives glycine's amino group in the alum-promoted reaction. This transfers existing organic nitrogen rather than fixing new nitrogen; high reactant concentrations and final L resolution remain unresolved.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_013\", \"rxn_014\", \"rxn_005\", \"rxn_015\", \"rxn_019\"],\n      \"key_intermediates\": [\"mol_006\", \"mol_008\", \"mol_026\", \"mol_027\", \"mol_012\", \"mol_013\"]\n    }\n  ],\n  \"hub_molecules\": [\n    \"mol_001\",\n    \"mol_003\",\n    \"mol_004\",\n    \"mol_007\",\n    \"mol_008\",\n    \"mol_012\",\n    \"mol_013\",\n    \"mol_018\",\n    \"mol_019\",\n    \"mol_022\",\n    \"mol_023\",\n    \"mol_030\"\n  ],\n  \"convergence_points\": [\n    {\n      \"molecule_id\": \"mol_007\",\n      \"incoming_reactions\": [\"rxn_001\", \"rxn_002\"],\n      \"outgoing_reactions\": [\"rxn_003\", \"rxn_016\"]\n    },\n    {\n      \"molecule_id\": \"mol_013\",\n      \"incoming_reactions\": [\n        \"rxn_004\",\n        \"rxn_006\",\n        \"rxn_007\",\n        \"rxn_008\",\n        \"rxn_009\",\n        \"rxn_010\",\n        \"rxn_011\",\n        \"rxn_012\",\n        \"rxn_015\"\n      ],\n      \"outgoing_reactions\": [\"rxn_019\"]\n    },\n    {\n      \"molecule_id\": \"mol_030\",\n      \"incoming_reactions\": [\"rxn_017\", \"rxn_018\"],\n      \"outgoing_reactions\": []\n    }\n  ]\n}", "parsed_response": {"target_molecule": "L-Alanine", "overall_strategy": "Construct ten distinct, connected synthesis sequences: two acetaldehyde/Strecker routes, seven mineral-dependent pyruvate amination routes, and one glycine-to-pyruvate transamination route. These are experimentally supported routes to alanine, not ten demonstrated routes to enantiopure L-alanine. All terminate in a racemic alanine pool followed by one explicitly speculative resolution step. The network exceeds the node-count minima to represent electron donors, necessary precursor synthesis, and competing sinks. Reaction nodes may combine several mechanistic steps. Organic acids and ammonia are represented using reference protonation states; actual speciation follows the stated pH. Mineral oxidation products are identified as formal bookkeeping equivalents where their experimental identities are unresolved. The DL-alanine node represents a racemic pool, not a third alanine stereoisomer; its nonstereochemical InChI does not itself encode the mixture composition. A null environment_formed indicates an externally supplied resource or formation in multiple environments. Coproducts use the intermediate role because the schema has no coproduct category. No reaction requires molecular oxygen. The final isolated-L endpoint remains conditional on an unvalidated separation mechanism.", "molecules": [{"id": "mol_001", "formula": "H2O", "iupac_name": "Oxidane", "common_name": "Water", "inchi": "InChI=1S/H2O/h1H2", "role": "starting", "environment_formed": null}, {"id": "mol_002", "formula": "CO2", "iupac_name": "Carbon dioxide", "common_name": "Carbon dioxide", "inchi": "InChI=1S/CO2/c2-1-3", "role": "starting", "environment_formed": null}, {"id": "mol_003", "formula": "H2", "iupac_name": "Dihydrogen", "common_name": "Hydrogen", "inchi": "InChI=1S/H2/h1H", "role": "starting", "environment_formed": null}, {"id": "mol_004", "formula": "NH3", "iupac_name": "Azane", "common_name": "Ammonia", "inchi": "InChI=1S/H3N/h1H3", "role": "starting", "environment_formed": null}, {"id": "mol_005", "formula": "CH4", "iupac_name": "Methane", "common_name": "Methane", "inchi": "InChI=1S/CH4/h1H4", "role": "starting", "environment_formed": null}, {"id": "mol_006", "formula": "CH2O", "iupac_name": "Methanal", "common_name": "Formaldehyde", "inchi": "InChI=1S/CH2O/c1-2/h1H2", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_007", "formula": "C2H4O", "iupac_name": "Ethanal", "common_name": "Acetaldehyde", "inchi": "InChI=1S/C2H4O/c1-2-3/h2H,1H3", "role": "hub_intermediate", "environment_formed": null}, {"id": "mol_008", "formula": "HCN", "iupac_name": "Hydrogen cyanide", "common_name": "Hydrogen cyanide", "inchi": "InChI=1S/CHN/c1-2/h1H", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_009", "formula": "C2H2", "iupac_name": "Ethyne", "common_name": "Acetylene", "inchi": "InChI=1S/C2H2/c1-2/h1-2H", "role": "starting", "environment_formed": null}, {"id": "mol_010", "formula": "CO", "iupac_name": "Carbon monoxide", "common_name": "Carbon monoxide", "inchi": "InChI=1S/CO/c1-2", "role": "starting", "environment_formed": null}, {"id": "mol_011", "formula": "C3H6N2", "iupac_name": "2-Aminopropanenitrile", "common_name": "Racemic alaninonitrile", "inchi": "InChI=1S/C3H6N2/c1-3(5)2-4/h3H,5H2,1H3", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_012", "formula": "C3H4O3", "iupac_name": "2-Oxopropanoic acid", "common_name": "Pyruvic acid; reference form of the pyruvate pool", "inchi": "InChI=1S/C3H4O3/c1-2(4)3(5)6/h1H3,(H,5,6)", "role": "hub_intermediate", "environment_formed": "Biochemical"}, {"id": "mol_013", "formula": "C3H7NO2", "iupac_name": "(2RS)-2-Aminopropanoic acid", "common_name": "DL-Alanine; racemic pool", "inchi": "InChI=1S/C3H7NO2/c1-2(4)3(5)6/h2H,4H2,1H3,(H,5,6)", "role": "hub_intermediate", "environment_formed": null}, {"id": "mol_014", "formula": "C3H7NO2", "iupac_name": "(2S)-2-Aminopropanoic acid", "common_name": "L-Alanine", "inchi": "InChI=1S/C3H7NO2/c1-2(4)3(5)6/h2H,4H2,1H3,(H,5,6)/t2-/m0/s1", "role": "target", "environment_formed": "Surface"}, {"id": "mol_015", "formula": "C3H7NO2", "iupac_name": "(2R)-2-Aminopropanoic acid", "common_name": "D-Alanine", "inchi": "InChI=1S/C3H7NO2/c1-2(4)3(5)6/h2H,4H2,1H3,(H,5,6)/t2-/m1/s1", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_016", "formula": "H3NO", "iupac_name": "Hydroxylamine", "common_name": "Hydroxylamine", "inchi": "InChI=1S/H3NO/c1-2/h2H,1H2", "role": "starting", "environment_formed": null}, {"id": "mol_017", "formula": "Fe", "iupac_name": "Iron", "common_name": "Native or meteoritic metallic iron", "inchi": "InChI=1S/Fe", "role": "starting", "environment_formed": null}, {"id": "mol_018", "formula": "Fe2+", "iupac_name": "Iron(2+)", "common_name": "Ferrous ion", "inchi": "InChI=1S/Fe/q+2", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_019", "formula": "H+", "iupac_name": "Hydron", "common_name": "Proton; aqueous acid-equivalent bookkeeping", "inchi": "InChI=1S/p+1", "role": "starting", "environment_formed": null}, {"id": "mol_020", "formula": "FeS", "iupac_name": "Iron(II) sulfide", "common_name": "Freshly precipitated ferrous sulfide", "inchi": null, "role": "starting", "environment_formed": null}, {"id": "mol_021", "formula": "FeS2", "iupac_name": "Iron(II) disulfide", "common_name": "Pyrite; speculative mineral-redox coproduct", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_022", "formula": "FeH2O2", "iupac_name": "Iron(II) hydroxide", "common_name": "Ferrous hydroxide", "inchi": null, "role": "starting", "environment_formed": null}, {"id": "mol_023", "formula": "FeHO2", "iupac_name": "Iron(III) oxide hydroxide", "common_name": "Ferric oxyhydroxide equivalent", "inchi": null, "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_024", "formula": "SO3^2-", "iupac_name": "Sulfite", "common_name": "Sulfite ion", "inchi": null, "role": "starting", "environment_formed": null}, {"id": "mol_025", "formula": "SO4^2-", "iupac_name": "Sulfate", "common_name": "Sulfate ion", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_026", "formula": "C2H4N2", "iupac_name": "2-Aminoacetonitrile", "common_name": "Aminoacetonitrile", "inchi": "InChI=1S/C2H4N2/c3-1-2-4/h1,3H2", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_027", "formula": "C2H5NO2", "iupac_name": "2-Aminoacetic acid", "common_name": "Glycine", "inchi": "InChI=1S/C2H5NO2/c3-1-2(4)5/h1,3H2,(H,4,5)", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_028", "formula": "C2H2O3", "iupac_name": "2-Oxoacetic acid", "common_name": "Glyoxylic acid; reference form of glyoxylate", "inchi": "InChI=1S/C2H2O3/c3-1-2(4)5/h1H,(H,4,5)", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_029", "formula": "C3H5NO", "iupac_name": "2-Hydroxypropanenitrile", "common_name": "Racemic lactonitrile", "inchi": "InChI=1S/C3H5NO/c1-3(5)2-4/h3,5H,1H3", "role": "intermediate", "environment_formed": "Hydrothermal"}, {"id": "mol_030", "formula": "C3H6O3", "iupac_name": "(2RS)-2-Hydroxypropanoic acid", "common_name": "DL-Lactic acid; reference form of lactate", "inchi": "InChI=1S/C3H6O3/c1-2(4)3(5)6/h2,4H,1H3,(H,5,6)", "role": "intermediate", "environment_formed": null}, {"id": "mol_031", "formula": "CH2O2", "iupac_name": "Methanoic acid", "common_name": "Formic acid; reference form of formate", "inchi": "InChI=1S/CH2O2/c2-1-3/h1H,(H,2,3)", "role": "intermediate", "environment_formed": "Biochemical"}, {"id": "mol_032", "formula": "C2H4O2", "iupac_name": "Ethanoic acid", "common_name": "Acetic acid; reference form of acetate", "inchi": "InChI=1S/C2H4O2/c1-2(3)4/h1H3,(H,3,4)", "role": "intermediate", "environment_formed": "Biochemical"}], "reactions": [{"id": "rxn_001", "name": "Electrical-discharge generation of aldehydes and cyanide", "inputs": ["mol_005", "mol_004", "mol_001"], "outputs": ["mol_006", "mol_007", "mol_008", "mol_003"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-330 K bulk gas and condensate; transient discharge channels are much hotter", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Anoxic, locally reducing methane/ammonia/water gas mixture; repeated electrical discharge and capture in aqueous condensate. Hydrogen represents the reduced-gas reservoir and possible discharge coproduct, not a specified experimental yield."}, "mechanism": "Energetic gas-phase radical chemistry generates HCN and carbonyl compounds, which dissolve in condensate. This node summarizes a product network rather than one elementary reaction.", "reasoning": "Miller (1955, 1957) identified aldehydes and HCN as precursors explaining amino-acid formation through Strecker chemistry. Johnson et al. (2008) and Parker et al. (2011) support localized volcanic-discharge variants. Trail et al. (2011) argue against assuming a permanently methane/ammonia-dominated global atmosphere, so this node requires a local or episodic reducing gas source. No iron catalyst is assigned because Miller (1957) found no substantial benefit from added ferrous salt."}, {"id": "rxn_002", "name": "NiS-mediated acetylene hydration to acetaldehyde", "inputs": ["mol_009", "mol_001", "mol_010"], "outputs": ["mol_007", "mol_010"], "environment": "Hydrothermal", "agents": ["Freshly precipitated nickel(II) sulfide; heterogeneous hydration catalyst"], "conditions": {"temperature": "378 K", "pressure": "Sealed vessel; sufficient pressure to retain liquid water and the acetylene/CO gas charge", "catalyst": "Nickel(II) sulfide", "aqueous": true, "other": "Anoxic acetylene/CO/water system. CO is retained on both sides as an experimental cofeed, not assigned net consumption in the hydration step. Subsequent Strecker chemistry requires a different pH regime."}, "mechanism": "Surface-assisted hydration of acetylene gives an enol that tautomerizes to acetaldehyde.", "reasoning": "The acetylene-NiS study in Communications Chemistry (2023; author names were not supplied in the research report) demonstrated millimolar acetaldehyde at 105 degrees Celsius. FeS alone did not give detectable free acetaldehyde, supporting the specific use of NiS rather than a generic sulfide. Added cyanide and ammonium subsequently gave only about 180 micromolar alanine after seven days, so acetaldehyde production does not establish an efficient complete alanine synthesis."}, {"id": "rxn_003", "name": "Acetaldehyde Strecker formation of alaninonitrile", "inputs": ["mol_007", "mol_004", "mol_008"], "outputs": ["mol_011", "mol_001"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-330 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Proposed concentrated receiving pool at pH approximately 8-10; sufficient free ammonia and cyanide activity; limit HCN volatilization. Acetaldehyde may arrive from discharge condensate or a cooled NiS reactor."}, "mechanism": "Ammonia adds to acetaldehyde to form a carbinolamine; dehydration generates an imine/iminium species, followed by cyanide addition to either face.", "reasoning": "Miller (1957) supports the aldehyde/HCN/aminonitrile mechanism. The Communications Chemistry acetylene-NiS study (2023; authors not supplied) detected aminoethanol and alaninonitrile after alkaline adjustment. Achiral reagents provide no intrinsic L preference. The proposed mild receiving-pool conditions should not be interpreted as a demonstrated optimum, and competition with lactonitrile depends strongly on pH and ammonia availability."}, {"id": "rxn_004", "name": "Alaninonitrile hydrolysis to racemic alanine", "inputs": ["mol_011", "mol_001"], "outputs": ["mol_013", "mol_004"], "environment": "Surface", "agents": ["Aqueous acidity supplied by an acidic geothermal pool"], "conditions": {"temperature": "350-370 K proposed hydrolysis window", "pressure": "Approximately 1 atm", "catalyst": "Hydronium ions", "aqueous": true, "other": "Separate acidic stage, approximately pH 1-3; extended residence, potentially days to weeks or longer. The required conversion time at natural acid activity remains to be established."}, "mechanism": "Sequential hydration and hydrolysis of the nitrile through an amide gives the carboxylic acid and releases ammonia, predominantly ammonium at the stated pH.", "reasoning": "Miller (1957) experimentally supported aminonitrile hydrolysis as an explanation for amino-acid accumulation. The exact environmental temperature, acidity, and residence-time combination proposed here is an integration hypothesis rather than a quoted optimum. Hydrolysis preserves the racemic carbon-center distribution; it does not create L selectivity. This step can be a bottleneck when strong laboratory acid hydrolysis is replaced by natural aqueous conditions."}, {"id": "rxn_005", "name": "Ni3Fe-mediated carbon dioxide reduction supplying pyruvate", "inputs": ["mol_002", "mol_003"], "outputs": ["mol_012", "mol_031", "mol_032", "mol_001"], "environment": "Biochemical", "agents": ["Awaruite-like Ni3Fe nanoparticles; heterogeneous carbon-fixation catalyst"], "conditions": {"temperature": "298 K", "pressure": "25 bar total CO2/H2 pressure", "catalyst": "Ni3Fe", "aqueous": true, "other": "Approximately pH 6, CO2:H2 gas ratio 3:2, 24 hours. Classified as a cool pressurized prebiotic mineral interface, not a 350-600 K hot vent. No enzyme or molecular oxygen is involved."}, "mechanism": "Metal-surface CO2 reduction and carbon-carbon coupling generate a mixed carboxylate inventory containing a small pyruvate fraction.", "reasoning": "Beyazay et al. (2023) reported approximately 26.72 mM formate, 0.04 mM acetate, and 0.02 mM pyruvate under these conditions. Formate and acetate are included because they dominate or compete with the target-directed carbon flux. The detailed elementary coupling sequence is not established here. Downstream Kaur et al. (2024) experiments used 30 mM pyruvate, roughly 1500 times the reported upstream concentration; concentration or sustained accumulation is therefore an unresolved integration requirement, not an assumed successful transfer."}, {"id": "rxn_006", "name": "Fresh FeS-promoted pyruvate reductive amination", "inputs": ["mol_012", "mol_004", "mol_020", "mol_019"], "outputs": ["mol_013", "mol_001", "mol_021", "mol_018"], "environment": "Surface", "agents": ["Freshly precipitated FeS; consumed redox-active promoter, not a demonstrated recyclable catalyst"], "conditions": {"temperature": "323 K", "pressure": "Approximately 1 atm in a sealed anoxic vessel", "catalyst": null, "aqueous": true, "other": "Approximately pH 8.8; about 17 hours in the reported reaction series; large ammonium excess and approximately 20 molar equivalents of FeS relative to keto acid. Hydron inputs represent buffered proton equivalents, not an acidic bulk pH."}, "mechanism": "Pyruvate condenses with ammonia and the resulting C=N functionality is reduced by a sacrificial FeS-associated redox process.", "reasoning": "Huber and Wachtershauser (2003) reported up to approximately 52 mol% alanine from supplied pyruvate. FeS must be treated as a large-excess reducing material. IMPORTANT: the FeS2 and Fe2+ outputs are a SPECULATIVE formal redox closure corresponding to sulfide oxidation during conversion of FeS to disulfide; the supplied research does not identify these as the measured final mineral products. The organic conversion is supported, but this solid-phase mass balance requires validation. Keefe et al. (1995) caution against extending such a result into an established CO2/FeS/H2S autotrophic network."}, {"id": "rxn_007", "name": "Ferrous-hydroxide-promoted pyruvate reductive amination", "inputs": ["mol_012", "mol_004", "mol_022"], "outputs": ["mol_013", "mol_023", "mol_001"], "environment": "Surface", "agents": ["Freshly precipitated iron(II) hydroxide; sacrificial reducing phase"], "conditions": {"temperature": "323-348 K; range represented in the reported reaction series", "pressure": "Approximately 1 atm in a sealed anoxic vessel", "catalyst": null, "aqueous": true, "other": "Alkaline ammonia-containing solution, approximately pH 9; long mineral contact and excess freshly prepared ferrous material. This range is not asserted to be a separately measured alanine optimum for Fe(OH)2."}, "mechanism": "Ammonia-derived imine formation is followed by reduction coupled to oxidation of ferrous mineral equivalents.", "reasoning": "Huber and Wachtershauser (2003) demonstrated alpha-keto-acid reductive amination with freshly precipitated Fe(OH)2 as well as FeS. The approximately 52% alanine value quoted for the FeS experiment is not transferred to this variant. FeOOH is a formal ferric solid equivalent that closes electron and atom bookkeeping, not an experimentally established assignment of the final crystal phase. No oxygen is required: the organic imine is the electron acceptor."}, {"id": "rxn_008", "name": "Mixed-valence iron-precipitate reductive amination", "inputs": ["mol_012", "mol_004", "mol_022", "mol_023"], "outputs": ["mol_013", "mol_023", "mol_001"], "environment": "Surface", "agents": ["Fresh mixed Fe(II)/Fe(III) hydroxide-oxyhydroxide precipitate; redox-active surface"], "conditions": {"temperature": "343 K", "pressure": "Approximately 1 atm in a closed anoxic batch", "catalyst": null, "aqueous": true, "other": "Approximately pH 10, initial Fe(II):Fe(III) ratio 1:1, excess ammonia, and 48-72 hours residence. Initial ferric material must already be available without introducing molecular oxygen into the reaction."}, "mechanism": "Mixed-valence surface chemistry favors reduction of the pyruvate/ammonia condensation product over direct carbonyl reduction; ferrous equivalents supply reducing power.", "reasoning": "Barge et al. (2019) observed liquid products approaching approximately 70% alanine and 30% lactate under favorable batch conditions. These are product-distribution figures, not an isolated L-alanine yield. Fe(OH)2 and FeOOH represent formal Fe(II) and Fe(III) components, not a claim that the precipitate consists of two pure crystalline phases. FeOOH occurs on both sides because an initial ferric surface component is present while additional ferric equivalents can form. No alanine was detected in the study's flowing chimney experiments, making long residence and excess ammonia critical limitations."}, {"id": "rxn_009", "name": "Hydrogen-driven reductive amination on metallic nickel", "inputs": ["mol_012", "mol_004", "mol_003"], "outputs": ["mol_013", "mol_001"], "environment": "Biochemical", "agents": ["Metallic nickel; heterogeneous H2-activation catalyst"], "conditions": {"temperature": "295 K", "pressure": "5 bar H2", "catalyst": "Nickel", "aqueous": true, "other": "Approximately pH 7-8, 24 hours, 30 mM pyruvate; ammonium concentrations of 6-150 mM were investigated. Cool pressurized mineral-interface chemistry rather than hot-zone vent chemistry."}, "mechanism": "Nickel activates molecular hydrogen and hydrogenates the imine/iminium formed from pyruvate and ammonia.", "reasoning": "Kaur et al. (2024) demonstrated H2-dependent alanine formation, including up to approximately 17% yield relative to ammonia with Ni in the low-ammonia assay. Hydrogen removal abolished product formation, supporting genuine catalysis rather than consumption of the metal as the principal electron donor. Ni and serpentinization-derived H2 are geochemically plausible, but metallic-surface accessibility, poisoning, ammonia supply, and the upstream pyruvate concentration gap remain unresolved. No L-selective catalyst is present."}, {"id": "rxn_010", "name": "Hydrogen-driven reductive amination on meteoritic Fe-Ni alloy", "inputs": ["mol_012", "mol_004", "mol_003"], "outputs": ["mol_013", "mol_001"], "environment": "Biochemical", "agents": ["Exposed Fe-Ni meteoritic alloy; Aletai meteorite powder was the experimental analogue"], "conditions": {"temperature": "295 K", "pressure": "5 bar H2", "catalyst": "Fe-Ni meteoritic alloy", "aqueous": true, "other": "Approximately pH 7-8 and 24 hours; pyruvate and ammonium supplied. Laboratory powdered meteorite provides substantially more accessible surface than intact meteoritic metal."}, "mechanism": "Ni-containing alloy sites activate H2 and reduce ammonia-derived pyruvate imines, while competing sites also hydrogenate pyruvate to lactate.", "reasoning": "Kaur et al. (2024) reported approximately 24% alanine and 43% lactate with powdered Aletai meteorite containing about 18 mol% Ni. These values are not asserted to apply to every ammonia loading or natural alloy surface. This is a distinct catalyst-access pathway within the same H2-driven reaction family, not a separate fundamental amination mechanism. Episodic delivery, weathering, surface area, and competition from lactate constrain its environmental importance."}, {"id": "rxn_011", "name": "ZnS-photocatalytic reductive amination with sulfite oxidation", "inputs": ["mol_012", "mol_004", "mol_024"], "outputs": ["mol_013", "mol_025"], "environment": "Surface", "agents": ["Sphalerite ZnS; semiconductor photocatalyst"], "conditions": {"temperature": "303 K", "pressure": "Approximately 1 atm under anoxic conditions", "catalyst": "Zinc sulfide", "aqueous": true, "other": "Approximately pH 9; several hours of suitable UV illumination; sulfite acts as a sacrificial hole scavenger. Requires an illuminated shallow pool or exposed mineral interface."}, "mechanism": "Photoexcited ZnS supplies conduction-band electrons for reduction of the pyruvate/ammonia condensation product. Sulfite consumes oxidative holes; sulfate is the formal fully oxidized sulfur endpoint.", "reasoning": "Wang et al. (2012) demonstrated light- and ZnS-dependent keto-acid amination, including pyruvate to alanine, with sulfite available as a hole scavenger. Explicit sulfite oxidation prevents treating light as an electron source without an accompanying donor. Sulfate is used for net redox bookkeeping rather than as a claimed exclusive measured sulfur product. As emphasized by Novikov and Copley (2013), this mechanism cannot operate in a dark deep-ocean vent. No L preference was established."}, {"id": "rxn_012", "name": "Hydroxylamine and metallic-iron reductive nitrogen incorporation", "inputs": ["mol_012", "mol_016", "mol_017", "mol_019"], "outputs": ["mol_013", "mol_018", "mol_001"], "environment": "Surface", "agents": ["Metallic iron powder; consumed electron donor rather than a recyclable catalyst"], "conditions": {"temperature": "300-343 K proposed integration window; the supplied summary does not specify the exact amination-stage temperature", "pressure": "Approximately 1 atm in an anoxic closed vessel", "catalyst": null, "aqueous": true, "other": "Hydroxylamine hydrochloride at approximately six equivalents and Fe0 at approximately ten equivalents in the reported network. Proton availability and iron dissolution must be maintained; exact natural pH and residence time remain unvalidated."}, "mechanism": "Hydroxylamine forms an N-O-containing carbonyl adduct, plausibly an oxime, followed by reduction and N-O bond cleavage driven by Fe0 oxidation.", "reasoning": "Muchowska, Varma and Moran (2019) obtained alanine after adding hydroxylamine and Fe0 to keto-acid-containing mixtures, and related substrate tests supported reductive nitrogen incorporation. The net Fe0-to-Fe2+ balance supplies the electrons needed for reduction of an N-O precursor. This does not establish a freely accumulated oxime intermediate or the proposed environmental temperature window. Hydroxylamine production and persistence, unusually reducing metal sources, competing hydrogen evolution, and large reagent excesses are major unresolved requirements."}, {"id": "rxn_013", "name": "Formaldehyde Strecker synthesis of aminoacetonitrile", "inputs": ["mol_006", "mol_004", "mol_008"], "outputs": ["mol_026", "mol_001"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-330 K proposed receiving-pool window", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Concentrated aldehyde, ammonia, and cyanide inventory; approximately pH 8-10. Competing formaldehyde condensations and HCN loss can reduce glycine-precursor accumulation."}, "mechanism": "Formaldehyde and ammonia form an imine-equivalent that is trapped by cyanide, giving aminoacetonitrile.", "reasoning": "Miller (1957) supports aldehyde/HCN Strecker chemistry as a source of glycine and related amino acids; Patel et al. (2015) also demonstrated access to glycine aminonitrile within a broader precursor network. This edge supplies the otherwise pre-existing organic nitrogen donor required by the transamination pathway. It does not import the complete cyanosulfidic network or claim that all its upstream chemistry is represented here."}, {"id": "rxn_014", "name": "Aminoacetonitrile hydrolysis supplying glycine", "inputs": ["mol_026", "mol_001"], "outputs": ["mol_027", "mol_004"], "environment": "Surface", "agents": ["Aqueous acidity supplied by an acidic geothermal pool"], "conditions": {"temperature": "350-370 K proposed hydrolysis window", "pressure": "Approximately 1 atm", "catalyst": "Hydronium ions", "aqueous": true, "other": "Separate acidic stage at approximately pH 1-3; prolonged residence. Subsequent accumulation or evaporation is needed before high-concentration transamination."}, "mechanism": "Nitrile hydration followed by amide hydrolysis produces glycine and releases ammonia/ammonium.", "reasoning": "Miller (1957) established the relevance of aminonitrile hydrolysis to amino-acid accumulation. The proposed mild geothermal implementation and its rate are not separately demonstrated by the supplied research. Generating some glycine is substantially less demanding than accumulating the approximately 350 mM glycine used in Stubbs et al. (2020), so this network does not assume that hydrolysis automatically supplies the downstream experimental concentration."}, {"id": "rxn_015", "name": "Alum-promoted transamination from glycine to pyruvate", "inputs": ["mol_012", "mol_027"], "outputs": ["mol_013", "mol_028"], "environment": "Surface", "agents": ["Potassium alum; source of catalytically active aqueous aluminium species"], "conditions": {"temperature": "353 K", "pressure": "Approximately 1 atm", "catalyst": "Potassium alum-derived aluminium species", "aqueous": true, "other": "pH 5, approximately 350 mM glycine, 1.2 equivalents pyruvate, 0.1 equivalent potassium alum, 24 hours. Requires a concentrated, mildly acidic setting distinct from alkaline amination pools."}, "mechanism": "Schiff-base formation, proton transfers, and hydrolysis transfer the glycine amino group to pyruvate, producing alanine and glyoxylate without fixing additional nitrogen.", "reasoning": "Stubbs et al. (2020) reported approximately 19% alanine under these conditions. The alanine-forming experiment used alum and therefore should not be called metal-free. Upstream glycine synthesis is explicitly included, but its concentration and delivery remain bottlenecks. Similarity to biological transamination does not establish historical ancestry or L stereoselectivity; the achiral reaction is represented as producing a racemic alanine pool."}, {"id": "rxn_016", "name": "Competing acetaldehyde cyanohydrin formation", "inputs": ["mol_007", "mol_008"], "outputs": ["mol_029"], "environment": "Hydrothermal", "agents": null, "conditions": {"temperature": "378 K experimental acetylene-NiS system", "pressure": "Sealed aqueous vessel", "catalyst": null, "aqueous": true, "other": "Acidic stage near pH 3, with little available free ammonia. NiS is not assigned an independent catalytic role in this carbonyl-addition step."}, "mechanism": "Cyanide addition to acetaldehyde and proton transfer form lactonitrile rather than the nitrogen-substituted alanine precursor.", "reasoning": "Miller (1957) identified competing amino- and hydroxynitrile chemistry. The Communications Chemistry acetylene-NiS study (2023; authors not supplied) reported approximately 10.2 mM lactonitrile at pH 3 with no alanine. This sink is included because acetaldehyde production alone does not determine alanine yield; ammonia speciation and pH control carbon partitioning."}, {"id": "rxn_017", "name": "Lactonitrile hydrolysis to lactic acid", "inputs": ["mol_029", "mol_001"], "outputs": ["mol_030", "mol_004"], "environment": "Surface", "agents": ["Aqueous acidity"], "conditions": {"temperature": "350-370 K proposed downstream hydrolysis window", "pressure": "Approximately 1 atm", "catalyst": "Hydronium ions", "aqueous": true, "other": "Acidic geothermal receiving pool with prolonged residence; actual environmental conversion rate requires measurement."}, "mechanism": "Hydrolysis converts the nitrile group to a carboxyl group while retaining the alpha-hydroxyl substituent.", "reasoning": "Miller (1957) supports the hydroxynitrile-to-hydroxy-acid branch competing with amino-acid formation. The specific natural hydrolysis conditions are an integration proposal, not a quoted rate measurement. This edge records irreversible loss of useful precursor carbon into lactate on the timescale of the modeled alanine pathways."}, {"id": "rxn_018", "name": "Competing hydrogenation of pyruvate to lactate", "inputs": ["mol_012", "mol_003"], "outputs": ["mol_030"], "environment": "Biochemical", "agents": ["Ni-containing Fe-Ni alloy surface"], "conditions": {"temperature": "295 K", "pressure": "5 bar H2", "catalyst": "Fe-Ni alloy", "aqueous": true, "other": "Approximately pH 7-8 and 24 hours; competes in the same ammonia-containing mineral-contact system used for reductive amination."}, "mechanism": "Surface-activated hydrogen reduces the pyruvate carbonyl directly, bypassing nitrogen incorporation.", "reasoning": "Kaur et al. (2024) reported substantial lactate alongside alanine, including approximately 43% lactate with the Aletai meteorite preparation. Novikov and Copley (2013) likewise showed that mineral identity changes the entire pyruvate reaction landscape. This sink prevents interpreting pyruvate consumption as equivalent to alanine production."}, {"id": "rxn_019", "name": "SPECULATIVE physical resolution of racemic alanine", "inputs": ["mol_013"], "outputs": ["mol_014", "mol_015"], "environment": "Surface", "agents": ["Single-handed alpha-quartz faces as a hypothetical resolving adsorbent; alanine discrimination and its sign are unvalidated"], "conditions": {"temperature": "300-320 K proposed separation window", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Hypothetical repeated adsorption, washing, and fractional desorption at approximately pH 5-7 on an exposed handed surface. Requires experimentally verified differential adsorption and natural spatial separation. UV shielding may be needed for product survival. No L-alanine seed is assumed."}, "mechanism": "A genuinely enantiodiscriminating surface could partition L- and D-alanine into different fractions. The outputs represent ideal separated enantiomer inventories; achievable enrichment, purity, recovery, and number of cycles are unknown. This is physical separation, not D-to-L conversion.", "reasoning": "SPECULATIVE and not established by any supplied study. Intrinsically chiral quartz motivates testing unequal adsorption free energies, but the supplied evidence does not demonstrate alanine resolution on quartz or identify an L-preferring face. Miller (1955) and Parker et al. (2011) support racemic synthesis, while Li et al. (2024) found a D-alanine excess on natural pyrite, not an explanation for L selection. That result motivates investigating surface discrimination but cannot validate this separator. Without racemization or asymmetric synthesis, separation cannot recover more L-alanine than the initial L fraction, approximately half of a racemate before losses. All ten isolated-L pathways remain conditional on this unresolved node."}], "pathways": [{"pathway_id": "P1", "name": "Atmospheric-discharge Strecker pathway", "description": "Discharge produces both acetaldehyde and HCN. Aqueous Strecker chemistry and nitrile hydrolysis generate DL-alanine. Reaching separated L-alanine additionally requires the speculative resolution node.", "reaction_sequence": ["rxn_001", "rxn_003", "rxn_004", "rxn_019"], "key_intermediates": ["mol_007", "mol_008", "mol_011", "mol_013"]}, {"pathway_id": "P2", "name": "Acetylene-NiS carbonyl supply followed by Strecker chemistry", "description": "NiS hydration supplies the acetaldehyde used in this pathway; discharge supplies the required HCN. The acetaldehyde coproduct of the discharge is not the selected carbonyl source here. Cooling and pH evolution connect the demonstrated but low-yield chemistry to nitrile hydrolysis and conditional L resolution.", "reaction_sequence": ["rxn_001", "rxn_002", "rxn_003", "rxn_004", "rxn_019"], "key_intermediates": ["mol_007", "mol_008", "mol_011", "mol_013"]}, {"pathway_id": "P3", "name": "CO2 fixation followed by sacrificial FeS reductive amination", "description": "Ni3Fe supplies a dilute pyruvate inventory that must accumulate before FeS-promoted amination. Organic alanine formation is supported, but the encoded mineral oxidation endpoint and subsequent L resolution are explicitly unresolved.", "reaction_sequence": ["rxn_005", "rxn_006", "rxn_019"], "key_intermediates": ["mol_012", "mol_013"]}, {"pathway_id": "P4", "name": "CO2 fixation followed by ferrous-hydroxide amination", "description": "Pyruvate from Ni3Fe carbon fixation undergoes ammonia incorporation driven by fresh Fe(OH)2. This is a distinct sacrificial mineral variant, not an independently demonstrated L-selective reaction.", "reaction_sequence": ["rxn_005", "rxn_007", "rxn_019"], "key_intermediates": ["mol_012", "mol_013"]}, {"pathway_id": "P5", "name": "CO2 fixation followed by mixed-valence iron batch chemistry", "description": "Pyruvate is delivered to a long-residence alkaline mixed-iron precipitate system. Batch alanine formation is supported, but natural concentration, ferric-phase availability, and transfer performance are unresolved. L isolation remains conditional.", "reaction_sequence": ["rxn_005", "rxn_008", "rxn_019"], "key_intermediates": ["mol_012", "mol_023", "mol_013"]}, {"pathway_id": "P6", "name": "CO2 fixation followed by H2-nickel reductive amination", "description": "Ni3Fe carbon fixation supplies pyruvate, followed by H2-driven amination on metallic Ni. Both transformations are demonstrated separately, but the roughly three-order-of-magnitude precursor concentration mismatch is not solved by this graph.", "reaction_sequence": ["rxn_005", "rxn_009", "rxn_019"], "key_intermediates": ["mol_012", "mol_013"]}, {"pathway_id": "P7", "name": "CO2 fixation followed by H2-meteoritic-alloy amination", "description": "An exposed Fe-Ni meteoritic catalyst replaces pure nickel in the H2-driven terminal conversion. This is a distinct catalyst-supply pathway within the same reductive-amination family; lactate competes strongly and L resolution is unvalidated.", "reaction_sequence": ["rxn_005", "rxn_010", "rxn_019"], "key_intermediates": ["mol_012", "mol_013"]}, {"pathway_id": "P8", "name": "CO2 fixation followed by illuminated ZnS amination", "description": "Pyruvate reaches a UV-exposed ZnS-bearing pool where sulfite supplies sacrificial reducing equivalents through the photocatalytic cycle. This requires an illuminated surface setting rather than a dark vent, followed by hypothetical L resolution.", "reaction_sequence": ["rxn_005", "rxn_011", "rxn_019"], "key_intermediates": ["mol_012", "mol_013"]}, {"pathway_id": "P9", "name": "CO2 fixation followed by hydroxylamine-iron nitrogen incorporation", "description": "Pyruvate reacts with hydroxylamine using metallic iron as the consumed reductant. This nitrogen-entry route avoids requiring ammonia for the alanine-forming step but requires independently available hydroxylamine and native metal. Its L endpoint remains conditional.", "reaction_sequence": ["rxn_005", "rxn_012", "rxn_019"], "key_intermediates": ["mol_012", "mol_013"]}, {"pathway_id": "P10", "name": "Strecker-derived glycine coupled to pyruvate transamination", "description": "Discharge-derived formaldehyde and HCN supply glycine through aminoacetonitrile. Independently formed pyruvate receives glycine's amino group in the alum-promoted reaction. This transfers existing organic nitrogen rather than fixing new nitrogen; high reactant concentrations and final L resolution remain unresolved.", "reaction_sequence": ["rxn_001", "rxn_013", "rxn_014", "rxn_005", "rxn_015", "rxn_019"], "key_intermediates": ["mol_006", "mol_008", "mol_026", "mol_027", "mol_012", "mol_013"]}], "hub_molecules": ["mol_001", "mol_003", "mol_004", "mol_007", "mol_008", "mol_012", "mol_013", "mol_018", "mol_019", "mol_022", "mol_023", "mol_030"], "convergence_points": [{"molecule_id": "mol_007", "incoming_reactions": ["rxn_001", "rxn_002"], "outgoing_reactions": ["rxn_003", "rxn_016"]}, {"molecule_id": "mol_013", "incoming_reactions": ["rxn_004", "rxn_006", "rxn_007", "rxn_008", "rxn_009", "rxn_010", "rxn_011", "rxn_012", "rxn_015"], "outgoing_reactions": ["rxn_019"]}, {"molecule_id": "mol_030", "incoming_reactions": ["rxn_017", "rxn_018"], "outgoing_reactions": []}]}, "reasoning": "", "duration_ms": 468494.6093559265, "success": true, "error_message": null