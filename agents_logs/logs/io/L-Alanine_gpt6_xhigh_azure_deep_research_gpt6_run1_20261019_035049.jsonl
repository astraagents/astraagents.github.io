a\": \"CO2\",\n      \"iupac_name\": \"carbon dioxide\",\n      \"common_name\": \"carbon dioxide\",\n      \"inchi\": \"InChI=1S/CO2/c2-1-3\",\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_016\",\n      \"formula\": \"C3H4O3\",\n      \"iupac_name\": \"2-oxopropanoic acid\",\n      \"common_name\": \"pyruvic acid\",\n      \"inchi\": \"InChI=1S/C3H4O3/c1-2(4)3(5)6/h1H3,(H,5,6)\",\n      \"role\": \"hub_intermediate\",\n      \"environment_formed\": \"Biochemical\"\n    },\n    {\n      \"id\": \"mol_017\",\n      \"formula\": \"SO3^2-\",\n      \"iupac_name\": \"sulfite\",\n      \"common_name\": \"sulfite ion\",\n      \"inchi\": null,\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_018\",\n      \"formula\": \"SO4^2-\",\n      \"iupac_name\": \"sulfate\",\n      \"common_name\": \"sulfate ion\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_019\",\n      \"formula\": \"H3NO\",\n      \"iupac_name\": \"hydroxylamine\",\n      \"common_name\": \"hydroxylamine\",\n      \"inchi\": \"InChI=1S/H3NO/c1-2/h2H,1H2\",\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_020\",\n      \"formula\": \"Fe\",\n      \"iupac_name\": \"iron\",\n      \"common_name\": \"metallic iron\",\n      \"inchi\": \"InChI=1S/Fe\",\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_021\",\n      \"formula\": \"H+\",\n      \"iupac_name\": \"hydron\",\n      \"common_name\": \"aqueous proton\",\n      \"inchi\": null,\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_022\",\n      \"formula\": \"Fe^2+\",\n      \"iupac_name\": \"iron(2+)\",\n      \"common_name\": \"ferrous ion\",\n      \"inchi\": \"InChI=1S/Fe/q+2\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_023\",\n      \"formula\": \"C2H4N2\",\n      \"iupac_name\": \"2-aminoacetonitrile\",\n      \"common_name\": \"glycinonitrile\",\n      \"inchi\": \"InChI=1S/C2H4N2/c3-1-2-4/h1,3H2\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_024\",\n      \"formula\": \"C2H5NO2\",\n      \"iupac_name\": \"2-aminoacetic acid\",\n      \"common_name\": \"glycine\",\n      \"inchi\": \"InChI=1S/C2H5NO2/c3-1-2(4)5/h1,3H2,(H,4,5)\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_025\",\n      \"formula\": \"C2H2O3\",\n      \"iupac_name\": \"2-oxoacetic acid\",\n      \"common_name\": \"glyoxylic acid\",\n      \"inchi\": \"InChI=1S/C2H2O3/c3-1-2(4)5/h1H,(H,4,5)\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_026\",\n      \"formula\": \"C3H5NO\",\n      \"iupac_name\": \"2-hydroxypropanenitrile\",\n      \"common_name\": \"lactonitrile, stereochemistry unspecified\",\n      \"inchi\": \"InChI=1S/C3H5NO/c1-3(5)2-4/h3,5H,1H3\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_027\",\n      \"formula\": \"C3H6O3\",\n      \"iupac_name\": \"2-hydroxypropanoic acid\",\n      \"common_name\": \"lactic acid, stereochemistry unspecified\",\n      \"inchi\": \"InChI=1S/C3H6O3/c1-2(4)3(5)6/h2,4H,1H3,(H,5,6)\",\n      \"role\": \"hub_intermediate\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_028\",\n      \"formula\": \"CH2O2\",\n      \"iupac_name\": \"formic acid\",\n      \"common_name\": \"formic acid\",\n      \"inchi\": \"InChI=1S/CH2O2/c2-1-3/h1H,(H,2,3)\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Biochemical\"\n    },\n    {\n      \"id\": \"mol_029\",\n      \"formula\": \"C2H4O2\",\n      \"iupac_name\": \"acetic acid\",\n      \"common_name\": \"acetic acid\",\n      \"inchi\": \"InChI=1S/C2H4O2/c1-2(3)4/h1H3,(H,3,4)\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Biochemical\"\n    }\n  ],\n  \"reactions\": [\n    {\n      \"id\": \"rxn_001\",\n      \"name\": \"Ammonia-containing atmospheric discharge supplies cyanide and carbonyl compounds\",\n      \"inputs\": [\"mol_001\", \"mol_002\", \"mol_003\", \"mol_004\"],\n      \"outputs\": [\"mol_006\", \"mol_007\", \"mol_008\", \"mol_004\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-340 K bulk gas and receiving water; transient discharge channels are much hotter\",\n        \"pressure\": \"Approximately 1 atm in the modeled local plume\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Anoxic CH4/NH3/H2/water-vapor mixture with repeated electrical discharge and gas-liquid circulation over days. Condensation and rainout deliver products to water. Alkaline receiving pools can retain HCN as cyanide; aldehyde volatilization, dilution and UV destruction remain competing losses. This is a gas-phase production plus aqueous-capture module, not a single elementary aqueous reaction.\"\n      },\n      \"mechanism\": \"Discharge-generated radicals form reduced C-N compounds and oxygenated carbon compounds. Independent formal net channels include CH4 + NH3 -> HCN + 3 H2; 2 CH4 + H2O -> CH3CHO + 4 H2; and CH4 + H2O -> HCHO + 2 H2. Their relative fluxes are unspecified. H2 is both a supplied gas and a possible net product, explaining its appearance on both sides without repeated IDs within either array.\",\n      \"reasoning\": \"Miller (1955, 1957) supports discharge production of HCN and aldehydes followed by Strecker chemistry, with DL-alanine rather than isolated L-alanine. Johnson et al. (2008) supports a volcanic-discharge context. Trail et al. (2011) argues against assuming a globally persistent methane/ammonia atmosphere, so this node is restricted to local or episodic reduced gas mixtures. The formal equations establish atom accounting, not measured coproduct ratios or quantitative condensate capture.\"\n    },\n    {\n      \"id\": \"rxn_002\",\n      \"name\": \"Nitrogen-containing atmospheric discharge supplies reduced nitrogen, cyanide and carbonyl compounds\",\n      \"inputs\": [\"mol_001\", \"mol_002\", \"mol_005\", \"mol_004\"],\n      \"outputs\": [\"mol_006\", \"mol_007\", \"mol_008\", \"mol_003\", \"mol_004\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-340 K bulk gas and receiving water; impulsive plasma temperatures are much higher\",\n        \"pressure\": \"Approximately 1 atm in the modeled local plume\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Anoxic CH4/N2/H2/water-vapor discharge followed by condensation into receiving pools. Nitrogen fixation requires the discharge, not ordinary UV illumination alone. Reduced nitrogen concentrations and capture efficiencies are not supplied by the research summary and are not assumed equal to the ammonia-fed experiment.\"\n      },\n      \"mechanism\": \"Energetic N2 activation feeds HCN and reduced-nitrogen chemistry while methane/water radical chemistry supplies aldehydes. One formal aggregate balance is 4 CH4 + N2 + 2 H2O + H2 -> HCN + NH3 + CH3CHO + HCHO + 6 H2. This is multichannel bookkeeping, not an elementary mechanism or a predicted product distribution; the ammonia node represents the reduced-nitrogen resource available for subsequent imine formation.\",\n      \"reasoning\": \"Miller (1957) obtained the same general amino-acid products at lower yield when N2 replaced supplied NH3. This is chemically distinct from rxn_001 because nitrogen activation must occur within the discharge. The supplied report does not quantify the free-ammonia inventory for this variant, so downstream Strecker performance cannot be assigned the ammonia-fed yields. Local reducing carbon supply remains environmentally conditional, as emphasized by Trail et al. (2011).\"\n    },\n    {\n      \"id\": \"rxn_003\",\n      \"name\": \"Nickel-sulfide-mediated acetylene hydration supplies acetaldehyde\",\n      \"inputs\": [\"mol_013\", \"mol_001\", \"mol_014\"],\n      \"outputs\": [\"mol_007\", \"mol_014\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"Freshly precipitated nickel sulfide, NiS\"],\n      \"conditions\": {\n        \"temperature\": \"378 K\",\n        \"pressure\": \"Closed gas-bearing aqueous system, above approximately 1.2 bar to retain liquid water; exact experimental gas pressure is not given in the supplied report\",\n        \"catalyst\": \"NiS\",\n        \"aqueous\": true,\n        \"other\": \"Acetylene and CO contact NiS-bearing water. CO is retained as an experimentally present gas, not consumed by the represented hydration channel. Proposed transfer is cooling and advective transport through liquid-filled fractures into a cyanide/ammonia-bearing receiving pool; acetaldehyde retention during that transfer is unquantified. The hydrothermal and Strecker stages need not occur at the same pH.\"\n      },\n      \"mechanism\": \"NiS-mediated hydration produces an enol that tautomerizes to acetaldehyde. Net: C2H2 + H2O -> CH3CHO. CO is an unchanged participant in this target-focused net channel; other CO-consuming chemistry is not inferred.\",\n      \"reasoning\": \"The 2023 Communications Chemistry acetylene/NiS study, whose authors are not identified in the supplied report, demonstrated acetaldehyde formation at 105 degrees C and identified the subsequent alanine Strecker intermediates after cyanide/ammonium addition. FeS alone did not reproduce free-acetaldehyde formation. The combined experiment gave only approximately 180 micromolar alanine after seven days, approximately 0.02% relative to ammonium chloride. The evidence therefore supports this carbonyl-supply alternative but not efficient cross-environment coupling or an L-selective product.\"\n    },\n    {\n      \"id\": \"rxn_004\",\n      \"name\": \"Acetaldehyde Strecker reaction forms both alaninonitrile enantiomers\",\n      \"inputs\": [\"mol_007\", \"mol_003\", \"mol_006\"],\n      \"outputs\": [\"mol_009\", \"mol_010\", \"mol_001\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-330 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Proposed receiving pool at approximately pH 8.5-10, with sufficient free NH3 and cyanide. Ammonia availability must compete successfully with cyanohydrin formation. Shallow subsurface water or mineral-covered pool margins reduce photodestruction without assuming absence of surface UV. No chiral catalyst or enantiomer separation is present.\"\n      },\n      \"mechanism\": \"Acetaldehyde and ammonia reversibly form a carbinolamine and imine/iminium intermediate; cyanide attacks the planar C=N center from either face. Achiral-pool balance: 2 CH3CHO + 2 NH3 + 2 HCN -> S-alaninonitrile + R-alaninonitrile + 2 H2O. The intermediates are described mechanistically rather than added as unnecessary persistent nodes.\",\n      \"reasoning\": \"Miller (1957) supports aldehyde/HCN/ammonia Strecker chemistry. The 2023 Communications Chemistry acetylene/NiS study identified aminoethanol and 2-aminopropanenitrile and showed strong pH dependence. The chosen surface temperature/pH window is a plausible integration scenario, not a reported optimum for the complete transported network. Achiral reactants provide no intrinsic L preference; separate nitrile nodes are stereochemical bookkeeping, not physically resolved fractions.\"\n    },\n    {\n      \"id\": \"rxn_005\",\n      \"name\": \"Hydrolysis of S-alaninonitrile produces the L-alanine component\",\n      \"inputs\": [\"mol_009\", \"mol_001\"],\n      \"outputs\": [\"mol_011\", \"mol_003\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Aqueous acid supplied by acidic geological fluids\"],\n      \"conditions\": {\n        \"temperature\": \"350-370 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": \"H+\",\n        \"aqueous\": true,\n        \"other\": \"Proposed warm, acidic receiving compartment, approximately pH 1-2, with sustained liquid water. Acidification follows rather than accompanies the alkaline capture stage. Residence times may extend over days or longer; conversion and racemization must be measured for the actual mixture. The R-enantiomer remains present and undergoes rxn_006 under the same conditions.\"\n      },\n      \"mechanism\": \"Nitrile hydration through an amide gives the carboxylic acid without requiring cleavage of a bond at the stereogenic carbon. Net reference-state equation: S-C3H6N2 + 2 H2O -> L-C3H7NO2 + NH3. Ammonia is predominantly ammonium under the stated acidic conditions. This is synthesis from one component of an unresolved nitrile pool, not enantioseparation.\",\n      \"reasoning\": \"Miller (1957) supports aminonitrile hydrolysis as a source of accumulated amino acids. The specific acidic surface compartment is an explicitly proposed integration condition, not a demonstrated natural reactor. Stereoretentive hydrolysis accounts for L molecules already encoded in the S-nitrile fraction; it neither enriches that fraction nor establishes isolated L-alanine. The equivalent R branch prevents a false homochiral endpoint.\"\n    },\n    {\n      \"id\": \"rxn_006\",\n      \"name\": \"Parallel hydrolysis of R-alaninonitrile produces D-alanine\",\n      \"inputs\": [\"mol_010\", \"mol_001\"],\n      \"outputs\": [\"mol_012\", \"mol_003\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Aqueous acid supplied by acidic geological fluids\"],\n      \"conditions\": {\n        \"temperature\": \"350-370 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": \"H+\",\n        \"aqueous\": true,\n        \"other\": \"Same unresolved aqueous mixture and acidification history as rxn_005. No kinetic resolution, selective adsorption or preferential crystallization is assumed.\"\n      },\n      \"mechanism\": \"R-C3H6N2 + 2 H2O -> D-C3H7NO2 + NH3 through nitrile hydration and amide hydrolysis. In an achiral environment this branch has the same intrinsic kinetics as the corresponding S branch, apart from any unmodeled environmental asymmetry.\",\n      \"reasoning\": \"Miller (1955, 1957) established DL-alanine and the aminonitrile-hydrolysis interpretation. This coproduct branch is chemically necessary to avoid representing an achiral Strecker reaction as selective L synthesis. It is not an additional pathway claimed toward the L target.\"\n    },\n    {\n      \"id\": \"rxn_007\",\n      \"name\": \"Ni3Fe-catalyzed CO2 hydrogenation supplies pyruvate\",\n      \"inputs\": [\"mol_015\", \"mol_004\"],\n      \"outputs\": [\"mol_016\", \"mol_001\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\"Ni3Fe alloy nanoparticles, an awaruite-like catalytic material\"],\n      \"conditions\": {\n        \"temperature\": \"298 K\",\n        \"pressure\": \"25 bar CO2/H2 gas mixture\",\n        \"catalyst\": \"Ni3Fe\",\n        \"aqueous\": true,\n        \"other\": \"Reported condition: initial pH approximately 6, CO2:H2 approximately 3:2, 24 hours. Physical analog: cool, pressurized, anoxic rock-water pores adjoining serpentinizing and CO2-bearing fluid sources, not a 350-600 K hot vent interior. Subsequent groundwater advection or porewater exchange is proposed; neither concentration nor downstream yield is established by this node.\"\n      },\n      \"mechanism\": \"Metal-catalyzed H2 activation, CO2 reduction and C-C coupling generate a minor C3 alpha-keto-acid branch. Net: 3 CO2 + 5 H2 -> C3H4O3 + 3 H2O. This is the balanced pyruvate channel, not the overall product distribution; competing formate and acetate channels are rxn_018 and rxn_019.\",\n      \"reasoning\": \"Beyazay et al. (2023) measured approximately 0.02 mM pyruvate, 26.72 mM formate and 0.04 mM acetate under these conditions. Pyruvate supply is therefore experimentally supported but minor. Kaur et al. (2024) used 30 mM pyruvate downstream, a nominal approximately 1500-fold concentration difference. That difference is an unresolved integration and flux problem, not proof that dilute alanine formation is impossible. No concentration mechanism in this network is asserted to bridge it quantitatively.\"\n    },\n    {\n      \"id\": \"rxn_008\",\n      \"name\": \"H2-driven reductive amination of pyruvate on nickel\",\n      \"inputs\": [\"mol_016\", \"mol_003\", \"mol_004\"],\n      \"outputs\": [\"mol_011\", \"mol_012\", \"mol_001\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\"Metallic nickel\"],\n      \"conditions\": {\n        \"temperature\": \"295 K\",\n        \"pressure\": \"5 bar H2\",\n        \"catalyst\": \"Ni\",\n        \"aqueous\": true,\n        \"other\": \"Reported benchmark: pH 7-8, 30 mM pyruvate, total ammonia/ammonium 6-150 mM, 24 hours. Physical setting: anoxic, H2-bearing aqueous mineral pores. Proposed coupling from rxn_007 requires fluid exchange, altered gas composition and buffering; it does not imply that 30 mM pyruvate arises automatically. No enzyme, cofactor or chiral auxiliary is used.\"\n      },\n      \"mechanism\": \"Pyruvate condenses with free NH3; Ni activates H2 and hydrogenates the resulting imine/iminium. Achiral reference balance: 2 C3H4O3 + 2 NH3 + 2 H2 -> L-alanine + D-alanine + 2 H2O.\",\n      \"reasoning\": \"Kaur et al. (2024) demonstrated H2-dependent alanine production with Ni, including up to approximately 17% yield relative to ammonia at 6 mM ammonia and 30 mM pyruvate. H2 is an explicit stoichiometric reductant, while Ni is catalytic. The experiment does not establish L selectivity; equal enantiomer production here is the achiral expectation. A serpentinization-related H2 source has geological precedent in Kelley et al. (2005), but the stated upstream/downstream coupling remains untested.\"\n    },\n    {\n      \"id\": \"rxn_009\",\n      \"name\": \"H2-driven reductive amination on meteoritic Fe-Ni material\",\n      \"inputs\": [\"mol_016\", \"mol_003\", \"mol_004\"],\n      \"outputs\": [\"mol_011\", \"mol_012\", \"mol_001\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\"Accessible Ni-bearing Fe-Ni meteoritic alloy, represented by the tested Aletai material\"],\n      \"conditions\": {\n        \"temperature\": \"295 K\",\n        \"pressure\": \"5 bar H2\",\n        \"catalyst\": \"Ni-bearing meteoritic Fe-Ni surfaces\",\n        \"aqueous\": true,\n        \"other\": \"Mild anoxic aqueous mineral interface at approximately pH 7-8, with pyruvate and ammonia/ammonium. The study used powdered meteoritic material and externally supplied concentrated pyruvate. Natural application requires surviving exposed metal surfaces, sufficient H2 activity and residence time; intact meteorites cannot be assigned the surface area of laboratory powder.\"\n      },\n      \"mechanism\": \"Meteoritic metal catalyzes H2 activation and reduction of a pyruvate-derived imine. Net: 2 C3H4O3 + 2 NH3 + 2 H2 -> L-alanine + D-alanine + 2 H2O. Metallic iron is not inserted as a consumed reagent because the demonstrated reaction requires external H2.\",\n      \"reasoning\": \"Kaur et al. (2024) reported approximately 24% alanine and 43% lactate with powdered Aletai meteorite; removal of H2 abolished product formation. This supports a catalytic alloy branch rather than speculative oxidation of bulk meteoritic iron as the electron source. Competing lactate formation is represented by rxn_017. Catalyst accessibility, precursor concentration and enantiomeric composition remain separate limitations; this is not evidence of an isolated L product.\"\n    },\n    {\n      \"id\": \"rxn_010\",\n      \"name\": \"ZnS photocatalytic reductive amination with sulfite as electron donor\",\n      \"inputs\": [\"mol_016\", \"mol_003\", \"mol_017\"],\n      \"outputs\": [\"mol_011\", \"mol_012\", \"mol_018\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Illuminated sphalerite, ZnS\"],\n      \"conditions\": {\n        \"temperature\": \"303 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": \"ZnS semiconductor\",\n        \"aqueous\": true,\n        \"other\": \"Approximately pH 9, several hours of irradiation at wavelengths absorbed by ZnS, and available sulfite as a sacrificial hole scavenger. The supplied report does not specify a transferable natural photon flux. Physical setting: an illuminated shallow anoxic pool or exposed mineral-water film, not a dark deep-sea vent. Upwelling groundwater could deliver pyruvate, but survival and concentration during delivery are unquantified.\"\n      },\n      \"mechanism\": \"Photogenerated conduction-band electrons reduce the pyruvate/ammonia-derived imine while sulfite consumes photogenerated holes. For the sulfate oxidation endpoint, the balanced net channel is 2 C3H4O3 + 2 NH3 + 2 SO3^2- -> L-alanine + D-alanine + 2 SO4^2-. Oxygen atoms are supplied by the reactants and water-mediated chemistry, not molecular O2.\",\n      \"reasoning\": \"Wang et al. (2012) demonstrated ZnS/light-dependent alpha-keto-acid amination and use of sulfite as a sacrificial scavenger. Sulfate is the chemically justified two-electron oxidation endpoint used to close this particular net channel; the supplied summary does not establish quantitative sulfur-product recovery, and competing sulfur chemistry or photocorrosion must be checked. Thus the alanine-forming reaction is supported, while its full redox-product accounting and environmental coupling are conditional. No L bias is established.\"\n    },\n    {\n      \"id\": \"rxn_011\",\n      \"name\": \"Hydroxylamine-mediated nitrogen incorporation with sacrificial metallic iron\",\n      \"inputs\": [\"mol_016\", \"mol_019\", \"mol_020\", \"mol_021\"],\n      \"outputs\": [\"mol_011\", \"mol_012\", \"mol_022\", \"mol_001\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Metallic iron powder as a consumed reductant, also listed explicitly as mol_020\"],\n      \"conditions\": {\n        \"temperature\": \"343 K proposed working condition; the supplied summary does not separately specify the amination-step temperature\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Proposed acidic, anoxic geothermal pool or mineral-covered water pocket, approximately pH 3-5, maintaining soluble Fe(II). The cited experiment introduced hydroxylamine hydrochloride at six equivalents and Fe0 powder at ten equivalents. Those reagent excesses are not replaced by the smaller ideal stoichiometric coefficients. Hydroxylamine supply and persistence are independent unresolved feedstock requirements.\"\n      },\n      \"mechanism\": \"Hydroxylamine forms an oxime-like intermediate; reduction of C=N and N-O functionality gives alanine while Fe0 supplies four electrons per alanine. Acidic reference balance: 2 C3H4O3 + 2 NH2OH + 4 Fe + 8 H+ -> L-alanine + D-alanine + 4 Fe^2+ + 4 H2O. Fe^2+ represents the dissolved corrosion product, not an invented ferric mineral phase. Parasitic H2 evolution can consume additional Fe and acid.\",\n      \"reasoning\": \"Muchowska, Varma and Moran (2019) detected alanine after hydroxylamine/Fe0 treatment of the corresponding keto-acid chemistry. Metallic iron is correctly encoded as a stoichiometric donor rather than a trace catalyst, and hydroxylamine has the consistent formula H3NO. The proposed pH and temperature are integration assumptions, not quoted optimized conditions. Natural inventories of hydroxylamine and reactive Fe0, actual iron speciation, and the pyruvate concentration remain bottlenecks. The supplied evidence does not demonstrate L selectivity.\"\n    },\n    {\n      \"id\": \"rxn_012\",\n      \"name\": \"Formaldehyde Strecker reaction supplies glycinonitrile\",\n      \"inputs\": [\"mol_008\", \"mol_003\", \"mol_006\"],\n      \"outputs\": [\"mol_023\", \"mol_001\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-330 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Anoxic, mildly alkaline carbonyl/cyanide/ammonia-containing pool, approximately pH 8.5-10 as a proposed integration window. Atmospheric condensate supplies formaldehyde and HCN. Competing formaldehyde oligomerization and hydroxynitrile chemistry can lower glycinonitrile accumulation.\"\n      },\n      \"mechanism\": \"Formaldehyde/ammonia condensation produces an imine-equivalent that undergoes cyanide addition. Net: HCHO + NH3 + HCN -> NH2CH2CN + H2O. The product is achiral.\",\n      \"reasoning\": \"Miller (1957) supports the aldehyde/aminonitrile mechanism of glycine production. This reaction provides an explicit organic nitrogen donor precursor for transamination instead of treating glycine as an unexplained complex feedstock. The chosen receiving-pool conditions are a plausible scenario; neither the required glycine concentration nor a complete naturally operating reactor is demonstrated.\"\n    },\n    {\n      \"id\": \"rxn_013\",\n      \"name\": \"Glycinonitrile hydrolysis supplies glycine\",\n      \"inputs\": [\"mol_023\", \"mol_001\"],\n      \"outputs\": [\"mol_024\", \"mol_003\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Aqueous acid supplied by acidic geological fluids\"],\n      \"conditions\": {\n        \"temperature\": \"350-370 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": \"H+\",\n        \"aqueous\": true,\n        \"other\": \"Proposed warm acidic water after alkaline precursor capture, approximately pH 1-2. Subsequent buffering toward pH 5 is required before the alum-assisted transamination stage. Actual conversion, retention and concentration must be established rather than inferred from laboratory hydrolysis.\"\n      },\n      \"mechanism\": \"Nitrile hydration and amide hydrolysis give glycine. Net: NH2CH2CN + 2 H2O -> NH2CH2CO2H + NH3. Protonation equilibria convert much of the released ammonia to ammonium under these conditions.\",\n      \"reasoning\": \"Miller (1957) supports hydrolysis of atmospheric Strecker intermediates as an amino-acid source. This explicitly closes the glycine-supply branch. It does not establish accumulation to the 350 mM glycine concentration used by Stubbs et al. (2020), and no fictitious concentration reaction is inserted.\"\n    },\n    {\n      \"id\": \"rxn_014\",\n      \"name\": \"Alum-assisted nonenzymatic transamination from glycine to pyruvate\",\n      \"inputs\": [\"mol_016\", \"mol_024\"],\n      \"outputs\": [\"mol_011\", \"mol_012\", \"mol_025\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Potassium alum, KAl(SO4)2\u00b712H2O, supplying Al(III)\"],\n      \"conditions\": {\n        \"temperature\": \"353 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": \"Al(III) supplied by potassium alum\",\n        \"aqueous\": true,\n        \"other\": \"Reported benchmark: pH 5, 350 mM glycine, approximately 1.2 equivalents pyruvate, 0.1 equivalent potassium alum and 24 hours. Physical scenario: an acidic warm evaporative-pool sediment with sufficient residence time and partial mineral shielding from UV. Atmospheric glycine and groundwater pyruvate must be mixed and buffered; their accumulation to the reported concentrations is not demonstrated.\"\n      },\n      \"mechanism\": \"Carbonyl/amine condensation and proton transfers redistribute the amino group from glycine to pyruvate, yielding glyoxylate. Achiral-pool balance: 2 C3H4O3 + 2 C2H5NO2 -> L-alanine + D-alanine + 2 C2H2O3. This transfers organic nitrogen; it does not fix new nitrogen.\",\n      \"reasoning\": \"Stubbs et al. (2020) reported approximately 19% alanine under these conditions. Alum is included because the reported transamination experiment was not literally metal-free, despite other metal-free chemistry discussed in that study. Reactions rxn_012 and rxn_013 supply glycine explicitly. Concentration, Al(III) availability and compatibility with the pyruvate-supply fluid remain unresolved. No enzyme or demonstrated L-selective influence is present.\"\n    },\n    {\n      \"id\": \"rxn_015\",\n      \"name\": \"Competing acetaldehyde cyanohydrin formation\",\n      \"inputs\": [\"mol_007\", \"mol_006\"],\n      \"outputs\": [\"mol_026\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-330 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Carbonyl/cyanide-containing receiving water. This branch becomes relatively important when free NH3 is scarce or protonated. Exact kinetics depend on cyanide speciation and pH; lower pH favoring the hydroxy-nitrile product distribution does not imply faster cyanide addition at every acidic pH.\"\n      },\n      \"mechanism\": \"Cyanide adds directly to the aldehyde carbonyl, followed by proton transfer. Net: CH3CHO + HCN -> CH3CH(OH)CN. No nitrogen is incorporated as an amino group.\",\n      \"reasoning\": \"Miller (1957) identified competition between amino- and hydroxynitrile chemistry. The 2023 Communications Chemistry acetylene/NiS study reported approximately 10.2 mM lactonitrile at pH 3 with no alanine, providing direct evidence for diversion of the acetaldehyde reservoir. The surface-temperature implementation is a chemically justified transfer scenario, not a reproduction of that hydrothermal experiment's full conditions.\"\n    },\n    {\n      \"id\": \"rxn_016\",\n      \"name\": \"Lactonitrile hydrolysis diverts carbon to lactic acid\",\n      \"inputs\": [\"mol_026\", \"mol_001\"],\n      \"outputs\": [\"mol_027\", \"mol_003\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Aqueous acid supplied by acidic geological fluids\"],\n      \"conditions\": {\n        \"temperature\": \"350-370 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": \"H+\",\n        \"aqueous\": true,\n        \"other\": \"Warm acidic receiving water, approximately pH 1-2 as a proposed hydrolysis compartment. Relative rates of aminonitrile and hydroxynitrile hydrolysis determine the final amino-acid/hydroxy-acid mixture.\"\n      },\n      \"mechanism\": \"Hydrolysis converts the nitrile carbon into a carboxyl group while retaining the alpha-hydroxyl substituent. Net: C3H5NO + 2 H2O -> C3H6O3 + NH3.\",\n      \"reasoning\": \"Miller (1957) supports hydroxy-acid formation through hydroxynitrile hydrolysis. This sink is included because a network containing only the desired Strecker product would overstate alanine selectivity. It does not contribute a pathway to L-alanine.\"\n    },\n    {\n      \"id\": \"rxn_017\",\n      \"name\": \"Competing hydrogenation of pyruvate to lactate on meteoritic metal\",\n      \"inputs\": [\"mol_016\", \"mol_004\"],\n      \"outputs\": [\"mol_027\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\"Ni-bearing meteoritic Fe-Ni surfaces\"],\n      \"conditions\": {\n        \"temperature\": \"295 K\",\n        \"pressure\": \"5 bar H2\",\n        \"catalyst\": \"Ni-bearing meteoritic alloy\",\n        \"aqueous\": true,\n        \"other\": \"Same anoxic aqueous interface as rxn_009, approximately pH 7-8. This reaction competes for the same pyruvate and reducing gas, especially when imine formation is limited by ammonia availability.\"\n      },\n      \"mechanism\": \"Surface-activated hydrogen reduces the keto group directly instead of reducing an imine. Net: C3H4O3 + H2 -> C3H6O3.\",\n      \"reasoning\": \"Kaur et al. (2024) reported approximately 43% lactate alongside approximately 24% alanine for the Aletai meteorite experiment. Encoding this competing channel prevents treatment of all consumed pyruvate as alanine. Its importance at the much lower pyruvate supply of Beyazay et al. (2023) requires separate kinetic measurements.\"\n    },\n    {\n      \"id\": \"rxn_018\",\n      \"name\": \"Dominant competing CO2 hydrogenation to formate\",\n      \"inputs\": [\"mol_015\", \"mol_004\"],\n      \"outputs\": [\"mol_028\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\"Ni3Fe alloy nanoparticles\"],\n      \"conditions\": {\n        \"temperature\": \"298 K\",\n        \"pressure\": \"25 bar CO2/H2 gas mixture\",\n        \"catalyst\": \"Ni3Fe\",\n        \"aqueous\": true,\n        \"other\": \"Same mineral-water reactor as rxn_007: initial pH approximately 6, CO2:H2 approximately 3:2 and 24 hours. The product is predominantly formate at this pH; the molecule node uses its neutral acid reference state.\"\n      },\n      \"mechanism\": \"Two-electron CO2 hydrogenation gives the C1 carboxylate without C-C coupling. Reference-state net: CO2 + H2 -> HCO2H.\",\n      \"reasoning\": \"Beyazay et al. (2023) measured approximately 26.72 mM formate compared with approximately 0.02 mM pyruvate. This experimentally dominant competing carbon channel is retained because upstream carbon fixation cannot be represented as selective conversion to the alanine skeleton. No subsequent formate-to-alanine shortcut is assumed.\"\n    },\n    {\n      \"id\": \"rxn_019\",\n      \"name\": \"Competing CO2 reduction and C-C coupling to acetate\",\n      \"inputs\": [\"mol_015\", \"mol_004\"],\n      \"outputs\": [\"mol_029\", \"mol_001\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\"Ni3Fe alloy nanoparticles\"],\n      \"conditions\": {\n        \"temperature\": \"298 K\",\n        \"pressure\": \"25 bar CO2/H2 gas mixture\",\n        \"catalyst\": \"Ni3Fe\",\n        \"aqueous\": true,\n        \"other\": \"Same mineral-water reactor as rxn_007 and rxn_018, initial pH approximately 6 and 24 hours. Acetate is the dominant protonation state; the node uses the neutral acid formula for consistent reference-state balances.\"\n      },\n      \"mechanism\": \"Surface reduction and C-C coupling generate a C2 carboxylate branch. Net: 2 CO2 + 4 H2 -> CH3CO2H + 2 H2O. The detailed catalytic sequence is not established by this net equation.\",\n      \"reasoning\": \"Beyazay et al. (2023) reported approximately 0.04 mM acetate under the same conditions that generated approximately 0.02 mM pyruvate. This is an observed side branch rather than a proposed alanine intermediate. Acetate is not assigned an unsupported direct reductive-amination route.\"\n    }\n  ],\n  \"pathways\": [\n    {\n      \"pathway_id\": \"P1\",\n      \"name\": \"Ammonia-fed atmospheric Strecker route\",\n      \"description\": \"Ammonia-containing discharge supplies acetaldehyde and cyanide. Strecker addition creates both alaninonitrile enantiomers; hydrolysis of the S component forms L-alanine while rxn_006 produces D-alanine in the same mixture. There is no isolation or enrichment of the L component.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_004\", \"rxn_005\"],\n      \"key_intermediates\": [\"mol_006\", \"mol_007\", \"mol_009\"]\n    },\n    {\n      \"pathway_id\": \"P2\",\n      \"name\": \"N2-activating atmospheric Strecker route\",\n      \"description\": \"The discharge activates N2 rather than requiring ammonia as the initial nitrogen feed. Its reduced-nitrogen, cyanide and acetaldehyde products feed the same racemic Strecker chemistry. This is an alternative nitrogen-entry pathway, not an alternative enantioselective mechanism; reduced-nitrogen accumulation is less constrained than in P1.\",\n      \"reaction_sequence\": [\"rxn_002\", \"rxn_004\", \"rxn_005\"],\n      \"key_intermediates\": [\"mol_003\", \"mol_006\", \"mol_007\", \"mol_009\"]\n    },\n    {\n      \"pathway_id\": \"P3\",\n      \"name\": \"Acetylene-derived carbon skeleton with ammonia-discharge cyanide supply\",\n      \"description\": \"This branched route assigns the acetaldehyde carbon skeleton to NiS-mediated acetylene hydration and cyanide to the ammonia-fed discharge. Atmospheric acetaldehyde may also coexist but is not the selected carbon-skeleton source in this route. Cooling, volatile retention and mixing are conditional physical requirements. The final alanine mixture contains both enantiomers.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_003\", \"rxn_004\", \"rxn_005\"],\n      \"key_intermediates\": [\"mol_006\", \"mol_007\", \"mol_009\"]\n    },\n    {\n      \"pathway_id\": \"P4\",\n      \"name\": \"Acetylene-derived carbon skeleton with N2-discharge nitrogen supply\",\n      \"description\": \"NiS hydration supplies acetaldehyde independently of N2-discharge production of cyanide and reduced nitrogen. The two precursor streams converge in Strecker chemistry. Compared with P3, nitrogen must be energetically activated from N2. Neither their natural coupling nor L enrichment is established.\",\n      \"reaction_sequence\": [\"rxn_002\", \"rxn_003\", \"rxn_004\", \"rxn_005\"],\n      \"key_intermediates\": [\"mol_003\", \"mol_006\", \"mol_007\", \"mol_009\"]\n    },\n    {\n      \"pathway_id\": \"P5\",\n      \"name\": \"CO2-to-pyruvate followed by nickel/H2 reductive amination\",\n      \"description\": \"Ni3Fe-mediated CO2 reduction provides a minor pyruvate stream; nickel then catalyzes H2-driven amination using supplied ammonia/ammonium. Both stages are individually demonstrated, but their natural concentration and flux coupling is not. L-alanine is one expected enantiomer of the unresolved product.\",\n      \"reaction_sequence\": [\"rxn_007\", \"rxn_008\"],\n      \"key_intermediates\": [\"mol_016\"]\n    },\n    {\n      \"pathway_id\": \"P6\",\n      \"name\": \"CO2-to-pyruvate followed by meteoritic-alloy/H2 amination\",\n      \"description\": \"CO2-derived pyruvate is aminated on accessible meteoritic Fe-Ni surfaces using external H2. This catalyst-source alternative is experimentally supported but conditional on exposed metal area and adequate precursor supply. Competing lactate production is represented separately, and no L-selective result is claimed.\",\n      \"reaction_sequence\": [\"rxn_007\", \"rxn_009\"],\n      \"key_intermediates\": [\"mol_016\"]\n    },\n    {\n      \"pathway_id\": \"P7\",\n      \"name\": \"CO2-derived pyruvate followed by surface ZnS photoreductive amination\",\n      \"description\": \"Pyruvate produced at an anoxic mineral-water interface is transported to an illuminated ZnS-bearing pool. Sulfite provides reducing equivalents through hole scavenging. Transfer, photon delivery and sulfur-product closure require validation; this route forms an unresolved alanine mixture rather than an isolated L fraction.\",\n      \"reaction_sequence\": [\"rxn_007\", \"rxn_010\"],\n      \"key_intermediates\": [\"mol_016\"]\n    },\n    {\n      \"pathway_id\": \"P8\",\n      \"name\": \"CO2-derived pyruvate with hydroxylamine and sacrificial Fe0\",\n      \"description\": \"Pyruvate receives nitrogen through hydroxylamine-derived intermediates and reducing equivalents from consumed metallic iron. The route explicitly includes proton demand and dissolved Fe(II) production. Natural hydroxylamine supply, suitable Fe0 surfaces and interstage concentration are unresolved; L selectivity is not demonstrated.\",\n      \"reaction_sequence\": [\"rxn_007\", \"rxn_011\"],\n      \"key_intermediates\": [\"mol_016\"]\n    },\n    {\n      \"pathway_id\": \"P9\",\n      \"name\": \"Ammonia-discharge glycine supply followed by pyruvate transamination\",\n      \"description\": \"The ammonia-fed atmospheric branch supplies formaldehyde and cyanide for glycine Strecker synthesis. Independently generated CO2-derived pyruvate accepts glycine's amino group under alum-assisted conditions. The sequence explicitly supplies organic nitrogen but does not demonstrate accumulation to the concentrated transamination benchmark or an L-enriched product.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_012\", \"rxn_013\", \"rxn_007\", \"rxn_014\"],\n      \"key_intermediates\": [\"mol_008\", \"mol_006\", \"mol_023\", \"mol_024\", \"mol_016\"]\n    },\n    {\n      \"pathway_id\": \"P10\",\n      \"name\": \"N2-discharge glycine supply followed by pyruvate transamination\",\n      \"description\": \"N2 activation supplies the nitrogen entering glycinonitrile and glycine, while a separate CO2/H2 branch supplies pyruvate. Alum-assisted transamination then redistributes that fixed nitrogen into alanine. This differs from P9 at nitrogen fixation, not at the terminal transamination mechanism; the unresolved product includes both L- and D-alanine.\",\n      \"reaction_sequence\": [\"rxn_002\", \"rxn_012\", \"rxn_013\", \"rxn_007\", \"rxn_014\"],\n      \"key_intermediates\": [\"mol_003\", \"mol_008\", \"mol_006\", \"mol_023\", \"mol_024\", \"mol_016\"]\n    }\n  ],\n  \"hub_molecules\": [\n    \"mol_001\",\n    \"mol_002\",\n    \"mol_003\",\n    \"mol_004\",\n    \"mol_006\",\n    \"mol_007\",\n    \"mol_008\",\n    \"mol_011\",\n    \"mol_012\",\n    \"mol_015\",\n    \"mol_016\",\n    \"mol_027\"\n  ],\n  \"convergence_points\": [\n    {\n      \"molecule_id\": \"mol_006\",\n      \"incoming_reactions\": [\"rxn_001\", \"rxn_002\"],\n      \"outgoing_reactions\": [\"rxn_004\", \"rxn_012\", \"rxn_015\"]\n    },\n    {\n      \"molecule_id\": \"mol_007\",\n      \"incoming_reactions\": [\"rxn_001\", \"rxn_002\", \"rxn_003\"],\n      \"outgoing_reactions\": [\"rxn_004\", \"rxn_015\"]\n    },\n    {\n      \"molecule_id\": \"mol_008\",\n      \"incoming_reactions\": [\"rxn_001\", \"rxn_002\"],\n      \"outgoing_reactions\": [\"rxn_012\"]\n    },\n    {\n      \"molecule_id\": \"mol_016\",\n      \"incoming_reactions\": [\"rxn_007\"],\n      \"outgoing_reactions\": [\"rxn_008\", \"rxn_009\", \"rxn_010\", \"rxn_011\", \"rxn_014\", \"rxn_017\"]\n    },\n    {\n      \"molecule_id\": \"mol_011\",\n      \"incoming_reactions\": [\"rxn_005\", \"rxn_008\", \"rxn_009\", \"rxn_010\", \"rxn_011\", \"rxn_014\"],\n      \"outgoing_reactions\": []\n    },\n    {\n      \"molecule_id\": \"mol_012\",\n      \"incoming_reactions\": [\"rxn_006\", \"rxn_008\", \"rxn_009\", \"rxn_010\", \"rxn_011\", \"rxn_014\"],\n      \"outgoing_reactions\": []\n    },\n    {\n      \"molecule_id\": \"mol_027\",\n      \"incoming_reactions\": [\"rxn_016\", \"rxn_017\"],\n      \"outgoing_reactions\": []\n    }\n  ]\n}", "parsed_response": {"target_molecule": "L-Alanine", "overall_strategy": "Construct ten distinct, partially shared feedstock-to-alanine pathways using atmospheric/Strecker chemistry, acetylene hydration, CO2-derived pyruvate, reductive amination and transamination. Crucially, this network establishes formation of L-alanine molecules within an unresolved alanine mixture, NOT isolated or L-enriched alanine. Separate L- and D-alanine nodes represent the racemic product pool; no unsupported resolution reaction is inserted. Likewise, the two alaninonitrile enantiomers are tracked separately without implying their separation. Equal L/D production is the achiral null model unless experimentally established; it is not a claimed enantiomeric analysis for every cited experiment. The ten pathways differ in nitrogen activation, carbon-skeleton supply or the alanine-forming reaction, rather than representing ten independent enantioselective mechanisms. All chemistry is anoxic and nonenzymatic. 'Biochemical' identifies mild abiotic mineral-water interfaces, not biological catalysis. Molecular formulas use neutral acid reference states where appropriate; actual acid-base speciation follows the stated pH. Null formation environments denote external feedstocks or species formed in multiple environments. The schema's 'intermediate' role also covers non-target coproducts and competitive sinks. Explicit equations appear in mechanism fields, never through repeated IDs. Proposed transport and concentration are distinguished from demonstrated reactions: no end-to-end natural coupling or approximately 1500-fold pyruvate enrichment is claimed. If the requested endpoint means isolated, substantially L-enriched material, that endpoint remains unsupported by the supplied literature.", "molecules": [{"id": "mol_001", "formula": "H2O", "iupac_name": "oxidane", "common_name": "water", "inchi": "InChI=1S/H2O/h1H2", "role": "starting", "environment_formed": null}, {"id": "mol_002", "formula": "CH4", "iupac_name": "methane", "common_name": "methane", "inchi": "InChI=1S/CH4/h1H4", "role": "starting", "environment_formed": null}, {"id": "mol_003", "formula": "NH3", "iupac_name": "azane", "common_name": "ammonia", "inchi": "InChI=1S/H3N/h1H3", "role": "starting", "environment_formed": null}, {"id": "mol_004", "formula": "H2", "iupac_name": "dihydrogen", "common_name": "hydrogen", "inchi": "InChI=1S/H2/h1H", "role": "starting", "environment_formed": null}, {"id": "mol_005", "formula": "N2", "iupac_name": "dinitrogen", "common_name": "nitrogen", "inchi": "InChI=1S/N2/c1-2", "role": "starting", "environment_formed": null}, {"id": "mol_006", "formula": "CHN", "iupac_name": "hydrogen cyanide", "common_name": "hydrogen cyanide", "inchi": "InChI=1S/CHN/c1-2/h1H", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_007", "formula": "C2H4O", "iupac_name": "ethanal", "common_name": "acetaldehyde", "inchi": "InChI=1S/C2H4O/c1-2-3/h2H,1H3", "role": "hub_intermediate", "environment_formed": null}, {"id": "mol_008", "formula": "CH2O", "iupac_name": "methanal", "common_name": "formaldehyde", "inchi": "InChI=1S/CH2O/c1-2/h1H2", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_009", "formula": "C3H6N2", "iupac_name": "(2S)-2-aminopropanenitrile", "common_name": "S-alaninonitrile", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_010", "formula": "C3H6N2", "iupac_name": "(2R)-2-aminopropanenitrile", "common_name": "R-alaninonitrile", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_011", "formula": "C3H7NO2", "iupac_name": "(2S)-2-aminopropanoic acid", "common_name": "L-alanine", "inchi": "InChI=1S/C3H7NO2/c1-2(4)3(5)6/h2H,4H2,1H3,(H,5,6)/t2-/m0/s1", "role": "target", "environment_formed": null}, {"id": "mol_012", "formula": "C3H7NO2", "iupac_name": "(2R)-2-aminopropanoic acid", "common_name": "D-alanine", "inchi": "InChI=1S/C3H7NO2/c1-2(4)3(5)6/h2H,4H2,1H3,(H,5,6)/t2-/m1/s1", "role": "intermediate", "environment_formed": null}, {"id": "mol_013", "formula": "C2H2", "iupac_name": "ethyne", "common_name": "acetylene", "inchi": "InChI=1S/C2H2/c1-2/h1-2H", "role": "starting", "environment_formed": null}, {"id": "mol_014", "formula": "CO", "iupac_name": "carbon monoxide", "common_name": "carbon monoxide", "inchi": "InChI=1S/CO/c1-2", "role": "starting", "environment_formed": null}, {"id": "mol_015", "formula": "CO2", "iupac_name": "carbon dioxide", "common_name": "carbon dioxide", "inchi": "InChI=1S/CO2/c2-1-3", "role": "starting", "environment_formed": null}, {"id": "mol_016", "formula": "C3H4O3", "iupac_name": "2-oxopropanoic acid", "common_name": "pyruvic acid", "inchi": "InChI=1S/C3H4O3/c1-2(4)3(5)6/h1H3,(H,5,6)", "role": "hub_intermediate", "environment_formed": "Biochemical"}, {"id": "mol_017", "formula": "SO3^2-", "iupac_name": "sulfite", "common_name": "sulfite ion", "inchi": null, "role": "starting", "environment_formed": null}, {"id": "mol_018", "formula": "SO4^2-", "iupac_name": "sulfate", "common_name": "sulfate ion", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_019", "formula": "H3NO", "iupac_name": "hydroxylamine", "common_name": "hydroxylamine", "inchi": "InChI=1S/H3NO/c1-2/h2H,1H2", "role": "starting", "environment_formed": null}, {"id": "mol_020", "formula": "Fe", "iupac_name": "iron", "common_name": "metallic iron", "inchi": "InChI=1S/Fe", "role": "starting", "environment_formed": null}, {"id": "mol_021", "formula": "H+", "iupac_name": "hydron", "common_name": "aqueous proton", "inchi": null, "role": "starting", "environment_formed": null}, {"id": "mol_022", "formula": "Fe^2+", "iupac_name": "iron(2+)", "common_name": "ferrous ion", "inchi": "InChI=1S/Fe/q+2", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_023", "formula": "C2H4N2", "iupac_name": "2-aminoacetonitrile", "common_name": "glycinonitrile", "inchi": "InChI=1S/C2H4N2/c3-1-2-4/h1,3H2", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_024", "formula": "C2H5NO2", "iupac_name": "2-aminoacetic acid", "common_name": "glycine", "inchi": "InChI=1S/C2H5NO2/c3-1-2(4)5/h1,3H2,(H,4,5)", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_025", "formula": "C2H2O3", "iupac_name": "2-oxoacetic acid", "common_name": "glyoxylic acid", "inchi": "InChI=1S/C2H2O3/c3-1-2(4)5/h1H,(H,4,5)", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_026", "formula": "C3H5NO", "iupac_name": "2-hydroxypropanenitrile", "common_name": "lactonitrile, stereochemistry unspecified", "inchi": "InChI=1S/C3H5NO/c1-3(5)2-4/h3,5H,1H3", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_027", "formula": "C3H6O3", "iupac_name": "2-hydroxypropanoic acid", "common_name": "lactic acid, stereochemistry unspecified", "inchi": "InChI=1S/C3H6O3/c1-2(4)3(5)6/h2,4H,1H3,(H,5,6)", "role": "hub_intermediate", "environment_formed": null}, {"id": "mol_028", "formula": "CH2O2", "iupac_name": "formic acid", "common_name": "formic acid", "inchi": "InChI=1S/CH2O2/c2-1-3/h1H,(H,2,3)", "role": "intermediate", "environment_formed": "Biochemical"}, {"id": "mol_029", "formula": "C2H4O2", "iupac_name": "acetic acid", "common_name": "acetic acid", "inchi": "InChI=1S/C2H4O2/c1-2(3)4/h1H3,(H,3,4)", "role": "intermediate", "environment_formed": "Biochemical"}], "reactions": [{"id": "rxn_001", "name": "Ammonia-containing atmospheric discharge supplies cyanide and carbonyl compounds", "inputs": ["mol_001", "mol_002", "mol_003", "mol_004"], "outputs": ["mol_006", "mol_007", "mol_008", "mol_004"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-340 K bulk gas and receiving water; transient discharge channels are much hotter", "pressure": "Approximately 1 atm in the modeled local plume", "catalyst": null, "aqueous": true, "other": "Anoxic CH4/NH3/H2/water-vapor mixture with repeated electrical discharge and gas-liquid circulation over days. Condensation and rainout deliver products to water. Alkaline receiving pools can retain HCN as cyanide; aldehyde volatilization, dilution and UV destruction remain competing losses. This is a gas-phase production plus aqueous-capture module, not a single elementary aqueous reaction."}, "mechanism": "Discharge-generated radicals form reduced C-N compounds and oxygenated carbon compounds. Independent formal net channels include CH4 + NH3 -> HCN + 3 H2; 2 CH4 + H2O -> CH3CHO + 4 H2; and CH4 + H2O -> HCHO + 2 H2. Their relative fluxes are unspecified. H2 is both a supplied gas and a possible net product, explaining its appearance on both sides without repeated IDs within either array.", "reasoning": "Miller (1955, 1957) supports discharge production of HCN and aldehydes followed by Strecker chemistry, with DL-alanine rather than isolated L-alanine. Johnson et al. (2008) supports a volcanic-discharge context. Trail et al. (2011) argues against assuming a globally persistent methane/ammonia atmosphere, so this node is restricted to local or episodic reduced gas mixtures. The formal equations establish atom accounting, not measured coproduct ratios or quantitative condensate capture."}, {"id": "rxn_002", "name": "Nitrogen-containing atmospheric discharge supplies reduced nitrogen, cyanide and carbonyl compounds", "inputs": ["mol_001", "mol_002", "mol_005", "mol_004"], "outputs": ["mol_006", "mol_007", "mol_008", "mol_003", "mol_004"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-340 K bulk gas and receiving water; impulsive plasma temperatures are much higher", "pressure": "Approximately 1 atm in the modeled local plume", "catalyst": null, "aqueous": true, "other": "Anoxic CH4/N2/H2/water-vapor discharge followed by condensation into receiving pools. Nitrogen fixation requires the discharge, not ordinary UV illumination alone. Reduced nitrogen concentrations and capture efficiencies are not supplied by the research summary and are not assumed equal to the ammonia-fed experiment."}, "mechanism": "Energetic N2 activation feeds HCN and reduced-nitrogen chemistry while methane/water radical chemistry supplies aldehydes. One formal aggregate balance is 4 CH4 + N2 + 2 H2O + H2 -> HCN + NH3 + CH3CHO + HCHO + 6 H2. This is multichannel bookkeeping, not an elementary mechanism or a predicted product distribution; the ammonia node represents the reduced-nitrogen resource available for subsequent imine formation.", "reasoning": "Miller (1957) obtained the same general amino-acid products at lower yield when N2 replaced supplied NH3. This is chemically distinct from rxn_001 because nitrogen activation must occur within the discharge. The supplied report does not quantify the free-ammonia inventory for this variant, so downstream Strecker performance cannot be assigned the ammonia-fed yields. Local reducing carbon supply remains environmentally conditional, as emphasized by Trail et al. (2011)."}, {"id": "rxn_003", "name": "Nickel-sulfide-mediated acetylene hydration supplies acetaldehyde", "inputs": ["mol_013", "mol_001", "mol_014"], "outputs": ["mol_007", "mol_014"], "environment": "Hydrothermal", "agents": ["Freshly precipitated nickel sulfide, NiS"], "conditions": {"temperature": "378 K", "pressure": "Closed gas-bearing aqueous system, above approximately 1.2 bar to retain liquid water; exact experimental gas pressure is not given in the supplied report", "catalyst": "NiS", "aqueous": true, "other": "Acetylene and CO contact NiS-bearing water. CO is retained as an experimentally present gas, not consumed by the represented hydration channel. Proposed transfer is cooling and advective transport through liquid-filled fractures into a cyanide/ammonia-bearing receiving pool; acetaldehyde retention during that transfer is unquantified. The hydrothermal and Strecker stages need not occur at the same pH."}, "mechanism": "NiS-mediated hydration produces an enol that tautomerizes to acetaldehyde. Net: C2H2 + H2O -> CH3CHO. CO is an unchanged participant in this target-focused net channel; other CO-consuming chemistry is not inferred.", "reasoning": "The 2023 Communications Chemistry acetylene/NiS study, whose authors are not identified in the supplied report, demonstrated acetaldehyde formation at 105 degrees C and identified the subsequent alanine Strecker intermediates after cyanide/ammonium addition. FeS alone did not reproduce free-acetaldehyde formation. The combined experiment gave only approximately 180 micromolar alanine after seven days, approximately 0.02% relative to ammonium chloride. The evidence therefore supports this carbonyl-supply alternative but not efficient cross-environment coupling or an L-selective product."}, {"id": "rxn_004", "name": "Acetaldehyde Strecker reaction forms both alaninonitrile enantiomers", "inputs": ["mol_007", "mol_003", "mol_006"], "outputs": ["mol_009", "mol_010", "mol_001"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-330 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Proposed receiving pool at approximately pH 8.5-10, with sufficient free NH3 and cyanide. Ammonia availability must compete successfully with cyanohydrin formation. Shallow subsurface water or mineral-covered pool margins reduce photodestruction without assuming absence of surface UV. No chiral catalyst or enantiomer separation is present."}, "mechanism": "Acetaldehyde and ammonia reversibly form a carbinolamine and imine/iminium intermediate; cyanide attacks the planar C=N center from either face. Achiral-pool balance: 2 CH3CHO + 2 NH3 + 2 HCN -> S-alaninonitrile + R-alaninonitrile + 2 H2O. The intermediates are described mechanistically rather than added as unnecessary persistent nodes.", "reasoning": "Miller (1957) supports aldehyde/HCN/ammonia Strecker chemistry. The 2023 Communications Chemistry acetylene/NiS study identified aminoethanol and 2-aminopropanenitrile and showed strong pH dependence. The chosen surface temperature/pH window is a plausible integration scenario, not a reported optimum for the complete transported network. Achiral reactants provide no intrinsic L preference; separate nitrile nodes are stereochemical bookkeeping, not physically resolved fractions."}, {"id": "rxn_005", "name": "Hydrolysis of S-alaninonitrile produces the L-alanine component", "inputs": ["mol_009", "mol_001"], "outputs": ["mol_011", "mol_003"], "environment": "Surface", "agents": ["Aqueous acid supplied by acidic geological fluids"], "conditions": {"temperature": "350-370 K", "pressure": "Approximately 1 atm", "catalyst": "H+", "aqueous": true, "other": "Proposed warm, acidic receiving compartment, approximately pH 1-2, with sustained liquid water. Acidification follows rather than accompanies the alkaline capture stage. Residence times may extend over days or longer; conversion and racemization must be measured for the actual mixture. The R-enantiomer remains present and undergoes rxn_006 under the same conditions."}, "mechanism": "Nitrile hydration through an amide gives the carboxylic acid without requiring cleavage of a bond at the stereogenic carbon. Net reference-state equation: S-C3H6N2 + 2 H2O -> L-C3H7NO2 + NH3. Ammonia is predominantly ammonium under the stated acidic conditions. This is synthesis from one component of an unresolved nitrile pool, not enantioseparation.", "reasoning": "Miller (1957) supports aminonitrile hydrolysis as a source of accumulated amino acids. The specific acidic surface compartment is an explicitly proposed integration condition, not a demonstrated natural reactor. Stereoretentive hydrolysis accounts for L molecules already encoded in the S-nitrile fraction; it neither enriches that fraction nor establishes isolated L-alanine. The equivalent R branch prevents a false homochiral endpoint."}, {"id": "rxn_006", "name": "Parallel hydrolysis of R-alaninonitrile produces D-alanine", "inputs": ["mol_010", "mol_001"], "outputs": ["mol_012", "mol_003"], "environment": "Surface", "agents": ["Aqueous acid supplied by acidic geological fluids"], "conditions": {"temperature": "350-370 K", "pressure": "Approximately 1 atm", "catalyst": "H+", "aqueous": true, "other": "Same unresolved aqueous mixture and acidification history as rxn_005. No kinetic resolution, selective adsorption or preferential crystallization is assumed."}, "mechanism": "R-C3H6N2 + 2 H2O -> D-C3H7NO2 + NH3 through nitrile hydration and amide hydrolysis. In an achiral environment this branch has the same intrinsic kinetics as the corresponding S branch, apart from any unmodeled environmental asymmetry.", "reasoning": "Miller (1955, 1957) established DL-alanine and the aminonitrile-hydrolysis interpretation. This coproduct branch is chemically necessary to avoid representing an achiral Strecker reaction as selective L synthesis. It is not an additional pathway claimed toward the L target."}, {"id": "rxn_007", "name": "Ni3Fe-catalyzed CO2 hydrogenation supplies pyruvate", "inputs": ["mol_015", "mol_004"], "outputs": ["mol_016", "mol_001"], "environment": "Biochemical", "agents": ["Ni3Fe alloy nanoparticles, an awaruite-like catalytic material"], "conditions": {"temperature": "298 K", "pressure": "25 bar CO2/H2 gas mixture", "catalyst": "Ni3Fe", "aqueous": true, "other": "Reported condition: initial pH approximately 6, CO2:H2 approximately 3:2, 24 hours. Physical analog: cool, pressurized, anoxic rock-water pores adjoining serpentinizing and CO2-bearing fluid sources, not a 350-600 K hot vent interior. Subsequent groundwater advection or porewater exchange is proposed; neither concentration nor downstream yield is established by this node."}, "mechanism": "Metal-catalyzed H2 activation, CO2 reduction and C-C coupling generate a minor C3 alpha-keto-acid branch. Net: 3 CO2 + 5 H2 -> C3H4O3 + 3 H2O. This is the balanced pyruvate channel, not the overall product distribution; competing formate and acetate channels are rxn_018 and rxn_019.", "reasoning": "Beyazay et al. (2023) measured approximately 0.02 mM pyruvate, 26.72 mM formate and 0.04 mM acetate under these conditions. Pyruvate supply is therefore experimentally supported but minor. Kaur et al. (2024) used 30 mM pyruvate downstream, a nominal approximately 1500-fold concentration difference. That difference is an unresolved integration and flux problem, not proof that dilute alanine formation is impossible. No concentration mechanism in this network is asserted to bridge it quantitatively."}, {"id": "rxn_008", "name": "H2-driven reductive amination of pyruvate on nickel", "inputs": ["mol_016", "mol_003", "mol_004"], "outputs": ["mol_011", "mol_012", "mol_001"], "environment": "Biochemical", "agents": ["Metallic nickel"], "conditions": {"temperature": "295 K", "pressure": "5 bar H2", "catalyst": "Ni", "aqueous": true, "other": "Reported benchmark: pH 7-8, 30 mM pyruvate, total ammonia/ammonium 6-150 mM, 24 hours. Physical setting: anoxic, H2-bearing aqueous mineral pores. Proposed coupling from rxn_007 requires fluid exchange, altered gas composition and buffering; it does not imply that 30 mM pyruvate arises automatically. No enzyme, cofactor or chiral auxiliary is used."}, "mechanism": "Pyruvate condenses with free NH3; Ni activates H2 and hydrogenates the resulting imine/iminium. Achiral reference balance: 2 C3H4O3 + 2 NH3 + 2 H2 -> L-alanine + D-alanine + 2 H2O.", "reasoning": "Kaur et al. (2024) demonstrated H2-dependent alanine production with Ni, including up to approximately 17% yield relative to ammonia at 6 mM ammonia and 30 mM pyruvate. H2 is an explicit stoichiometric reductant, while Ni is catalytic. The experiment does not establish L selectivity; equal enantiomer production here is the achiral expectation. A serpentinization-related H2 source has geological precedent in Kelley et al. (2005), but the stated upstream/downstream coupling remains untested."}, {"id": "rxn_009", "name": "H2-driven reductive amination on meteoritic Fe-Ni material", "inputs": ["mol_016", "mol_003", "mol_004"], "outputs": ["mol_011", "mol_012", "mol_001"], "environment": "Biochemical", "agents": ["Accessible Ni-bearing Fe-Ni meteoritic alloy, represented by the tested Aletai material"], "conditions": {"temperature": "295 K", "pressure": "5 bar H2", "catalyst": "Ni-bearing meteoritic Fe-Ni surfaces", "aqueous": true, "other": "Mild anoxic aqueous mineral interface at approximately pH 7-8, with pyruvate and ammonia/ammonium. The study used powdered meteoritic material and externally supplied concentrated pyruvate. Natural application requires surviving exposed metal surfaces, sufficient H2 activity and residence time; intact meteorites cannot be assigned the surface area of laboratory powder."}, "mechanism": "Meteoritic metal catalyzes H2 activation and reduction of a pyruvate-derived imine. Net: 2 C3H4O3 + 2 NH3 + 2 H2 -> L-alanine + D-alanine + 2 H2O. Metallic iron is not inserted as a consumed reagent because the demonstrated reaction requires external H2.", "reasoning": "Kaur et al. (2024) reported approximately 24% alanine and 43% lactate with powdered Aletai meteorite; removal of H2 abolished product formation. This supports a catalytic alloy branch rather than speculative oxidation of bulk meteoritic iron as the electron source. Competing lactate formation is represented by rxn_017. Catalyst accessibility, precursor concentration and enantiomeric composition remain separate limitations; this is not evidence of an isolated L product."}, {"id": "rxn_010", "name": "ZnS photocatalytic reductive amination with sulfite as electron donor", "inputs": ["mol_016", "mol_003", "mol_017"], "outputs": ["mol_011", "mol_012", "mol_018"], "environment": "Surface", "agents": ["Illuminated sphalerite, ZnS"], "conditions": {"temperature": "303 K", "pressure": "Approximately 1 atm", "catalyst": "ZnS semiconductor", "aqueous": true, "other": "Approximately pH 9, several hours of irradiation at wavelengths absorbed by ZnS, and available sulfite as a sacrificial hole scavenger. The supplied report does not specify a transferable natural photon flux. Physical setting: an illuminated shallow anoxic pool or exposed mineral-water film, not a dark deep-sea vent. Upwelling groundwater could deliver pyruvate, but survival and concentration during delivery are unquantified."}, "mechanism": "Photogenerated conduction-band electrons reduce the pyruvate/ammonia-derived imine while sulfite consumes photogenerated holes. For the sulfate oxidation endpoint, the balanced net channel is 2 C3H4O3 + 2 NH3 + 2 SO3^2- -> L-alanine + D-alanine + 2 SO4^2-. Oxygen atoms are supplied by the reactants and water-mediated chemistry, not molecular O2.", "reasoning": "Wang et al. (2012) demonstrated ZnS/light-dependent alpha-keto-acid amination and use of sulfite as a sacrificial scavenger. Sulfate is the chemically justified two-electron oxidation endpoint used to close this particular net channel; the supplied summary does not establish quantitative sulfur-product recovery, and competing sulfur chemistry or photocorrosion must be checked. Thus the alanine-forming reaction is supported, while its full redox-product accounting and environmental coupling are conditional. No L bias is established."}, {"id": "rxn_011", "name": "Hydroxylamine-mediated nitrogen incorporation with sacrificial metallic iron", "inputs": ["mol_016", "mol_019", "mol_020", "mol_021"], "outputs": ["mol_011", "mol_012", "mol_022", "mol_001"], "environment": "Surface", "agents": ["Metallic iron powder as a consumed reductant, also listed explicitly as mol_020"], "conditions": {"temperature": "343 K proposed working condition; the supplied summary does not separately specify the amination-step temperature", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Proposed acidic, anoxic geothermal pool or mineral-covered water pocket, approximately pH 3-5, maintaining soluble Fe(II). The cited experiment introduced hydroxylamine hydrochloride at six equivalents and Fe0 powder at ten equivalents. Those reagent excesses are not replaced by the smaller ideal stoichiometric coefficients. Hydroxylamine supply and persistence are independent unresolved feedstock requirements."}, "mechanism": "Hydroxylamine forms an oxime-like intermediate; reduction of C=N and N-O functionality gives alanine while Fe0 supplies four electrons per alanine. Acidic reference balance: 2 C3H4O3 + 2 NH2OH + 4 Fe + 8 H+ -> L-alanine + D-alanine + 4 Fe^2+ + 4 H2O. Fe^2+ represents the dissolved corrosion product, not an invented ferric mineral phase. Parasitic H2 evolution can consume additional Fe and acid.", "reasoning": "Muchowska, Varma and Moran (2019) detected alanine after hydroxylamine/Fe0 treatment of the corresponding keto-acid chemistry. Metallic iron is correctly encoded as a stoichiometric donor rather than a trace catalyst, and hydroxylamine has the consistent formula H3NO. The proposed pH and temperature are integration assumptions, not quoted optimized conditions. Natural inventories of hydroxylamine and reactive Fe0, actual iron speciation, and the pyruvate concentration remain bottlenecks. The supplied evidence does not demonstrate L selectivity."}, {"id": "rxn_012", "name": "Formaldehyde Strecker reaction supplies glycinonitrile", "inputs": ["mol_008", "mol_003", "mol_006"], "outputs": ["mol_023", "mol_001"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-330 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Anoxic, mildly alkaline carbonyl/cyanide/ammonia-containing pool, approximately pH 8.5-10 as a proposed integration window. Atmospheric condensate supplies formaldehyde and HCN. Competing formaldehyde oligomerization and hydroxynitrile chemistry can lower glycinonitrile accumulation."}, "mechanism": "Formaldehyde/ammonia condensation produces an imine-equivalent that undergoes cyanide addition. Net: HCHO + NH3 + HCN -> NH2CH2CN + H2O. The product is achiral.", "reasoning": "Miller (1957) supports the aldehyde/aminonitrile mechanism of glycine production. This reaction provides an explicit organic nitrogen donor precursor for transamination instead of treating glycine as an unexplained complex feedstock. The chosen receiving-pool conditions are a plausible scenario; neither the required glycine concentration nor a complete naturally operating reactor is demonstrated."}, {"id": "rxn_013", "name": "Glycinonitrile hydrolysis supplies glycine", "inputs": ["mol_023", "mol_001"], "outputs": ["mol_024", "mol_003"], "environment": "Surface", "agents": ["Aqueous acid supplied by acidic geological fluids"], "conditions": {"temperature": "350-370 K", "pressure": "Approximately 1 atm", "catalyst": "H+", "aqueous": true, "other": "Proposed warm acidic water after alkaline precursor capture, approximately pH 1-2. Subsequent buffering toward pH 5 is required before the alum-assisted transamination stage. Actual conversion, retention and concentration must be established rather than inferred from laboratory hydrolysis."}, "mechanism": "Nitrile hydration and amide hydrolysis give glycine. Net: NH2CH2CN + 2 H2O -> NH2CH2CO2H + NH3. Protonation equilibria convert much of the released ammonia to ammonium under these conditions.", "reasoning": "Miller (1957) supports hydrolysis of atmospheric Strecker intermediates as an amino-acid source. This explicitly closes the glycine-supply branch. It does not establish accumulation to the 350 mM glycine concentration used by Stubbs et al. (2020), and no fictitious concentration reaction is inserted."}, {"id": "rxn_014", "name": "Alum-assisted nonenzymatic transamination from glycine to pyruvate", "inputs": ["mol_016", "mol_024"], "outputs": ["mol_011", "mol_012", "mol_025"], "environment": "Surface", "agents": ["Potassium alum, KAl(SO4)2\u00b712H2O, supplying Al(III)"], "conditions": {"temperature": "353 K", "pressure": "Approximately 1 atm", "catalyst": "Al(III) supplied by potassium alum", "aqueous": true, "other": "Reported benchmark: pH 5, 350 mM glycine, approximately 1.2 equivalents pyruvate, 0.1 equivalent potassium alum and 24 hours. Physical scenario: an acidic warm evaporative-pool sediment with sufficient residence time and partial mineral shielding from UV. Atmospheric glycine and groundwater pyruvate must be mixed and buffered; their accumulation to the reported concentrations is not demonstrated."}, "mechanism": "Carbonyl/amine condensation and proton transfers redistribute the amino group from glycine to pyruvate, yielding glyoxylate. Achiral-pool balance: 2 C3H4O3 + 2 C2H5NO2 -> L-alanine + D-alanine + 2 C2H2O3. This transfers organic nitrogen; it does not fix new nitrogen.", "reasoning": "Stubbs et al. (2020) reported approximately 19% alanine under these conditions. Alum is included because the reported transamination experiment was not literally metal-free, despite other metal-free chemistry discussed in that study. Reactions rxn_012 and rxn_013 supply glycine explicitly. Concentration, Al(III) availability and compatibility with the pyruvate-supply fluid remain unresolved. No enzyme or demonstrated L-selective influence is present."}, {"id": "rxn_015", "name": "Competing acetaldehyde cyanohydrin formation", "inputs": ["mol_007", "mol_006"], "outputs": ["mol_026"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-330 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Carbonyl/cyanide-containing receiving water. This branch becomes relatively important when free NH3 is scarce or protonated. Exact kinetics depend on cyanide speciation and pH; lower pH favoring the hydroxy-nitrile product distribution does not imply faster cyanide addition at every acidic pH."}, "mechanism": "Cyanide adds directly to the aldehyde carbonyl, followed by proton transfer. Net: CH3CHO + HCN -> CH3CH(OH)CN. No nitrogen is incorporated as an amino group.", "reasoning": "Miller (1957) identified competition between amino- and hydroxynitrile chemistry. The 2023 Communications Chemistry acetylene/NiS study reported approximately 10.2 mM lactonitrile at pH 3 with no alanine, providing direct evidence for diversion of the acetaldehyde reservoir. The surface-temperature implementation is a chemically justified transfer scenario, not a reproduction of that hydrothermal experiment's full conditions."}, {"id": "rxn_016", "name": "Lactonitrile hydrolysis diverts carbon to lactic acid", "inputs": ["mol_026", "mol_001"], "outputs": ["mol_027", "mol_003"], "environment": "Surface", "agents": ["Aqueous acid supplied by acidic geological fluids"], "conditions": {"temperature": "350-370 K", "pressure": "Approximately 1 atm", "catalyst": "H+", "aqueous": true, "other": "Warm acidic receiving water, approximately pH 1-2 as a proposed hydrolysis compartment. Relative rates of aminonitrile and hydroxynitrile hydrolysis determine the final amino-acid/hydroxy-acid mixture."}, "mechanism": "Hydrolysis converts the nitrile carbon into a carboxyl group while retaining the alpha-hydroxyl substituent. Net: C3H5NO + 2 H2O -> C3H6O3 + NH3.", "reasoning": "Miller (1957) supports hydroxy-acid formation through hydroxynitrile hydrolysis. This sink is included because a network containing only the desired Strecker product would overstate alanine selectivity. It does not contribute a pathway to L-alanine."}, {"id": "rxn_017", "name": "Competing hydrogenation of pyruvate to lactate on meteoritic metal", "inputs": ["mol_016", "mol_004"], "outputs": ["mol_027"], "environment": "Biochemical", "agents": ["Ni-bearing meteoritic Fe-Ni surfaces"], "conditions": {"temperature": "295 K", "pressure": "5 bar H2", "catalyst": "Ni-bearing meteoritic alloy", "aqueous": true, "other": "Same anoxic aqueous interface as rxn_009, approximately pH 7-8. This reaction competes for the same pyruvate and reducing gas, especially when imine formation is limited by ammonia availability."}, "mechanism": "Surface-activated hydrogen reduces the keto group directly instead of reducing an imine. Net: C3H4O3 + H2 -> C3H6O3.", "reasoning": "Kaur et al. (2024) reported approximately 43% lactate alongside approximately 24% alanine for the Aletai meteorite experiment. Encoding this competing channel prevents treatment of all consumed pyruvate as alanine. Its importance at the much lower pyruvate supply of Beyazay et al. (2023) requires separate kinetic measurements."}, {"id": "rxn_018", "name": "Dominant competing CO2 hydrogenation to formate", "inputs": ["mol_015", "mol_004"], "outputs": ["mol_028"], "environment": "Biochemical", "agents": ["Ni3Fe alloy nanoparticles"], "conditions": {"temperature": "298 K", "pressure": "25 bar CO2/H2 gas mixture", "catalyst": "Ni3Fe", "aqueous": true, "other": "Same mineral-water reactor as rxn_007: initial pH approximately 6, CO2:H2 approximately 3:2 and 24 hours. The product is predominantly formate at this pH; the molecule node uses its neutral acid reference state."}, "mechanism": "Two-electron CO2 hydrogenation gives the C1 carboxylate without C-C coupling. Reference-state net: CO2 + H2 -> HCO2H.", "reasoning": "Beyazay et al. (2023) measured approximately 26.72 mM formate compared with approximately 0.02 mM pyruvate. This experimentally dominant competing carbon channel is retained because upstream carbon fixation cannot be represented as selective conversion to the alanine skeleton. No subsequent formate-to-alanine shortcut is assumed."}, {"id": "rxn_019", "name": "Competing CO2 reduction and C-C coupling to acetate", "inputs": ["mol_015", "mol_004"], "outputs": ["mol_029", "mol_001"], "environment": "Biochemical", "agents": ["Ni3Fe alloy nanoparticles"], "conditions": {"temperature": "298 K", "pressure": "25 bar CO2/H2 gas mixture", "catalyst": "Ni3Fe", "aqueous": true, "other": "Same mineral-water reactor as rxn_007 and rxn_018, initial pH approximately 6 and 24 hours. Acetate is the dominant protonation state; the node uses the neutral acid formula for consistent reference-state balances."}, "mechanism": "Surface reduction and C-C coupling generate a C2 carboxylate branch. Net: 2 CO2 + 4 H2 -> CH3CO2H + 2 H2O. The detailed catalytic sequence is not established by this net equation.", "reasoning": "Beyazay et al. (2023) reported approximately 0.04 mM acetate under the same conditions that generated approximately 0.02 mM pyruvate. This is an observed side branch rather than a proposed alanine intermediate. Acetate is not assigned an unsupported direct reductive-amination route."}], "pathways": [{"pathway_id": "P1", "name": "Ammonia-fed atmospheric Strecker route", "description": "Ammonia-containing discharge supplies acetaldehyde and cyanide. Strecker addition creates both alaninonitrile enantiomers; hydrolysis of the S component forms L-alanine while rxn_006 produces D-alanine in the same mixture. There is no isolation or enrichment of the L component.", "reaction_sequence": ["rxn_001", "rxn_004", "rxn_005"], "key_intermediates": ["mol_006", "mol_007", "mol_009"]}, {"pathway_id": "P2", "name": "N2-activating atmospheric Strecker route", "description": "The discharge activates N2 rather than requiring ammonia as the initial nitrogen feed. Its reduced-nitrogen, cyanide and acetaldehyde products feed the same racemic Strecker chemistry. This is an alternative nitrogen-entry pathway, not an alternative enantioselective mechanism; reduced-nitrogen accumulation is less constrained than in P1.", "reaction_sequence": ["rxn_002", "rxn_004", "rxn_005"], "key_intermediates": ["mol_003", "mol_006", "mol_007", "mol_009"]}, {"pathway_id": "P3", "name": "Acetylene-derived carbon skeleton with ammonia-discharge cyanide supply", "description": "This branched route assigns the acetaldehyde carbon skeleton to NiS-mediated acetylene hydration and cyanide to the ammonia-fed discharge. Atmospheric acetaldehyde may also coexist but is not the selected carbon-skeleton source in this route. Cooling, volatile retention and mixing are conditional physical requirements. The final alanine mixture contains both enantiomers.", "reaction_sequence": ["rxn_001", "rxn_003", "rxn_004", "rxn_005"], "key_intermediates": ["mol_006", "mol_007", "mol_009"]}, {"pathway_id": "P4", "name": "Acetylene-derived carbon skeleton with N2-discharge nitrogen supply", "description": "NiS hydration supplies acetaldehyde independently of N2-discharge production of cyanide and reduced nitrogen. The two precursor streams converge in Strecker chemistry. Compared with P3, nitrogen must be energetically activated from N2. Neither their natural coupling nor L enrichment is established.", "reaction_sequence": ["rxn_002", "rxn_003", "rxn_004", "rxn_005"], "key_intermediates": ["mol_003", "mol_006", "mol_007", "mol_009"]}, {"pathway_id": "P5", "name": "CO2-to-pyruvate followed by nickel/H2 reductive amination", "description": "Ni3Fe-mediated CO2 reduction provides a minor pyruvate stream; nickel then catalyzes H2-driven amination using supplied ammonia/ammonium. Both stages are individually demonstrated, but their natural concentration and flux coupling is not. L-alanine is one expected enantiomer of the unresolved product.", "reaction_sequence": ["rxn_007", "rxn_008"], "key_intermediates": ["mol_016"]}, {"pathway_id": "P6", "name": "CO2-to-pyruvate followed by meteoritic-alloy/H2 amination", "description": "CO2-derived pyruvate is aminated on accessible meteoritic Fe-Ni surfaces using external H2. This catalyst-source alternative is experimentally supported but conditional on exposed metal area and adequate precursor supply. Competing lactate production is represented separately, and no L-selective result is claimed.", "reaction_sequence": ["rxn_007", "rxn_009"], "key_intermediates": ["mol_016"]}, {"pathway_id": "P7", "name": "CO2-derived pyruvate followed by surface ZnS photoreductive amination", "description": "Pyruvate produced at an anoxic mineral-water interface is transported to an illuminated ZnS-bearing pool. Sulfite provides reducing equivalents through hole scavenging. Transfer, photon delivery and sulfur-product closure require validation; this route forms an unresolved alanine mixture rather than an isolated L fraction.", "reaction_sequence": ["rxn_007", "rxn_010"], "key_intermediates": ["mol_016"]}, {"pathway_id": "P8", "name": "CO2-derived pyruvate with hydroxylamine and sacrificial Fe0", "description": "Pyruvate receives nitrogen through hydroxylamine-derived intermediates and reducing equivalents from consumed metallic iron. The route explicitly includes proton demand and dissolved Fe(II) production. Natural hydroxylamine supply, suitable Fe0 surfaces and interstage concentration are unresolved; L selectivity is not demonstrated.", "reaction_sequence": ["rxn_007", "rxn_011"], "key_intermediates": ["mol_016"]}, {"pathway_id": "P9", "name": "Ammonia-discharge glycine supply followed by pyruvate transamination", "description": "The ammonia-fed atmospheric branch supplies formaldehyde and cyanide for glycine Strecker synthesis. Independently generated CO2-derived pyruvate accepts glycine's amino group under alum-assisted conditions. The sequence explicitly supplies organic nitrogen but does not demonstrate accumulation to the concentrated transamination benchmark or an L-enriched product.", "reaction_sequence": ["rxn_001", "rxn_012", "rxn_013", "rxn_007", "rxn_014"], "key_intermediates": ["mol_008", "mol_006", "mol_023", "mol_024", "mol_016"]}, {"pathway_id": "P10", "name": "N2-discharge glycine supply followed by pyruvate transamination", "description": "N2 activation supplies the nitrogen entering glycinonitrile and glycine, while a separate CO2/H2 branch supplies pyruvate. Alum-assisted transamination then redistributes that fixed nitrogen into alanine. This differs from P9 at nitrogen fixation, not at the terminal transamination mechanism; the unresolved product includes both L- and D-alanine.", "reaction_sequence": ["rxn_002", "rxn_012", "rxn_013", "rxn_007", "rxn_014"], "key_intermediates": ["mol_003", "mol_008", "mol_006", "mol_023", "mol_024", "mol_016"]}], "hub_molecules": ["mol_001", "mol_002", "mol_003", "mol_004", "mol_006", "mol_007", "mol_008", "mol_011", "mol_012", "mol_015", "mol_016", "mol_027"], "convergence_points": [{"molecule_id": "mol_006", "incoming_reactions": ["rxn_001", "rxn_002"], "outgoing_reactions": ["rxn_004", "rxn_012", "rxn_015"]}, {"molecule_id": "mol_007", "incoming_reactions": ["rxn_001", "rxn_002", "rxn_003"], "outgoing_reactions": ["rxn_004", "rxn_015"]}, {"molecule_id": "mol_008", "incoming_reactions": ["rxn_001", "rxn_002"], "outgoing_reactions": ["rxn_012"]}, {"molecule_id": "mol_016", "incoming_reactions": ["rxn_007"], "outgoing_reactions": ["rxn_008", "rxn_009", "rxn_010", "rxn_011", "rxn_014", "rxn_017"]}, {"molecule_id": "mol_011", "incoming_reactions": ["rxn_005", "rxn_008", "rxn_009", "rxn_010", "rxn_011", "rxn_014"], "outgoing_reactions": []}, {"molecule_id": "mol_012", "incoming_reactions": ["rxn_006", "rxn_008", "rxn_009", "rxn_010", "rxn_011", "rxn_014"], "outgoing_reactions": []}, {"molecule_id": "mol_027", "incoming_reactions": ["rxn_016", "rxn_017"], "outgoing_reaction