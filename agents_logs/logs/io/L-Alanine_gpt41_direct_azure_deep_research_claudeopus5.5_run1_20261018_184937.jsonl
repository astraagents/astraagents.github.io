ed": null}, {"id": "mol_005", "formula": "HCN", "iupac_name": "hydrogen cyanide", "common_name": "hydrogen cyanide", "inchi": "InChI=1S/CN/c1-2/h1H", "role": "starting", "environment_formed": "Surface"}, {"id": "mol_006", "formula": "CH3CHO", "iupac_name": "ethanal", "common_name": "acetaldehyde", "inchi": "InChI=1S/C2H4O/c1-2-3/h2H,1H3", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_007", "formula": "HCHO", "iupac_name": "methanal", "common_name": "formaldehyde", "inchi": "InChI=1S/CH2O/c1-2/h1H2", "role": "starting", "environment_formed": "Surface"}, {"id": "mol_008", "formula": "C2H4O2", "iupac_name": "ethane-1,2-diol", "common_name": "glycolaldehyde", "inchi": "InChI=1S/C2H4O2/c3-1-2-4/h1-2,4H,3H2", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_009", "formula": "C3H6O3", "iupac_name": "2,3-dihydroxypropanal", "common_name": "glyceraldehyde", "inchi": "InChI=1S/C3H6O3/c4-1-2(5)3-6/h2,4-6H,1,3H2", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_010", "formula": "C3H6NO", "iupac_name": "2-aminopropanenitrile", "common_name": "\u03b1-aminopropionitrile", "inchi": "InChI=1S/C3H6N2/c1-2(4)3-5/h2H,1,4H2", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_011", "formula": "C2H6O", "iupac_name": "ethanol", "common_name": "ethanol", "inchi": "InChI=1S/C2H6O/c1-2-3/h3H,2H2,1H3", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_012", "formula": "C3H7NO2", "iupac_name": "(R,S)-2-aminopropanoic acid", "common_name": "racemic alanine", "inchi": "InChI=1S/C3H7NO2/c1-2(4)3(5)6/h2H,4H2,1H3,(H,5,6)", "role": "intermediate", "environment_formed": null}, {"id": "mol_013", "formula": "C3H4N2O2", "iupac_name": "imidazolidine-2,4-dione", "common_name": "hydantoin", "inchi": "InChI=1S/C3H4N2O2/c6-2-1-5-3(7)4-2/h1H2,(H2,4,5,6,7)", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_014", "formula": "C3H7NO2", "iupac_name": "(S)-2-aminopropanoic acid", "common_name": "L-alanine", "inchi": "InChI=1S/C3H7NO2/c1-2(4)3(5)6/h2H,4H2,1H3,(H,5,6)/t2-/m0/s1", "role": "target", "environment_formed": "Biochemical"}, {"id": "mol_015", "formula": "C3H8O3", "iupac_name": "propane-1,2,3-triol", "common_name": "glycerol", "inchi": "InChI=1S/C3H8O3/c4-1-3(6)2-5/h3-6H,1-2H2", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_016", "formula": "C3H8NO2S", "iupac_name": "3-mercaptopropanoic acid", "common_name": "3-mercaptopropionic acid", "inchi": "InChI=1S/C3H8O2S/c4-2-1-3(5)6/h4,6H,1-2H2,(H,5,6)", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_017", "formula": "C3H5O3", "iupac_name": "(R,S)-2-hydroxypropanoic acid", "common_name": "racemic lactate", "inchi": "InChI=1S/C3H6O3/c1-2(4)3(5)6/h2,4H,1H3,(H,5,6)", "role": "intermediate", "environment_formed": null}, {"id": "mol_018", "formula": "CH3COOH", "iupac_name": "acetic acid", "common_name": "acetate", "inchi": "InChI=1S/C2H4O2/c1-2(3)4/h1H3,(H,3,4)", "role": "intermediate", "environment_formed": "Hydrothermal"}, {"id": "mol_019", "formula": "C3H7NO2", "iupac_name": "(S)-2-aminopropanoic acid", "common_name": "delivered L-alanine", "inchi": "InChI=1S/C3H7NO2/c1-2(4)3(5)6/h2H,4H2,1H3,(H,5,6)/t2-/m0/s1", "role": "intermediate", "environment_formed": "Surface"}], "reactions": [{"id": "rxn_001", "name": "CO2 reduction and C\u2013C bond assembly to pyruvate (Ni3Fe-catalyzed)", "inputs": ["mol_001", "mol_002"], "outputs": ["mol_004", "mol_018"], "environment": "Hydrothermal", "agents": ["awaruite (Ni3Fe)"], "conditions": {"temperature": "373-373K", "pressure": "high", "catalyst": "awaruite (Ni3Fe)", "aqueous": true, "other": "alkaline, H2 present; >5 mM NH3 not required"}, "mechanism": "CO2 hydrogenation and C\u2013C coupling on awaruite; yields formate, acetate, then pyruvate at low \u00b5M concentrations.", "reasoning": "Demonstrated by Preiner et al. (2020, Nature Ecology & Evolution) and in Cody et al. (2000, Science), with awaruite mediating formation of pyruvate from CO2/H2. Pyruvate is generated in \u00b5M yields in hydrothermal conditions. Acetate is also produced as a byproduct. This provides a prebiotically plausible C3-ketoacid feedstock for amino acid synthesis. Yield is low and concentration requires local focusing (Preiner et al., 2020)."}, {"id": "rxn_002", "name": "Pyruvate reductive amination to racemic alanine (FeS/Fe(OH)2)", "inputs": ["mol_004", "mol_003"], "outputs": ["mol_012", "mol_017"], "environment": "Hydrothermal", "agents": ["FeS", "Fe(OH)2"], "conditions": {"temperature": "323-348K", "pressure": "high", "catalyst": "FeS or Fe(OH)2", "aqueous": true, "other": "alkaline (pH 9-10), high NH3 (>0.1 M for FeS route); 1:1 Fe(II):Fe(III) (green rust) for selectivity"}, "mechanism": "Nucleophilic attack of NH3 on pyruvate, forming iminopyruvate, which is reduced by the Fe(II) mineral to alanine; competing reduction to lactate.", "reasoning": "Solidly demonstrated (Huber & W\u00e4chtersh\u00e4user 2003; Barge et al. 2019, PNAS) with FeS, green rust, and Fe(OH)2 under alkaline, hydrothermal conditions. Supported by Kitadai et al. (2019, Science Advances). Selectivity is controlled by pH and Fe(II):Fe(III) ratio (Barge et al.)."}, {"id": "rxn_003", "name": "Reductive amination of pyruvate (Ni0/H2 route)", "inputs": ["mol_004", "mol_003", "mol_002"], "outputs": ["mol_012", "mol_017"], "environment": "Hydrothermal", "agents": ["Ni0", "H2"], "conditions": {"temperature": "295K", "pressure": "5 bar", "catalyst": "Ni0 (native or meteorite)", "aqueous": true, "other": "pH 7-8; can operate at only 6 mM ammonia"}, "mechanism": "Pyruvate is aminated by NH3, reduced by H2 on Ni0 to racemic alanine; lactate forms as parallel reduction.", "reasoning": "Supported by Kaur et al. (2024, Chem), who show up to 18\u201340% alanine yield with 5\u201315% lactate. The route is robust at modest NH3 concentrations, improving prebiotic plausibility. Meteorite metals also work (Aletai meteorite, Kaur et al.)."}, {"id": "rxn_004", "name": "Bucherer\u2013Bergs synthesis from pyruvate (cyanide-ammonia-CO2)", "inputs": ["mol_004", "mol_003", "mol_001", "mol_005"], "outputs": ["mol_012", "mol_013"], "environment": "Surface", "agents": [null], "conditions": {"temperature": "300-350K", "pressure": "1 atm", "catalyst": null, "aqueous": true, "other": "CO2 essential; mild aqueous pH"}, "mechanism": "Pyruvate reacts with NH3, HCN, and CO2 to form hydantoin and then undergoes ring opening to racemic alanine.", "reasoning": "Demonstrated in Pulletikurti et al. (2022, Nature Chem.), with pyruvate plus cyanide, ammonia and CO2 giving high-yield \u03b1-amino acids. The intermediate is hydantoin. The necessity of providing both pyruvate and cyanide in the same locale is a practical challenge (Pulletikurti et al, critique)."}, {"id": "rxn_005", "name": "Strecker synthesis: cyanohydrin/aldehyde pathway (classical Strecker)", "inputs": ["mol_006", "mol_003", "mol_005"], "outputs": ["mol_010"], "environment": "Surface", "agents": [null], "conditions": {"temperature": "293-333K", "pressure": "1 atm", "catalyst": null, "aqueous": true, "other": "can run on evaporitic surfaces, post-spark discharge"}, "mechanism": "Imine formation from acetaldehyde and ammonia, nucleophilic addition of HCN to imine forming \u03b1-aminopropionitrile.", "reasoning": "Classical Strecker pathway, demonstrated since Miller (1953, Science) and widely reviewed (Johnson et al. 2008, Science). Acetaldehyde can be atmospheric or photochemical in origin (Miller\u2013Urey), HCN from discharge or photo-oxidation. Cited by Patel et al. (2015, Nature Chem.), Sutherland\u2019s cyanosulfidic variants."}, {"id": "rxn_006", "name": "\u03b1-aminopropionitrile hydrolysis to racemic alanine", "inputs": ["mol_010"], "outputs": ["mol_012"], "environment": "Surface", "agents": ["montmorillonite"], "conditions": {"temperature": "298-333K", "pressure": "1 atm", "catalyst": "montmorillonite clay (optional; accelerates hydrolysis)", "aqueous": true, "other": "acidic to neutral pH; wet-dry cycling promotes hydrolysis"}, "mechanism": "Acid/base-catalyzed hydration of the nitrile followed by tautomerization and ammonia elimination to give alanine.", "reasoning": "Strecker hydrolysis step is universally demonstrated, both neat and clay-catalyzed. The reaction proceeds under plausible surface conditions. Cited by Bada (M\u00e8tode), Johnson et al. (2008), and Sutherland (2015)."}, {"id": "rxn_007", "name": "Photoreduction of HCN to acetaldehyde via cyanosulfidic protometabolism", "inputs": ["mol_005"], "outputs": ["mol_006"], "environment": "Surface", "agents": ["HS-", "Cu(I)", "UV light (254 nm)"], "conditions": {"temperature": "300-310K", "pressure": "1 atm", "catalyst": "HS-, Cu(I), UV", "aqueous": true, "other": "sulfidic water, phosphate, intense mid-UV"}, "mechanism": "Reductive homologation of HCN to C2\u2013C3 aldehydes, photochemically, mediated by copper and hydrogen sulfide.", "reasoning": "Explicitly shown in Patel et al. (2015, Nature Chem.), Ranjan et al. (arXiv), and further characterized in Sutherland's work. This provides a geochemically plausible and photochemically robust bridge between HCN-rich settings and Strecker substrates."}, {"id": "rxn_008", "name": "Formose-type condensation: formaldehyde + glycolaldehyde to glyceraldehyde", "inputs": ["mol_007", "mol_008"], "outputs": ["mol_009"], "environment": "Surface", "agents": ["Ca(OH)2", "borate"], "conditions": {"temperature": "330K", "pressure": "1 atm", "catalyst": "Ca(OH)2, borate minerals", "aqueous": true, "other": "wet-dry cycles; borate stabilizes sugars"}, "mechanism": "Aldol condensations and isomerizations of formaldehyde and glycolaldehyde, giving glyceraldehyde.", "reasoning": "Well-known prebiotic C3-sugar formation (Weber 1985, J. Mol. Evol.; also Benson & Calvin, historical). Borate minerals stabilize and steer selectivity. Provides a sugar intermediate for further chemistry. Used as input for the thiol-catalyzed pathway."}, {"id": "rxn_009", "name": "Thiol-assisted amination of glyceraldehyde to alanine (Weber route)", "inputs": ["mol_009", "mol_003", "mol_016"], "outputs": ["mol_012", "mol_017"], "environment": "Surface", "agents": ["3-mercaptopropanoic acid"], "conditions": {"temperature": "313K", "pressure": "1 atm", "catalyst": "3-mercaptopropionic acid (thiol)", "aqueous": true, "other": "mildly acidic (pH 5.2), long time (30\u201360 days)"}, "mechanism": "Glyceraldehyde dehydrates to methylglyoxal, reacts with ammonia and thiol, via hemithioacetal and imine, then to alanine and lactate.", "reasoning": "Thiol-catalyzed amino acid synthesis is demonstrated by Weber (1985, 1998); although yield is low, the route is robust and does not require HCN. Provides both alanine and lactate. The thiol must be locally available (Weber, 1998 OLEB)."}, {"id": "rxn_010", "name": "Transamination: pyruvate to alanine swap with amino acid nitrogen donor", "inputs": ["mol_004", "mol_003"], "outputs": ["mol_012", "mol_017"], "environment": "Hydrothermal", "agents": ["pyridoxal", "Fe(III)", "Al(III)"], "conditions": {"temperature": "350K", "pressure": "1 atm", "catalyst": "pyridoxal, Fe(III), Al(III)", "aqueous": true, "other": "alkaline, prebiotic pools"}, "mechanism": "Pyridoxal forms a Schiff base with amino acid, facilitating amino group transfer to pyruvate to yield alanine.", "reasoning": "Non-enzymatic transamination demonstrated with pyridoxal and metal ions (Dherbassy et al. 2023, JACS; Life 2023; Kaur et al. 2024). Boosts yield at low NH3; pyridoxal\u2019s own prebiotic synthesis is unsolved, but its catalytic properties are well established in laboratory analogs."}, {"id": "rxn_011", "name": "Extraterrestrial delivery: racemic alanine import from meteorites/parent body", "inputs": [], "outputs": ["mol_012", "mol_019"], "environment": "Surface", "agents": [null], "conditions": {"temperature": null, "pressure": null, "catalyst": null, "aqueous": false, "other": "accretion/impact delivery"}, "mechanis