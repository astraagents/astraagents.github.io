ing\": \"Documented by Pulletikurti et al. (2022, Nature Chem.): atom balance checked, CO2 required as per experiment.\"\n    },\n    {\n      \"id\": \"rxn_010\",\n      \"name\": \"Hydantoin hydrolysis to L-alanine\",\n      \"inputs\": [\"mol_016\", \"mol_005\"],\n      \"outputs\": [\"mol_006\", \"mol_001\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300-350K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"hydrolytic conditions\"\n      },\n      \"mechanism\": \"Hydantoin ring opens and hydrolyzes to alanine, CO2 released.\",\n      \"reasoning\": \"Classic Bucherer\u2013Bergs amination route (Pulletikurti et al. 2022); atom balance verified.\"\n    },\n    {\n      \"id\": \"rxn_011\",\n      \"name\": \"Reductive amination of pyruvate with hydroxylamine on Fe0\",\n      \"inputs\": [\"mol_003\", \"mol_018\"],\n      \"outputs\": [\"mol_006\", \"mol_007\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"native Fe0\"],\n      \"conditions\": {\n        \"temperature\": \"298-320K\",\n        \"pressure\": \"moderate\",\n        \"catalyst\": \"Fe0\",\n        \"aqueous\": true,\n        \"other\": \"mildly acidic to neutral\"\n      },\n      \"mechanism\": \"Pyruvate forms an oxime with hydroxylamine, then is reduced by Fe0 to alanine and competing lactate.\",\n      \"reasoning\": \"Muchowska et al. (2019, Nature); Fe0 as reductant, yields multiple amino acids, atom balance included.\"\n    },\n    {\n      \"id\": \"rxn_012\",\n      \"name\": \"Transamination: Aspartate + pyruvate yields alanine\",\n      \"inputs\": [\"mol_019\", \"mol_003\"],\n      \"outputs\": [\"mol_006\", \"mol_001\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\"pyridoxal\", \"Fe(III)\", \"Al(III)\"],\n      \"conditions\": {\n        \"temperature\": \"300-350K\",\n        \"pressure\": \"1 atm\",\n     