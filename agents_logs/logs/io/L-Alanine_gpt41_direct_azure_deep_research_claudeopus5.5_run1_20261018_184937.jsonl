\": \"mol_012\",\n      \"formula\": \"C2H4O2\",\n      \"iupac_name\": \"glycolaldehyde\",\n      \"common_name\": \"glycolaldehyde\",\n      \"inchi\": \"InChI=1S/C2H4O2/c3-1-2-4/h1-2,4H,1-2H2\",\n      \"role\": \"starting\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_013\",\n      \"formula\": \"C3H6O3S\",\n      \"iupac_name\": \"3-mercaptopropanoic acid\",\n      \"common_name\": \"3-mercaptopropionic acid\",\n      \"inchi\": \"InChI=1S/C3H6O2S/c4-2-1-3(5)6/h6H,1-2H2,(H,4,5)\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_014\",\n      \"formula\": \"C3H6O3\",\n      \"iupac_name\": \"glyceraldehyde\",\n      \"common_name\": \"glyceraldehyde\",\n      \"inchi\": \"InChI=1S/C3H6O3/c1-2(4)3(5)6/h2,4H,1H3,(H,5,6)\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_015\",\n      \"formula\": \"CO\",\n      \"iupac_name\": \"carbon monoxide\",\n      \"common_name\": \"carbon monoxide\",\n      \"inchi\": \"InChI=1S/CO/c1-2\",\n      \"role\": \"starting\",\n      \"environment_formed\": \"Hydrothermal\"\n    },\n    {\n      \"id\": \"mol_016\",\n      \"formula\": \"C3H4O2N2\",\n      \"iupac_name\": \"hydantoin\",\n      \"common_name\": \"hydantoin\",\n      \"inchi\": \"InChI=1S/C3H4N2O2/c4-1-2(6)5-3(7)8-2/h1,4H2\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Biochemical\"\n    },\n    {\n      \"id\": \"mol_017\",\n      \"formula\": \"C2H5NO2\",\n      \"iupac_name\": \"2-aminoacetic acid\",\n      \"common_name\": \"glycine\",\n      \"inchi\": \"InChI=1S/C2H5NO2/c3-1-2(4)5/h1,3H2,(H,4,5)\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_018\",\n      \"formula\": \"NH2OH\",\n      \"iupac_name\": \"hydroxylamine\",\n      \"common_name\": \"hydroxylamine\",\n      \"inchi\": \"InChI=1S/H3NO/c2-1/h2H,1H2\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_019\",\n      \"formula\": \"Asp\",\n      \"iupac_name\": \"(S)-2-aminosuccinic acid\",\n      \"common_name\": \"L-aspartic acid\",\n      \"inchi\": \"InChI=1S/C4H7NO4/c5-2-1-3(6)4(7)8/h1-2H2,5H2,(H,6,7,8)/t2-/m0/s1\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Biochemical\"\n    }\n  ],\n  \"reactions\": [\n    {\n      \"id\": \"rxn_001\",\n      \"name\": \"CO2 reduction with H2 to pyruvate via mineral catalysis\",\n      \"inputs\": [\"mol_001\", \"mol_002\"],\n      \"outputs\": [\"mol_003\", \"mol_005\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"greigite (Fe3S4)\", \"magnetite (Fe3O4)\", \"awaruite (Ni3Fe)\"],\n      \"conditions\": {\n        \"temperature\": \"370-400K\",\n        \"pressure\": \"high\",\n        \"catalyst\": \"iron-nickel-sulfur minerals\",\n        \"aqueous\": true,\n        \"other\": \"alkaline, reducing, H2-rich\"\n      },\n      \"mechanism\": \"CO2 is reduced via sequential reactions with H2 on Fe-Ni sulfide surfaces, affording pyruvate and water.\",\n      \"reasoning\": \"This step is based on Preiner et al. (2020, Nature Ecol. Evol.), Cody et al. (2000, Science), with yields of ~10 \u03bcM pyruvate from CO2/H2; atom balance holds as the corresponding H2O is also produced. Thermodynamically favored in H2-rich vents (Amend & Shock 1998).\"\n    },\n    {\n      \"id\": \"rxn_002\",\n      \"name\": \"Reductive amination of pyruvate with ammonia to alanine\",\n      \"inputs\": [\"mol_003\", \"mol_004\", \"mol_002\"],\n      \"outputs\": [\"mol_006\", \"mol_005\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"mixed-valence iron hydroxide (green rust)\"],\n      \"conditions\": {\n        \"temperature\": \"320-370K\",\n        \"pressure\": \"moderate\",\n        \"catalyst\": \"Fe(II)/Fe(III) hydroxide\",\n        \"aqueous\": true,\n        \"other\": \"alkaline pH 10, 1:1 Fe(II):Fe(III)\"\n      },\n      \"mechanism\": \"Pyruvate reacts with ammonia, accepting two electrons and two protons (from H2 or mineral), yielding alanine and water.\",\n      \"reasoning\": \"Barge et al. (2019, PNAS); high-yield amination at pH 10, 70\u00b0C, green rust as redox shuttle. Mass and charge are conserved (pyruvate + NH3 + H2 \u2192 alanine + H2O).\"\n    },\n    {\n      \"id\": \"rxn_003\",\n      \"name\": \"Pyruvate reduction to lactate (competing)\",\n      \"inputs\": [\"mol_003\", \"mol_002\"],\n      \"outputs\": [\"mol_007\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"FeS\", \"H2\"],\n      \"conditions\": {\n        \"temperature\": \"320-370K\",\n        \"pressure\": \"moderate\",\n        \"catalyst\": \"FeS\",\n        \"aqueous\": true,\n        \"other\": \"pH \u22649\"\n      },\n      \"mechanism\": \"Pyruvate is reduced by H2 (on FeS) to form lactate.\",\n      \"reasoning\": \"Competing reduction observed in all Fe/Ni hydrothermal amination experiments (Kaur 2024, Barge 2019, Kitadai 2019). Must be tracked for atom balance and selectivity.\"\n    },\n    {\n      \"id\": \"rxn_004\",\n      \"name\": \"Acetaldehyde synthesis from glycolaldehyde (homologation)\",\n      \"inputs\": [\"mol_012\"],\n      \"outputs\": [\"mol_008\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"basic/alkaline solution\", \"UV radiation\"],\n      \"conditions\": {\n        \"temperature\": \"300-320K\",\n        \"pressure\": \"ambient\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"UV or mineral-catalyzed isomerization\"\n      },\n      \"mechanism\": \"Glycolaldehyde undergoes isomerization/dehydration to acetaldehyde.\",\n      \"reasoning\": \"Cyanosulfidic (Patel et al. 2015, Nature Chem.) and classic surface photoprocesses (Sutherland, Weber 1998); supported as a prebiotic C2\u2013C3 building step.\"\n    },\n    {\n      \"id\": \"rxn_005\",\n      \"name\": \"Strecker condensation: acetaldehyde + HCN + ammonia to alanine aminonitrile\",\n      \"inputs\": [\"mol_008\", \"mol_009\", \"mol_004\"],\n      \"outputs\": [\"mol_010\", \"mol_005\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300-330K\",\n        \"pressure\": \"ambient\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"ambient to slightly alkaline pH\"\n      },\n      \"mechanism\": \"Acetaldehyde and ammonia form imine; HCN adds to make \u03b1-aminopropionitrile, with water as byproduct.\",\n      \"reasoning\": \"Strecker synthesis: classic lab and Miller-Urey chemistry (Miller 1953, Science, Cleaves 2008). Atom balanced, verified by isotope studies (Chimiak 2020).\"\n    },\n    {\n      \"id\": \"rxn_006\",\n      \"name\": \"Hydrolysis of alanine aminonitrile to alanine\",\n      \"inputs\": [\"mol_010\", \"mol_005\"],\n      \"outputs\": [\"mol_006\", \"mol_004\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300-360K\",\n        \"pressure\": \"ambient\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"acidic, neutral, or mildly basic\"\n      },\n      \"mechanism\": \"Aminonitrile hydrolyzed through amide to the amino acid, with ammonia released.\",\n      \"reasoning\": \"Follows Strecker route (Patel 2015, Sutherland school), atom balanced (aminonitrile + H2O \u2192 alanine + NH3).\"\n    },\n    {\n      \"id\": \"rxn_007\",\n      \"name\": \"Formose reaction: formaldehyde + glycolaldehyde to glyceraldehyde\",\n      \"inputs\": [\"mol_011\", \"mol_012\"],\n      \"outputs\": [\"mol_014\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"montmorillonite\"],\n      \"conditions\": {\n        \"temperature\": \"310-340K\",\n        \"pressure\": \"ambient\",\n        \"catalyst\": \"clay minerals\",\n        \"a