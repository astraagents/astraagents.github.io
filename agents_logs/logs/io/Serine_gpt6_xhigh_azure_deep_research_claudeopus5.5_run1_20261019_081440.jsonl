      \"common_name\": \"Carbonate ion\",\n      \"inchi\": null,\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_026\",\n      \"formula\": \"FeCO3\",\n      \"iupac_name\": \"Iron(II) carbonate\",\n      \"common_name\": \"Siderite\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_027\",\n      \"formula\": \"C2H4O\",\n      \"iupac_name\": \"Ethanal\",\n      \"common_name\": \"Acetaldehyde\",\n      \"inchi\": \"InChI=1S/C2H4O/c1-2-3/h2H,1H3\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_028\",\n      \"formula\": \"C4H9NO4\",\n      \"iupac_name\": \"2-Amino-3-hydroxy-2-(hydroxymethyl)propanoic acid\",\n      \"common_name\": \"Alpha-(hydroxymethyl)serine\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_029\",\n      \"formula\": \"C3H4O3\",\n      \"iupac_name\": \"2-Oxopropanoic acid\",\n      \"common_name\": \"Pyruvic acid\",\n      \"inchi\": \"InChI=1S/C3H4O3/c1-2(4)3(5)6/h1H3,(H,5,6)\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Hydrothermal\"\n    },\n    {\n      \"id\": \"mol_030\",\n      \"formula\": \"C3H5NO2\",\n      \"iupac_name\": \"2,3-Dihydroxypropanenitrile\",\n      \"common_name\": \"Glyceronitrile\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_031\",\n      \"formula\": \"CH3NO\",\n      \"iupac_name\": \"N-Hydroxymethanimine\",\n      \"common_name\": \"Formaldoxime\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    }\n  ],\n  \"reactions\": [\n    {\n      \"id\": \"rxn_001\",\n      \"name\": \"Cyanohydrin formation supplying glycolonitrile\",\n      \"inputs\": [\"mol_001\", \"mol_002\"],\n      \"outputs\": [\"mol_006\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-313 K\",\n        \"pressure\": \"Approximately 1 bar, anoxic headspace\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Proposed feed preparation: 10-30 mM total formaldehyde and approximately equimolar total cyanide, pH 7-9, sampled over 1-24 h. Use a shaded, partially enclosed pool or pore reservoir to limit HCN escape. These concentrations require local concentration and are not estimates of an early ocean.\"\n      },\n      \"mechanism\": \"Reversible cyanide addition to formaldehyde followed by proton transfer. Balanced equation: CH2O + HCN -> C2H3NO. Hydrated formaldehyde is in equilibrium with the reactive carbonyl.\",\n      \"reasoning\": \"Glycolonitrile is the experimentally used substrate in reductive homologation (Ritson and Sutherland, 2013; Patel et al., 2015). Cyanohydrin formation is chemically established, but the proposed preparation window and retention efficiency are not quantified by the supplied report. HCN availability and volatility remain environmental constraints.\"\n    },\n    {\n      \"id\": \"rxn_002\",\n      \"name\": \"Copper-assisted cyanosulfidic reduction to glycolaldehyde\",\n      \"inputs\": [\"mol_006\", \"mol_005\", \"mol_004\"],\n      \"outputs\": [\"mol_007\", \"mol_003\", \"mol_008\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Copper(I) cyanide and dissolved cyanocuprate photoredox species\"],\n      \"conditions\": {\n        \"temperature\": \"Ambient laboratory temperature; proposed deployment 300-303 K\",\n        \"pressure\": \"Approximately 1 bar, anoxic\",\n        \"catalyst\": \"CuCN, 10 mol% relative to glycolonitrile in the reported experiment\",\n        \"aqueous\": true,\n        \"other\": \"Reported reference mixture: 10 mM glycolonitrile, 30 mM H2S, 33 mM sodium phosphate, pH 7, 254 nm irradiation for 2 h. The provided record does not specify irradiance, so the laboratory time must not be converted directly to a solar exposure time. Proposed setting: optically shallow water, followed by drainage into a shaded mineral pore zone that retains suspended CuCN. Measure aldehyde recovery across this transfer.\"\n      },\n      \"mechanism\": \"Photoinduced electron transfer reduces the nitrile to an imine, which hydrolyzes to glycolaldehyde. Formal redox closure: 8 C2H3NO + 8 H2S + 8 H2O -> 8 C2H4O2 + 8 NH3 + S8. Elemental sulfur represents a possible oxidized sulfur pool rather than an exclusive measured product.\",\n      \"reasoning\": \"Ritson and Sutherland (2013) reported 42% glycolaldehyde hydrate after 2 h under the stated reference conditions. The active copper speciation is cyanide-dependent; generic iron sulfides are not substituted for the demonstrated catalyst. Further irradiation destroys glycolaldehyde, represented by rxn_021. Sulfide supply, copper availability and photon exposure are local constraints (Patel et al., 2015; Ranjan et al., 2018). No quantitative transfer recovery is established.\"\n    },\n    {\n      \"id\": \"rxn_003\",\n      \"name\": \"Copper-free cyanosulfidic reduction to glycolaldehyde\",\n      \"inputs\": [\"mol_006\", \"mol_005\", \"mol_004\"],\n      \"outputs\": [\"mol_007\", \"mol_003\", \"mol_008\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-313 K, proposed screening range\",\n        \"pressure\": \"Approximately 1 bar, anoxic\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Proposed matched comparison: 10 mM glycolonitrile, 30 mM total sulfide, 33 mM phosphate, pH 7, 254 nm irradiation without added copper. Sample over 0.5-12 h at measured photon fluence. This sampling interval is not a demonstrated productive window. Stop irradiation at the measured glycolaldehyde maximum and transfer into shade.\"\n      },\n      \"mechanism\": \"Sulfide-driven photochemical reduction without the copper accelerator, followed by imine hydrolysis. Formal closure: 8 C2H3NO + 8 H2S + 8 H2O -> 8 C2H4O2 + 8 NH3 + S8. Sulfur speciation requires measurement.\",\n      \"reasoning\": \"Copper-free reduction is supported, rather than merely conjectured, by the chemistry discussed in Ritson and Sutherland (2013). However, its slower rate means that neither the copper-assisted 42% yield nor its 2 h optimum can be assigned to this branch. Its usable photon-dose window, aldehyde recovery and sulfur balance remain unmeasured in the supplied evidence.\"\n    },\n    {\n      \"id\": \"rxn_004\",\n      \"name\": \"Cyanosulfitic photoreduction with glycolaldehyde trapping\",\n      \"inputs\": [\"mol_006\", \"mol_009\", \"mol_004\"],\n      \"outputs\": [\"mol_011\", \"mol_003\", \"mol_010\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Ferrocyanide, [Fe(CN)6]4-, as a photochemical electron-source mediator\"],\n      \"conditions\": {\n        \"temperature\": \"300-313 K, proposed deployment range\",\n        \"pressure\": \"Approximately 1 bar, anoxic\",\n        \"catalyst\": \"Ferrocyanide; proposed screening concentration 0.1-1 mM\",\n        \"aqueous\": true,\n        \"other\": \"Proposed reconstruction: 10 mM glycolonitrile, 30-100 mM total sulfite plus bisulfite, 10-30 mM phosphate, pH 7-8, 254 nm UV. These concentrations are proposed, not extracted experimental values. The cited experiment reports a 1 h result; photon fluence and exact original formulation must be checked before replication. Ferrocyanide contains Fe(II) and does not require an oxygenated environment.\"\n      },\n      \"mechanism\": \"Photogenerated reducing equivalents reduce the nitrile; bisulfite traps the aldehyde. One balanced formal closure is C2H3NO + 3 HSO3- + H2O -> C2H5O5S- + NH3 + S2O6^2-. Dithionate represents sulfite-radical recombination; the actual sulfur-product distribution may also contain other species.\",\n      \"reasoning\": \"Xu et al. (2018) reported 68% total reduced products after 1 h, divided into 40% glyceronitrile and 28% glycolaldehyde-sulfite adduct. This is not 68% free or recoverable glycolaldehyde. The graph therefore retains the trapped species explicitly and requires rxn_005 before Strecker conversion. Dithionate is a provisional balanced endpoint, not a claimed quantitative coproduct.\"\n    },\n    {\n      \"id\": \"rxn_005\",\n      \"name\": \"Equilibrium release of glycolaldehyde from its bisulfite adduct\",\n      \"inputs\": [\"mol_011\"],\n      \"outputs\": [\"mol_007\", \"mol_009\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-313 K, proposed\",\n        \"pressure\": \"Approximately 1 bar, anoxic\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Proposed shaded mixing zone: pH 7.5-9, 0.1-5 mM adduct, monitored over 1 h to 14 days. Couple release to aldehyde capture in rxn_006 rather than assume quantitative deprotection. Measure free aldehyde, remaining adduct and total S(IV). No separation efficiency or recoverable aldehyde yield is assigned.\"\n      },\n      \"mechanism\": \"Reversible cleavage of the carbon-sulfur bond in the carbonyl-bisulfite addition product. Balanced equation: C2H5O5S- -> C2H4O2 + HSO3-. Forward flux requires an equilibrium shift or downstream consumption of free aldehyde.\",\n      \"reasoning\": \"Xu et al. (2018) establish the trapped reduced product, not an end-to-end adduct-to-serine sequence. Carbonyl-bisulfite dissociation is chemically plausible, but productive release under this proposed mixing window is an unvalidated integration step. Residual sulfite can recapture aldehyde and interfere with imine chemistry; this branch is blocked if capture does not outcompete retrapping.\"\n    },\n    {\n      \"id\": \"rxn_006\",\n      \"name\": \"Glycolaldehyde Strecker conversion to serine aminonitrile\",\n      \"inputs\": [\"mol_007\", \"mol_002\", \"mol_003\"],\n      \"outputs\": [\"mol_012\", \"mol_004\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-313 K\",\n        \"pressure\": \"Approximately 1 bar, anoxic\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Proposed dark reaction zone: 1-10 mM glycolaldehyde, 1-2 equivalents total cyanide, 5-20 equivalents total ammonia, pH 8-9.5. Sample over 1-28 days, consistent with the reported days-to-weeks timescale but not a replicated yield. End UV exposure before adding the nitrogen/cyanide capture mixture. Quantify free aldehyde, cyanohydrin, aminonitrile and losses in each transferred matrix.\"\n      },\n      \"mechanism\": \"Ammonia addition and dehydration generate an imine or iminium species, followed by cyanide addition. Balanced equation: C2H4O2 + HCN + NH3 -> C3H6N2O + H2O. Achiral conditions give racemic aminonitrile.\",\n      \"reasoning\": \"This serine-specific transformation has strong component-level support (Ritson and Sutherland, 2013; Patel et al., 2015; Foden et al., 2020). Foden et al. describe excellent aminonitrile yield, but the supplied report does not provide a numerical value. That statement is not a free-serine yield. Excess ammonia favors Strecker capture over the competing cyanohydrin channel rxn_025; sulfite-containing inputs require separate compatibility measurements.\"\n    },\n    {\n      \"id\": \"rxn_007\",\n      \"name\": \"Acid-promoted hydration of serine aminonitrile\",\n      \"inputs\": [\"mol_012\", \"mol_004\"],\n      \"outputs\": [\"mol_013\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Hydron catalysis supplied by nonoxidizing volcanic acidity\"],\n      \"conditions\": {\n        \"temperature\": \"353-370 K, proposed screening range\",\n        \"pressure\": \"Approximately 1 bar\",\n        \"catalyst\": \"Aqueous acid; proposed 0.1-1 M acid equivalents\",\n        \"aqueous\": true,\n        \"other\": \"Proposed shaded, volcanic-HCl-fed brine containing 1-10 mM aminonitrile. Screen 1-30 days and distinguish aminonitrile loss from serinamide formation. The acid inventory and residence time are environmental requirements, not established properties of typical prebiotic pools. Counterions and rapid protonation equilibria are omitted from the neutral-parent equation.\"\n      },\n      \"mechanism\": \"Nitrile protonation, water addition and tautomerization produce the primary amide. Balanced parent-species equation: C3H6N2O + H2O -> C3H8N2O2.\",\n      \"reasoning\": \"Hydrolysis is the conventional Strecker terminus, but the cited serine studies primarily establish aminonitrile chemistry (Ritson and Sutherland, 2013; Foden et al., 2020). The stated acid concentration, temperature and time constitute an unvalidated environmental implementation, not a published serinamide yield. Direct measurement is necessary because serine-related intermediates can undergo competing decomposition.\"\n    },\n    {\n      \"id\": \"rxn_008\",\n      \"name\": \"Acid-promoted serinamide cleavage to free serine\",\n      \"inputs\": [\"mol_013\", \"mol_004\"],\n      \"outputs\": [\"mol_014\", \"mol_003\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Hydron catalysis\"],\n      \"conditions\": {\n        \"temperature\": \"353-370 K, proposed; cool below 310 K after productive conversion\",\n        \"pressure\": \"Approximately 1 bar\",\n        \"catalyst\": \"Aqueous acid; proposed 0.1-1 M acid equivalents\",\n        \"aqueous\": true,\n        \"other\": \"Continue the acid branch only while free-serine formation exceeds destruction; proposed sampling spans 1-30 days. Quantify serinamide, free serine and degradation products separately. Cooling and dilution into a less acidic shaded reservoir are physical operations with unmeasured recovery, not additional synthetic reactions.\"\n      },\n      \"mechanism\": \"Acid-promoted amide hydrolysis liberates the carboxylic acid and ammonium. Balanced neutral-parent equation: C3H8N2O2 + H2O -> C3H7NO3 + NH3.\",\n      \"reasoning\": \"General Strecker hydrolysis supports the transformation, but the supplied serine-nitrile literature does not establish its rate or isolated serine yield in this proposed mild-temperature acid brine (Ritson and Sutherland, 2013; Foden et al., 2020). This is a key unvalidated bottleneck, not an assumed quantitative workup. Thermal-loss evidence requires limiting hot residence time (Aubrey et al., 2009; Sato et al., 2004).\"\n    },\n    {\n      \"id\": \"rxn_009\",\n      \"name\": \"Base-promoted hydration of serine aminonitrile\",\n      \"inputs\": [\"mol_012\", \"mol_004\"],\n      \"outputs\": [\"mol_013\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Hydroxide in strongly alkaline water\"],\n      \"conditions\": {\n        \"temperature\": \"353-370 K, proposed screening range\",\n        \"pressure\": \"Approximately 1 bar\",\n        \"catalyst\": \"Hydroxide; proposed activity-equivalent concentration 0.01-0.03 M\",\n        \"aqueous\": true,\n        \"other\": \"Proposed strongly alkaline Ca-silicate alteration pool, potentially supplied by portlandite-bearing material; 1-10 mM aminonitrile, sampled for 1-30 days. Measure hydroxide activity at reaction temperature rather than equate it with a room-temperature pH. Such alkalinity is a restrictive local condition, not an assumed property of all alkaline vents.\"\n      },\n      \"mechanism\": \"Hydroxide addition to the nitrile gives an imidate-derived intermediate that protonates and tautomerizes to the amide. Balanced parent-species equation: C3H6N2O + H2O -> C3H8N2O2.\",\n      \"reasoning\": \"This is a chemically conventional alternative hydrolysis mechanism, but no serine-specific productive rate under these conditions is supplied by Ritson and Sutherland (2013) or Foden et al. (2020). The environmental implementation is therefore explicitly speculative. It is retained as an operational alternative to acid hydrolysis, not as independent evidence that free serine accumulates.\"\n    },\n    {\n      \"id\": \"rxn_010\",\n      \"name\": \"Base-promoted serinamide cleavage and serine recovery\",\n      \"inputs\": [\"mol_013\", \"mol_004\"],\n      \"outputs\": [\"mol_014\", \"mol_003\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Hydroxide in strongly alkaline water\"],\n      \"conditions\": {\n        \"temperature\": \"353-370 K, proposed; subsequent cooling below 310 K\",\n        \"pressure\": \"Approximately 1 bar\",\n        \"catalyst\": \"Hydroxide; proposed activity-equivalent concentration 0.01-0.03 M\",\n        \"aqueous\": true,\n        \"other\": \"Proposed 1-30 day screen in the alkaline pool. Carboxylate is the immediate aqueous product; the target node denotes the neutral-parent serine inventory. Cool and mix with CO2-bearing water after the measured product maximum. Determine serine retention during neutralization and any carbonate precipitation.\"\n      },\n      \"mechanism\": \"Hydroxide-mediated acyl substitution cleaves the amide. Balanced neutral-parent equation: C3H8N2O2 + H2O -> C3H7NO3 + NH3. At reaction pH the product is predominantly serinate, with acid-base adjustment implicit.\",\n      \"reasoning\": \"The chemical transformation is conventional, but a useful serine yield at the proposed hydroxide activity and temperature is not established in the supplied evidence. The branch must be tested against amide persistence and serine destruction; neutralization is not evidence of successful recovery (Aubrey et al., 2009; Sato et al., 2004). It is an unvalidated implementation rather than a literature-reported complete pathway.\"\n    },\n    {\n      \"id\": \"rxn_011\",\n      \"name\": \"Formaldehyde Strecker conversion to aminoacetonitrile\",\n      \"inputs\": [\"mol_001\", \"mol_002\", \"mol_003\"],\n      \"outputs\": [\"mol_015\", \"mol_004\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-313 K\",\n        \"pressure\": \"Approximately 1 bar, anoxic\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Proposed shaded pool: 10 mM total formaldehyde, 10-20 mM total cyanide, 50-200 mM total ammonia, pH 8-9.5, sampled over 1-28 days. Glycolonitrile and other formaldehyde-ammonia products must be quantified rather than assumed absent.\"\n      },\n      \"mechanism\": \"Imine formation followed by cyanide capture. Balanced equation: CH2O + HCN + NH3 -> C2H4N2 + H2O.\",\n      \"reasoning\": \"Formaldehyde-to-glycine-aminonitrile chemistry is part of the demonstrated Strecker product suite (Ritson and Sutherland, 2013; Patel et al., 2015). The numerical formulation here is a proposed operating window. Subsequent glycine recovery and removal of residual cyanide are additional requirements before copper-mediated hydroxymethylation.\"\n    },\n    {\n      \"id\": \"rxn_012\",\n      \"name\": \"Acid-promoted aminoacetonitrile hydration\",\n      \"inputs\": [\"mol_015\", \"mol_004\"],\n      \"outputs\": [\"mol_016\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Hydron catalysis\"],\n      \"conditions\": {\n        \"temperature\": \"353-370 K, proposed\",\n        \"pressure\": \"Approximately 1 bar\",\n        \"catalyst\": \"Aqueous acid; proposed 0.1-1 M acid equivalents\",\n        \"aqueous\": true,\n        \"other\": \"Proposed 1-10 mM aminoacetonitrile in a shaded acidic geothermal brine. Sample for 1-30 days. Resolve glycinamide from glycine analytically; aminonitrile disappearance alone does not establish usable glycine production.\"\n      },\n      \"mechanism\": \"Acid-promoted nitrile hydration. Balanced equation: C2H4N2 + H2O -> C2H6N2O.\",\n      \"reasoning\": \"This is the standard amide intermediate of Strecker hydrolysis, compatible with the glycine precursor chemistry in Ritson and Sutherland (2013) and Patel et al. (2015). The provided report does not give a rate for this particular acid window, so the environmental residence time remains unvalidated.\"\n    },\n    {\n      \"id\": \"rxn_013\",\n      \"name\": \"Acid-promoted glycinamide hydrolysis\",\n      \"inputs\": [\"mol_016\", \"mol_004\"],\n      \"outputs\": [\"mol_017\", \"mol_003\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Hydron catalysis\"],\n      \"conditions\": {\n        \"temperature\": \"353-370 K, proposed; cool before copper chemistry\",\n        \"pressure\": \"Approximately 1 bar\",\n        \"catalyst\": \"Aqueous acid; proposed 0.1-1 M acid equivalents\",\n        \"aqueous\": true,\n        \"other\": \"Proposed 1-30 day screen. Before rxn_020, acidic gas exchange can lower residual HCN, followed by mixing with alkaline water. Neither cyanide removal nor glycine retention is assumed quantitative. Require measured residual total cyanide below 1% of the intended total copper concentration.\"\n      },\n      \"mechanism\": \"Amide hydrolysis. Balanced neutral-parent equation: C2H6N2O + H2O -> C2H5NO2 + NH3.\",\n      \"reasoning\": \"Conventional Strecker chemistry supports glycine formation, but the rate and recovery under the stated deployment conditions are not supplied by the cited cyanosulfidic studies (Ritson and Sutherland, 2013; Patel et al., 2015). The cyanide carryover criterion is a proposed compatibility gate, not a demonstrated cleanup yield.\"\n    },\n    {\n      \"id\": \"rxn_014\",\n      \"name\": \"Base-promoted aminoacetonitrile hydration\",\n      \"inputs\": [\"mol_015\", \"mol_004\"],\n      \"outputs\": [\"mol_016\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Hydroxide in strongly alkaline water\"],\n      \"conditions\": {\n        \"temperature\": \"353-370 K, proposed\",\n        \"pressure\": \"Approximately 1 bar\",\n        \"catalyst\": \"Hydroxide; proposed activity-equivalent concentration 0.01-0.03 M\",\n        \"aqueous\": true,\n        \"other\": \"Proposed 1-10 mM aminoacetonitrile in a strongly alkaline alteration pool, sampled for 1-30 days. Measure alkalinity and hydroxide activity at reaction temperature. This is not assigned the acid-branch rate.\"\n      },\n      \"mechanism\": \"Hydroxide addition to the nitrile followed by proton transfer gives glycinamide. Balanced equation: C2H4N2 + H2O -> C2H6N2O.\",\n      \"reasoning\": \"This is an alternative standard hydrolysis mechanism, not a demonstrated environmental rate law. Ritson and Sutherland (2013) and Patel et al. (2015) support the aminoacetonitrile precursor; the proposed alkaline hydration window remains to be validated.\"\n    },\n    {\n      \"id\": \"rxn_015\",\n      \"name\": \"Base-promoted glycinamide hydrolysis\",\n      \"inputs\": [\"mol_016\", \"mol_004\"],\n      \"outputs\": [\"mol_017\", \"mol_003\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Hydroxide in strongly alkaline water\"],\n      \"conditions\": {\n        \"temperature\": \"353-370 K, proposed; subsequent cooling below 310 K\",\n        \"pressure\": \"Approximately 1 bar\",\n        \"catalyst\": \"Hydroxide; proposed activity-equivalent concentration 0.01-0.03 M\",\n        \"aqueous\": true,\n        \"other\": \"Proposed 1-30 day screen. Cool and adjust alkalinity before rxn_020. Residual cyanide must be measured and meet the same copper-compatibility gate as the acid branch; alkaline hydrolysis does not itself demonstrate cyanide removal.\"\n      },\n      \"mechanism\": \"Base-promoted amide cleavage gives glycinate and ammonia. Balanced neutral-parent equation: C2H6N2O + H2O -> C2H5NO2 + NH3.\",\n      \"reasoning\": \"The parent transformation is conventional, but the supplied literature does not establish glycine recovery or catalyst-compatible handoff under this proposed alkaline window (Ritson and Sutherland, 2013; Patel et al., 2015). This branch remains conditional even though its atom balance is straightforward.\"\n    },\n    {\n      \"id\": \"rxn_016\",\n      \"name\": \"Nickel-catalyzed reductive amination of glyoxylate to glycine\",\n      \"inputs\": [\"mol_018\", \"mol_003\", \"mol_019\"],\n      \"outputs\": [\"mol_017\", \"mol_004\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\"Ni(0) on silica-alumina, the experimentally supported catalyst analog\"],\n      \"conditions\": {\n        \"temperature\": \"295 K, corresponding to the reported 22 degrees C\",\n        \"pressure\": \"5 bar H2 in the reference reaction; total pressure includes solvent vapor and other gases\",\n        \"catalyst\": \"Supported Ni(0); proposed catalyst-loading screen 1-10 g/L\",\n        \"aqueous\": true,\n        \"other\": \"Reported anchors: pH 8, 72 h, 5 equivalents NH4HCO3 and 5 bar H2. A 10 mM glyoxylate feed and the catalyst-loading range are proposed because their original values are not provided in the research summary. Physical analog: a cool, confined pore-water reservoir supplied with serpentinization-derived H2. Before rxn_020, retain nickel grains in the source bed, depressurize into an anoxic shaded basin, and assay particle carryover and dissolved nickel. Proposed gates: no detectable reactive Ni particles, H2 partial pressure below 0.001 bar, and dissolved Ni below 1% of intended total Cu.\"\n      },\n      \"mechanism\": \"Ammonia condenses with glyoxylate and the resulting imine is hydrogenated on Ni(0). Balanced equation: C2H2O3 + NH3 + H2 -> C2H5NO2 + H2O.\",\n      \"reasoning\": \"Glyoxylate-to-glycine reduction is directly within the substrate scope reported by Kaur et al. (2024). That study is not evidence for hydroxypyruvate-to-serine conversion. The engineered supported catalyst has no demonstrated identical natural counterpart, and the proposed nickel-retention and degassing gates have no established recovery yield. The downstream sequence is therefore supported at the component level but not validated end to end.\"\n    },\n    {\n      \"id\": \"rxn_017\",\n      \"name\": \"Glyoxylate oxime formation\",\n      \"inputs\": [\"mol_018\", \"mol_020\"],\n      \"outputs\": [\"mol_021\", \"mol_004\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-323 K, proposed\",\n        \"pressure\": \"Approximately 1 bar, anoxic\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Proposed shaded acidic pool: 10 mM glyoxylate, 8-9 mM hydroxylamine, pH 4-6, sampled for 1-24 h. Hydroxylamine is deliberately limiting. Its prebiotic supply is not established by this network. Require measured residual free hydroxylamine below 1 micromolar before formaldehyde is introduced downstream.\"\n      },\n      \"mechanism\": \"Carbonyl condensation with hydroxylamine. Balanced equation: C2H2O3 + H3NO -> C2H3NO3 + H2O.\",\n      \"reasoning\": \"The oxime-mediated interpretation is consistent with Fe(0)/hydroxylamine amino-acid production reported by Muchowska, Varma and Moran (2019). The isolated oxime operation and numerical conditions here are a mechanistic implementation, not a separately established environmental sequence. Limiting hydroxylamine reduces a known compatibility problem but does not prove its complete exhaustion.\"\n    },\n    {\n      \"id\": \"rxn_018\",\n      \"name\": \"Stoichiometric iron reduction of glyoxylate oxime\",\n      \"inputs\": [\"mol_021\", \"mol_022\", \"mol_023\"],\n      \"outputs\": [\"mol_017\", \"mol_024\", \"mol_004\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"323-343 K, proposed screening range\",\n        \"pressure\": \"Approximately 1 bar, anoxic; vent evolved gases without introducing oxygen\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Proposed pH 4-6, 1-10 mM oxime, 2-4 equivalents reactive Fe(0), sampled over 1-72 h. An acid feed must supply at least four proton equivalents per converted oxime while maintaining pH. Fe(0) is consumed, not called a catalyst. Retain solid iron grains in the source bed; direct transfer to Cu(II) chemistry is disallowed until iron and hydroxylamine compatibility criteria are met.\"\n      },\n      \"mechanism\": \"Reductive N-O cleavage and C=N reduction consume four electrons. Balanced equation: C2H3NO3 + 2 Fe + 4 H+ -> C2H5NO2 + 2 Fe^2+ + H2O.\",\n      \"reasoning\": \"Muchowska, Varma and Moran (2019) support Fe(0)/hydroxylamine access to glycine, but do not establish the separate kinetics or selective cleanup assumed in a coupled serine synthesis. The explicit oxime step and proposed operating window require testing. Native iron availability, competing proton reduction and surface passivation are additional constraints.\"\n    },\n    {\n      \"id\": \"rxn_019\",\n      \"name\": \"Conditional siderite precipitation before copper chemistry\",\n      \"inputs\": [\"mol_024\", \"mol_025\"],\n      \"outputs\": [\"mol_026\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-313 K, proposed\",\n        \"pressure\": \"Approximately 1 bar, strictly anoxic\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Proposed conditioning basin: pH 8.5-9.5, carbonate activity 0.1-1 mM, screened for 1-7 days with settling or porous-bed retention. Precipitation requires a_Fe2+ times a_CO3^2- above the siderite solubility product, approximately 2e-11 near 298 K before activity corrections. Target total dissolved Fe below 1 micromolar and measure glycine retention; equilibrium free-ion calculations do not establish total-iron removal in a ligand-rich mixture.\"\n      },\n      \"mechanism\": \"Anoxic carbonate precipitation. Balanced equation: Fe^2+ + CO3^2- -> FeCO3(s). The precipitate must remain in the conditioning bed rather than accompany the glycine solution.\",\n      \"reasoning\": \"This is a speculative integration operation: none of the supplied studies demonstrates siderite-mediated cleanup and glycine recovery for the proposed sequence. Its chemical basis is carbonate saturation, not an assumed generic mineral adsorption effect. Muchowska et al. (2019) support the preceding glycine chemistry, not this separation. Slow nucleation, glycine complexation and coprecipitation may prevent the proposed endpoint.\"\n    },\n    {\n      \"id\": \"rxn_020\",\n      \"name\": \"Copper-mediated hydroxymethylation of glycine to serine\",\n      \"inputs\": [\"mol_017\", \"mol_001\"],\n      \"outputs\": [\"mol_014\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Cu(II), introduced as soluble copper sulfate in the experimental analog and complexed by glycine\"],\n      \"conditions\": {\n        \"temperature\": \"330-360 K, proposed screening range\",\n        \"pressure\": \"Approximately 1 bar, anoxic\",\n        \"catalyst\": \"Cu(II)-glycinate; proposed 1-10 mol% Cu relative to glycine\",\n        \"aqueous\": true,\n        \"other\": \"Proposed shaded alkaline pool: 10 mM glycine, 10-20 mM formaldehyde, pH 9-10.5, sampled over 1-72 h. These numerical values are a screen, not an extracted Akabori protocol. Before reaction, require total dissolved cyanide below 1% of total Cu, dissolved sulfide below 0.1% of total Cu, free hydroxylamine below 1 micromolar, total dissolved Fe below 1 micromolar, and absence of reactive Fe/Ni particles. Verify soluble Cu(II)-glycinate rather than infer it from added copper. Cu(II) supply and persistence in an anoxic Fe(II)-rich world require a locally justified source; no molecular oxygen is assumed. Quantify serine, unreacted glycine and over-addition products.\"\n      },\n      \"mechanism\": \"Copper coordination facilitates alpha-carbon activation of glycine, C-C bond formation with formaldehyde and proton transfer. Balanced equation: C2H5NO2 + CH2O -> C3H7NO3. The transformation is reversible and produces racemic serine.\",\n      \"reasoning\": \"Akabori et al. (1959) demonstrated preparative DL-serine formation from glycine and formaldehyde in alkaline aqueous solution with catalytic CuSO4. The supplied report does not provide the exact yield or complete numerical protocol. Copper-glycinate chemistry is therefore supported, whereas the proposed concentrations, natural catalyst source and integrated handoffs remain conditional. Anoxia alone does not forbid Cu(II), but reducing metals, sulfide and cyanide can remove or alter it. Retro-aldol and over-hydroxymethylation are explicitly represented by rxn_022 and rxn_023.\"\n    },\n    {\n      \"id\": \"rxn_021\",\n      \"name\": \"Competing photochemical over-reduction of glycolaldehyde\",\n      \"inputs\": [\"mol_007\", \"mol_005\"],\n      \"outputs\": [\"mol_027\", \"mol_004\", \"mol_008\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"CuCN/cyanocuprate photoredox species in the experimentally characterized loss system\"],\n      \"conditions\": {\n        \"temperature\": \"Ambient laboratory temperature; proposed deployment 300-303 K\",\n        \"pressure\": \"Approximately 1 bar, anoxic\",\n        \"catalyst\": \"CuCN/cyanocuprates\",\n        \"aqueous\": true,\n        \"other\": \"Apply during continued 254 nm irradiation in the sulfide-containing reference matrix of rxn_002. The cited work compares aldehyde distributions at 2 h and 6 h. Use measured photon fluence and time-resolved aldehyde concentrations; do not assign this copper-assisted loss rate to the copper-free branch.\"\n      },\n      \"mechanism\": \"Net reductive deoxygenation converts the required hydroxyaldehyde to acetaldehyde. Formal closure: 8 C2H4O2 + 8 H2S -> 8 C2H4O + 8 H2O + S8.\",\n      \"reasoning\": \"Glycolaldehyde destruction on prolonged irradiation is directly documented by Ritson and Sutherland (2013). It chemically justifies termination of irradiation and dark downstream capture rather than arbitrary compartment multiplication. The sulfur endpoint remains provisional, and this edge is not a complete model of all photochemical losses.\"\n    },\n    {\n      \"id\": \"rxn_022\",\n      \"name\": \"Competing copper-mediated serine retro-aldol cleavage\",\n      \"inputs\": [\"mol_014\"],\n      \"outputs\": [\"mol_017\", \"mol_001\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Cu(II)-amino-acid complexes\"],\n      \"conditions\": {\n        \"temperature\": \"300-360 K, proposed monitoring range\",\n        \"pressure\": \"Approximately 1 bar, anoxic\",\n        \"catalyst\": \"Cu(II)-amino-acid complexes\",\n        \"aqueous\": true,\n        \"other\": \"Monitor under the pH 9-10.5 and copper-loading window of rxn_020, including cooling and storage. No reverse rate constant is supplied. Measure both forward and reverse fluxes instead of treating Cu removal or cooling as guaranteed product preservation.\"\n      },\n      \"mechanism\": \"Reverse C-C bond cleavage of the hydroxymethylation product. Balanced equation: C3H7NO3 -> C2H5NO2 + CH2O.\",\n      \"reasoning\": \"The glycine-formaldehyde/serine interconversion is reported as reversible in the supplied assessment, with copper-promoted synthesis established by Akabori et al. (1959) and explicit reversible pyridoxal-metal chemistry established by Metzler, Longenecker and Snell (1954). The latter does not provide a copper-only rate constant; the magnitude of this copper-system loss must be measured rather than transferred between catalysts.\"\n    },\n    {\n      \"id\": \"rxn_023\",\n      \"name\": \"Competing over-hydroxymethylation of serine\",\n      \"inputs\": [\"mol_014\", \"mol_001\"],\n      \"outputs\": [\"mol_028\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Cu(II)-amino-acid complexes\"],\n      \"conditions\": {\n        \"temperature\": \"330-360 K, proposed monitoring range\",\n        \"pressure\": \"Approximately 1 bar, anoxic\",\n        \"catalyst\": \"Cu(II)-amino-acid complexes\",\n        \"aqueous\": true,\n        \"other\": \"Apply in the alkaline hydroxymethylation pool, pH 9-10.5. Compare 1 and 2 equivalents formaldehyde and sample throughout 1-72 h. The proposed comparison tests selectivity; it is not evidence that either ratio prevents overreaction.\"\n      },\n      \"mechanism\": \"A second alpha-carbon hydroxymethylation consumes serine and formaldehyde. Balanced equation: C3H7NO3 + CH2O -> C4H9NO4.\",\n      \"reasoning\": \"Alpha-(hydroxymethyl)serine is a reported coproduct of the copper-mediated preparation (Akabori et al., 1959) and appears in the broader glycine-formaldehyde product mixture discussed by Chadha and Choughuley (1984). This competing edge prevents equating total glycine conversion with serine yield.\"\n    },\n    {\n      \"id\": \"rxn_024\",\n      \"name\": \"Representative thermal serine loss to a pyruvate-equivalent pool\",\n      \"inputs\": [\"mol_014\"],\n      \"outputs\": [\"mol_029\", \"mol_003\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"398-448 K\",\n        \"pressure\": \"10-100 bar, sufficient to retain liquid water\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Reference instability context: pH approximately 8 and 0.5 M NaCl in Aubrey et al. Their precursor experiments used 30 mM starting reagents and showed transient serine, including an early maximum within about 2.5 h at 398 K. Monitor minutes to hours during any hot exposure. This loss edge is not required by pathways that remain below these temperatures.\"\n      },\n      \"mechanism\": \"A possible dehydration-imine-hydrolysis sequence has the balanced net equation C3H7NO3 -> C3H4O3 + NH3. This is a representative deamination channel, not an assertion that all thermally destroyed serine becomes pyruvate.\",\n      \"reasoning\": \"Hydrothermal serine instability is experimentally supported (Aubrey, Cleaves and Bada, 2009; Sato et al., 2004). The pyruvate-only branch is a chemically plausible coarse-grained representation, not an experimentally established exclusive product distribution. Alanine, glycine and other products can also occur. High-temperature vent exposure is therefore not counted as an additional net serine-production pathway.\"\n    },\n    {\n      \"id\": \"rxn_025\",\n      \"name\": \"Competing glycolaldehyde cyanohydrin formation\",\n      \"inputs\": [\"mol_007\", \"mol_002\"],\n      \"outputs\": [\"mol_030\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-313 K\",\n        \"pressure\": \"Approximately 1 bar, anoxic\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Relevant wherever 0.1-10 mM glycolaldehyde encounters cyanide before effective ammonia capture. Proposed pH 7-9, with sampling from minutes to days. This reversible trapping channel competes with, rather than proves failure of, rxn_006.\"\n      },\n      \"mechanism\": \"Cyanide addition to glycolaldehyde gives glyceronitrile. Balanced equation: C2H4O2 + HCN -> C3H5NO2.\",\n      \"reasoning\": \"Glyceronitrile is explicitly reported among the reduced products of Xu et al. (2018), accounting for 40% in the cited experiment. Retaining this branch avoids mislabeling all reduced carbon as glycolaldehyde available for serine. No equilibrium constant or downstream recovery fraction is inferred from that product percentage.\"\n    },\n    {\n      \"id\": \"rxn_026\",\n      \"name\": \"Formaldehyde sequestration by residual hydroxylamine\",\n      \"inputs\": [\"mol_001\", \"mol_020\"],\n      \"outputs\": [\"mol_031\", \"mol_004\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-333 K, proposed monitoring range\",\n        \"pressure\": \"Approximately 1 bar, anoxic\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Monitor during pH adjustment and formaldehyde addition following the iron/hydroxylamine branch. A proposed residual hydroxylamine gate of less than 1 micromolar limits, but does not experimentally establish the absence of, this loss relative to a 10 mM formaldehyde feed.\"\n      },\n      \"mechanism\": \"Oxime condensation consumes the C1 donor. Balanced equation: CH2O + H3NO -> CH3NO + H2O.\",\n      \"reasoning\": \"This competition follows established carbonyl-hydroxylamine chemistry, but no rate or yield for the proposed mixed prebiotic stream is supplied by the research. It is therefore an explicit unquantified compatibility edge. Muchowska et al. (2019) support hydroxylamine-based amino-acid generation, not quantitative hydroxylamine exhaustion before a formaldehyde-dependent synthesis.\"\n    }\n  ],\n  \"pathways\": [\n    {\n      \"pathway_id\": \"P1\",\n      \"name\": \"Copper-assisted cyanosulfidic Strecker route with acid hydrolysis\",\n      \"description\": \"Formaldehyde and HCN supply glycolonitrile, copper-assisted sulfide photochemistry supplies glycolaldehyde, and dark Strecker capture precedes acid hydration and amide cleavage. The aldehyde and aminonitrile components are demonstrated; acid-brine conversion to recovered free serine and transfer recovery remain unvalidated.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_002\", \"rxn_006\", \"rxn_007\", \"rxn_008\"],\n      \"key_intermediates\": [\"mol_006\", \"mol_007\", \"mol_012\", \"mol_013\"]\n    },\n    {\n      \"pathway_id\": \"P2\",\n      \"name\": \"Copper-assisted cyanosulfidic Strecker route with alkaline hydrolysis\",\n      \"description\": \"Shares the demonstrated copper-assisted aldehyde supply with P1 but uses hydroxide-mediated nitrile hydration and amide cleavage. This is a distinct catalytic reaction-node sequence, not an independent carbon-skeleton-forming mechanism. Strong alkalinity, conversion rates and serine recovery are conditional.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_002\", \"rxn_006\", \"rxn_009\", \"rxn_010\"],\n      \"key_intermediates\": [\"mol_006\", \"mol_007\", \"mol_012\", \"mol_013\"]\n    },\n    {\n      \"pathway_id\": \"P3\",\n      \"name\": \"Copper-free cyanosulfidic Strecker route with acid hydrolysis\",\n      \"description\": \"Uses supported but slower copper-free sulfide photochemistry, followed by Strecker capture and the acid hydrolysis branch. Its usable irradiation window cannot be borrowed from P1, and acid-stage free-serine recovery remains to be measured.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_003\", \"rxn_006\", \"rxn_007\", \"rxn_008\"],\n      \"key_intermediates\": [\"mol_006\", \"mol_007\", \"mol_012\", \"mol_013\"]\n    },\n    {\n      \"pathway_id\": \"P4\",\n      \"name\": \"Copper-free cyanosulfidic Strecker route with alkaline hydrolysis\",\n      \"description\": \"Combines copper-free aldehyde production with dark Strecker capture and hydroxide-mediated hydrolysis. Both the copper-free photon-dose window and productive alkaline release of free serine require measurement; no yield is inferred from the copper-assisted route.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_003\", \"rxn_006\", \"rxn_009\", \"rxn_010\"],\n      \"key_intermediates\": [\"mol_006\", \"mol_007\", \"mol_012\", \"mol_013\"]\n    },\n    {\n      \"pathway_id\": \"P5\",\n      \"name\": \"Cyanosulfitic adduct route with acid hydrolysis\",\n      \"description\": \"Ferrocyanide/sulfite photochemistry produces a trapped glycolaldehyde pool. Equilibrium release coupled to Strecker capture is required before acid hydrolysis. The reported 28% adduct yield is not assigned as a recoverable glycolaldehyde or serine yield; release and sulfite compatibility are decisive unvalidated steps.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_004\", \"rxn_005\", \"rxn_006\", \"rxn_007\", \"rxn_008\"],\n      \"key_intermediates\": [\"mol_006\", \"mol_011\", \"mol_007\", \"mol_012\", \"mol_013\"]\n    },\n    {\n      \"pathway_id\": \"P6\",\n      \"name\": \"Cyanosulfitic adduct route with alkaline hydrolysis\",\n      \"description\": \"Uses the same trapped aldehyde supply as P5 but follows Strecker capture with the hydroxide-mediated hydrolysis branch. This sequence remains conditional on adduct release, sulfite-compatible capture, sufficiently alkaline water and measured free-serine survival.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_004\", \"rxn_005\", \"rxn_006\", \"rxn_009\", \"rxn_010\"],\n      \"key_intermediates\": [\"mol_006\", \"mol_011\", \"mol_007\", \"mol_012\", \"mol_013\"]\n    },\n    {\n      \"pathway_id\": \"P7\",\n      \"name\": \"Acid-hydrolyzed glycine Strecker supply followed by copper hydroxymethylation\",\n      \"description\": \"Formaldehyde Strecker chemistry supplies aminoacetonitrile, acid hydrolysis supplies glycine, and a second formaldehyde input installs the serine side chain. Residual cyanide must meet the explicit copper-compatibility gate. The final carbon-carbon bond formation is demonstrated, but hydrolysis, cleanup and recovery have not been integrated experimentally.\",\n      \"reaction_sequence\": [\"rxn_011\", \"rxn_012\", \"rxn_013\", \"rxn_020\"],\n      \"key_intermediates\": [\"mol_015\", \"mol_016\", \"mol_017\"]\n    },\n    {\n      \"pathway_id\": \"P8\",\n      \"name\": \"Base-hydrolyzed glycine Strecker supply followed by copper hydroxymethylation\",\n      \"description\": \"Uses hydroxide-mediated aminoacetonitrile and glycinamide hydrolysis before the copper-glycinate aldol step. This differs operationally from P7 and does not assume that alkaline hydrolysis removes cyanide. Productive glycine formation and catalyst-compatible conditioning must both be verified.\",\n      \"reaction_sequence\": [\"rxn_011\", \"rxn_014\", \"rxn_015\", \"rxn_020\"],\n      \"key_intermediates\": [\"mol_015\", \"mol_016\", \"mol_017\"]\n    },\n    {\n      \"pathway_id\": \"P9\",\n      \"name\": \"Nickel-hydrogen glycine supply followed by copper hydroxymethylation\",\n      \"description\": \"Experimentally supported glyoxylate reductive amination supplies glycine at 295 K and 5 bar H2. A physically retained nickel bed and depressurization separate this reducing stage from copper chemistry. The reaction sequence is supported at the component level, but native catalyst equivalence, nickel retention, gas removal and overall recovery remain conditional.\",\n      \"reaction_sequence\": [\"rxn_016\", \"rxn_020\"],\n      \"key_intermediates\": [\"mol_017\"]\n    },\n    {\n      \"pathway_id\": \"P10\",\n      \"name\": \"Iron-oxime glycine supply with carbonate conditioning and copper hydroxymethylation\",\n      \"description\": \"Glyoxylate oxime formation and stoichiometric iron reduction supply glycine. The listed precipitation step removes an iron coproduct rather than extending the carbon skeleton; glycine from rxn_018 remains available for rxn_020. This is the most integration-dependent branch: hydroxylamine exhaustion, reactive-iron retention, siderite saturation, total dissolved-iron removal and glycine recovery must all be measured. It is blocked if the stated compatibility gates are not met.\",\n      \"reaction_sequence\": [\"rxn_017\", \"rxn_018\", \"rxn_019\", \"rxn_020\"],\n      \"key_intermediates\": [\"mol_021\", \"mol_017\", \"mol_024\"]\n    }\n  ],\n  \"hub_molecules\": [\n    \"mol_001\",\n    \"mol_002\",\n    \"mol_003\",\n    \"mol_004\",\n    \"mol_005\",\n    \"mol_006\",\n    \"mol_007\",\n    \"mol_009\",\n    \"mol_012\",\n    \"mol_013\",\n    \"mol_014\",\n    \"mol_015\",\n    \"mol_016\",\n    \"mol_017\",\n    \"mol_018\",\n    \"mol_020\"\n  ],\n  \"convergence_points\": [\n    {\n      \"molecule_id\": \"mol_006\",\n      \"incoming_reactions\": [\"rxn_001\"],\n      \"outgoing_reactions\": [\"rxn_002\", \"rxn_003\", \"rxn_004\"]\n    },\n    {\n      \"molecule_id\": \"mol_007\",\n      \"incoming_reactions\": [\"rxn_002\", \"rxn_003\", \"rxn_005\"],\n      \"outgoing_reactions\": [\"rxn_006\", \"rxn_021\", \"rxn_025\"]\n    },\n    {\n      \"molecule_id\": \"mol_012\",\n      \"incoming_reactions\": [\"rxn_006\"],\n      \"outgoing_reactions\": [\"rxn_007\", \"rxn_009\"]\n    },\n    {\n      \"molecule_id\": \"mol_013\",\n      \"incoming_reactions\": [\"rxn_007\", \"rxn_009\"],\n      \"outgoing_reactions\": [\"rxn_008\", \"rxn_010\"]\n    },\n    {\n      \"molecule_id\": \"mol_015\",\n      \"incoming_reactions\": [\"rxn_011\"],\n      \"outgoing_reactions\": [\"rxn_012\", \"rxn_014\"]\n    },\n    {\n      \"molecule_id\": \"mol_016\",\n      \"incoming_reactions\": [\"rxn_012\", \"rxn_014\"],\n      \"outgoing_reactions\": [\"rxn_013\", \"rxn_015\"]\n    },\n    {\n      \"molecule_id\": \"mol_017\",\n      \"incoming_reactions\": [\"rxn_013\", \"rxn_015\", \"rxn_016\", \"rxn_018\", \"rxn_022\"],\n      \"outgoing_reactions\": [\"rxn_020\"]\n    },\n    {\n      \"molecule_id\": \"mol_014\",\n      \"incoming_reactions\": [\"rxn_008\", \"rxn_010\", \"rxn_020\"],\n      \"outgoing_reactions\": [\"rxn_022\", \"rxn_023\", \"rxn_024\"]\n    }\n  ]\n}", "parsed_response": {"target_molecule": "Serine", "overall_strategy": "Construct ten distinct reaction-node sequences using glycolaldehyde Strecker chemistry and copper-mediated glycine hydroxymethylation. These are ten operational pathways, not ten independently demonstrated carbon-skeleton-forming mechanisms: acid- and base-promoted hydrolysis are explicitly distinguished catalytic branches. Three glycolaldehyde supplies feed six Strecker pathways; two aminoacetonitrile hydrolysis branches and two glyoxylate amination branches feed four glycine pathways. The supplied literature does not establish ten complete geochemical routes to recovered free serine. Accordingly, demonstrated component chemistry is distinguished from proposed operating windows and unvalidated integration. Numerical screening conditions below are not presented as published measurements unless identified as such. Photochemistry, hydrolysis and copper chemistry occupy physically separate reaction zones where their conditions are incompatible; transfer recovery must be measured, not assumed. All settings are anoxic, and no molecular oxygen or generally available Fe(III) is invoked. Products are racemic or stereochemically unspecified. Neutral parent formulas represent rapidly interconverting aqueous protonation states except where ions are explicitly required for redox or precipitation balance. Balanced equations in mechanism fields record inferred coefficients without repeating molecule IDs. S8 and dithionate are provisional sulfur bookkeeping endpoints, not established exclusive coproducts. The environment_formed field records a reference formation setting, not every alternative setting. Because the schema lacks a byproduct role, terminal competition products are labeled intermediate. Competing reactions and explicit conditioning requirements prevent interpreting graph connectivity as evidence of net serine accumulation.", "molecules": [{"id": "mol_001", "formula": "CH2O", "iupac_name": "Methanal", "common_name": "Formaldehyde", "inchi": "InChI=1S/CH2O/c1-2/h1H2", "role": "starting", "environment_formed": null}, {"id": "mol_002", "formula": "CHN", "iupac_name": "Hydrogen cyanide", "common_name": "Hydrogen cyanide", "inchi": "InChI=1S/CHN/c1-2/h1H", "role": "starting", "environment_formed": null}, {"id": "mol_003", "formula": "NH3", "iupac_name": "Azane", "common_name": "Ammonia", "inchi": "InChI=1S/H3N/h1H3", "role": "starting", "environment_formed": null}, {"id": "mol_004", "formula": "H2O", "iupac_name": "Oxidane", "common_name": "Water", "inchi": "InChI=1S/H2O/h1H2", "role": "starting", "environment_formed": null}, {"id": "mol_005", "formula": "H2S", "iupac_name": "Sulfane", "common_name": "Hydrogen sulfide", "inchi": "InChI=1S/H2S/h1H2", "role": "starting", "environment_formed": null}, {"id": "mol_006", "formula": "C2H3NO", "iupac_name": "2-Hydroxyacetonitrile", "common_name": "Glycolonitrile", "inchi": "InChI=1S/C2H3NO/c3-1-2-4/h4H,2H2", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_007", "formula": "C2H4O2", "iupac_name": "2-Hydroxyethanal", "common_name": "Glycolaldehyde", "inchi": "InChI=1S/C2H4O2/c3-1-2-4/h1,4H,2H2", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_008", "formula": "S8", "iupac_name": "Cyclooctasulfur", "common_name": "Elemental sulfur", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_009", "formula": "HSO3-", "iupac_name": "Hydrogensulfite", "common_name": "Bisulfite", "inchi": null, "role": "starting", "environment_formed": null}, {"id": "mol_010", "formula": "S2O6^2-", "iupac_name": "Dithionate(2-)", "common_name": "Dithionate", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_011", "formula": "C2H5O5S-", "iupac_name": "1,2-Dihydroxyethane-1-sulfonate", "common_name": "Glycolaldehyde bisulfite adduct", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_012", "formula": "C3H6N2O", "iupac_name": "2-Amino-3-hydroxypropanenitrile", "common_name": "Serine aminonitrile", "inchi": null, "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_013", "formula": "C3H8N2O2", "iupac_name": "2-Amino-3-hydroxypropanamide", "common_name": "Serinamide", "inchi": null, "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_014", "formula": "C3H7NO3", "iupac_name": "2-Amino-3-hydroxypropanoic acid", "common_name": "DL-Serine", "inchi": "InChI=1S/C3H7NO3/c4-2(1-5)3(6)7/h2,5H,1,4H2,(H,6,7)", "role": "target", "environment_formed": "Surface"}, {"id": "mol_015", "formula": "C2H4N2", "iupac_name": "2-Aminoacetonitrile", "common_name": "Aminoacet