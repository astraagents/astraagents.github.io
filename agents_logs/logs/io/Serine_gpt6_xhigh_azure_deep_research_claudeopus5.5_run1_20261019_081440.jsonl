le\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_026\",\n      \"formula\": \"C4H9NO4\",\n      \"iupac_name\": \"2-amino-3-hydroxy-2-(hydroxymethyl)propanoic acid\",\n      \"common_name\": \"alpha-(hydroxymethyl)serine\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_027\",\n      \"formula\": \"C3H4O3\",\n      \"iupac_name\": \"2-oxopropanoic acid\",\n      \"common_name\": \"pyruvic acid\",\n      \"inchi\": \"InChI=1S/C3H4O3/c1-2(4)3(5)6/h1H3,(H,5,6)\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Hydrothermal\"\n    },\n    {\n      \"id\": \"mol_028\",\n      \"formula\": \"CH3NO\",\n      \"iupac_name\": \"N-methylidenehydroxylamine\",\n      \"common_name\": \"formaldoxime\",\n      \"inchi\": \"InChI=1S/CH3NO/c1-2-3/h3H,1H2\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_029\",\n      \"formula\": \"HCO3^-\",\n      \"iupac_name\": \"hydrogencarbonate\",\n      \"common_name\": \"bicarbonate\",\n      \"inchi\": null,\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_030\",\n      \"formula\": \"FeCO3\",\n      \"iupac_name\": \"iron(II) carbonate\",\n      \"common_name\": \"siderite\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_031\",\n      \"formula\": \"C3H5NO2\",\n      \"iupac_name\": \"2,3-dihydroxypropanenitrile\",\n      \"common_name\": \"glyceronitrile\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    }\n  ],\n  \"reactions\": [\n    {\n      \"id\": \"rxn_001\",\n      \"name\": \"Formaldehyde cyanohydrin formation\",\n      \"inputs\": [\"mol_002\", \"mol_001\"],\n      \"outputs\": [\"mol_006\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-310 K\",\n        \"pressure\": \"Approximately 1 bar\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Proposed shaded, anoxic pool at pH 7-9 with approximately 10 mM formaldehyde and 10 mM total cyanide. These concentrations are local feed assumptions, not inferred ocean concentrations. Cyanide speciation, gas loss and competing ammonia chemistry must be measured.\"\n      },\n      \"mechanism\": \"Balanced net: CH2O + HCN -> C2H3NO. Cyanide adds to the formaldehyde carbonyl, followed by proton transfer, to form glycolonitrile. The reaction is an equilibrium rather than an irreversible quantitative capture.\",\n      \"reasoning\": \"Glycolonitrile is the experimentally used entry substrate for reductive homologation in Ritson and Sutherland (2013), and cyanohydrin formation underlies the integrated network of Patel et al. (2015). Concentrated HCN supply and retention remain geochemical constraints; this entry does not claim that dilute open-ocean feedstocks reach the stated concentrations.\"\n    },\n    {\n      \"id\": \"rxn_002\",\n      \"name\": \"Copper-assisted cyanosulfidic reduction of glycolonitrile\",\n      \"inputs\": [\"mol_006\", \"mol_005\", \"mol_004\"],\n      \"outputs\": [\"mol_007\", \"mol_003\", \"mol_008\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Copper(I) cyanide and dissolved cyanocuprate(I) photoredox species\"],\n      \"conditions\": {\n        \"temperature\": \"Approximately 300 K\",\n        \"pressure\": \"Approximately 1 bar\",\n        \"catalyst\": \"CuCN/cyanocuprate(I)\",\n        \"aqueous\": true,\n        \"other\": \"Reported assay: 10 mM glycolonitrile, 30 mM H2S, 33 mM phosphate, 10 mol% CuCN, pH 7 and 254 nm irradiation; glycolaldehyde hydrate reached 42% at 2 h. A shallow illuminated compartment is followed by shaded drainage or interruption of irradiation near the measured maximum. Natural photon flux, optical depth and drainage recovery are unquantified.\"\n      },\n      \"mechanism\": \"Balanced formal sulfur-endpoint equation: 8 C2H3NO + 8 H2S + 8 H2O -> 8 C2H4O2 + 8 NH3 + S8. Photogenerated reducing equivalents reduce the nitrile through imine-level intermediates; hydrolysis releases glycolaldehyde. S8 represents a net zero-valent-sulfur endpoint, not a measured exclusive sulfur product.\",\n      \"reasoning\": \"Ritson and Sutherland (2013) directly demonstrated the aldehyde-forming chemistry and the 42% two-hour yield. Patel et al. (2015) support staged integration. Continued irradiation promotes loss through rxn_020. Ranjan et al. (2018) identify local sulfide availability as a constraint; phosphate and copper concentrations also require local justification. The laboratory irradiation time must not be transferred directly to sunlight exposure.\"\n    },\n    {\n      \"id\": \"rxn_003\",\n      \"name\": \"Copper-free cyanosulfidic photoreduction\",\n      \"inputs\": [\"mol_006\", \"mol_005\", \"mol_004\"],\n      \"outputs\": [\"mol_007\", \"mol_003\", \"mol_008\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-310 K\",\n        \"pressure\": \"Approximately 1 bar\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Proposed comparison: 10 mM glycolonitrile, 30 mM total sulfide, phosphate-buffered pH near 7, 254 nm irradiation and no intentionally added copper. Screen exposure times rather than importing the two-hour copper-assisted optimum. Trace-metal contamination and sulfur-product light screening require controls.\"\n      },\n      \"mechanism\": \"Balanced formal endpoint: 8 C2H3NO + 8 H2S + 8 H2O -> 8 C2H4O2 + 8 NH3 + S8. Sulfide photochemistry supplies reducing equivalents without the copper acceleration. The microscopic reduction sequence and sulfur distribution need not match the copper-assisted system.\",\n      \"reasoning\": \"Ritson and Sutherland (2013), as summarized in the supplied research, support copper-independent photoreduction with slower chemistry. This is a catalyst-regime alternative, not an independent carbon-skeleton mechanism. No matched serine yield or copper-free rate is supplied, so the 42% copper-assisted yield is not assigned to this edge.\"\n    },\n    {\n      \"id\": \"rxn_004\",\n      \"name\": \"Cyanosulfitic photoreduction with aldehyde trapping\",\n      \"inputs\": [\"mol_006\", \"mol_009\", \"mol_004\"],\n      \"outputs\": [\"mol_010\", \"mol_003\", \"mol_011\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Ferrocyanide, [Fe(CN)6]4-, as a photoredox mediator\"],\n      \"conditions\": {\n        \"temperature\": \"300-310 K\",\n        \"pressure\": \"Approximately 1 bar\",\n        \"catalyst\": \"Ferrocyanide\",\n        \"aqueous\": true,\n        \"other\": \"UV-illuminated, anoxic sulfite-bearing pool. Proposed screening values, not verified original assay values: 10 mM glycolonitrile, 30-100 mM total dissolved S(IV), 0.1-1 mM ferrocyanide and pH 7-9. Bisulfite is the proton-balanced reference species for the sulfite/bisulfite pool. The reported comparison endpoint was 1 h.\"\n      },\n      \"mechanism\": \"Balanced illustrative channel: C2H3NO + 3 HSO3^- + H2O -> C2H5O5S^- + NH3 + S2O6^2-. Two S(IV) equivalents formally supply two electrons through oxidation to dithionate; another traps the aldehyde as its bisulfite adduct. Dithionate is a provisional balanced radical-recombination endpoint, not a quantified exclusive coproduct.\",\n      \"reasoning\": \"Xu et al. (2018) reported 68% total reduced products after one hour, including 28% glycolaldehyde-sulfite adduct and 40% glyceronitrile. Those percentages are not free-glycolaldehyde or serine yields. This edge models the observed adduct branch; rxn_027 represents competing cyanohydrin capture. The proposed sulfur bookkeeping and environmental concentrations require direct verification.\"\n    },\n    {\n      \"id\": \"rxn_005\",\n      \"name\": \"Release of glycolaldehyde from its bisulfite adduct\",\n      \"inputs\": [\"mol_010\"],\n      \"outputs\": [\"mol_007\", \"mol_009\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-320 K\",\n        \"pressure\": \"Approximately 1 bar\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Proposed shaded downstream mixing zone at pH 8-9.5. Test modest dilution and immediate capture of released aldehyde by excess ammonia and cyanide in rxn_007. Sulfite remains in solution; this operation is not represented as a demonstrated quantitative sulfite separation.\"\n      },\n      \"mechanism\": \"Balanced equilibrium: C2H5O5S^- -> C2H4O2 + HSO3^-. Reversible carbonyl-bisulfite adduct dissociation exposes the aldehyde; consumption of free aldehyde can pull the equilibrium.\",\n      \"reasoning\": \"Xu et al. (2018) establish the trapped aldehyde pool, not a complete serine-producing handoff. Adduct dissociation is established carbonyl chemistry, but its integration here is speculative: the free-aldehyde fraction, dissociation rate and competition with continued sulfite trapping have not been demonstrated under the proposed conditions.\"\n    },\n    {\n      \"id\": \"rxn_006\",\n      \"name\": \"Conditional net C2 production within formose chemistry\",\n      \"inputs\": [\"mol_002\"],\n      \"outputs\": [\"mol_007\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Calcium hydroxide as an alkaline calcium source\"],\n      \"conditions\": {\n        \"temperature\": \"320-350 K\",\n        \"pressure\": \"Approximately 1 bar\",\n        \"catalyst\": \"Alkaline calcium-containing medium\",\n        \"aqueous\": true,\n        \"other\": \"Proposed carbonate-poor alkaline pool, pH 10-11, with locally concentrated formaldehyde at 10-100 mM. No externally supplied glycolaldehyde seed is assumed. Measure initiation separately from autocatalytic growth; cool and lower pH before Strecker capture. These are screening conditions, not a reported selective glycolaldehyde preparation.\"\n      },\n      \"mechanism\": \"Formal carbon balance for the selected C2 branch: 2 CH2O -> C2H4O2. This is a coarse-grained formose-network edge, not an elementary base-catalysed aldol of two formaldehyde molecules. Initiation without a C2 seed remains unresolved, and competing Cannizzaro and higher-sugar reactions are expected.\",\n      \"reasoning\": \"This is a speculative de novo supply branch within classical formose chemistry. The supplied research does not establish selective glycolaldehyde production or an integrated serine yield. Weber (1998) is a negative constraint: aldehydes, ammonia and thiol did not yield reported serine without cyanide. The branch is retained as a testable alternative, not as an established replacement for photoreduction.\"\n    },\n    {\n      \"id\": \"rxn_007\",\n      \"name\": \"Glycolaldehyde Strecker conversion to serine aminonitrile\",\n      \"inputs\": [\"mol_007\", \"mol_001\", \"mol_003\"],\n      \"outputs\": [\"mol_012\", \"mol_004\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-320 K\",\n        \"pressure\": \"Approximately 1 bar\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Shaded anoxic pool after irradiation has stopped. Proposed concentrations: 1-10 mM glycolaldehyde equivalents, comparable or modestly excess total cyanide and 0.05-0.2 M total ammonia, pH 8-9.5. The reported network developed aminonitriles over days to weeks. The proposed concentrations are not a verified reconstruction of the Foden assay. Avoid acylating or formylating reagents that divert Ser-CN toward elimination products.\"\n      },\n      \"mechanism\": \"Balanced net: C2H4O2 + HCN + NH3 -> C3H6N2O + H2O. Ammonia forms an imine or iminium intermediate, followed by cyanide addition. Attack on either face gives racemic serine aminonitrile. Cyanohydrin formation in rxn_027 competes with productive imine capture.\",\n      \"reasoning\": \"Ritson and Sutherland (2013) report formation of the relevant aminonitriles, and Foden et al. (2020) describe glycolaldehyde-to-Ser-CN conversion in excellent yield without a retrieved numerical value. This is the strongest serine-specific skeleton-forming edge in the supplied record. Residual reductive irradiation must stop, and concentrated ammonia availability remains a local requirement.\"\n    },\n    {\n      \"id\": \"rxn_008\",\n      \"name\": \"Hydration of serine aminonitrile to serinamide\",\n      \"inputs\": [\"mol_012\", \"mol_004\"],\n      \"outputs\": [\"mol_013\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Hydronium in a volcanic mineral-acid pool\"],\n      \"conditions\": {\n        \"temperature\": \"350-365 K\",\n        \"pressure\": \"Approximately 1 bar\",\n        \"catalyst\": \"Hydronium\",\n        \"aqueous\": true,\n        \"other\": \"Proposed shaded, chloride-acidified geothermal pool at pH 1-2.5 with 1-10 mM aminonitrile. Screen residence times from one day to several weeks while measuring nitrile, amide, serine and degradation products. Volcanic HCl is a possible acid source without molecular oxygen. No hydrolysis rate or quantitative transfer recovery is assumed.\"\n      },\n      \"mechanism\": \"Balanced net: C3H6N2O + H2O -> C3H8N2O2. Acid-catalysed nitrile hydration gives the amide through protonated nitrile and imidic intermediates. Acid is catalytic in the reference neutral-species equation.\",\n      \"reasoning\": \"This resolves the standard Strecker hydrolysis into its kinetically important amide intermediate. Ritson and Sutherland (2013) and Foden et al. (2020) support aminonitrile availability, but do not establish the proposed mild hydrolysis schedule. The environmental implementation is speculative and necessary to distinguish Ser-CN formation from demonstrated free-serine production.\"\n    },\n    {\n      \"id\": \"rxn_009\",\n      \"name\": \"Serinamide hydrolysis to free serine\",\n      \"inputs\": [\"mol_013\", \"mol_004\"],\n      \"outputs\": [\"mol_014\", \"mol_003\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Hydronium in the same mineral-acid hydrolysis compartment\"],\n      \"conditions\": {\n        \"temperature\": \"350-365 K\",\n        \"pressure\": \"Approximately 1 bar\",\n        \"catalyst\": \"Hydronium\",\n        \"aqueous\": true,\n        \"other\": \"Proposed pH 1-2.5, 1-10 mM amide and a monitored residence of days to weeks. Ammonia is predominantly ammonium at this pH. Cool toward 300 K promptly after the serine maximum; do not assume that indefinite heating completes hydrolysis without destruction.\"\n      },\n      \"mechanism\": \"Balanced reference-species equation: C3H8N2O2 + H2O -> C3H7NO3 + NH3. Addition to the protonated amide carbonyl and C-N cleavage produce serine and ammonium after solution protonation equilibria.\",\n      \"reasoning\": \"Amide hydrolysis is conventional chemistry, but its rate and serine recovery under these proposed prebiotic conditions are speculative. The supplied Ser-CN studies do not supply this missing kinetic record. Aubrey et al. (2009) and Sato et al. (2004) establish why hydrolysis must be evaluated against serine degradation rather than treated as automatically quantitative.\"\n    },\n    {\n      \"id\": \"rxn_010\",\n      \"name\": \"Formaldehyde Strecker conversion to aminoacetonitrile\",\n      \"inputs\": [\"mol_002\", \"mol_001\", \"mol_003\"],\n      \"outputs\": [\"mol_015\", \"mol_004\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-320 K\",\n        \"pressure\": \"Approximately 1 bar\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Proposed sulfur-free, shaded pool with 10 mM formaldehyde, approximately 10 mM cyanide and 0.05-0.2 M total ammonia, pH 8-9.5. Permit days-to-weeks screening, not an assumed fixed conversion time. Glycolonitrile and hexamethylenetetramine-type chemistry can compete.\"\n      },\n      \"mechanism\": \"Balanced net: CH2O + HCN + NH3 -> C2H4N2 + H2O. Formaldehyde-ammonia imine formation followed by cyanide addition produces aminoacetonitrile.\",\n      \"reasoning\": \"Ritson and Sutherland (2013) report conversion of formaldehyde-containing mixtures to the glycine aminonitrile after addition of HCN and ammonia. This provides a chemically simple glycine supply independent of glycolaldehyde. Exact yields and rates for the proposed compartment are unavailable.\"\n    },\n    {\n      \"id\": \"rxn_011\",\n      \"name\": \"Aminoacetonitrile hydration to glycinamide\",\n      \"inputs\": [\"mol_015\", \"mol_004\"],\n      \"outputs\": [\"mol_016\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Hydronium from volcanic mineral acid\"],\n      \"conditions\": {\n        \"temperature\": \"350-365 K\",\n        \"pressure\": \"Approximately 1 bar\",\n        \"catalyst\": \"Hydronium\",\n        \"aqueous\": true,\n        \"other\": \"Proposed shaded hydrolysis pool at pH 1-2.5 with 1-10 mM aminoacetonitrile. Quantify amide accumulation during days-to-weeks screening. Acidification can release residual unreacted HCN to the gas phase; neither cyanide retention nor carbon recovery is assumed quantitative.\"\n      },\n      \"mechanism\": \"Balanced net: C2H4N2 + H2O -> C2H6N2O. Acid-catalysed hydration converts the nitrile to glycinamide.\",\n      \"reasoning\": \"This is the conventional first hydrolysis stage of the Strecker glycine route supported upstream by Ritson and Sutherland (2013). The selected environmental conditions and residence time are speculative because the supplied research does not provide their rate constants. An explicit amide node prevents the network from hiding the hydrolysis bottleneck.\"\n    },\n    {\n      \"id\": \"rxn_012\",\n      \"name\": \"Glycinamide hydrolysis to glycine\",\n      \"inputs\": [\"mol_016\", \"mol_004\"],\n      \"outputs\": [\"mol_017\", \"mol_003\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Hydronium from volcanic mineral acid\"],\n      \"conditions\": {\n        \"temperature\": \"350-365 K\",\n        \"pressure\": \"Approximately 1 bar\",\n        \"catalyst\": \"Hydronium\",\n        \"aqueous\": true,\n        \"other\": \"Proposed pH 1-2.5 and monitored days-to-weeks residence. Before hydroxymethylation, cool to 300-330 K and move into a carbonate-buffered alkaline compartment. For the copper branch, labile cyanide must be depleted sufficiently to avoid copper-cyanide sequestration. Acid-driven HCN loss is a proposed conditioning mechanism, not demonstrated quantitative purification.\"\n      },\n      \"mechanism\": \"Balanced reference-species equation: C2H6N2O + H2O -> C2H5NO2 + NH3. Amide hydrolysis releases glycine and ammonia, with their actual protonation controlled by pH.\",\n      \"reasoning\": \"Classical Strecker chemistry provides the molecular precedent; Ritson and Sutherland (2013) establish the upstream aminoacetonitrile. The mild hydrolysis kinetics and subsequent copper-compatible recovery remain speculative. Akabori et al. (1959) support the downstream glycine reaction, not this complete environmental handoff.\"\n    },\n    {\n      \"id\": \"rxn_013\",\n      \"name\": \"Nickel-catalysed reductive amination of glyoxylate to glycine\",\n      \"inputs\": [\"mol_018\", \"mol_003\", \"mol_019\"],\n      \"outputs\": [\"mol_017\", \"mol_004\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\"Reduced nickel surfaces; supported Ni/SiO2-Al2O3 is the laboratory benchmark\"],\n      \"conditions\": {\n        \"temperature\": \"295 K laboratory benchmark; approximately 300 K proposed extension\",\n        \"pressure\": \"H2 partial pressure approximately 5 bar; total pressure at least 5 bar\",\n        \"catalyst\": \"Reduced nickel\",\n        \"aqueous\": true,\n        \"other\": \"Reported benchmark: pH 8, ammonium bicarbonate at five equivalents and 72 h with H2/Ni. Proposed physical setting: cool, confined, H2-bearing mineral-interface porewater, not an exposed ambient-pressure pond. A proposed flow-through implementation retains nickel grains upstream, then depressurizes and degasses the glycine-bearing water before formaldehyde addition. Catalyst loading, native-surface activity, dissolved-metal carryover and glycine recovery must be measured.\"\n      },\n      \"mechanism\": \"Balanced net: C2H2O3 + NH3 + H2 -> C2H5NO2 + H2O. Glyoxylate forms an imine with ammonia; nickel activates hydrogen for reduction to glycine.\",\n      \"reasoning\": \"Kaur et al. (2024) directly demonstrated glyoxylate-to-glycine conversion with H2 and nickel-based catalysts. Their results do not demonstrate hydroxypyruvate-to-serine conversion, which is therefore omitted. Supported catalyst performance is not automatically assigned to arbitrary natural minerals. Grain retention and H2 removal are chemically necessary to prevent continued hydrogenation of the subsequently supplied formaldehyde, but the integrated recovery has not been demonstrated.\"\n    },\n    {\n      \"id\": \"rxn_014\",\n      \"name\": \"Formation of glyoxylic acid oxime\",\n      \"inputs\": [\"mol_018\", \"mol_020\"],\n      \"outputs\": [\"mol_021\", \"mol_004\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-343 K\",\n        \"pressure\": \"Approximately 1 bar\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Proposed shaded, anoxic pool at pH 3-5 with 1-10 mM glyoxylate and 0.8-1.0 equivalent hydroxylamine, keeping hydroxylamine limiting. No formaldehyde is introduced at this stage. The supplied report does not give a verified complete concentration and pH record for the original iron/hydroxylamine assay.\"\n      },\n      \"mechanism\": \"Balanced net: C2H2O3 + H3NO -> C2H3NO3 + H2O. Hydroxylamine condenses with the glyoxylate carbonyl to form an oxime; no particular E/Z isomer is selected.\",\n      \"reasoning\": \"Muchowska et al. (2019) demonstrated amino-acid formation using hydroxylamine and metallic iron. The explicit oxime is a mechanistically inferred intermediate rather than an independently quantified intermediate in the supplied record. A concentrated prebiotic hydroxylamine supply is an additional unresolved requirement, and residual hydroxylamine would trap downstream formaldehyde through rxn_026.\"\n    },\n    {\n      \"id\": \"rxn_015\",\n      \"name\": \"Stoichiometric native-iron reduction of glyoxylate oxime\",\n      \"inputs\": [\"mol_021\", \"mol_022\", \"mol_024\"],\n      \"outputs\": [\"mol_017\", \"mol_023\", \"mol_004\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Native iron grains as a consumed reductant, not a catalyst\"],\n      \"conditions\": {\n        \"temperature\": \"320-343 K\",\n        \"pressure\": \"Approximately 1 bar in an anoxic, gas-vented compartment\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Proposed pH 3-5, 1-10 mM oxime and excess accessible Fe0 surface. Four proton equivalents and two Fe0 equivalents are required by the idealized reduction channel; additional iron can be consumed by acid corrosion. Oxime disappearance, glycine formation and residual hydroxylamine must be assayed. Native Fe0 requires a local metal-bearing source and is not inferred merely from abundant dissolved Fe2+.\"\n      },\n      \"mechanism\": \"Balanced equation: C2H3NO3 + 2 Fe + 4 H3O+ -> C2H5NO2 + 2 Fe^2+ + 5 H2O. Four-electron reduction of the oxime, including N-O bond cleavage, gives glycine while iron is oxidized to Fe2+.\",\n      \"reasoning\": \"Muchowska et al. (2019) provide experimental precedent for Fe0/hydroxylamine amino-acid production, including glycine. This explicit electron-balanced oxime channel is a mechanistic decomposition of that chemistry; its proposed pH, surface loading and rate are not independently established here. Both metallic iron and hydroxylamine must be removed or exhausted before the hydroxymethylation stage.\"\n    },\n    {\n      \"id\": \"rxn_016\",\n      \"name\": \"Proposed reductive exhaustion of residual hydroxylamine\",\n      \"inputs\": [\"mol_020\", \"mol_022\", \"mol_024\"],\n      \"outputs\": [\"mol_003\", \"mol_023\", \"mol_004\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Native iron retained in the upstream reduction bed\"],\n      \"conditions\": {\n        \"temperature\": \"320-343 K\",\n        \"pressure\": \"Approximately 1 bar\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Maintain contact with excess upstream Fe0 after oxime conversion, without formaldehyde present. Transfer is conditional on demonstrated depletion of hydroxylamine, not simply elapsed time. A proposed screening gate is residual hydroxylamine below 1% of the subsequently introduced formaldehyde concentration; this is an operational test criterion, not a demonstrated geological purification efficiency.\"\n      },\n      \"mechanism\": \"Balanced equation: H3NO + Fe + 2 H3O+ -> NH3 + Fe^2+ + 3 H2O. Iron supplies two electrons for reductive N-O cleavage.\",\n      \"reasoning\": \"This is a speculative compatibility operation motivated by the reducing Fe0/hydroxylamine system of Muchowska et al. (2019), not a reported validated cleanup stage from that study. It addresses the specific risk that residual hydroxylamine consumes formaldehyde. If depletion cannot be shown while retaining glycine, pathways P9 and P10 are not operationally closed.\"\n    },\n    {\n      \"id\": \"rxn_017\",\n      \"name\": \"Proposed anoxic removal of dissolved iron as siderite\",\n      \"inputs\": [\"mol_023\", \"mol_029\", \"mol_004\"],\n      \"outputs\": [\"mol_030\", \"mol_024\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-330 K\",\n        \"pressure\": \"Approximately 1 bar\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Proposed downstream carbonate-rich settling compartment, pH 7.5-8.5 and 50-100 mM dissolved inorganic carbon, with upstream Fe0 grains physically retained. Siderite supersaturation must be established using activities, not total concentrations alone. Allow only measured precipitation and sediment retention; nucleation delay and glycine adsorption or coprecipitation are unresolved.\"\n      },\n      \"mechanism\": \"Balanced reference-species equation: Fe^2+ + HCO3^- + H2O -> FeCO3 + H3O+. Carbonate precipitation lowers dissolved Fe2+ without introducing molecular oxygen. Buffering must accommodate the released acidity.\",\n      \"reasoning\": \"This is a speculative network-integration step based on ordinary anoxic carbonate geochemistry; the supplied studies do not demonstrate this handoff. It is included because the iron-containing product mixture of Muchowska et al. (2019) cannot simply be assumed equivalent to a clean glycine solution for Akabori et al. (1959). Iron removal, metal carryover and glycine recovery require separate measurements.\"\n    },\n    {\n      \"id\": \"rxn_018\",\n      \"name\": \"Copper-glycinate-catalysed hydroxymethylation to serine\",\n      \"inputs\": [\"mol_017\", \"mol_002\"],\n      \"outputs\": [\"mol_014\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Dissolved copper(II)-glycinate complexes in alkaline solution\"],\n      \"conditions\": {\n        \"temperature\": \"300-350 K proposed screening range\",\n        \"pressure\": \"Approximately 1 bar\",\n        \"catalyst\": \"Copper(II)-glycinate\",\n        \"aqueous\": true,\n        \"other\": \"Proposed shaded, sulfur-poor alkaline pool: 10 mM glycine, 10-20 mM formaldehyde, 0.1-1 mM total Cu(II), pH 8.5-10. These are design values, not verified Akabori assay values. Glycinate complexation must keep an active dissolved copper population despite hydroxide precipitation. Exclude residual sulfide, substantial labile cyanide, Fe0, active nickel/H2 and hydroxylamine. A local Cu(II) inventory and its lifetime under anoxia remain conditional. Measure forward, retro-aldol and over-addition rates.\"\n      },\n      \"mechanism\": \"Balanced net: C2H5NO2 + CH2O -> C3H7NO3. Copper coordination enables alpha-carbon activation of glycinate, C-C addition to formaldehyde and protonation to racemic serine. Reverse cleavage and a second hydroxymethylation are represented separately.\",\n      \"reasoning\": \"Akabori et al. (1959) directly reported preparative DL-serine from glycine and formaldehyde with catalytic copper sulfate in alkaline water. No numerical yield or complete experimental condition record was retrieved in the supplied research. Anoxia does not prohibit Cu(II), but neither its supply nor persistence in reducing, sulfidic water can be presumed. Sulfur-free staging, metal speciation and substrate recovery are explicit feasibility gates rather than claimed solved separations.\"\n    },\n    {\n      \"id\": \"rxn_019\",\n      \"name\": \"Low-confidence alkaline hydroxymethylation without deliberately added copper or pyridoxal\",\n      \"inputs\": [\"mol_017\", \"mol_002\"],\n      \"outputs\": [\"mol_014\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Aqueous base; no deliberately added transition-metal or pyridoxal catalyst\"],\n      \"conditions\": {\n        \"temperature\": \"300-330 K proposed screening range\",\n        \"pressure\": \"Approximately 1 bar\",\n        \"catalyst\": \"Base-promoted reaction network; active microscopic catalyst is unresolved\",\n        \"aqueous\": true,\n        \"other\": \"Reported concentration basis: 10 mM glycine and glycine:formaldehyde ratio 1:2. Proposed pH 8.5-10 in a shaded alkaline pool and monitoring over days to weeks. Original serine yield, rate and trace-metal inventory are unavailable. No catalytic benefit is assigned to clay. Hydroxylamine and active hydrogenation catalysts must still be depleted before formaldehyde addition.\"\n      },\n      \"mechanism\": \"Balanced selected-product channel: C2H5NO2 + CH2O -> C3H7NO3. The experiment reports hydroxymethylation within a multichannel alkaline mixture; a fast elementary reaction of free glycine carbanion with formaldehyde is not assumed.\",\n      \"reasoning\": \"Chadha and Choughuley (1984) report serine together with hydroxymethylserine, sarcosine, iminodiacetic acid and alanine under dilute mildly alkaline conditions. This supports a mixed-product channel, not an efficient catalyst-free synthesis. The high uncatalysed coupling barriers summarized in the supplied 2024 computational study reinforce the kinetic uncertainty. This lower-confidence alternative avoids an assumed prebiotic pyridoxal supply but must not be assigned the efficiency of Akabori et al. (1959).\"\n    },\n    {\n      \"id\": \"rxn_020\",\n      \"name\": \"Competing photoreductive loss of glycolaldehyde to acetaldehyde\",\n      \"inputs\": [\"mol_007\", \"mol_005\"],\n      \"outputs\": [\"mol_025\", \"mol_004\", \"mol_008\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"CuCN/cyanocuprate(I) photoredox species\"],\n      \"conditions\": {\n        \"temperature\": \"Approximately 300 K\",\n        \"pressure\": \"Approximately 1 bar\",\n        \"catalyst\": \"CuCN/cyanocuprate(I)\",\n        \"aqueous\": true,\n        \"other\": \"Same sulfide-containing irradiated compartment as rxn_002. The reported product distribution shifted strongly toward acetaldehyde with prolonged irradiation between 2 and 6 h. This laboratory interval is not a calibrated natural-sunlight residence time.\"\n      },\n      \"mechanism\": \"Balanced formal endpoint: 8 C2H4O2 + 8 H2S -> 8 C2H4O + 8 H2O + S8. Net reductive deoxygenation removes the hydroxymethyl oxygen, destroying the aldehyde required for serine synthesis.\",\n      \"reasoning\": \"Ritson and Sutherland (2013) directly document over-reduction and identify it as a threat to glycolaldehyde-dependent serine chemistry. This edge makes irradiation control an actual competition rather than an unqualified productive step. Its rate relative to rxn_002 must be measured for each light field; the S8 endpoint remains formal sulfur bookkeeping.\"\n    },\n    {\n      \"id\": \"rxn_021\",\n      \"name\": \"Copper-associated retro-aldol loss of serine\",\n      \"inputs\": [\"mol_014\"],\n      \"outputs\": [\"mol_017\", \"mol_002\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Copper(II)-glycinate/serinate complexes\"],\n      \"conditions\": {\n        \"temperature\": \"300-350 K\",\n        \"pressure\": \"Approximately 1 bar\",\n        \"catalyst\": \"Copper(II)-amino-acid complexes\",\n        \"aqueous\": true,\n        \"other\": \"Same copper-bearing alkaline compartment as rxn_018. The reverse coefficient and equilibrium composition are unknown under the proposed dilute conditions. Cooling and shortening post-formation residence are proposed retention measures, not quantified stabilization procedures.\"\n      },\n      \"mechanism\": \"Balanced equation: C3H7NO3 -> C2H5NO2 + CH2O. Metal-assisted C-C cleavage reverses hydroxymethylation.\",\n      \"reasoning\": \"The supplied research describes the glycine/formaldehyde-serine chemistry as reversible. Akabori et al. (1959) support copper-promoted synthesis, while Metzler, Longenecker and Snell (1954) directly support reversibility in pyridoxal-metal systems. The latter does not establish a numerical copper-only reverse rate; this edge is a necessary kinetic possibility, not a transferred rate constant.\"\n    },\n    {\n      \"id\": \"rxn_022\",\n      \"name\": \"Unquantified alkaline retro-aldol background\",\n      \"inputs\": [\"mol_014\"],\n      \"outputs\": [\"mol_017\", \"mol_002\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Aqueous base\"],\n      \"conditions\": {\n        \"temperature\": \"300-330 K\",\n        \"pressure\": \"Approximately 1 bar\",\n        \"catalyst\": \"Base; microscopic catalytic pathway unresolved\",\n        \"aqueous\": true,\n        \"other\": \"Proposed pH 8.5-10 with no deliberately added copper or pyridoxal. Include in kinetic testing of rxn_019 rather than assuming the background synthesis channel is irreversible. No measurable ambient-temperature rate is asserted.\"\n      },\n      \"mechanism\": \"Balanced equation: C3H7NO3 -> C2H5NO2 + CH2O. This is the formal reverse C-C cleavage channel of alkaline hydroxymethylation.\",\n      \"reasoning\": \"This rate-bearing edge is speculative. Chadha and Choughuley (1984) support a multichannel alkaline product network, but do not provide a reverse rate in the supplied account. Metzler, Longenecker and Snell (1954) establish retro-aldol feasibility with stronger catalysis, not its speed without those catalysts. The edge prevents unjustified irreversible accumulation in the weakly supported base branch.\"\n    },\n    {\n      \"id\": \"rxn_023\",\n      \"name\": \"Copper-promoted over-hydroxymethylation of serine\",\n      \"inputs\": [\"mol_014\", \"mol_002\"],\n      \"outputs\": [\"mol_026\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Copper(II)-amino-acid complexes\"],\n      \"conditions\": {\n        \"temperature\": \"300-350 K\",\n        \"pressure\": \"Approximately 1 bar\",\n        \"catalyst\": \"Copper(II)-amino-acid complexes\",\n        \"aqueous\": true,\n        \"other\": \"Same compartment as rxn_018; favored as a competing channel when formaldehyde remains available after serine forms. Quantify selectivity against formaldehyde exposure and residence time rather than assuming excess aldehyde improves serine yield.\"\n      },\n      \"mechanism\": \"Balanced equation: C3H7NO3 + CH2O -> C4H9NO4. A second alpha-carbon hydroxymethylation replaces serine's remaining alpha hydrogen and creates alpha-(hydroxymethyl)serine.\",\n      \"reasoning\": \"Akabori et al. (1959) identify alpha-(hydroxymethyl)serine as a coproduct of copper-catalysed synthesis. This is therefore a experimentally motivated selectivity limit. Its rate and yield under the proposed geochemical concentrations are unavailable.\"\n    },\n    {\n      \"id\": \"rxn_024\",\n      \"name\": \"Over-hydroxymethylation in the weak alkaline product network\",\n      \"inputs\": [\"mol_014\", \"mol_002\"],\n      \"outputs\": [\"mol_026\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Aqueous base; unidentified trace catalytic contributions are not excluded\"],\n      \"conditions\": {\n        \"temperature\": \"300-330 K\",\n        \"pressure\": \"Approximately 1 bar\",\n        \"catalyst\": \"Alkaline reaction medium\",\n        \"aqueous\": true,\n        \"other\": \"Same proposed pH 8.5-10 and 10 mM glycine/20 mM initial formaldehyde regime as rxn_019. The reported product identification does not supply a kinetic branching fraction or prove the absence of trace-metal catalysis.\"\n      },\n      \"mechanism\": \"Balanced selected-product equation: C3H7NO3 + CH2O -> C4H9NO4. A second hydroxymethylation diverts serine into the over-addition product.\",\n      \"reasoning\": \"Chadha and Choughuley (1984) report hydroxymethylserine along with serine in the mildly alkaline mixture. The explicit sequential serine-to-over-addition edge is a mechanistic interpretation of that product relationship; neither its rate nor the exact catalyst responsible was established in the supplied account.\"\n    },\n    {\n      \"id\": \"rxn_025\",\n      \"name\": \"Coarse-grained thermal deamination loss of serine\",\n      \"inputs\": [\"mol_014\"],\n      \"outputs\": [\"mol_027\", \"mol_003\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"398-448 K\",\n        \"pressure\": \"10-20 bar, sufficient to retain liquid water\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Anoxic hydrothermal exposure, approximately pH 8. Aubrey et al. observed transient serine maxima near 398 K followed by decay; their high-concentration mixed-feed assays do not establish a pure-serine rate law for this edge. This is a loss scenario, not a required productive transfer.\"\n      },\n      \"mechanism\": \"Balanced net: C3H7NO3 -> C3H4O3 + NH3. A possible sequence is dehydration to an aminoacrylate/enamine, followed by imine hydrolysis. This coarse-grained channel does not assert that pyruvate is the sole or dominant measured degradation product.\",\n      \"reasoning\": \"Aubrey et al. (2009) demonstrate serine's transient behavior in hydrothermal mixtures, and Sato et al. (2004) show substantial high-temperature serine instability. They support a degradation constraint rather than a unique pyruvate product distribution. The specific net channel is chemically plausible but its branching fraction is unmeasured; alanine formation, retro-aldol chemistry and other losses can also occur.\"\n    },\n    {\n      \"id\": \"rxn_026\",\n      \"name\": \"Formaldehyde sequestration by residual hydroxylamine\",\n      \"inputs\": [\"mol_002\", \"mol_020\"],\n      \"outputs\": [\"mol_028\", \"mol_004\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-330 K\",\n        \"pressure\": \"Approximately 1 bar\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Any mixing zone where hydroxylamine from the oxime-reduction branch survives until formaldehyde addition. The rate depends on pH and free hydroxylamine activity. This competing channel remains active unless the depletion gate in rxn_016 is demonstrated.\"\n      },\n      \"mechanism\": \"Balanced equation: CH2O + H3NO -> CH3NO + H2O. Hydroxylamine condenses with formaldehyde to form formaldoxime, removing the C1 donor needed for serine hydroxymethylation.\",\n      \"reasoning\": \"This is established oxime chemistry but a speculative, unmeasured compatibility edge in the proposed combined network. Muchowska et al. (2019) support the upstream use of hydroxylamine, not compatibility with the formaldehyde-dependent reaction of Akabori et al. (1959). Explicitly representing this competitor prevents the Fe/hydroxylamine pathway from assuming an unjustified clean handoff.\"\n    },\n    {\n      \"id\": \"rxn_027\",\n      \"name\": \"Competing cyanohydrin trapping of glycolaldehyde\",\n      \"inputs\": [\"mol_007\", \"mol_001\"],\n      \"outputs\": [\"mol_031\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-320 K\",\n        \"pressure\": \"Approximately 1 bar\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Cyanide-bearing aldehyde pools, particularly before sufficient ammonia-dependent imine formation. Cyanohydrin formation is reversible, so this is a competing reservoir rather than an established irreversible sink. Quantitative partitioning among free aldehyde, hydrate, sulfite adduct, cyanohydrin and aminonitrile must be measured.\"\n      },\n      \"mechanism\": \"Balanced equation: C2H4O2 + HCN -> C3H5NO2. Cyanide addition to glycolaldehyde gives glyceronitrile instead of the nitrogen-bearing Strecker product.\",\n      \"reasoning\": \"Xu et al. (2018) report glyceronitrile as 40% of the products at the cited one-hour endpoint. This observation is why their 68% total reduced-product yield cannot be assigned directly to serine-available glycolaldehyde. Ritson and Sutherland (2013) and Foden et al. (2020) support ammonia-dependent diversion toward aminonitriles, but do not remove the need to quantify this competing equilibrium.\"\n    }\n  ],\n  \"pathways\": [\n    {\n      \"pathway_id\": \"P1\",\n      \"name\": \"Copper-assisted cyanosulfidic glycolaldehyde-Strecker route\",\n      \"description\": \"Formaldehyde and HCN give glycolonitrile; timed Cu(I)/sulfide photoreduction supplies glycolaldehyde, followed by shaded Strecker capture and explicitly staged nitrile-to-amide-to-serine hydrolysis. Component chemistry is strongly supported, but mild hydrolysis rates and material recovery are unvalidated.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_002\", \"rxn_007\", \"rxn_008\", \"rxn_009\"],\n      \"key_intermediates\": [\"mol_006\", \"mol_007\", \"mol_012\", \"mol_013\"]\n    },\n    {\n      \"pathway_id\": \"P2\",\n      \"name\": \"Copper-free cyanosulfidic glycolaldehyde-Strecker route\",\n      \"description\": \"Uses the copper-independent sulfide photochemical channel before the same Strecker and hydrolysis sequence. This is a distinct catalyst-regime graph path, not a new carbon-skeleton disconnection. Its irradiation window and productive yield cannot be copied from P1.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_003\", \"rxn_007\", \"rxn_008\", \"rxn_009\"],\n      \"key_intermediates\": [\"mol_006\", \"mol_007\", \"mol_012\", \"mol_013\"]\n    },\n    {\n      \"pathway_id\": \"P3\",\n      \"name\": \"Cyanosulfitic adduct-release and Strecker route\",\n      \"description\": \"Ferrocyanide/sulfite photochemistry creates an aldehyde-bisulfite reservoir. Adduct dissociation and ammonia-dependent capture must compete successfully with renewed sulfite and cyanide trapping before hydrolysis to serine. The adduct is demonstrated; the integrated serine-producing handoff is conditional.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_004\", \"rxn_005\", \"rxn_007\", \"rxn_008\", \"rxn_009\"],\n      \"key_intermediates\": [\"mol_006\", \"mol_010\", \"mol_007\", \"mol_012\", \"mol_013\"]\n    },\n    {\n      \"pathway_id\": \"P4\",\n      \"name\": \"Conditional formose-fed glycolaldehyde-Strecker route\",\n      \"description\": \"A low-confidence net formose C2-supply branch feeds established glycolaldehyde Strecker chemistry. Seed-free initiation, competing sugar chemistry, mild hydrolysis and serine recovery are unresolved. No glycolaldehyde seed or target recycling is hidden in the route.\",\n      \"reaction_sequence\": [\"rxn_006\", \"rxn_007\", \"rxn_008\", \"rxn_009\"],\n      \"key_intermediates\": [\"mol_007\", \"mol_012\", \"mol_013\"]\n    },\n    {\n      \"pathway_id\": \"P5\",\n      \"name\": \"Strecker glycine followed by copper-catalysed hydroxymethylation\",\n      \"description\": \"Formaldehyde Strecker chemistry supplies aminoacetonitrile, which is hydrolysed through glycinamide. After cooling, pH adjustment and demonstrated depletion of labile cyanide, copper-glycinate catalyses addition of a further formaldehyde equivalent. Copper availability and hydrolysis recovery remain conditional.\",\n      \"reaction_sequence\": [\"rxn_010\", \"rxn_011\", \"rxn_012\", \"rxn_018\"],\n      \"key_intermediates\": [\"mol_015\", \"mol_016\", \"mol_017\"]\n    },\n    {\n      \"pathway_id\": \"P6\",\n      \"name\": \"Strecker glycine followed by low-confidence alkaline hydroxymethylation\",\n      \"description\": \"Uses the same independently supplied glycine sequence as P5 but the reported mixed-product alkaline channel without deliberately added copper or pyridoxal. This avoids assuming a copper catalyst supply while accepting much weaker kinetic and selectivity evidence.\",\n      \"reaction_sequence\": [\"rxn_010\", \"rxn_011\", \"rxn_012\", \"rxn_019\"],\n      \"key_intermediates\": [\"mol_015\", \"mol_016\", \"mol_017\"]\n    },\n    {\n      \"pathway_id\": \"P7\",\n      \"name\": \"Nickel/H2 glycine followed by copper-catalysed hydroxymethylation\",\n      \"description\": \"Experimentally supported glyoxylate reductive amination supplies glycine in a confined H2-bearing mineral-interface compartment. Nickel grains must remain upstream and H2 must be released before formaldehyde and copper are encountered. No pyridoxal is used. The sequential environmental operation and glycine recovery have not been demonstrated.\",\n      \"reaction_sequence\": [\"rxn_013\", \"rxn_018\"],\n      \"key_intermediates\": [\"mol_017\"]\n    },\n    {\n      \"pathway_id\": \"P8\",\n      \"name\": \"Nickel/H2 glycine followed by low-confidence alkaline hydroxymethylation\",\n      \"description\": \"Pairs demonstrated nickel-catalysed glycine production with the weak alkaline serine-forming channel. Grain retention and H2 degassing remain necessary because residual hydrogenation activity would consume formaldehyde even without copper addition.\",\n      \"reaction_sequence\": [\"rxn_013\", \"rxn_019\"],\n      \"key_intermediates\": [\"mol_017\"]\n    },\n    {\n      \"pathway_id\": \"P9\",\n      \"name\": \"Iron/oxime glycine with explicit conditioning before copper hydroxymethylation\",\n      \"description\": \"Glyoxylate oxime formation and Fe0 reduction supply glycine. The sequence includes required parallel conditioning operations: reductive exhaustion of residual hydroxylamine and carbonate removal of dissolved iron, with Fe0 grains retained upstream. The reaction list is a dependency-respecting execution sequence, not a claim that every cleanup reaction carries the carbon skeleton. Copper hydroxymethylation is allowed only after these compatibility gates and glycine recovery are demonstrated.\",\n      \"reaction_sequence\": [\"rxn_014\", \"rxn_015\", \"rxn_016\", \"rxn_017\", \"rxn_018\"],\n      \"key_intermediates\": [\"mol_021\", \"mol_017\", \"mol_023\"]\n    },\n    {\n      \"pathway_id\": \"P10\",\n      \"name\": \"Iron/oxime glycine with explicit conditioning before alkaline hydroxymethylation\",\n      \"description\": \"Uses the same oxime-reduction and conditioning sequence as P9, followed by the lower-confidence alkaline channel without deliberately added copper or pyridoxal. Hydroxylamine exhaustion is still essential because formaldehyde trapping does not depend on the final catalyst. This pathway combines experimentally grounded component chemistry with speculative handoffs and weakly quantified final selectivity.\",\n      \"reaction_sequence\": [\"rxn_014\", \"rxn_015\", \"rxn_016\", \"rxn_017\", \"rxn_019\"],\n      \"key_intermediates\": [\"mol_021\", \"mol_017\", \"mol_023\"]\n    }\n  ],\n  \"hub_molecules\": [\n    \"mol_001\",\n    \"mol_002\",\n    \"mol_003\",\n    \"mol_004\",\n    \"mol_005\",\n    \"mol_006\",\n    \"mol_007\",\n    \"mol_014\",\n    \"mol_017\",\n    \"mol_018\",\n    \"mol_020\",\n    \"mol_022\",\n    \"mol_023\",\n    \"mol_024\"\n  ],\n  \"convergence_points\": [\n    {\n      \"molecule_id\": \"mol_007\",\n      \"incoming_reactions\": [\"rxn_002\", \"rxn_003\", \"rxn_005\", \"rxn_006\"],\n      \"outgoing_reactions\": [\"rxn_007\", \"rxn_020\", \"rxn_027\"]\n    },\n    {\n      \"molecule_id\": \"mol_017\",\n      \"incoming_reactions\": [\"rxn_012\", \"rxn_013\", \"rxn_015\", \"rxn_021\", \"rxn_022\"],\n      \"outgoing_reactions\": [\"rxn_018\", \"rxn_019\"]\n    },\n    {\n      \"molecule_id\": \"mol_014\",\n      \"incoming_reactions\": [\"rxn_009\", \"rxn_018\", \"rxn_019\"],\n      \"outgoing_reactions\": [\"rxn_021\", \"rxn_022\", \"rxn_023\", \"rxn_024\", \"rxn_025\"]\n    },\n    {\n      \"molecule_id\": \"mol_023\",\n      \"incoming_reactions\": [\"rxn_015\", \"rxn_016\"],\n      \"outgoing_reactions\": [\"rxn_017\"]\n    }\n  ]\n}", "parsed_response": {"target_molecule": "Serine, racemic", "overall_strategy": "A connected, staged synthesis proposal containing ten distinct reaction-sequence pathways: four glycolaldehyde-supply variants feeding Strecker chemistry, and three glycine-supply routes each feeding either copper-catalysed or weakly supported, base-promoted hydroxymethylation. These are ten graph pathways, not ten independently demonstrated prebiotic mechanisms. Experimental support is strongest for individual cyanosulfidic, Strecker and copper-catalysed transformations; formose initiation, uncatalysed hydroxymethylation, mild nitrile hydrolysis and environmental integration remain conditional. Pyridoxal-dependent routes are excluded because a credible prebiotic cofactor supply is missing. Hydroxypyruvate amination is excluded because serine formation has not been demonstrated. All compartments are anoxic. Sulfidic photochemical pools, acidic hydrolysis pools and copper-containing alkaline pools are alternatives or sequentially conditioned compartments, not one homogeneous mixture. Nickel-bearing grains must be retained and hydrogen released before formaldehyde addition; hydroxylamine-bearing routes explicitly include reductant exhaustion and iron-removal operations. These handoffs are physically motivated proposals, not demonstrated quantitative separations. Reported experimental conditions are distinguished from proposed screening conditions in each entry; missing rates and recovery fractions are not invented. No overall yield or net accumulation is claimed. Equations explicitly record stoichiometry, while input and output arrays contain each ID only once. Reference neutral structures are used for organic compounds despite pH-dependent protonation and hydration. Sulfur endpoints are balanced bookkeeping channels rather than established complete product distributions. The intermediate role also covers off-target products because the schema has no byproduct role. environment_formed identifies a reference formation compartment; reaction entries specify alternative formation environments.", "molecules": [{"id": "mol_001", "formula": "HCN", "iupac_name": "hydrogen cyanide", "common_name": "hydrogen cyanide", "inchi": "InChI=1S/CHN/c1-2/h1H", "role": "starting", "environment_formed": null}, {"id": "mol_002", "formula": "CH2O", "iupac_name": "methanal", "common_name": "formaldehyde", "inchi": "InChI=1S/CH2O/c1-2/h1H2", "role": "starting", "environment_formed": null}, {"id": "mol_003", "formula": "NH3", "iupac_name": "azane", "common_name": "ammonia", "inchi": "InChI=1S/H3N/h1H3", "role": "starting", "environment_formed": null}, {"id": "mol_004", "formula": "H2O", "iupac_name": "oxidane", "common_name": "water", "inchi": "InChI=1S/H2O/h1H2", "role": "starting", "environment_formed": null}, {"id": "mol_005", "formula": "H2S", "iupac_name": "sulfane", "common_name": "hydrogen sulfide", "inchi": "InChI=1S/H2S/h1H2", "role": "starting", "environment_formed": null}, {"id": "mol_006", "formula": "C2H3NO", "iupac_name": "2-hydroxyacetonitrile", "common_name": "glycolonitrile", "inchi": "InChI=1S/C2H3NO/c3-1-2-4/h4H,2H2", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_007", "formula": "C2H4O2", "iupac_name": "2-hydroxyethanal", "common_name": "glycolaldehyde", "inchi": null, "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_008", "formula": "S8", "iupac_name": "cyclooctasulfur", "common_name": "elemental sulfur", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_009", "formula": "HSO3^-", "iupac_name": "hydrogensulfite", "common_name": "bisulfite", "inchi": null, "role": "starting", "environment_formed": null}, {"id": "mol_010", "formula": "C2H5O5S^-", "iupac_name": "1,2-dihydroxyethane-1-sulfonate", "common_name": "glycolaldehyde-bisulfite adduct", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_011", "formula": "S2O6^2-", "iupac_name": "dithionate", "common_name": "dithionate", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_012", "formula": "C3H6N2O", "iupac_name": "2-amino-3-hydroxypropanenitrile", "common_name": "serine aminonitrile", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_013", "formula": "C3H8N2O2", "iupac_name": "2-amino-3-hydroxypropanamide", "common_name": "serinamide", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_014", "formula": "C3H7NO3", "iupac_name": "2-amino-3-hydroxypropanoic acid", "common_name": "serine", "inchi": "InChI=1S/C3H7NO3/c4-2(1-5)3(6)7/h2,5H,1,4H2,(H,6,7)", "role": "target", "environment_formed": "Surface"}, {"id": "mol_015", "formula": "C2H4N2", "iupac_name": "2-aminoacetonitrile", "common_name": "aminoacetonitrile", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_016", "formula": "C2H6N2O", "iupac_name": "2-aminoacetamide", "common_name": "glycinamide", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_017", "formula": "C2H5NO2", "iupac_name": "2-aminoacetic acid", "common_name": "glycine", "inchi": "InChI=1S/C2H5NO2/c3-1-2(4)5/h1,3H2,(H,4,5)", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_018", "formula": "C2H2O3", "iupac_name": "2-oxoacetic acid", "common_name": "glyoxylic acid", "inchi": "InChI=1S/C2H2O3/c3-1-2(4)5/h1H,(H,4,5)", "role": "starting", "environment_formed": null}, {"id": "mol_019", "formula": "H2", "iupac_name": "dihydrogen", "common_name": "hydrogen", "inchi": "InChI=1S/H2/h1H", "role": "starting", "environment_formed": null}, {"id": "mol_020", "formula": "H3NO", "iupac_name": "hydroxylamine", "common_name": "hydroxylamine", "inchi": "InChI=1S/H3NO/c1-2/h2H,1H2", "role": "starting", "environment_formed": null}, {"id": "mol_021", "formula": "C2H3NO3", "iupac_name": "2-(hydroxyimino)acetic acid", "common_name": "glyoxylic acid oxime", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_022", "formula": "Fe", "iupac_name": "iron", "common_name": "native iron", "inchi": "InChI=1S/Fe", "role": "starting", "environment_formed": null}, {"id": "mol_023", "formula": "Fe^2+", "iupac_name": "iron(2+)", "common_name": "ferrous ion", "inchi": "InChI=1S/Fe/q+2", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_024", "formula": "H3O+", "iupac_name": "oxidanium", "common_name": "hydronium", "inchi": "InChI=1S/H2O/h1H2/p+1", "role": "starting", "environment_formed": null}, {"id": "mol_025", "formula": "C2H4O", "iupac_name": "ethanal", "common_name": "acetaldehyde", "inchi": "InChI=1S/C2H4O/c1-2-3/h2H,1H3", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_026", "formula": "C4H9NO4", "iupac_name": "2-amino-3-hydroxy-2-(hydroxymethyl)propanoic acid", "common_name": "alpha-(hydroxymethyl)serine", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_027", "formula": "C3H4O3", "iupac_name": "2-oxopropanoic acid", "common_name": "pyruvic acid", "inchi": "InChI=1S/C3H4O3/c1-2(4)3(5)6/h1H3,(H,5,6)", "role": "intermediate", "environment_formed": "Hydrothermal"}, {"id": "mol_028", "formula": "CH3NO", "iupac_name": "N-methylidenehydroxylamine", "common_name": "formaldoxime", "inchi": "InChI=1S/CH3NO/c1-2-3/h3H,1H2", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_029", "formula": "HCO3^-", "iupac_name": "hydrogencarbonate", "common_name": "bicarbonate", "inchi": null, "role": "starting", "environment_formed": null}, {"id": "mol_030", "formula": "FeCO3", "iupac_name": "iron(II) carbonate", "common_name": "siderite", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_031", "formula": "C3H5NO2", "iupac_name": "2,3-dihydroxypropanenitrile", "common_name": "glyceronitrile", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}], "reactions": [{"id": "rxn_001", "name": "Formaldehyde cyanohydrin formation", "inputs": ["mol_002", "mol_001"], "outputs": ["mol_006"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-310 K", "pressure": "Approximately 1 bar", "catalyst": null, "aqueous": true, "other": "Proposed shaded, anoxic pool at pH 7-9 with approximately 10 mM formaldehyde and 10 mM total cyanide. These concentrations are local feed assumptions, not inferred ocean concentrations. Cyanide speciation, gas loss and competing ammonia chemistry must be measured."}, "mechanism": "Balanced net: CH2O + HCN -> C2H3NO. Cyanide adds to the formaldehyde carbonyl, followed by proton transfer, to form glycolonitrile. The reaction is an equilibrium rather than an irreversible quantitative capture.", "reasoning": "Glycolonitrile is the experimentally used entry substrate for reductive homologation in Ritson and Sutherland (2013), and cyanohydrin formation underlies the integrated network of Patel et al. (2015). Concentrated HCN supply and retention remain geochemical constraints; this entry does not claim that dilute open-ocean feedstocks reach the stated concentrations."}, {"id": "rxn_002", "name": "Copper-assisted cyanosulfidic reduction of glycolonitrile", "inputs": ["mol_006", "mol_005", "mol_004"], "outputs": ["mol_007", "mol_003", "mol_008"], "environment": "Surface", "agents": ["Copper(I) cyanide and dissolved cyanocuprate(I) photoredox species"], "conditions": {"temperature": "Approximately 300 K", "pressure": "Approximately 1 bar", "catalyst": "CuCN/cyanocuprate(I)", "aqueous": true, "other": "Reported assay: 10 mM glycolonitrile, 30 mM H2S, 33 mM phosphate, 10 mol% CuCN, pH 7 and 254 nm irradiation; glycolaldehyde hydrate reached 42% at 2 h. A shallow illuminated compartment is followed by shaded drainage or interruption of irradiation near the measured maximum. Natural photon flux, optical depth and drainage recovery are unquantified."}, "mechanism": "Balanced formal sulfur-endpoint equation: 8 C2H3NO + 8 H2S + 8 H2O -> 8 C2H4O2 + 8 NH3 + S8. Photogenerated reducing equivalents reduce the nitrile through imine-level intermediates; hydrolysis releases glycolaldehyde. S8 represents a net zero-valent-sulfur endpoint, not a measured exclusive sulfur product.", "reasoning": "Ritson and Sutherland (2013) directly demonstrated the aldehyde-forming chemistry and the 42% two-hour yield. Patel et al. (2015) support staged integration. Continued irradiation promotes loss through rxn_020. Ranjan et al. (2018) identify local sulfide availability as a constraint; phosphate and copper concentrations also require local justification. The laboratory irradiation time must not be transferred directly to sunlight exposure."}, {"id": "rxn_003", "name": "Copper-free cyanosulfidic photoreduction", "inputs": ["mol_006", "mol_005", "mol_004"], "outputs": ["mol_007", "mol_003", "mol_008"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-310 K", "pressure": "Approximately 1 bar", "catalyst": null, "aqueous": true, "other": "Proposed comparison: 10 mM glycolonitrile, 30 mM total sulfide, phosphate-buffered pH near 7, 254 nm irradiation and no intentionally added copper. Screen exposure times rather than importing the two-hour copper-assisted optimum. Trace-metal contamination and sulfur-product light screening require controls."}, "mechanism": "Balanced formal endpoint: 8 C2H3NO + 8 H2S + 8 H2O -> 8 C2H4O2 + 8 NH3 + S8. Sulfide photochemistry supplies reducing equivalents without the copper acceleration. The microscopic reduction sequence and sulfur distribution need not match the copper-assisted system.", "reasoning": "Ritson and Sutherland (2013), as summarized in the supplied research, support copper-independent photoreduction with slower chemistry. This is a catalyst-regime alternative, not an independent carbon-skeleton mechanism. No matched serine yield or copper-free rate is supplied, so the 42% copper-assisted yield is not assigned to this edge."}, {"id": "rxn_004", "name": "Cyanosulfitic photoreduction with aldehyde trapping", "inputs": ["mol_006", "mol_009", "mol_004"], "outputs": ["mol_010", "mol_003", "mol_011"], "environment": "Surface", "agents": ["Ferrocyanide, [Fe(CN)6]4-, as a photoredox mediator"], "conditions": {"temperature": "300-310 K", "pressure": "Approximately 1 bar", "catalyst": "Ferrocyanide", "aqueous": true, "other": "UV-illuminated, anoxic sulfite-bearing pool. Proposed screening values, not verified original assay values: 10 mM glycolonitrile, 30-100 mM total dissolved S(IV), 0.1-1 mM ferrocyanide and pH 7-9. Bisulfite is the proton-balanced reference species for the sulfite/bisulfite pool. The reported comparison endpoint was 1 h."}, "mechanism": "Balanced illustrative channel: C2H3NO + 3 HSO3^- + H2O -> C2H5O5S^- + NH3 + S2O6^2-. Two S(IV) equivalents formally supply two electrons through oxidation to dithionate; another traps the aldehyde as its bisulfite adduct. Dithionate is a provisional balanced radical-recombination endpoint, not a quantified exclusive coproduct.", "reasoning": "Xu et al. (2018) reported 68% total reduced products after one hour, including 28% glycolaldehyde-sulfite adduct and 40% glyceronitrile. Those percentages are not free-glycolaldehyde or serine yields. This edge models the observed adduct branch; rxn_027 represents competing cyanohydrin capture. The proposed sulfur bookkeeping and environmental concentrations require direct verification."}, {"id": "rxn_005", "name": "Release of glycolaldehyde from its bisulfite adduct", "inputs": ["mol_010"], "outputs": ["mol_007", "mol_009"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-320 K", "pressure": "Approximately 1 bar", "catalyst": null, "aqueous": true, "other": "Proposed shaded downstream mixing zone at pH 8-9.5. Test modest dilution and immediate capture of released aldehyde by excess ammonia and cyanide in rxn_007. Sulfite remains in solution; this operation is not represented as a demonstrated quantitative sulfite separation."}, "mechanism": "Balanced equilibrium: C2H5O5S^- -> C2H4O2 + HSO3^-. Reversible carbonyl-bisulfite adduct dissociation exposes the aldehyde; consumption of free aldehyde can pull the equilibrium.", "reasoning": "Xu et al. (2018) establish the trapped aldehyde pool, not a complete serine-producing handoff. Adduct dissociation is established carbonyl chemistry, but its integration here is speculative: the free-aldehyde fraction, dissociation rate and competition with continued sulfite trapping have not been demonstrated under the proposed conditions."}, {"id": "rxn_006", "name": "Conditional net C2 production within formose chemistry", "inputs": ["mol_002"], "outputs": ["mol_007"], "environment": "Surface", "agents": ["Calcium hydroxide as an alkaline calcium source"], "conditions": {"temperature": "320-350 K", "pressure": "Approximately 1 bar", "catalyst": "Alkaline calcium-containing medium", "aqueous": true, "other": "Proposed carbonate-poor alkaline pool, pH 10-11, with locally concentrated formaldehyde at 10-100 mM. No externally supplied glycolaldehyde seed is assumed. Measure initiation separately from autocatalytic growth; cool and lower pH before Strecker capture. These are screening conditions, not a reported selective glycolaldehyde preparation."}, "mechanism": "Formal carbon balance for the selected C2 branch: 2 CH2O -> C2H4O2. This is a coarse-grained formose-network edge, not an elementary base-catalysed aldol of two formaldehyde molecules. Initiation without a C2 seed remains unresolved, and competing Cannizzaro and higher-sugar reactions are expected.", "reasoning": "This is a speculative de novo supply branch within classical formose chemistry. The supplied research does not establish selective glycolaldehyde production or an integrated serine yield. Weber (1998) is a negative constraint: aldehydes, ammonia and thiol did not yield reported serine without cyanide. The branch is retained as a testable alternative, not as an established replacement for photoreduction."}, {"id": "rxn_007", "name": "Glycolaldehyde Strecker conversion to serine aminonitrile", "inputs": ["mol_007", "mol_001", "mol_003"], "outputs": ["mol_012", "mol_004"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-320 K", "pressure": "Approximately 1 bar", "catalyst": null, "aqueous": true, "other": "Shaded anoxic pool after irradiation has stopped. Proposed concentrations: 1-10 mM glycolaldehyde equivalents, comparable or modestly excess total cyanide and 0.05-0.2 M total ammonia, pH 8-9.5. The reported network developed aminonitriles over days to weeks. The proposed concentrations are not a verified reconstruction of the Foden assay. Avoid acylating or formylating reagents that divert Ser-CN toward elimination products."}, "mechanism": "Balanced net: C2H4O2 + HCN + NH3 -> C3H6N2O + H2O. Ammonia forms an imine or iminium intermediate, followed by cyanide addition. Attack on either face gives racemic serine aminonitrile. Cyanohydrin formation in rxn_027 competes with productive imine capture.", "reasoning": "Ritson and Sutherland (2013) report formation of the relevant aminonitriles, and Foden et al. (2020) describe glycolaldehyde-to-Ser-CN conversion in excellent yield without a retrieved numerical value. This is the strongest serine-specific skeleton-forming edge in the supplied record. Residual reductive irradiation must stop, and concentrated ammonia availability remains a local requirement."}, {"id": "rxn_008", "name": "Hydration of serine aminonitrile to serinamide", "inputs": ["mol_012", "mol_004"], "outputs": ["mol_013"], "environment": "Surface", "agents": ["Hydronium in a volcanic mineral-acid pool"], "conditions": {"temperature": "350-365 K", "pressure": "Approximately 1 bar", "catalyst": "Hydronium", "aqueous": true, "other": "Proposed shaded, chloride-acidified geothermal pool at pH 1-2.5 with 1-10 mM aminonitrile. Screen residence times from one day to several weeks while measuring nitrile, amide, serine and degradation products. Volcanic HCl is a possible acid source without molecular oxygen. No hydrolysis rate or quantitative transfer recovery is assumed."}, "mechanism": "Balanced net: C3H6N2O + H2O -> C3H8N2O2. Acid-catalysed nitrile hydration gives the amide through protonated nitrile and imidic intermediates. Acid is catalytic in the reference neutral-species equation.", "reasoning": "This resolves the standard Strecker hydrolysis into its kinetically important amide intermediate. Ritson and Sutherland (2013) and Foden et al. (2020) support aminonitrile availability, but do not establish the proposed mild hydrolysis schedule. The environmental implementation is speculative and necessary to distinguish Ser-CN formation from demonstrated free-serine production."}, {"id": "rxn_009", "name": "Serinamide hydrolysis to free serine", "inputs": ["mol_013", "mol_004"], "outputs": ["mol_014", "mol_003"], "environment": "Surface", "agents": ["Hydronium in the same mineral-acid hydrolysis compartment"], "conditions": {"temperature": "350-365 K", "pressure": "Approximately 1 bar", "catalyst": "Hydronium", "aqueous": true, "other": "Proposed pH 1-2.5, 1-10 mM amide and a monitored residence of days to weeks. Ammonia is predominantly ammonium at this pH. Cool toward 300 K promptly after the serine maximum; do not assume that indefinite heating completes hydrolysis without destruction."}, "mechanism": "Balanced reference-species equation: C3H8N2O2 + H2O -> C3H7NO3 + NH3. Addition to the protonated amide carbonyl and C-N cleavage produce serine and ammonium after solution protonation equilibria.", "reasoning": "Amide hydrolysis is conventional chemistry, but its rate and serine recovery under these proposed prebiotic conditions are speculative. The supplied Ser-CN studies do not supply this missing kinetic record. Aubrey et al. (2009) and Sato et al. (2004) establish why hydrolysis must be evaluated against serine degradation rather than treated as automatically quantitative."}, {"id": "rxn_010", "name": "Formaldehyde Strecker conversion to aminoacetonitrile", "inputs": ["mol_002", "mol_001", "mol_003"], "outputs": ["mol_015", "mol_004"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-320 K", "pressure": "Approximately 1 bar", "catalyst": null, "aqueous": true, "other": "Proposed sulfur-free, shaded pool with 10 mM formaldehyde, approximately 10 mM cyanide and 0.05-0.2 M total ammonia, pH 8-9.5. Permit days-to-weeks screening, not an assumed fixed conversion time. Glycolonitrile and hexamethylenetetramine-type chemistry can compete."}, "mechanism": "Balanced net: CH2O + HCN + NH3 -> C2H4N2 + H2O. Formaldehyde-ammonia imine formation followed by cyanide addition produces aminoacetonitrile.", "reasoning": "Ritson and Sutherland (2013) report conversion of formaldehyde-containing mixtures to the glycine aminonitrile after addition of HCN and ammonia. This provides a chemically simple glycine supply independent of glycolaldehyde. Exact yields and rates for the proposed compartment are unavailable."}, {"id": "rxn_011", "name": "Aminoacetonitrile hydration to glycinamide", "inputs": ["mol_015", "mol_004"], "outputs": ["mol_016"], "environment": "Surface", "agents": ["Hydronium from volcanic mineral acid"], "conditions": {"temperature": "350-365 K", "pressure": "Approximately 1 bar", "catalyst": "Hydronium", "aqueous": true, "other": "Proposed shaded hydrolysis pool at pH 1-2.5 with 1-10 mM aminoacetonitrile. Quantify amide accumulation during days-to-weeks screening. Acidification can release residual unreacted HCN to the gas phase; neither cyanide retention nor carbon recovery is assumed quantitative."}, "mechanism": "Balanced net: C2H4N2 + H2O -> C2H6N2O. Acid-catalysed hydration converts the nitrile to glycinamide.", "reasoning": "This is the conventional first hydrolysis stage of the Strecker glycine route supported upstream by Ritson and Sutherland (2013). The selected environmental conditions and residence time are speculative because the supplied research does not provide their rate constants. An explicit amide node prevents the network from hiding the hydrolysis bottleneck."}, {"id": "rxn_012", "name": "Glycinamide hydrolysis to glycine", "inputs": ["mol_016", "mol_004"], "outputs": ["mol_017", "mol_003"], "environment": "Surface", "agents": ["Hydronium from volcanic mineral acid"], "conditions": {"temperature": "350-365 K", "pressure": "Approximately 1 bar", "catalyst": "Hydronium", "aqueous": true, "other": "Proposed pH 1-2.5 and monitored days-to-weeks residence. Before hydroxymethylation, cool to 300-330 K and move into a carbonate-buffered alkaline compartment. For the copper branch, labile cyanide must be depleted sufficiently to avoid copper-cyanide sequestration. Acid-driven HCN loss is a proposed conditioning mechanism, not demonstrated quantitative purification."}, "mechanism": "Balanced reference-species equation: C2H6N2O + H2O -> C2H5NO2 + NH3. Amide hydrolysis releases glycine and ammonia, with their actual protonation controlled by pH.", "reasoning": "Classical Strecker chemistry provides the molecular precedent; Ritson and Sutherland (2013) establish the upstream aminoacetonitrile. The mild hydrolysis kinetics and subsequent copper-compatible recovery remain speculative. Akabori et al. (1959) support the downstream glycine reaction, not this complete environmental handoff."}, {"id": "rxn_013", "name": "Nickel-catalysed reductive amination of glyoxylate to glycine", "inputs": ["mol_018", "mol_003", "mol_019"], "outputs": ["mol_017", "mol_004"], "environment": "Biochemical", "agents": ["Reduced nickel surfaces; supported Ni/SiO2-Al2O3 is the laboratory benchmark"], "conditions": {"temperature": "295 K laboratory benchmark; approximately 300 K proposed extension", "pressure": "H2 partial pressure approximately 5 bar; total pressure at least 5 bar", "catalyst": "Reduced nickel", "aqueous": true, "other": "Reported benchmark: pH 8, ammonium bicarbonate at five equivalents and 72 h with H2/Ni. Proposed physical setting: cool, confined, H2-bearing mineral-interface porewater, not an exposed ambient-pressure pond. A proposed flow-through implementation retains nickel grains upstream, then depressurizes and degasses the glycine-bearing water before formaldehyde addition. Catalyst loading, native-surface activity, dissolved-metal carryover and glycine recovery must be measured."}, "mechanism": "Balanced net: C2H2O3 + NH3 + H2 -> C2H5NO2 + H2O. Glyoxylate forms an imine with ammonia; nickel activates hydrogen for reduction to glycine.", "reasoning": "Kaur et al. (2024) directly demonstrated glyoxylate-to-glycine conversion with H2 and nickel-based catalysts. Their results do not demonstrate hydroxypyruvate-to-serine conversion, which is therefore omitted. Supported catalyst performance is not automatically assigned to arbitrary natural minerals. Grain retention and H2 removal are chemically necessary to prevent continued hydrogenation of the subsequently supplied formaldehyde, but the integrated recovery has not been demonstrated."}, {"id": "rxn_014", "name": "Formation of glyoxylic acid oxime", "inputs": ["mol_018", "mol_020"], "outputs": ["mol_021", "mol_004"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-343 K", "pressure": "Approximately 1 bar", "catalyst": null, "aqueous": true, "other": "Proposed shaded, anoxic pool at pH 3-5 with 1-10 mM glyoxylate and 0.8-1.0 equivalent hydroxylamine, keeping hydroxylamine limiting. No formaldehyde is introduced at this stage. The supplied report does not give a verified complete concentration and pH record for the original iron/hydroxylamine assay."}, "mechanism": "Balanced net: C2H2O3 + H3NO -> C2H3NO3 + H2O. Hydroxylamine condenses with the glyoxylate carbonyl to form an oxime; no particular E/Z isomer is selected.", "reasoning": "Muchowska et al. (2019) demonstrated amino-acid formation using hydroxylamine and metallic iron. The explicit oxime is a mechanistically inferred intermediate rather than an independently quantified intermediate in the supplied record. A concentrated prebiotic hydroxylamine supply is an additional unresolved requirement, and residual hydroxylamine would trap downstream formaldehyde through rxn_026."}, {"id": "rxn_015", "name": "Stoichiometric native-iron reduction of glyoxylate oxime", "inputs": ["mol_021", "mol_022", "mol_024"], "outputs": ["mol_017", "mol_023", "mol_004"], "environment": "Surface", "agents": ["Native iron grains as a consumed reductant, not a catalyst"], "conditions": {"temperature": "320-343 K", "pressure": "Approximately 1 bar in an anoxic, gas-vented compartment", "catalyst": null, "aqueous": true, "other": "Proposed pH 3-5, 1-10 mM oxime and excess accessible Fe0 surface. Four proton equivalents and two Fe0 equivalents are required by the idealized reduction channel; additional iron can be consumed by acid corrosion. Oxime disappearance, glycine formation and residual hydroxylamine must be assayed. Native Fe0 requires a local metal-bearing source and is not inferred merely from abundant dissolved Fe2+."}, "mechanism": "Balanced equation: C2H3NO3 + 2 Fe + 4 H3O+ -> C2H5NO2 + 2 Fe^2+ + 5 H2O. Four-electron reduction of the oxime, including N-O bond cleavage, gives glycine while iron is oxidized to Fe2+.", "reasoning": "Muchowska et al. (2019) provide experimental precedent for Fe0/hydroxylamine amino-acid production, including glycine. This explicit electron-balanced oxime channel is a mechanistic decomposition of that chemistry; its proposed pH, surface loading and rate are not independently established here. Both metallic iron and hydroxylamine must be removed or exhausted before the hydroxymethylation stage."}, {"id": "rxn_016", "name": "Proposed reductive exhaustion of residual hydroxylamine", "inputs": ["mol_020", "mol_022", "mol_024"], "outputs": ["mol_003", "mol_023", "mol_004"], "environment": "Surface", "agents": ["Native iron retained in the upstream reduction bed"], "conditions": {"temperature": "320-343 K", "pressure": "Approximately 1 bar", "catalyst": null, "aqueous": true, "other": "Maintain contact with excess upstream Fe0 after oxime conversion, without formaldehyde present. Transfer is conditional on demonstrated depletion of hydroxylamine, not simply elapsed time. A proposed screening gate is residual hydroxylamine below 1% of the subsequently introduced formaldehyde concentration; this is an operational test criterion, not a demonstrated geological purification efficiency."}, "mechanism": "Balanced equation: H3NO + Fe + 2 H3O+ -> NH3 + Fe^2+ + 3 H2O. Iron supplies two electrons for reductive N-O cleavage.", "reasoning": "This is a speculative compatibility operation motivated by the reducing Fe0/hydroxylamine system of Muchowska et al. (2019), not a reported validated cleanup stage from that study. It addresses the specific risk that residual hydroxylamine consumes formaldehyde. If depletion cannot be shown while retaining glycine, pathways P9 and P10 are not operationally closed."}, {"id": "rxn_017", "name": "Proposed anoxic removal of dissolved iron as siderite", "inputs": ["mol_023", "mol_029", "mol_004"], "outputs": ["mol_030", "mol_024"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-330 K", "pressure": "Approximately 1 bar", "catalyst": null, "aqueous": true, "other": "Proposed downstream carbonate-rich settling compartment, pH 7.5-8.5 and 50-100 mM dissolved inorganic carbon, with upstream Fe0 grains physically retained. Siderite supersaturation must be established using activities, not total concentrations alone. Allow only measured precipitation and sediment retention; nucleation delay and glycine adsorption or coprecipitation are unresolved."}, "mechanism": "Balanced reference-species equation: Fe^2+ + HCO3^- + H2O -> FeCO3 + H3O+. Carbonate precipitation lowers dissolved Fe2+ without introducing molecular oxygen. Buffering must accommodate the released acidity.", "reasoning": "This is a speculative network-integration step based on ordinary anoxic carbonate geochemistry; the supplied studies do not demonstrate this handoff. It is included because the iron-containing product mixture of Muchowska et al. (2019) cannot simply be assumed equivalent to a clean glycine solution for Akabori et al. (1959). Iron removal, metal carryover and glycine recovery require separate measurements."}, {"id": "rxn_018", "name": "Copper-glycinate-catalysed hydroxymethylation to serine", "inputs": ["mol_017", "mol_002"], "outputs": ["mol_014"], "environment": "Surface", "agents": ["Dissolved copper(II)-glycinate complexes in alkaline solution"], "conditions": {"temperature": "300-350 K proposed screening range", "pressure": "Approximately 1 bar", "catalyst": "Copper(II)-glycinate", "aqueous": true, "other": "Proposed shaded, sulfur-poor alkaline pool: 10 mM glycine, 10-20 mM formaldehyde, 0.1-1 mM total Cu(II), pH 8.5-10. These are design values, not verified Akabori assay values. Glycinate complexation must keep an active dissolved copper population despite hydroxide precipitation. Exclude residual sulfide, substantial labile cyanide, Fe0, active nickel/H2 and hydroxylamine. A local Cu(II) inventory and its lifetime under anoxia remain conditional. Measure forward, retro-aldol and over-addition rates."}, "mechanism": "Balanced net: C2H5NO2 + CH2O -> C3H7NO3. Copper coordination enables alpha-carbon activation of glycinate, C-C addition to formaldehyde and protonation to racemic serine. Reverse cleavage and a second hydroxymethylation are represented separately.", "reasoning": "Akabori et al. (1959) directly reported preparative DL-serine from glycine and formaldehyde with catalytic copper sulfate in alkaline water. No numerical yield or complete experimental condition record was retrieved in the supplied research. Anoxia does not prohibit Cu(II), but neither its supply nor persistence in reducing, sulfidic water can be presumed. Sulfur-free staging, metal speciation and substrate recovery are explicit feasibility gates rather than claimed solved separations."}, {"id": "rxn_019", "name": "Low-confidence alkaline hydroxymethylation without deliberately added copper or pyridoxal", "inputs": ["mol_017", "mol_002"], "outputs": ["mol_014"], "environment": "Surface", "agents": ["Aqueous base; no deliberately added transition-metal or pyridoxal catalyst"], "conditions": {"temperature": "300-330 K proposed screening range", "pressure": "Approximately 1 bar", "catalyst": "Base-promoted reaction network; active microscopic catalyst is unresolved", "aqueous": true, "other": "Reported concentration basis: 10 mM glycine and glycine:formaldehyde ratio 1:2. Proposed pH 8.5-10 in a shaded alkaline pool and monitoring over days to weeks. Original serine yield, rate and trace-metal inventory are unavailable. No catalytic benefit is assigned to clay. Hydroxylamine and active hydrogenation catalysts must still be depleted before formaldehyde addition."}, "mechanism": "Balanced selected-product channel: C2H5NO2 + CH2O -> C3H7NO3. The experiment reports hydroxymethylation within a multichannel alkaline mixture; a fast elementary reaction of free glycine carbanion with formaldehyde is not assumed.", "reasoning": "Chadha and Choughuley (1984) report serine together with hydroxymethylserine, sarcosine, iminodiacetic acid and alanine under dilute mildly alkaline conditions. This supports a mixed-product channel, not an efficient catalyst-free synthesis. The high uncatalysed coupling barriers summarized in the supplied 2024 computational study reinforce the kinetic uncertainty. This lower-confidence alternative avoids an assumed prebiotic pyridoxal supply but must not be assigned the efficiency of Akabori et al. (1959)."}, {"id": "rxn_020", "name": "Competing photoreductive loss of glycolaldehyde to acetaldehyde", "inputs": ["mol_007", "mol_005"], "outputs": ["mol_025", "mol_004", "mol_008"], "environment": "Surface", "agents": ["CuCN/cyanocuprate(I) photoredox species"], "conditions": {"temperature": "Approximately 300 K", "pressure": "Approximately 1 bar", "catalyst": "CuCN/cyanocuprate(I)", "aqueous": true, "other": "Same sulfide-containing irradiated compartment as rxn_002. The reported product distribution shifted strongly toward acetaldehyde with prolonged irradiation between 2 and 6 h. This laboratory interval is not a calibrated natural-sunlight residence time."}, "mechanism": "Balanced formal endpoint: 8 C2H4O2 + 8 H2S -> 8 C2H4O + 8 H2O + S8. Net reductive deoxygenation removes the hydroxymethyl oxygen, destroying the aldehyde required for serine synthesis.", "reasoning": "Ritson and Sutherland (2013) directly document over-reduction and identify it as a threat to glycolaldehyde-dependent serine chemistry. This edge makes irradiation control an actual competition rather than an unqualified productive step. Its rate relative to rxn_002 must be measured for each light field; the S8 endpoint remains formal sulfur bookkeeping."}, {"id": "rxn_021", "name": "Copper-associated retro-aldol loss of serine", "inputs": ["mol_014"], "outputs": ["mol_017", "mol_002"], "environment": "Surface", "agents": ["Copper(II)-glycinate/serinate complexes"], "conditions": {"temperature": "300-350 K", "pressure": "Approximately 1 bar", "catalyst": "Copper(II)-amino-acid complexes", "aqueous": true, "other": "Same copper-bearing alkaline compartment as rxn_018. The reverse coefficient and equilibrium composition are unknown under the proposed dilute conditions. Cooling and shortening post-formation residence are proposed retention measures, not quantified stabilization procedures."}, "mechanism": "Balanced equation: C3H7NO3 -> C2H5NO2 + CH2O. Metal-assisted C-C cleavage reverses hydroxymethylation.", "reasoning": "The supplied research describes the glycine/formaldehyde-serine chemistry as reversible. Akabori et al. (1959) support copper-promoted synthesis, while Metzler, Longenecker and Snell (1954) directly support reversibility in pyridoxal-metal systems. The latter does not establish a numerical copper-only reverse rate; this edge is a necessary kinetic possibility, not a transferred rate constant."}, {"id": "rxn_022", "name": "Unquantified alkaline retro-aldol background", "inputs": ["mol_014"], "outputs": ["mol_017", "mol_002"], "environment": "Surface", "agents": ["Aqueous base"], "conditions": {"temperature": "300-330 K", "pressure": "Approximately 1 bar", "catalyst": "Base; microscopic catalytic pathway unresolved", "aqueous": true, "other": "Proposed pH 8.5-10 with no deliberately added copper or pyridoxal. Include in kinetic testing of rxn_019 rather than assuming the background synthesis channel is irreversible. No measurable ambient-temperature rate is asserted."}, "mechanism": "Balanced equation: C3H7NO3 -> C2H5NO2 + CH2O. This is the formal reverse C-C cleavage channel of alkaline hydroxymethylation.", "reasoning": "This rate-bearing edge is speculative. Chadha and Choughuley (1984) support a multichannel alkaline product network, but do not provide a reverse rate in the supplied account. Metzler, Longenecker and Snell (1954) establish retro-aldol feasibility with stronger catalysis, not its speed without those catalysts. The edge prevents unjustified irreversible accumulation in the weakly supported base branch."}, {"id": "rxn_023", "name": "Copper-promoted over-hydroxymethylation of serine", "inputs": ["mol_014", "mol_002"], "outputs": ["mol_026"], "environment": "Surface", "agents": ["Copper(II)-amino-acid complexes"], "conditions": {"temperature": "300-350 K", "pressure": "Approximately 1 bar", "catalyst": "Copper(II)-amino-acid complexes", "aqueous": true, "other": "Same compartment as rxn_018; favored as a competing channel when formaldehyde remains available after serine forms. Quantify selectivity against formaldehyde exposure and residence time rather than assuming excess aldehyde improves serine yield."}, "mechanism": "Balanced equation: C3H7NO3 + CH2O -> C4H9NO4. A second alpha-carbon hydroxymethylation replaces serine's remaining alpha hydrogen and creates alpha-(hydroxymethyl)serine.", "reasoning": "Akabori et al. (1959) identify alpha-(hydroxymethyl)serine as a coproduct of copper-catalysed synthesis. This is therefore a experimentally motivated selectivity limit. Its rate and yield under the proposed geochemical concentrations are unavailable."}, {"id": "rxn_024", "name": "Over-hydroxymethylation in the weak alkaline product network", "inputs": ["mol_014", "mol_002"], "outputs": ["mol_026"], "environment": "Surface", "agents": ["Aqueous base; unidentified trace catalytic contributions are not excluded"], "conditions": {"temperature": "300-330 K", "pressure": "Approximately 1 bar", "catalyst": "Alkaline reaction medium", "aqueous": true, "other": "Same proposed pH 8.5-10 and 10 mM glycine/20 mM initial formaldehyde regime as rxn_019. The reported product identification does not supply a kinetic branching fraction or prove the absence of trace-metal catalysis."}, "mechanism": "Balanced selected-product equation: C3H7NO3 + CH2O -> C4H9NO4. A second hydroxymethylation diverts serine into the over-addition product.", "reasoning": "Chadha and Choughuley (1984) report hydroxymethylserine along with serine in the mildly alkaline mixture. The explicit sequential serine-to-over-addition edge is a mechanistic interpretation of that product relationship; neither its rate nor the exact catalyst responsible was established in the supplied account."}, {"id": "rxn_025", "name": "Coarse-grained thermal deamination loss of serine", "inputs": ["mol_014"], "outputs": ["mol_027", "mol_003"], "environment": "Hydrothermal", "agents": null, "conditions": {"temperature": "398-448 K", "pressure": "10-20 bar, sufficient to retain liquid water", "catalyst": null, "aqueous": true, "other": "Anoxic hydrothermal exposure, approximately pH 8. Aubrey et al. observed transient serine maxima near 398 K followed by decay; their high-concentration mixed-feed assays do not establish a pure-serine rate law for this edge. This is a loss scenario, not a required productive transfer."}, "mechanism": "Balanced net: C3H7NO3 -> C3H4O3 + NH3. A possible sequence is dehydration to an aminoacrylate/enamine, followed by imine hydrolysis. This coarse-grained channel does not assert that pyruvate is the sole or dominant measured degradation product.", "reasoning": "Aubrey et al. (2009) demonstrate serine's transient behavior in hydrothermal mixtures, and Sato et al. (2004) show substantial high-temperature serine instability. They support a degradation constraint rather than a unique pyruvate product distribution. The specific net channel is chemically plausible but its branching fraction is unmeasured; alanine formation, retro-aldol chemistry and other losses can also occur."}, {"id": "rxn_026", "name": "Formaldehyde sequestration by residual hydroxylamine", "inputs": ["mol_002", "mol_020"], "outputs": ["mol_028", "mol_004"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-330 K", "pressure": "Approximately 1 bar", "catalyst": null, "aqueous": true, "other": "Any mixing zone where hydroxylamine from the oxime-reduction branch survives until formaldehyde addition. The rate depends on pH and free hydroxylamine activity. This competing channel remains active unless the depletion gate in rxn_016 is demonstrated."}, "mechanism": "Balanced equation: CH2O + H3NO -> CH3NO + H2O. Hydroxylamine condenses with formaldehyde to form formaldoxime, removing the C1 donor needed for serine hydroxymethylation.", "reasoning": "This is established oxime chemistry but a speculative, unmeasured compatibility edge in the proposed combined network. Muchowska et al. (2019) support the upstream use of hydroxylamine, not compatibility with the formaldehyde-dependent reaction of Akabori et al. (1959). Explicitly representing this competitor prevents the Fe/hydroxylamine pathway from assuming an unjustified clean handoff."}, {"id": "rxn_027", "name": "Competing cyanohydrin trapping of glycolaldehyde", "inputs": ["mol_007", "mol_001"], "outputs": ["mol_031"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-320 K", "pressure": "Approximately 1 bar", "catalyst": null, "aqueous": true, "other": "Cyanide-bearing aldehyde pools, particularly before sufficient ammonia-dependent imine formation. Cyanohydrin formation is reversible, so this is a competing reservoir rather than an established irreversible sink. Quantitative partitioning among free aldehyde, hydrate, sulfite adduct, cyanohydrin and aminonitrile must be measured."}, "mechanism": "Balanced equation: C2H4O2 + HCN -> C3H5NO2. Cyanide addition to glycolaldehyde gives glyceronitrile instead of the nitrogen-bearing Strecker product.", "reasoning": "Xu et al. (2018) report glyceronitrile as 40% of the products at the cited one-hour endpoint. This observation is why their 68% total reduced-product yield cannot be assigned directly to serine-available glycolaldehyde. Ritson and Sutherland (2013) and Foden et al. (2020) support ammonia-dependent diversion toward aminonitriles, but do not remove the need to quantify this competing equilibrium."}], "pathways": [{"pathway_id": "P1", "name": "Copper-assisted cyanosulfidic glycolaldehyde-Strecker route", "description": "Formaldehyde and HCN give glycolonitrile; timed Cu(I)/sulfide photoreduction supplies glycolaldehyde, followed by shaded Strecker capture and explicitly staged nitrile-to-amide-to-serine hydrolysis. Component chemistry is strongly supported, but mild hydrolysis rates and material recovery are unvalidated.", "reaction_sequence": ["rxn_001", "rxn_002", "rxn_007", "rxn_008", "rxn_009"], "key_intermediates": ["mol_006", "mol_007", "mol_012", "mol_013"]}, {"pathway_id": "P2", "name": "Copper-free cyanosulfidic glycolaldehyde-Strecker route", "description": "Uses the copper-independent sulfide photochemical channel before the same Strecker and hydrolysis sequence. This is a distinct catalyst-regime graph path, not a new carbon-skeleton disconnection. Its irradiation window and productive yield cannot be copied from P1.", "reaction_sequence": ["rxn_001", "rxn_003", "rxn_007", "rxn_008", "rxn_009"], "key_intermediates": ["mol_006", "mol_007", "mol_012", "mol_013"]}, {"pathway_id": "P3", "name": "Cyanosulfitic adduct-release and Strecker route", "description": "Ferrocyanide/sulfite photochemistry creates an aldehyde-bisulfite reservoir. Adduct dissociation and ammonia-dependent capture must compete successfully with renewed sulfite and cyanide trapping before hydrolysis to serine. The adduct is demonstrated; the integrated serine-producing handoff is conditional.", "reaction_sequence": ["rxn_001", "rxn_004", "rxn_005", "rxn_007", "rxn_008", "rxn_009"], "key_intermediates": ["mol_006", "mol_010", "mol_007", "mol_012", "mol_013"]}, {"pathway_id": "P4", "name": "Conditional formose-fed glycolaldehyde-Strecker route", "description": "A low-confidence net formose C2-supply branch feeds established glycolaldehyde Strecker chemistry. Seed-free initiation, competing sugar chemistry, mild hydrolysis and serine recovery are unresolved. No glycolaldehyde seed or target recycling is hidden in the route.", "reaction_sequence": ["rxn_006", "rxn_007", "rxn_008", "rxn_009"], "key_intermediates": ["mol_007", "mol_012", "mol_013"]}, {"pathway_id": "P5", "name": "Strecker glycine followed by copper-catalysed hydroxymethylation", "description": "Formaldehyde Strecker chemistry supplies aminoacetonitrile, which is hydrolysed through glycinamide. After cooling, pH adjustment and demonstrated depletion of labile cyanide, copper-glycinate catalyses addition of a further formaldehyde equivalent. Copper availability and hydrolysis recovery remain conditional.", "reaction_sequence": ["rxn_010", "rxn_011", "rxn_012", "rxn_018"], "key_intermediates": ["mol_015", "mol_016", "mol_017"]}, {"pathway_id": "P6", "name": "Strecker glycine followed by low-confidence alkaline hydroxymethylation", "description": "Uses the same independently supplied glycine sequence as P5 but the reported mixed-product alkaline channel without deliberately added copper or pyridoxal. This avoids assuming a copper catalyst supply while accepting much weaker kinetic and selectivity evidence.", "reaction_sequence": ["rxn_010", "rxn_011", "rxn_012", "rxn_019"], "key_intermediates": ["mol_015", "mol_016", "mol_017"]}, {"pathway_id": "P7", "name": "Nickel/H2 glycine followed by copper-catalysed hydroxymethylation", "description": "Experimentally supported glyoxylate reductive amination supplies glycine in a confined H2-bearing mineral-interface compartment. Nickel grains must remain upstream and H2 must be released before formaldehyde and copper are encountered. No pyridoxal is used. The sequential environmental operation and glycine recovery have not been demonstrated.", "reaction_sequence": ["rxn_013", "rxn_018"], "key_intermediates": ["mol_017"]}, {"pathway_id": "P8", "name": "Nickel/H2 glycine followed by low-confidence alkaline hydroxymethylation", "description": "Pairs demonstrated nickel-catalysed glycine production with the weak alkaline serine-forming channel. Grain retention and H2 degassing remain necessary because residual hydrogenation activity would consume formaldehyde even without copper addition.", "reaction_sequence": ["rxn_013", "rxn_019"], "key_intermediates": ["mol_017"]}, {"pathway_id": "P9", "name": "Iron/oxime glycine with explicit conditioning before copper hydroxymethylation", "description": "Glyoxylate oxime formation and Fe0 reduction supply glycine. The sequence includes required parallel conditioning operations: reductive exhaustion of residual hydroxylamine and carbonate removal of dissolved iron, with Fe0 grains retained upstream. The reaction list is a dependency-respecting execution sequence, not a claim that every cleanup reaction carries the carbon skeleton. Copper hydroxymethylation is allowed only after these compatibility gates and glycine recovery are demonstrated.", "reaction_sequence": ["rxn_014", "rxn_015", "rxn_016", "rxn_017", "rxn_018"], "key_intermediates": ["mol_021", "mol_017", "mol_023"]}, {"pathway_id": "P10", "name": "Iron/oxime glycine with explicit conditioning before alkaline hydroxymethylation", "description": "Uses the same oxime-reduction and conditioning sequence as P9, followed by the lower-confidence alkaline channel without deliberately added copper or pyridoxal. Hydroxylamine exhaustion is still essential because formaldehyde trapping does not depend on the final catalyst. This pathway combines experimentally grounded component chemistry with speculative handoffs and weakly quantified final selectivity.", "reaction_sequence": ["rxn_014", "rxn_015", "rxn_016", "rxn_017", "rxn_019"], "key_intermediates": ["mol_021", "mol_017", "mol_023"]}], "hub_molecules": ["mol_001", "mol_002", "mol_003", "mol_004", "mol_005", "mol_006", "mol_007", "mol_014", "mol_017", "mol_018", "mol_020", "mol_022", "mol_023", "mol_024"], "convergence_points": [{"molecule_id": "mol_007", "incoming_reactions": ["rxn_002", "rxn_003", "rxn_005", "rxn_006"], "outgoing_reactions": ["rxn_007", "rxn_020", "rxn_027"]}, {"molecule_id": "mol_017", "incoming_reactions": ["rxn_012", "rxn_013", "rxn_015", "rxn_021", "rxn_022"], "outgoing_reactions": ["rxn_018", "rxn_019"]}, {"molecule_id": "mol_014", "incoming_reactions": ["rxn_009", "rxn_018", "rxn_019"], "outgoing_reactions": ["rxn_021", "rxn_022", "rxn_023", "rxn_024", "rxn_025"]}, {"molecule_id": "mol_023", "incoming_reactions": ["rxn_015", "rxn_016"], "outgoing_reactions": ["rxn_017"]}]}, "reasoning": "", "duration_ms": 589987.4954223633, "success": true, "error_message": null}
