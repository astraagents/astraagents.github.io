": ["rxn_001", "rxn_002", "rxn_003", "rxn_012", "rxn_013", "rxn_014", "rxn_015", "rxn_016"], "key_intermediates": ["mol_017", "mol_018", "mol_019", "mol_020"]}, {"pathway_id": "P6", "name": "Alcohol-derived keto-acid precursor followed by hydrogen-driven reductive amination", "description": "Isobutanol supplies the aldehyde conditionally; cyanohydrin chemistry and speculative hydroxy-acid dehydrogenation produce the keto acid. Hydrogen reduction of its ammonia-derived imine gives valine if mineral selectivity is adequate.", "reaction_sequence": ["rxn_004", "rxn_012", "rxn_013", "rxn_014", "rxn_015", "rxn_016"], "key_intermediates": ["mol_007", "mol_018", "mol_019", "mol_020"]}, {"pathway_id": "P7", "name": "Aldol-derived keto-acid precursor followed by iron-driven reductive amination", "description": "The aldol and cyanohydrin sequences conditionally supply alpha-ketoisovalerate. Metallic iron rather than molecular hydrogen provides the net reducing equivalents for the imine-to-valine step. Keto-acid formation and selective iron reduction remain unvalidated.", "reaction_sequence": ["rxn_001", "rxn_002", "rxn_003", "rxn_012", "rxn_013", "rxn_014", "rxn_015", "rxn_017"], "key_intermediates": ["mol_017", "mol_018", "mol_019", "mol_020"]}, {"pathway_id": "P8", "name": "Alcohol-derived keto-acid precursor followed by iron-driven reductive amination", "description": "Candidate alcohol dehydrogenation feeds cyanohydrin-based keto-acid formation. Ammonia introduces nitrogen, and stoichiometric iron oxidation conditionally reduces the imine. This variant does not assume Fe2+ itself is the reducing reagent.", "reaction_sequence": ["rxn_004", "rxn_012", "rxn_013", "rxn_014", "rxn_015", "rxn_017"], "key_intermediates": ["mol_007", "mol_018", "mol_019", "mol_020"]}, {"pathway_id": "P9", "name": "Aldol-derived keto-acid precursor followed by oxime reduction", "description": "The aldol and cyanohydrin sequences conditionally produce alpha-ketoisovalerate. Supplied hydroxylamine fo