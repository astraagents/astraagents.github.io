hi": null, "role": "intermediate", "environment_formed": "Hydrothermal"}, {"id": "mol_019", "formula": "C5H8O3", "iupac_name": "3-methyl-2-oxobutanoic acid", "common_name": "alpha-ketoisovaleric acid", "inchi": "InChI=1S/C5H8O3/c1-3(2)4(6)5(7)8/h3H,1-2H3,(H,7,8)", "role": "hub_intermediate", "environment_formed": "Hydrothermal"}, {"id": "mol_020", "formula": "C5H9NO2", "iupac_name": "2-imino-3-methylbutanoic acid", "common_name": "alpha-iminoisovaleric acid", "inchi": null, "role": "hub_intermediate", "environment_formed": "Hydrothermal"}, {"id": "mol_021", "formula": "Fe", "iupac_name": "iron", "common_name": "native iron", "inchi": "InChI=1S/Fe", "role": "starting", "environment_formed": null}, {"id": "mol_022", "formula": "H+", "iupac_name": "hydron", "common_name": "proton", "inchi": "InChI=1S/p+1", "role": "starting", "environment_formed": null}, {"id": "mol_023", "formula": "Fe2+", "iupac_name": "iron(2+)", "common_name": "ferrous ion", "inchi": "InChI=1S/Fe/q+2", "role": "intermediate", "environment_formed": "Hydrothermal"}, {"id": "mol_024", "formula": "H3NO", "iupac_name": "hydroxylamine", "common_name": "hydroxylamine", "inchi": "InChI=1S/H3NO/c1-2/h2H,1H2", "role": "starting", "environment_formed": null}, {"id": "mol_025", "formula": "C5H9NO3", "iupac_name": "2-(hydroxyimino)-3-methylbutanoic acid", "common_name": "alpha-ketoisovaleric acid oxime", "inchi": null, "role": "intermediate", "environment_formed": "Hydrothermal"}, {"id": "mol_026", "formula": "C5H11NO2", "iupac_name": "2-amino-3-methylbutanoic acid", "common_name": "valine, racemic", "inchi": "InChI=1S/C5H11NO2/c1-3(2)4(6)5(7)8/h3-4H,6H2,1-2H3,(H,7,8)", "role": "target", "environment_formed": "Hydrothermal"}], "reactions": [{"id": "rxn_001", "name": "Crossed aldol addition of propanal to formaldehyde", "inputs": ["mol_002", "mol_001"], "outputs": ["mol_003"], "environment": "Surface", "agents": ["hydroxide ions for base catalysis"], "conditions": {"temperature": "315-350 K", "pressure": "approximately 1 bar", "catalyst": "hydroxide ions", "aqueous": true, "other": "Anoxic, concentrated alkaline pool; pH approximately 9-10.5; turbidity or shaded pores can reduce destructive UV exposure."}, "mechanism": "A propanal-derived enolate attacks formaldehyde, followed by protonation to form the beta-hydroxy aldehyde.", "reasoning": "Crossed aldol chemistry provides the branched C4 skeleton without importing a complex biomolecular precursor. Formaldehyde has no enolizable alpha carbon, but propanal self-condensation, further hydroxymethylation and formaldehyde side reactions remain serious competitors. The reaction class is established; selective accumulation in a natural mixed pool is not demonstrated here."}, {"id": "rxn_002", "name": "Dehydration of the crossed-aldol product to methacrolein", "inputs": ["mol_003"], "outputs": ["mol_004", "mol_010"], "environment": "Surface", "agents": ["hydroxide ions for base catalysis"], "conditions": {"temperature": "340-370 K", "pressure": "approximately 1 bar", "catalyst": "hydroxide ions", "aqueous": true, "other": "Alkaline wet-dry cycling with a residual aqueous phase; pH approximately 9-11; evaporative concentration lowers water activity."}, "mechanism": "Base-promoted elimination from the beta-hydroxy aldehyde forms the conjugated carbon-carbon double bond and releases water.", "reasoning": "Conjugation favors the aldol-condensation product, and warming or concentration can promote dehydration. Methacrolein is volatile and readily undergoes further reactions; retention and rapid downstream consumption are necessary rather than assumed."}, {"id": "rxn_003", "name": "Candidate mineral-mediated hydrogenation of methacrolein", "inputs": ["mol_004", "mol_005"], "outputs": ["mol_007"], "environment": "Hydrothermal", "agents": ["exposed native nickel or awaruite surfaces"], "conditions": {"temperature": "370-420 K", "pressure": "50-200 bar", "catalyst": "native nickel or awaruite", "aqueous": true, "other": "Anoxic, hydrogen-rich rock-water interface; pH approximately 7-9; cooling or removal of product limits further reduction."}, "mechanism": "Surface-activated hydrogen adds across the alkene while the aldehyde group is retained.", "reasoning": "Metal-catalyzed alkene hydrogenation is chemically appropriate, and nickel-bearing reduced phases are plausible in serpentinizing systems. This particular mineral implementation is speculative: carbonyl reduction to isobutanol, hydrogenolysis and catalyst passivation may prevent useful aldehyde selectivity. Molecular hydrogen alone is not treated as an effective catalyst."}, {"id": "rxn_004", "name": "Candidate dehydrogenation of supplied isobutanol", "inputs": ["mol_006"], "outputs": ["mol_007", "mol_005"], "environment": "Hydrothermal", "agents": ["exposed native copper surfaces"], "conditions": {"temperature": "420-470 K", "pressure": "50-200 bar", "catalyst": "native copper", "aqueous": true, "other": "Low-hydrogen-activity flowing compartment; pH approximately 6-8; physically separate from hydrogen-rich reduction zones."}, "mechanism": "Surface-mediated removal of the alcohol O-H and alpha C-H hydrogens produces the aldehyde and molecular hydrogen.", "reasoning": "Alcohol dehydrogenation is established heterogeneous chemistry, but its extension to native copper in these aqueous hydrothermal conditions is speculative. Low hydrogen activity, exposed metallic sites and product removal are essential; passivation and unfavorable equilibrium may suppress conversion. This alternative is conditional on an external isobutanol supply, not a claim that abundant prebiotic isobutanol is established."}, {"id": "rxn_005", "name": "Reversible formation of the isobutyraldehyde imine", "inputs": ["mol_007", "mol_008"], "outputs": ["mol_011", "mol_010"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-330 K", "pressure": "approximately 1 bar", "catalyst": null, "aqueous": true, "other": "Concentrated ammonia-containing pool; pH approximately 8-9; partial evaporation and immediate cyanide trapping favor productive turnover."}, "mechanism": "Ammonia adds to the aldehyde, and the resulting addition intermediate loses water to give a transient imine.", "reasoning": "This is the conventional imine-forming component of Strecker chemistry. The imine need not accumulate or be isolated: cyanide can trap its equilibrium population. Water favors reversal, and aldehyde self-reaction competes."}, {"id": "rxn_006", "name": "Strecker cyanide addition to the aldehyde-derived imine", "inputs": ["mol_011", "mol_009"], "outputs": ["mol_012"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-330 K", "pressure": "approximately 1 bar", "catalyst": null, "aqueous": true, "other": "HCN/CN- speciation controlled near pH 8-9; ammonia remains available; shaded or turbid water limits photochemical losses."}, "mechanism": "Cyanide attacks the imine or iminium carbon, followed by proton transfer, yielding the alpha-aminonitrile.", "reasoning": "The Strecker reaction class is well established (Strecker, 1850). Here the cyanide carbon becomes the eventual valine carboxyl carbon, while the aldehyde supplies the isopropyl-bearing skeleton. No chiral influence is specified, so both configurations form. HCN volatilization, polymerization and dilution constrain environmental yields."}, {"id": "rxn_007", "name": "Hydration of valine aminonitrile to valinamide", "inputs": ["mol_012", "mol_010"], "outputs": ["mol_013"], "environment": "Hydrothermal", "agents": ["hydron for acid catalysis"], "conditions": {"temperature": "370-410 K", "pressure": "50-150 bar", "catalyst": "hydron", "aqueous": true, "other": "Acidic rock-water mixing compartment; pH approximately 2-4; aminonitrile nitrogen is protonated according to local conditions."}, "mechanism": "Proton-assisted water addition to the nitrile, followed by proton transfers and tautomerization, gives the primary amide.", "reasoning": "Nitrile hydration is established chemistry and explicitly exposes an important hydrolysis intermediate. Rates under modest natural acidity cannot be inferred from concentrated laboratory acid treatments. Aminonitrile decomposition and limited residence time may reduce conversion."}, {"id": "rxn_008", "name": "Hydrolysis of valinamide to valine", "inputs": ["mol_013", "mol_010"], "outputs": ["mol_026", "mol_008"], "environment": "Hydrothermal", "agents": ["hydron for acid catalysis"], "conditions": {"temperature": "380-420 K", "pressure": "50-150 bar", "catalyst": "hydron", "aqueous": true, "other": "Acidic aqueous compartment; pH approximately 2-4; sufficient residence time followed by cooling; ammonia represents the corresponding aqueous ammonia/ammonium pool."}, "mechanism": "Water attacks the activated amide carbonyl; collapse of the addition intermediate releases ammonia and forms the carboxylic acid.", "reasoning": "Amide hydrolysis completes the conventional Strecker sequence. It is a likely kinetic bottleneck under mild geochemical acidity, and quantitative conversion is not assumed. Extended heating also increases opportunities for amino-acid degradation."}, {"id": "rxn_009", "name": "Bucherer-Bergs conversion of aminonitrile to hydantoin", "inputs": ["mol_012", "mol_014"], "outputs": ["mol_015"], "environment": "Surface", "agents": null, "conditions": {"temperature": "320-360 K", "pressure": "approximately 1 bar", "catalyst": null, "aqueous": true, "other": "Ammonia-rich carbonate/bicarbonate pool; pH approximately 8-9; dissolved CO2 represents the inorganic-carbon reagent pool."}, "mechanism": "Aminonitrile N-carboxylation is followed by cyclization and rearrangement to the substituted hydantoin.", "reasoning": "This is the established Bucherer-Bergs reaction class, represented from its aminonitrile intermediate. Carbon dioxide supplies the additional ring carbonyl carbon, which is subsequently lost during deprotection. A concentrated ammonium-carbonate environment is required; equivalent performance in dilute natural water is not established."}, {"id": "rxn_010", "name": "Hydrolytic opening of 5-isopropylhydantoin", "inputs": ["mol_015", "mol_010"], "outputs": ["mol_016"], "environment": "Hydrothermal", "agents": ["hydroxide ions for base-promoted hydrolysis"], "conditions": {"temperature": "380-420 K", "pressure": "50-150 bar", "catalyst": "hydroxide ions", "aqueous": true, "other": "Alkaline rock-water compartment; pH approximately 10-11; organic products are written in neutral bookkeeping forms."}, "mechanism": "Hydrolytic cleavage of the appropriate cyclic amide bond opens the hydantoin to N-carbamoylvaline.", "reasoning": "Hydantoin ring opening is established synthetic chemistry, but useful rates at natural alkaline pH may require long residence times. Stronger laboratory alkali cannot be assumed to have a direct environmental equivalent. No hydantoinase enzyme is invoked."}, {"id": "rxn_011", "name": "Hydrolytic removal of the carbamoyl group", "inputs": ["mol_016", "mol_010"], "outputs": ["mol_026", "mol_008", "mol_014"], "environment": "Hydrothermal", "agents": ["hydron for acid catalysis"], "conditions": {"temperature": "390-430 K", "pressure": "50-150 bar", "catalyst": "hydron", "aqueous": true, "other": "Separate acidic mixing compartment; pH approximately 1-3; subsequent cooling protects accumulated amino acid."}, "mechanism": "Hydrolysis of the ureido group gives valine and carbamic-acid-derived products, with net release of ammonia and carbon dioxide.", "reasoning": "Nonenzymatic deprotection of N-carbamoyl amino acids is chemically possible but may require harsh conditions. This is a major geochemical bottleneck: adequate rates, appropriate acidity and survival of valine have not been established for the proposed setting. No biological carbamoylase is assumed."}, {"id": "rxn_012", "name": "Cyanohydrin formation from isobutyraldehyde", "inputs": ["mol_007", "mol_009"], "outputs": ["mol_017"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-320 K", "pressure": "approximately 1 bar", "catalyst": null, "aqueous": true, "other": "HCN-containing pool near pH 7.5-9; relatively low ammonia activity favors the cyanohydrin branch over Strecker trapping."}, "mechanism": "Cyanide adds to the aldehyde carbonyl, and proton transfer produces the alpha-hydroxynitrile.", "reasoning": "Cyanohydrin formation is established carbonyl chemistry and introduces the required fifth carbon without an enzyme. Formation is reversible, so cyanohydrin dissociation, HCN loss and competition with aminonitrile formation must be considered."}, {"id": "rxn_013", "name": "Net hydrolysis of the cyanohydrin nitrile", "inputs": ["mol_017", "mol_010"], "outputs": ["mol_018", "mol_008"], "environment": "Hydrothermal", "agents": ["hydron for acid catalysis"], "conditions": {"temperature": "370-410 K", "pressure": "50-150 bar", "catalyst": "hydron", "aqueous": true, "other": "Acidic aqueous compartment; pH approximately 2-4; this node represents the complete nitrile-to-carboxyl hydrolysis."}, "mechanism": "Successive hydration and hydrolysis convert the nitrile group to a carboxyl group, releasing ammonia while retaining the alpha hydroxyl group.", "reasoning": "Cyanohydrin hydrolysis is a standard route to alpha-hydroxy acids. The net reaction requires water but no oxidant. Environmental yield is uncertain because cyanohydrin reversal and incomplete hydrolysis may compete."}, {"id": "rxn_014", "name": "Speculative acceptorless dehydrogenation to alpha-ketoisovalerate", "inputs": ["mol_018"], "outputs": ["mol_019", "mol_005"], "environment": "Hydrothermal", "agents": ["exposed native copper surfaces"], "conditions": {"temperature": "400-450 K", "pressure": "50-150 bar", "catalyst": "native copper", "aqueous": true, "other": "Low-hydrogen-activity flowing compartment; pH approximately 6-8; rapid transfer to cooler conditions would be needed to preserve the alpha-keto acid."}, "mechanism": "Formal surface-mediated removal of hydrogen from the alpha-hydroxyl group and adjacent carbon generates the alpha-keto acid and hydrogen.", "reasoning": "This is the weakest-supported connection in the network and is explicitly speculative. It supplies the keto-acid precursor from smaller feedstocks rather than assuming that precursor is already available. Although the redox transformation is chemically valid, selective native-mineral catalysis for this substrate under the stated conditions is not established. Decarboxylation, metal passivation and unfavorable hydrogen activity could prevent useful conversion; pathways using this edge remain conditional."}, {"id": "rxn_015", "name": "Transient imine formation from alpha-ketoisovalerate and ammonia", "inputs": ["mol_019", "mol_008"], "outputs": ["mol_020", "mol_010"], "environment": "Hydrothermal", "agents": null, "conditions": {"temperature": "350-370 K", "pressure": "50-100 bar", "catalyst": null, "aqueous": true, "other": "Ammonia-rich fluid near pH 8-9; imine is generated in situ and must be trapped by a subsequent reduction."}, "mechanism": "Ammonia addition to the keto group and water elimination establish an equilibrium population of the alpha-imino acid.", "reasoning": "This is the condensation component of reductive amination. It is not a claim that the imino acid accumulates in water: hydrolysis strongly competes, and productive flux requires sufficiently rapid reduction. No pyridoxal cofactor or enzyme is used."}, {"id": "rxn_016", "name": "Candidate hydrogen-driven reduction of the alpha-imino acid", "inputs": ["mol_020", "mol_005"], "outputs": ["mol_026"], "environment": "Hydrothermal", "agents": ["exposed native nickel or awaruite surfaces"], "conditions": {"temperature": "350-400 K", "pressure": "50-200 bar", "catalyst": "native nickel or awaruite", "aqueous": true, "other": "Hydrogen-rich, ammonia-containing fluid; pH approximately 7-9; distinct from the low-hydrogen compartment required for rxn_014."}, "mechanism": "Metal-activated hydrogen reduces the imine carbon-nitrogen double bond to the amino-acid functionality.", "reasoning": "Catalytic imine hydrogenation is established chemistry, but efficient mineral-catalyzed valine production under this specific geochemical implementation is not demonstrated here. Keto-acid reduction back to the hydroxy acid, imine hydrolysis and decarboxylation compete. The proposed catalyst must be experimentally shown to retain activity and selectivity."}, {"id": "rxn_017", "name": "Candidate iron-driven reduction of the alpha-imino acid", "inputs": ["mol_020", "mol_021", "mol_022"], "outputs": ["mol_026", "mol_023"], "environment": "Hydrothermal", "agents": ["native iron as a stoichiometric reductant, explicitly included among the inputs"], "conditions": {"temperature": "350-390 K", "pressure": "50-100 bar", "catalyst": null, "aqueous": true, "other": "Fresh iron-bearing interface receiving the imine-containing stream; locally mildly acidic conditions, approximately pH 4-6."}, "mechanism": "Oxidation of metallic iron to ferrous ion supplies the electrons for proton-coupled reduction of the imine to valine.", "reasoning": "The net reaction is atom- and charge-balanceable as a two-electron reduction. Native or meteoritic iron provides a distinct possible reducing resource, but the substrate-specific geochemical conversion is a candidate rather than an established result. Iron corrosion, hydrogen evolution, imine hydrolysis and passivation may dominate. Abundant Fe2+ alone is not treated as proof of reducing capacity."}, {"id": "rxn_018", "name": "Oxime formation from alpha-ketoisovalerate", "inputs": ["mol_019", "mol_024"], "outputs": ["mol_025", "mol_010"], "environment": "Hydrothermal", "agents": ["hydron for acid-catalyzed condensation"], "conditions": {"temperature": "350-370 K", "pressure": "50-100 bar", "catalyst": "hydron", "aqueous": true, "other": "Mildly acidic water, approximately pH 4-6; hydroxylamine must be supplied and consumed before extensive decomposition."}, "mechanism": "Hydroxylamine adds to the keto group, followed by dehydration to form the oxime.", "reasoning": "Oxime formation is established carbonyl chemistry and can trap the keto acid more strongly than ammonia-derived imine formation. The important prebiotic gap is hydroxylamine availability: treating this small molecule as a feedstock does not demonstrate that it accumulated naturally. This branch is conditional on such a supply."}, {"id": "rxn_019", "name": "Candidate iron-mediated reduction of the oxime to valine", "inputs": ["mol_025", "mol_021", "mol_022"], "outputs": ["mol_026", "mol_023", "mol_010"], "environment": "Hydrothermal", "agents": ["native iron as a stoichiometric reductant, explicitly included among the inputs"], "conditions": {"temperature": "350-400 K", "pressure": "50-100 bar", "catalyst": null, "aqueous": true, "other": "Fresh iron surface in mildly acidic water, approximately pH 3-5; cooling follows reaction to limit product degradation."}, "mechanism": "Proton-coupled electron transfer reduces the carbon-nitrogen double bond and cleaves the nitrogen-oxygen bond, giving valine and water.", "reasoning": "Oxime-to-amine reduction is established synthetic chemistry. The balanced net transformation requires a four-electron reduction, supplied here by oxidation of metallic iron to Fe2+. Efficient conversion with native iron under the proposed conditions is not established; corrosion, incomplete reduction and competing decomposition require testing. Product stereochemistry is uncontrolled."}], "pathways": [{"pathway_id": "P1", "name": "Aldol-derived aldehyde followed by Strecker hydrolysis", "description": "Formaldehyde and propanal supply the branched aldehyde through aldol condensation and candidate alkene hydrogenation. Ammonia and HCN then give valine through the aminonitrile and amide. Mineral hydrogenation selectivity and hydrolysis rates are unresolved.", "reaction_sequence": ["rxn_001", "rxn_00