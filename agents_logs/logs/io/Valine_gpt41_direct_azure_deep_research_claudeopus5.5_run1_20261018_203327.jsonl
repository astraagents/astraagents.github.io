rying (vacuum \u2192 ambient)", "catalyst": null, "aqueous": true, "other": "interstellar ice analog, followed by warm hydrolysis"}, "mechanism": "UV photolysis in ices, then room-temperature hydrolysis liberates trace amino acids (including valine).", "reasoning": "Experimentally proven for trace valine (Mu\u00f1oz Caro et al., 2002; Modica et al., 2014); yields tiny but mass/charge complete."}, {"id": "rxn_016", "name": "Biosynthetic analog: \u03b1-KIV formation from condensation of pyruvate and CO2 (alternative speculative)", "inputs": ["mol_025", "mol_025", "mol_024"], "outputs": ["mol_011", "mol_003"], "environment": "Hydrothermal", "agents": ["Fe(II) minerals (speculative)"], "conditions": {"temperature": "370-420K", "pressure": "high", "catalyst": "speculative", "aqueous": true, "other": null}, "mechanism": "Coupling of two pyruvates and CO2, Fe-catalyzed, to provide \u03b1-KIV. Not demonstrated abiotically.", "reasoning": "Proposed as a plausible branch per Keefe et al., 1995; included for completeness."}], "pathways": [{"pathway_id": "P1", "name": "Spark-Strecker pathway (canonical)", "description": "Methane/nitrogen/water/ammonia spark produces isobutyraldehyde and HCN, leading to Strecker aminonitrile, followed by hydrolysis to valine. Side-branch into pantoic acid/pantolactone and co-formation of norvaline/isovaline.", "reaction_sequence": ["rxn_001", "rxn_002", "rxn_003"], "key_intermediates": ["mol_010", "mol_015"]}, {"pathway_id": "P2", "name": "Spark-Strecker isomer (norvaline/isovaline) pathway", "description": "Parallel Strecker chemistry on co-formed C5 aldehyde/ketone isomers yields norvaline and isovaline aminonitriles and hydrolyzes to corresponding amino acids (common to meteorite spectra).", "reaction_sequence": ["rxn_001", "rxn_006", "rxn_007"], "key_intermediates": ["mol_021", "mol_016", "mol_017"]}, {"pathway_id": "P3", "name": "Side-branch: pantoic acid/pantolactone divergence", "description": "Aldol condensation of isobutyraldehyde and f