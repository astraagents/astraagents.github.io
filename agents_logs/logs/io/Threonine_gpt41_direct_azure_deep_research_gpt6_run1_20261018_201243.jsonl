a\": \"H2O\",\n      \"iupac_name\": \"water\",\n      \"common_name\": \"water\",\n      \"inchi\": \"InChI=1S/H2O/h1H2\",\n      \"role\": \"starting\",\n      \"environment_formed\": \"Surface\"\n    }\n  ],\n  \"reactions\": [\n    {\n      \"id\": \"rxn_001\",\n      \"name\": \"Acetaldehyde cyanohydrin (lactonitrile) formation\",\n      \"inputs\": [\"mol_001\", \"mol_002\"],\n      \"outputs\": [\"mol_003\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300\u2013320 K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": \"true\",\n        \"other\": \"neutral-to-slightly-basic pH\"\n      },\n      \"mechanism\": \"Nucleophilic addition of HCN to acetaldehyde forms lactonitrile.\",\n      \"reasoning\": \"This reaction has been directly observed as the entry to HCN-derived Strecker chemistry for amino/hydroxy acid generation. Cited: Ritson & Sutherland (2013), Patel et al. (2015).\"\n    },\n    {\n      \"id\": \"rxn_002\",\n      \"name\": \"Photoreduction of lactonitrile to lactaldehyde\",\n      \"inputs\": [\"mol_003\", \"mol_017\"],\n      \"outputs\": [\"mol_004\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"H2S\", \"UV\", \"CuCN (optional)\", \"phosphate\"],\n      \"conditions\": {\n        \"temperature\": \"300\u2013310 K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"Cu(I) (optional), H2S\",\n        \"aqueous\": \"true\",\n        \"other\": \"UV254 nm, neutral pH, H2S as reductant\"\n      },\n      \"mechanism\": \"UV photoreduction; H2S is oxidized while lactonitrile is reduced to lactaldehyde, optionally accelerated by Cu(I)\",\n      \"reasoning\": \"Cyanosulfidic photoredox homologation robustly generates lactaldehyde from lactonitrile, with 19% yield. Metallic catalysts are accelerators, not requirements. Cited: Ritson & Sutherland (2013), Patel et al. (2015).\"\n    },\n    {\n      \"id\": \"rxn_003\",\n      \"name\": \"Strecker-type aminonitrile formation from lactaldehyde\",\n      \"inputs\": [\"mol_004\", \"mol_002\", \"mol_005\"],\n      \"outputs\": [\"mol_006\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300\u2013330 K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": \"true\",\n        \"other\": \"neutral to mildly basic pH\"\n      },\n      \"mechanism\": \"Addition of HCN and NH3 to lactaldehyde yields threonine aminonitrile via cyanohydrin and imine intermediates.\",\n      \"reasoning\": \"Classic Strecker step, experimentally shown to give threonine aminonitrile from prebiotic lactaldehyde. Ritson & Sutherland (2013).\"\n    },\n    {\n      \"id\": \"rxn_004\",\n      \"name\": \"Hydrolysis of threonine aminonitrile to threonine\",\n      \"inputs\": [\"mol_006\", \"mol_017\"],\n      \"outputs\": [\"mol_007\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"310\u2013370 K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": \"true\",\n        \"other\": \"acidic hydrolysis (hot HCl in experiments)\"\n      },\n      \"mechanism\": \"Hydrolysis of the aminonitrile to the amino acid, likely under acidic, heated conditions.\",\n      \"reasoning\": \"Free threonine detected following extended acid hydrolysis; step required to release the amino acid. Cited: Ritson & Sutherland (2013); critique: uncatalyzed hydrolysis is slow under mild conditions, so environmental implementation is limited by kinetics.\"\n    },\n    {\n      \"id\": \"rxn_005\",\n      \"name\": \"HCN trimerization to aminomalononitrile\",\n      \"inputs\": [\"mol_002\"],\n      \"outputs\": [\"mol_008\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300\u2013320 K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": \"true\",\n        \"other\": \"neutral pH, concentration required\"\n      },\n      \"mechanism\": \"Spontaneous trimerization of HCN in water forms aminomalononitrile.\",\n      \"reasoning\": \"HCN trimerizes upon aqueous condensation; aminomalononitrile is a major mid-level product. Well-established classic chemistry. Thanassi (1975).\"\n    },\n    {\n      \"id\": \"rxn_006\",\n      \"name\": \"Aminomalononitrile addition to acetaldehyde\",\n      \"inputs\": [\"mol_008\", \"mol_001\"],\n      \"outputs\": [\"mol_010\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300\u2013320 K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": \"true\",\n        \"other\": \"near-neutral pH\"\n      },\n      \"mechanism\": \"C\u2013C bond formation: aminomalononitrile nucleophilically attacks acetaldehyde.\",\n      \"reasoning\": \"Directly demonstrated to give hydrolyzable threonine precursor under mild conditions. Thanassi (1975); Kuroda et al. (2020).\"\n    },\n    {\n      \"id\": \"rxn_007\",\n      \"name\": \"Hydrolysis and decarboxylation of hydrolyzable Thr precursor\",\n      \"inputs\": [\"mol_010\", \"mol_017\"],\n      \"outputs\": [\"mol_007\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"310\u2013370 K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": \"true\",\n        \"other\": \"acidic hydrolysis and decarboxylation\"\n      },\n      \"mechanism\": \"Sequential hydrolysis of nitriles then decarboxylation yields threonine.\",\n      \"reasoning\": \"Experimental product is free threonine amongst products. Thanassi (1975); hydrolyzable precursor step is fully established.\"\n    },\n    {\n      \"id\": \"rxn_008\",\n      \"name\": \"Glycine formation from HCN (Strecker 