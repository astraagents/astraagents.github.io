ame\": \"Oxaloacetate\",\n      \"inchi\": \"InChI=1S/C4H4O5/c5-2(4(8)9)1-3(6)7/h1H2,(H,6,7)(H,8,9)\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Hydrothermal\"\n    },\n    {\n      \"id\": \"mol_010\",\n      \"formula\": \"CO2\",\n      \"iupac_name\": \"carbon dioxide\",\n      \"common_name\": \"Carbon dioxide\",\n      \"inchi\": \"InChI=1S/CO2/c2-1-3\",\n      \"role\": \"hub_intermediate\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_011\",\n      \"formula\": \"C3H6O3\",\n      \"iupac_name\": \"2-hydroxypropanoic acid\",\n      \"common_name\": \"Lactic acid\",\n      \"inchi\": \"InChI=1S/C3H6O3/c1-2(4)3(5)6/h2,4H,1H3,(H,5,6)\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    }\n  ],\n  \"reactions\": [\n    {\n      \"id\": \"rxn_001\",\n      \"name\": \"Cyanosulfidic hydrolysis of 2-aminopropanenitrile to alanine\",\n      \"inputs\": [\"mol_002\", \"mol_006\", \"mol_006\"],\n      \"outputs\": [\"mol_001\", \"mol_003\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300-320K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": \"true\",\n        \"other\": \"Wet conditions, cyanosulfidic chemistry, variable UV exposure\"\n      },\n      \"mechanism\": \"Hydrolysis of the nitrile group in 2-aminopropanenitrile produces L-alanine and ammonia via amide intermediate.\",\n      \"reasoning\": \"This is a core experimentally supported route to alanine under cyanosulfidic conditions (Patel et al., 2015, DOI:10.1038/nchem.2202). Stoichiometry and charge balance with two H2O yielding one L-alanine and one NH3 are verified.\"\n    },\n    {\n      \"id\": \"rxn_002\",\n      \"name\": \"Iron-catalyzed reductive amination of pyruvate (hydrated variant)\",\n      \"inputs\": [\"mol_004\", \"mol_005\", \"mol_006\"],\n      \"outputs\": [\"mol_001\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"Elemental iron (Fe0)\", \"Ferrous iron (Fe2+)\"],\n      \"conditions\": {\n        \"temperature\": \"343K (70\u00b0C)\",\n        \"pressure\": \"moderate-high\",\n        \"catalyst\": \"Elemental iron + Ferrous iron\",\n        \"aqueous\": \"true\",\n        \"other\": \"Anaerobic, iron-rich vent environment\"\n      },\n      \"mechanism\": \"Pyruvate undergoes iron-promoted reductive amination by hydroxylamine with water as co-substrate, yielding L-alanine.\",\n      \"reasoning\": \"Completely literature-supported transformation (Muchowska et al., 2019, DOI:10.1038/s41586-019-1151-1) with explicit inclusion of water as required for atom balance.\"\n    },\n    {\n      \"id\": \"rxn_003\",\n      \"name\": \"Iron-catalyzed reductive amination of pyruvate (anhydrous variant)\",\n      \"inputs\": [\"mol_004\", \"mol_005\"],\n      \"outputs\": [\"mol_001\", \"mol_006\", \"mol_006\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"Elemental iron (Fe0)\", \"Ferrous iron (Fe2+)\"],\n      \"conditions\": {\n        \"temperature\": \"343K (70\u00b0C)\",\n        \"pressure\": \"moderate-high\",\n        \"catalyst\": \"Elemental iron + Ferrous iron\",\n        \"aqueous\": \"true\",\n        \"other\": \"Anaerobic, iron-rich solution\"\n      },\n      \"mechanism\": \"Reductive amination of pyruvate by hydroxylamine with net production of water.\",\n      \"reasoning\": \"Well supported experimentally and by mechanism (Muchowska et al., 2019, DOI:10.1038/s41586-019-1151-1). Explicit water production ensures correct stoichiometry.\"\n    },\n    {\n      \"id\": \"rxn_004\",\n      \"name\": \"Hydrothermal reductive dehydroxylation of L-serine to L-alanine\",\n      \"inputs\": [\"mol_007\", \"mol_008\"],\n      \"outputs\": [\"mol_001\", \"mol_006\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"370-420K\",\n        \"pressure\": \"high\",\n        \"catalyst\": null,\n        \"aqueous\": \"true\",\n        \"other\": \"High H2 flux from serpentinization\"\n      },\n      \"mechanism\": \"Reductive removal of the serine \u03b2-hydroxyl group by H2, yielding L-alanine and water.\",\n      \"reasoning\": \"Experimentally verified under vent conditions; H2 acts as electron donor (Aubrey et al., 2008, DOI:10.1007/s11084-008-9153-2). H2O is included for mass balance.\"\n    },\n    {\n      \"id\": \"rxn_005\",\n      \"name\": \"Fischer-Tropsch-type CO2 fixation to pyruvate\",\n      \"inputs\": [\"mol_010\", \"mol_010\", \"mol_010\", \"mol_008\", \"mol_008\", \"mol_008\", \"mol_008\", \"mol_008\"],\n      \"outputs\": [\"mol_004\", \"mol_006\", \"mol_006\", \"mol_006\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"Elemental iron (Fe0)\", \"Awaruite (Ni3Fe)\", \"Magnetite (Fe3O4)\"],\n      \"conditions\": {\n        \"temperature\": \"373K (100\u00b0C)\",\n        \"pressure\": \"high\",\n        \"catalyst\": \"Fe0, awaruite, and/or magnetite\",\n        \"aqueous\": \"true\",\n        \"other\": \"Anaerobic, reducing vent fluids\"\n      },\n      \"mechanism\": \"Stepwise reduction and condensation of three CO2 with five H2 equivalents form pyruvate, releasing three waters.\",\n      \"reasoning\": \"Experimentally demonstrated by Preiner et al., 2020 (DOI:10.1038/s41559-020-1125-6), with catalysts and stoichiometry as reported.\"\n    },\n    {\n      \"id\": \"rxn_006\",\n      \"name\": \"Fe2+-catalyzed decarboxylation of oxaloacetate to pyruvate (hydrothermal)\",\n      \"inputs\": [\"mol_009\"],\n      \"outputs\": [\"mol_004\", \"mol_010\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"Ferrous iron (Fe2+)\"],\n      \"conditions\": {\n        \"temperature\": \"343K (70\u00b0C)\",\n        \"pressure\": \"moderate\",\n        \"catalyst\": \"Ferrous iron\",\n        \"aqueous\": \"true\",\n        \"other\": \"Mildly reducing, mineral-rich so