\": [\"mol_003\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"electrical discharge\"],\n      \"conditions\": {\n        \"temperature\": \"300-350K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"strong spark or corpuscular irradiation\"\n      },\n      \"mechanism\": \"High-energy discharge breaks bonds and forms HCN from simple C/N sources.\",\n      \"reasoning\": \"Robustly supported by Miller (1955, 1957), Kobayashi et al. (2023): spark/irradiation produces HCN from reduced C/N gases. (Miller 1955; Kobayashi et al. 2023)\"\n    },\n    {\n      \"id\": \"rxn_003\",\n      \"name\": \"1-aminoethanol formation (acetaldehyde + ammonia)\",\n      \"inputs\": [\"mol_001\", \"mol_002\"],\n      \"outputs\": [\"mol_004\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300-350K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"usually neutral to slightly basic pH\"\n      },\n      \"mechanism\": \"Nucleophilic addition of NH3 to acetaldehyde yields 1-aminoethanol.\",\n      \"reasoning\": \"This is a classical Strecker intermediate; established in Miller's mechanistic work. (Miller 1957)\"\n    },\n    {\n      \"id\": \"rxn_004\",\n      \"name\": \"Imine formation (1-aminoethanol \u2192 ethanimine)\",\n      \"inputs\": [\"mol_004\"],\n      \"outputs\": [\"mol_005\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300-340K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Schiff base formation, equilibrium process\"\n      },\n      \"mechanism\": \"Dehydration of 1-aminoethanol forms imine (ethanimine).\",\n      \"reasoning\": \"Supported by the Strecker pathway as outlined in Miller (1957).\"\n    },\n    {\n 