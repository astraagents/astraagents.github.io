, "name": "1-aminoethanol formation (acetaldehyde + ammonia)", "inputs": ["mol_001", "mol_002"], "outputs": ["mol_004"], "environment": "Surface", "agents": [null], "conditions": {"temperature": "300-350K", "pressure": "1 atm", "catalyst": null, "aqueous": true, "other": "usually neutral to slightly basic pH"}, "mechanism": "Nucleophilic addition of NH3 to acetaldehyde yields 1-aminoethanol.", "reasoning": "This is a classical Strecker intermediate; established in Miller's mechanistic work. (Miller 1957)"}, {"id": "rxn_004", "name": "Imine formation (1-aminoethanol \u2192 ethanimine)", "inputs": ["mol_004"], "outputs": ["mol_005"], "environment": "Surface", "agents": [null], "conditions": {"temperature": "300-340K", "pressure": "1 atm", "catalyst": null, "aqueous": true, "other": "Schiff base formation, equilibrium process"}, "mechanism": "Dehydration of 1-aminoethanol forms imine (ethanimine).", "reasoning": "Supported by the Strecker pathway as outlined in Miller (1957)."}, {"id": "rxn_005", "name": "Aminonitrile formation (Strecker: ethanimine + HCN \u2192 alaninonitrile)", "inputs": ["mol_005", "mol_003"], "outputs": ["mol_006"], "environment": "Surface", "agents": [null], "conditions": {"temperature": "300-350K", "pressure": "1 atm", "catalyst": null, "aqueous": true, "other": "slightly basic pH enhances Strecker reaction"}, "mechanism": "Cyanide anion attack at imine carbon yields amino nitrile.", "reasoning": "Strecker reaction is robust for alanine precursor. (Miller 1957; Patel et al. 2015)"}, {"id": "rxn_006", "name": "Hydrolysis of alaninonitrile to DL-alanine", "inputs": ["mol_006", "mol_012"], "outputs": ["mol_020"], "environment": "Surface", "agents": [null], "conditions": {"temperature": "300-373K", "pressure": "1 atm", "catalyst": null, "aqueous": true, "other": "may be acid- or base-catalyzed"}, "mechanism": "Hydration and hydrolysis of nitrile group yields DL-alanine.", "reasoning": "Final step in all Strecker-based alanine syntheses. (Miller 1957, Patel et al. 2015)"}, {"id": "rxn_007", "name": "Pyruvate synthesis from CO2/H2 over Ni3Fe (hydrothermal carbon fixation)", "inputs": ["mol_011", "mol_009"], "outputs": ["mol_008", "mol_015"], "environment": "Hydrothermal", "agents": ["Ni3Fe"], "conditions": {"temperature": "298-333K", "pressure": "20-30 bar", "catalyst": "Ni3Fe", "aqueous": true, "other": "slightly acidic to neutral pH"}, "mechanism": "Superficial reduction and carboxylation yields pyruvate and acetate.", "reasoning": "Direct experimental support for CO2/H2 \u2192 pyruvate via Ni3Fe or awaruite. (Beyazay et al. 2023)"}, {"id": "rxn_008", "name": "Reductive amination of pyruvate to alanine (FeS promoter)", "inputs": ["mol_008", "mol_002"], "outputs": ["mol_020"], "environment": "Hydrothermal", "agents": ["FeS"], "conditions": {"temperature": "323-348K", "pressure": "1-10 bar", "catalyst": "FeS (stoichiometric promoter)", "aqueous": true, "other": "alkaline, reduced conditions"}, "mechanism": "NH3 condenses with pyruvate, FeS donates electrons to reduce imine to alanine.", "reasoning": "Clearly demonstrated by Huber & W\u00e4chtersh\u00e4user (2003); large FeS excess needed."}, {"id": "rxn_009", "name": "Reductive amination of pyruvate to alanine (H2/Ni catalysis)", "inputs": ["mol_008", "mol_002", "mol_009"], "outputs": ["mol_020"], "environment": "Hydrothermal", "agents": ["Ni (nickel metal or Ni-bearing meteorite)"], "conditions": {"temperature": "295-320K", "pressure": "1-5 bar", "catalyst": "Ni, H2", "aqueous": true, "other": "mild alkaline conditions"}, "mechanism": "Imine formation/reduction: H2 activation by Ni allows conversion of pyruvate + NH3 to alanine.", "reasoning": "Well supported; Kaur et al. (2024) show efficient alanine formation at moderate [NH3] and pyruvate. (Kaur et al. 2024)"}, {"id": "rxn_010", "name": "Oxime/imine N-incorporation (pyruvate + hydroxylamine, Fe0 promoted)", "inputs": ["mol_008", "mol_014"], "outputs": ["mol_020"], "environment": "Hydrothermal", "agents": ["Fe0"], "conditions": {"temperature": "320-350K", "pressure": "1-10 bar", "catalyst": "Fe0 (elemental iron)", "aqueous": true, "other": "excess NH2OH"}, "mechanism": "Pyruvate forms oxime/imine species with NH2OH, reduced by Fe0 to alanine.", "reasoning": "Prominent in Muchowska et al. (2019), who observed alanine from NH2OH and Fe0; stereochemistry undefined."}, {"id": "rxn_011", "name": "Mixed-valence iron (Fe(II)/Fe(III)) oxyhydroxide-promoted pyruvate amination", "inputs": ["mol_008", "mol_002"], "outputs": ["mol_020"], "environment": "Hydrothermal", "agents": ["Fe(II)/Fe(III) oxyhydroxide"], "conditions": {"temperature": "325-350K", "pressure": "1-10 bar", "catalyst": "mixed-valence iron oxyhydroxide", "aqueous": true, "other": "pH 9-11, batch"}, "mechanism": "Reductive amination by pyruvate + NH3, electron transfer via iron oxyhydroxide.", "reasoning": "High selectivity and yield of alanine under batch conditions; flow suppresses yield. (Barge et al. 2019)"}, {"id": "rxn_012", "name": "ZnS-promoted photochemical reductive amination of pyruvate", "inputs": ["mol_008", "mol_002"], "outputs": ["mol_020"], "environment": "Surface", "agents": ["ZnS", "light"], "conditions": {"temperature": "300-310K", "pressure": "1 atm", "catalyst": "ZnS (sphalerite), UV/visible light", "aqueous": true, "other": "alkaline; photoexcitation"}, "mechanism": "Photoexcited e- from ZnS reduce Schiff base intermediate from pyruvate + NH3, giving alanine.", "reasoning": "Direct experimental support; photosynthetic amination of pyruvate. (Wang et al. 2012)"}, {"id": "rxn_013", "name": "Pyruvate + glycine transamination (alum or mineral promoted)", "inputs": ["mol_008", "mol_017"], "outputs": ["mol_020", "mol_018"], "environment": "Biochemical", "agents": ["alum", "hydrothermal minerals (e.g., clays)"], "conditions": {"temperature": "350-360K", "pressure": "1 atm", "catalyst": "Al3+ or clays", "aqueous": true, "other": "slightly acidic; batch"}, "mechanism": "Amino group is transferred from gl