 event\"],\n      \"conditions\": {\n        \"temperature\": \"variable\",\n        \"pressure\": \"variable\",\n        \"catalyst\": null,\n        \"aqueous\": null,\n        \"other\": \"requires symmetry-breaking process\"\n      },\n      \"mechanism\": \"Nonselective DL-alanine pool is enriched in L-alanine by chiral amplification or selection.\",\n      \"reasoning\": \"No prebiotic protocol has yet demonstrated substantial L-alanine from achiral feedstocks; node represents conceptual symmetry-breaking step (Li et al., 2024, Nature Communications, D-selectivity only; see also Bernstein et al., 2002 for CP UV).\"\n    },\n    {\n      \"id\": \"rxn_018\",\n      \"name\": \"Lactonitrile formation (side route from acetaldehyde)\",\n      \"inputs\": [\"mol_005\", \"mol_006\"],\n      \"outputs\": [\"mol_018\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"298-310K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"competing Strecker sink\"\n      },\n      \"mechanism\": \"HCN addition to acetaldehyde yields lactonitrile, a key branch away from alanine.\",\n      \"reasoning\": \"Demonstrated by Miller (1957, BBA); mass balanced; route explains yield modulation.\"\n    },\n    {\n      \"id\": \"rxn_019\",\n      \"name\": \"Lactonitrile hydrolysis to lactic acid\",\n      \"inputs\": [\"mol_018\", \"mol_008\"],\n      \"outputs\": [\"mol_019\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"298-338K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"neutral or acidic\"\n      },\n      \"mechanism\": \"Lactonitrile is hydrolyzed to lactic acid (\u03b1-hydroxyacid).\",\n      \"reasoning\": \"Observed both as a competitor for alanine synthesis and as a product in Barge et al. (2019, PNAS), a