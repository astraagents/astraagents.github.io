   \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    }\n  ],\n  \"reactions\": [\n    {\n      \"id\": \"rxn_001\",\n      \"name\": \"CO2 fixation to pyruvate (Ni3Fe catalyzed)\",\n      \"inputs\": [\"mol_001\", \"mol_002\", \"mol_012\"],\n      \"outputs\": [\"mol_004\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"Ni3Fe alloy (awaruite-like)\"],\n      \"conditions\": {\n        \"temperature\": \"298-320K\",\n        \"pressure\": \"25 bar\",\n        \"catalyst\": \"Ni3Fe alloy\",\n        \"aqueous\": true,\n        \"other\": \"Neutral to mildly acidic pH\"\n      },\n      \"mechanism\": \"Ni3Fe catalyzes sequential hydrogenation and carbonylation, leading from CO2 to formate, acetate, and on to pyruvate.\",\n      \"reasoning\": \"Direct experimental support for CO2/H2 \u2192 pyruvate over Ni3Fe at room temperature and moderate pressure (Beyazay et al., 2023, Nature Communications).\"\n    },\n    {\n      \"id\": \"rxn_002\",\n      \"name\": \"Pyruvate reductive amination (FeS-promoted)\",\n      \"inputs\": [\"mol_004\", \"mol_003\"],\n      \"outputs\": [\"mol_009\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"Fresh FeS\"],\n      \"conditions\": {\n        \"temperature\": \"323-348K\",\n        \"pressure\": \"ambient to moderate\",\n        \"catalyst\": \"FeS (stoichiometric, not catalytic)\",\n        \"aqueous\": true,\n        \"other\": \"pH 8.5-9.5, anoxic\"\n      },\n      \"mechanism\": \"FeS promotes condensation of pyruvate with NH3 to form imines, which are reduced to alanine.\",\n      \"reasoning\": \"Efficient and robust in the lab, up to ca. 52 mol% alanine. FeS is consumed, not merely a catalyst. (Huber & W\u00e4chtersh\u00e4user, 2003; Novikov & Copley, 2013).\"\n    },\n    {\n      \"id\": \"rxn_003\",\n      \"name\": \"Reductive amination on mixed-valence Fe(II)/Fe(III) hydroxides\",\n      \"inputs\": [\"mol_004\", \"mol_003\"],\n      \