tputs\": [\"mol_007\", \"mol_013\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Fe-Ni mineral surface\", \"magnetite\"],\n      \"conditions\": {\n        \"temperature\": \"330-390 K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"Fe-Ni or magnetite surface\",\n        \"aqueous\": false,\n        \"other\": \"Hot mineral films or low-water interfaces; balanced as alcohol dehydrogenation C5H8N2O -> C5H6N2O + H2.\"\n      },\n      \"mechanism\": \"Mineral-assisted alcohol dehydrogenation/oxidation to the imidazole aldehyde.\",\n      \"reasoning\": \"This oxidation/dehydrogenation is not demonstrated in the supplied histidine papers and should be treated as speculative. It is included only because Shen et al. (1987) identified imidazole-4-ethanol as a real coproduct and noted that conversion to the aldehyde would be needed for closure, while Vazquez-Salazar et al. (2018) highlighted that the redox step remains unresolved.\"\n    },\n    {\n      \"id\": \"rxn_007\",\n      \"name\": \"Strecker addition on imidazole-4-acetaldehyde\",\n      \"inputs\": [\"mol_007\", \"mol_005\", \"mol_004\"],\n      \"outputs\": [\"mol_010\", \"mol_002\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [],\n      \"conditions\": {\n        \"temperature\": \"300-330 K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"HCN- and NH3-bearing aqueous solution; balanced net is imidazole-4-acetaldehyde + NH3 + HCN -> histidine aminonitrile + H2O.\"\n      },\n      \"mechanism\": \"Imine/iminium formation followed by cyanide capture to give the alpha-aminonitrile.\",\n      \"reasoning\": \"This is the conventional Strecker capture of the validated imidazole aldehyde. Shen et al. (1990) experimentally closed the route by adding HCN and ammonia to the imidazole-precursor mixture, and the corresponding alpha-aminonitrile is the standard mechanistic intermediate for that chemistry (Shen et al., 1990).\"\n    },\n    {\n      \"id\": \"rxn_008\",\n      \"name\": \"Hydrolysis of histidine aminonitrile to histidine\",\n      \"inputs\": [\"mol_010\", \"mol_002\"],\n      \"outputs\": [\"mol_011\", \"mol_005\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [],\n      \"conditions\": {\n        \"temperature\": \"320-370 K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Prolonged aqueous aging or geothermal cycling; balanced net consumes 2 H2O per aminonitrile and liberates NH3.\"\n      },\n      \"mechanism\": \"Nitrile hydrolysis converts the alpha-aminonitrile into the amino acid carboxyl group.\",\n      \"reasoning\": \"Hydrolysis of the alpha-aminonitrile to histidine is the conservative interpretation of the second half of the Shen synthesis. Histidine itself was identified by multiple chromatographic and mass-spectrometric methods in Shen et al. (1990), making this the most mechanistically secure completion step.\"\n    },\n    {\n      \"id\": \"rxn_009\",\n      \"name\": \"One-pot Shen-Oro histidine synthesis net step\",\n      \"inputs\": [\"mol_003\", \"mol_006\", \"mol_004\"],\n      \"outputs\": [\"mol_011\", \"mol_002\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [],\n      \"conditions\": {\n        \"temperature\": \"350-355 K then aqueous aging\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Balanced net edge: erythrose + formamidine + HCN -> histidine + 2 H2O. NH3 is omitted because it is consumed in the Strecker stage but regenerated during aminonitrile hydrolysis.\"\n      },\n      \"mechanism\": \"Aggregate two-stage sequence combining imidazole construction with Strecker closure and hydrolysis.\",\n      \"reasoning\": \"This is a balanced aggregate representation of the experimentally closed Shen-Oro sequence, not an elementary step: erythrose + formamidine 