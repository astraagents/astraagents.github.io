, "rxn_005", "rxn_006", "rxn_007", "rxn_008"], "key_intermediates": ["mol_005", "mol_006", "mol_007", "mol_011", "mol_012"]}, {"pathway_id": "P6", "name": "Glycolaldehyde/formaldehyde-entry via direct nitrile hydrolysis", "description": "The same mixed C1 and C2 reservoir enters at glyceraldehyde formation but uses the overall nitrile hydrolysis endgame instead of isolating the amide.", "reaction_sequence": ["rxn_003", "rxn_004", "rxn_005", "rxn_006", "rxn_009"], "key_intermediates": ["mol_005", "mol_006", "mol_007", "mol_011"]}, {"pathway_id": "P7", "name": "Glyceraldehyde-entry via stepwise hydrolysis", "description": "Entry from a glyceraldehyde reservoir produced elsewhere in the broader formose network gives methylglyoxal, then lactaldehyde, followed by Strecker synthesis and explicit amide hydrolysis.", "reaction_sequence": ["rxn_004", "rxn_005", "rxn_006", "rxn_007", "rxn_008"], "key_intermediates": ["mol_006", "mol_007", "mol_011", "mol_012"]}, {"pathway_id": "P8", "name": "Glyceraldehyde-entry via direct nitrile hydrolysis", "description": "A glyceraldehyde-rich carbonyl pool is funneled through methylglyoxal and lactaldehyde, then converted to threonine by Strecker synthesis and overall nitrile hydrolysis.", "reaction_sequence": ["rxn_004", "rxn_005", "rxn_006", "rxn_009"], "key_intermediates": ["mol_006", "mol_007", "mol_011"]}, {"pathway_id": "P9", "name": "Methylglyoxal-entry via stepwise hydrolysis", "description": "Entry from a pre-existing methylglyoxal pool generated by sugar degradation requires only reduction to lactaldehyde, Strecker synthesis, and stepwise nitrile hydrolysis.", "reaction_sequence": ["rxn_005", "rxn_006", "rxn_007", "rxn_008"], "key_intermediates": ["mol_007", "mol_011", "mol_012"]}, {"pathway_id": "P10", "name": "Methylglyoxal-entry via direct nitrile hydrolysis", "description": "A methylglyoxal reservoir is reduced to lactaldehyde and then taken through Strecker capture plus overall hydrolysis under extended geothermal heating.