", "mol_002"], "outputs": ["mol_003", "mol_010"], "environment": "Hydrothermal", "agents": ["magnetite", "awaruite"], "conditions": {"temperature": "350-390K", "pressure": "high", "catalyst": "magnetite/awaruite", "aqueous": true, "other": "H2-rich alkaline to mildly alkaline subseafloor hydrothermal fluids; anoxic"}, "mechanism": "Stepwise mineral-surface reduction of CO2 to the carbonyl level, releasing formaldehyde into the aqueous C1 pool.", "reasoning": "This node provides a fully connected inorganic-carbon entry. The overall stoichiometry is CO2 + 2 H2 -> CH2O + H2O. In H2-rich serpentinization settings, Fe-Ni oxides and alloys can reduce CO2 to C1 organics; formaldehyde is expected to be low-yield and transient in hot water, so later pathways also allow entry from pre-existing surface formaldehyde reservoirs."}, {"id": "rxn_002", "name": "Formaldehyde dimerization to glycolaldehyde", "inputs": ["mol_003"], "outputs": ["mol_004"], "environment": "Surface", "agents": ["borate minerals", "carbonate minerals"], "conditions": {"temperature": "300-340K", "pressure": "1 atm", "catalyst": "borate/carbonate mineral assemblage", "aqueous": true, "other": "Alkaline evaporitic pool with wet-dry concentration and partially UV-shielded microenvironments"}, "mechanism": "Base-catalyzed formose dimerization of two formaldehyde equivalents.", "reasoning": "The overall stoichiometry is 2 CH2O -> C2H4O2. This is the initiating C-C bond-forming step of formose-type chemistry. It is concentration-sensitive and challenging at low conversion, but glycolaldehyde is the canonical first higher sugar and borate-bearing alkaline brines can help stabilize higher-carbonyl products against runaway side reactions."}, {"id": "rxn_003", "name": "Formose homologation to glyceraldehyde", "inputs": ["mol_003", "mol_004"], "outputs": ["mol_005"], "environment": "Surface", "agents": ["borate minerals", "carbonate minerals"], "conditions": {"temperature": "300-340K", "pressure": "1 atm", "catalyst": "borate/carbonate mineral assemblage", "aqueous": true, "other": "Alkaline evaporitic pool or tidal-flat brine under wet-dry concentration"}, "mechanism": "Aldol homologation within formose chemistry.", "reasoning": "Aldol addition of formaldehyde to glycolaldehyde grows the carbon skeleton to a triose pool. Glyceraldehyde and dihydroxyacetone are both plausible outcomes under these conditions; only the glyceraldehyde branch is propagated here because it can dehydrate cleanly to methylglyoxal, a direct precursor to lactaldehyde."}, {"id": "rxn_004", "name": "Glyceraldehyde dehydration to pyruvaldehyde", "inputs": ["mol_005"], "outputs": ["mol_006", "mol_010"], "environment": "Surface", "agents": ["phosphate minerals"], "conditions": {"temperature": "330-370K", "pressure": "1 atm", "catalyst": "phosphate minerals", "aqueous": true, "other": "Warm evaporitic pools or subaerial geothermal fields with intermittent drying; mildly basic to neutral; anoxic"}, "mechanism": "Enediolization followed by dehydration and rearrangement to an alpha-oxoaldehyde.", "reasoning": "Triose sugars readily enolize and dehydrate under heating, especially in phosphate-rich or mildly basic media, to give methylglyoxal. Explicit H2O release keeps the node balanced and captures a known degradation path of glyceraldehyde without invoking any unpaired oxidant or reductant."}, {"id": "rxn_005", "name": "Hydrothermal reduction of pyruvaldehyde to lactaldehyde", "inputs": ["mol_006", "mol_002"], "outputs": ["mol_007"], "environment": "Hydrothermal", "agents": ["greigite", "awaruite"], "conditions": {"temperature": "350-400K", "pressure": "high", "catalyst": "greigite/awaruite", "aqueous": true, "other": "Anoxic H2-rich hydrothermal flow through Fe-Ni mineral assemblages"}, "mechanism": "Mineral-surface hydrogenation of the ketone carbonyl of methylglyoxal to give the corresponding alpha-hydroxy aldehyde.", "reasoning": "Compared with the Strecker and hydrolysis steps, this reduction is less directly constrained in prebiotic experiments, but it is chemically straightforward: H2-rich Fe/Ni sulfide or alloy surfaces can deliver the needed two-electron reduction of the keto group of methylglyoxal to lactaldehyde. Selectivity is the key bottleneck, and lactaldehyde would likely coexist with more reduced side products."}, {"id": "rxn_006", "name": "Strecker synthesis of threonine nitrile", "inputs": ["mol_007", "mol_008", "mol_009"], "outputs": ["mol_011", "mol_010"], "environment": "Surface", "agents": [], "conditions": {"temperature": "300-330K", "pressure": "1 atm", "catalyst": null, "aqueous": true, "other": "Concentrated NH3 and HCN in evaporitic or partially UV-shielded surface brines; anoxic"}, "mechanism": "Imine formation from lactaldehyde and ammonia followed by cyanide addition.", "reasoning": "This is the chemically strongest way to install the amino nitrile functionality on the correct beta-hydroxy carbon skeleton. Alpha-hydroxy aldehydes undergo standard Strecker chemistry to the corresponding alpha-amino nitriles. Explicit water release keeps the step balanced. Because lactaldehyde is already chiral and cyanide addition creates a new stereocenter, the product is expected to be a racemic threonine and allothreonine nitrile mixture rather than a single stereoisomer."}, {"id": "rxn_007", "name": "Hydration of threonine nitrile to threoninamide", "inputs": ["mol_011", "mol_010"], "outputs": ["mol_012"], "environment": "Surface", "agents": [], "conditions": {"temperature": "340-370K", "pressure": "1 atm", "catalyst": null, "aqueous": true, "other": "Hot surface waters in subaerial geothermal fields with repeated heating and cooling; anoxic"}, "mechanism": "Nucleophilic hydration of the nitrile to the corresponding amide.", "reasoning": "Aminonitrile hydrolysis is stepwise, with the amide as the chemically realistic first hydrolysis product under hot aqueous conditions. Representing threoninamide explicitly is more rigorous than collapsing the chemistry into an under-specified one-step conversion."}, {"id": "rxn_008", "name": "Hydrolysis of threoninamide to threonine", "inputs": ["mol_012", "mol_010"], "outputs": ["mol_013", "mol_009"], "environment": "Surface", "agents": [], "conditions": {"temperature": "340-370K", "pressure": "1 atm", "catalyst": null, "aqueous": true, "other": "Continued hot-water exposure in geothermal pools or hot springs; anoxic"}, "mechanism": "Amide hydrolysis to the carboxylic acid with ammonia release.", "reasoning": "Continued hot-water exposure converts the amide to the amino acid and explicitly releases NH3. This keeps the hydrolysis nonenzymatic and in a defined surface-geothermal setting rather than a vague biochemical placeholder; the resulting amino acid pool would contain both threonine and allothreonine, with threonine tracked as the target node."}, {"id": "rxn_009", "name": "Overall hydrolysis of threonine nitrile to threonine", "inputs": ["mol_011", "mol_010"], "outputs": ["mol_013", "mol_009"], "environment": "Surface", "agents": [], "conditions": {"temperature": "350-370K", "pressure": "1 atm", "catalyst": null, "aqueous": true, "other": "Extended hot aqueous exposure in geothermal pools; mechanistically via an unisolated amide intermediate"}, "mechanism": "Overall nitrile hydrolysis to the amino acid through sequential hydration and amide hydrolysis.", "reasoning": "This alternative overall node represents prolonged hydrolysis without isolating threoninamide. The net stoichiometry is threonine nitrile + 2 H2O -> threonine + NH3, with the implicit second water accounted for by stoichiometric inference. It summarizes the same chemistry made explicit in rxn_007 and rxn_008, again yielding a threonine and allothreonine mixture in practice."}], "pathways": [{"pathway_id": "P1", "name": "CO2-entry via stepwise hydrolysis", "description": "CO2 is reduced to a formaldehyde pool hydrothermally, expanded by surface formose chemistry to glyceraldehyde, degraded to methylglyoxal, reduc