essure": "1 atm", "catalyst": null, "aqueous": "true", "other": "HCN-bearing shallow pool or thin film; anoxic"}, "mechanism": "Cyanide attacks the iminium form of methanimine, yielding the aminonitrile.", "reasoning": "Addition of cyanide to a small imine is the key C-C bond-forming step of the Strecker reaction. Rapid trapping of transient methanimine makes glycine nitrile a credible prebiotic hub."}, {"id": "rxn_003", "name": "One-pot Strecker synthesis of glycine nitrile", "inputs": ["mol_001", "mol_002", "mol_004"], "outputs": ["mol_005"], "environment": "Surface", "agents": null, "conditions": {"temperature": "290-320K", "pressure": "1 atm", "catalyst": null, "aqueous": "true", "other": "one-pot evaporitic brine or tidal-flat pool; anoxic"}, "mechanism": "In situ methanimine formation is followed immediately by cyanide capture, giving glycine nitrile without isolating the imine.", "reasoning": "When formaldehyde, ammonia, and HCN coexist, aminonitrile formation can occur in one pot. This operationally distinct route avoids the need for a separately accumulating methanimine pool."}, {"id": "rxn_004", "name": "Hydrothermal decarboxylation of pyruvate to acetaldehyde", "inputs": ["mol_006"], "outputs": ["mol_008"], "environment": "Hydrothermal", "agents": ["magnetite", "FeS"], "conditions": {"temperature": "380-430K", "pressure": "high", "catalyst": "magnetite plus FeS", "aqueous": "true", "other": "subseafloor hydrothermal mixing zone; anoxic; rapid quench helps preserve acetaldehyde"}, "mechanism": "Thermal and mineral-assisted decarboxylation of the alpha-keto acid releases CO2 and furnishes acetaldehyde.", "reasoning": "Alpha-keto acids are thermally labile, and hydrothermal temperatures plus iron-rich mineral surfaces favor decarboxylation to simpler aldehydes. Pyruvate therefore provides an anoxic vent-compatible, though transient, source of acetaldehyde."}, {"id": "rxn_005", "name": "UV-driven dehydrogenation of ethanol to acetaldehyde", "inputs": ["mol_00