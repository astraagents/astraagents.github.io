    \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Biochemical\"\n    },\n    {\n      \"id\": \"mol_016\",\n      \"formula\": \"C5H10O5\",\n      \"iupac_name\": \"D-ribose\",\n      \"common_name\": null,\n      \"inchi\": \"InChI=1S/C5H10O5/c6-1-2(7)3(8)4(9)5(10)11-3/h1-5,8-10H,6H2\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_017\",\n      \"formula\": \"H2O\",\n      \"iupac_name\": \"oxidane\",\n      \"common_name\": \"water\",\n      \"inchi\": \"InChI=1S/H2O/h1H2\",\n      \"role\": \"starting\",\n      \"environment_formed\": \"Surface\"\n    }\n  ],\n  \"reactions\": [\n    {\n      \"id\": \"rxn_001\",\n      \"name\": \"Formose reaction (formaldehyde to erythrose)\",\n      \"inputs\": [\"mol_001\", \"mol_017\"],\n      \"outputs\": [\"mol_004\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"montmorillonite (clay)\"],\n      \"conditions\": {\n        \"temperature\": \"320-340K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"montmorillonite\",\n        \"aqueous\": true,\n        \"other\": \"alkaline, wet-dry cycles\"\n      },\n      \"mechanism\": \"Aldol reactions and rearrangements polymerize formaldehyde to C2\u2013C6 aldoses/ketoses, erythrose being a minor tetrose product.\",\n      \"reasoning\": \"Experimentally demonstrated in prebiotic conditions with clay or basic catalysts; tetroses are unstable, minor products (V\u00e1zquez-Salazar et al., 2018; Shen et al., 1987, 1990).\"\n    },\n    {\n      \"id\": \"rxn_002\",\n      \"name\": \"Prebiotic synthesis of formamidine from HCN and ammonia\",\n      \"inputs\": [\"mol_003\", \"mol_002\"],\n      \"outputs\": [\"mol_005\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300-330K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"evaporitic concentration\"\n      },\n      \"mechanism\": \"Tandem nucleophilic addition and condensation of HCN and NH3 yields formamidine; hydrolysis limits its accumulation.\",\n      \"reasoning\": \"Requires high local concentration (0.3 M) but chemically plausible without catalyst; forms in HCN/NH3-rich pools. (Shen et al., 1987, 1990; V\u00e1zquez-Salazar et al., 2018\u2014contested, concentration-limited).\"\n    },\n    {\n      \"id\": \"rxn_003\",\n      \"name\": \"Condensation and cyclization of erythrose and formamidine to imidazole-4-acetaldehyde\",\n      \"inputs\": [\"mol_004\", \"mol_005\"],\n      \"outputs\": [\"mol_006\", \"mol_007\", \"mol_008\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300-340K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"mildly basic, open aqueous pools\"\n      },\n      \"mechanism\": \"Imine formation and Amadori-type rearrangement lead to closure of the imidazole ring, generating imidazole-4-acetaldehyde with glycol and ethanol byproducts.\",\n      \"reasoning\": \"The only demonstrated prebiotic route to the correct C4-imidazole; but very low yields (1.6%) and strongly critiqued for prebiotic realism. (Shen et al., 1987, 1990).\"\n    },\n    {\n      \"id\": \"rxn_004\",\n      \"name\": \"Strecker-like cyanation/hydrolysis of imidazole-4-acetaldehyde to histidine\",\n      \"inputs\": [\"mol_006\", \"mol_003\", \"mol_002\"],\n      \"outputs\": [\"mol_009\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300-340K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"ambient aqueous, circumneutral pH\"\n      },\n      \"mechanism\": \"Imidazole-4-acetaldehyde reacts with HCN and NH3 via a Strecker reaction to yield amino nitrile, which hydrolyzes in water to yield histidine.\",\n      \"reasoning\": \"Directly demonstrated (histidine at 3.5% yield), but follows contested precursor formation. (Shen et al., 1990; V\u00e1zquez-Salazar et al., 2018).\"\n    },\n    {\n      \"id\": \"rxn_005\",\n      \"name\": \"Oxidation of imidazole-4-glycol to imidazole-4-acetaldehyde (speculative)\",\n      \"inputs\": [\"mol_007\"],\n      \"outputs\": [\"mol_006\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Fe(III) oxides (goethite/hematite)\"],\n      \"conditions\": {\n        \"temperature\": \"300-340K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"iron oxides\",\n        \"aqueous\": true,\n        \"other\": null\n      },\n      \"mechanism\": \"Fe(III)-mediated oxidation of the glycol intermediate to the corresponding aldehyde.\",\n      \"reasoning\": \"Not demonstrated in published prebiotic chemistry; oxidation assumed plausible by analogy to biological/organic synthesis, included as a reservoir edge (Shen et al., 1987, speculative).\"\n    },\n    {\n      \"id\": \"rxn_006\",\n      \"name\": \"Oxidation of imidazole-4-ethanol to imidazole-4-acetaldehyde (speculative)\",\n      \"inputs\": [\"mol_008\"],\n      \"outputs\": [\"mol_006\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Fe(III) oxides (goethite/hematite)\"],\n      \"conditions\": {\n        \"temperature\": \"300-340K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"iron oxides\",\n        \"aqueous\": true,\n        \"other\": null\n      },\n      \"mechanism\": \"Oxidation of the primary alcohol group to an aldehyde via Fe(III) oxides acting as oxidant.\",\n      \"reasoning\": \"Chemically plausible; not directly demonstrated in prebiotic experiments. (Supported as a byproduct in Shen et al., 1987, but conversion not shown).\"\n    },\n    {\n      \"id\": \"rxn_007\",\n      \"name\": \"HCN polymer hydrolysis (trace amino acids)\",\n      \"inputs\": [\"mol_003\", \"mol_002\", \"mol_017\"],\n      \"outputs\": [\"mol_009\", \"mol_013\", \"mol_014\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"360-380K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"acid hydrolysis, prolonged heating (trace yields)\"\n      },\n      \"mechanism\": \"HCN/NH4CN polymerizes and, upon strong acid hydrolysis, liberates trace histidine along with imidazole and amidine trimer.\",\n      \"reasoning\": \"Trace histidine detected in old hydrolyzed HCN polymer experiments\u2014bulk amino acid release unconfirmed by modern MS (Ruiz-Bermejo et al., 2013; see also reviews, weak evidence for actual histidine production).\"\n    },\n    {\n      \"id\": \"rxn_008\",\n      \"name\": \"Strecker-like reaction from imidazole-4-acetaldehyde reservoir (side pathway)\",\n      \"inputs\": [\"mol_006\", \"mol_003\", \"mol_002\"],\n      \"outputs\": [\"mol_009\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300-340K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"duplicate of main Strecker sequence from alternate reservoir\"\n      },\n      \"mechanism\": \"As in rxn_004\u2014amidocarbonyl cyanation followed by hydrolysis.\",\n      \"reasoning\": \"Redundant with rxn_004, included for explicit pathway enumeration from different reservoir sources. (Shen et al., 1990).\"\n    },\n    {\n      \"id\": \"rxn_009\",\n      \"name\": \"Semi-enzymatic (biotic-like) assembly of histidine via IGP\",\n      \"inputs\": [\"mol_016\", \"mol_015\", \"mol_002\"],\n      \"outputs\": [\"mol_009\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300-310K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"high NH4+, possible mineral phosphate, semi-enzymatic\"\n      },\n      \"mechanism\": \"PRPP and ATP (ribose-phosphate derivatives) condense and cyclize to imidazole glycerol phosphate, providing an imidazole ring; followed by further aminotransfer/hydrolysis to histidine.\",\n      \"reasoning\": \"Proposed as an early biotic (RNA/protein-catalysed) route, not demonstrated prebiotically, but congruent with extant biosynthesis (Lazcano & Miller; V\u00e1zquez-Salazar et al., 2018).\"\n    },\n    {\n      \"id\": \"rxn_010\",\n      \"name\": \"Debus-type condensation: imidazole ring formation from glyoxal, aldehyde, and ammonia (side product)\",\n      \"inputs\": [\"mol_001\", \"mol_002\"],\n      \"outputs\": [\"mol_013\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"330-350K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"evaporitic pools, not regioselective\"\n      },\n      \"mechanism\": \"Aldehyde and NH3 condense through cyclization to form imidazole derivatives (does not produce correct histori-dine side-chain).\",\n      \"reasoning\": \"Imidazole synthesis confirmed, but wrong substitution pattern for histidine; intermediary for side chemistry only (Or\u00f3 et al., 1984; Bennu: Mojarro et al., 2025).\"\n    },\n    {\n      \"id\": \"rxn_011\",\n      \"name\": \"Decarboxylation/amination of imidazole-4-carboxylic acid to imidazole-4-acetaldehyde (hypothetical)\",\n      \"inputs\": [\"mol_010\", \"mol_002\"],\n      \"outputs\": [\"mol_006\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"pyrite (FeS2)\"],\n      \"conditions\": {\n        \"temperature\": \"400-470K\",\n        \"pressure\": \"high\",\n        \"catalyst\": \"pyrite (FeS2)\",\n        \"aqueous\": true,\n        \"other\": \"reducing/alkaline subseafloor context\"\n      },\n      \"mechanism\": \"Reductive decarboxylation and amination promotes chain elongation from carboxylic acid to aldehyde.\",\n      \"reasoning\": \"Speculative; not demonstrated for C4 substitution, but imidazole carboxylic acid present in meteorites, with conversion hypothesized (Mojarro et al., 2025; see PNAS); prebiotic plausibility very limited.\"\n    },\n    {\n      \"id\": \"rxn_012\",\n      \"name\": \"Reductive amination of imidazole-4-pyruvic acid (hypothetical)\",\n      \"inputs\": [\"mol_011\", \"mol_002\"],\n      \"outputs\": [\"mol_009\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"native Fe/Ni\"],\n      \"conditions\": {\n        \"temperature\": \"420-480K\",\n        \"pressure\": \"high\",\n        \"catalyst\": \"Fe/Ni alloy\",\n        \"aqueous\": true,\n        \"other\": \"alkaline, subseafloor vent analog\"\n      },\n      \"mechanism\": \"Reductive amination akin to metabolic amino acid synthesis\u2014NH3 addition to hei-molo-4-pyruvate yields histidine.\",\n      \"reasoning\": \"No prebiotic synthesis of imidazole-4-pyruvate is known; the conversion is chemically plausible by analogy but unsupported by data (Amend & Shock, 1998; speculative).\"\n    },\n    {\n      \"id\": \"rxn_013\",\n      \"name\": \"C2\u2013C2 coupling of HCN/amidine to imidazole-4-acetaldehyde (cyanosulfidic speculative)\",\n      \"inputs\": [\"mol_001\", \"mol_003\", \"mol_002\", \"mol_005\"],\n      \"outputs\": [\"mol_006\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"UV light\", \"Cu(I)/phosphate/buffer\"],\n      \"conditions\": {\n        \"temperature\": \"300-330K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"UV, divalent metals\",\n        \"aqueous\": true,\n        \"other\": \"cyanosulfidic, wet-dry\"\n      },\n      \"mechanism\": \"UV-driven cross-coupling of HCN and formamidine fragments with formaldehyde provides correct C4 imidazole-acetaldehyde.\",\n      \"reasoning\": \"No experimental support; included to express speculative cyanosulfidic/C2\u2013C2 pathway (Patel et al., 2015; permitted by Mojarro et al., 2025 as theoretical).\"\n    },\n    {\n      \"id\": \"rxn_014\",\n      \"name\": \"Conversion of imidazole-4-ethylamine to imidazole-4-acetaldehyde (hypothetical oxidative deamination)\",\n      \"inputs\": [\"mol_012\"],\n      \"outputs\": [\"mol_006\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Fe(III) oxides\"],\n      \"conditions\": {\n        \"temperature\": \"310-340K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"iron oxides\",\n        \"aqueous\": true,\n        \"other\": null\n      },\n      \"mechanism\": \"Oxidative deamination of ethylamine group to aldehyde by Fe(III) oxides.\",\n      \"reasoning\": \"No experimental data in this setting; included as a plausible intermediate for minor side-reservoir (speculative).\"\n    }\n  ],\n  \"pathways\": [\n    {\n      \"pathway_id\": \"P1\",\n      \"name\": \"Canonical surface sugar-amidine condensation\",\n      \"description\": \"Formose synthesis of erythrose from formaldehyde, followed by condensation with formamidine to imidazole-4-acetaldehyde, and Strecker reaction to histidine (Shen et al./Or\u00f3 route, only verified edge).\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_002\", \"rxn_003\", \"rxn_004\"],\n      \"key_intermediates\": [\"mol_004\", \"mol_005\", \"mol_006\"]\n    },\n    {\n      \"pathway_id\": \"P2\",\n      \"name\": \"Imidazole-4-glycol oxidation branch\",\n      \"description\": \"Erythrose condenses to imidazole-4-glycol; iron-oxide-catalyzed oxidation to imidazole-4-acetaldehyde, giving histidine via Strecker.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_002\", \"rxn_003\", \"rxn_005\", \"rxn_004\"],\n      \"key_intermediates\": [\"mol_007\", \"mol_006\"]\n    },\n    {\n      \"pathway_id\": \"P3\",\n      \"name\": \"Imidazole-4-ethanol oxidation branch\",\n      \"description\": \"Imidazole-4-ethanol, another byproduct of the surface condensation, is oxidized to imidazole-4-acetaldehyde, then gives histidine via Strecker.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_002\", \"rxn_003\", \"rxn_006\", \"rxn_004\"],\n      \"key_intermediates\": [\"mol_008\", \"mol_006\"]\n    },\n    {\n      \"pathway_id\": \"P4\",\n      \"name\": \"HCN polymer hydrolysate (trace histidine/imidazole)\",\n      \"description\": \"HCN + NH3 condensation yields a heterogeneous polymer; acid hydrolysis liberates trace histidine (unsupported by modern MS), imidazole, and amidine trimer.\",\n      \"reaction_sequence\": [\"rxn_007\"],\n      \"key_intermediates\": [\"mol_014\", \"mol_013\"]\n    },\n    {\n      \"pathway_id\": \"P5\",\n      \"name\": \"Alternate Strecker from imidazole-4-acetaldehyde reservoirs\",\n      \"description\": \"Side branching: imidazole-4-acetaldehyde generated from oxidation or other pools reacts directly to histidine via Strecker chemistry, modeling possible real-world redundancy from intermediates.\",\n      \"reaction_sequence\": [\"rxn_008\"],\n      \"key_intermediates\": [\"mol_006\"]\n    },\n    {\n      \"pathway_id\": \"P6\",\n      \"name\": \"Semi-enzymatic biotic histidine synthesis\",\n      \"description\": \"IGP/HisF-like scenario: biochemically plausible route with ribose phosphate and imidazole glycerol phosphate, leading to histidine with high NH4+ (semi-enzymatic, biotic context only).\",\n      \"reaction_sequence\": [\"rxn_009\"],\n      \"key_intermediates\": [\"mol_015\"]\n    },\n    {\n      \"pathway_id\": \"P7\",\n      \"name\": \"Meteorite/bennu-derived imidazole-4-carboxylic acid conversion (speculative hydrothermal)\",\n      \"description\": \"Imidazole-4-carboxylic acid as detected in meteorites is chain-extended via hydrothermal decarboxylation and amination to imidazole-4-acetaldehyde, which then forms histidine via Strecker sequence.\",\n      \"reaction_sequence\": [\"rxn_011\", \"rxn_004\"],\n      \"key_intermediat