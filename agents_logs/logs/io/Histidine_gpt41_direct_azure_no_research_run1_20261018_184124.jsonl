ce", "agents": ["montmorillonite"], "conditions": {"temperature": "300-330K", "pressure": "1 atm", "catalyst": "montmorillonite", "aqueous": true, "other": "Wet-dry cycling"}, "mechanism": "Formaldehyde, HCN, and ammonia condense through imine and cyanohydrin intermediates to give glycine after hydrolysis.", "reasoning": "Classical prebiotic amino acid synthesis; enhanced by montmorillonite-catalyzed hydrolysis (Ferris et al., 1981)."}, {"id": "rxn_004", "name": "Strecker synthesis of alanine", "inputs": ["mol_005", "mol_003", "mol_006"], "outputs": ["mol_008"], "environment": "Surface", "agents": ["montmorillonite"], "conditions": {"temperature": "300-330K", "pressure": "1 atm", "catalyst": "montmorillonite", "aqueous": true, "other": "Wet-dry cycling"}, "mechanism": "Aldehyde, HCN, and ammonia undergo Strecker synthesis to produce alanine via the corresponding aminonitrile and hydrolysis.", "reasoning": "Supported by plausible prebiotic aldehyde/ammonia chemistry; montmorillonite enhances yield (Cleaves et al., 2009)."}, {"id": "rxn_005", "name": "Imidazole ring formation from formamide", "inputs": ["mol_003", "mol_006"], "outputs": ["mol_010"], "environment": "Surface", "agents": ["Al2O3", "UV light"], "conditions": {"temperature": "320-350K", "pressure": "1 atm", "catalyst": "Al2O3", "aqueous": false, "other": "Dry phase; UV irradiation"}, "mechanism": "Formamide and HCN thermally decompose and cyclize under evaporative/UV conditions to produce imidazole and related heterocycles.", "reasoning": "Supported by Saladino et al. (2001); plausible under evaporitic, mineral-catalyzed surface conditions."}, {"id": "rxn_006", "name": "Ammonolysis and hydrolysis of acetonitrile to glycine/alanine", "inputs": ["mol_012", "mol_006", "mol_004"], "outputs": ["mol_007", "mol_008"], "environment": "Surface", "agents": ["montmorillonite"], "conditions": {"temperature": "330K", "pressure": "1 atm", "catalyst": "montmorillonite", "aqueous": true, "other": "Wet-dry cycles"}, "mechanism": "Acetonitrile, ammonia, and formaldehyde generate aminonitrile and subsequently glycine and alanine.", "reasoning": "Alternative pathway incorporating nitrile chemistry for amino acid formation; supported for other amino acids (Peltzer et al., 1984)."}, {"id": "rxn_007", "name": "Alkylation of imidazole to imidazole-4-carbonitrile", "inputs": ["mol_010", "mol_003"], "outputs": ["mol_009"], "environment": "Surface", "agents": ["phosphate mineral", "UV light"], "conditions": {"temperature": "300-330K", "pressure": "1 atm", "catalyst": "phosphate minerals", "aqueous": true, "other": "UV irradiation"}, "mechanism": "Alkylation at imidazole ring with HCN under UV and mineral catalysis to generate imidazole nitrile.", "reasoning": "Supported for UV-induced ring alkylation in surface pools (Patel et al., 2015; speculative for this precise case, extends plausible chemistry)."}, {"id": "rxn_008", "name": "Hydrolysis of imidazole-4-carbonitrile to imidazole and urea", "inputs": ["mol_009", "mol_006"], "outputs": ["mol_010", "mol_015"], "environment": "Biochemical", "agents": ["null"], "conditions": {"temperature": "340K", "pressure": "1 atm", "catalyst": null, "aqueous": true, "other": "mild heating"}, "mechanism": "Hydrolysis of the nitrile to the corresponding imidazole and release of urea group.", "reasoning": "Prebiotic hydrolysis of nitrile functional groups is thermodynamically favored; supported in analogous prebiotic scenarios (Yamada et al., 2014)."}, {"id": "rxn_009", "name": "Histidine backbone build-up via condensation of imidazole and amino acid", "inputs": ["mol_010", "mol_008", "mol_006"], "outputs": ["mol_016"], "environment": "Biochemical", "agents": ["phosphate mineral surface", "heating/drying"], "conditions": {"temperature": "350-370K", "pressure": "1 atm", "catalyst": "phosphate minerals", "aqueous": false, "other": "dry-down"}, "mechanism": "Condensation between the nucleophilic imidazole, alpha-amino acid (alanine), and ammonia to form the imidazolyl-propanoic acid (histidine).", "reasoning": "Supported in phosphorylation/mineral-catalyzed condensations on prebiotic phosphate surfaces (Kitadai et al., 2018; general surface dehydration logic)."}, {"id": "rxn_010", "name": "Amination of glycolaldehyde to aminoacetaldehyde", "inputs": ["mol_005", "mol_006"], "outputs": ["mol_014"], "environment": "Hydrothermal", "agents": ["FeS mineral"], "conditions": {"temperature": "420K", "pressure": "high", "catalyst": "FeS", "aqueous": true, "other": "pH 8-9"}, "mechanism": "Nucleophilic attack of ammonia on glycolaldehyde to yield aminoacetaldehyde.", "reasoning": "Supported in hydrothermal amination reactions (Huber & W\u00e4chtersh\u00e4user, 1998)."}, {"id": "rxn_011", "name": "Cyclization of aminoacetaldehyde with formamidine to give imidazole", "inputs": ["mol_014", "mol_003"], "outputs": ["mol_010"], "environment": "Hydrothermal", "agents": ["FeS"], "conditions": {"temperature": "400K", "pressure": "high", "catalyst": "FeS", "aqueous": true, "other": "neutral pH"}, "mechanism": "Cyclization of diamino intermediate and imine (derived from HCN) gives imidazole ring.", "reasoning": "Prebiotic imidazole formation via diamino/imine cyclization is supported in both surface and vent chemistry (Saladino et al., 2001; speculative but logical extension)."}, {"id": "rxn_012", "name": "Addition of urea and glycolaldehyde for alternative imidazole synthesis", "inputs": ["mol_005", "mol_015", "mol_003"], "outputs": ["mol_010"], "environment": "Surface", "agents": ["borate mineral"], "conditions": {"temperature": "330-340K", "pressure": "1 atm", "catalyst": "borate minerals", "aqueous": true, "other": "repeated dry/damp cycling"}, "mechanism": "Urea and glycolaldehyde condense, cyclize with HCN (as a C1/N source) under borate stabilization to give imidazole.", "reasoning": "Borate minerals stabilize glycolaldehyde/urea chemistry (Kim et al., 2011, speculative for imidazole but supports related nucleobase assembly)."}], "pathways