ediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_016\",\n      \"formula\": \"H2O\",\n      \"iupac_name\": \"oxidane\",\n      \"common_name\": \"water\",\n      \"inchi\": \"InChI=1S/H2O/h1H2\",\n      \"role\": \"byproduct\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_017\",\n      \"formula\": \"NH4Cl\",\n      \"iupac_name\": \"ammonium chloride\",\n      \"common_name\": \"ammonium chloride\",\n      \"inchi\": \"InChI=1S/ClH.H3N/h1H;1H3\",\n      \"role\": \"byproduct\",\n      \"environment_formed\": null\n    }\n  ],\n  \"reactions\": [\n    {\n      \"id\": \"rxn_001\",\n      \"name\": \"Formose Reaction: Formaldehyde dimerization\",\n      \"inputs\": [\"mol_001\", \"mol_001\"],\n      \"outputs\": [\"mol_002\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"Ca(OH)2\"],\n      \"conditions\": {\n        \"temperature\": \"360-400K\",\n        \"pressure\": \"high\",\n        \"catalyst\": \"calcium hydroxide\",\n        \"aqueous\": true,\n        \"other\": \"alkaline; abundant formaldehyde\"\n      },\n      \"mechanism\": \"Aldol-type dimerization of formaldehyde on basic surfaces to glycolaldehyde.\",\n      \"reasoning\": \"Formose reaction is robust in alkaline hydrothermal settings and is experimentally supported as a prebiotic route to glycolaldehyde. (Weber, 1998; Ritson & Sutherland, 2012)\"\n    },\n    {\n      \"id\": \"rxn_002\",\n      \"name\": \"Oxidation of glycolaldehyde to glyoxylic acid\",\n      \"inputs\": [\"mol_002\", \"mol_016\"],\n      \"outputs\": [\"mol_011\", \"mol_001\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Fe2O3\"],\n      \"conditions\": {\n        \"temperature\": \"315-340K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"iron(III) oxide\",\n        \"aqueous\": true,\n        \"other\": \"wet-dry cycling\"\n      },\n      \"mechanism\": \"Mineral-catalyzed oxidation of glycolaldehyde, yielding glyoxylic acid and formaldehyde.\",\n      \"reasoning\": \"Prebiotic oxidation of glycolaldehyde to glyoxylic acid is plausible via iron oxides; the reaction also generates formaldehyde, thus is mass balanced. (Cleaves, 2008)\"\n    },\n    {\n      \"id\": \"rxn_003\",\n      \"name\": \"Strecker Synthesis: Glycine formation\",\n      \"inputs\": [\"mol_002\", \"mol_006\", \"mol_007\", \"mol_016\"],\n      \"outputs\": [\"mol_004\", \"mol_014\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300-340K\",\n        \"pressure\": \"ambient\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"aqueous/evaporitic pool\"\n      },\n      \"mechanism\": \"Glycolaldehyde reacts via Strecker pathway with ammonia and HCN to yield glycine and threonine nitrile.\",\n      \"reasoning\": \"The Strecker pathway from glycolaldehyde is a main abiotic route to glycine; competitive side reaction can yield nitriles such as threonine nitrile. (Miller, 1957; O'Connor & Powell, 2010)\"\n    },\n    {\n      \"id\": \"rxn_004\",\n      \"name\": \"Aldol Addition: Glycolaldehyde with acetaldehyde\",\n      \"inputs\": [\"mol_002\", \"mol_003\"],\n      \"outputs\": [\"mol_008\", \"mol_016\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Montmorillonite\"],\n      \"conditions\": {\n        \"temperature\": \"325-355K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"montmorillonite clay\",\n        \"aqueous\": true,\n        \"other\": \"wet-dry cycling\"\n      },\n      \"mechanism\": \"Aldol reaction between glycolaldehyde and acetaldehyde yields threoninal (2-hydroxypropanal).\",\n      \"reasoning\": \"Clay-catalyzed aldol additions of aldehydes are robust in prebiotic settings, supporting assembly of 3C-4C sugars and hydroxyaldehydes. (Ferris, 1996; Lambert, 2008)\"\n    },\n    {\n      \"id\": \"rxn_005\",\n      \"name\": \"Reductive amination of threoninal\