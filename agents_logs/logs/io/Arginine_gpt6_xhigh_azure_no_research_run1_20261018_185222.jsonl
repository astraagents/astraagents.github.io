\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_005\",\n      \"formula\": \"CH2N2\",\n      \"iupac_name\": \"cyanamide\",\n      \"common_name\": \"cyanamide\",\n      \"inchi\": \"InChI=1S/CH2N2/c2-1-3/h2H2\",\n      \"role\": \"hub_intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_006\",\n      \"formula\": \"H2O\",\n      \"iupac_name\": \"oxidane\",\n      \"common_name\": \"water\",\n      \"inchi\": \"InChI=1S/H2O/h1H2\",\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_007\",\n      \"formula\": \"CO2\",\n      \"iupac_name\": \"carbon dioxide\",\n      \"common_name\": \"carbon dioxide\",\n      \"inchi\": \"InChI=1S/CO2/c2-1-3\",\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_008\",\n      \"formula\": \"H2\",\n      \"iupac_name\": \"dihydrogen\",\n      \"common_name\": \"hydrogen\",\n      \"inchi\": \"InChI=1S/H2/h1H\",\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_009\",\n      \"formula\": \"C4H5NO\",\n      \"iupac_name\": \"4-oxobutanenitrile\",\n      \"common_name\": \"beta-cyanopropionaldehyde\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_010\",\n      \"formula\": \"C6H7N3O2\",\n      \"iupac_name\": \"5-(2-cyanoethyl)imidazolidine-2,4-dione\",\n      \"common_name\": \"5-(2-cyanoethyl)hydantoin\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_011\",\n      \"formula\": \"C6H11N3O2\",\n      \"iupac_name\": \"5-(3-aminopropyl)imidazolidine-2,4-dione\",\n      \"common_name\": \"ornithine hydantoin\",\n      \"inchi\": null,\n      \"role\": \"hub_intermediate\",\n      \"environment_formed\": \"Hydrothermal\"\n    },\n    {\n      \"id\": \"mol_012\",\n      \"formula\": \"C6H13N3O3\",\n      \"iupac_name\": \"5-amino-2-(carbamoylamino)pentanoic acid\",\n      \"common_name\": \"N-alpha-carbamoylornithine\",\n      \"inchi\": null,\n      \"role\": \"hub_intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_013\",\n      \"formula\": \"CH4O\",\n      \"iupac_name\": \"methanol\",\n      \"common_name\": \"methanol\",\n      \"inchi\": \"InChI=1S/CH4O/c1-2/h2H,1H3\",\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_014\",\n      \"formula\": \"C2H6O\",\n      \"iupac_name\": \"ethanol\",\n      \"common_name\": \"ethanol\",\n      \"inchi\": \"InChI=1S/C2H6O/c1-2-3/h3H,2H2,1H3\",\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_015\",\n      \"formula\": \"CH4S\",\n      \"iupac_name\": \"methanethiol\",\n      \"common_name\": \"methyl mercaptan\",\n      \"inchi\": \"InChI=1S/CH4S/c1-2/h2H,1H3\",\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_016\",\n      \"formula\": \"C2H6S\",\n      \"iupac_name\": \"ethanethiol\",\n      \"common_name\": \"ethyl mercaptan\",\n      \"inchi\": \"InChI=1S/C2H6S/c1-2-3/h3H,2H2,1H3\",\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_017\",\n      \"formula\": \"C2H6N2O\",\n      \"iupac_name\": \"methyl carbamimidate\",\n      \"common_name\": \"O-methylisourea\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_018\",\n      \"formula\": \"C3H8N2O\",\n      \"iupac_name\": \"ethyl carbamimidate\",\n      \"common_name\": \"O-ethylisourea\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_019\",\n      \"formula\": \"C2H6N2S\",\n      \"iupac_name\": \"methyl carbamimidothioate\",\n      \"common_name\": \"S-methylisothiourea\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_020\",\n      \"formula\": \"C3H8N2S\",\n      \"iupac_name\": \"ethyl carbamimidothioate\",\n      \"common_name\": \"S-ethylisothiourea\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_021\",\n      \"formula\": \"C7H13N5O2\",\n      \"iupac_name\": \"5-[3-(carbamimidamido)propyl]imidazolidine-2,4-dione\",\n      \"common_name\": \"arginine hydantoin\",\n      \"inchi\": null,\n      \"role\": \"hub_intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_022\",\n      \"formula\": \"C7H15N5O3\",\n      \"iupac_name\": \"2-(carbamoylamino)-5-(carbamimidamido)pentanoic acid\",\n      \"common_name\": \"N-alpha-carbamoylarginine\",\n      \"inchi\": null,\n      \"role\": \"hub_intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_023\",\n      \"formula\": \"C6H14N4O2\",\n      \"iupac_name\": \"2-amino-5-(carbamimidamido)pentanoic acid\",\n      \"common_name\": \"DL-arginine\",\n      \"inchi\": \"InChI=1S/C6H14N4O2/c7-4(5(11)12)2-1-3-10-6(8)9/h4H,1-3,7H2,(H,11,12)(H4,8,9,10)\",\n      \"role\": \"target\",\n      \"environment_formed\": \"Hydrothermal\"\n    }\n  ],\n  \"reactions\": [\n    {\n      \"id\": \"rxn_001\",\n      \"name\": \"Cyanogen ammonolysis supplying cyanamide and hydrogen cyanide\",\n      \"inputs\": [\"mol_002\", \"mol_003\"],\n      \"outputs\": [\"mol_005\", \"mol_004\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-305 K\",\n        \"pressure\": \"approximately 1 bar\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Proposed window: ammonia 0.05-0.2 M, cyanogen supplied incrementally to 1-10 mM, pH 9.5-10.5, contact time 1-60 minutes. Use a shaded, gas-fed pool or pore. HCN is substantially present as cyanide; excess ammonia also forms ammonium cyanide. Before donor use, residual ammonia must be reduced enough not to dominate guanyl-donor consumption. Degassing and subsequent HCN gas transfer are possible conditioning operations, but their recovery and cyanamide losses must be measured.\"\n      },\n      \"mechanism\": \"Ammonia attacks cyanogen, followed by proton transfer and cyanide departure. The neutral-form net equation is C2N2 + NH3 -> CH2N2 + HCN; all displayed coefficients are one.\",\n      \"reasoning\": \"Cyanogen ammonolysis is a recognizable cyanamide preparation, unlike an unspecified discharge equation. It also supplies cyanide required for the carbon skeleton. However, cyanogen abundance, competition from hydrolysis, and separation from excess ammonia remain unresolved prebiotic supply and handling requirements. This is not evidence for a naturally concentrated cyanamide reservoir.\"\n    },\n    {\n      \"id\": \"rxn_002\",\n      \"name\": \"Conjugate hydrocyanation of acrolein\",\n      \"inputs\": [\"mol_001\", \"mol_004\"],\n      \"outputs\": [\"mol_009\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\n        \"cyanide ion maintained by mildly alkaline carbonate-buffered water\"\n      ],\n      \"conditions\": {\n        \"temperature\": \"300-315 K\",\n        \"pressure\": \"approximately 1 bar\",\n        \"catalyst\": \"cyanide ion and general-base buffering; no transition-metal catalyst assumed\",\n        \"aqueous\": true,\n        \"other\": \"Proposed window: pH 7.5-8.5, total HCN/cyanide 20-100 mM, acrolein maintained at 1-5 mM by slow delivery, reaction time 0.5-12 hours. A covered pore limits HCN loss. Determine the 1,4-adduct, cyanohydrin, and polymer fractions before committing material downstream.\"\n      },\n      \"mechanism\": \"Cyanide adds at the beta carbon of acrolein; protonation of the resulting enolate affords NC-CH2-CH2-CHO.\",\n      \"reasoning\": \"This directly installs a reducible terminal nitrile without generating an aminoaldehyde. It replaces the previous nitro-Michael bottleneck with a chemically recognizable hydrocyanation, but does not make selectivity automatic: reversible carbonyl addition, oligomerization, and cyanide loss can compete. The stated environmental window is a proposal, and substrate-specific productive selectivity must be demonstrated.\"\n    },\n    {\n      \"id\": \"rxn_003\",\n      \"name\": \"Bucherer-Bergs capture of the aldehyde as a nitrile-bearing hydantoin\",\n      \"inputs\": [\"mol_009\", \"mol_004\", \"mol_003\", \"mol_007\"],\n      \"outputs\": [\"mol_010\", \"mol_006\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"323-343 K\",\n        \"pressure\": \"approximately 1 bar\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Proposed window: aldehyde 1-10 mM, total cyanide 20-100 mM, ammonia/ammonium 0.2-1 M, inorganic carbon 0.1-0.5 M, pH 8.5-9.5, 12-96 hours. A gas-fed or diffusion-limited pore is needed to retain volatile reagents. Carbon dioxide represents the equilibrating dissolved inorganic-carbon pool.\"\n      },\n      \"mechanism\": \"Aldehyde-derived aminonitrile formation is followed by carbamylation and intramolecular cyclization to the hydantoin. The remote nitrile remains available for reduction. The neutral net reaction produces one water molecule.\",\n      \"reasoning\": \"Bucherer-Bergs chemistry provides a chemically motivated alpha-amino protecting framework before the side-chain amine exists. It avoids capturing free 4-aminobutanal and avoids introducing an acetyl group with an uncertain thioester acylation. Nevertheless, competing reactions of this bifunctional aldehyde and preservation of the remote nitrile require substrate-specific testing; reaction-family precedent is not proof of a geochemical yield.\"\n    },\n    {\n      \"id\": \"rxn_004\",\n      \"name\": \"Complete hydrogenation of the protected side-chain nitrile\",\n      \"inputs\": [\"mol_010\", \"mol_008\"],\n      \"outputs\": [\"mol_011\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\n        \"fresh, sulfur-poor awaruite (Ni3Fe) with exposed metallic nickel sites\"\n      ],\n      \"conditions\": {\n        \"temperature\": \"383-413 K\",\n        \"pressure\": \"100-200 bar total; proposed H2 fugacity equivalent to 20-80 bar\",\n        \"catalyst\": \"exposed metallic nickel sites on awaruite; catalytic competence must be verified\",\n        \"aqueous\": true,\n        \"other\": \"Proposed window: nitrile-bearing hydantoin 1-20 mM, ammonia 0.1-0.5 M, pH 9-10 measured after cooling to 298 K, mineral loading 1-10 g/L, residence 6-72 hours. Require low dissolved sulfide and demonstrably unpassivated metal surfaces. Surface-derived substrate would enter through downwelling fractures; dilution, adsorption, and survival during transport cannot be assumed negligible. Cool effluent below 330 K before guanidination.\"\n      },\n      \"mechanism\": \"Surface hydrogenation proceeds through imine-like intermediates to the primary amine. The net equation consumes two H2 molecules per molecule of mol_010; the H2 ID is listed only once.\",\n      \"reasoning\": \"Unlike the earlier failed design, this reaction need not stop nitrile reduction at an aldehyde and contains no free aldehyde to over-reduce or cyclize. Synthetic nickel-catalyzed nitrile hydrogenation supports the reaction class, and ammonia can suppress secondary-amine formation. Awaruite is a specific chemically relevant natural metallic phase, not a generic mineral label. Its activity and selectivity for this hydantoin are nevertheless unestablished; engineered nickel catalysts cannot be equated with natural awaruite. This is a shared, decisive bottleneck across all ten pathways.\"\n    },\n    {\n      \"id\": \"rxn_005\",\n      \"name\": \"Controlled hydantoin opening while retaining the alpha-carbamoyl mask\",\n      \"inputs\": [\"mol_011\", \"mol_006\"],\n      \"outputs\": [\"mol_012\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\n        \"hydroxide supplied by a strongly alkaline rock-water-derived brine\"\n      ],\n      \"conditions\": {\n        \"temperature\": \"353-368 K\",\n        \"pressure\": \"approximately 1 bar\",\n        \"catalyst\": \"hydroxide; base-promoted hydrolysis\",\n        \"aqueous\": true,\n        \"other\": \"Proposed window: pH 11.5-12.5, substrate 5-30 mM, 12-96 hours in a warm alkaline discharge pool. Follow conversion to the open-chain ureido acid and stop before substantial loss of the carbamoyl mask. Subsequent cooling and mixing with bicarbonate-rich water must lower pH to the chosen guanidination window. Salt accumulation and material recovery require measurement.\"\n      },\n      \"mechanism\": \"Hydrolysis of the hydantoin carboxamide linkage opens the ring, adding one water molecule and giving N-alpha-carbamoylornithine.\",\n      \"reasoning\": \"Opening the ring leaves the alpha nitrogen in a urea-like group while exposing only the terminal primary amine as a strongly nucleophilic amine. This can offer better guanidination selectivity than an intact hydantoin with an acidic imide nitrogen. Nonenzymatic accumulation of this particular intermediate, rather than complete hydrolysis or reclosure, is not established under the proposed conditions and is a branch-specific bottleneck.\"\n    },\n    {\n      \"id\": \"rxn_006\",\n      \"name\": \"Acid-assisted preparation of O-methylisourea\",\n      \"inputs\": [\"mol_005\", \"mol_013\"],\n      \"outputs\": [\"mol_017\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\n        \"hydrogen chloride in an alcohol-enriched condensate\"\n      ],\n      \"conditions\": {\n        \"temperature\": \"300-315 K\",\n        \"pressure\": \"approximately 1 bar\",\n        \"catalyst\": \"acid activation by HCl\",\n        \"aqueous\": false,\n        \"other\": \"Preparative screening window: cyanamide 0.02-0.2 M, methanol-rich liquid with water below approximately 10 wt%, formal HCl concentration 0.1-1 M, 6-48 hours. Aqueous pH is not a meaningful descriptor for this solvent. The product is principally an isourea salt. Cool before dilution and neutralize only immediately before guanyl transfer. The required low-water methanol enrichment is a geological assumption, not an established pool composition.\"\n      },\n      \"mechanism\": \"Acid activation of cyanamide permits methanol addition across the nitrile functionality, yielding an O-methylisourea salt, represented by its neutral parent.\",\n      \"reasoning\": \"This specifies the acid activation and solvent requirements missing from an equation that simply combines cyanamide with methanol. Isourea formation is recognizable preparative chemistry, but hydrolysis competes in water-rich mixtures. The necessary alcohol enrichment and donor recovery are substantial prebiotic gaps, so this branch is less geochemically secure than the formula alone suggests.\"\n    },\n    {\n      \"id\": \"rxn_007\",\n      \"name\": \"Acid-assisted preparation of O-ethylisourea\",\n      \"inputs\": [\"mol_005\", \"mol_014\"],\n      \"outputs\": [\"mol_018\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\n        \"hydrogen chloride in an alcohol-enriched condensate\"\n      ],\n      \"conditions\": {\n        \"temperature\": \"300-320 K\",\n        \"pressure\": \"approximately 1 bar\",\n        \"catalyst\": \"acid activation by HCl\",\n        \"aqueous\": false,\n        \"other\": \"Preparative screening window: cyanamide 0.02-0.2 M, ethanol-rich liquid with water below approximately 10 wt%, formal HCl concentration 0.1-1 M, 6-72 hours. Product is retained as an isourea salt until immediately before use. Volatilization, dilution, and neutralization losses must be included in recovery measurements. A naturally ethanol-enriched, low-water compartment remains unverified.\"\n      },\n      \"mechanism\": \"Acid-activated addition of ethanol to cyanamide forms O-ethylisourea, represented without its counterion.\",\n      \"reasoning\": \"The ethyl donor is a chemically distinct homologous alternative, not an independent solution to cyanamide activation. Acidic low-water conditions are essential assumptions. There is no supplied evidence that its geological preparation or performance is superior to that of the methyl donor.\"\n    },\n    {\n      \"id\": \"rxn_008\",\n      \"name\": \"Acid-assisted preparation of S-methylisothiourea\",\n      \"inputs\": [\"mol_005\", \"mol_015\"],\n      \"outputs\": [\"mol_019\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\n        \"hydrogen chloride in an acidic thiol-fed pore\"\n      ],\n      \"conditions\": {\n        \"temperature\": \"300-315 K\",\n        \"pressure\": \"approximately 1 bar with a continuously replenished thiol-containing gas phase\",\n        \"catalyst\": \"acid activation by HCl\",\n        \"aqueous\": true,\n        \"other\": \"Proposed window: cyanamide 10-100 mM, dissolved methanethiol targeted at 20-200 mM, HCl 0.1-1 M, 6-48 hours. Actual dissolved thiol must be measured rather than inferred from gas supply. The isothiouronium salt is retained in acidic water and used after rapid dilution into the guanidination compartment. Avoid sulfide-rich metal surfaces that sequester sulfur compounds.\"\n      },\n      \"mechanism\": \"Methanethiol adds to acid-activated cyanamide to form an S-methylisothiouronium salt, represented by its neutral parent.\",\n      \"reasoning\": \"An isothiourea is a credible activated guanyl donor, and direct thiol addition is chemically motivated. However, productive formation at these aqueous concentrations, competition with cyanamide hydrolysis, and retention of highly volatile methanethiol remain unverified. Continuous gas delivery is a physical requirement, not an assumed catalyst.\"\n    },\n    {\n      \"id\": \"rxn_009\",\n      \"name\": \"Acid-assisted preparation of S-ethylisothiourea\",\n      \"inputs\": [\"mol_005\", \"mol_016\"],\n      \"outputs\": [\"mol_020\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\n        \"hydrogen chloride in an acidic thiol-fed pore\"\n      ],\n      \"conditions\": {\n        \"temperature\": \"300-320 K\",\n        \"pressure\": \"approximately 1 bar\",\n        \"catalyst\": \"acid activation by HCl\",\n        \"aqueous\": true,\n        \"other\": \"Proposed window: cyanamide 10-100 mM, dissolved ethanethiol 20-200 mM, HCl 0.1-1 M, 6-72 hours. Require continuing thiol delivery or a diffusion-limited pore; measure dissolved concentration and evaporation losses. Preserve the donor as its acidic salt until immediately before transfer into the amine-containing pool.\"\n      },\n      \"mechanism\": \"Acid-assisted ethanethiol addition across the cyanamide nitrile functionality produces S-ethylisothiourea.\",\n      \"reasoning\": \"This supplies a second chemically credible sulfur-based guanyl donor without invoking an unsupported discharge source. Ethyl substitution changes volatility and solubility but does not by itself establish better yield. Donor synthesis and survival during pH adjustment remain conditional, substrate-specific requirements.\"\n    },\n    {\n      \"id\": \"rxn_010\",\n      \"name\": \"Direct cyanamide guanidination of ornithine hydantoin\",\n      \"inputs\": [\"mol_011\", \"mol_005\"],\n      \"outputs\": [\"mol_021\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"333-353 K\",\n        \"pressure\": \"approximately 1 bar\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Proposed window: hydantoin 5-30 mM, cyanamide 0.05-0.3 M, pH 8.5-9.5, 1-7 days. Use a shaded concentrated film rather than unrestricted UV exposure. Residual ammonia must be quantified and sufficiently depleted not to dominate cyanamide consumption. Resolve terminal-amine guanidination from ring-nitrogen guanidination analytically.\"\n      },\n      \"mechanism\": \"The terminal primary amine attacks cyanamide, followed by proton transfers to form the guanidino group without a small-molecule coproduct.\",\n      \"reasoning\": \"Direct cyanamide guanidination minimizes donor-preparation requirements. The alpha nitrogen is masked, but the hydantoin imide can be deprotonated in this pH range, so exclusive side-chain selectivity is not assumed. Slow productive addition, cyanamide oligomerization, and ring-nitrogen reaction are major competing processes. This edge is a conditional desired transformation, not a demonstrated selective preparation.\"\n    },\n    {\n      \"id\": \"rxn_011\",\n      \"name\": \"O-methylisourea guanyl transfer to ornithine hydantoin\",\n      \"inputs\": [\"mol_011\", \"mol_017\"],\n      \"outputs\": [\"mol_021\", \"mol_013\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"313-343 K\",\n        \"pressure\": \"approximately 1 bar\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Proposed window: hydantoin 5-30 mM, donor 10-100 mM, pH 8.5-9.5, 12-96 hours. Dilute the acidic donor stream into buffered substrate solution incrementally. Ammonia carryover, donor hydrolysis, and wrong-site guanidination must be measured.\"\n      },\n      \"mechanism\": \"The terminal amine attacks the isourea carbon and displaces methanol after proton transfer.\",\n      \"reasoning\": \"O-alkylisourea-mediated guanidination is credible preparative chemistry and avoids unprotected alpha/side-chain diamine competition. It does not eliminate hydantoin ring-nitrogen competition or establish that the donor can be supplied prebiotically. No selectivity or yield is claimed for this exact substrate under the proposed window.\"\n    },\n    {\n      \"id\": \"rxn_012\",\n      \"name\": \"O-ethylisourea guanyl transfer to ornithine hydantoin\",\n      \"inputs\": [\"mol_011\", \"mol_018\"],\n      \"outputs\": [\"mol_021\", \"mol_014\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"313-343 K\",\n        \"pressure\": \"approximately 1 bar\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Proposed window: hydantoin 5-30 mM, donor 10-100 mM, pH 8.5-9.5, 12-96 hours. Introduce acidic donor solution slowly after cooling. Require direct measurement of desired guanidino substitution, donor loss, and residual ammonia competition.\"\n      },\n      \"mechanism\": \"Nucleophilic guanyl substitution by the side-chain amine releases ethanol.\",\n      \"reasoning\": \"The chemistry parallels O-methylisourea transfer but uses a distinct donor. Ethyl substitution does not resolve masking selectivity or upstream solvent-enrichment problems. This is a conditional homologous branch, not independently validated prebiotic chemistry.\"\n    },\n    {\n      \"id\": \"rxn_013\",\n      \"name\": \"S-methylisothiourea guanyl transfer to ornithine hydantoin\",\n      \"inputs\": [\"mol_011\", \"mol_019\"],\n      \"outputs\": [\"mol_021\", \"mol_015\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"313-343 K\",\n        \"pressure\": \"approximately 1 bar\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Proposed window: hydantoin 5-30 mM, donor 10-100 mM, pH 8.0-9.5, 6-72 hours. Cool and dilute the acidic donor feed immediately before contact. Methanethiol release can occur to the gas phase, but quantitative removal is not assumed. Screen separately for ring-nitrogen products.\"\n      },\n      \"mechanism\": \"The terminal amine attacks the isothiourea carbon; proton transfer and methanethiol departure furnish the guanidino group.\",\n      \"reasoning\": \"Isothiourea guanyl transfer has a stronger leaving-group rationale than unactivated cyanamide addition. The intact hydantoin masks the alpha amine but retains a potentially reactive imide nitrogen. Donor availability and substrate-specific regioselectivity remain unresolved even if the substitution class is credible.\"\n    },\n    {\n      \"id\": \"rxn_014\",\n      \"name\": \"S-ethylisothiourea guanyl transfer to ornithine hydantoin\",\n      \"inputs\": [\"mol_011\", \"mol_020\"],\n      \"outputs\": [\"mol_021\", \"mol_016\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"313-343 K\",\n        \"pressure\": \"approximately 1 bar\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Proposed window: hydantoin 5-30 mM, donor 10-100 mM, pH 8.0-9.5, 6-72 hours. Gradual mixing controls the acidic donor stream. Quantify ethanethiol release, donor hydrolysis, ammonia competition, and substitution at hydantoin nitrogens.\"\n      },\n      \"mechanism\": \"Side-chain amine attack at the activated guanyl carbon displaces ethanethiol.\",\n      \"reasoning\": \"This is a chemically distinguishable sulfur-donor alternative with the same masking rationale and limitations as the methyl homolog. There is no evidence supplied that it is intrinsically superior. The desired-product edge must not be interpreted as evidence of exclusive side-chain guanidination.\"\n    },\n    {\n      \"id\": \"rxn_015\",\n      \"name\": \"Direct cyanamide guanidination of N-alpha-carbamoylornithine\",\n      \"inputs\": [\"mol_012\", \"mol_005\"],\n      \"outputs\": [\"mol_022\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"333-353 K\",\n        \"pressure\": \"approximately 1 bar\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Proposed window: ureido acid 5-30 mM, cyanamide 0.05-0.3 M, pH 9.0-10.0, 1-7 days. Use concentrated shaded brine. Confirm that the alpha-carbamoyl group remains attached and that residual ammonia does not dominate donor consumption.\"\n      },\n      \"mechanism\": \"The terminal amine adds to cyanamide to form N-alpha-carbamoylarginine.\",\n      \"reasoning\": \"The ring-opened urea-like mask is less nucleophilic than a free alpha amine and avoids the acidic hydantoin imide. This improves the selectivity rationale without proving it. Productive direct guanidination must outcompete cyanamide decomposition, oligomerization, and reactions of the carbamoyl group; the added ring-opening step must also be justified by recovered yield.\"\n    },\n    {\n      \"id\": \"rxn_016\",\n      \"name\": \"O-methylisourea guanyl transfer to N-alpha-carbamoylornithine\",\n      \"inputs\": [\"mol_012\", \"mol_017\"],\n      \"outputs\": [\"mol_022\", \"mol_013\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"313-343 K\",\n        \"pressure\": \"approximately 1 bar\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Proposed window: ureido acid 5-30 mM, donor 10-100 mM, pH 9.0-10.0, 12-96 hours. Mix acidic donor into buffered substrate only immediately before reaction. Measure retention of the alpha-carbamoyl group, donor hydrolysis, and competing ammonia guanidination.\"\n      },\n      \"mechanism\": \"The free terminal amine substitutes at the isourea carbon, releasing methanol.\",\n      \"reasoning\": \"Masking the alpha nitrogen as an open-chain carbamoyl group gives a clear positional rationale for side-chain guanidination. It does not solve O-methylisourea production in a realistic early-Earth solvent or establish nonenzymatic mask removal. Substrate-specific rates and selectivity remain unmeasured in the proposed setting.\"\n    },\n    {\n      \"id\": \"rxn_017\",\n      \"name\": \"O-ethylisourea guanyl transfer to N-alpha-carbamoylornithine\",\n      \"inputs\": [\"mol_012\", \"mol_018\"],\n      \"outputs\": [\"mol_022\", \"mol_014\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"313-343 K\",\n        \"pressure\": \"approximately 1 bar\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Proposed window: ureido acid 5-30 mM, donor 10-100 mM, pH 9.0-10.0, 12-96 hours. Monitor mask persistence, ethanol release, and donor hydrolysis. Residual ammonia and excess inorganic salts from conditioning cannot be ignored.\"\n      },\n      \"mechanism\": \"Guanyl substitution by the terminal amine produces N-alpha-carbamoylarginine and ethanol.\",\n      \"reasoning\": \"This is a meaningful donor substitution within the ring-opened masking strategy. The ethyl donor offers no demonstrated geochemical advantage over the methyl donor. Product formation remains contingent on donor preparation, transfer survival, and selective reaction with the terminal amine.\"\n    },\n    {\n      \"id\": \"rxn_018\",\n      \"name\": \"S-methylisothiourea guanyl transfer to N-alpha-carbamoylornithine\",\n      \"inputs\": [\"mol_012\", \"mol_019\"],\n      \"outputs\": [\"mol_022\", \"mol_015\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"313-343 K\",\n        \"pressure\": \"approximately 1 bar\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Proposed window: ureido acid 5-30 mM, donor 10-100 mM, pH 8.5-10.0, 6-72 hours. Use immediate buffered mixing of the acidic donor feed. Verify side-chain substitution and mask survival by structural analysis rather than mass alone; isomeric guanidination products can share the same formula.\"\n      },\n      \"mechanism\": \"The terminal primary amine displaces methanethiol from the activated guanyl donor.\",\n      \"reasoning\": \"An activated sulfur donor combined with an open-chain alpha-carbamoyl mask gives a comparatively strong chemical selectivity rationale. This remains a conditional design, not an established geochemical preparation. It cannot compensate for failure of hydrocyanation, natural-mineral hydrogenation, controlled ring opening, or final decarbamoylation.\"\n    },\n    {\n      \"id\": \"rxn_019\",\n      \"name\": \"S-ethylisothiourea guanyl transfer to N-alpha-carbamoylornithine\",\n      \"inputs\": [\"mol_012\", \"mol_020\"],\n      \"outputs\": [\"mol_022\", \"mol_016\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"313-343 K\",\n        \"pressure\": \"approximately 1 bar\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Proposed window: ureido acid 5-30 mM, donor 10-100 mM, pH 8.5-10.0, 6-72 hours. Control acid-base mixing and quantify ethanethiol release, donor hydrolysis, and alpha-carbamoyl retention. Confirm the position of the installed guanidino group.\"\n      },\n      \"mechanism\": \"Side-chain amine attack and ethanethiol departure generate N-alpha-carbamoylarginine.\",\n      \"reasoning\": \"This has the same comparatively favorable masking and leaving-group rationale as the S-methyl route. No supplied evidence warrants ranking the two sulfur homologs by yield. All common upstream and downstream bottlenecks remain, and donor preparation is itself conditional.\"\n    },\n    {\n      \"id\": \"rxn_020\",\n      \"name\": \"Acidic ring opening of arginine hydantoin\",\n      \"inputs\": [\"mol_021\", \"mol_006\"],\n      \"outputs\": [\"mol_022\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\n        \"hydronium supplied by a chloride-rich volcanic acid brine\"\n      ],\n      \"conditions\": {\n        \"temperature\": \"393-413 K\",\n        \"pressure\": \"10-30 bar, sufficient to retain liquid water\",\n        \"catalyst\": \"hydronium\",\n        \"aqueous\": true,\n        \"other\": \"Proposed screening window: HCl 0.1-0.5 M, substrate 1-20 mM, residence 1-14 days in an acidic geothermal fracture separated from the earlier alkaline metal-bearing zone. This concentration of acid is a local geological requirement, not a generic vent property. N-alpha-carbamoylarginine may be a transient intermediate rather than an isolable product.\"\n      },\n      \"mechanism\": \"Acid-catalyzed hydrolysis opens the hydantoin carboxamide linkage, consuming one water molecule and forming the open-chain carbamoylated amino acid.\",\n      \"reasoning\": \"This is necessary to release the amino-acid skeleton from the hydantoin mask. Acidic rather than strongly alkaline processing is chosen to reduce the risk of guanidino-group degradation, but ring-opening rates and target survival in this proposed window are not demonstrated. Formation of the correct hydantoin does not establish successful nonenzymatic unmasking.\"\n    },\n    {\n      \"id\": \"rxn_021\",\n      \"name\": \"Hydrolytic removal of the alpha-carbamoyl group to release arginine\",\n      \"inputs\": [\"mol_022\", \"mol_006\"],\n      \"outputs\": [\"mol_023\", \"mol_003\", \"mol_007\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\n        \"hydronium supplied by a chloride-rich volcanic acid brine\"\n      ],\n      \"conditions\": {\n        \"temperature\": \"393-413 K\",\n        \"pressure\": \"10-30 bar\",\n        \"catalyst\": \"hydronium\",\n        \"aqueous\": true,\n        \"other\": \"Proposed screening window: HCl 0.1-0.5 M, substrate 1-20 mM, 1-14 days, with time-resolved measurements to find any interval of net arginine accumulation. Ammonia is predominantly ammonium in situ and arginine is protonated. Cool discharged solution below 330 K promptly. Stronger laboratory acid hydrolysis must not be silently substituted for this proposed geological window.\"\n      },\n      \"mechanism\": \"Hydrolysis of the alpha-linked carbamoyl group releases the alpha amine; the detached carbamic-acid equivalent decomposes to ammonia and carbon dioxide. The neutral net equation is mol_022 + H2O -> arginine + NH3 + CO2, with all coefficients one.\",\n      \"reasoning\": \"N-carbamoyl hydrolysis is chemically recognizable, and arginine is generally more compatible with acidic than strongly alkaline hydrolysis. Neither fact proves an adequate rate or recovered yield for this substrate in a volcanic brine. This terminal bottleneck must be established by direct arginine identification and mass balance, including checks for residual protected material, ornithine, and other decomposition products. No stereoselection is assumed; the intended product is racemic arginine.\"\n    }\n  ],\n  \"pathways\": [\n    {\n      \"pathway_id\": \"P1\",\n      \"name\": \"Intact hydantoin mask with direct cyanamide guanidination\",\n      \"description\": \"Build and hydrogenate the nitrile-bearing hydantoin, guanidinate its terminal amine directly with cyanamide, then open and remove the mask. This minimizes donor activation but retains slow guanidination and hydantoin ring-nitrogen selectivity risks.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_002\", \"rxn_003\", \"rxn_004\", \"rxn_010\", \"rxn_020\", \"rxn_021\"],\n      \"key_intermediates\": [\"mol_009\", \"mol_010\", \"mol_011\", \"mol_021\", \"mol_022\"]\n    },\n    {\n      \"pathway_id\": \"P2\",\n      \"name\": \"Intact hydantoin mask with O-methylisourea\",\n      \"description\": \"Prepare the protected ornithine skeleton and O-methylisourea in separate compartments, perform terminal guanyl transfer, and hydrolyze the mask. Low-water methanol enrichment is an additional unresolved requirement.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_002\", \"rxn_003\", \"rxn_004\", \"rxn_006\", \"rxn_011\", \"rxn_020\", \"rxn_021\"],\n      \"key_intermediates\": [\"mol_010\", \"mol_011\", \"mol_017\", \"mol_021\", \"mol_022\"]\n    },\n    {\n      \"pathway_id\": \"P3\",\n      \"name\": \"Intact hydantoin mask with O-ethylisourea\",\n      \"description\": \"Use O-ethylisourea as the activated donor before hydantoin hydrolysis. This is a homologous donor alternative, not independent evidence that the shared backbone synthesis works.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_002\", \"rxn_003\", \"rxn_004\", \"rxn_007\", \"rxn_012\", \"rxn_020\", \"rxn_021\"],\n      \"key_intermediates\": [\"mol_010\", \"mol_011\", \"mol_018\", \"mol_021\", \"mol_022\"]\n    },\n    {\n      \"pathway_id\": \"P4\",\n      \"name\": \"Intact hydantoin mask with S-methylisothiourea\",\n      \"description\": \"Generate the sulfur-based donor separately, transfer its guanyl group to the terminal amine, and release arginine by acidic hydrolysis. Donor formation and hydantoin substitution selectivity remain conditional.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_002\", \"rxn_003\", \"rxn_004\", \"rxn_008\", \"rxn_013\", \"rxn_020\", \"rxn_021\"],\n      \"key_intermediates\": [\"mol_010\", \"mol_011\", \"mol_019\", \"mol_021\", \"mol_022\"]\n    },\n    {\n      \"pathway_id\": \"P5\",\n      \"name\": \"Intact hydantoin mask with S-ethylisothiourea\",\n      \"description\": \"Employ the ethyl sulfur donor at the intact-hydantoin stage, followed by ring opening and decarbamoylation. No performance advantage over the methyl sulfur donor is assumed.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_002\", \"rxn_003\", \"rxn_004\", \"rxn_009\", \"rxn_014\", \"rxn_020\", \"rxn_021\"],\n      \"key_intermediates\": [\"mol_010\", \"mol_011\", \"mol_020\", \"mol_021\", \"mol_022\"]\n    },\n    {\n      \"pathway_id\": \"P6\",\n      \"name\": \"Open-chain carbamoyl mask with direct cyanamide\",\n      \"description\": \"Open ornithine hydantoin before guanidination while retaining its alpha-carbamoyl group. Direct cyanamide addition then precedes decarbamoylation. The improved masking rationale is purchased at the cost of controlled partial hydrolysis.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_002\", \"rxn_003\", \"rxn_004\", \"rxn_005\", \"rxn_015\", \"rxn_021\"],\n      \"key_intermediates\": [\"mol_010\", \"mol_011\", \"mol_012\", \"mol_022\"]\n    },\n    {\n      \"pathway_id\": \"P7\",\n      \"name\": \"Open-chain carbamoyl mask with O-methylisourea\",\n      \"description\": \"Guanidinate N-alpha-carbamoylornithine using separately prepared O-methylisourea, then hydrolyze the carbamoyl group. Both selective mask retention and prebiotic donor preparation require validation.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_002\", \"rxn_003\", \"rxn_004\", \"rxn_005\", \"rxn_006\", \"rxn_016\", \"rxn_021\"],\n      \"key_intermediates\": [\"mol_011\", \"mol_012\", \"mol_017\", \"mol_022\"]\n    },\n    {\n      \"pathway_id\": \"P8\",\n      \"name\": \"Open-chain carbamoyl mask with O-ethylisourea\",\n      \"description\": \"Use the ethyl oxygen donor after controlled hydantoin opening. The desired terminal guanidination avoids a free alpha amine, but donor solvent requirements and final deprotection remain unresolved.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_002\", \"rxn_003\", \"rxn_004\", \"rxn_005\", \"rxn_007\", \"rxn_017\", \"rxn_021\"],\n      \"key_intermediates\": [\"mol_011\", \"mol_012\", \"mol_018\", \"mol_022\"]\n    },\n    {\n      \"pathway_id\": \"P9\",\n      \"name\": \"Open-chain carbamoyl mask with S-methylisothiourea\",\n      \"description\": \"Combine the open-chain alpha-carbamoyl mask with an activated sulfur donor, then release arginine by decarbamoylation. This has a comparatively favorable selectivity rationale, but is not an experimentally demonstrated complete prebiotic route.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_002\", \"rxn_003\", \"rxn_004\", \"rxn_005\", \"rxn_008\", \"rxn_018\", \"rxn_021\"],\n      \"key_intermediates\": [\"mol_011\", \"mol_012\", \"mol_019\", \"mol_022\"]\n    },\n    {\n      \"pathway_id\": \"P10\",\n      \"name\": \"Open-chain carbamoyl mask with S-ethylisothiourea\",\n      \"description\": \"Use the ethyl sulfur donor after controlled ring opening and finish with alpha-decarbamoylation. Its chemical rationale is comparable to P9; neither homolog bypasses the shared mineral-hydrogenation and unmasking bottlenecks.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_002\", \"rxn_003\", \"rxn_004\", \"rxn_005\", \"rxn_009\", \"rxn_019\", \"rxn_021\"],\n      \"key_intermediates\": [\"mol_011\", \"mol_012\", \"mol_020\", \"mol_022\"]\n    }\n  ],\n  \"hub_molecules\": [\n    \"mol_003\",\n    \"mol_004\",\n    \"mol_005\",\n    \"mol_006\",\n    \"mol_007\",\n    \"mol_011\",\n    \"mol_012\",\n    \"mol_013\",\n    \"mol_014\",\n    \"mol_015\",\n    \"mol_016\",\n    \"mol_017\",\n    \"mol_018\",\n    \"mol_019\",\n    \"mol_020\",\n    \"mol_021\",\n    \"mol_022\"\n  ],\n  \"convergence_points\": [\n    {\n      \"molecule_id\": \"mol_021\",\n      \"incoming_reactions\": [\"rxn_010\", \"rxn_011\", \"rxn_012\", \"rxn_013\", \"rxn_014\"],\n      \"outgoing_reactions\": [\"rxn_020\"]\n    },\n    {\n      \"molecule_id\": \"mol_022\",\n      \"incoming_reactions\": [\"rxn_015\", \"rxn_016\", \"rxn_017\", \"rxn_018\", \"rxn_019\", \"rxn_020\"],\n      \"outgoing_reactions\": [\"rxn_021\"]\n    }\n  ]\n}", "parsed_response": {"target_molecule": "Arginine", "overall_strategy": "Construct a racemic ornithine skeleton by conjugate hydrocyanation of acrolein, capture the aldehyde as a hydantoin, and only then reduce the remaining side-chain nitrile. This ordering avoids selective partial nitrile reduction, free 4-aminobutanal, and guanidination of an unprotected alpha-amino group. Five guanyl donors are evaluated at two genuinely different masking stages: the intact hydantoin and its ring-opened N-alpha-carbamoyl derivative. These combinations give ten distinct conditional pathways, not ten independently demonstrated prebiotic syntheses; methyl/ethyl donor pairs are homologous alternatives. No supplied evidence establishes an end-to-end prebiotic arginine synthesis. Numerical conditions below are proposed experimental screening windows, not reported substrate-specific yields or proven geological operating windows. The principal unresolved requirements are selective acrolein hydrocyanation, activity of a natural nickel-bearing phase toward the protected nitrile, donor availability, guanidination selectivity, and productive nonenzymatic unmasking. Simple feedstocks are stipulated rather than assigned unsupported origins. All reactions are anoxic. Surface organics would require transport through water-filled fractures into a sulfur-poor hydrogen-rich hydrothermal reaction zone, followed by cooling and concentration before guanidination; final acidic hydrolysis requires a separate chloride-rich geothermal compartment. Such transfers are physical assumptions requiring recovery measurements, not additional synthesis reactions. Molecules are represented once in neutral constitutional forms; protonation, counterions, and acid-base neutralization are described in conditions rather than duplicated as molecule nodes. Formation-environment labels identify a principal formation setting, not an exclusive one. The network describes productive transformations, not an exhaustive inventory of competing products.", "molecules": [{"id": "mol_001", "formula": "C3H4O", "iupac_name": "prop-2-enal", "common_name": "acrolein", "inchi": "InChI=1S/C3H4O/c1-2-3-4/h2-3H,1H2", "role": "starting", "environment_formed": null}, {"id": "mol_002", "formula": "C2N2", "iupac_name": "ethanedinitrile", "common_name": "cyanogen", "inchi": "InChI=1S/C2N2/c3-1-2-4", "role": "starting", "environment_formed": null}, {"id": "mol_003", "formula": "NH3", "iupac_name": "azane", "common_name": "ammonia", "inchi": "InChI=1S/H3N/h1H3", "role": "starting", "environment_formed": null}, {"id": "mol_004", "formula": "CHN", "iupac_name": "hydrogen cyanide", "common_name": "hydrogen cyanide", "inchi": "InChI=1S/CHN/c1-2/h1H", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_005", "formula": "CH2N2", "iupac_name": "cyanamide", "common_name": "cyanamide", "inchi": "InChI=1S/CH2N2/c2-1-3/h2H2", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_006", "formula": "H2O", "iupac_name": "oxidane", "common_name": "water", "inchi": "InChI=1S/H2O/h1H2", "role": "starting", "environment_formed": null}, {"id": "mol_007", "formula": "CO2", "iupac_name": "carbon dioxide", "common_name": "carbon dioxide", "inchi": "InChI=1S/CO2/c2-1-3", "role": "starting", "environment_formed": null}, {"id": "mol_008", "formula": "H2", "iupac_name": "dihydrogen", "common_name": "hydrogen", "inchi": "InChI=1S/H2/h1H", "role": "starting", "environment_formed": null}, {"id": "mol_009", "formula": "C4H5NO", "iupac_name": "4-oxobutanenitrile", "common_name": "beta-cyanopropionaldehyde", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_010", "formula": "C6H7N3O2", "iupac_name": "5-(2-cyanoethyl)imidazolidine-2,4-dione", "common_name": "5-(2-cyanoethyl)hydantoin", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_011", "formula": "C6H11N3O2", "iupac_name": "5-(3-aminopropyl)imidazolidine-2,4-dione", "common_name": "ornithine hydantoin", "inchi": null, "role": "hub_intermediate", "environment_formed": "Hydrothermal"}, {"id": "mol_012", "formula": "C6H13N3O3", "iupac_name": "5-amino-2-(carbamoylamino)pentanoic acid", "common_name": "N-alpha-carbamoylornithine", "inchi": null, "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_013", "formula": "CH4O", "iupac_name": "methanol", "common_name": "methanol", "inchi": "InChI=1S/CH4O/c1-2/h2H,1H3", "role": "starting", "environment_formed": null}, {"id": "mol_014", "formula": "C2H6O", "iupac_name": "ethanol", "common_name": "ethanol", "inchi": "InChI=1S/C2H6O/c1-2-3/h3H,2H2,1H3", "role": "starting", "environment_formed": null}, {"id": "mol_015", "formula": "CH4S", "iupac_name": "methanethiol", "common_name": "methyl mercaptan", "inchi": "InChI=1S/CH4S/c1-2/h2H,1H3", "role": "starting", "environment_formed": null}, {"id": "mol_016", "formula": "C2H6S", "iupac_name": "ethanethiol", "common_name": "ethyl mercaptan", "inchi": "InChI=1S/C2H6S/c1-2-3/h3H,2H2,1H3", "role": "starting", "environment_formed": null}, {"id": "mol_017", "formula": "C2H6N2O", "iupac_name": "methyl carbamimidate", "common_name": "O-methylisourea", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_018", "formula": "C3H8N2O", "iupac_name": "ethyl carbamimidate", "common_name": "O-ethylisourea", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_019", "formula": "C2H6N2S", "iupac_name": "methyl carbamimidothioate", "common_name": "S-methylisothiourea", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_020", "formula": "C3H8N2S", "iupac_name": "ethyl carbamimidothioate", "common_name": "S-ethylisothiourea", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_021", "formula": "C7H13N5O2", "iupac_name": "5-[3-(carbamimidamido)propyl]imidazolidine-2,4-dione", "common_name": "arginine hydantoin", "inchi": null, "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_022", "formula": "C7H15N5O3", "iupac_name": "2-(carbamoylamino)-5-(carbamimidamido)pentanoic acid", "common_name": "N-alpha-carbamoylarginine", "inchi": null, "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_023", "formula": "C6H14N4O2", "iupac_name": "2-amino-5-(carbamimidamido)pentanoic acid", "common_name": "DL-arginine", "inchi": "InChI=1S/C6H14N4O2/c7-4(5(11)12)2-1-3-10-6(8)9/h4H,1-3,7H2,(H,11,12)(H4,8,9,10)", "role": "target", "environment_formed": "Hydrothermal"}], "reactions": [{"id": "rxn_001", "name": "Cyanogen ammonolysis supplying cyanamide and hydrogen cyanide", "inputs": ["mol_002", "mol_003"], "outputs": ["mol_005", "mol_004"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-305 K", "pressure": "approximately 1 bar", "catalyst": null, "aqueous": true, "other": "Proposed window: ammonia 0.05-0.2 M, cyanogen supplied incrementally to 1-10 mM, pH 9.5-10.5, contact time 1-60 minutes. Use a shaded, gas-fed pool or pore. HCN is substantially present as cyanide; excess ammonia also forms ammonium cyanide. Before donor use, residual ammonia must be reduced enough not to dominate guanyl-donor consumption. Degassing and subsequent HCN gas transfer are possible conditioning operations, but their recovery and cyanamide losses must be measured."}, "mechanism": "Ammonia attacks cyanogen, followed by proton transfer and cyanide departure. The neutral-form net equation is C2N2 + NH3 -> CH2N2 + HCN; all displayed coefficients are one.", "reasoning": "Cyanogen ammonolysis is a recognizable cyanamide preparation, unlike an unspecified discharge equation. It also supplies cyanide required for the carbon skeleton. However, cyanogen abundance, competition from hydrolysis, and separation from excess ammonia remain unresolved prebiotic supply and handling requirements. This is not evidence for a naturally concentrated cyanamide reservoir."}, {"id": "rxn_002", "name": "Conjugate hydrocyanation of acrolein", "inputs": ["mol_001", "mol_004"], "outputs": ["mol_009"], "environment": "Surface", "agents": ["cyanide ion maintained by mildly alkaline carbonate-buffered water"], "conditions": {"temperature": "300-315 K", "pressure": "approximately 1 bar", "catalyst": "cyanide ion and general-base buffering; no transition-metal catalyst assumed", "aqueous": true, "other": "Proposed window: pH 7.5-8.5, total HCN/cyanide 20-100 mM, acrolein maintained at 1-5 mM by slow delivery, reaction time 0.5-12 hours. A covered pore limits HCN loss. Determine the 1,4-adduct, cyanohydrin, and polymer fractions before committing material downstream."}, "mechanism": "Cyanide adds at the beta carbon of acrolein; protonation of the resulting enolate affords NC-CH2-CH2-CHO.", "reasoning": "This directly installs a reducible terminal nitrile without generating an aminoaldehyde. It replaces the previous nitro-Michael bottleneck with a chemically recognizable hydrocyanation, but does not make selectivity automatic: reversible carbonyl addition, oligomerization, and cyanide loss can compete. The stated environmental window is a proposal, and substrate-specific productive selectivity must be demonstrated."}, {"id": "rxn_003", "name": "Bucherer-Bergs capture of the aldehyde as a nitrile-bearing hydantoin", "inputs": ["mol_009", "mol_004", "mol_003", "mol_007"], "outputs": ["mol_010", "mol_006"], "environment": "Surface", "agents": null, "conditions": {"temperature": "323-343 K", "pressure": "approximately 1 bar", "catalyst": null, "aqueous": true, "other": "Proposed window: aldehyde 1-10 mM, total cyanide 20-100 mM, ammonia/ammonium 0.2-1 M, inorganic carbon 0.1-0.5 M, pH 8.5-9.5, 12-96 hours. A gas-fed or diffusion-limited pore is needed to retain volatile reagents. Carbon dioxide represents the equilibrating dissolved inorganic-carbon pool."}, "mechanism": "Aldehyde-derived aminonitrile formation is followed by carbamylation and intramolecular cyclization to the hydantoin. The remote nitrile remains available for reduction. The neutral net reaction produces one water molecule.", "reasoning": "Bucherer-Bergs chemistry provides a chemically motivated alpha-amino protecting framework before the side-chain amine exists. It avoids capturing free 4-aminobutanal and avoids introducing an acetyl group with an uncertain thioester acylation. Nevertheless, competing reactions of this bifunctional aldehyde and preservation of the remote nitrile require substrate-specific testing; reaction-family precedent is not proof of a geochemical yield."}, {"id": "rxn_004", "name": "Complete hydrogenation of the protected side-chain nitrile", "inputs": ["mol_010", "mol_008"], "outputs": ["mol_011"], "environment": "Hydrothermal", "agents": ["fresh, sulfur-poor awaruite (Ni3Fe) with exposed metallic nickel sites"], "conditions": {"temperature": "383-413 K", "pressure": "100-200 bar total; proposed H2 fugacity equivalent to 20-80 bar", "catalyst": "exposed metallic nickel sites on awaruite; catalytic competence must be verified", "aqueous": true, "other": "Proposed window: nitrile-bearing hydantoin 1-20 mM, ammonia 0.1-0.5 M, pH 9-10 measured after cooling to 298 K, mineral loading 1-10 g/L, residence 6-72 hours. Require low dissolved sulfide and demonstrably unpassivated metal surfaces. Surface-derived substrate would enter through downwelling fractures; dilution, adsorption, and survival during transport cannot be assumed negligible. Cool effluent below 330 K before guanidination."}, "mechanism": "Surface hydrogenation proceeds through imine-like intermediates to the primary amine. The net equation consumes two H2 molecules per molecule of mol_010; the H2 ID is listed only once.", "reasoning": "Unlike the earlier failed design, this reaction need not stop nitrile reduction at an aldehyde and contains no free aldehyde to over-reduce or cyclize. Synthetic nickel-catalyzed nitrile hydrogenation supports the reaction class, and ammonia can suppress secondary-amine formation. Awaruite is a specific chemically relevant natural metallic phase, not a generic mineral label. Its activity and selectivity for this hydantoin are nevertheless unestablished; engineered nickel catalysts cannot be equated with natural awaruite. This is a shared, decisive bottleneck across all ten pathways."}, {"id": "rxn_005", "name": "Controlled hydantoin opening while retaining the alpha-carbamoyl mask", "inputs": ["mol_011", "mol_006"], "outputs": ["mol_012"], "environment": "Surface", "agents": ["hydroxide supplied by a strongly alkaline rock-water-derived brine"], "conditions": {"temperature": "353-368 K", "pressure": "approximately 1 bar", "catalyst": "hydroxide; base-promoted hydrolysis", "aqueous": true, "other": "Proposed window: pH 11.5-12.5, substrate 5-30 mM, 12-96 hours in a warm alkaline discharge pool. Follow conversion to the open-chain ureido acid and stop before substantial loss of the carbamoyl mask. Subsequent cooling and mixing with bicarbonate-rich water must lower pH to the chosen guanidination window. Salt accumulation and material recovery require measurement."}, "mechanism": "Hydrolysis of the hydantoin carboxamide linkage opens the ring, adding one water molecule and giving N-alpha-carbamoylornithine.", "reasoning": "Opening the ring leaves the alpha nitrogen in a urea-like group while exposing only the terminal primary amine as a strongly nucleophilic amine. This can offer better guanidination selectivity than an intact hydantoin with an acidic imide nitrogen. Nonenzymatic accumulation of this particular intermediate, rather than complete hydrolysis or reclosure, is not established under the proposed conditions and is a branch-specific bottleneck."}, {"id": "rxn_006", "name": "Acid-assisted preparation of O-methylisourea", "inputs": ["mol_005", "mol_013"], "outputs": ["mol_017"], "environment": "Surface", "agents": ["hydrogen chloride in an alcohol-enriched condensate"], "conditions": {"temperature": "300-315 K", "pressure": "approximately 1 bar", "catalyst": "acid activation by HCl", "aqueous": false, "other": "Preparative screening window: cyanamide 0.02-0.2 M, methanol-rich liquid with water below approximately 10 wt%, formal HCl concentration 0.1-1 M, 6-48 hours. Aqueous pH is not a meaningful descriptor for this solvent. The product is principally an isourea salt. Cool before dilution and neutralize only immediately before guanyl transfer. The required low-water methanol enrichment is a geological assumption, not an established pool composition."}, "mechanism": "Acid activation of cyanamide permits methanol addition across the nitrile functionality, yielding an O-methylisourea salt, represented by its neutral parent.", "reasoning": "This specifies the acid activation and solvent requirements missing from an equation that simply combines cyanamide with methanol. Isourea formation is recognizable preparative chemistry, but hydrolysis competes in water-rich mixtures. The necessary alcohol enrichment and donor recovery are substantial prebiotic gaps, so this branch is less geochemically secure than the formula alone suggests."}, {"id": "rxn_007", "name": "Acid-assisted preparation of O-ethylisourea", "inputs": ["mol_005", "mol_014"], "outputs": ["mol_018"], "environment": "Surface", "agents": ["hydrogen chloride in an alcohol-enriched condensate"], "conditions": {"temperature": "300-320 K", "pressure": "approximately 1 bar", "catalyst": "acid activation by HCl", "aqueous": false, "other": "Preparative screening window: cyanamide 0.02-0.2 M, ethanol-rich liquid with water below approximately 10 wt%, formal HCl concentration 0.1-1 M, 6-72 hours. Product is retained as an isourea salt until immediately before use. Volatilization, dilution, and neutralization losses must be included in recovery measurements. A naturally ethanol-enriched, low-water compartment remains unverified."}, "mechanism": "Acid-activated addition of ethanol to cyanamide forms O-ethylisourea, represented without its counterion.", "reasoning": "The ethyl donor is a chemically distinct homologous alternative, not an independent solution to cyanamide activation. Acidic low-water conditions are essential assumptions. There is no supplied evidence that its geological preparation or performance is superior to that of the methyl donor."}, {"id": "rxn_008", "name": "Acid-assisted preparation of S-methylisothiourea", "inputs": ["mol_005", "mol_015"], "outputs": ["mol_019"], "environment": "Surface", "agents": ["hydrogen chloride in an acidic thiol-fed pore"], "conditions": {"temperature": "300-315 K", "pressure": "approximately 1 bar with a continuously replenished thiol-containing gas phase", "catalyst": "acid activation by HCl", "aqueous": true, "other": "Proposed window: cyanamide 10-100 mM, dissolved methanethiol targeted at 20-200 mM, HCl 0.1-1 M, 6-48 hours. Actual dissolved thiol must be measured rather than inferred from gas supply. The isothiouronium salt is retained in acidic water and used after rapid dilution into the guanidination compartment. Avoid sulfide-rich metal surfaces that sequester sulfur compounds."}, "mechanism": "Methanethiol adds to acid-activated cyanamide to form an S-methylisothiouronium salt, represented by its neutral parent.", "reasoning": "An isothiourea is a credible activated guanyl donor, and direct thiol addition is chemically motivated. However, productive formation at these aqueous concentrations, competition with cyanamide hydrolysis, and retention of highly volatile methanethiol remain unverified. Continuous gas delivery is a physical requirement, not an assumed catalyst."}, {"id": "rxn_009", "name": "Acid-assisted preparation of S-ethylisothiourea", "inputs": ["mol_005", "mol_016"], "outputs": ["mol_020"], "environment": "Surface", "agents": ["hydrogen chloride in an acidic thiol-fed pore"], "conditions": {"temperature": "300-320 K", "pressure": "approximately 1 bar", "catalyst": "acid activation by HCl", "aqueous": true, "other": "Proposed window: cyanamide 10-100 mM, dissolved ethanethiol 20-200 mM, HCl 0.1-1 M, 6-72 hours. Require continuing thiol delivery or a diffusion-limited pore; measure dissolved concentration and evaporation losses. Preserve the donor as its acidic salt until immediately before transfer into the amine-containing pool."}, "mechanism": "Acid-assisted ethanethiol addition across the cyanamide nitrile functionality produces S-ethylisothiourea.", "reasoning": "This supplies a second chemically credible sulfur-based guanyl donor without invoking an unsupported discharge source. Ethyl substitution changes volatility and solubility but does not by itself establish better yield. Donor synthesis and survival during pH adjustment remain conditional, substrate-specific requirements."}, {"id": "rxn_010", "name": "Direct cyanamide guanidination of ornithine hydantoin", "inputs": ["mol_011", "mol_005"], "outputs": ["mol_021"], "environment": "Surface", "agents": null, "conditions": {"temperature": "333-353 K", "pressure": "approximately 1 bar", "catalyst": null, "aqueous": true, "other": "Proposed window: hydantoin 5-30 mM, cyanamide 0.05-0.3 M, pH 8.5-9.5, 1-7 days. Use a shaded concentrated film rather than unrestricted UV exposure. Residual ammonia must be quantified and sufficiently depleted not to dominate cyanamide consumption. Resolve terminal-amine guanidination from ring-nitrogen guanidination analytically."}, "mechanism": "The terminal primary amine attacks cyanamide, followed by proton transfers to form the guanidino group without a small-molecule coproduct.", "reasoning": "Direct cyanamide guanidination minimizes donor-preparation requirements. The alpha nitrogen is masked, but the hydantoin imide can be deprotonated in this pH range, so exclusive side-chain selectivity is not assumed. Slow productive addition, cyanamide oligomerization, and ring-nitrogen reaction are major competing processes. This edge is a conditional desired transformation, not a demonstrated selective preparation."}, {"id": "rxn_011", "name": "O-methylisourea guanyl transfer to ornithine hydantoin", "inputs": ["mol_011", "mol_017"], "outputs": ["mol_021", "mol_013"], "environment": "Surface", "agents": null, "conditions": {"temperature": "313-343 K", "pressure": "approximately 1 bar", "catalyst": null, "aqueous": true, "other": "Proposed window: hydantoin 5-30 mM, donor 10-100 mM, pH 8.5-9.5, 12-96 hours. Dilute the acidic donor stream into buffered substrate solution incrementally. Ammonia carryover, donor hydrolysis, and wrong-site guanidination must be measured."}, "mechanism": "The terminal amine attacks the isourea carbon and displaces methanol after proton transfer.", "reasoning": "O-alkylisourea-mediated guanidination is credible preparative chemistry and avoids unprotected alpha/side-chain diamine competition. It does not eliminate hydantoin ring-nitrogen competition or establish that the donor can be supplied prebiotically. No selectivity or yield is claimed for this exact substrate under the proposed window."}, {"id": "rxn_012", "name": "O-ethylisourea guanyl transfer to ornithine hydantoin", "inputs": ["mol_011", "mol_018"], "outputs": ["mol_021", "mol_014"], "environment": "Surface", "agents": null, "conditions": {"temperature": "313-343 K", "pressure": "approximately 1 bar", "catalyst": null, "aqueous": true, "other": "Proposed window: hydantoin 5-30 mM, donor 10-100 mM, pH 8.5-9.5, 12-96 hours. Introduce acidic donor solution slowly after cooling. Require direct measurement of desired guanidino substitution, donor loss, and residual ammonia competition."}, "mechanism": "Nucleophilic guanyl substitution by the side-chain amine releases ethanol.", "reasoning": "The chemistry parallels O-methylisourea transfer but uses a distinct donor. Ethyl substitution does not resolve masking selectivity or upstream solvent-enrichment problems. This is a conditional homologous branch, not independently validated prebiotic chemistry."}, {"id": "rxn_013", "name": "S-methylisothiourea guanyl transfer to ornithine hydantoin", "inputs": ["mol_011", "mol_019"], "outputs": ["mol_021", "mol_015"], "environment": "Surface", "agents": null, "conditions": {"temperature": "313-343 K", "pressure": "approximately 1 bar", "catalyst": null, "aqueous": true, "other": "Proposed window: hydantoin 5-30 mM, donor 10-100 mM, pH 8.0-9.5, 6-72 hours. Cool and dilute the acidic donor feed immediately before contact. Methanethiol release can occur to the gas phase, but quantitative removal is not assumed. Screen separately for ring-nitrogen products."}, "mechanism": "The terminal amine attacks the isothiourea carbon; proton transfer and methanethiol departure furnish the guanidino group.", "reasoning": "Isothiourea guanyl transfer has a stronger leaving-group rationale than unactivated cyanamide addition. The intact hydantoin masks the alpha amine but retains a potentially reactive imide nitrogen. Donor availability and substrate-specific regioselectivity remain unresolved even if the substitution class is credible."}, {"id": "rxn_014", "name": "S-ethylisothiourea guanyl transfer to ornithine hydantoin", "inputs": ["mol_011", "mol_020"], "outputs": ["mol_021", "mol_016"], "environment": "Surface", "agents": null, "conditions": {"temperature": "313-343 K", "pressure": "approximately 1 bar", "catalyst": null, "aqueous": true, "other": "Proposed window: hydantoin 5-30 mM, donor 10-100 mM, pH 8.0-9.5, 6-72 hours. Gradual mixing controls the acidic donor stream. Quantify ethanethiol release, donor hydrolysis, ammonia competition, and substitution at hydantoin nitrogens."}, "mechanism": "Side-chain amine attack at the activated guanyl carbon displaces ethanethiol.", "reasoning": "This is a chemically distinguishable sulfur-donor alternative with the same masking rationale and limitations as the methyl homolog. There is no evidence supplied that it is intrinsically superior. The desired-product edge must not be interpreted as evidence of exclusive side-chain guanidination."}, {"id": "rxn_015", "name": "Direct cyanamide guanidination of N-alpha-carbamoylornithine", "inputs": ["mol_012", "mol_005"], "outputs": ["mol_022"], "environment": "Surface", "agents": null, "conditions": {"temperature": "333-353 K", "pressure": "approximately 1 bar", "catalyst": null, "aqueous": true, "other": "Proposed window: ureido acid 5-30 mM, cyanamide 0.05-0.3 M, pH 9.0-10.0, 1-7 days. Use concentrated shaded brine. Confirm that the alpha-carbamoyl group remains attached and that residual ammonia does not dominate donor consumption."}, "mechanism": "The terminal amine adds to cyanamide to form N-alpha-carbamoylarginine.", "reasoning": "The ring-opened urea-like mask is less nucleophilic than a free alpha amine and avoids the acidic hydantoin imide. This improves the selectivity rationale without proving it. Productive direct guanidination must outcompete cyanamide decomposition, oligomerization, and reactions of the carbamoyl group; the added ring-opening step must also be justified by recovered yield."}, {"id": "rxn_016", "name": "O-methylisourea guanyl transfer to N-alpha-carbamoylornithine", "inputs": ["mol_012", "mol_017"], "outputs": ["mol_022", "mol_013"], "environment": "Surface", "agents": null, "conditions": {"temperature": "313-343 K", "pressure": "approximately 1 bar", "catalyst": null, "aqueous": true, "other": "Proposed window: ureido acid 5-30 mM, donor 10-100 mM, pH 9.0-10.0, 12-96 hours. Mix acidic donor into buffered substrate only immediately before reaction. Measure retention of the alpha-carbamoyl group, donor hydrolysis, and competing ammonia guanidination."}, "mechanism": "The free terminal amine substitutes at the isourea carbon, releasing methanol.", "reasoning": "Masking the alpha nitrogen as an open-chain carbamoyl group gives a clear positional rationale for side-chain guanidination. It does not solve O-methylisourea production in a realistic early-Earth solvent or establish nonenzymatic mask removal. Substrate-specific rates and selectivity remain unmeasured in the proposed setting."}, {"id": "rxn_017", "name": "O-ethylisourea guanyl transfer to N-alpha-carbamoylornithine", "inputs": ["mol_012", "mol_018"], "outputs": ["mol_022", "mol_014"], "environment": "Surface", "agents": null, "conditions": {"temperature": "313-343 K", "pressure": "approximately 1 bar", "catalyst": null, "aqueous": true, "other": "Proposed window: ureido acid 5-30 mM, donor 10-100 mM, pH 9.0-10.0, 12-96 hours. Monitor mask persistence, ethanol release, and donor hydrolysis. Residual ammonia and excess inorganic salts from conditioning cannot be ignored."}, "mechanism": "Guanyl substitution by the terminal amine produces N-alpha-carbamoylarginine and ethanol.", "reasoning": "This is a meaningful donor substitution within the ring-opened masking strategy. The ethyl donor offers no demonstrated geochemical advantage over the methyl donor. Product formation remains contingent on donor preparation, transfer survival, and selective reaction with the terminal amine."}, {"id": "rxn_018", "name": "S-methylisothiourea guanyl transfer to N-alpha-carbamoylornithine", "inputs": ["mol_012", "mol_019"], "outputs": ["mol_022", "mol_015"], "environment": "Surface", "agents": null, "conditions": {"temperature": "313-343 K", "pressure": "approximately 1 bar", "catalyst": null, "aqueous": true, "other": "Proposed window: ureido acid 5-30 mM, donor 10-100 mM, pH 8.5-10.0, 6-72 hours. Use immediate buffered mixing of the acidic donor feed. Verify side-chain substitution and mask survival by structural analysis rather than mass alone; isomeric guanidination products can share the same formula."}, "mechanism": "The terminal primary amine displaces methanethiol from the activated guanyl donor.", "reasoning": "An activated sulfur donor combined with an open-chain alpha-carbamoyl mask gives a comparatively strong chemical selectivity rationale. This remains a conditional design, not an established geochemical preparation. It cannot compensate for failure of hydrocyanation, natural-mineral hydrogenation, controlled ring opening, or final decarbamoylation."}, {"id": "rxn_019", "name": "S-ethylisothiourea guanyl transfer to N-alpha-carbamoylornithine", "inputs": ["mol_012", "mol_020"], "outputs": ["mol_022", "mol_016"], "environment": "Surface", "agents": null, "conditions": {"temperature": "313-343 K", "pressure": "approximately 1 bar", "catalyst": null, "aqueous": true, "other": "Proposed window: ureido acid 5-30 mM, donor 10-100 mM, pH 8.5-10.0, 6-72 hours. Control acid-base mixing and quantify ethanethiol release, donor hydrolysis, and alpha-carbamoyl retention. Confirm the position of the installed guanidino group."}, "mechanism": "Side-chain amine attack and ethanethiol departure generate N-alpha-carbamoylarginine.", "reasoning": "This has the same comparatively favorable masking and leaving-group rationale as the S-methyl route. No supplied evidence warrants ranking the two sulfur homologs by yield. All common upstream and downstream bottlenecks remain, and donor preparation is itself conditional."}, {"id": "rxn_020", "name": "Acidic ring opening of arginine hydantoin", "inputs": ["mol_021", "mol_006"], "outputs": ["mol_022"], "environment": "Hydrothermal", "agents": ["hydronium supplied by a chloride-rich volcanic acid brine"], "conditions": {"temperature": "393-413 K", "pressure": "10-30 bar, sufficient to retain liquid water", "catalyst": "hydronium", "aqueous": true, "other": "Proposed screening window: HCl 0.1-0.5 M, substrate 1-20 mM, residence 1-14 days in an acidic geothermal fracture separated from the earlier alkaline metal-bearing zone. This concentration of acid is a local geological requirement, not a generic vent property. N-alpha-carbamoylarginine may be a transient intermediate rather than an isolable product."}, "mechanism": "Acid-catalyzed hydrolysis opens the hydantoin carboxamide linkage, consuming one water molecule and forming the open-chain carbamoylated amino acid.", "reasoning": "This is necessary to release the amino-acid skeleton from the hydantoin mask. Acidic rather than strongly alkaline processing is chosen to reduce the risk of guanidino-group degradation, but ring-opening rates and target survival in this proposed window are not demonstrated. Formation of the correct hydantoin does not establish successful nonenzymatic unmasking."}, {"id": "rxn_021", "name": "Hydrolytic removal of the alpha-carbamoyl group to release arginine", "inputs": ["mol_022", "mol_006"], "outputs": ["mol_023", "mol_003", "mol_007"], "environment": "Hydrothermal", "agents": ["hydronium supplied by a chloride-rich volcanic acid brine"], "conditions": {"temperature": "393-413 K", "pressure": "10-30 bar", "catalyst": "hydronium", "aqueous": true, "other": "Proposed screening window: HCl 0.1-0.5 M, substrate 1-20 mM, 1-14 days, with time-resolved measurements to find any interval of net arginine accumulation. Ammonia is predominantly ammonium in situ and arginine is protonated. Cool discharged solution below 330 K promptly. Stronger laboratory acid hydrolysis must not be silently substituted for this proposed geological window."}, "mechanism": "Hydrolysis of the alpha-linked carbamoyl group releases the alpha amine; the detached carbamic-acid equivalent decomposes to ammonia and carbon dioxide. The neutral net equation is mol_022 + H2O -> arginine + NH3 + CO2, with all coefficients one.", "reasoning": "N-carbamoyl hydrolysis is chemically recognizable, and arginine is generally more compatible with acidic than strongly alkaline hydrolysis. Neither fact proves an adequate rate or recovered yield for this substrate in a volcanic brine. This terminal bottleneck must be established by direct arginine identification and mass balance, including checks for residual protected material, ornithine, and other decomposition products. No stereoselection is assumed; the intended product is racemic arginine."}], "pathways": [{"pathway_id": "P1", "name": "Intact hydantoin mask with direct cyanamide guanidination", "description": "Build and hydrogenate the nitrile-bearing hydantoin, guanidinate its terminal amine directly with cyanamide, then open and remove the mask. This minimizes donor activation but retains slow guanidination and hydantoin ring-nitrogen selectivity risks.", "reaction_sequence": ["rxn_001", "rxn_002", "rxn_003", "rxn_004", "rxn_010", "rxn_020", "rxn_021"], "key_intermediates": ["mol_009", "mol_010", "mol_011", "mol_021", "mol_022"]}, {"pathway_id": "P2", "name": "Intact hydantoin mask with O-methylisourea", "description": "Prepare the protected ornithine skeleton and O-methylisourea in separate compartments, perform terminal guanyl transfer, and hydrolyze the mask. Low-water methanol enrichment is an additional unresolved requirement.", "reaction_sequence": ["rxn_001", "rxn_002", "rxn_003", "rxn_004", "rxn_006", "rxn_011", "rxn_020", "rxn_021"], "key_intermediates": ["mol_010", "mol_011", "mol_017", "mol_021", "mol_022"]}, {"pathway_id": "P3", "name": "Intact hydantoin mask with O-ethylisourea", "description": "Use O-ethylisourea as the activated donor before hydantoin hydrolysis. This is a homologous donor alternative, not independent evidence that the shared backbone synthesis works.", "reaction_sequence": ["rxn_001", "rxn_002", "rxn_003", "rxn_004", "rxn_007", "rxn_012", "rxn_020", "rxn_021"], "key_intermediates": ["mol_010", "mol_011", "mol_018", "mol_021", "mol_022"]}, {"pathway_id": "P4", "name": "Intact hydantoin mask with S-methylisothiourea", "description": "Generate the sulfur-based donor separately, transfer its guanyl group to the terminal amine, and release arginine by acidic hydrolysis. Donor formation and hydantoin substitution selectivity remain conditional.", "reaction_sequence": ["rxn_001", "rxn_002", "rxn_003", "rxn_004", "rxn_008", "rxn_013", "rxn_020", "rxn_021"], "key_intermediates": ["mol_010", "mol_011", "mol_019", "mol_021", "mol_022"]}, {"pathway_id": "P5", "name": "Intact hydantoin mask with S-ethylisothiourea", "description": "Employ the ethyl sulfur donor at the intact-hydantoin stage, followed by ring opening and decarbamoylation. No performance advantage over the methyl sulfur donor is assumed.", "reaction_sequence": ["rxn_001", "rxn_002", "rxn_003", "rxn_004", "rxn_009", "rxn_014", "rxn_020", "rxn_021"], "key_intermediates": ["mol_010", "mol_011", "mol_020", "mol_021", "mol_022"]}, {"pathway_id": "P6", "name": "Open-chain ca