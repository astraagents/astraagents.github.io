ctions": [{"id": "rxn_001", "name": "Acetaldehyde cyanohydrin formation", "inputs": ["mol_002", "mol_001"], "outputs": ["mol_006"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-310 K, proposed near-ambient operating window", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Approximately neutral to mildly alkaline water; cyanide speciation controls reaction rate. Retain volatile HCN and acetaldehyde in a locally concentrated reservoir."}, "mechanism": "Reversible cyanide addition to the aldehyde carbonyl followed by proton transfer produces racemic lactonitrile.", "reasoning": "This is the defined acetaldehyde-entry step of the threonine-precursor sequence reported by Ritson and Sutherland (2013). No mineral is required. Concentration, volatilization, and competing cyanide reactions limit environmental flux; cyanide storage in closed-basin settings has independent geochemical support from Toner and Catling (2019)."}, {"id": "rxn_002", "name": "Cu(I)-assisted sulfidic photoreduction of lactonitrile", "inputs": ["mol_006", "mol_005", "mol_004"], "outputs": ["mol_007", "mol_003", "mol_014"], "environment": "Surface", "agents": ["Copper(I) cyanide photoredox component"], "conditions": {"temperature": "300-310 K, proposed near-ambient operating window", "pressure": "Approximately 1 atm", "catalyst": "CuCN/Cu(I)", "aqueous": true, "other": "Anoxic, UV-transparent shallow water near pH 7; laboratory reference uses 254 nm irradiation. Representative related-module conditions were 10 mM nitrile, 30 mM H2S, 33 mM phosphate, and 10 mol% CuCN, not a universal recipe for every substrate."}, "mechanism": "Photogenerated reducing equivalents reduce the nitrile to an imine-level intermediate; hydrolysis releases lactaldehyde and ammonia. Sulfide supplies reducing equivalents.", "reasoning": "Ritson and Sutherland (2013) obtained lactaldehyde in 19% yield after two hours in the acetaldehyde-cyanohydrin photochemical system. This supports the carbon transformation, not identical yields under all modeled conditions. Elemental sulfur is an oxidized-sulfur endmember for net redox bookkeeping; actual sulfur products may include polysulfides. Cu/Fe sulfide precipitation and sulfur-associated UV attenuation constrain deployment (Ranjan et al., 2018)."}, {"id": "rxn_003", "name": "Copper-free sulfidic photoreduction candidate", "inputs": ["mol_006", "mol_005", "mol_004"], "outputs": ["mol_007", "mol_003", "mol_014"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-310 K, proposed", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Anoxic UV irradiation with H2S/HS- near neutral pH; no added copper. Target-substrate irradiation time and effective concentrations are unestablished."}, "mechanism": "Sulfide-derived photochemistry supplies reducing equivalents for nitrile reduction and subsequent imine hydrolysis without an added copper mediator.", "reasoning": "Speculative threonine-specific extension. Patel et al. (2015) support copper-independent reduction within H2S-containing cyanosulfidic chemistry, but the supplied evidence does not establish a separate copper-free lactonitrile-to-lactaldehyde yield. This is an alternative photoredox implementation, not an independently demonstrated threonine synthesis. Sulfur availability and UV compatibility remain constrained (Ranjan et al., 2018). S8 is provisional redox-endmember bookkeeping."}, {"id": "rxn_004", "name": "Ferrocyanide-sulfite photoreduction candidate", "inputs": ["mol_006", "mol_015", "mol_004"], "outputs": ["mol_007", "mol_003", "mol_016"], "environment": "Surface", "agents": ["Dissolved hexacyanidoferrate(II), ferrocyanide, as photoredox mediator"], "conditions": {"temperature": "300-310 K, proposed", "pressure": "Approximately 1 atm", "catalyst": "Ferrocyanide photoredox mediator", "aqueous": true, "other": "Anoxic UV-exposed water containing sulfite/bisulfite; approximately neutral to mildly alkaline candidate conditions. Lactonitrile-specific optimization is not established."}, "mechanism": "Photoinduced electron-transfer chemistry reduces the nitrile; imine hydrolysis gives lactaldehyde and ammonia. Sulfite supplies reducing equivalents.", "reasoning": "Speculative substrate-specific extension of experimentally demonstrated HCN reductive homologation using sulfite and ferrocyanide (Xu et al., 2018). That study did not establish a new threonine endpoint or the lactonitrile conversion modeled here. Sulfite provides a chemically motivated alternative where sustained hydrosulfide is difficult (Ranjan et al., 2018). Sulfate is a possible oxidized-sulfur balance endmember, not an assertion that it is the unique measured photoproduct."}, {"id": "rxn_005", "name": "Lactaldehyde cyanohydrin formation", "inputs": ["mol_007", "mol_001"], "outputs": ["mol_008"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-310 K, proposed near-ambient window", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Near-neutral aqueous cyanide; protect the accumulating hydroxyaldehyde-derived pool from excessive continued irradiation and competing condensation."}, "mechanism": "Reversible cyanide addition to lactaldehyde produces 2,3-dihydroxybutanenitrile as a stereoisomeric cyanohydrin pool.", "reasoning": "Ritson and Sutherland (2013) describe conversion of lactaldehyde through its cyanohydrin into the threonine/allothreonine aminonitrile. Explicitly retaining this node avoids conflating aldehyde capture with amination or nitrile hydrolysis. Environmental lactaldehyde persistence remains an unmeasured bottleneck."}, {"id": "rxn_006", "name": "Strecker aminonitrile formation from the lactaldehyde cyanohydrin pool", "inputs": ["mol_008", "mol_003"], "outputs": ["mol_009", "mol_004"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-310 K, proposed near-ambient window", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Excess ammonia with retained cyanide; days-to-weeks residence may be necessary. pH must permit both carbonyl/iminium chemistry and sufficient available ammonia."}, "mechanism": "Cyanohydrin dissociation regenerates lactaldehyde and cyanide; ammonia-derived imine/iminium formation and cyanide capture yield the aminonitrile. This is not assumed to be direct displacement of hydroxide from the cyanohydrin.", "reasoning": "The threonine/allothreonine Strecker aminonitrile is an experimentally supported endpoint of Ritson and Sutherland (2013). Related conversions took days to weeks. Competing carbonyl reactions, ammonia loss, and cyanohydrin equilibria therefore matter; the transformation should not be represented as instantaneous."}, {"id": "rxn_007", "name": "Threonine-family aminonitrile hydrolysis", "inputs": ["mol_009", "mol_004"], "outputs": ["mol_010", "mol_011", "mol_012", "mol_013", "mol_003"], "environment": "Surface", "agents": ["Hydronium ions for specific acid catalysis"], "conditions": {"temperature": "330-370 K, proposed environmental window", "pressure": "Approximately 1 atm", "catalyst": "Hydronium ions", "aqueous": true, "other": "Candidate acidic pool, approximately pH 1-3, after transfer or temporal acidification of the aminonitrile-containing water. Required residence time and competing decomposition rates are unknown."}, "mechanism": "Sequential nitrile hydration through an amide and subsequent amide hydrolysis form the carboxylic acid and release ammonia, predominantly ammonium at the stated pH.", "reasoning": "Speculative environmental completion of an experimentally established precursor route. Ritson and Sutherland (2013) demonstrated the aminonitrile, not a quantified free-threonine yield under these proposed pool conditions. The chemistry is standard nitrile hydrolysis, but its useful environmental rate is a major unresolved bottleneck. The listed stereoisomers are possible products, not equal-yield coefficients or a demonstrated L-selective outcome."}, {"id": "rxn_008", "name": "HCN oligomerization to aminomalononitrile", "inputs": ["mol_001"], "outputs": ["mol_017"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-330 K, proposed concentration-stage window", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Concentrated HCN/cyanide in mildly alkaline water, approximately pH 8-10. The node represents trimer formation within competing oligomerization, not quantitative conversion into a pure trimer."}, "mechanism": "Successive cyanide/HCN addition and proton-transfer reactions generate the HCN trimer aminomalononitrile.", "reasoning": "Aminomalononitrile is the established HCN trimer used in Thanassi's threonine chemistry (Thanassi, 1975); broader ammonium-cyanide oligomerization is supported by Lowe et al. (1963). Selective accumulation and retention of the trimer under the proposed environmental conditions are not established. Cyanide concentration is a substantive requirement rather than an assumed ocean-wide condition (Toner and Catling, 2019)."}, {"id": "rxn_009", "name": "Aminomalononitrile C-C addition to acetaldehyde", "inputs": ["mol_017", "mol_002"], "outputs": ["mol_018"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-320 K, proposed mild aqueous window", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Approximately neutral aqueous solution; preserve acetaldehyde and avoid excessive competing HCN oligomerization. No mineral catalyst is imposed."}, "mechanism": "The activated central carbon of aminomalononitrile forms a C-C bond with acetaldehyde, giving a hydroxyethyl-substituted dinitrile skeleton.", "reasoning": "Thanassi (1975) demonstrated threonine and allothreonine after reaction of aminomalononitrile with acetaldehyde and subsequent hydrolysis/decarboxylation. Kuroda et al. (2020) describe the C