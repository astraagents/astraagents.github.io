nChI=1S/H2S/h1H2", "role": "starting", "environment_formed": null}, {"id": "mol_006", "formula": "C3H5NO", "iupac_name": "2-Hydroxypropanenitrile", "common_name": "Lactonitrile", "inchi": "InChI=1S/C3H5NO/c1-3(5)2-4/h3,5H,1H3", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_007", "formula": "C3H6O2", "iupac_name": "2-Hydroxypropanal", "common_name": "Lactaldehyde", "inchi": "InChI=1S/C3H6O2/c1-3(5)2-4/h2-3,5H,1H3", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_008", "formula": "S8", "iupac_name": "Cyclooctasulfur", "common_name": "Elemental sulfur", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_009", "formula": "SO3^2-", "iupac_name": "Sulfite", "common_name": "Sulfite ion", "inchi": null, "role": "starting", "environment_formed": null}, {"id": "mol_010", "formula": "SO4^2-", "iupac_name": "Sulfate", "common_name": "Sulfate ion", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_011", "formula": "C4H7NO2", "iupac_name": "2,3-Dihydroxybutanenitrile", "common_name": "Lactaldehyde cyanohydrin", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_012", "formula": "C4H8N2O", "iupac_name": "2-Amino-3-hydroxybutanenitrile", "common_name": "Threonine/allothreonine aminonitrile", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_013", "formula": "C4H10N2O2", "iupac_name": "2-Amino-3-hydroxybutanamide", "common_name": "Threoninamide/allothreoninamide", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_014", "formula": "C4H9NO3", "iupac_name": "(2RS,3SR)-2-Amino-3-hydroxybutanoic acid", "common_name": "D,L-Threonine", "inchi": null, "role": "target", "environment_formed": "Surface"}, {"id": "mol_015", "formula": "C4H9NO3", "iupac_name": "(2RS,3RS)-2-Amino-3-hydroxybutanoic acid", "common_name": "D,L-Allothreonine", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_016", "formula": "C3H3N3", "iupac_name": "2-Aminopropanedinitrile", "common_name": "Aminomalononitrile", "inchi": "InChI=1S/C3H3N3/c4-1-3(6)2-5/h3H,6H2", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_017", "formula": "C5H7N3O", "iupac_name": "2-Amino-2-(1-hydroxyethyl)propanedinitrile", "common_name": "Aminomalononitrile-acetaldehyde addition product", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_018", "formula": "C5H9NO5", "iupac_name": "2-Amino-2-(1-hydroxyethyl)propanedioic acid", "common_name": "Hydroxyethyl-substituted aminomalonic acid", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_019", "formula": "CO2", "iupac_name": "Carbon dioxide", "common_name": "Carbon dioxide", "inchi": "InChI=1S/CO2/c2-1-3", "role": "starting", "environment_formed": null}, {"id": "mol_020", "formula": "CH2O", "iupac_name": "Methanal", "common_name": "Formaldehyde", "inchi": "InChI=1S/CH2O/c1-2/h1H2", "role": "starting", "environment_formed": null}, {"id": "mol_021", "formula": "C2H4N2", "iupac_name": "2-Aminoethanenitrile", "common_name": "Aminoacetonitrile", "inchi": "InChI=1S/C2H4N2/c3-1-2-4/h1,3H2", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_022", "formula": "C2H5NO2", "iupac_name": "2-Aminoacetic acid", "common_name": "Glycine", "inchi": "InChI=1S/C2H5NO2/c3-1-2(4)5/h1,3H2,(H,4,5)", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_023", "formula": "C3H5NO4", "iupac_name": "2-Aminopropanedioic acid", "common_name": "Aminomalonic acid", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_024", "formula": "CH4", "iupac_name": "Methane", "common_name": "Methane", "inchi": "InChI=1S/CH4/h1H4", "role": "starting", "environment_formed": null}, {"id": "mol_025", "formula": "H2", "iupac_name": "Dihydrogen", "common_name": "Hydrogen", "inchi": "InChI=1S/H2/h1H", "role": "intermediate", "environment_formed": "Surface"}], "reactions": [{"id": "rxn_001", "name": "Acetaldehyde cyanohydrin formation", "inputs": ["mol_002", "mol_001"], "outputs": ["mol_006"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-310 K proposed surface implementation", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Approximately neutral to mildly alkaline water; proposed pH 7-9 and millimolar-to-tens-of-millimolar reactants. Retain volatile HCN and acetaldehyde through gas-water equilibration. Addition is reversible; no quantitative environmental conversion is assumed."}, "mechanism": "Cyanide adds to the acetaldehyde carbonyl and proton transfer gives lactonitrile.", "reasoning": "This is the experimentally grounded entry to the lactaldehyde branch in Ritson and Sutherland (2013), incorporated into Patel et al. (2015). No mineral catalyst is required. Concentration, volatilization and competing cyanide oligomerization constrain flux; alkaline-lake cyanide storage provides a possible supply mechanism but does not establish simultaneous reagent availability (Toner and Catling, 2019)."}, {"id": "rxn_002", "name": "Copper-assisted sulfidic photoreduction of lactonitrile", "inputs": ["mol_006", "mol_005", "mol_004"], "outputs": ["mol_007", "mol_003", "mol_008"], "environment": "Surface", "agents": ["Copper(I) cyanide, CuCN, as a photoredox component"], "conditions": {"temperature": "300-310 K proposed surface implementation", "pressure": "Approximately 1 atm with a sulfide-retaining headspace", "catalyst": "CuCN, approximately 10 mol% relative to nitrile", "aqueous": true, "other": "Approximately pH 7; 254 nm irradiation; 2 h reference exposure. A starting test formulation is 10 mM lactonitrile, 30 mM total sulfide, 33 mM phosphate and 1 mM CuCN. These concentrations are transferred from the study's representative nitrile experiment, not asserted to reproduce its exact lactaldehyde experiment. Measure UV transmission and dissolved catalyst speciation."}, "mechanism": "Photogenerated reducing equivalents reduce the nitrile to an imine-level intermediate; hydrolysis releases lactaldehyde and ammonia. Sulfide supplies reducing equivalents. Elemental sulfur represents the oxidized sulfur pool, whose actual speciation may include polysulfides.", "reasoning": "Ritson and Sutherland (2013) reported lactaldehyde in 19% yield after 2 h from the acetaldehyde-cyanohydrin system. That measured yield is not assigned to the proposed formulation above. Copper accelerates the demonstrated implementation, but sulfide precipitation, catalyst speciation and UV attenuation must be resolved in a natural setting (Patel et al., 2015; Ranjan et al., 2018)."}, {"id": "rxn_003", "name": "Candidate copper-free sulfidic photoreduction", "inputs": ["mol_006", "mol_005", "mol_004"], "outputs": ["mol_007", "mol_003", "mol_008"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-310 K proposed screening conditions", "pressure": "Approximately 1 atm with a sulfide-retaining headspace", "catalyst": null, "aqueous": true, "other": "Proposed matched comparison with rxn_002: pH 7, 10 mM lactonitrile, 30 mM total sulfide, 33 mM phosphate, 254 nm irradiation and 2-24 h sampling, but no added copper. This exposure range is a test design, not a reported productive operating window."}, "mechanism": "Sulfide-derived photochemical reducing equivalents are proposed to reduce the nitrile, followed by imine hydrolysis. Elemental sulfur is a formal oxidized-sulfur endpoint rather than a measured exclusive product.", "reasoning": "Speculative for this substrate-specific implementation. Patel et al. (2015) support copper-independent reduction in parts of sulfidic photochemistry, but the supplied evidence does not establish copper-free lactonitrile-to-lactaldehyde yield or selectivity. This alternative tests a genuine catalyst-availability constraint rather than assuming copper is universally necessary. Sulfide supply and UV compatibility remain unresolved (Ranjan et al., 2018)."}, {"id": "rxn_004", "name": "Candidate ferrocyanide-sulfite photoreduction", "inputs": ["mol_006", "mol_009", "mol_004"], "outputs": ["mol_007", "mol_003", "mol_010"], "environment": "Surface", "agents": ["Ferrocyanide, [Fe(CN)6]4-, as a photoelectron donor and photoredox component"], "conditions": {"temperature": "300-310 K proposed screening conditions", "pressure": "Approximately 1 atm", "catalyst": "Ferrocyanide; proposed loading 0.1-1 mM", "aqueous": true, "other": "Proposed substrate test: 10 mM lactonitrile, 30-100 mM total sulfite/bisulfite, pH 7-8, 254 nm irradiation and 2-24 h sampling. These values are not reported lactonitrile conditions. Quantify ferrocyanide/ferricyanide turnover, cyanide loss, sulfate formation and competing sulfur products. No oxygen is required or supplied."}, "mechanism": "Photoelectron release from ferrocyanide is proposed to drive nitrile reduction; sulfite supplies net reducing equivalents while supporting photoredox turnover. Imine hydrolysis gives lactaldehyde. Sulfate is a formal fully oxidized donor endpoint.", "reasoning": "Speculative substrate extension. Xu et al. (2018) demonstrated sulfite/ferrocyanide-driven HCN reductive homologation, not this lactonitrile-to-threonine sequence. The alternative has geochemical merit because sulfite can be more accessible than sulfide, but neither catalyst turnover nor substrate selectivity follows from a balanced equation (Ranjan et al., 2018). Ferrocyanide accumulation is plausible in some alkaline lakes, not universal (Toner and Catling, 2019)."}, {"id": "rxn_005", "name": "Lactaldehyde cyanohydrin formation", "inputs": ["mol_007", "mol_001"], "outputs": ["mol_011"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-310 K proposed surface implementation", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Approximately neutral to mildly alkaline water. Proposed starting concentrations are 1-10 mM lactaldehyde with cyanide at comparable concentration or modest excess. Preserve the aldehyde against competing reduction, condensation and decomposition; treat cyanohydrin formation as an equilibrium."}, "mechanism": "Cyanide addition to lactaldehyde gives 2,3-dihydroxybutanenitrile, introducing the carbon that can become threonine's carboxyl group.", "reasoning": "Ritson and Sutherland (2013) described conversion of lactaldehyde through its cyanohydrin into the threonine/allothreonine aminonitrile. Resolving this intermediate avoids treating Strecker chemistry as instantaneous. Lactaldehyde lifetime in realistic mixed solutions is an unmeasured bottleneck."}, {"id": "rxn_006", "name": "Ammonia-dependent conversion to the threonine aminonitrile", "inputs": ["mol_011", "mol_003"], "outputs": ["mol_012", "mol_004"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-310 K proposed surface implementation", "pressure": "Approximately 1 atm with ammonia-retaining gas-water contact", "catalyst": null, "aqueous": true, "other": "Excess ammonia; proposed total ammonia approximately 0.1 M with 1-10 mM cyanohydrin and pH 8-9. Monitor for days to weeks. Ammonia addition and pH adjustment follow photoreduction rather than assuming all stages share one optimized solution."}, "mechanism": "Cyanohydrin dissociation, carbonyl-imine equilibration and cyanide trapping produce the alpha-aminonitrile. This is not modeled as direct displacement of an unactivated hydroxyl group by ammonia.", "reasoning": "The threonine/allothreonine aminonitrile endpoint is supported by Ritson and Sutherland (2013). Related conversions required days to weeks. The proposed concentration bracket is not a published optimum, and no stereochemical enrichment or quantitative conversion is assumed."}, {"id": "rxn_007", "name": "Aminonitrile hydration to a threoninamide intermediate", "inputs": ["mol_012", "mol_004"], "outputs": ["mol_013"], "environment": "Surface", "agents": ["Hydronium ions for general acid catalysis"], "conditions": {"temperature": "350-370 K proposed environmental test", "pressure": "Approximately 1 atm", "catalyst": "Acid catalysis at proposed pH 1-2", "aqueous": true, "other": "A distinct acidic, warmed stage is required after ammonia-rich Strecker chemistry. Proposed monitoring spans days to months; this is not a known conversion time. Measure aminonitrile loss, amide formation and competing decomposition separately."}, "mechanism": "Nitrile protonation and water addition produce an imidic intermediate that tautomerizes to the primary amide.", "reasoning": "This is an inferred standard nitrile-hydrolysis intermediate, not a threoninamide isolated in the supplied threonine experiment. Ritson and Sutherland (2013) establish the aminonitrile, not environmentally effective free-threonine production. The stated mild mineral-acid implementation is speculative and is retained because hydrolysis is chemically necessary, not because its environmental kinetics are known."}, {"id": "rxn_008", "name": "Threoninamide hydrolysis to free threonine-family amino acids", "inputs": ["mol_013", "mol_004"], "outputs": ["mol_014", "mol_015", "mol_003"], "environment": "Surface", "agents": ["Hydronium ions for general acid catalysis"], "conditions": {"temperature": "350-370 K proposed environmental test", "pressure": "Approximately 1 atm", "catalyst": "Acid catalysis at proposed pH 1-2", "aqueous": true, "other": "Continue the separate acidic hydrolysis stage and measure free amino-acid accumulation against degradation over days to months. Ammonia is predominantly ammonium at this pH. Neither complete hydrolysis nor a threonine:allothreonine ratio is assigned."}, "mechanism": "Acid-catalyzed amide hydrolysis forms the carboxylic acid and releases ammonia/ammonium while retaining the precursor carbon skeleton.", "reasoning": "Chemically standard completion of a Strecker route, but environmentally productive rates are speculative here. Strong analytical hydrolysis in historical cyanide studies cannot establish conversion at pH 1-2 and 350-370 K (Matthews and Moser, 1967; Dragani\u0107 et al., 1977). Ritson and Sutherland (2013) did not establish an isolated free-threonine yield for this proposed environmental completion."}, {"id": "rxn_009", "name": "HCN oligomerization to aminomalononitrile", "inputs": ["mol_001"], "outputs": ["mol_016"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-330 K proposed surface implementation", "pressure": "Approximately 1 atm with minimized HCN escape", "catalyst": null, "aqueous": true, "other": "Concentrated cyanide solution; proposed screening bracket 0.1-1 M total HCN/cyanide, pH 9-10 and aging over days to weeks. Quantify aminomalononitrile rather than equating total polymer formation with useful trimer yield. These are proposed bounds, not source-specific measured conditions."}, "mechanism": "Cyanide-initiated HCN oligomerization generates the trimer aminomalononitrile, which competes with further oligomerization and hydrolysis.", "reasoning": "Aminomalononitrile is the established HCN trimer used by Thanassi (1975); broader cyanide oligomerization is supported by Lowe et al. (1963). Selective accumulation is not demonstrated by bulk-polymer production. Cyanide concentration and retention require a localized reservoir, potentially involving the storage processes examined by Toner and Catling (2019)."}, {"id": "rxn_010", "name": "Aminomalononitrile addition to acetaldehyde", "inputs": ["mol_016", "mol_002"], "outputs": ["mol_017"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-320 K proposed mild aqueous implementation", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Approximately neutral solution. Proposed pH 6.5-7.5 and millimolar-to-tens-of-millimolar reactants, with an hours-to-days sampling series. The supplied literature summary does not provide an exact concentration, residence time or threonine yield."}, "mechanism": "The activated central carbon of aminomalononitrile forms a carbon-carbon bond with acetaldehyde, generating a hydroxyethyl-substituted dinitrile.", "reasoning": "Thanassi (1975) demonstrated threonine and allothreonine after acetaldehyde reaction followed by hydrolysis/decarboxylation; Kuroda et al. (2020) describe the addition as occurring in nearly neutral water. No mineral catalyst is justified. The adduct is a mechanistic representation of the productive connectivity, not an assertion that every intermediate was isolated."}, {"id": "rxn_011", "name": "Hydrolysis of the hydroxyethyl-substituted dinitrile", "inputs": ["mol_017", "mol_004"], "outputs": ["mol_018", "mol_003"], "environment": "Surface", "agents": ["Hydronium ions for acid-catalyzed nitrile hydrolysis"], "conditions": {"temperature": "350-370 K proposed environmental extension", "pressure": "Approximately 1 atm", "catalyst": "Acid catalysis at proposed pH 1-2", "aqueous": true, "other": "Separate hydrolysis stage after near-neutral carbon-carbon bond formation. Follow both nitriles through partially hydrolyzed products over days to months. Thanassi's acid-workup endpoint supports the chemistry, but the supplied summary does not establish rates under this milder proposed regime."}, "mechanism": "Successive hydration and hydrolysis of both nitriles gives the substituted aminomalonic acid and ammonia/ammonium. The reaction node lumps the individual amide-hydrolysis events.", "reasoning": "Hydrolysis/decarboxylation is supported at the net experimental level by Thanassi (1975), as discussed by Kuroda et al. (2020). The explicitly drawn dicarboxylic acid is mechanistically inferred. Free-threonine accumulation under realistic acidic-pool conditions remains speculative; a successful strong-acid workup does not supply those kinetics."}, {"id": "rxn_012", "name": "Decarboxylation to threonine and allothreonine", "inputs": ["mol_018"], "outputs": ["mol_014", "mol_015", "mol_019"], "environment": "Surface", "agents": null, "conditions": {"temperature": "350-370 K proposed surface implementation", "pressure": "Approximately 1 atm with carbon dioxide escape", "catalyst": null, "aqueous": true, "other": "Acidic to weakly acidic water, proposed pH 2-5. Decarboxylation may overlap the preceding hydrolysis rather than requiring isolation of the diacid. Determine its rate and stereoisomer distribution experimentally."}, "mechanism": "Loss of one carboxyl group from the substituted aminomalonic acid, followed by protonation, creates the alpha-amino-acid center and releases carbon dioxide.", "reasoning": "Thanassi (1975) directly supports D,L-threonine and allothreonine after the combined addition/hydrolysis/decarboxylation sequence. The mechanism is consistent with an aminomalonate intermediate, but the supplied evidence does not establish the isolated rate or selectivity of this individual step. No enantioselection is claimed."}, {"id": "rxn_013", "name": "Formaldehyde Strecker synthesis of aminoacetonitrile", "inputs": ["mol_020", "mol_001", "mol_003"], "outputs": ["mol_021", "mol_004"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-320 K proposed surface implementation", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Proposed pH 8-9, formaldehyde and cyanide at millimolar-to-tens-of-millimolar concentrations, and ammonia in excess. Sample over hours to days. Preserve volatile reactants and quantify competing cyanohydrin, imine and oligomer pools."}, "mechanism": "Formaldehyde-ammonia imine chemistry followed by cyanide addition produces aminoacetonitrile.", "reasoning": "This is an established Strecker reaction class used here as a glycine-supply module, not a threonine synthesis demonstrated in the supplied papers. Its integration under the stated surface conditions is speculative. The mechanistic analogy is supported by the aminonitrile chemistry of Ritson and Sutherland (2013); the downstream reason to make glycine is the experimentally observed aldehyde-amino-acid chemistry of Ivanov and Ivanov (1983)."}, {"id": "rxn_014", "name": "Aminoacetonitrile hydrolysis to glycine", "inputs": ["mol_021", "mol_004"], "outputs": ["mol_022", "mol_003"], "environment": "Surface", "agents": ["Hydronium ions for acid-catalyzed hydrolysis"], "conditions": {"temperature": "350-370 K proposed surface implementation", "pressure": "Approximately 1 atm", "catalyst": "Acid catalysis at proposed pH 1-2", "aqueous": true, "other": "A separate acidic stage follows aminoacetonitrile formation. Monitor nitrile, glycinamide and glycine over days to months; no environmental rate or completion fraction is assigned. Subsequently adjust to the weaker acidity required by rxn_015."}, "mechanism": "Nitrile hydration and amide hydrolysis convert aminoacetonitrile to glycine while releasing ammonia/ammonium.", "reasoning": "Standard Strecker completion supplies the glycine required by Ivanov and Ivanov (1983). The specific environmental operating window is speculative rather than established by that study. Cyanide-derived amino-acid recovery after hydrolysis supports chemical accessibility, not quantitative conversion under the proposed mild workup (Lowe et al., 1963; Dragani\u0107 et al., 1977)."}, {"id": "rxn_015", "name": "Glycine-acetaldehyde carbon-carbon bond formation", "inputs": ["mol_022", "mol_002"], "outputs": ["mol_014", "mol_015"], "environment": "Surface", "agents": null, "conditions": {"temperature": "333-353 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "pH 3.3-3.7; homogeneous weakly acidic water with no inorganic solids. Glycine and acetaldehyde must coexist at useful concentrations. Exact reactant concentrations and residence times are not supplied in the research summary and are not invented here. Allothreonine is a possible stereochemical coproduct; its yield was not reported."}, "mechanism": "The observed aldehyde-amino-acid reaction network forms the required bond between glycine's alpha carbon and acetaldehyde's carbonyl carbon. The net connectivity is aldol-like, but a free glycine enolate under acidic conditions is not assumed to be the established microscopic mechanism.", "reasoning": "Ivanov and Ivanov (1983) detected threonine in glycine/oligoglycine-aldehyde experiments at these temperatures and pH without inorganic solids. This edge represents the productive branch of a broad reaction network, not a selective binary synthesis with known yield. Generic aldehyde-ammonia chemistry cannot substitute for this evidence: Koga and Naraoka (2017) did not convincingly produce threonine in their different aldehyde system."}, {"id": "rxn_016", "name": "Alternative glycine supply through aminomalononitrile hydrolysis", "inputs": ["mol_016", "mol_004"], "outputs": ["mol_023", "mol_003"], "environment": "Surface", "agents": ["Hydronium ions for acid-catalyzed nitrile hydrolysis"], "conditions": {"temperature": "350-370 K proposed surface implementation", "pressure": "Approximately 1 atm", "catalyst": "Acid catalysis at proposed pH 1-2", "aqueous": true, "other": "Hydrolyze an aminomalononitrile-bearing fraction before introducing acetaldehyde. Monitor nitrile disappearance, partial hydrolysis products and decarboxylation over days to months. This branch competes with rxn_010 rather than presuming both consume the same material quantitatively."}, "mechanism": "Hydrolysis of the two nitrile groups forms aminomalonic acid and releases ammonia/ammonium.", "reasoning": "Speculative as an explicitly resolved environmental supply branch in this network. The chemistry follows ordinary dinitrile hydrolysis and the aminomalononitrile framework of Thanassi (1975), but the supplied research does not independently establish this isolated intermediate under the proposed conditions. It is chemically motivated because it supplies glycine without requiring a formaldehyde feed."}, {"id": "rxn_017", "name": "Aminomalonic acid decarboxylation to glycine", "inputs": ["mol_023"], "outputs": ["mol_022", "mol_019"], "environment": "Surface", "agents": null, "conditions": {"temperature": "330-370 K proposed surface implementation", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Acidic to weakly acidic water; carbon dioxide can escape. Decarboxylation may occur during rxn_016. Measure glycine recovery before adjusting to pH 3.3-3.7 and adding acetaldehyde."}, "mechanism": "Aminomalonic acid loses carbon dioxide; protonation gives glycine.", "reasoning": "This is chemically expected aminomalonate decarboxylation, but its environmental kinetics and coupling to rxn_015 are speculative in the supplied evidence. It is an unsubstituted counterpart of the hydrolysis/decarboxylation logic associated with Thanassi (1975). Ivanov and Ivanov (1983) support the subsequent glycine-dependent target-forming step, not this integrated upstream sequence."}, {"id": "rxn_018", "name": "Thermal HCN-ammonia reaction ensemble followed by hydrolysis", "inputs": ["mol_001", "mol_003", "mol_004"], "outputs": ["mol_014", "mol_003", "mol_019"], "environment": "Surface", "agents": ["Hydronium ions during the subsequent hydrolysis stage"], "conditions": {"temperature": "300-330 K proposed aging stage; 350-370 K candidate environmental hydrolysis", "pressure": "Approximately 1 atm with volatile-reactant retention", "catalyst": "Acid catalysis during hydrolysis only", "aqueous": true, "other": "Proposed aging bracket: 0.1-1 M total cyanide, ammoniacal pH 9-10, days to weeks. These are screening conditions, not reconstructed historical values. Historical evidence relies on strong acid hydrolysis, including approximately 6 N HCl near 373 K for many hours. Replacing that workup with pH 1-2 at 350-370 K is an unvalidated environmental extension."}, "mechanism": "Unresolved HCN oligomerization and subsequent water/ammonia chemistry generate hydrolyzable material containing threonine precursors. Later hydrolysis releases threonine. Ammonia and carbon dioxide are formal coproduct pools, not a demonstrated exclusive product distribution.", "reasoning": "Lowe et al. (1963) and Matthews and Moser (1966, 1967) support complex cyanide-derived products and threonine in hydrolysates. The immediate precursor is unidentified, so no fictitious polymer molecule is assigned. This establishes laboratory precursor accessibility, not free-threonine accumulation during aging. Cyanide concentration and environmentally adequate hydrolysis remain separate unresolved requirements."}, {"id": "rxn_019", "name": "Gamma-radiolysis of aqueous cyanide followed by hydrolysis", "inputs": ["mol_001", "mol_004"], "outputs": ["mol_014", "mol_003", "mol_019", "mol_025"], "environment": "Surface", "agents": ["Hydronium ions during the subsequent hydrolysis stage"], "conditions": {"temperature": "Approximately 300 K irradiation analogue; 350-370 K candidate environmental hydrolysis", "pressure": "Approximately 1 atm, oxygen-free and sealed against HCN loss", "catalyst": "No irradiation catalyst; acid catalysis during hydrolysis", "aqueous": true, "other": "Experimentally reported HCN concentration: 0.004-0.1 M. Laboratory activation: cobalt-60 gamma radiation at approximately 2 kGy/h. The supplied summary does not specify total dose or all hydrolysis parameters. No natural terrestrial dose rate or irradiation duration is assigned. A pH 1-2 environmental hydrolysis replacement is hypothetical."}, "mechanism": "Water- and cyanide-derived radicals form an unresolved oligomeric precursor inventory; subsequent hydrolysis releases threonine. Hydrogen represents a possible radiolytic reducing-product pool, while carbon dioxide and ammonia provide formal balance closure rather than measured threonine-specific coproduct yields.", "reasoning": "Sweeney et al. (1976) and Dragani\u0107 et al. (1977) support threonine recovery after irradiation and hydrolysis, with approximately racemic chiral products. Cobalt-60 is a laboratory proxy, not an asserted Hadean energy source. Without natural dosimetry and environmental hydrolysis kinetics, this remains a laboratory-supported ensemble with unquantified terrestrial flux."}, {"id": "rxn_020", "name": "H2S-rich gas-water electrical-discharge ensemble", "inputs": ["mol_024", "mol_003", "mol_019", "mol_005", "mol_004"], "outputs": ["mol_014", "mol_025", "mol_008"], "environment": "Surface", "agents": ["Tungsten electrode surfaces in the laboratory apparatus; any catalytic contribution is unresolved"], "conditions": {"temperature": "300-370 K bulk-fluid analogue; discharge channels are transiently much hotter", "pressure": "Initial dry-gas total approximately 695 mmHg, plus water vapor", "catalyst": null, "aqueous": true, "other": "Reference apparatus: 5 L, CH4 258 mmHg, H2S 100 mmHg, NH3 250 mmHg and CO2 87 mmHg, with electrical discharge and gas-water recirculation. The supplied summary does not specify discharge power, duration or complete sample workup. Sulfur deposition near tungsten electrodes was observed. No natural lightning exposure equivalent is assumed."}, "mechanism": "An unresolved gas-phase and aqueous network produces organic precursors and amino acids. The threonine-forming sequence is not assigned to a particular Strecker or radical mechanism. Hydrogen and sulfur are formal coproduct pools, not measured stoichiometric partners of threonine.", "reasoning": "Parker et al. (2011) detected threonine in the archived H2S-rich Miller experiment. The gas composition and possible electrode effects are specified rather than hidden under a generic surface label. This is a laboratory product-level result; an analogous natural setting would require a local or transient reducing plume, gas-water capture and sufficient discharge exposure. It does not demonstrate production in a global CO2/N2 atmosphere."}, {"id": "rxn_021", "name": "Dry methane-ammonia discharge followed by residue hydrolysis", "inputs": ["mol_024", "mol_003", "mol_004"], "outputs": ["mol_014", "mol_025"], "environment": "Surface", "agents": ["Hydronium ions during the later residue-hydrolysis stage"], "conditions": {"temperature": "Approximately 300 K bulk dry-gas analogue; 350-370 K candidate aqueous hydrolysis", "pressure": "Approximately 1 atm proposed analogue; original value not supplied", "catalyst": "No established discharge catalyst; acid catalysis during hydrolysis", "aqueous": false, "other": "The initial CH4/NH3 activation stage is dry; listed water is introduced only during subsequent residue hydrolysis. The supplied summary does not establish gas ratio, discharge energy, exposure time or residue residence time. Historical evidence uses laboratory hydrolysis; a later pH 1-2 warm-water stage is an unvalidated environmental replacement. The aqueous flag describes the initial activation stage."}, "mechanism": "Electrical discharge produces an unresolved nitrogen-rich organic residue. Subsequent hydration and hydrolysis release threonine. Hydrogen is a formal net dehydrogenation coproduct; the equation is not an identified elementary synthesis or measured product allocation.", "reasoning": "Matthews and Moser (1966, 1967) support threonine in hydrolysates of discharge-generated material. This differs experimentally from the wet H2S-rich Miller ensemble, but it does not establish a naturally maintained dry methane/ammonia reservoir. Dry-stage preservation, subsequent wetting and productive environmental hydrolysis remain unquantified; these gaps are not filled with invented operating values."}], "pathways": [{"pathway_id": "P1", "name": "Copper-assisted lactaldehyde-Strecker route", "description": "Acetaldehyde undergoes cyanohydrin formation and demonstrated copper-assisted photoreductive homologation. Lactaldehyde then reaches the experimentally supported threonine aminonitrile. The final