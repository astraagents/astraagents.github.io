"awaruite"], "conditions": {"temperature": "360-420K", "pressure": "high", "catalyst": "magnetite/awaruite", "aqueous": true, "other": "alkaline vent fluids, pH 9-10, H2-rich, anoxic"}, "mechanism": "Surface-bound CO2 is partially hydrogenated on Fe-Ni mineral surfaces to a formyl-level carbonyl; water is the coproduct of the net reduction.", "reasoning": "Serpentinization supplies H2 and Fe-Ni minerals capable of low-level CO2 reduction under anoxic hydrothermal conditions. Formaldehyde is treated here as a diffusible C1 feedstock rather than as a high-yield product."}, {"id": "rxn_002", "name": "Surface formose dimerization of formaldehyde to glycolaldehyde", "inputs": ["mol_003"], "outputs": ["mol_004"], "environment": "Surface", "agents": ["brucite", "borate minerals"], "conditions": {"temperature": "320-350K", "pressure": "1 atm", "catalyst": "brucite/borate", "aqueous": true, "other": "wet-dry cycles in mildly basic evaporitic pools"}, "mechanism": "Base-assisted formaldehyde self-condensation gives the first stable C2 sugar, glycolaldehyde.", "reasoning": "Glycolaldehyde is the earliest persistent formose product, and borate-bearing wet-dry settings help enrich it relative to uncontrolled polymerization."}, {"id": "rxn_003", "name": "Hydrothermal hydrogenation of glyoxal to glycolaldehyde", "inputs": ["mol_005", "mol_002"], "outputs": ["mol_004"], "environment": "Hydrothermal", "agents": ["awaruite", "mackinawite"], "conditions": {"temperature": "360-420K", "pressure": "high", "catalyst": "awaruite/mackinawite", "aqueous": true, "other": "subseafloor flow paths with dissolved glyoxal and H2"}, "mechanism": "One aldehyde group of glyoxal is selectively hydrogenated on reduced mineral surfaces to the alpha-hydroxy aldehyde glycolaldehyde.", "reasoning": "Selective partial reduction of a dicarbonyl to an alpha-hydroxy aldehyde is chemically simpler than hydrothermal C1-C1 coupling and provides an alternative C2 entry without invoking unstable tetrose chemistry."}, {"id": "rxn_004", "name": "Hydrogenative deoxygenation of glycolaldehyde to acetaldehyde", "inputs": ["mol_004", "mol_002"], "outputs": ["mol_007", "mol_011"], "environment": "Hydrothermal", "agents": ["awaruite", "mackinawite"], "conditions": {"temperature": "370-430K", "pressure": "high", "catalyst": "awaruite/mackinawite", "aqueous": true, "other": "H2-rich subseafloor circulation"}, "mechanism": "Metal-surface hydrogenolysis/deoxygenation converts the alpha-hydroxy aldehyde into the less oxidized aldehyde.", "reasoning": "This explicitly H2-driven deoxygenation is simpler and better balanced than unsupported sugar redox cascades, but it remains moderately speculative; the independent acetylene branch is therefore retained as a bypass."}, {"id": "rxn_005", "name": "Mineral-assisted hydration of acetylene to acetaldehyde", "inputs": ["mol_006", "mol_011"], "outputs": ["mol_007"], "environment": "Surface", "agents": ["Cu(I) sulfide"], "conditions": {"temperature": "330-390K", "pressure": "1 atm", "catalyst": "Cu(I) sulfide", "aqueous": true, "other": "acidic volcanic hot-spring films carrying dissolved acetylene"}, "mechanism": "Metal activation of the alkyne enables water addition to an enol that tautomerizes to acetaldehyde.", "reasoning": "Acetylene is a plausible volcanic or impact-derived feedstock. Metal-sulfide-assisted hydration gives a direct non-sugar route to acetaldehyde, although support is weaker than for classical Hg-catalyzed hydration."}, {"id": "rxn_006", "name": "Surface cross-aldol of glyoxal and acetaldehyde", "inputs": ["mol_005", "mol_007"], "outputs": ["mol_008"], "environment": "Surface", "agents": ["montmorillonite", "calcite"], "conditions": {"temperature": "300-330K", "pressure": "1 atm", "catalyst": "montmorillonite", "aqueous": true, "other": "evaporative concentration at mildly basic pool margins"}, "mechanism": "Acetaldehyde enolization followed by attack on one carbonyl of glyoxal gives the beta-hydroxydialdehyde 2-hydroxybutane-1,4-dial.", "reasoning": "This C2+C2 union installs the entire future histidine side chain before ring closure. Cross-aldol selectivity is a bottleneck, but clay/mineral adsorption and evaporation can favor the desired mixed product."}, {"id": "rxn_007", "name": "Hydrothermal cross-aldol of glyoxal and acetaldehyde", "inputs": ["mol_005", "mol_007"], "outputs": ["mol_008"], "environment": "Hydrothermal", "agents": ["green rust", "FeS"], "conditions": {"temperature": "350-390K", "pressure": "high", "catalyst": "green rust/FeS", "aqueous": true, "other": "alkaline vent pores with steep thermal gradients"}, "mechanism": "Mineral-assisted acetaldehyde enolization and addition to glyoxal generates 2-hydroxybutane-1,4-dial in situ.", "reasoning": "A hydrothermal aldol branch avoids moving the fragile beta-hydroxydialdehyde between environments; mineral confinement can favor rapid formation and immediate consumption."}, {"id": "rxn_008", "name": "Dehydrogenation of 2-hydroxybutane-1,4-dial to 2-oxobutane-1,4-dial", "inputs": ["mol_008"], "outputs": ["mol_009", "mol_002"], "environment": "Hydrothermal", "agents": ["greigite", "awaruite"], "conditions": {"temperature": "370-420K", "pressure": "high", "catalyst": "greigite/awaruite", "aqueous": true, "other": "rapid in situ turnover favored because the keto-dialdehyde product is short-lived"}, "mechanism": "Mineral-catalyzed alcohol dehydrogenation converts the secondary alcohol into the alpha-keto group, releasing H2.", "reasoning": "The keto-dialdehyde is the exact oxidation-state match needed for Debus closure, and explicit H2 evolution keeps redox bookkeeping closed. The step is demanding but more defensible than leaving the oxidation implicit."}, {"id": "rxn_009", "name": "Surface Debus-Radziszewski cyclization to imidazole-4-acetaldehyde", "inputs": ["mol_009", "mol_003", "mol_010"], "outputs": ["mol_013", "mol_011"], "environment": "Surface", "agents": ["silica", "phosphate minerals"], "conditions": {"temperature": "320-350K", "pressure": "1 atm", "catalyst": null, "aqueous": true, "other": "ammonium-rich evaporitic films with partial drying"}, "mechanism": "Sequential imine formation with ammonia, cyclization, dehydration, and aromatization yield the imidazole while retaining the CH2CHO side chain.", "reasoning": "This is the key strategic step: the imidazole is built from an aldehyde-bearing alpha-keto dialdehyde so imidazole-4-acetaldehyde forms directly, avoiding weak post-ring homologation of simpler imidazoles. Competing oligomerization of the dialdehydic substrate remains the main uncertainty."}, {"id": "rxn_010", "name": "Hydrothermal Debus-Radziszewski cyclization to imidazole-4-acetaldehyde", "inputs": ["mol_009", "mol_003", "mol_010"], "outputs": ["mol_013", "mol_011"], "environment": "Hydrothermal", "agents": ["greigite", "silica"], "conditions": {"temperature": "350-390K", "pressure": "high", "catalyst": "greigite", "aqueous": true, "other": "ammonium-bearing vent microcompartments with rapid quench into cooler zones"}, "mechanism": "Ammonia-driven imine formation and ring closure occur on mineral interfaces, followed by dehydration to the imidazole aldehyde.", "reasoning": "A hydrothermal Debus variant is less selective but physically coherent because the short-lived keto-dialdehyde can be generated and trapped in the same setting instead of being transported to the surface."}, {"id": "rxn_011", "name": "Strecker conversion of imidazole-4-acetaldehyde to histidine nitrile", "inputs": ["mol_013", "mol_010", "mol_012"], "outputs": ["mol_014", "mol_011"], "environment": "Surface", "agents": ["phosphate minerals"], "conditions": {"temperature": "300-320K", "pressure": "1 atm", "catalyst": null, "aqueous": true, "other": "cyanide-bearing pool, near-neutral to mildly acidic pH, reduced UV exposure by shallow burial or night-side accumulation"}, "mechanism": "Imine/iminium formation from the aldehyde and ammonia is followed by cyanide addition to give the alpha-aminonitrile.", "reasoning": "Strecker chemistry is among the most robust prebiotic entries to alpha-amino acid precursors. Imidazole-4-acetaldehyde is substantially more transportable than the upstream keto-dialdehyde, so quenching into cooler cyanide-bearing pools is plausible."}, {"id": "rxn_012", "name": "Hydrolysis of histidine nitrile to histidine", "inputs": ["mol_014", "mol_011"], "outputs": ["mol_015", "mol_010"], "environment": "Biochemical", "agents": ["Fe2+", "montmorillonite"], "conditions": {"temperature": "320-360K", "pressure": "1 atm", "catalyst": "Fe2+/montmorillonite", "aqueous": true, "other": "geothermal heating-cooling cycles in concentrated pools or mineral-lined compartments"}, "mechanism": "Sequential hydration of the nitrile through amide-like intermediates yields the carboxylic acid and releases ammonia.", "reasoning": "Histidine nitrile can act as a kinetically persistent reservoir that hydrolyzes during prolonged wet heating. Mineral and Fe2+-assisted hydrolysis in concentrated pools converts it to the amino acid under milder conditions than the upstream carbonyl chemistry."}], "pathways": [{"pathway_id": "P1", "name": "Formose entry with surface aldol and vent Debus", "description": "CO2-derived formaldehyde enters surface formose chemistry to give glycolaldehyde; after hydrothermal deoxygenation, the C4 aldol product is carried into hydrothermal pores for oxidation and Debus closure before Strecker conversion and hydrolysis.", "reaction_sequence": ["rxn_001", "rxn_002", "rxn_004", "rxn_006", "rxn_008", "rxn_010", "rxn_011", "rxn_012"], "key_intermediates": ["mol_003", "mol_004", "mol_007", "mol_008", "mol_009", "mol_013", "mol_014"]}, {"pathway_id": "P2", "name": "Formose entry with vent aldol and surface Debus", "description": "Formose-derived glycolaldehyde is deoxygenated hydrothermally, then the side-chain-bearing keto-dialdehyde is assembled in vents and transferred only after oxidation for cooler surface Debus and Strecker chemistry.", "rea