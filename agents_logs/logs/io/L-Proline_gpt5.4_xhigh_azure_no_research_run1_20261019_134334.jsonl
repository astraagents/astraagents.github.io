leted by either CO2 carboxylation to \u03941-pyrroline-2-carboxylate or Strecker-type HCN capture followed by hydrolysis. Because these routes are not intrinsically enantioselective on achiral mineral surfaces, the network explicitly produces racemic proline first and then isolates an L-enriched fraction by a separate mineral-assisted resolution step, rather than incorrectly treating L-proline as if it were formed directly in bulk.", "molecules": [{"id": "mol_001", "formula": "HCN", "iupac_name": "hydrogen cyanide", "common_name": "hydrogen cyanide", "inchi": "InChI=1S/CHN/c1-2/h1H", "role": "starting", "environment_formed": null}, {"id": "mol_002", "formula": "NH3", "iupac_name": "azane", "common_name": "ammonia", "inchi": "InChI=1S/H3N/h1H3", "role": "starting", "environment_formed": null}, {"id": "mol_003", "formula": "H2O", "iupac_name": "oxidane", "common_name": "water", "inchi": "InChI=1S/H2O/h1H2", "role": "starting", "environment_formed": null}, {"id": "mol_004", "formula": "H2", "iupac_name": "molecular hydrogen", "common_name": "hydrogen", "inchi": "InChI=1S/H2/h1H", "role": "starting", "environment_formed": null}, {"id": "mol_005", "formula": "CO2", "iupac_name": "carbon dioxide", "common_name": "carbon dioxide", "inchi": "InChI=1S/CO2/c2-1-3", "role": "starting", "environment_formed": null}, {"id": "mol_006", "formula": "C3H4O", "iupac_name": "prop-2-enal", "common_name": "acrolein", "inchi": "InChI=1S/C3H4O/c1-2-3-4/h2-3H,1H2", "role": "starting", "environment_formed": null}, {"id": "mol_007", "formula": "C4H5NO", "iupac_name": "4-oxobutanenitrile", "common_name": null, "inchi": "InChI=1S/C4H5NO/c5-3-1-2-4-6/h4H,1-2H2", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_008", "formula": "C4H9NO", "iupac_name": "4-aminobutanal", "common_name": "gamma-aminobutyraldehyde", "inchi": "InChI=1S/C4H9NO/c5-3-1-2-4-6/h4H,1-3,5H2", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_009", "formula": "C4H6O2", "iupac_name": "butane-1,4-dial", "common_name": "succinaldehyde", "inchi": "InChI=1S/C4H6O2/c5-3-1-2-4-6/h3-4H,1-2H2", "role": "starting", "environment_formed": null}, {"id": "mol_010", "formula": "C4H7N", "iupac_name": "2,3,4,5-tetrahydro-1H-pyrrole", "common_name": "1-pyrroline", "inchi": null, "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_011", "formula": "C5H7NO2", "iupac_name": "3,4-dihydro-2H-pyrrole-2-carboxylic acid", "common_name": "\u03941-pyrroline-2-carboxylic acid", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_012", "formula": "C5H8N2", "iupac_name": "pyrrolidine-2-carbonitrile", "common_name": "proline nitrile", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_013", "formula": "C5H9NO2", "iupac_name": "pyrrolidine-2-carboxylic acid", "common_name": "DL-proline", "inchi": "InChI=1S/C5H9NO2/c7-5(8)4-2-1-3-6-4/h4,6H,1-3H2,(H,7,8)", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_014", "formula": "C5H9NO2", "iupac_name": "(2S)-pyrrolidine-2-carboxylic acid", "common_name": "L-proline", "inchi": "InChI=1S/C5H9NO2/c7-5(8)4-2-1-3-6-4/h4,6H,1-3H2,(H,7,8)/t4-/m0/s1", "role": "target", "environment_formed": "Surface"}], "reactions": [{"id": "rxn_001", "name": "Hydrocyanation of acrolein to 4-oxobutanenitrile", "inputs": ["mol_006", "mol_001"], "outputs": ["mol_007"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-330K", "pressure": "1 atm", "catalyst": null, "aqueous": true, "other": "Mildly basic cyanide-bearing pool; conjugate addition favored over prolonged UV exposure."}, "mechanism": "Cyanide adds to the \u03b2-carbon of the enal, followed by proton transfer to give the Michael-type adduct 4-oxobutanenitrile.", "reasoning": "Acrolein is an activated \u03b1,\u03b2-unsaturated aldehyde and is a reasonable cyanide acceptor in surface brines. Writing the step as simple hydrocyanation avoids the earlier under-specifie