n to the cyclic aminonitrile, which is hydrolyzed directly to rac-proline before L-enrichment.\",\n      \"reaction_sequence\": [\"rxn_003\", \"rxn_004\", \"rxn_006\", \"rxn_009\", \"rxn_012\"],\n      \"key_intermediates\": [\"mol_008\", \"mol_009\", \"mol_010\"]\n    },\n    {\n      \"pathway_id\": \"P9\",\n      \"name\": \"Acrolein-fed route via pyrroline cyanation and amide relay\",\n      \"description\": \"The same acrolein-fed branch proceeds through 1-pyrroline and 2-cyanopyrrolidine, but hydrolysis is resolved into amide then acid before the final chiral selection step.\",\n      \"reaction_sequence\": [\"rxn_003\", \"rxn_004\", \"rxn_006\", \"rxn_007\", \"rxn_008\", \"rxn_012\"],\n      \"key_intermediates\": [\"mol_008\", \"mol_009\", \"mol_011\"]\n    },\n    {\n      \"pathway_id\": \"P10\",\n      \"name\": \"Acrolein-fed route via pyrroline carboxylation\",\n      \"description\": \"A shorter noncyanide branch starts from environmental acrolein, passes through succinaldehyde and 1-pyrroline, then uses hydrothermal carboxylation to P5C and hydrogenation to proline before L-resolution.\",\n      \"reaction_sequence\": [\"rxn_003\", \"rxn_004\", \"rxn_010\", \"rxn_011\", \"rxn_012\"],\n      \"key_intermediates\": [\"mol_008\", \"mol_009\", \"mol_012\"]\n    }\n  ],\n  \"hub_molecules\": [\"mol_008\", \"mol_009\", \"mol_010\", \"mol_013\"],\n  \"convergence_points\": [\n    {\n      \"molecule_id\": \"mol_008\",\n      \"incoming_reactions\": [\"rxn_003\"],\n      \"outgoing_reactions\": [\"rxn_004\", \"rxn_005\"]\n    },\n    {\n      \"molecule_id\": \"mol_009\",\n      \"incoming_reactions\": [\"rxn_004\"],\n      \"outgoing_reactions\": [\"rxn_006\", \"rxn_010\"]\n    },\n    {\n      \"molecule_id\": \"mol_010\",\n      \"incoming_reactions\": [\"rxn_005\", \"rxn_006\"],\n      \"outgoing_reactions\": [\"rxn_007\", \"rxn_009\"]\n    },\n    {\n      \"molecule_id\": \"mol_013\",\n      \"incoming_reactions\": [\"rxn_008\", \"rxn_009\", \"rxn_011\"