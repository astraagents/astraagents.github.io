  {\n      \"id\": \"mol_016\",\n      \"formula\": \"NH2CH2COONH4\",\n      \"iupac_name\": \"Ammonium glycinate\",\n      \"common_name\": \"Ammonium glycinate\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Biochemical\"\n    }\n  ],\n  \"reactions\": [\n    {\n      \"id\": \"rxn_001\",\n      \"name\": \"Photoreduction of CO2 to formaldehyde\",\n      \"inputs\": [\"mol_001\", \"mol_005\"],\n      \"outputs\": [\"mol_007\", \"mol_004\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"UV light\", \"titanium dioxide (TiO2)\"],\n      \"conditions\": {\n        \"temperature\": \"280-320K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"TiO2\",\n        \"aqueous\": true,\n        \"other\": \"Strong UV irradiation\"\n      },\n      \"mechanism\": \"Photoinduced reduction of CO2 with H2 over semiconductor mineral surfaces, yielding formaldehyde and water.\",\n      \"reasoning\": \"Supported by Fresco & Blank (1964); Mita et al. (2011). Formose-relevant photoreduction present in evaporitic and shallow pools.\"\n    },\n    {\n      \"id\": \"rxn_002\",\n      \"name\": \"Methane ammonolysis to methylamine\",\n      \"inputs\": [\"mol_003\", \"mol_002\"],\n      \"outputs\": [\"mol_008\", \"mol_005\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"nickel-iron alloy\"],\n      \"conditions\": {\n        \"temperature\": \"550-600K\",\n        \"pressure\": \"high\",\n        \"catalyst\": \"nickel-iron alloy (kamacite)\",\n        \"aqueous\": true,\n        \"other\": \"Mineral catalyzed under reducing, high T\"\n      },\n      \"mechanism\": \"Ammonolysis of CH4 to methylamine and H2 over Fe-Ni alloy surfaces.\",\n      \"reasoning\": \"Feasible at hydrothermal vents; see Preiner et al. (2020); mass is balanced: CH4 + NH3 \u2192 CH3NH2 + H2.\"\n    },\n    {\n      \"id\": \"rxn_003\",\n      \"name\": \"Hydrogen cyanide formation from methane and ammonia\",\n      \"inputs