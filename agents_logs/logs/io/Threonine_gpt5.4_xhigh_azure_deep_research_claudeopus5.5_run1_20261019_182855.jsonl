 \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_007\",\n      \"formula\": \"C2H4O2\",\n      \"iupac_name\": \"2-hydroxyethanal\",\n      \"common_name\": \"glycolaldehyde\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_008\",\n      \"formula\": \"C2H4O\",\n      \"iupac_name\": \"ethanal\",\n      \"common_name\": \"acetaldehyde\",\n      \"inchi\": null,\n      \"role\": \"hub_intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_009\",\n      \"formula\": \"S\",\n      \"iupac_name\": \"sulfur\",\n      \"common_name\": \"elemental sulfur\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_010\",\n      \"formula\": \"C3H5NO\",\n      \"iupac_name\": \"2-hydroxypropanenitrile\",\n      \"common_name\": \"lactonitrile\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_011\",\n      \"formula\": \"C3H6O2\",\n      \"iupac_name\": \"2-hydroxypropanal\",\n      \"common_name\": \"lactaldehyde\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_012\",\n      \"formula\": \"C4H8N2O\",\n      \"iupac_name\": \"2-amino-3-hydroxybutanenitrile\",\n      \"common_name\": \"threonine aminonitrile\",\n      \"inchi\": null,\n      \"role\": \"hub_intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_013\",\n      \"formula\": \"C2H5NO2\",\n      \"iupac_name\": \"2-aminoethanoic acid\",\n      \"common_name\": \"glycine\",\n      \"inchi\": null,\n      \"role\": \"hub_intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_014\",\n      \"formula\": \"C4H9NO3\",\n      \"iupac_name\": \"2-amino-3-hydroxybutanoic acid\",\n      \"common_name\": \"threonine\",\n      \"inchi\": null,\n      \"role\": \"target\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_015\",\n      \"formula\": \"C4H9NO3\",\n      \"iupac_name\": \"2-amino-3-hydroxybutanoic acid\",\n      \"common_name\": \"allothreonine\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    }\n  ],\n  \"reactions\": [\n    {\n      \"id\": \"rxn_001\",\n      \"name\": \"Cyanohydrin capture of formaldehyde to glycolonitrile\",\n      \"inputs\": [\"mol_005\", \"mol_001\"],\n      \"outputs\": [\"mol_006\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-320K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"cyanide-bearing evaporitic or tidal-flat pool; wet-dry concentration; anoxic\"\n      },\n      \"mechanism\": \"Cyanide adds to formaldehyde to give the cyanohydrin glycolonitrile.\",\n      \"reasoning\": \"This entry step is a simplifying but chemically standard abstraction. The cited cyanosulfidic literature reaches the same glycolonitrile node by longer HCN homologation chemistry, whereas direct formaldehyde cyanohydrin capture is used here to expose the threonine-relevant network without adding unrelated upstream steps (Ritson & Sutherland, 2013; Patel et al., 2015).\"\n    },\n    {\n      \"id\": \"rxn_002\",\n      \"name\": \"Cu-sulfide photoreduction of glycolonitrile to glycolaldehyde\",\n      \"inputs\": [\"mol_006\", \"mol_003\", \"mol_004\"],\n      \"outputs\": [\"mol_007\", \"mol_002\", \"mol_009\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"CuCN\"],\n      \"conditions\": {\n        \"temperature\": \"300-320K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"CuCN\",\n        \"aqueous\": true,\n        \"other\": \"UV-irradiated sulfidic pool, phosphate-buffered near pH 7; elemental sulfur is a bookkeeping sink for oxidized sulfur\"\n      },\n      \"mechanism\": \"UV-driven Cu-mediated sulfide photoredox reduces the nitrile carbon to an aldehyde equivalent and hydrolyzes the reduced intermediate, releasing ammonia.\",\n      \"reasoning\": \"Ritson and Sutherland showed CuCN/phosphate/HS- plus UV can reduce nitrile-derived intermediates toward aldehydes. This net step captures glycolonitrile-to-glycolaldehyde conversion; sulfur is shown as elemental S only as a bookkeeping sink because the true oxidized sulfur pool is more complex. Sulfide supply and UV attenuation remain important geochemical constraints (Ritson & Sutherland, 2013; Patel et al., 2015; Ranjan et al., 2018).\"\n    },\n    {\n      \"id\": \"rxn_003\",\n      \"name\": \"Cu-sulfide photoreduction of glycolaldehyde to acetaldehyde\",\n      \"inputs\": [\"mol_007\", \"mol_004\"],\n      \"outputs\": [\"mol_008\", \"mol_003\", \"mol_009\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"CuCN\"],\n      \"conditions\": {\n        \"temperature\": \"300-320K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"CuCN\",\n        \"aqueous\": true,\n        \"other\": \"same UV/sulfidic surface setting as rxn_002; phosphate-buffered; anoxic\"\n      },\n      \"mechanism\": \"Related Cu-sulfide photoredox reduces and deoxygenates glycolaldehyde to acetaldehyde, with sulfide serving as reductant and sulfur as the bookkeeping oxidation sink.\",\n      \"reasoning\": \"Patel et al. place acetaldehyde downstream of glycolaldehyde reduction in the same cyanosulfidic framework. This is a decisive hub-forming step because acetaldehyde feeds both the Strecker and Akabori branches; sulfur speciation is again simplified to S for a balanceable net reaction (Patel et al., 2015).\"\n    },\n    {\n      \"id\": \"rxn_004\",\n      \"name\": \"Cyanohydrin formation from acetaldehyde to lactonitrile\",\n      \"inputs\": [\"mol_008\", \"mol_001\"],\n      \"outputs\": [\"mol_010\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-320K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"HCN-rich, mildly alkaline to neutral surface pool\"\n      },\n      \"mechanism\": \"Cyanide adds to acetaldehyde to form the cyanohydrin lactonitrile.\",\n      \"reasoning\": \"Acetaldehyde cyanohydrin formation is straightforward aqueous cyanide chemistry and gives lactonitrile, the immediate photoredox precursor to lactaldehyde. Cobb and Pudritz identify lactaldehyde as threonine's Strecker aldehyde, so this step is central rather than optional (Ritson & Sutherland, 2013; Cobb & Pudritz, 2015).\"\n    },\n    {\n      \"id\": \"rxn_005\",\n      \"name\": \"Cu-sulfide photoreduction of lactonitrile to lactaldehyde\",\n      \"inputs\": [\"mol_010\", \"mol_004\", \"mol_003\"],\n      \"outputs\": [\"mol_011\", \"mol_002\", \"mol_009\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"CuCN\"],\n      \"conditions\": {\n        \"temperature\": \"300-320K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"CuCN\",\n        \"aqueous\": true,\n        \"other\": \"UV-irradiated sulfidic pool, phosphate-buffered near pH 7; reported lactaldehyde yield about 19 percent\"\n      },\n      \"mechanism\": \"Photoredox reduction converts the nitrile carbon of lactonitrile to the aldehyde level with hydrolytic ammonia release; sulfide is oxidized to a sulfur pool represented here as elemental sulfur.\",\n      \"reasoning\": \"This is the best documented threonine-specific bottleneck. Ritson and Sutherland reported lactonitrile photoreduction to lactaldehyde in about 19 percent yield under CuCN/HS-/UV conditions, making it the strongest experimental entry to threonine's required C3 hydroxyaldehyde precursor. The narrow geochemical window for sulfide and copper remains a real limitation (Ritson & Sutherland, 2013; Patel et al., 2015; Ranjan et al., 2018).\"\n    },\n    {\n      \"id\": \"rxn_006\",\n      \"name\": \"Strecker capture of lactaldehyde to threonine aminonitrile\",\n      \"inputs\": [\"mol_011\", \"mol_001\", \"mol_002\"],\n      \"outputs\": [\"mol_012\", \"mol_003\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-320K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"cool cyanide-ammonia-rich surface pool; imine formation followed by cyanide addition; mixed stereochemistry expected\"\n      },\n      \"mechanism\": \"Ammonia condenses with lactaldehyde to an imine, then cyanide adds to give a stereochemically mixed threonine aminonitrile pool with water loss.\",\n      \"reasoning\": \"Lactaldehyde plus HCN and NH3 is the canonical Strecker capture for threonine. The cited work reports smooth formation of the threonine aminonitrile pool from this aldehyde, but not a free-amino-acid yield or a resolved threo:allo aminonitrile ratio, so the product is modeled as a mixed aminonitrile node (Ritson & Sutherland, 2013; Patel et al., 2015).\"\n    },\n    {\n      \"id\": \"rxn_007\",\n      \"name\": \"Hydrolysis of threonine aminonitrile to threonine\",\n      \"inputs\": [\"mol_012\", \"mol_003\"],\n      \"outputs\": [\"mol_014\", \"mol_002\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-340K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"dark rehydrating surface pool or evaporite film; implied stoichiometry is one aminonitrile plus two waters to one amino acid plus ammonia; low flux\"\n      },\n      \"mechanism\": \"Stepwise nitrile hydration and hydrolysis converts the threonine aminonitrile branch to free threonine with ammonia release.\",\n      \"reasoning\": \"Hydrolysis to free threonine is chemically reasonable but experimentally the weakest part of the dedicated cyanosulfidic route: the provided literature stops at the aminonitrile stage and does not report a prebiotic free-threonine yield. This branch is therefore low-confidence and low-flux. It is kept because threonine is the target and because nonenzymatic threo:allo outcomes are unresolved rather than selectively threo (Ritson & Sutherland, 2013; Patel et al., 2015; Ring et al., 1972; Weber & Miller, 1981).\"\n    },\n    {\n      \"id\": \"rxn_008\",\n      \"name\": \"Hydrolysis of threonine aminonitrile to allothreonine\",\n      \"inputs\": [\"mol_012\", \"mol_003\"],\n      \"outputs\": [\"mol_015\", \"mol_002\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-340K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"dark rehydrating surface pool or evaporite film; implied stoichiometry is one aminonitrile plus two waters to one amino acid plus ammonia; low flux\"\n      },\n      \"mechanism\": \"The parallel hydrolysis branch converts the aminonitrile pool to allothreonine with ammonia release.\",\n      \"reasoning\": \"A separate allothreonine hydrolysis branch is required because nonenzymatic Strecker chemistry lacks useful diastereocontrol and abiotic threo:allo outcomes are often close to nonselective. As with rxn_007, the hydrolysis itself is chemically plausible but not experimentally secured for this specific aminonitrile under clearly prebiotic conditions (Ritson & Sutherland, 2013; Patel et al., 2015; Ring et al., 1972; Weber & Miller, 1981).\"\n    },\n    {\n      \"id\": \"rxn_009\",\n      \"name\": \"Cu-assisted glycine-acetaldehyde aldol to threonine\",\n      \"inputs\": [\"mol_013\", \"mol_008\"],\n      \"outputs\": [\"mol_014\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Cu2+\"],\n      \"conditions\": {\n        \"temperature\": \"305-320K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"Cu2+\",\n        \"aqueous\": true,\n        \"other\": \"concentrated evaporitic pool or mineral interface; mildly basic carbonate or phosphate; low free sulfide so copper remains available; reversible Akabori-type chemistry\"\n      },\n      \"mechanism\": \"Cu-chelated glycine undergoes C-alpha deprotonation and aldol addition to acetaldehyde to give threonine; the reaction is reversible.\",\n      \"reasoning\": \"This Akabori-type aldol route is the only literature chemistry that intentionally reaches free threonine. Copper glycinate and related metal-chelate systems give threonine together with allothreonine, showing that the reaction is real even if the required Cu-rich, mildly basic, relatively low-sulfide pools may have been spatially restricted. It is included as a plausible low-water-activity surface route, but with lower prebiotic confidence than the precursor-supply photoredox chemistry (Sato et al., 1957; Ikutani et al., 1959).\"\n    },\n    {\n      \"id\": \"rxn_010\",\n      \"name\": \"Cu-assisted glycine-acetaldehyde aldol to allothreonine\",\n      \"inputs\": [\"mol_013\", \"mol_008\"],\n      \"outputs\": [\"mol_015\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Cu2+\"],\n      \"conditions\": {\n        \"temperature\": \"305-320K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"Cu2+\",\n        \"aqueous\": true,\n        \"other\": \"concentrated evaporitic pool or mineral interface; mildly basic carbonate or phosphate; low free sulfide so copper remains available; reversible Akabori-type chemistry\"\n      },\n      \"mechanism\": \"The same Cu-assisted glycine-acetaldehyde aldol chemistry can terminate in the allothreonine diastereomer.\",\n      \"reasoning\": \"Allothreonine is an unavoidable parallel outcome in the same Cu-assisted glycine-acetaldehyde chemistry. Separate threo and allo branches are necessary because reported diastereomer ratios vary with catalyst and conditions rather than approaching exclusive threonine formation (Sato et al., 1957; Ikutani et al., 1959).\"\n    },\n    {\n      \"id\": \"rxn_011\",\n      \"name\": \"Retro-aldol cleavage of threonine to glycine and acetaldehyde\",\n      \"inputs\": [\"mol_014\"],\n      \"outputs\": [\"mol_013\", \"mol_008\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"320-370K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"warm surface pool or geothermal cycling; decomposition sink accelerates with heating and long residence times\"\n      },\n      \"mechanism\": \"Retro-aldol cleavage of the beta-hydroxy amino acid regenerates glycine and acetaldehyde.\",\n      \"reasoning\": \"Retro-aldol cleavage of threonine back to glycine plus acetaldehyde is a major abiotic sink and explains why threonine should be treated as a late, low-accumulation product. Thermal studies and decomposition work show strong fragility with increasing temperature, arguing against prolonged hot residence (Schroeder & Bada, 1977; Aubrey et al., 2009).\"\n    },\n    {\n      \"id\": \"rxn_012\",\n      \"name\": \"Retro-aldol cleavage of allothreonine to glycine and acetaldehyde\",\n      \"inputs\": [\"mol_015\"],\n      \"outputs\": [\"mol_013\", \"mol_008\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"320-370K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"warm surface pool or geothermal cycling; decomposition sink accelerates with heating and long residence times\"\n      },\n      \"mechanism\": \"Allothreonine undergoes the same retro-aldol cleavage framework to regenerate glycine and acetaldehyde.\",\n      \"reasoning\": \"Allothreonine should feed the same retro-aldol sink network as threonine, with additional blurring from epimerization. This branch is somewhat more inferential than rxn_011 but follows the documented threo-allo decomposition and epimerization behavior and is needed to keep the stereochemical pool chemically closed (Schroeder & Bada, 1977; Aubrey et al., 2009).\"\n    }\n  ],\n  \"pathways\": [\n    {\n      \"pathway_id\": \"P1\",\n      \"name\": \"Full formaldehyde-to-threonine cyanosulfidic Strecker route\",\n      \"description\": \"Formaldehyde is trapped as glycolonitrile, reduced through glycolaldehyde and acetaldehyde to lactonitrile and lactaldehyde, then captured as threonine aminonitrile and hydrolyzed in a cool dark surface pool.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_002\", \"rxn_003\", \"rxn_004\", \"rxn_005\", \"rxn_006\", \"rxn_007\"],\n      \"key_intermediates\": [\"mol_006\", \"mol_008\", \"mol_011\", \"mol_012\"]\n    },\n    {\n      \"pathway_id\": \"P2\",\n      \"name\": \"Glycolonitrile-entry Strecker route\",\n      \"description\": \"Begins at the experimentally central glycolonitrile node and follows the same acetaldehyde-lactaldehyde bottleneck to threonine aminonitrile and then threonine.\",\n      \"reaction_sequence\": [\"rxn_002\", \"rxn_003\", \"rxn_004\", \"rxn_005\", \"rxn_006\", \"rxn_007\"],\n      \"key_intermediates\": [\"mol_007\", \"mol_008\", \"mol_011\", \"mol_012\"]\n    },\n    {\n      \"pathway_id\": \"P3\",\n      \"name\": \"Glycolaldehyde-entry Strecker route\",\n      \"description\": \"Starts from glycolaldehyde, bypasses the first cyanohydrin-capture step, and proceeds through acetaldehyde, lactonitrile, lactaldehyde, and the aminonitrile pool.\",\n      \"reaction_sequence\": [\"rxn_003\", \"rxn_004\", \"rxn_005\", \"rxn_006\", \"rxn_007\"],\n      \"key_intermediates\": [\"mol_008\", \"mol_010\