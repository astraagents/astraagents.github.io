   \"role\": \"intermediate\",\n      \"environment_formed\": \"Biochemical\"\n    }\n  ],\n  \"reactions\": [\n    {\n      \"id\": \"rxn_001\",\n      \"name\": \"Cu(I)-catalyzed HCN-acetylene coupling\",\n      \"inputs\": [\"mol_001\", \"mol_002\"],\n      \"outputs\": [\"mol_005\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Cu(I) ions\"],\n      \"conditions\": {\n        \"temperature\": \"300-350K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"Cu(I)\",\n        \"aqueous\": true,\n        \"other\": \"Neutral to slightly basic pH (8-9)\"\n      },\n      \"mechanism\": \"Cu(I)-catalyzed cross-coupling of HCN and acetylene to give acrylonitrile.\",\n      \"reasoning\": \"This step is shown mechanistically in Patel et al. (2015, Nature Chem.), with Cu(I) accelerating the coupling of HCN and acetylene to acrylonitrile. Critiques concern Cu abundance and staged reagent delivery, but the reaction is supported. [Patel et al., 2015]\"\n    },\n    {\n      \"id\": \"rxn_002\",\n      \"name\": \"Aza-Michael addition: acrylonitrile + NH3\",\n      \"inputs\": [\"mol_005\", \"mol_003\"],\n      \"outputs\": [\"mol_006\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300-340K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"No catalyst is required; neutral pH favorable\"\n      },\n      \"mechanism\": \"Nucleophilic addition of ammonia to acrylonitrile to give \u03b2-aminopropionitrile.\",\n      \"reasoning\": \"Ammonia reacts with acrylonitrile under aqueous conditions to form \u03b2-aminopropionitrile; demonstrated as a precursor of proline. [Patel et al., 2015]\"\n    },\n    {\n      \"id\": \"rxn_003\",\n      \"name\": \"UV/H2S photoreduction to 3-aminopropanal\",\n      \"inputs\": [\"mol_006\", \"mol_004\"],\n      \"outputs\": [\"mol_007\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"UV light (254nm)\", \"H2S\"],\n      \"conditions\": {\n        \"temperature\": \"300-330K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"UV irradiation, presence of H2S as photoreductant\"\n      },\n      \"mechanism\": \"Photoreductive cleavage of the nitrile to the aldehyde using H2S and UV light (254 nm).\",\n      \"reasoning\": \"Photoreduction with H2S/UV is key to cyanosulfidic chemistry. Yields \u03b2-aminopropanal, an established intermediate. [Patel et al., 2015, Figure 1]\"\n    },\n    {\n      \"id\": \"rxn_004\",\n      \"name\": \"Cyclization/hydrolysis to \u03b2-alanine\",\n      \"inputs\": [\"mol_007\", \"mol_021\"],\n      \"outputs\": [\"mol_008\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"310-330K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Mildly basic pH\"\n      },\n      \"mechanism\": \"Aldehyde hydration and subsequent hydrolysis yields \u03b2-alanine from \u03b2-aminopropanal.\",\n      \"reasoning\": \"\u03b2-aminopropanal can be hydrated and hydrolyzed to \u03b2-alanine; this is plausible and parallels Strecker-like steps, although not shown as a main branch in Patel et al. (2015). [Speculative but mechanistically justified]\"\n    },\n    {\n      \"id\": \"rxn_005\",\n      \"name\": \"Reductive formation of \u03b3-butyrothiolactam\",\n      \"inputs\": [\"mol_006\", \"mol_004\"],\n      \"outputs\": [\"mol_009\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"UV light (254nm)\", \"H2S\"],\n      \"conditions\": {\n        \"temperature\": \"310-330K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Requires photoreductive environment\"\n      },\n      \"mechanism\": \"UV/H2S mediated reduction and cyclization yields \u03b3-butyrothiolactam (cyclic thioamide) from \u03b2-aminopropionitrile.\",\n      \"reasoning\": \"Formation of \u03b3-butyrothiolactam is explicitly reported in the proline route as a key intermediate. [Patel et al., 2015, Scheme 2]\"\n    },\n    {\n      \"id\": \"rxn_006\",\n      \"name\": \"Photoreduction/cyclization to proline \u03b1-aminonitrile\",\n      \"inputs\": [\"mol_009\", \"mol_001\"],\n      \"outputs\": [\"mol_010\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"UV light (254nm)\", \"H2S\"],\n      \"conditions\": {\n        \"temperature\": \"312-333K\",\n        \"pressure\": \"wet-dry cycles (ambient)\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"UV irradiation; staged addition of HCN\"\n      },\n      \"mechanism\": \"Conversion of \u03b3-butyrothiolactam to cyclic imine and subsequent Strecker capture with HCN yields proline \u03b1-aminonitrile.\",\n      \"reasoning\": \"Final photoreduction plus HCN addition completes the mechanistic prebiotic proline precursor synthesis, 32% yield over these steps. [Patel et al., 2015]\"\n    },\n    {\n      \"id\": \"rxn_007\",\n      \"name\": \"Hydrolysis of proline \u03b1-aminonitrile to prolinamide\",\n      \"inputs\": [\"mol_010\", \"mol_021\"],\n      \"outputs\": [\"mol_011\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"320-370K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Long timescale or mild acid/base\"\n      },\n      \"mechanism\": \"Stepwise aqueous hydrolysis of the \u03b1-aminonitrile's nitrile group to amide.\",\n      \"reasoning\": \"Hydrolysis of aminonitrile to amide is a standard Strecker sequence step, but not directly demonstrated for proline aminonitrile; plausible by analogy. [Patel et al., 2015, with caveat of unquantified yield]\"\n    },\n    {\n      \"id\": \"rxn_008\",\n      \"name\": \"Hydrolysis of prolinamide to racemic proline\",\n      \"inputs\": [\"mol_011\", \"mol_021\"],\n      \"outputs\": [\"mol_022\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"320-370K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Long timescale hydrolysis\"\n      },\n      \"mechanism\": \"Final hydrolysis liberates proline from the amide intermediate.\",\n      \"reasoning\": \"Hydrolysis of the amide to proline closes the Strecker sequence. Not directly demonstrated for proline but standard for \u03b1-aminonitriles. [Patel et al., 2015 and general Strecker precedents]\"\n    },\n    {\n      \"id\": \"rxn_009\",\n      \"name\": \"Enantiomeric amplification (solid\u2013solution eutectic or phase equilibrium)\",\n      \"inputs\": [\"mol_022\"],\n      \"outputs\": [\"mol_023\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\"solid-solution equilibrium\", \"eutectic phase separation\"],\n      \"conditions\": {\n        \"temperature\": \"298-320K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": false,\n        \"other\": \"Partial solubility with eutectic phase behavior; applies to near-racemic solutions\"\n      },\n      \"mechanism\": \"Seed enantiomeric excess is amplified in solution by selective crystallization with the racemate.\",\n      \"reasoning\": \"Proline has the best-studied phase-behavior amplification; nearly enantiopure solutions are achievable from a small initial excess (if any), though not in truly prebiotic solvents. [Klussmann et al., 2006, Nature]\"\n    },\n    {\n      \"id\": \"rxn_010\",\n      \"name\": \"Solid-phase hydrolysis of extraterrestrial organic residue\",\n      \"inputs\": [\"mol_021\"],\n      \"outputs\": [\"mol_022\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"acid (e.g., HCl, formed in situ)\"],\n      \"conditions\": {\n        \"temperature\": \"310-340K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Hydrolysis of organic residue deposits\"\n      },\n      \"mechanism\": \"Hydrolysis of acid-labile residues (from irradiated ices or meteorite organics) releases racemic proline.\",\n      \"reasoning\": \"Proline detected after hydrolysis of organic residues in UV-irradiated ices (Mu\u00f1oz Caro et al., 2002; Bernstein et al., 2002) and meteorites (Kvenvolden et al., 1970; Glavin et al., 2025). Mechanism not established but product is unambiguous. [Mu\u00f1oz Caro et al., 2002; Glavin et al., 2025]\"\n    },\n    {\n      \"id\": \"rxn_011\",\n      \"name\": \"Spark discharge Strecker\u2013like amino acid synthesis\",\n      \"inputs\": [\"mol_001\", \"mol_003\", \"mol_021\"],\n      \"outputs\": [\"mol_022\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"electrical discharge\"],\n      \"conditions\": {\n        \"temperature\": \"310-330K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Reducing to neutral atmosphere; mixture of products\"\n      },\n      \"mechanism\": \"Electrical discharge yields complex organic mixture containing HCN and other precursors. Inferred Strecker-type pathway leads to proline.\",\n      \"reasoning\": \"Proline detected among 20+ amino acids in Miller spark discharge reactions (Ring et al., 1972; Johnson et al., 2008). Mechanistic details for proline not isolated but strongly inferred. [Ring et al., 1972; Parker et al., 2011]\"\n    },\n    {\n      \"id\": \"rxn_012\",\n      \"name\": \"Parent-body aqueous alteration (Strecker/fischer\u2013tropsch)\",\n      \"inputs\": [\"mol_001\", \"mol_003\", \"mol_021\"],\n      \"outputs\": [\"mol_022\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"meteoritic minerals (Fe, Ni, silicates)\"],\n      \"conditions\": {\n        \"temperature\": \"273-423K\",\n        \"pressure\": \"variable\",\n        \"catalyst\": \"meteoritic mineral catalysis\",\n        \"aqueous\": true,\n        \"other\": \"Aqueous alteration, low oxygen\"\n      },\n      \"mechanism\": \"Strecker/catalytic formation of amino acids in aqueous parent-body settings, possibly followed by hydrolysis.\",\n      \"reasoning\": \"Proline detected in Murchison, Bennu, Ryugu, and parent-body hydrolysates. Exact mechanism for proline not established. [Kvenvolden et al., 1970; Glavin et al., 2025; Parker et al., 2023]\"\n    },\n    {\n      \"id\": \"rxn_013\",\n      \"name\": \"Cyanamide guanidinylation (competing arginine branch)\",\n      \"inputs\": [\"mol_005\", \"mol_013\"],\n      \"outputs\": [\"mol_014\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"310-340K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Presence of cyanamide\"\n      },\n      \"mechanism\": \"Cyanamide enables guanidinylation of \u03b2-aminopropionitrile skeleton, diverting flux toward arginine-type products.\",\n      \"reasoning\": \"When cyanamide is present, the cyanosulfidic network generates arginine aminonitrile alongside proline's. This is a documented branchpoint in the Patel et al. (2015) route. [Patel et al., 2015]\"\n    },\n    {\n      \"id\": \"rxn_014\",\n      \"name\": \"Hydrolysis of arginine \u03b1-aminonitrile to arginine\",\n      \"inputs\": [\"mol_014\", \"mol_021\"],\n      \"outputs\": [\"mol_020\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"320-350K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Standard aqueous hydrolysis\"\n      },\n      \"mechanism\": \"Stepwise hydrolysis of arginine aminonitrile intermediate to arginine.\",\n   