ldehyde\",\n      \"description\": \"L-alanine formed by any upstream route reacts with hydrothermally generated formaldehyde, yielding L-threonine via aldol condensation.\",\n      \"reaction_sequence\": [\"rxn_004\"],\n      \"key_intermediates\": [\"mol_008\"]\n    },\n    {\n      \"pathway_id\": \"P3\",\n      \"name\": \"Surface Strecker-aminonitrile hydrolysis route to L-alanine then hydrothermal aldol\",\n      \"description\": \"Glycolaldehyde (mol_012) with HCN and NH3 yields alanine (mol_008) via aminonitrile hydrolysis, enabling formaldehyde condensation to threonine in hydrothermal vents.\",\n      \"reaction_sequence\": [\"rxn_005\", \"rxn_006\", \"rxn_004\"],\n      \"key_intermediates\": [\"mol_013\", \"mol_008\"]\n    },\n    {\n      \"pathway_id\": \"P4\",\n      \"name\": \"Pyruvate reductive amination to alanine and then aldol condensation\",\n      \"description\": \"Pyruvic acid with ammonia and hydroxylamine (Fe catalyzed) yields alanine, enabling hydrothermal aldol to threonine.\",\n      \"reaction_sequence\": [\"rxn_007\", \"rxn_004\"],\n      \"key_intermediates\": [\"mol_010\", \"mol_008\"]\n    },\n    {\n      \"pathway_id\": \"P5\",\n      \"name\": \"Serine reduction to alanine then hydrothermal aldol\",\n      \"description\": \"Serine reduced to alanine (hydrothermal, FeS), then formaldehyde condensation produces threonine.\",\n      \"reaction_sequence\": [\"rxn_010\", \"rxn_008\", \"rxn_004\"],\n      \"key_intermediates\": [\"mol_014\", \"mol_008\"]\n    },\n    {\n      \"pathway_id\": \"P6\",\n      \"name\": \"Glycolaldehyde + formaldehyde \u2192 lactaldehyde \u2192 cyanosulfidic Strecker sequence\",\n      \"description\": \"Glycolaldehyde and formaldehyde generate lactaldehyde (rxn_009), launching full surface cyanosulfidic path to threonine.\",\n      \"reaction_sequence\": [\"rxn_009\", \"rxn_001\", \"rxn_002\", \"rxn_003\"],\n      \"key_intermediates\": [\"mol_001\", \"mol_003\", \"mol_005\"]\n    },\n    {\n      \"pat