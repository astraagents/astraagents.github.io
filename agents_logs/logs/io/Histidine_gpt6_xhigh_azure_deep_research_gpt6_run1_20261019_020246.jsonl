\": \"mol_014\",\n      \"formula\": \"C6H10N4O\",\n      \"iupac_name\": \"2-amino-3-(1H-imidazol-4-yl)propanamide\",\n      \"common_name\": \"histidinamide\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_015\",\n      \"formula\": \"CO2\",\n      \"iupac_name\": \"carbon dioxide\",\n      \"common_name\": \"carbon dioxide\",\n      \"inchi\": \"InChI=1S/CO2/c2-1-3\",\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_016\",\n      \"formula\": \"C7H8N4O2\",\n      \"iupac_name\": \"5-[(1H-imidazol-4-yl)methyl]imidazolidine-2,4-dione\",\n      \"common_name\": \"histidine hydantoin\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_017\",\n      \"formula\": \"C7H10N4O3\",\n      \"iupac_name\": \"2-(carbamoylamino)-3-(1H-imidazol-4-yl)propanoic acid\",\n      \"common_name\": \"N-carbamoylhistidine\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_018\",\n      \"formula\": \"C6H9N3O2\",\n      \"iupac_name\": \"2-amino-3-(1H-imidazol-4-yl)propanoic acid\",\n      \"common_name\": \"histidine\",\n      \"inchi\": \"InChI=1S/C6H9N3O2/c7-5(6(10)11)1-4-2-8-3-9-4/h2-3,5H,1,7H2,(H,8,9)(H,10,11)\",\n      \"role\": \"target\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_019\",\n      \"formula\": \"CH4\",\n      \"iupac_name\": \"methane\",\n      \"common_name\": \"methane\",\n      \"inchi\": \"InChI=1S/CH4/h1H4\",\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_020\",\n      \"formula\": \"H2\",\n      \"iupac_name\": \"dihydrogen\",\n      \"common_name\": \"hydrogen\",\n      \"inchi\": \"InChI=1S/H2/h1H\",\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_021\",\n      \"formula\": \"N2\",\n      \"iupac_name\": \"dinitrogen\",\n      \"common_name\": \"nitrogen\",\n      \"inchi\": \"InChI=1S/N2/c1-2\",\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    }\n  ],\n  \"reactions\": [\n    {\n      \"id\": \"rxn_001\",\n      \"name\": \"Erythrose-producing branch of glycolaldehyde self-aldol chemistry\",\n      \"inputs\": [\"mol_005\"],\n      \"outputs\": [\"mol_006\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Hydroxide ions, providing general-base catalysis\"],\n      \"conditions\": {\n        \"temperature\": \"300-340 K, proposed operating range\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": \"Hydroxide ions\",\n        \"aqueous\": true,\n        \"other\": \"Alkaline concentrated water, approximately pH 9-11. Erythrose is one product of a mixture containing other tetroses and further condensation products. Subsequent acidification is required.\"\n      },\n      \"mechanism\": \"Base-mediated enolization and aldol addition combine glycolaldehyde molecules into tetroses. This node represents the erythrose-producing branch, not selective conversion of the entire feed.\",\n      \"reasoning\": \"Formose-derived tetroses are identified as possible erythrose sources in the supplied discussion of Shen et al. (1987) and V\u00e1zquez-Salazar et al. (2018). Glycolaldehyde self-aldol chemistry provides the required carbon skeleton without an oxidant. However, the supplied literature does not demonstrate selective erythrose accumulation followed by end-to-end histidine synthesis. The proposed environmental integration is speculative; competing threose formation, degradation, and further oligomerization are major limitations.\"\n    },\n    {\n      \"id\": \"rxn_002\",\n      \"name\": \"Candidate formamidine supply by HCN ammoniation\",\n      \"inputs\": [\"mol_003\", \"mol_002\"],\n      \"outputs\": [\"mol_007\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-320 K, exploratory rather than validated\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Concentrated ammonia/HCN microenvironments with limited volatilization; rapid downstream consumption would be necessary. No productive rate or yield is assigned.\"\n      },\n      \"mechanism\": \"Proposed nucleophilic addition of ammonia to HCN followed by proton transfers gives formamidine. This represents a candidate supply reaction, not an established efficient aqueous process.\",\n      \"reasoning\": \"Speculative precursor-supply edge. Shen et al. (1987, 1990) considered HCN/ammonia-derived formamidine prebiotically relevant, but useful production from dilute mixtures was problematic. V\u00e1zquez-Salazar et al. (2018) emphasized competing formamidine hydrolysis. The edge closes the nitrogenous precursor inventory chemically but remains a principal feasibility bottleneck; it must not be interpreted as demonstrated accumulation of approximately 30 mM formamidine.\"\n    },\n    {\n      \"id\": \"rxn_003\",\n      \"name\": \"Observed erythrose\u2013formamidine assembly of imidazole acetaldehyde\",\n      \"inputs\": [\"mol_006\", \"mol_007\"],\n      \"outputs\": [\"mol_009\", \"mol_001\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"353 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Approximately 0.03 M erythrose and 0.03 M formamidine, pH approximately 6, about 12 hours. Concentration and pH must be staged separately from alkaline tetrose formation.\"\n      },\n      \"mechanism\": \"Coarse-grained condensation, rearrangement, cyclization, and dehydration construct the substituted imidazole. The endpoint is established, but the microscopic order of these events is not uniquely resolved.\",\n      \"reasoning\": \"Shen et al. (1987) identified imidazole-4-acetaldehyde, with a maximum reported yield of 1.6% relative to erythrose, without an added mineral catalyst. Shen et al. (1990) subsequently obtained histidine from the precursor-generating mixture. The original precursor concentration was 0.03 M, not the 0.3 M quoted in V\u00e1zquez-Salazar et al. (2018). Availability and survival of both precursors remain unresolved geochemical constraints.\"\n    },\n    {\n      \"id\": \"rxn_004\",\n      \"name\": \"Observed erythrose\u2013formamidine formation of imidazole glycol\",\n      \"inputs\": [\"mol_006\", \"mol_007\"],\n      \"outputs\": [\"mol_008\", \"mol_001\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"353 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Approximately 0.03 M precursor concentrations, mildly acidic water near pH 6, approximately 12 hours.\"\n      },\n      \"mechanism\": \"Condensation and ring closure retain a vicinal-diol side chain, producing imidazole-4-glycol with net water elimination.\",\n      \"reasoning\": \"Shen et al. (1987) reported imidazole-4-glycol at up to 6.8% yield relative to erythrose. Its formation is experimentally supported, but its quantitative conversion into the histidine precursor aldehyde was not established as a separately closed pathway. It is therefore represented as an observed potential reservoir rather than an automatically productive histidine intermediate.\"\n    },\n    {\n      \"id\": \"rxn_005\",\n      \"name\": \"Proposed acid-promoted conversion of imidazole glycol to aldehyde\",\n      \"inputs\": [\"mol_008\"],\n      \"outputs\": [\"mol_009\", \"mol_001\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Hydronium ions, providing acid catalysis\"],\n      \"conditions\": {\n        \"temperature\": \"330-370 K, proposed range\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": \"Hydronium ions\",\n        \"aqueous\": true,\n        \"other\": \"Separate acidic stage, approximately pH 2-5. Product distribution and residence time require measurement before downstream neutralization.\"\n      },\n      \"mechanism\": \"Proposed pinacol-type dehydration and hydride migration convert the heteroaryl vicinal diol into the side-chain aldehyde. Competing rearrangements may produce other carbonyl compounds.\",\n      \"reasoning\": \"Speculative completion of an experimentally observed precursor branch. Shen et al. (1987) discussed glycol-to-aldehyde dehydration as plausible, but the supplied research does not establish a selective, geochemically validated conversion. The proposed hydride-migration orientation gives the required aldehyde without molecular oxygen; its regioselectivity, yield, and rate are unmeasured bottlenecks.\"\n    },\n    {\n      \"id\": \"rxn_006\",\n      \"name\": \"Proposed anoxic redox closure of the erythrose\u2013formaldehyde\u2013ammonia glycol branch\",\n      \"inputs\": [\"mol_006\", \"mol_004\", \"mol_002\"],\n      \"outputs\": [\"mol_008\", \"mol_011\", \"mol_001\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"353 K as an experimental reference, not validation of the proposed redox mechanism\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Concentrated erythrose, formaldehyde, and ammonium/ammonia near pH 6.6. Additional formaldehyde supplies a proposed sacrificial oxidant and is reduced to methanol. Molecular oxygen is excluded.\"\n      },\n      \"mechanism\": \"Coarse-grained carbonyl\u2013ammonia condensation constructs the imidazole glycol while a proposed coupled transfer of reducing equivalents converts formaldehyde to methanol.\",\n      \"reasoning\": \"Shen et al. (1987) observed imidazole-4-glycol in erythrose/formaldehyde/ammonia mixtures, at approximately 1.8% maximum yield, but did not identify the necessary oxidant. Formaldehyde was among the possibilities considered. This oxygen-free closure is speculative: methanol is a predicted balancing coproduct, not a reported product assignment for this mechanism. Neither the electron-transfer mechanism nor its rate under these conditions is established.\"\n    },\n    {\n      \"id\": \"rxn_007\",\n      \"name\": \"Hypothesized precyclization dehydration of erythrose\",\n      \"inputs\": [\"mol_006\"],\n      \"outputs\": [\"mol_010\", \"mol_001\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Hydronium ions, providing acid catalysis\"],\n      \"conditions\": {\n        \"temperature\": \"330-370 K, exploratory range\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": \"Hydronium ions\",\n        \"aqueous\": true,\n        \"other\": \"Approximately pH 2-5 in a separate stage. Immediate trapping would be needed because sugar rearrangement, fragmentation, and polymerization compete.\"\n      },\n      \"mechanism\": \"Hypothesized dehydration and hydride migration across the terminal vicinal diol produce 2-hydroxybutane-1,4-dial while retaining the alpha-hydroxyaldehyde unit needed for later ring formation.\",\n      \"reasoning\": \"Highly speculative structural realization of the precyclization-dehydration alternative discussed by Shen et al. (1987). That discussion does not identify 2-hydroxybutane-1,4-dial as an experimentally observed intermediate. The proposed structure makes the required side-chain aldehyde before imidazole closure and is atom-balanced without oxidation, but ordinary sugar degradation may overwhelmingly dominate.\"\n    },\n    {\n      \"id\": \"rxn_008\",\n      \"name\": \"Hypothesized formamidine capture of the preformed side-chain aldehyde precursor\",\n      \"inputs\": [\"mol_010\", \"mol_007\"],\n      \"outputs\": [\"mol_009\", \"mol_001\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"330-353 K, proposed range\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Adjust toward pH 5-7 after the dehydration stage; use rapid production\u2013capture coupling rather than assuming storage of the dialdehyde.\"\n      },\n      \"mechanism\": \"Proposed formamidine condensation with the alpha-hydroxyaldehyde end, followed by cyclodehydration, forms the imidazole ring while preserving the distal acetaldehyde substituent.\",\n      \"reasoning\": \"Speculative; no target-specific experiment with this named dialdehyde is reported in the supplied literature. Shen et al. (1987) support considering rearrangement before versus after heterocycle formation, but not this precise intermediate assignment. Competing attack at the second aldehyde and intermolecular condensation may prevent selective ring closure. This edge is a testable mechanistic alternative, not an established additional synthesis.\"\n    },\n    {\n      \"id\": \"rxn_009\",\n      \"name\": \"Strecker imine formation\",\n      \"inputs\": [\"mol_009\", \"mol_002\"],\n      \"outputs\": [\"mol_012\", \"mol_001\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-330 K, proposed mechanistic staging\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Ammonia-rich water, approximately pH 8-9, followed by cyanide capture. The imine is an equilibrium intermediate rather than an assumed isolable reservoir.\"\n      },\n      \"mechanism\": \"Ammonia adds to the aldehyde, and carbinolamine dehydration establishes an imine/iminium equilibrium.\",\n      \"reasoning\": \"The aldehyde-to-histidine Strecker sequence is supported by Shen et al. (1990). This explicit imine node is a conventional mechanistic decomposition of that sequence, not a claim that the intermediate was separately isolated or kinetically characterized. The listed conditions are proposed staging conditions; the supplied report does not establish them as the exact optimized second-stage protocol.\"\n    },\n    {\n      \"id\": \"rxn_010\",\n      \"name\": \"Strecker cyanide capture and alpha-aminonitrile formation\",\n      \"inputs\": [\"mol_012\", \"mol_003\"],\n      \"outputs\": [\"mol_013\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-330 K, proposed range\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"HCN/cyanide supplied to the imine-containing mixture. Avoid assuming indefinite HCN retention in an open, irradiated pool.\"\n      },\n      \"mechanism\": \"Cyanide addition to the iminium carbon followed by proton transfer installs the alpha-amino-acid carbon skeleton as an aminonitrile.\",\n      \"reasoning\": \"Shen et al. (1990) obtained histidine after adding HCN and ammonia to the imidazole-aldehyde-generating mixture, supporting this conventional Strecker connection. The reported 3.5% histidine yield applies to the experimental sequence as a whole, not to this individual modeled step. No enantioselective catalyst or demonstrated asymmetric induction is assigned.\"\n    },\n    {\n      \"id\": \"rxn_011\",\n      \"name\": \"Stepwise hydrolysis of histidine aminonitrile to histidinamide\",\n      \"inputs\": [\"mol_013\", \"mol_001\"],\n      \"outputs\": [\"mol_014\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Hydronium ions, promoting nitrile hydrolysis\"],\n      \"conditions\": {\n        \"temperature\": \"340-370 K, proposed range\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": \"Hydronium ions\",\n        \"aqueous\": true,\n        \"other\": \"Acidic aqueous aging, approximately pH 1-3, after cyanide capture. Required residence time is unmeasured for this environmental implementation.\"\n      },\n      \"mechanism\": \"Protonation and water addition to the nitrile, followed by tautomerization, produce the corresponding primary amide.\",\n      \"reasoning\": \"Nitrile hydrolysis is required by the Strecker interpretation of Shen et al. (1990). The amide is a conventional mechanistic intermediate, not a separately demonstrated accumulating species in the supplied histidine experiment. Efficient hydrolysis at the proposed surface temperatures and acidity remains an extrapolation; heating cannot be increased without considering amino-acid and precursor destruction, as emphasized by Ito et al. (2006).\"\n    },\n    {\n      \"id\": \"rxn_012\",\n      \"name\": \"Histidinamide hydrolysis to histidine\",\n      \"inputs\": [\"mol_014\", \"mol_001\"],\n      \"outputs\": [\"mol_018\", \"mol_002\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Hydronium ions, promoting amide hydrolysis\"],\n      \"conditions\": {\n        \"temperature\": \"350-370 K, proposed range\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": \"Hydronium ions\",\n        \"aqueous\": true,\n        \"other\": \"Prolonged acidic aqueous aging, followed by cooling and partial neutralization. The nitrogen coproduct is predominantly ammonium at the reaction pH.\"\n      },\n      \"mechanism\": \"Acid-promoted addition\u2013elimination hydrolyzes the amide to the carboxylic acid and releases ammonia/ammonium.\",\n      \"reasoning\": \"Shen et al. (1990) directly established the histidine endpoint by multiple chromatographic and mass-spectrometric methods. The separate amide-hydrolysis node is mechanistic bookkeeping rather than a measured individual reaction. Its natural rate may be a substantial bottleneck, and neither a complete kinetic model nor a validated geochemical hydrolysis protocol is provided by the supplied research.\"\n    },\n    {\n      \"id\": \"rxn_013\",\n      \"name\": \"Proposed Bucherer\u2013Bergs diversion of the aminonitrile to histidine hydantoin\",\n      \"inputs\": [\"mol_013\", \"mol_015\"],\n      \"outputs\": [\"mol_016\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"323-363 K, exploratory range\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Ammonium carbonate/bicarbonate-rich water near pH 8-9. Carbon dioxide represents the equilibrating dissolved inorganic-carbon reagent, not a mineral catalyst.\"\n      },\n      \"mechanism\": \"Candidate aminonitrile carbamylation by dissolved inorganic carbon, followed by cyclization and rearrangement, yields the substituted hydantoin.\",\n      \"reasoning\": \"Speculative for this substrate and prebiotic setting. Criado-Reyes et al. (2021) discuss Bucherer\u2013Bergs chemistry as a possible general amino-acid pathway but do not establish a histidine-specific hydantoin intermediate. Standard aminonitrile/carbon-dioxide chemistry motivates the branch; substrate compatibility, competing imidazole chemistry, and productive environmental concentrations require experimental testing.\"\n    },\n    {\n      \"id\": \"rxn_014\",\n      \"name\": \"Proposed hydrolytic opening of histidine hydantoin\",\n      \"inputs\": [\"mol_016\", \"mol_001\"],\n      \"outputs\": [\"mol_017\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Hydroxide ions, promoting hydantoin ring opening\"],\n      \"conditions\": {\n        \"temperature\": \"350-370 K, exploratory range\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": \"Hydroxide ions\",\n        \"aqueous\": true,\n        \"other\": \"Separate alkaline stage near pH 10-12. No enzyme is assumed, and sufficient conversion within a realistic residence time is not established.\"\n      },\n      \"mechanism\": \"Hydrolytic cleavage of the hydantoin ring gives the corresponding N-carbamoyl amino acid.\",\n      \"reasoning\": \"Speculative target-specific extension of the general Bucherer\u2013Bergs possibility mentioned by Criado-Reyes et al. (2021). The supplied literature contains no demonstrated nonenzymatic histidine-hydantoin hydrolysis under these conditions. This step is included as the chemically required opening of the proposed hydantoin reservoir, not as evidence that the alternative pathway operates efficiently.\"\n    },\n    {\n      \"id\": \"rxn_015\",\n      \"name\": \"Proposed decarbamoylation of N-carbamoylhistidine\",\n      \"inputs\": [\"mol_017\", \"mol_001\"],\n      \"outputs\": [\"mol_018\", \"mol_002\", \"mol_015\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Hydronium ions, promoting carbamoyl-group hydrolysis\"],\n      \"conditions\": {\n        \"temperature\": \"350-370 K, exploratory range\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": \"Hydronium ions\",\n        \"aqueous\": true,\n        \"other\": \"Acidification after hydantoin opening; prolonged aqueous aging may be necessary. No unmeasured conversion rate or yield is assigned.\"\n      },\n      \"mechanism\": \"Hydrolysis removes the N-carbamoyl group, releasing histidine, ammonia/ammonium, and carbon dioxide.\",\n      \"reasoning\": \"Speculative; no N-carbamoylhistidine-to-histidine prebiotic experiment is established in the supplied research. This is the chemically required terminal transformation of the proposed Bucherer\u2013Bergs branch, which Criado-Reyes et al. (2021) mention only at the general amino-acid level. Resistance of the carbamoyl group to mild hydrolysis may invalidate the proposed surface implementation even if upstream hydantoin formation succeeds.\"\n    },\n    {\n