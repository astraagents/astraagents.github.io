\": \"C4H9N3O\",\n      \"iupac_name\": \"2-Imino-1,3-diazinan-4-ol\",\n      \"common_name\": \"Cyclic hemiaminal of 3-guanidinopropanal\",\n      \"inchi\": \"InChI=1S/C4H9N3O/c5-4-6-2-1-3(8)7-4/h3,8H,1-2H2,(H3,5,6,7)\",\n      \"role\": \"hub_intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_014\",\n      \"formula\": \"C4H8N2O\",\n      \"iupac_name\": \"4-Amino-2-hydroxybutanenitrile\",\n      \"common_name\": null,\n      \"inchi\": null,\n      \"role\": \"hub_intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_015\",\n      \"formula\": \"C5H10N4O\",\n      \"iupac_name\": \"4-(Diaminomethylideneamino)-2-hydroxybutanenitrile\",\n      \"common_name\": \"First guanidino cyanohydrin\",\n      \"inchi\": \"InChI=1S/C5H10N4O/c6-3-4(10)1-2-9-5(7)8/h4,10H,1-2H2,(H4,7,8,9)\",\n      \"role\": \"hub_intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_016\",\n      \"formula\": \"C4H10N2OS\",\n      \"iupac_name\": \"4-Amino-2-hydroxybutanethioamide\",\n      \"common_name\": null,\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_017\",\n      \"formula\": \"C5H12N4OS\",\n      \"iupac_name\": \"4-(Diaminomethylideneamino)-2-hydroxybutanethioamide\",\n      \"common_name\": \"Guanidino hydroxythioamide\",\n      \"inchi\": \"InChI=1S/C5H12N4OS/c6-4(11)3(10)1-2-9-5(7)8/h3,10H,1-2H2,(H2,6,11)(H4,7,8,9)\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_018\",\n      \"formula\": \"C4H10N2S\",\n      \"iupac_name\": \"4-Aminobutanethioamide\",\n      \"common_name\": null,\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_019\",\n      \"formula\": \"C5H12N4S\",\n      \"iupac_name\": \"4-(Diaminomethyl