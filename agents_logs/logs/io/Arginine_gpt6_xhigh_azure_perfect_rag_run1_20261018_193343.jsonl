: "Guanidino butanethioamide", "inchi": "InChI=1S/C5H12N4S/c6-4(10)2-1-3-9-5(7)8/h1-3H2,(H2,6,10)(H4,7,8,9)", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_020", "formula": "C5H11N3O", "iupac_name": "4-[(Diaminomethylidene)amino]butanal", "common_name": "4-Guanidinobutanal", "inchi": null, "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_021", "formula": "C4H4N2", "iupac_name": "Butanedinitrile", "common_name": "Succinonitrile", "inchi": "InChI=1S/C4H4N2/c5-3-1-2-4-6/h1-2H2", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_022", "formula": "C4H8N2", "iupac_name": "4-Aminobutanenitrile", "common_name": "Gamma-aminobutyronitrile", "inchi": null, "role": "hub_intermediate", "environment_formed": null}, {"id": "mol_023", "formula": "C5H10N4", "iupac_name": "4-[(Diaminomethylidene)amino]butanenitrile", "common_name": "N-(3-Cyanopropyl)guanidine", "inchi": null, "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_024", "formula": "C4H5NO", "iupac_name": "4-Oxobutanenitrile", "common_name": "3-Cyanopropanal", "inchi": null, "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_025", "formula": "C6H13N5", "iupac_name": "2-Amino-5-[(diaminomethylidene)amino]pentanenitrile", "common_name": "Arginine aminonitrile", "inchi": "InChI=1S/C6H13N5/c7-4-5(8)2-1-3-11-6(9)10/h5H,1-3,8H2,(H4,9,10,11)", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_026", "formula": "C6H15N5O", "iupac_name": "2-Amino-5-[(diaminomethylidene)amino]pentanamide", "common_name": "Argininamide", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_027", "formula": "C6H14N4O2", "iupac_name": "2-Amino-5-[(diaminomethylidene)amino]pentanoic acid", "common_name": "Arginine", "inchi": "InChI=1S/C6H14N4O2/c7-4(5(11)12)2-1-3-10-6(8)9/h4H,1-3,7H2,(H,11,12)(H4,8,9,10)", "role": "target", "environment_formed": null}, {"id": "mol_028", "formula": "C7H13N5O2", "iupac_name": "5-[3-[(Diaminomethylidene)amino]propyl]imidazolidine-2,4-dione", "common_name": "Arginine hydantoin", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_029", "formula": "C7H15N5O3", "iupac_name": "2-(Carbamoylamino)-5-[(diaminomethylidene)amino]pentanoic acid", "common_name": "N-alpha-Carbamoylarginine", "inchi": null, "role": "intermediate", "environment_formed": "Hydrothermal"}], "reactions": [{"id": "rxn_001", "name": "Copper(I)-assisted acetylene hydrocyanation", "inputs": ["mol_001", "mol_002"], "outputs": ["mol_011"], "environment": "Surface", "agents": ["Dissolved copper(I) chloride/cyanide complexes"], "conditions": {"temperature": "330-365 K", "pressure": "Approximately 1 bar", "catalyst": "Copper(I) complexes", "aqueous": true, "other": "Prospective sulfide-free gas-water contact stage; mildly acidic chloride-bearing water; screen 0.1-10 mM dissolved copper. Copper speciation, gas delivery, and polymerization losses require measurement."}, "mechanism": "Copper-assisted addition of HCN across the acetylene triple bond forms the vinyl nitrile. This is hydrocyanation, not an uncatalyzed Michael addition to an electrophilic acetylene carbon.", "reasoning": "The supplied review attributes this entry reaction to Patel et al. (2015). Copper(I) catalysis is chemically more defensible than the review's bare nucleophilic-addition description. The stated conditions are screening assumptions, not verified conditions from that paper. Sulfide must not be assumed compatible with the dissolved copper catalyst because copper sulfide precipitation can remove it."}, {"id": "rxn_002", "name": "Ammonia conjugate addition to acrylonitrile", "inputs": ["mol_011", "mol_003"], "outputs": ["mol_012"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-325 K", "pressure": "Approximately 1 bar", "catalyst": null, "aqueous": true, "other": "Prospective pH 8.5-10; ammonia in excess over acrylonitrile; shaded or nighttime reaction period; screen hours to days."}, "mechanism": "Ammonia adds at the beta carbon of acrylonitrile, followed by proton transfer to form 3-aminopropanenitrile.", "reasoning": "This reaction class and substrate pair are included in the supplied Patel et al. (2015) summary. Excess ammonia is intended to favor monoaddition, but additional cyanoethylation, polymerization, and ammonia volatilization must be quantified. No selective yield is inferred from the network."}, {"id": "rxn_003", "name": "Early guanidination of 3-aminopropanenitrile", "inputs": ["mol_012", "mol_004"], "outputs": ["mol_014"], "environment": "Surface", "agents": null, "conditions": {"temperature": "320-360 K", "pressure": "Approximately 1 bar", "catalyst": null, "aqueous": true, "other": "Prospective pH 8-10; concentrated aqueous phase with cyanamide in excess; screen 1-7 days; avoid complete drying and sustained UV exposure."}, "mechanism": "The primary amine attacks the nitrile carbon of cyanamide; proton transfers generate the substituted guanidine.", "reasoning": "The supplied review assigns this transformation to Patel et al. (2015), but does not provide its yield or operating window. Early guanidination avoids having to distinguish the alpha and side-chain amino groups of ornithine later. Cyanamide hydrolysis, oligomerization, and subsequent cyclization of the product remain competing reactions."}, {"id": "rxn_004", "name": "Guanidine formation from cyanamide and ammonia", "inputs": ["mol_004", "mol_003"], "outputs": ["mol_013"], "environment": "Surface", "agents": null, "conditions": {"temperature": "330-370 K", "pressure": "Approximately 1 bar", "catalyst": null, "aqueous": true, "other": "Prospective concentrated ammoniacal solution, pH 9-11; screen days to weeks. Evaporation must be balanced against ammonia loss."}, "mechanism": "Ammonia adds to cyanamide, followed by proton transfer to give guanidine.", "reasoning": "Speculative as an effective prebiotic supply reaction under these conditions; it is not established by the supplied Patel et al. (2015) material. The transformation is chemically motivated by cyanamide's electrophilic carbon, but ammonia is a weaker nucleophile than many alkylamines. Cyanamide dimerization and hydrolysis may dominate."}, {"id": "rxn_005", "name": "Guanidine conjugate addition to acrylonitrile", "inputs": ["mol_013", "mol_011"], "outputs": ["mol_014"], "environment": "Surface", "agents": null, "conditions": {"temperature": "320-360 K", "pressure": "Approximately 1 bar", "catalyst": null, "aqueous": true, "other": "Prospective concentrated solution at pH 10-11; screen 1-7 days. Measure the unprotonated guanidine fraction and cyclic products rather than assuming productive conversion."}, "mechanism": "An unprotonated guanidine nitrogen undergoes aza-Michael addition to acrylonitrile, followed by proton transfer.", "reasoning": "Speculative alternative to rxn_002 plus rxn_003; no substrate-specific support is supplied by Patel et al. (2015). It reverses the order of guanidine assembly and carbon-chain attachment without introducing an aminoaldehyde. Guanidine protonation strongly limits nucleophilicity, and intramolecular capture of the remaining nitrile could prevent accumulation of the required open-chain product."}, {"id": "rxn_006", "name": "Proposed partial reduction of guanidino propanenitrile to an aldehyde", "inputs": ["mol_014", "mol_007", "mol_006"], "outputs": ["mol_015", "mol_003", "mol_008"], "environment": "Surface", "agents": ["Ferrocyanide photoredox mediator", "Ultraviolet light"], "conditions": {"temperature": "300-315 K", "pressure": "Approximately 1 bar", "catalyst": "Ferrocyanide", "aqueous": true, "other": "Prospective pH 7-9, substrate 1-10 mM, sulfite 10-100 mM, ferrocyanide 0.1-1 mM; screen 1-24 hours. A 254 nm source at 1-10 W/m2 is a laboratory proxy, not an asserted early-Earth spectrum. Exclude added sulfide and dissolved copper."}, "mechanism": "Hypothesized two-electron reduction of the nitrile to an imine followed by hydrolysis. The balanced net reaction consumes two waters and oxidizes sulfite to sulfate.", "reasoning": "Speculative substrate-specific reduction. Patel et al. (2015) provides the supplied cyanosulfidic context, while Xu et al. (2018) supports sulfite/ferrocyanide photoredox homologation for other substrates, not this guanidino nitrile. This formulation supplies explicit reducing equivalents instead of treating nitrile-to-hemiaminal conversion as simple hydrolysis. Selective aldehyde production, guanidine survival, mediator turnover, and sulfate versus other sulfur products must all be demonstrated."}, {"id": "rxn_007", "name": "Reversible formation of the six-membered guanidine hemiaminal", "inputs": ["mol_015"], "outputs": ["mol_016"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-325 K", "pressure": "Approximately 1 bar", "catalyst": null, "aqueous": true, "other": "Prospective pH 7-9; shaded equilibration after irradiation. Determine the open-chain aldehyde fraction and competing condensation products."}, "mechanism": "Intramolecular addition of a guanidine nitrogen to the aldehyde forms a six-membered cyclic hemiaminal without net addition or loss of water.", "reasoning": "This is a chemically corrected, speculative interpretation of the cyclic intermediate described in the supplied Patel et al. (2015) review. It distinguishes genuine hemiaminal formation from nitrile reduction and does not count omitted water or ammonia as alternative pathways. Productive downstream chemistry requires a measurable equilibrium population of the open-chain aldehyde."}, {"id": "rxn_008", "name": "Cyanohydrin trapping of the cyclic-hemiaminal equilibrium", "inputs": ["mol_016", "mol_002"], "outputs": ["mol_017"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-320 K", "pressure": "Approximately 1 bar", "catalyst": null, "aqueous": true, "other": "Prospective pH 8-9 and total cyanide 10-100 mM; shaded reaction interval. Monitor HCN escape, cyanohydrin reversal, and ring-opening equilibrium."}, "mechanism": "The cyclic hemiaminal reversibly opens to its aldehyde; cyanide adds to that carbonyl and protonation gives the cyanohydrin.", "reasoning": "The supplied review associates this conversion with Patel et al. (2015). The aldehyde-trapping mechanism is more defensible than direct cyanide displacement at a saturated hemiaminal carbon with unexplained retention of hydroxyl. Substrate-specific equilibrium constants and selectivity are missing, so productive trapping remains a hypothesis rather than an established step."}, {"id": "rxn_009", "name": "Hydrogen sulfide addition to the cyanohydrin nitrile", "inputs": ["mol_017", "mol_005"], "outputs": ["mol_018"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-335 K", "pressure": "Approximately 1 bar", "catalyst": null, "aqueous": true, "other": "Prospective pH 7-9 and dissolved sulfide 10-100 mM; screen hours to days in a copper-depleted, shaded solution."}, "mechanism": "Hydrosulfide attacks the nitrile carbon; proton transfer and tautomerization yield the thioamide.", "reasoning": "This reaction is included in the supplied Patel et al. (2015) summary and is consistent with known nitrile thiolysis chemistry. H2S is a stoichiometric sulfur reagent here, not an unspecified catalyst. The guanidino substrate's yield and competition with cyanohydrin dissociation are not established by the supplied information."}, {"id": "rxn_010", "name": "Proposed sulfite-driven reductive deoxygenation of the hydroxythioamide", "inputs": ["mol_018", "mol_007"], "outputs": ["mol_019", "mol_008"], "environment": "Surface", "agents": ["Ferrocyanide photoredox mediator", "Ultraviolet light"], "conditions": {"temperature": "300-315 K", "pressure": "Approximately 1 bar", "catalyst": "Ferrocyanide", "aqueous": true, "other": "Prospective pH 7-9; sulfite 10-100 mM and ferrocyanide 0.1-1 mM; laboratory 254 nm irradiation for 1-24 hours. Residual sulfide from rxn_009 must be measured and reduced before testing rather than assumed harmless."}, "mechanism": "Proposed two-electron reductive replacement of the alpha hydroxyl group by hydrogen. Sulfite oxidation provides the reducing equivalents; water cancels from the balanced net equation.", "reasoning": "Speculative and a decisive bottleneck, not a demonstrated repair of the review's Cu/H2S step. Patel et al. (2015), as summarized, motivates deoxygenation; Xu et al. (2018) motivates testing an explicit sulfite photoredox donor but does not establish this transformation. C-O cleavage must outcompete thioamide reduction, fragmentation, and photolysis. Sulfate production and carbon-product selectivity must be measured independently. This step does not homologate the carbon skeleton."}, {"id": "rxn_011", "name": "Proposed reductive hydrolysis of the guanidino thioamide", "inputs": ["mol_019", "mol_007", "mol_006"], "outputs": ["mol_020", "mol_003", "mol_005", "mol_008"], "environment": "Surface", "agents": ["Ferrocyanide photoredox mediator", "Ultraviolet light"], "conditions": {"temperature": "300-320 K", "pressure": "Approximately 1 bar", "catalyst": "Ferrocyanide", "aqueous": true, "other": "Prospective pH 7-9, sulfite 10-100 mM, ferrocyanide 0.1-1 mM; screen short irradiation intervals up to 24 hours. Quantify accumulating H2S, aldehyde trapping efficiency, and competing amide or amine formation."}, "mechanism": "Hypothesized two-electron reduction and hydrolytic cleavage of the thioamide to aldehyde, ammonia, and hydrogen sulfide. Two waters are consumed in the balanced net reaction.", "reasoning": "Speculative and a second decisive bottleneck. The supplied Patel et al. (2015) review compresses a redox-demanding conversion into a thioamide-to-cyanohydrin exchange. Here sulfite, not sulfur already present in the substrate, is explicitly oxidized as the external donor. This fixes bookkeeping but does not establish a productive mechanism. Aldehyde selectivity, sulfur fate, sulfide inhibition, and photocatalyst turnover remain unresolved; pathways P5-P10 bypass this reaction entirely."}, {"id": "rxn_012", "name": "Conjugate hydrocyanation of acrylonitrile to succinonitrile", "inputs": ["mol_011", "mol_002"], "outputs": ["mol_021"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-335 K", "pressure": "Approximately 1 bar", "catalyst": null, "aqueous": true, "other": "Prospective pH 8.5-10; concentrated cyanide-containing water; screen hours to days. Quantify polymerization and HCN loss."}, "mechanism": "Cyanide undergoes conjugate addition to acrylonitrile, followed by protonation to form succinonitrile.", "reasoning": "Speculative as a geochemical supply step in this network, although conjugate hydrocyanation is established reaction-class chemistry. The supplied Patel et al. (2015) material supports considering acrylonitrile as an intermediate but does not document this branch. It creates the required four-carbon backbone without the hydroxythioamide deoxygenation sequence and is included for that chemical advantage, not merely for pathway count."}, {"id": "rxn_013", "name": "Proposed selective monohydrogenation of succinonitrile", "inputs": ["mol_021", "mol_009"], "outputs": ["mol_022"], "environment": "Hydrothermal", "agents": ["Fresh native nickel-rich iron-nickel alloy surface"], "conditions": {"temperature": "370-420 K", "pressure": "10-100 bar total; prospective hydrogen partial pressure 1-20 bar", "catalyst": "Native nickel-rich iron-nickel alloy", "aqueous": true, "other": "Prospective sulfide-poor geothermal pores, pH 8-10, excess ammonia, and 1-24 hour contact. Test low conversion, catalyst passivation, product cyclization, and overhydrogenation. Subsequent cooling and transport to a surface capture stage are required but not demonstrated."}, "mechanism": "Hydrogen activation on nickel followed by hydrogenation of one nitrile group to a primary amine; two H2 molecules are required.", "reasoning": "Speculative; no substrate-selective hydrothermal experiment is supplied. Nickel is justified by its ability to activate hydrogen and catalyze nitrile hydrogenation, not by mineral availability alone. The principal problems are reduction of both nitriles, five-membered cyclic amidine formation from 4-aminobutanenitrile, and alloy sulfidation. Neither excess ammonia nor low conversion is assumed to solve these problems. This route is unacceptable as a productive pathway unless recoverable mono-reduced product is demonstrated."}, {"id": "rxn_014", "name": "Guanidination of 4-aminobutanenitrile before aldehyde generation", "inputs": ["mol_022", "mol_004"], "outputs": ["mol_023"], "environment": "Surface", "agents": null, "conditions": {"temperature": "315-350 K", "pressure": "Approximately 1 bar", "catalyst": null, "aqueous": true, "other": "Prospective pH 8-10, cyanamide in excess, and 1-72 hour reaction time. Hydrothermal feed, if used, must first cool and lose contact with the hydrogenation catalyst. Transport and capture times must be compared with measured cyclization kinetics."}, "mechanism": "The terminal primary amine adds to cyanamide to form the guanidino nitrile.", "reasoning": "Speculative extension of the amine guanidination summarized for Patel et al. (2015). It avoids late, nonselective guanidination of ornithine and avoids making unprotected 4-aminobutanal. However, 4-aminobutanenitrile can cyclize before guanidination. No pH or residence-time window is known from the supplied evidence in which useful guanidination outcompetes that reaction."}, {"id": "rxn_015", "name": "Proposed partial photoreduction of succinonitrile to a cyanoaldehyde", "inputs": ["mol_021", "mol_007", "mol_006"], "outputs": ["mol_024", "mol_003", "mol_008"], "environment": "Surface", "agents": ["Ferrocyanide photoredox mediator", "Ultraviolet light"], "conditions": {"temperature": "300-315 K", "pressure": "Approximately 1 bar", "catalyst": "Ferrocyanide", "aqueous": true, "other": "Prospective pH 7-9, succinonitrile 1-10 mM, sulfite 10-100 mM, ferrocyanide 0.1-1 mM; screen brief irradiation intervals within 1-24 hours. Avoid added HCN during aldehyde generation."}, "mechanism": "Two-electron reduction of one nitrile to an imine followed by hydrolysis gives 3-cyanopropanal. Two waters are consumed in the net reaction.", "reasoning": "Speculative substrate-specific extrapolation from the photoredox reaction class discussed by Patel et al. (2015) and Xu et al. (2018). The equivalent nitrile groups do not provide intrinsic protection against double reduction. Productive aldehyde capture must outcompete further reduction, hydration, and oligomerization. Unlike an aminoaldehyde route, this intermediate cannot directly form the problematic five-membered imine of 4-aminobutanal."}, {"id": "rxn_016", "name": "Proposed reductive amination of the cyanoaldehyde", "inputs": ["mol_024", "mol_003", "mol_007"], "outputs": ["mol_022", "mol_008"], "environment": "Surface", "agents": ["Ferrocyanide photoredox mediator", "Ultraviolet light"], "conditions": {"temperature": "300-320 K", "pressure": "Approximately 1 bar", "catalyst": "Ferrocyanide", "aqueous": true, "other": "Prospective pH 8-10, ammonia in substantial excess, sulfite 10-100 mM, and ferrocyanide 0.1-1 mM. Exclude added cyanide during imine formation and screen short irradiation periods."}, "mechanism": "Ammonia forms an imine or iminium species with the aldehyde; reduction gives the amino nitrile. Water from condensation cancels water used in the formal sulfite oxidation half-reaction.", "reasoning": "Speculative; the supplied Patel et al. (2015) research does not establish this reductive amination. It offers a surface alternative to hydrothermal nitrile hydrogenation, not a proven selectivity improvement. Reduction of the carbonyl to an alcohol, reduction of the remaining nitrile, and cyclization of the amino-nitrile product may dominate. Productive imine reduction and subsequent guanidination require direct testing."}, {"id": "rxn_017", "name": "Proposed reductive alkylation of guanidine with the cyanoaldehyde", "inputs": ["mol_024", "mol_013", "mol_007"], "outputs": ["mol_023", "mol_008"], "environment": "Surface", "agents": ["Ferrocyanide photoredox mediator", "Ultraviolet light"], "conditions": {"temperature": "300-335 K", "pressure": "Approximately 1 bar", "catalyst": "Ferrocyanide", "aqueous": true, "other": "Prospective pH 9.5-11, guanidine in excess, sulfite 10-100 mM, and ferrocyanide 0.1-1 mM. Determine whether any condensable guanidine fraction exists before applying photoreduction."}, "mechanism": "Hypothesized condensation of an unprotonated guanidine nitrogen with the aldehyde followed by reduction of the resulting C=N linkage.", "reasoning": "Speculative and the least-supported scaffold-entry branch; no supporting substrate experiment is supplied by Patel et al. (2015). Its chemical purpose is to bypass both the aminoaldehyde problem and cyclization of free 4-aminobutanenitrile. Strong guanidine protonation, weak condensation, and competing carbonyl reduction may make it ineffective. Inclusion denotes a falsifiable alternative, not evidence that reductive guanidine alkylation works prebiotically."}, {"id": "rxn_018", "name": "Proposed partial reduction of the guanidino butanenitrile", "inputs": ["mol_023", "mol_007", "mol_006"], "outputs": ["mol_020", "mol_003", "mol_008"], "environment": "Surface", "agents": ["Ferrocyanide photoredox mediator", "Ultraviolet light"], "conditions": {"temperature": "300-315 K", "pressure": "Approximately 1 bar", "catalyst": "Ferrocyanide", "aqueous": true, "other": "Prospective pH 7-9, substrate 1-10 mM, sulfite 10-100 mM, ferrocyanide 0.1-1 mM, and 1-24 hour irradiation screen. Stop irradiation before attempting Strecker capture."}, "mechanism": "Two-electron nitrile reduction followed by imine hydrolysis gives 4-guanidinobutanal, ammonia, and sulfate; two waters are consumed.", "reasoning": "Speculative substrate-specific application of the photoredox class discussed by Patel et al. (2015) and Xu et al. (2018). This branch avoids the two thioamide bottlenecks but introduces a different selective nitrile-reduction requirement. Guanidine survival, aldehyde overreduction, and possible seven-membered cyclic-hemiaminal formation must be measured. A persistent, freely available aldehyde is not assumed."}, {"id": "rxn_019", "name": "Strecker formation of arginine aminonitrile", "inputs": ["mol_020", "mol_003", "mol_002"], "outputs": ["mol_025", "mol_006"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-325 K", "pressure": "Approximately 1 bar", "catalyst": null, "aqueous": true, "other": "Prospective pH 8-9, aldehyde 1-10 mM, total cyanide 10-100 mM, and ammonia in excess; shaded reaction interval of hours to days. Redox mediators and sulfide carryover must be assessed."}, "mechanism": "Reversible aldehyde-ammonia condensation forms an imine or iminium species, followed by cyanide addition to produce the alpha-aminonitrile.", "reasoning": "The supplied Patel et al. (2015) review places an aminonitrile immediately before arginine. This mechanism corrects its description of ammonia simply displacing an unactivated hydroxyl group: cyanohydrin and aminonitrile products can communicate through aldehyde/imine equilibria. The reaction class is established, but this substrate's yield and accessible aldehyde fraction are not. Achiral reagents provide no basis for an L-only product."}, {"id": "rxn_020", "name": "Acid-promoted hydration of arginine aminonitrile", "inputs": ["mol_025", "mol_006"], "outputs": ["mol_026"], "environment": "Surface", "agents": ["Hydronium ions"], "conditions": {"temperature": "350-370 K", "pressure": "Approximately 1 bar", "catalyst": "General acid catalysis", "aqueous": true, "other": "Prospective pH 0-1 in a concentrated acidic geothermal pool; screen 1-30 days. Such acidity is an environmental requirement to establish, not a consequence of the Surface label. Assess cyanide and iron-cyanide carryover before acidification."}, "mechanism": "Nitrile protonation and water addition produce an imidic intermediate that tautomerizes to argininamide.", "reasoning": "The supplied Patel et al. (2015) review invokes nitrile hydrolysis but gives no numerical conditions or intermediate yields. Separating hydration from amide cleavage exposes a possible kinetic bottleneck. The proposed acidic window is not a literature-derived arginine result; slower natural conditions may be inadequate, and decomposition can compete with hydration."}, {"id": "rxn_021", "name": "Acid-promoted hydrolysis of argininamide to arginine", "inputs": ["mol_026", "mol_006"], "outputs": ["mol_027", "mol_003"], "environment": "Surface", "agents": ["Hydronium ions"], "conditions": {"temperature": "360-370 K", "pressure": "Approximately 1 bar", "catalyst": "General acid catalysis", "aqueous": true, "other": "Prospective pH 0-1 and 1-30 day screening period. Measure both amide disappearance and intact arginine formation; cool the product-containing solution after reaction."}, "mechanism": "Acid-catalyzed water addition to the amide carbonyl followed by C-N cleavage gives the amino acid and ammonia, present mainly as ammonium under these conditions.", "reasoning": "This completes the conventional hydrolysis sequence invoked in the supplied Patel et al. (2015) review. The reaction family is credible, but complete selective conversion in an actual prebiotic pool is not established by that citation. Strong-acid availability, residence time, guanidino-group preservation, and cumulative losses remain necessary tests. The product is stereochemically unspecified arginine."}, {"id": "rxn_022", "name": "Bucherer-Bergs-type trapping of arginine aminonitrile as a hydantoin", "inputs": ["mol_025", "mol_010"], "outputs": ["mol_028"], "environment": "Surface", "agents": null, "conditions": {"temperature": "320-350 K", "pressure": "Approximately 1 bar; prospective CO2 partial pressure 0.01-0.1 bar", "catalyst": null, "aqueous": true, "other": "Prospective ammonium-carbonate-containing solution at pH 8-9.5; screen 1-7 days. Determine carbonate speciation and competition between alpha-amino and guanidino interactions with CO2."}, "mechanism": "CO2 capture by the alpha-amino group, cyclization involving the nitrile, and rearrangement give the hydantoin. The net transformation incorporates one CO2 without net water consumption.", "reasoning": "Speculative substrate-specific extension of Bucherer-Bergs chemistry; this branch is not demonstrated in the supplied Patel et al. (2015) material. It is a genuinely different endgame from direct nitrile hydration, not an alternative stoichiometric rendering of the same step. Guanidinium-carbonate association, competing nitrogen-site chemistry, and hydantoin yield are unresolved."}, {"id": "rxn_023", "name": "Warm alkaline opening of arginine hydantoin", "inputs": ["mol_028", "mol_006"], "outputs": ["mol_029"], "environment": "Hydrothermal", "agents": ["Hydroxide-bearing alkaline geothermal water"], "conditions": {"temperature": "420-450 K", "pressure": "20-100 bar", "catalyst": "Base-promoted hydrolysis", "aqueous": true, "other": "Prospective pH 10-11 and residence times of 1-30 days in recirculating geothermal pores. Requires infiltration of a concentrated surface product and retention against dilution; neither transport efficiency nor lifetime is known."}, "mechanism": "Hydroxide-assisted attack at the hydantoin carbonyl opens the ring to an N-carbamoyl amino acid.", "reasoning": "Speculative for this guanidino hydantoin and this geochemical window; no supporting experiment is supplied by Patel et al. (2015). Warmer pressurized water addresses the known kinetic difficulty of hydantoin hydrolysis, but does not establish adequate rates at pH 10-11. Adsorption, dilution, and thermal destruction must be included in any feasibility assessment."}, {"id": "rxn_024", "name": "Hydrolytic decarbamoylation to arginine", "inputs": ["mol_029", "mol_006"], "outputs": ["mol_027", "mol_003", "mol_010"], "environment": "Hydrothermal", "agents": ["Hydroxide-bearing alkaline geothermal water"], "conditions": {"temperature": "420-450 K", "pressure": "20-100 bar", "catalyst": "Base-promoted hydrolysis", "aqueous": true, "other": "Prospective pH 10-11 and 1-30 day screening interval, followed by cooling. Compare selective alpha-decarbamoylation with guanidino-group degradation and amino-acid destruction."}, "mechanism": "Hydrolysis of the alpha-ureido group releases arginine, ammonia, and inorganic carbon, represented by CO2 in the net equation.", "reasoning": "Speculative and a major endpoint bottleneck. Neither the supplied Patel et al. (2015) material nor the existence of a hydantoin intermediate establishes selective nonenzymatic decarbamoylation here. Stronger laboratory conditions might be needed than the proposed geothermal window can supply. Productive arginine accumulation cannot be claimed unless this reaction outruns side-chain hydrolysis and thermal degradation."}], "pathways": [{"pathway_id": "P1", "name": "Early aminonitrile guanidination with direct amino-acid hydrolysis", "description": "Review-inspired scaffold construction followed by Strecker chemistry and stepwise aminonitrile hydrolysis. Conditional on selective rxn_006, rxn_010, and rxn_011; the latter two remain unvalidated decisive bottlenecks.", "reaction_sequence": ["rxn_001", "rxn_002", "rxn_003", "rxn_006", "rxn_007", "rxn_008", "rxn_009", "rxn_010", "rxn_011", "rxn_019", "rxn_020", "rxn_021"], "key_intermediates": ["mol_014", "mol_018", "mol_019", "mol_020", "mol_025", "mol_026"]}, {"pathway_id": "P2", "name": "Early aminonitrile guanidination with hydantoin capture", "description": "Uses the P1 scaffold branch but diverts the final aminonitrile through a hydantoin. It does not solve the scaffold-reduct