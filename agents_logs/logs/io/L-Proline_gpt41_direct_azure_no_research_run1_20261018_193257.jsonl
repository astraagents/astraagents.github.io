ressure": "high", "catalyst": "FeS", "aqueous": true, "other": "CO2 present at low activity"}, "mechanism": "Glycine reacts with formaldehyde in an FeS-catalyzed reductive amination to yield alanine and water.", "reasoning": "Homologation reactions are seen with Fe/Ni minerals in hydrothermal vents (Muchowska, 2017; Preiner, 2020)."}, {"id": "rxn_003", "name": "Aminopropionaldehyde formation by reduction of alanine", "inputs": ["mol_009", "mol_002"], "outputs": ["mol_013", "mol_001"], "environment": "Hydrothermal", "agents": ["NiS"], "conditions": {"temperature": "400-450K", "pressure": "high", "catalyst": "NiS", "aqueous": true, "other": "Partial hydrogen pressure"}, "mechanism": "Reductive decarboxylation of alanine yields 3-aminopropanal and water.", "reasoning": "Metal-catalyzed decarboxylation and hydrogenation are supported in vent environments (Huber & W\u00e4chtersh\u00e4user, 1997)."}, {"id": "rxn_004", "name": "Cyclization of 3-aminopropanal to pyrroline intermediate", "inputs": ["mol_013"], "outputs": ["mol_017"], "environment": "Biochemical", "agents": ["null"], "conditions": {"temperature": "300-320K", "pressure": "1 atm", "catalyst": "null", "aqueous": false, "other": "mildly acidic surface"}, "mechanism": "Intramolecular condensation of 3-aminopropanal forms \u03941-pyrroline-2-carboxylic acid.", "reasoning": "This cyclization step is established in non-enzymatic settings (Peltzer et al., 1984)."}, {"id": "rxn_005", "name": "Reduction of pyrroline-2-carboxylic acid to L-proline", "inputs": ["mol_017", "mol_002"], "outputs": ["mol_012"], "environment": "Hydrothermal", "agents": ["FeS/pyrite film"], "conditions": {"temperature": "350-400K", "pressure": "high", "catalyst": "FeS/pyrite", "aqueous": true, "other": "reducing setting"}, "mechanism": "Hydrogenation at the imine double bond produces L-proline.", "reasoning": "Non-enzymatic reduction with transition metals is strongly substantiated (Varadarajan et al., 2022)."}, {"id": "rxn_006", "name": "Strecker synthesis of \u03b3-aminobutyric acid", "inputs": ["mol_015", "mol_006", "mol_004", "mol_001"], "outputs": ["mol_010", "mol_001"], "environment": "Surface", "agents": ["montmorillonite clay"], "conditions": {"temperature": "320-350K", "pressure": "1 atm", "catalyst": "montmorillonite", "aqueous": true, "other": "wet-dry cycles"}, "mechanism": "Propanal, HCN and NH3 react via Strecker to give \u03b3-aminobutyraldehyde, hydrolyzed to \u03b3-aminobutyric acid; water produced.", "reasoning": "Supported by surface-catalyzed Strecker chemistry (Chyba & Sagan, 1992; Saladino et al., 2012)."}, {"id": "rxn_007", "name": "Dehydration to aminocrotonic acid", "inputs": ["mol_010"], "outputs": ["mol_011", "mol_001"], "environment": "Surface", "agents": ["montmorillonite clay"], "conditions": {"temperature": "330-360K", "pressure": "1 atm", "catalyst": "montmorillonite", "aqueous": false, "other": "dry down in shallow pools"}, "mechanism": "Surface-catalyzed elimination of water produces aminocrotonic acid from \u03b3-aminobutyric acid.", "reasoning": "Surface-facilitated dehydration is common in wet-dry cycles (Lambert, 2008)."}, {"id": "rxn_008", "name": "Cyclization to proline (via aminocrotonic acid)", "inputs": ["mol_011"], "outputs": ["mol_012"], "environment": "Biochemical", "agents": ["null"], "conditions": {"temperature": "310-340K", "pressure": "1 atm", "catalyst": "null", "aqueous": false, "other": "dry surface phase"}, "mechanism": "The aminocrotonic acid cyclizes directly to proline under mild heating, no catalyst.", "reasoning": "This spontaneous cyclization has precedent (Meierhenrich et al., 2005; Saladino et al., 2012)."}, {"id": "rxn_009", "name": "Glycine chain elongation via acrolein condensation", "inputs": ["mol_008", "mol_016"], "outputs": ["mol_010", "mol_003"], "environment": "Surface", "agents": ["borate minerals"], "conditions": {"temperature": "320-350K", "pressure": "1 atm", "catalyst": "borate minerals", "aqueous": true, "other": "wet-dry cycling