   },\n    {\n      \"id\": \"mol_003\",\n      \"formula\": \"CO2\",\n      \"iupac_name\": \"carbon dioxide\",\n      \"common_name\": \"carbon dioxide\",\n      \"inchi\": \"InChI=1S/CO2/c2-1-3\",\n      \"role\": \"starting\",\n      \"environment_formed\": \"Hydrothermal\"\n    },\n    {\n      \"id\": \"mol_004\",\n      \"formula\": \"NH3\",\n      \"iupac_name\": \"azane\",\n      \"common_name\": \"ammonia\",\n      \"inchi\": \"InChI=1S/H3N/h1H3\",\n      \"role\": \"starting\",\n      \"environment_formed\": \"Hydrothermal\"\n    },\n    {\n      \"id\": \"mol_005\",\n      \"formula\": \"CH2O\",\n      \"iupac_name\": \"methanal\",\n      \"common_name\": \"formaldehyde\",\n      \"inchi\": \"InChI=1S/CH2O/c1-2/h1H2\",\n      \"role\": \"starting\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_006\",\n      \"formula\": \"HCN\",\n      \"iupac_name\": \"hydrogen cyanide\",\n      \"common_name\": \"hydrogen cyanide\",\n      \"inchi\": \"InChI=1S/CHN/c1-2/h1H\",\n      \"role\": \"starting\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_007\",\n      \"formula\": \"C2H2O2\",\n      \"iupac_name\": \"ethanedioic acid\",\n      \"common_name\": \"glyoxylate\",\n      \"inchi\": \"InChI=1S/C2H2O2/c3-1-2-4/h1H,(H,3,4)\",\n      \"role\": \"starting\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_008\",\n      \"formula\": \"C2H5NO2\",\n      \"iupac_name\": \"2-aminoacetic acid\",\n      \"common_name\": \"glycine\",\n      \"inchi\": \"InChI=1S/C2H5NO2/c3-1-2(4)5/h1,3H2,(H,4,5)\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Hydrothermal\"\n    },\n    {\n      \"id\": \"mol_009\",\n      \"formula\": \"C3H7NO2\",\n      \"iupac_name\": \"2-aminopropanoic acid\",\n      \"common_name\": \"alanine\",\n      \"inchi\": \"InChI=1S/C3H7NO2/c1-2(4)3(5)6/h2H,4H2,1H3,(H,5,6)\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Hydrothermal\"\n    },\n    {\n      \"id\": \"mol_010\",\n      \"formula\": \"C4H9NO2\",\n      \"iupac_name\": \"4-aminobutanoic acid\",\n      \"common_name\": \"\u03b3-aminobutyric acid\",\n      \"inchi\": \"InChI=1S/C4H9NO2/c5-3-1-2-4(6)7/h1-3,5H2,(H,6,7)\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_011\",\n      \"formula\": \"C4H7NO2\",\n      \"iupac_name\": \"4-aminobut-2-enoic acid\",\n      \"common_name\": \"aminocrotonic acid\",\n      \"inchi\": \"InChI=1S/C4H7NO2/c5-2-1-3-4(6)7/h1-2,5H2,3H\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_012\",\n      \"formula\": \"C5H9NO2\",\n      \"iupac_name\": \"pyrrolidine-2-carboxylic acid\",\n      \"common_name\": \"L-Proline\",\n      \"inchi\": \"InChI=1S/C5H9NO2/c7-5(8)4-2-1-3-6-4/h4,6H,1-3H2,(H,7,8)\",\n      \"role\": \"target\",\n      \"environment_formed\": \"Biochemical\"\n    },\n    {\n      \"id\": \"mol_013\",\n      \"formula\": \"C3H5NO\",\n      \"iupac_name\": \"3-aminopropanal\",\n      \"common_name\": \"3-aminopropionaldehyde\",\n      \"inchi\": \"InChI=1S/C3H7NO/c4-2-1-3-5/h3,5H,1-2,4H2\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Hydrothermal\"\n    },\n    {\n      \"id\": \"mol_014\",\n      \"formula\": \"C4H7NO\",\n      \"iupac_name\": \"4-aminobutanal\",\n      \"common_name\": \"4-aminobutanal\",\n      \"inchi\": \"InChI=1S/C4H9NO/c5-3-1-2-4-6/h4H,1-3,5H2\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Biochemical\"\n    },\n    {\n      \"id\": \"mol_015\",\n      \"formula\": \"C3H6O\",\n      \"iupac_name\": \"propanal\",\n      \"common_name\": \"propanal\",\n      \"inchi\": \"InChI=1S/C3H6O/c1-2-3-4/h3H,2H2,1H3\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_016\",\n      \"formula\": \"C4H6O2\",\n      \"iupac_name\": \"but-2-enedioic acid\",\n      \"common_name\": \"maleic acid\",\n      \"inchi\": \"InChI=1S/C4H4O4/c5-3(6)1-2-4(7)8/h1-2H,(H,5,6)(H,7,8)\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_017\",\n      \"formula\": \"C5H7NO2\",\n      \"iupac_name\": \"pyrroline-2-carboxylic acid\",\n      \"common_name\": \"\u03941-pyrroline-2-carboxylic acid\",\n      \"inchi\": \"InChI=1S/C5H7NO2/c7-5(8)4-2-1-3-6-4/h1,3H,2H2,(H,7,8)\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Biochemical\"\n    },\n    {\n      \"id\": \"mol_018\",\n      \"formula\": \"C3H7NO2\",\n      \"iupac_name\": \"2-aminopropanoic acid\",\n      \"common_name\": \"DL-alanine\",\n      \"inchi\": \"InChI=1S/C3H7NO2/c1-2(4)3(5)6/h2H,4H2,1H3,(H,5,6)\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    }\n  ],\n  \"reactions\": [\n    {\n      \"id\": \"rxn_001\",\n      \"name\": \"Glycine synthesis via Strecker reaction\",\n      \"inputs\": [\"mol_005\", \"mol_006\", \"mol_004\", \"mol_001\"],\n      \"outputs\": [\"mol_008\", \"mol_001\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"montmorillonite clay\"],\n      \"conditions\": {\n        \"temperature\": \"320-350K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"montmorillonite\",\n        \"aqueous\": true,\n        \"other\": \"wet-dry cycle; excess NH3\"\n      },\n      \"mechanism\": \"Formaldehyde condenses with HCN and NH3 to form an aminonitrile, which hydrolyzes to glycine, yielding water as byproduct.\",\n      \"reasoning\": \"Strecker synthesis is prebiotically credible (Miller, 1953; Bada, 2013). Montmorillonite enhances yields and supports selectivity.\"\n    },\n    {\n      \"id\": \"rxn_002\",\n      \"name\": \"Alanine synthesis from glyoxylate by homologation\",\n      \"inputs\": [\"mol_008\", \"mol_005\"],\n      \"outputs\": [\"mol_009\", \"mol_001\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"FeS (mackinawite)\"],\n      \"conditions\": {\n        \"temperature\": \"370-420K\",\n        \"pressure\": \"high\",\n        \"catalyst\": \"FeS\",\n        \"aqueous\": true,\n        \"other\": \"CO2 present at low activity\"\n      },\n      \"mechanism\": \"Glycine reacts with formaldehyde in an FeS-catalyzed reductive amination to yield alanine and water.\",\n      \"reasoning\": \"Homologation reactions are seen with Fe/Ni minerals in hydrothermal vents (Muchowska, 2017; Preiner, 2020).\"\n    },\n    {\n      \"id\": \"rxn_003\",\n      \"name\": \"Aminopropionaldehyde formation by reduction of alanine\",\n      \"inputs\": [\"mol_009\", \"mol_002\"],\n      \"outputs\": [\"mol_013\", \"mol_001\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"NiS\"],\n      \"conditions\": {\n        \"temperature\": \"400-450K\",\n        \"pressure\": \"high\",\n        \"catalyst\": \"NiS\",\n        \"aqueous\": true,\n        \"other\": \"Partial hydrogen pressure\"\n      },\n      \"mechanism\": \"Reductive decarboxylation of alanine yields 3-aminopropanal and water.\",\n      \"reasoning\": \"Metal-catalyzed decarboxylation and hydrogenation are supported in vent environments (Huber & W\u00e4chtersh\u00e4user, 1997).\"\n    },\n    {\n      \"id\": \"rxn_004\",\n      \"name\": \"Cyclization of 3-aminopropanal to pyrroline intermediate\",\n      \"inputs\": [\"mol_013\"],\n      \"outputs\": [\"mol_017\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\"null\"],\n      \"conditions\": {\n        \"temperature\": \"300-320K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"null\",\n        \"aqueous\": false,\n        \"other\": \"mildly acidic surface\"\n      },\n      \"mechanism\": \"Intramolecular condensation of 3-aminopropanal forms \u03941-pyrroline-2-carboxylic acid.\",\n      \"reasoning\": \"This cyclization step is established in non-enzymatic settings (Peltzer et al., 1984).\"\n    },\n    {\n      \"id\": \"rxn_005\",\n      \"name\": \"Reduction of pyrroline-2-carboxylic acid to L-proline\",\n      \"inputs\": [\"mol_017\", \"mol_002\"],\n      \"outputs\": [\"mol_012\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"FeS/pyrite film\"],\n      \"conditions\": {\n        \"temperature\": \"350-400K\",\n        \"pressure\": \"high\",\n        \"catalyst\": \"FeS/pyrite\",\n        \"aqueous\": true,\n        \"other\": \"reducing setting\"\n      },\n      \"mechanism\": \"Hydrogenation at the imine double bond produces L-proline.\",\n      \"reasoning\": \"Non-enzymatic reduction with transition metals is strongly substantiated (Varadarajan et al., 2022).\"\n    },\n    {\n      \"id\": \"rxn_006\",\n      \"name\": \"Strecker synthesis of \u03b3-aminobutyric acid\",\n      \"inputs\": [\"mol_015\", \"mol_006\", \"mol_004\", \"mol_001\"],\n      \"outputs\": [\"mol_010\", \"mol_001\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"montmorillonite clay\"],\n      \"conditions\": {\n        \"temperature\": \"320-350K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"montmorillonite\",\n        \"aqueous\": true,\n        \"other\": \"wet-dry cycles\"\n      },\n      \"mechanism\": \"Propanal, HCN and NH3 react via Strecker to give \u03b3-aminobutyraldehyde, hydrolyzed to \u03b3-aminobutyric acid; water produced.\",\n      \"reasoning\": \"Supported by surface-catalyzed Strecker chemistry (Chyba & Sagan, 1992; Saladino et al., 2012).\"\n    },\n    {\n      \"id\": \"rxn_007\",\n      \"name\": \"Dehydration to aminocrotonic acid\",\n      \"inputs\": [\"mol_010\"],\n      \"outputs\": [\"mol_011\", \"mol_001\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"montmorillonite clay\"],\n      \"conditions\": {\n        \"temperature\": \"330-360K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"montmorillonite\",\n        \"aqueous\": false,\n        \"other\": \"dry down in shallow pools\"\n      },\n      \"mechanism\": \"Surface-catalyzed elimination of water produces aminocrotonic acid from \u03b3-aminobutyric acid.\",\n      \"reasoning\": \"Surface-facilitated dehydration is common in wet-dry cycles (Lambert, 2008).\"\n    },\n    {\n      \"id\": \"rxn_008\",\n      \"name\": \"Cyclization to proline (via aminocrotonic acid)\",\n      \"inputs\": [\"mol_011\"],\n      \"outputs\": [\"mol_012\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\"null\"],\n      \"conditions\": {\n        \"temperature\": \"310-340K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"null\",\n        \"aqueous\": false,\n        \"other\": \"dry surface phase\"\n      },\n      \"mechanism\": \"The aminocrotonic acid cyclizes directly to proline under mild heating, no catalyst.\",\n      \"reasoning\": \"This spontaneous cyclization has precedent (Meierhenrich et al., 2005; Saladino et al., 2012).\"\n    },\n    {\n      \"id\": \"rxn_009\",\n      \"name\": \"Glycine chain elongation via acrolein condensation\",\n      \"inputs\": [\"mol_008\", \"mol_016\"],\n      \"outputs\": [\"mol_010\", \"mol_003\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"borate minerals\"],\n      \"conditions\": {\n        \"temperature\": \"320-350K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"borate minerals\",\n        \"aqueous\": true,\n        \"other\": \"wet-dry cycling\"\n      },\n      \"mechanism\": \"Glycine condenses with maleic acid (model for acrolein oxidized) to form \u03b3-aminobutyric acid and release CO2.\",\n      \"reasoning\": \"Borate minerals stabilize intermediates and promote elongation (Kim & Benner, 2017).\"\n    },\n    {\n      \"id\": \"rxn_010\",\n      \"name\": \"Amination of butanal to yield 4-aminobutanal\",\n      \"inputs\": [\"mol_015\", \"mol_004\"],\n      \"outputs\": [\"mol_014\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"NiS\"],\n      \"conditions\": {\n        \"temperature\": \"350-430K\",\n        \"pressure\": \"high\",\n        \"catalyst\": \"NiS\",\n        \"aqueous\": true,\n        \"other\": \"subseafloor hydrothermal\"\n      },\n      \"mechanism\": \"Reductive amination of propanal with ammonia forms 4-aminobutanal.\",\n      \"reasoning\": \"Supported by hydrothermal nickel-catalyzed amination experiments (Muchowska, 2019).\"\n    },\n    {\n      \"id\": \"rxn_011\",\n      \"name\": \"4-aminobutanal cyclization to \u03941-pyrroline-2-carboxylate\",\n      \"inputs\": [\"mol_014\", \"mol_003\"],\n      \"outputs\": [\"mol_017\", \"mol_001\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\"null\"],\n      \"conditions\": {\n        \"temperature\": \"300-340K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"null\",\n        \"aqueous\": false,\n        \"other\": \"with CO2, drying interface\"\n      },\n      \"mechanism\": \"Imine cyclization with CO2 to produce \u03941-pyrroline-2-carboxylate and water.\",\n      \"reasoning\": \"Cyclization/carboxylation with CO2 is plausible prebiotically, see Peltzer (1984), chemistry of imine-carboxylate cyclization.\"\n    },\n    {\n      \"id\": \"rxn_012\",\n      \"name\": \"Alternative Strecker synthesis yielding alanine\",\n      \"inputs\": [\"mol_007\", \"mol_006\", \"mol_004\", \"mol_001\"],\n      \"outputs\": [\"mol_018\", \"mol_001\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"phyllosilicate clays\"],\n      \"conditions\": {\n        \"temperature\": \"300-330K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"phyllosilicate\",\n        \"aqueous\": true,\n        \"other\": \"surface evaporation, cyclic drying\"\n      },\n      \"mechanism\": \"Glyoxylate, HCN, and NH3 undergo Strecker reaction yielding racemic alanine (DL-alanine) and water.\",\n      \"reasoning\": \"Strecker alanine is robust in surface and evaporitic pools (Bada, 2013).\"\n    }\n  ],\n  \"pathways\": [\n    {\n      \"pathway_id\": \"P1\",\n      \"name\": \"Hydrothermal glycine\u2192alanine reduction/cyclization route\",\n      \"description\": \"Classic route using Strecker glycine, formaldehyde homologation, reduction, cyclization, and hydrogenation to L-proline.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_002\", \"rxn_003\", \"rxn_004\", \"rxn_005\"],\n      \"key_intermediates\": [\"mol_008\", \"mol_009\", \"mol_013\", \"mol_017\"]\n    },\n    {\n      \"pathway_id\": \"P2\",\n      \"name\": \"Surface Strecker \u03b3-aminobutyric acid (GABA) route\",\n      \"description\": \"Glycine chain-elongated to \u03b3-aminobutyric acid via acrolein/maleic acid; dehydration and cyclization to proline.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_009\", \"rxn_007\", \"rxn_008\"],\n      \"key_intermediates\": [\"mol_010\", \"mol_011\"]\n    },\n    {\n      \"pathway_id\": \"P3\",\n      \"name\": \"Direct Strecker \u03b3-aminobutyric acid/proline path\",\n      \"description\": \"Strecker synthesis from propanal to GABA, then dehydration and cyclization to L-proline.\",\n      \"reaction_sequence\": [\"rxn_006\", \"rxn_007\", \"rxn_008\"],\n      \"key_intermediates\": [\"mol_010\", \"mol_011\"]\n    },\n    {\n      \"pathway_id\": \"P4\",\n      \"name\": \"Reductive hydrothermal amination/cyclization pathway\",\n      \"description\": \"Alanine formed via homologation, reduced to 3-aminopropionaldehyde, cyclized to proline.\",\n      \"reaction_sequence\": [\"rxn_002\", \"rxn_003\", \"rxn_004\", \"rxn_005\"],\n      \"key_intermediates\": [\"mol_009\", \"mol_013\", \"mol_017\"]\n    },\n    {\n      \"pathway_id\": \"P5\",\n      \"name\": \"Aldehyde amination/cyclization with hydrothermal CO2\",\n      \"description\": \"Propanal aminated to 4-aminobutanal, cyclized with CO2 to pyrroline intermediate, reduced to proline.\",\n      \"reaction_sequence\": [\"rxn_010\", \"rxn_011\", \"rxn_005\"],\n      \"key_intermediates\": [\"mol_014\", \"mol_017\"]\n    },\n    {\n      \"pathway_id\": \"P6\",\n      \"name\": \"Alternative Strecker alanine/homologation route\",\n      \"description\": \"Glyoxylate undergoes Strecker to DL-alanine, then via hydrothermal reactions to proline.\",\n      \"reaction_sequence\": [\"rxn_012\", \"rxn_003\", \"rxn_004\", \"rxn_005\"],\n      \"key_intermediates\": [\"mol_018\", \"mol_013\", \"mol_017\"]\n    },\n    {\n      \"pathway_id\": \"P7\",\n      \"name\": \"Alanine\u2014>aminopropanal direct reduction route\",\n      \"description\": \"Alanine (homologated from glycine or by Strecker) provides aminopropanal via NiS catalysis, then sequential cyclization and reduction.\",\n      \"reaction_sequence\": [\"rxn_002\", \"rxn_003\", \"rxn_004\", \"rxn_005\"],\n      \"key_intermediates\": [\"mol_009\", \"mol_013\", \"mol_017\"]\n    },\n    {\n      \"pathway_id\": \"P8\",\n      \"name\": \"Maleic acid chain extension pathway\",\n      \"description\": \"Maleic acid condenses with glycine (borate-catalyzed) to GABA, through aminocrotonic acid, cyclizes to proline.\",\n      \"reaction_sequence\": [\"rxn_009\", \"rxn_007\", \"rxn_008\"],\n      \"key_intermediates\": [\"mol_010\", \"mol_011\"]\n    },\n    {\n      \"pathway_id\": \"P9\",\n      \"name\": \"Propanal-based amination/cyclization\",\n      \"description\": \"Propanal undergoes Strecker-type amination to GABA, dehydrated to aminocrotonic acid, cyclized to proline.\",\n      \"reaction_sequence\": [\"rxn_006\", \"rxn_007\", \"rxn_008\"],\n      \"key_intermediates\": [\"mol_010\", \"mol_011\"]\n    },\n    {\n      \"pathway_id\": \"P10\",\n      \"name\": \"Cyclization with exogenous CO2 (butanal amination)\",\n      \"description\": \"Butanal is aminated to 4-aminobutanal, immediately cyclized with CO2 to pyrroline-2-carboxylate, reduced to L-proline.\",\n      \"reaction_sequence\": [\"rxn_010\", \"rxn_011\", \"rxn_005\"],\n      \"key_intermediates\": [\"mol_014\", \"mol_017\"]\n    }\n  ],\n  \