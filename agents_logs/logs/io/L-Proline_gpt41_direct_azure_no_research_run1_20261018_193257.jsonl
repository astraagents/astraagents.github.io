re": "300-320K", "pressure": "1 atm", "catalyst": null, "aqueous": true, "other": null}, "mechanism": "Direct cyclization (lactam formation) of aminoaldehydes to five-membered ring.", "reasoning": "Aldehyde-amino cyclization to pyrrolidone rings is established under mild aqueous conditions (Weber & Pizzarello, 2006); requires prior aminoaldehyde formation."}, {"id": "rxn_013", "name": "Oxidation of 4-aminobutanol to GABA", "inputs": ["mol_009", "mol_012"], "outputs": ["mol_007", "mol_015"], "environment": "Surface", "agents": ["hematite"], "conditions": {"temperature": "320-350K", "pressure": "1 atm", "catalyst": "hematite", "aqueous": true, "other": null}, "mechanism": "Oxidation of aminoalcohol or aldehyde yields GABA.", "reasoning": "In the presence of hematite and water, robust C=O oxidation is plausible (Abelson, 1966; Sutherland, 2016)."}, {"id": "rxn_014", "name": "Homo-Strecker homologation (GABA from glycine via C2 extension)", "inputs": ["mol_004", "mol_001", "mol_003", "mol_002", "mol_015"], "outputs": ["mol_007"], "environment": "Surface", "agents": ["montmorillonite"], "conditions": {"temperature": "320-340K", "pressure": "1 atm", "catalyst": "montmorillonite", "aqueous": true, "other": "Wet-dry cycling"}, "mechanism": "Chain-elongated Strecker synthesis from glycine to GABA, via aminonitrile intermediate and hydrolysis.", "reasoning": "Extensions beyond the canonical amino acids have been explored in model prebiotic systems (Patel et al., 2015; Danger et al., 2013)."}, {"id": "rxn_015", "name": "Racemic proline generation via non-selective lactamization", "inputs": ["mol_007"], "outputs": ["mol_016", "mol_015"], "environment": "Surface", "agents": ["silica"], "conditions": {"temperature": "340-360K", "pressure": "1 atm", "catalyst": "silica", "aqueous": false, "other": "Evaporitic"}, "mechanism": "Dry cyclization yields both enantiomers (DL-proline) and water.", "reasoning": "Silica-catalyzed prebiotic cyclizations are known to be unselective; step pro