e\": \"hydantoin\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_012\",\n      \"formula\": \"C3H6N2O3\",\n      \"iupac_name\": \"2-(carbamoylamino)acetic acid\",\n      \"common_name\": \"N-carbamoylglycine\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_013\",\n      \"formula\": \"C2H2O3\",\n      \"iupac_name\": \"2-oxoacetic acid\",\n      \"common_name\": \"glyoxylic acid\",\n      \"inchi\": \"InChI=1S/C2H2O3/c3-1-2(4)5/h1H,(H,4,5)\",\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_014\",\n      \"formula\": \"C2H3NO2\",\n      \"iupac_name\": \"2-iminoacetic acid\",\n      \"common_name\": \"glycine imine\",\n      \"inchi\": null,\n      \"role\": \"hub_intermediate\",\n      \"environment_formed\": \"Biochemical\"\n    },\n    {\n      \"id\": \"mol_015\",\n      \"formula\": \"C2H5NO2\",\n      \"iupac_name\": \"2-aminoacetic acid\",\n      \"common_name\": \"glycine\",\n      \"inchi\": \"InChI=1S/C2H5NO2/c3-1-2(4)5/h1,3H2,(H,4,5)\",\n      \"role\": \"target\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_016\",\n      \"formula\": \"C2H4O3\",\n      \"iupac_name\": \"2-hydroxyacetic acid\",\n      \"common_name\": \"glycolic acid\",\n      \"inchi\": \"InChI=1S/C2H4O3/c3-1-2(4)5/h3H,1H2,(H,4,5)\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_017\",\n      \"formula\": \"NH3O\",\n      \"iupac_name\": \"hydroxylamine\",\n      \"common_name\": \"hydroxylamine\",\n      \"inchi\": \"InChI=1S/H3NO/c1-2/h2H,1H2\",\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_018\",\n      \"formula\": \"C2H3NO3\",\n      \"iupac_name\": \"2-(hydroxyimino)acetic acid\",\n      \"common_name\": \"glyoxylic acid oxime\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Biochemical\"\n    },\n    {\n      \"id\": \"mol_019\",\n      \"formula\": \"Fe\",\n      \"iupac_name\": \"iron\",\n      \"common_name\": \"native iron\",\n      \"inchi\": \"InChI=1S/Fe\",\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_020\",\n      \"formula\": \"Fe2+\",\n      \"iupac_name\": \"iron(2+)\",\n      \"common_name\": \"ferrous ion\",\n      \"inchi\": \"InChI=1S/Fe/q+2\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Biochemical\"\n    },\n    {\n      \"id\": \"mol_021\",\n      \"formula\": \"FeH2O2\",\n      \"iupac_name\": \"iron(II) hydroxide\",\n      \"common_name\": \"ferrous hydroxide endmember\",\n      \"inchi\": null,\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_022\",\n      \"formula\": \"FeHO2\",\n      \"iupac_name\": \"iron(III) oxide hydroxide\",\n      \"common_name\": \"ferric oxyhydroxide endmember\",\n      \"inchi\": null,\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_023\",\n      \"formula\": \"NO3-\",\n      \"iupac_name\": \"nitrate\",\n      \"common_name\": \"nitrate\",\n      \"inchi\": \"InChI=1S/NO3/c2-1(3)4/q-1\",\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_024\",\n      \"formula\": \"H+\",\n      \"iupac_name\": \"hydron\",\n      \"common_name\": \"proton\",\n      \"inchi\": \"InChI=1S/p+1\",\n      \"role\": \"starting\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_025\",\n      \"formula\": \"C4H7NO4\",\n      \"iupac_name\": \"2-[(carboxymethyl)amino]acetic acid\",\n      \"common_name\": \"iminodiacetic acid\",\n      \"inchi\": \"InChI=1S/C4H7NO4/c6-3(7)1-5-2-4(8)9/h5H,1-2H2,(H,6,7)(H,8,9)\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Biochemical\"\n    }\n  ],\n  \"reactions\": [\n    {\n      \"id\": \"rxn_001\",\n      \"name\": \"Reversible formaldehyde-ammonia condensation\",\n      \"inputs\": [\"mol_002\", \"mol_003\"],\n      \"outputs\": [\"mol_007\", \"mol_001\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-323 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Design window: pH 8-9; formaldehyde 1-100 mM and total ammonia 50-500 mM; hours to days with immediate downstream cyanide trapping. Use a covered or water-shaded pool with limited gas exchange. These concentrations and residence times are screening assumptions, not measured geological inventories.\"\n      },\n      \"mechanism\": \"Ammonia adds to formaldehyde; the resulting carbinolamine reversibly loses water to form methanimine.\",\n      \"reasoning\": \"This is the conventional condensation component of Strecker chemistry underlying reducing-atmosphere amino-acid experiments (Miller, 1953; Johnson et al., 2008). Methanimine need not accumulate or be isolated: hydration and hydrolysis compete strongly in water. Concentrated, retained ammonia and formaldehyde remain feedstock assumptions, not consequences of those experiments.\"\n    },\n    {\n      \"id\": \"rxn_002\",\n      \"name\": \"Cyanide trapping of methanimine\",\n      \"inputs\": [\"mol_007\", \"mol_004\"],\n      \"outputs\": [\"mol_009\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-323 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Design window: pH 8-9; total cyanide 10-100 mM; total ammonia comparable to or greater than total cyanide. Couple directly to rxn_001 without isolating methanimine; hours-to-days screening residence. HCN volatilization and hydroxy-nitrile formation must be measured.\"\n      },\n      \"mechanism\": \"Cyanide attacks the imine or iminium carbon, with proton transfer yielding aminoacetonitrile.\",\n      \"reasoning\": \"Aminonitrile formation is the chemically established core of the aqueous Strecker interpretation of Miller-type experiments (Miller, 1953; Johnson et al., 2008). No mineral catalyst is required. The amino-acid branch is not intrinsically exclusive: formaldehyde also enters rxn_003, and feedstock concentrations cannot be inferred from amino-acid detection alone.\"\n    },\n    {\n      \"id\": \"rxn_003\",\n      \"name\": \"Formaldehyde cyanohydrin formation\",\n      \"inputs\": [\"mol_002\", \"mol_004\"],\n      \"outputs\": [\"mol_008\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-323 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Design window: pH 7-9; formaldehyde and total cyanide each 10-100 mM; hours-to-days screening residence. Formation is reversible. Low ammonia favors storage as cyanohydrin rather than immediate aminonitrile formation.\"\n      },\n      \"mechanism\": \"Cyanide adds to the formaldehyde carbonyl, followed by proton transfer to form glycolonitrile.\",\n      \"reasoning\": \"Glycolonitrile is an experimentally grounded branch point in cyanide-derived precursor chemistry (Patel et al., 2015). This reaction requires neither UV photoredox catalysis nor sulfide because the formaldehyde is already supplied. It creates both a productive ammonia-exchange route and the competing glycolate route, rather than a guaranteed glycine precursor.\"\n    },\n    {\n      \"id\": \"rxn_004\",\n      \"name\": \"Ammonia-driven conversion of glycolonitrile to aminoacetonitrile\",\n      \"inputs\": [\"mol_008\", \"mol_003\"],\n      \"outputs\": [\"mol_009\", \"mol_001\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-323 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Design window: pH 8-9; glycolonitrile 10-100 mM; total ammonia 0.1-0.5 M; hours to days. Introduce ammonia before strong heating or acid hydrolysis. Required ammonia retention and transfer between precursor-rich and ammonia-rich waters are scenario assumptions.\"\n      },\n      \"mechanism\": \"Cyanohydrin-carbonyl equilibration, ammonia condensation and renewed cyanide trapping give net replacement of hydroxyl by amino functionality; direct displacement of free hydroxide is not assumed.\",\n      \"reasoning\": \"Ammonia conversion of glycolonitrile into the aminonitrile branch is supported by the cyanosulfidic precursor network (Patel et al., 2015). This node represents only the downstream exchange chemistry, not the upstream Cu/sulfide/UV homologation sequence. Cu is therefore not assigned as an unjustified catalyst, and this pathway is acknowledged to share Strecker equilibria with P1.\"\n    },\n    {\n      \"id\": \"rxn_005\",\n      \"name\": \"Aminoacetonitrile hydration to glycinamide\",\n      \"inputs\": [\"mol_009\", \"mol_001\"],\n      \"outputs\": [\"mol_010\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Hydronium supplied by an anoxic volcanic acid pool\"],\n      \"conditions\": {\n        \"temperature\": \"353-370 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": \"Specific acid catalysis by hydronium\",\n        \"aqueous\": true,\n        \"other\": \"Proposed hydrolysis window: pH 0-2 and 1-30 days. Transfer or acidify an aminonitrile-bearing fraction after precursor formation; do not assume coexistence with the alkaline synthesis stage. The supplied research does not establish a rate constant within this entire window.\"\n      },\n      \"mechanism\": \"Protonation and water addition to the nitrile, followed by tautomerization, produce glycinamide.\",\n      \"reasoning\": \"Nitrile-to-amide-to-amino-acid hydrolysis is the standard Strecker product-release sequence (Miller, 1953; Ruiz-Bermejo et al., 2013). The acid pool is an accelerator, not a required mineral catalyst. Environmental execution remains conditional because acid availability, transfer losses and hydrolysis kinetics must be established; rapid neutral-water hydrolysis is not assumed.\"\n    },\n    {\n      \"id\": \"rxn_006\",\n      \"name\": \"Glycinamide hydrolysis to glycine\",\n      \"inputs\": [\"mol_010\", \"mol_001\"],\n      \"outputs\": [\"mol_015\", \"mol_003\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Hydronium supplied by an anoxic volcanic acid pool\"],\n      \"conditions\": {\n        \"temperature\": \"353-370 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": \"Specific acid catalysis by hydronium\",\n        \"aqueous\": true,\n        \"other\": \"Proposed window: pH 0-2 and 1-30 days, with analytical monitoring rather than an assumed complete conversion. Ammonia is predominantly ammonium here. Cool and neutralize only if subsequent chemistry requires it; those operations are not additional synthesis reactions.\"\n      },\n      \"mechanism\": \"Water attacks the activated amide carbonyl; carbon-nitrogen bond cleavage releases glycine and the ammonia/ammonium pool.\",\n      \"reasoning\": \"This is the terminal hydrolysis of the established aminonitrile route (Miller, 1953; Ruiz-Bermejo et al., 2013). Amide hydrolysis can be the product-release bottleneck and must not be treated as instantaneous at ambient neutral pH. Nitrogen originally residing in the nitrile is released, whereas the amino nitrogen is retained in glycine.\"\n    },\n    {\n      \"id\": \"rxn_007\",\n      \"name\": \"Carbon dioxide trapping of aminoacetonitrile as hydantoin\",\n      \"inputs\": [\"mol_009\", \"mol_005\"],\n      \"outputs\": [\"mol_011\"],\n      \"environment\": \"Surface\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"300-323 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Provisional substrate-specific window: pH 8-9; dissolved inorganic carbon 10-100 mM; aminonitrile 1-100 mM; ammonia-rich solution; hours to days. Carbon dioxide denotes the inorganic-carbon pool. Retention of both inorganic carbon and cyanide-derived intermediates must be verified.\"\n      },\n      \"mechanism\": \"Aminonitrile carbamylation, cyclization through an imino heterocycle and rearrangement incorporate inorganic carbon into hydantoin.\",\n      \"reasoning\": \"Bucherer-Bergs chemistry supports aminonitrile-to-hydantoin conversion, and related prebiotic experiments support hydantoin-mediated amino-acid production (Pulletikurti et al., 2022; Ferris et al., 1974). However, the 2022 study emphasizes alpha-ketoacid substrates. Applying its mild formation conditions specifically to unsubstituted hydantoin from formaldehyde-derived aminoacetonitrile is a provisional extrapolation, not a demonstrated yield claim.\"\n    },\n    {\n      \"id\": \"rxn_008\",\n      \"name\": \"Hydantoin ring opening to N-carbamoylglycine\",\n      \"inputs\": [\"mol_011\", \"mol_001\"],\n      \"outputs\": [\"mol_012\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Hydronium in a separate acidic geothermal pool\"],\n      \"conditions\": {\n        \"temperature\": \"353-370 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": \"Specific acid catalysis by hydronium\",\n        \"aqueous\": true,\n        \"other\": \"Proposed window: pH 0-2; 1-30 days, extending only if measured survival and conversion justify it. Requires acidification or transfer from the carbonate-rich formation stage. Ring-opening kinetics for unsubstituted hydantoin under these exact conditions are unresolved.\"\n      },\n      \"mechanism\": \"Hydrolytic cleavage of the cyclic amide opens hydantoin to N-carbamoylglycine.\",\n      \"reasoning\": \"Hydantoin hydrolysis provides a recognized connection to amino acids (Ferris et al., 1974; Ruiz-Bermejo et al., 2013). The approximately 353 K hydrolysis discussed for other hydantoin systems cannot automatically establish the rate for this substrate (Pulletikurti et al., 2022). This is therefore an explicit kinetic bottleneck with provisional environmental operating conditions.\"\n    },\n    {\n      \"id\": \"rxn_009\",\n      \"name\": \"N-carbamoylglycine hydrolysis and carbon dioxide release\",\n      \"inputs\": [\"mol_012\", \"mol_001\"],\n      \"outputs\": [\"mol_015\", \"mol_003\", \"mol_005\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Hydronium in a separate acidic geothermal pool\"],\n      \"conditions\": {\n        \"temperature\": \"353-370 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": \"Specific acid catalysis by hydronium\",\n        \"aqueous\": true,\n        \"other\": \"Proposed window: pH 0-2 and 1-30 days. Monitor residual ureido compound, glycine and total ammonia. Carbon dioxide loss can favor net deprotection, but conversion and product survival cannot be assigned without substrate-specific kinetic measurements.\"\n      },\n      \"mechanism\": \"Hydrolysis of the carbamoyl group releases glycine; the remaining carbamic-acid equivalent decomposes to ammonia and carbon dioxide.\",\n      \"reasoning\": \"This represents the conventional terminal chemistry of hydantoin hydrolysis to glycine (Ferris et al., 1974; Ruiz-Bermejo et al., 2013). The split into ring opening and decarbamoylation makes the slow steps visible, rather than interpreting hydantoin formation as immediate amino-acid production. Exact prebiotic rates remain unsupported by the supplied substrate-specific evidence.\"\n    },\n    {\n      \"id\": \"rxn_010\",\n      \"name\": \"Moderate-temperature hydrothermal Strecker synthesis, lumped\",\n      \"inputs\": [\"mol_002\", \"mol_003\", \"mol_004\", \"mol_001\"],\n      \"outputs\": [\"mol_015\", \"mol_003\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"Pyrite-pyrrhotite-magnetite assemblage as a redox buffer, not a demonstrated reaction catalyst\"],\n      \"conditions\": {\n        \"temperature\": \"423 K\",\n        \"pressure\": \"10 bar experimental pressure\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Reported anchors: NH4Cl-containing solution, CO2/H2 gas mixture of 3:1, and 25-54 h residence. Initial reactant concentrations and pH are not securely specified in the supplied summary. Require a locally sulfide-bearing subseafloor pocket and subsequent cooling; do not extrapolate to prolonged residence above 473 K.\"\n      },\n      \"mechanism\": \"Lumped imine formation, cyanide addition and nitrile/amide hydrolysis. Ammonia appears on both sides because amino nitrogen is incorporated while nitrile nitrogen is released.\",\n      \"reasoning\": \"Hennet et al. (1992) reported hydrothermal Strecker synthesis; the supplied 9.3-11.6 mM glycine values are available through Andersson and Holm (2000), not direct verification of the primary paper. This is a temperature-regime variant of Strecker chemistry, not a new mechanism. Thermal destruction limits extrapolation to hotter vents (Bada et al., 1995; Aubrey et al., 2009).\"\n    },\n    {\n      \"id\": \"rxn_011\",\n      \"name\": \"Reversible glyoxylate-ammonia condensation to glycine imine\",\n      \"inputs\": [\"mol_013\", \"mol_003\"],\n      \"outputs\": [\"mol_014\", \"mol_001\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"293-343 K, selected to match the coupled reduction\",\n        \"pressure\": \"Approximately 1 atm, or 5 bar H2 when coupled to hydrogenation\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"pH 8-10; total ammonia 6-375 mM depending on the downstream experiment. Condensation occurs in situ during reduction, not as an isolated preparative stage. Residence follows the coupled reaction, from laboratory day-scale screening to six-week mineral incubations.\"\n      },\n      \"mechanism\": \"Ammonia adds to glyoxylate through a hemiaminal; reversible dehydration generates a low-abundance imine pool.\",\n      \"reasoning\": \"Glycine imine has been characterized, and its rapid hydration or hydrolysis in water is documented (Paczelt et al., 2023). Coupled reductive amination does not require an isolable bulk imine concentration (Kaur et al., 2024). The node is a mechanistic bookkeeping intermediate that may be surface-bound; efficient geological glyoxylate supply remains unresolved.\"\n    },\n    {\n      \"id\": \"rxn_012\",\n      \"name\": \"Hydrogenation of glycine imine over supported nickel\",\n      \"inputs\": [\"mol_014\", \"mol_006\"],\n      \"outputs\": [\"mol_015\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\"Reduced Ni(0) on SiO2-Al2O3, approximately 10 mol% Ni relative to starting carbonyl substrate\"],\n      \"conditions\": {\n        \"temperature\": \"295 K\",\n        \"pressure\": \"5 bar H2\",\n        \"catalyst\": \"Ni(0)/SiO2-Al2O3\",\n        \"aqueous\": true,\n        \"other\": \"Reported anchors: pH 8 and total ammonium 6-150 mM. Couple to rxn_011 in an anoxic, hydrogen-retaining mineral-interface reactor. A 24-72 h screening residence is proposed, not asserted as a glyoxylate-specific time course from the supplied report. Measure nickel passivation and rxn_020 concurrently.\"\n      },\n      \"mechanism\": \"Nickel dissociates hydrogen and transfers surface hydrogen to the imine carbon-nitrogen bond.\",\n      \"reasoning\": \"Hydrogen-driven amino-acid production over supported nickel is experimentally supported at low ammonium concentrations (Kaur et al., 2024). Reported amino-plus-hydroxy-acid yields are not glycine-only yields, and glycolate competes. The supported catalyst is a laboratory benchmark; equivalent activity on an unmodified natural nickel-bearing mineral is an unproven geological extrapolation.\"\n    },\n    {\n      \"id\": \"rxn_013\",\n      \"name\": \"Hydrogenation of glycine imine on meteoritic Fe-Ni material\",\n      \"inputs\": [\"mol_014\", \"mol_006\"],\n      \"outputs\": [\"mol_015\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\"Ground iron meteorite containing accessible metallic Fe-Ni surfaces\"],\n      \"conditions\": {\n        \"temperature\": \"295 K\",\n        \"pressure\": \"5 bar H2\",\n        \"catalyst\": \"Characterized meteoritic Fe-Ni metal powder\",\n        \"aqueous\": true,\n        \"other\": \"Reported framework: pH 8 and ammonium in the 6-150 mM experimental range. Use an anoxic hydrogen-retaining pore or experimental analog. A 1-7 day screening interval is proposed. Meteorite identity, exposed Ni(0), surface area and loading require specification; the supplied summary does not provide a transferable loading-rate relationship.\"\n      },\n      \"mechanism\": \"Accessible meteoritic metal sites activate hydrogen and reduce the coupled glyoxylate-derived imine.\",\n      \"reasoning\": \"Ground iron meteorites were tested as catalysts in hydrogen-driven reductive amination (Kaur et al., 2024), giving this variant a more direct material analog than synthetic supported nickel. Meteorites are not interchangeable catalysts: corrosion, passivation and accessible nickel determine performance. This is a catalyst-distinct pathway sharing the hydrogenation mechanism of P5.\"\n    },\n    {\n      \"id\": \"rxn_014\",\n      \"name\": \"Glycine imine reduction by mixed-valence iron hydroxides\",\n      \"inputs\": [\"mol_014\", \"mol_021\", \"mol_022\"],\n      \"outputs\": [\"mol_015\", \"mol_022\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\"Initially mixed Fe(II)/Fe(III) hydroxide precipitate; ferrous sites are consumed as reducing equivalents\"],\n      \"conditions\": {\n        \"temperature\": \"343 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": \"Mixed-valence hydroxide interface; not a regenerated ferrous reductant\",\n        \"aqueous\": true,\n        \"other\": \"Reported anchors: glyoxylate 2.5 mM, NH4Cl 375 mM, pH 7-10, and approximately 50% initial Fe(II) for substantial glycine/glycolate production. Use week-scale monitoring. Initial Fe(III) is a declared boundary inventory; an anoxic source such as prior photochemical Fe(II) oxidation is a geological assumption, not demonstrated here.\"\n      },\n      \"mechanism\": \"Ferrous mineral sites provide the reducing equivalents for imine hydrogenation and become ferric sites; the initial ferric component also supplies the mixed-valence interface.\",\n      \"reasoning\": \"The glyoxylate experiments are reported by Barge et al. (2020), whereas Barge et al. (2019) primarily addressed pyruvate. Near-equal glycine and glycolate production makes rxn_021 essential. FeOOH on both sides preserves the explicitly required initial ferric inventory while recording additional oxidation; the endmember balance does not establish the final mineral assemblage.\"\n    },\n    {\n      \"id\": \"rxn_015\",\n      \"name\": \"Glycine imine reduction by ferroan brucite\",\n      \"inputs\": [\"mol_014\", \"mol_021\"],\n      \"outputs\": [\"mol_015\", \"mol_022\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\"Ferroan brucite, nominal Fe0.33Mg0.67(OH)2; structural Fe(II) is the finite reductant and the Mg-bearing host is not consumed in the represented redox balance\"],\n      \"conditions\": {\n        \"temperature\": \"293 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": \"Ferroan brucite reactive interface; structural Fe(II) is consumed\",\n        \"aqueous\": true,\n        \"other\": \"Reported anchors: starting pH 10, glyoxylate 100 mM, NH4Cl 100 mM, and six weeks. The reported ferrous inventory could support at most 31.25 mM amino acid. Couple directly to rxn_011. Quantify dissolved and mineral-associated glycine separately, together with glycolate and secondary amination products.\"\n      },\n      \"mechanism\": \"Structural Fe(II) transfers reducing equivalents to the imine; oxidation of the mineral supplies the net hydrogen equivalents needed to form glycine.\",\n      \"reasoning\": \"Ferroan brucite supports glycine synthesis with ammonia under mild conditions (Chimiak et al., 2024). The reported 52-69% yields must be interpreted using the study's limiting-reagent basis, not as 52-69 mM glycine from 100 mM glyoxylate when Fe(II) permits only 31.25 mM. Mineral availability, long residence and independent replication remain limitations.\"\n    },\n    {\n      \"id\": \"rxn_016\",\n      \"name\": \"Coupled nitrate reduction and glyoxylate amination on ferroan brucite\",\n      \"inputs\": [\"mol_013\", \"mol_023\", \"mol_021\", \"mol_024\"],\n      \"outputs\": [\"mol_015\", \"mol_022\", \"mol_001\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\"Ferroan brucite, nominal Fe0.33Mg0.67(OH)2, as a stoichiometrically consumed electron source and reactive interface\"],\n      \"conditions\": {\n        \"temperature\": \"293 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": \"Ferroan brucite interface; Fe(II) is not regenerated\",\n        \"aqueous\": true,\n        \"other\": \"Reported anchors: glyoxylate 100 mM, KNO3 100 mM, starting pH 10, and six weeks. The reported Fe(II) inventory supports at most 6.25 mM glycine for this nitrogen source. The proton input is formal charge bookkeeping at controlled pH, not an acidic bulk solution. Distinguish acid-digestible total product from dissolved product.\"\n      },\n      \"mechanism\": \"A lumped coupled process reduces nitrate-derived nitrogen and incorporates it into reduced glyoxylate. Nitrogen reduction and carbonyl reduction together require substantially more electrons than ammonia-based amination.\",\n      \"reasoning\": \"This coupled route was demonstrated with ferroan brucite (Chimiak et al., 2024). The graph does not assert that free ammonia accumulates as an isolated intermediate. Reported glycine yields were low, and up to 97% of product in nitrate systems was mineral-associated and recovered after acid digestion; synthesis therefore does not establish downstream bioavailability.\"\n    },\n    {\n      \"id\": \"rxn_017\",\n      \"name\": \"Glyoxylate condensation with hydroxylamine\",\n      \"inputs\": [\"mol_013\", \"mol_017\"],\n      \"outputs\": [\"mol_018\", \"mol_001\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": null,\n      \"conditions\": {\n        \"temperature\": \"343 K nominal design temperature\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Proposed screening window: pH 4-7, glyoxylate 10-100 mM, hydroxylamine at least comparable to glyoxylate, and hours to days. These are design conditions rather than a verified reproduction of the primary experimental recipe. Couple to native-iron reduction without requiring oxime isolation.\"\n      },\n      \"mechanism\": \"Hydroxylamine adds to the aldehyde group and loses water to form a glyoxylic acid oxime.\",\n      \"reasoning\": \"Hydroxylamine plus metallic iron was used to obtain amino acids from ketoacids, including glyoxylate (Muchowska et al., 2019). Oxime formation is the conventional mechanistic interpretation, but the supplied research does not establish an isolated oxime time course under these conditions. Geological hydroxylamine supply and persistence are additional boundary assumptions.\"\n    },\n    {\n      \"id\": \"rxn_018\",\n      \"name\": \"Native-iron reduction of glyoxylic acid oxime\",\n      \"inputs\": [\"mol_018\", \"mol_019\", \"mol_024\"],\n      \"outputs\": [\"mol_015\", \"mol_020\", \"mol_001\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\"Native Fe(0) powder or exposed meteoritic iron, acting as a consumed reductant and reactive surface\"],\n      \"conditions\": {\n        \"temperature\": \"343 K nominal design temperature\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": \"Reactive Fe(0) surface; iron is consumed rather than assumed catalytic\",\n        \"aqueous\": true,\n        \"other\": \"Proposed window: pH 4-7 and hours-to-days monitoring. Supply enough accessible Fe(0) for oxime reduction, plus independently assessed corrosion losses. Buffered proton activity, not an unbuffered proton stock, supports the formal ionic balance. Surface passivation and dissolved Fe(II) must be measured.\"\n      },\n      \"mechanism\": \"Reduction cleaves the nitrogen-oxygen bond and saturates the carbon-nitrogen bond; Fe(0) is oxidized to Fe(II), with oxygen leaving as water.\",\n      \"reasoning\": \"The overall hydroxylamine/metallic-iron amino-acid synthesis is supported by Muchowska et al. (2019). This node exposes reductant consumption that would be hidden by labeling iron only as a catalyst. The isolated-oxime mechanism and stated screening pH/time window are provisional decompositions of the experimentally supported overall transformation.\"\n    },\n    {\n      \"id\": \"rxn_019\",\n      \"name\": \"Competing glycolonitrile hydrolysis to glycolate\",\n      \"inputs\": [\"mol_008\", \"mol_001\"],\n      \"outputs\": [\"mol_016\", \"mol_003\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Hydronium in the hydrolysis pool\"],\n      \"conditions\": {\n        \"temperature\": \"353-370 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": \"Specific acid catalysis by hydronium\",\n        \"aqueous\": true,\n        \"other\": \"Same proposed pH 0-2 and 1-30 day hydrolysis window as the aminonitrile branch. This sink acts on glycolonitrile that escapes ammonia conversion. The amino/hydroxy product split is established partly during precursor formation, not only during hydrolysis.\"\n      },\n      \"mechanism\": \"Sequential nitrile hydration and amide hydrolysis release glycolic acid and ammonia.\",\n      \"reasoning\": \"Cyanohydrin chemistry competes with aminoacetonitrile formation in cyanide-derived networks (Patel et al., 2015; Ruiz-Bermejo et al., 2013). Explicit glycolate production prevents the model from treating every cyanide-formaldehyde encounter as productive glycine synthesis. Exact rates must be determined in the same matrix used for rxn_005 and rxn_006.\"\n    },\n    {\n      \"id\": \"rxn_020\",\n      \"name\": \"Competing hydrogenation of glyoxylate to glycolate\",\n      \"inputs\": [\"mol_013\", \"mol_006\"],\n      \"outputs\": [\"mol_016\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\"Ni(0)/SiO2-Al2O3 or characterized meteoritic Fe-Ni metal, used as alternative catalysts rather than a required mixture\"],\n      \"conditions\": {\n        \"temperature\": \"295 K\",\n        \"pressure\": \"5 bar H2\",\n        \"catalyst\": \"The same metal catalyst used in the coupled reductive-amination experiment\",\n        \"aqueous\": true,\n        \"other\": \"pH 8; total ammonium 6-150 mM; match catalyst loading, surface state and residence to rxn_012 or rxn_013. Measure amino-acid and hydroxy-acid production independently. Reduced ammonia availability increases the importance of direct carbonyl reduction.\"\n      },\n      \"mechanism\": \"Metal-activated hydrogen reduces the glyoxylate carbonyl directly, bypassing nitrogen incorporation.\",\n      \"reasoning\": \"Amino-acid and hydroxy-acid production compete in the nickel and meteorite experiments (Kaur et al., 2024). Combined product yields cannot be assigned entirely to glycine. This sink shares the same hydrogen inventory and active surface as productive imine hydrogenation, so selectivity must be modeled jointly.\"\n    },\n    {\n      \"id\": \"rxn_021\",\n      \"name\": \"Competing mineral-driven glyoxylate reduction to glycolate\",\n      \"inputs\": [\"mol_013\", \"mol_021\"],\n      \"outputs\": [\"mol_016\", \"mol_022\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\"Fe(II)-bearing hydroxide interface: either mixed-valence iron hydroxides or ferroan brucite in separate experiments\"],\n      \"conditions\": {\n        \"temperature\": \"343 K for the mixed-hydroxide system; 293 K for ferroan brucite\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": \"Reactive iron hydroxide interface; ferrous reducing equivalents are consumed\",\n        \"aqueous\": true,\n        \"other\": \"Match pH, ammonium, mineral loading and duration to rxn_014 or rxn_015. These are two experimental settings, not a validated continuous temperature-response curve. Quantify glycolate against glycine and include competition for the finite Fe(II) inventory.\"\n      },\n      \"mechanism\": \"Electron and proton transfer from ferrous mineral sites reduces the carbonyl group directly while oxidizing Fe(II) to Fe(III).\",\n      \"reasoning\": \"Glycolate is a documented competitor in iron-hydroxide and ferroan-brucite glyoxylate experiments (Barge et al., 2020; Chimiak et al., 2024). In the mixed-valence system it can be comparable to glycine. Including its reductant demand prevents overestimating the amino-acid yield permitted by the mineral electron budget.\"\n    },\n    {\n      \"id\": \"rxn_022\",\n      \"name\": \"Secondary reductive amination consuming glycine\",\n      \"inputs\": [\"mol_015\", \"mol_013\", \"mol_021\"],\n      \"outputs\": [\"mol_025\", \"mol_022\", \"mol_001\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\"Ferroan brucite with remaining accessible structural Fe(II)\"],\n      \"conditions\": {\n        \"temperature\": \"293 K\",\n        \"pressure\": \"Approximately 1 atm\",\n        \"catalyst\": \"Ferroan brucite reactive interface; structural Fe(II) is consumed\",\n        \"aqueous\": true,\n        \"other\": \"Starting pH approximately 10; glyoxylate-rich mixtures; days to six weeks, matching the brucite incubations. Requires both residual glyoxylate and remaining mineral reducing capacity after glycine first forms. Product formation is not assumed if glycine is inaccessible through adsorption.\"\n      },\n      \"mechanism\": \"Glycine's amino group condenses with another glyoxylate molecule; reduction of the resulting imine yields iminodiacetic acid.\",\n      \"reasoning\": \"Iminodiacetic acid was identified among ferroan-brucite reaction products (Chimiak et al., 2024). Secondary reductive amination is a chemically justified interpretation, although the isolated sequence was not established by the supplied evidence. This explicitly represents loss of accumulated glycine and additional consumption of the finite ferrous inventory.\"\n    }\n  ],\n  \"pathways\": [\n    {\n      \"pathway_id\": \"P1\",\n      \"name\": \"Aqueous imine-first Strecker pathway\",\n      \"description\": \"Form methanimine in an ammonia-rich pool, trap it with cyanide, and hydrolyze the aminonitrile through glycinamide. The alkaline precursor stage and acidic heated hydrolysis stage require sequential conditions or physical transfer; they are not simultaneous one-pot conditions.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_002\", \"rxn_005\", \"rxn_006\"],\n      \"key_intermediates\": [\"mol_007\", \"mol_009\", \"mol_010\"]\n    },\n    {\n      \"pathway_id\": \"P2\",\n      \"name\": \"Cyanohydrin-first ammonia-exchange pathway\",\n      \"description\": \"Store formaldehyde and cyanide as glycolonitrile, introduce ammonia before hydrolysis, and converge on aminoacetonitrile. This is a distinct precursor-processing path sharing Strecker equilibria with P1, not an independent elementary mechanism. Residual glycolonitrile is lost through rxn_019.\",\n      \"reaction_sequence\": [\"rxn_003\", \"rxn_004\", \"rxn_005\", \"rxn_006\"],\n      \"key_intermediates\": [\"mol_008\", \"mol_009\", \"mol_010\"]\n    },\n    {\n      \"pathway_id\": \"P3\",\n      \"name\": \"Hydantoin capture and hydrolytic release pathway\",\n      \"description\": \"Capture formaldehyde-derived aminoacetonitrile with inorganic carbon, then open and hydrolyze hydantoin to glycine. The formaldehyde-specific mild formation window and environmental hydrolysis rates are provisional; evidence for other hydantoin substrates is not treated as a measured rate for this sequence.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_002\", \"rxn_007\", \"rxn_008\", \"rxn_009\"],\n      \"key_intermediates\": [\"mol_009\", \"mol_011\", \"mol_012\"]\n    },\n    {\n      \"pathway_id\": \"P4\",\n      \"name\": \"Moderate-temperature hydrothermal Strecker pathway\",\n      \"description\": \"Use the experimentally reported 423 K hydrothermal setting for coupled precursor reaction and hydrolysis, represented as one lumped reaction. This temperature-regime variant requires cooling for accumulation and is not extrapolated to black-smoker temperatures.\",\n      \"reaction_sequence\": [\"rxn_010\"],\n      \"key_intermediates\": []\n    },\n    {\n      \"pathway_id\": \"P5\",\n      \"name\": \"Hydrogen-supported nickel reductive amination\",\n      \"description\": \"Couple in situ glyoxylate-ammonia condensation to hydrogenation on supported Ni(0). This is an experimentally supported low-ammonium laboratory benchmark with an unresolved natural-catalyst analog. Direct glycolate formation through rxn_020 shares the same reductant.\",\n      \"reaction_sequence\": [\"rxn_011\", \"rxn_012\"],\n      \"key_intermediates\": [\"mol_014\"]\n    },\n    {\n      \"pathway_id\": \"P6\",\n      \"name\": \"Hydrogen-supported meteoritic metal reductive amination\",\n      \"description\": \"Couple the same imine-forming equilibrium to hydrogenation on characterized meteoritic Fe-Ni surfaces. This is a catalyst-distinct experimental variant of P5, contingent on accessible metal sites, sustained hydrogen pressure and limited passivation.\",\n      \"reaction_sequence\": [\"rxn_011\", \"rxn_013\"],\n      \"key_intermediates\": [\"mol_014\"]\n    },\n    {\n      \"pathway_id\": \"P7\",\n      \"name\": \"Mixed-valence iron-hydroxide reductive amination\",\n      \"description\": \"Reduce the glyoxylate-derived imine using ferrous sites in an initially mixed Fe(II)/Fe(III) interface. Initial ferric inventory is supplied explicitly rather than generated by an undeclared oxygen exposure. Glycolate competes for the same ferrous inventory through rxn_021.\",\n      \"reaction_sequence\": [\"rxn_011\", \"rxn_014\"],\n      \"key_intermediates\": [\"mol_014\"]\n    },\n    {\n      \"pathway_id\": \"P8\",\n      \"name\": \"Ammonia-fed ferroan-brucite reductive amination\",\n      \"description\": \"Form and reduce the imine within an ammonia-containing ferroan-brucite suspension at approximately 293 K. Structural Fe(II), not glyoxylate alone, limits yield. Long residence, competing glycolate production and secondary glycine consumption must be included in any accumulation model.\",\n      \"reaction_sequence\": [\"rxn_011\", \"rxn_015\"],\n      \"key_intermediates\": [\"mol_014\"]\n    },\n    {\n      \"pathway_id\": \"P9\",\n      \"name\": \"Nitrate-fed ferroan-brucite coupled nitrogen reduction\",\n      \"description\": \"Use nitrate rather than supplied ammonia in a coupled mineral-mediated reduction and amination. The greater electron demand lowers the maximum glycine yield for a fixed Fe(II) inventory. The target includes mineral-associated glycine; acid-digestion recovery is not evidence that free glycine was environmentally available.\",\n      \"reaction_sequence\": [\"rxn_016\"],\n      \"key_intermediates\": []\n    },\n    {\n      \"pathway_id\": \"P10\",\n      \"name\": \"Hydroxylamine-oxime pathway with native iron\",\n      \"description\": \"Condense glyoxylate with hydroxylamine and reduce the resulting oxime using consumable Fe(0). The overall reagent combination is experimentally supported, while the isolated intermediate sequence and proposed operating window require verification. Hydroxylamine supply is an additional unresolved feedstock boundary.\",\n      \"reaction_sequence\": [\"rxn_017\", \"rxn_018\"],\n      \"key_intermediates\": [\"mol_018\"]\n    }\n  ],\n  \"hub_molecules\": [\n    \"mol_001\",\n    \"mol_002\",\n    \"mol_003\",\n    \"mol_004\",\n    \"mol_006\",\n    \"mol_008\",\n    \"mol_009\",\n    \"mol_013\",\n    \"mol_014\",\n    \"mol_015\",\n    \"mol_016\",\n    \"mol_021\",\n    \"mol_022\",\n    \"mol_024\"\n  ],\n  \"convergence_points\": [\n    {\n      \"molecule_id\": \"mol_001\",\n      \"incoming_reactions\": [\"rxn_001\", \"rxn_004\", \"rxn_011\", \"rxn_016\", \"rxn_017\", \"rxn_018\", \"rxn_022\"],\n      \"outgoing_reactions\": [\"rxn_005\", \"rxn_006\", \"rxn_008\", \"rxn_009\", \"rxn_010\", \"rxn_019\"]\n    },\n    {\n      \"molecule_id\": \"mol_003\",\n      \"incoming_reactions\": [\"rxn_006\", \"rxn_009\", \"rxn_010\", \"rxn_019\"],\n      \"outgoing_reactions\": [\"rxn_001\", \"rxn_004\", \"rxn_010\", \"rxn_011\"]\n    },\n    {\n      \"molecule_id\": \"mol_009\",\n      \"incoming_reactions\": [\"rxn_002\", \"rxn_004\"],\n      \"outgoing_reactions\": [\"rxn_005\", \"rxn_007\"]\n    },\n    {\n      \"molecule_id\": \"mol_015\",\n      \"incoming_reactions\": [\"rxn_006\", \"rxn_009\", \"rxn_010\", \"rxn_012\", \"rxn_013\", \"rxn_014\", \"rxn_015\", \"rxn_016\", \"rxn_018\"],\n      \"outgoing_reactions\": [\"rxn_022\"]\n    },\n    {\n      \"molecule_id\": \"mol_016\",\n      \"incoming_reactions\": [\"rxn_019\", \"rxn_020\", \"rxn_021\"],\n      \"outgoing_reactions\": []\n    },\n    {\n      \"molecule_id\": \"mol_022\",\n      \"incoming_reactions\": [\"rxn_014\", \"rxn_015\", \"rxn_016\", \"rxn_021\", \"rxn_022\"],\n      \"outgoing_reactions\": [\"rxn_014\"]\n    }\n  ]\n}", "parsed_response": {"target_molecule": "Glycine", "overall_strategy": "Construct ten graph-distinct pathways using experimentally supported Strecker, cyanohydrin, hydantoin and reductive-amination chemistry. Some pathways are experimentally distinct temperature, catalyst or mineral variants of a shared mechanism; they are not ten independent reaction families. The network is complete at a declared feedstock boundary: formaldehyde, HCN, ammonia, glyoxylate, hydroxylamine, hydrogen and reactive mineral inventories are supplied inputs. Their geological production and concentration are not assumed solved, especially for glyoxylate, HCN and hydroxylamine. Competing glycolate formation and secondary glycine consumption are explicit. All settings are anoxic; surface reactions not requiring irradiation occupy water-covered or mineral-shaded locations. Neutral organic acids and NH3 represent analytical acid-base pools rather than their dominant microspecies. Fe(OH)2 and FeOOH represent idealized ferrous and ferric mineral endmember equivalents; they conserve atoms and reducing equivalents without asserting that every experiment produces a pure FeOOH phase. Initial ferric material is an explicitly declared boundary inventory, not material generated using molecular oxygen within this network. A single representative environment_formed is assigned where several environments are possible; null denotes an unspecified boundary origin. Glycine denotes chemical identity, including mineral-associated material, not necessarily freely available dissolved product. The role intermediate also covers terminal coproducts because the schema has no byproduct category. Conditions distinguish reported experimental anchors from proposed screening windows. Slow hydrolysis, mineral passivation, feedstock supply and product desorption remain explicit bottlenecks.", "molecules": [{"id": "mol_001", "formula": "H2O", "iupac_name": "oxidane", "common_name": "water", "inchi": "InChI=1S/H2O/h1H2", "role": "starting", "environment_formed": null}, {"id": "mol_002", "formula": "CH2O", "iupac_name": "methanal", "common_name": "formaldehyde", "inchi": "InChI=1S/CH2O/c1-2/h1H2", "role": "starting", "environment_formed": null}, {"id": "mol_003", "formula": "NH3", "iupac_name": "azane", "common_name": "ammonia", "inchi": "InChI=1S/H3N/h1H3", "role": "starting", "environment_formed": null}, {"id": "mol_004", "formula": "CHN", "iupac_name": "hydrogen cyanide", "common_name": "hydrogen cyanide", "inchi": "InChI=1S/CHN/c1-2/h1H", "role": "starting", "environment_formed": null}, {"id": "mol_005", "formula": "CO2", "iupac_name": "carbon dioxide", "common_name": "carbon dioxide", "inchi": "InChI=1S/CO2/c2-1-3", "role": "starting", "environment_formed": null}, {"id": "mol_006", "formula": "H2", "iupac_name": "dihydrogen", "common_name": "hydrogen", "inchi": "InChI=1S/H2/h1H", "role": "starting", "environment_formed": null}, {"id": "mol_007", "formula": "CH3N", "iupac_name": "methanimine", "common_name": "formaldimine", "inchi": "InChI=1S/CH3N/c1-2/h2H,1H2", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_008", "formula": "C2H3NO", "iupac_name": "2-hydroxyacetonitrile", "common_name": "glycolonitrile", "inchi": "InChI=1S/C2H3NO/c3-1-2-4/h4H,2H2", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_009", "formula": "C2H4N2", "iupac_name": "2-aminoacetonitrile", "common_name": "aminoacetonitrile", "inchi": "InChI=1S/C2H4N2/c3-1-2-4/h2,4H2", "role": "hub_intermediate", "environment_formed": "Surface"}, {"id": "mol_010", "formula": "C2H6N2O", "iupac_name": "2-aminoacetamide", "common_name": "glycinamide", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_011", "formula": "C3H4N2O2", "iupac_name": "imidazolidine-2,4-dione", "common_name": "hydantoin", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_012", "formula": "C3H6N2O3", "iupac_name": "2-(carbamoylamino)acetic acid", "common_name": "N-carbamoylglycine", "inchi": null, "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_013", "formula": "C2H2O3", "iupac_name": "2-oxoacetic acid", "common_name": "glyoxylic acid", "inchi": "InChI=1S/C2H2O3/c3-1-2(4)5/h1H,(H,4,5)", "role": "starting", "environment_formed": null}, {"id": "mol_014", "formula": "C2H3NO2", "iupac_name": "2-iminoacetic acid", "common_name": "glycine imine", "inchi": null, "role": "hub_intermediate", "environment_formed": "Biochemical"}, {"id": "mol_015", "formula": "C2H5NO2", "iupac_name": "2-aminoacetic acid", "common_name": "glycine", "inchi": "InChI=1S/C2H5NO2/c3-1-2(4)5/h1,3H2,(H,4,5)", "role": "target", "environment_formed": "Surface"}, {"id": "mol_016", "formula": "C2H4O3", "iupac_name": "2-hydroxyacetic acid", "common_name": "glycolic acid", "inchi": "InChI=1S/C2H4O3/c3-1-2(4)5/h3H,1H2,(H,4,5)", "role": "intermediate", "environment_formed": "Surface"}, {"id": "mol_017", "formula": "NH3O", "iupac_name": "hydroxylamine", "common_name": "hydroxylamine", "inchi": "InChI=1S/H3NO/c1-2/h2H,1H2", "role": "starting", "environment_formed": null}, {"id": "mol_018", "formula": "C2H3NO3", "iupac_name": "2-(hydroxyimino)acetic acid", "common_name": "glyoxylic acid oxime", "inchi": null, "role": "intermediate", "environment_formed": "Biochemical"}, {"id": "mol_019", "formula": "Fe", "iupac_name": "iron", "common_name": "native iron", "inchi": "InChI=1S/Fe", "role": "starting", "environment_formed": null}, {"id": "mol_020", "formula": "Fe2+", "iupac_name": "iron(2+)", "common_name": "ferrous ion", "inchi": "InChI=1S/Fe/q+2", "role": "intermediate", "environment_formed": "Biochemical"}, {"id": "mol_021", "formula": "FeH2O2", "iupac_name": "iron(II) hydroxide", "common_name": "ferrous hydroxide endmember", "inchi": null, "role": "starting", "environment_formed": null}, {"id": "mol_022", "formula": "FeHO2", "iupac_name": "iron(III) oxide hydroxide", "common_name": "ferric oxyhydroxide endmember", "inchi": null, "role": "starting", "environment_formed": null}, {"id": "mol_023", "formula": "NO3-", "iupac_name": "nitrate", "common_name": "nitrate", "inchi": "InChI=1S/NO3/c2-1(3)4/q-1", "role": "starting", "environment_formed": null}, {"id": "mol_024", "formula": "H+", "iupac_name": "hydron", "common_name": "proton", "inchi": "InChI=1S/p+1", "role": "starting", "environment_formed": null}, {"id": "mol_025", "formula": "C4H7NO4", "iupac_name": "2-[(carboxymethyl)amino]acetic acid", "common_name": "iminodiacetic acid", "inchi": "InChI=1S/C4H7NO4/c6-3(7)1-5-2-4(8)9/h5H,1-2H2,(H,6,7)(H,8,9)", "role": "intermediate", "environment_formed": "Biochemical"}], "reactions": [{"id": "rxn_001", "name": "Reversible formaldehyde-ammonia condensation", "inputs": ["mol_002", "mol_003"], "outputs": ["mol_007", "mol_001"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-323 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Design window: pH 8-9; formaldehyde 1-100 mM and total ammonia 50-500 mM; hours to days with immediate downstream cyanide trapping. Use a covered or water-shaded pool with limited gas exchange. These concentrations and residence times are screening assumptions, not measured geological inventories."}, "mechanism": "Ammonia adds to formaldehyde; the resulting carbinolamine reversibly loses water to form methanimine.", "reasoning": "This is the conventional condensation component of Strecker chemistry underlying reducing-atmosphere amino-acid experiments (Miller, 1953; Johnson et al., 2008). Methanimine need not accumulate or be isolated: hydration and hydrolysis compete strongly in water. Concentrated, retained ammonia and formaldehyde remain feedstock assumptions, not consequences of those experiments."}, {"id": "rxn_002", "name": "Cyanide trapping of methanimine", "inputs": ["mol_007", "mol_004"], "outputs": ["mol_009"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-323 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Design window: pH 8-9; total cyanide 10-100 mM; total ammonia comparable to or greater than total cyanide. Couple directly to rxn_001 without isolating methanimine; hours-to-days screening residence. HCN volatilization and hydroxy-nitrile formation must be measured."}, "mechanism": "Cyanide attacks the imine or iminium carbon, with proton transfer yielding aminoacetonitrile.", "reasoning": "Aminonitrile formation is the chemically established core of the aqueous Strecker interpretation of Miller-type experiments (Miller, 1953; Johnson et al., 2008). No mineral catalyst is required. The amino-acid branch is not intrinsically exclusive: formaldehyde also enters rxn_003, and feedstock concentrations cannot be inferred from amino-acid detection alone."}, {"id": "rxn_003", "name": "Formaldehyde cyanohydrin formation", "inputs": ["mol_002", "mol_004"], "outputs": ["mol_008"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-323 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Design window: pH 7-9; formaldehyde and total cyanide each 10-100 mM; hours-to-days screening residence. Formation is reversible. Low ammonia favors storage as cyanohydrin rather than immediate aminonitrile formation."}, "mechanism": "Cyanide adds to the formaldehyde carbonyl, followed by proton transfer to form glycolonitrile.", "reasoning": "Glycolonitrile is an experimentally grounded branch point in cyanide-derived precursor chemistry (Patel et al., 2015). This reaction requires neither UV photoredox catalysis nor sulfide because the formaldehyde is already supplied. It creates both a productive ammonia-exchange route and the competing glycolate route, rather than a guaranteed glycine precursor."}, {"id": "rxn_004", "name": "Ammonia-driven conversion of glycolonitrile to aminoacetonitrile", "inputs": ["mol_008", "mol_003"], "outputs": ["mol_009", "mol_001"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-323 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Design window: pH 8-9; glycolonitrile 10-100 mM; total ammonia 0.1-0.5 M; hours to days. Introduce ammonia before strong heating or acid hydrolysis. Required ammonia retention and transfer between precursor-rich and ammonia-rich waters are scenario assumptions."}, "mechanism": "Cyanohydrin-carbonyl equilibration, ammonia condensation and renewed cyanide trapping give net replacement of hydroxyl by amino functionality; direct displacement of free hydroxide is not assumed.", "reasoning": "Ammonia conversion of glycolonitrile into the aminonitrile branch is supported by the cyanosulfidic precursor network (Patel et al., 2015). This node represents only the downstream exchange chemistry, not the upstream Cu/sulfide/UV homologation sequence. Cu is therefore not assigned as an unjustified catalyst, and this pathway is acknowledged to share Strecker equilibria with P1."}, {"id": "rxn_005", "name": "Aminoacetonitrile hydration to glycinamide", "inputs": ["mol_009", "mol_001"], "outputs": ["mol_010"], "environment": "Surface", "agents": ["Hydronium supplied by an anoxic volcanic acid pool"], "conditions": {"temperature": "353-370 K", "pressure": "Approximately 1 atm", "catalyst": "Specific acid catalysis by hydronium", "aqueous": true, "other": "Proposed hydrolysis window: pH 0-2 and 1-30 days. Transfer or acidify an aminonitrile-bearing fraction after precursor formation; do not assume coexistence with the alkaline synthesis stage. The supplied research does not establish a rate constant within this entire window."}, "mechanism": "Protonation and water addition to the nitrile, followed by tautomerization, produce glycinamide.", "reasoning": "Nitrile-to-amide-to-amino-acid hydrolysis is the standard Strecker product-release sequence (Miller, 1953; Ruiz-Bermejo et al., 2013). The acid pool is an accelerator, not a required mineral catalyst. Environmental execution remains conditional because acid availability, transfer losses and hydrolysis kinetics must be established; rapid neutral-water hydrolysis is not assumed."}, {"id": "rxn_006", "name": "Glycinamide hydrolysis to glycine", "inputs": ["mol_010", "mol_001"], "outputs": ["mol_015", "mol_003"], "environment": "Surface", "agents": ["Hydronium supplied by an anoxic volcanic acid pool"], "conditions": {"temperature": "353-370 K", "pressure": "Approximately 1 atm", "catalyst": "Specific acid catalysis by hydronium", "aqueous": true, "other": "Proposed window: pH 0-2 and 1-30 days, with analytical monitoring rather than an assumed complete conversion. Ammonia is predominantly ammonium here. Cool and neutralize only if subsequent chemistry requires it; those operations are not additional synthesis reactions."}, "mechanism": "Water attacks the activated amide carbonyl; carbon-nitrogen bond cleavage releases glycine and the ammonia/ammonium pool.", "reasoning": "This is the terminal hydrolysis of the established aminonitrile route (Miller, 1953; Ruiz-Bermejo et al., 2013). Amide hydrolysis can be the product-release bottleneck and must not be treated as instantaneous at ambient neutral pH. Nitrogen originally residing in the nitrile is released, whereas the amino nitrogen is retained in glycine."}, {"id": "rxn_007", "name": "Carbon dioxide trapping of aminoacetonitrile as hydantoin", "inputs": ["mol_009", "mol_005"], "outputs": ["mol_011"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-323 K", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Provisional substrate-specific window: pH 8-9; dissolved inorganic carbon 10-100 mM; aminonitrile 1-100 mM; ammonia-rich solution; hours to days. Carbon dioxide denotes the inorganic-carbon pool. Retention of both inorganic carbon and cyanide-derived intermediates must be verified."}, "mechanism": "Aminonitrile carbamylation, cyclization through an imino heterocycle and rearrangement incorporate inorganic carbon into hydantoin.", "reasoning": "Bucherer-Bergs chemistry supports aminonitrile-to-hydantoin conversion, and related prebiotic experiments support hydantoin-mediated amino-acid production (Pulletikurti et al., 2022; Ferris et al., 1974). However, the 2022 study emphasizes alpha-ketoacid substrates. Applying its mild formation conditions specifically to unsubstituted hydantoin from formaldehyde-derived aminoacetonitrile is a provisional extrapolation, not a demonstrated yield claim."}, {"id": "rxn_008", "name": "Hydantoin ring opening to N-carbamoylglycine", "inputs": ["mol_011", "mol_001"], "outputs": ["mol_012"], "environment": "Surface", "agents": ["Hydronium in a separate acidic geothermal pool"], "conditions": {"temperature": "353-370 K", "pressure": "Approximately 1 atm", "catalyst": "Specific acid catalysis by hydronium", "aqueous": true, "other": "Proposed window: pH 0-2; 1-30 days, extending only if measured survival and conversion justify it. Requires acidification or transfer from the carbonate-rich formation stage. Ring-opening kinetics for unsubstituted hydantoin under these exact conditions are unresolved."}, "mechanism": "Hydrolytic cleavage of the cyclic amide opens hydantoin to N-carbamoylglycine.", "reasoning": "Hydantoin hydrolysis provides a recognized connection to amino acids (Ferris et al., 1974; Ruiz-Bermejo et al., 2013). The approximately 353 K hydrolysis discussed for other hydantoin systems cannot automatically establish the rate for this substrate (Pulletikurti et al., 2022). This is therefore an explicit kinetic bottleneck with provisional environmental operating conditions."}, {"id": "rxn_009", "name": "N-carbamoylglycine hydrolysis and carbon dioxide release", "inputs": ["mol_012", "mol_001"], "outputs": ["mol_015", "mol_003", "mol_005"], "environment": "Surface", "agents": ["Hydronium in a separate acidic geothermal pool"], "conditions": {"temperature": "353-370 K", "pressure": "Approximately 1 atm", "catalyst": "Specific acid catalysis by hydronium", "aqueous": true, "other": "Proposed window: pH 0-2 and 1-30 days. Monitor residual ureido compound, glycine and total ammonia. Carbon dioxide loss can favor net deprotection, but conversion and product survival cannot be assigned without substrate-specific kinetic measurements."}, "mechanism": "Hydrolysis of the carbamoyl group releases glycine; the remaining carbamic-acid equivalent decomposes to ammonia and carbon dioxide.", "reasoning": "This represents the conventional terminal chemistry of hydantoin hydrolysis to glycine (Ferris et al., 1974; Ruiz-Bermejo et al., 2013). The split into ring opening and decarbamoylation makes the slow steps visible, rather than interpreting hydantoin formation as immediate amino-acid production. Exact prebiotic rates remain unsupported by the supplied substrate-specific evidence."}, {"id": "rxn_010", "name": "Moderate-temperature hydrothermal Strecker synthesis, lumped", "inputs": ["mol_002", "mol_003", "mol_004", "mol_001"], "outputs": ["mol_015", "mol_003"], "environment": "Hydrothermal", "agents": ["Pyrite-pyrrhotite-magnetite assemblage as a redox buffer, not a demonstrated reaction catalyst"], "conditions": {"temperature": "423 K", "pressure": "10 bar experimental pressure", "catalyst": null, "aqueous": true, "other": "Reported anchors: NH4Cl-containing solution, CO2/H2 gas mixture of 3:1, and 25-54 h residence. Initial reactant concentrations and pH are not securely specified in the supplied summary. Require a locally sulfide-bearing subseafloor pocket and subsequent cooling; do not extrapolate to prolonged residence above 473 K."}, "mechanism": "Lumped imine formation, cyanide addition and nitrile/amide hydrolysis. Ammonia appears on both sides because amino nitrogen is incorporated while nitrile nitrogen is released.", "reasoning": "Hennet et al. (1992) reported hydrothermal Strecker synthesis; the supplied 9.3-11.6 mM glycine values are available through Andersson and Holm (2000), not direct verification of the primary paper. This is a temperature-regime variant of Strecker chemistry, not a new mechanism. Thermal destruction limits extrapolation to hotter vents (Bada et al., 1995; Aubrey et al., 2009)."}, {"id": "rxn_011", "name": "Reversible glyoxylate-ammonia condensation to glycine imine", "inputs": ["mol_013", "mol_003"], "outputs": ["mol_014", "mol_001"], "environment": "Biochemical", "agents": null, "conditions": {"temperature": "293-343 K, selected to match the coupled reduction", "pressure": "Approximately 1 atm, or 5 bar H2 when coupled to hydrogenation", "catalyst": null, "aqueous": true, "other": "pH 8-10; total ammonia 6-375 mM depending on the downstream experiment. Condensation occurs in situ during reduction, not as an isolated preparative stage. Residence follows the coupled reaction, from laboratory day-scale screening to six-week mineral incubations."}, "mechanism": "Ammonia adds to glyoxylate through a hemiaminal; reversible dehydration generates a low-abundance imine pool.", "reasoning": "Glycine imine has been characterized, and its rapid hydration or hydrolysis in water is documented (Paczelt et al., 2023). Coupled reductive amination does not require an isolable bulk imine concentration (Kaur et al., 2024). The node is a mechanistic bookkeeping intermediate that may be surface-bound; efficient geological glyoxylate supply remains unresolved."}, {"id": "rxn_012", "name": "Hydrogenation of glycine imine over supported nickel", "inputs": ["mol_014", "mol_006"], "outputs": ["mol_015"], "environment": "Biochemical", "agents": ["Reduced Ni(0) on SiO2-Al2O3, approximately 10 mol% Ni relative to starting carbonyl substrate"], "conditions": {"temperature": "295 K", "pressure": "5 bar H2", "catalyst": "Ni(0)/SiO2-Al2O3", "aqueous": true, "other": "Reported anchors: pH 8 and total ammonium 6-150 mM. Couple to rxn_011 in an anoxic, hydrogen-retaining mineral-interface reactor. A 24-72 h screening residence is proposed, not asserted as a glyoxylate-specific time course from the supplied report. Measure nickel passivation and rxn_020 concurrently."}, "mechanism": "Nickel dissociates hydrogen and transfers surface hydrogen to the imine carbon-nitrogen bond.", "reasoning": "Hydrogen-driven amino-acid production over supported nickel is experimentally supported at low ammonium concentrations (Kaur et al., 2024). Reported amino-plus-hydroxy-acid yields are not glycine-only yields, and glycolate competes. The supported catalyst is a laboratory benchmark; equivalent activity on an unmodified natural nickel-bearing mineral is an unproven geological extrapolation."}, {"id": "rxn_013", "name": "Hydrogenation of glycine imine on meteoritic Fe-Ni material", "inputs": ["mol_014", "mol_006"], "outputs": ["mol_015"], "environment": "Biochemical", "agents": ["Ground iron meteorite containing accessible metallic Fe-Ni surfaces"], "conditions": {"temperature": "295 K", "pressure": "5 bar H2", "catalyst": "Characterized meteoritic Fe-Ni metal powder", "aqueous": true, "other": "Reported framework: pH 8 and ammonium in the 6-150 mM experimental range. Use an anoxic hydrogen-retaining pore or experimental analog. A 1-7 day screening interval is proposed. Meteorite identity, exposed Ni(0), surface area and loading require specification; the supplied summary does not provide a transferable loading-rate relationship."}, "mechanism": "Accessible meteoritic metal sites activate hydrogen and reduce the coupled glyoxylate-derived imine.", "reasoning": "Ground iron meteorites were tested as catalysts in hydrogen-driven reductive amination (Kaur et al., 2024), giving this variant a more direct material analog than synthetic supported nickel. Meteorites are not interchangeable catalysts: corrosion, passivation and accessible nickel determine performance. This is a catalyst-distinct pathway sharing the hydrogenation mechanism of P5."}, {"id": "rxn_014", "name": "Glycine imine reduction by mixed-valence iron hydroxides", "inputs": ["mol_014", "mol_021", "mol_022"], "outputs": ["mol_015", "mol_022"], "environment": "Biochemical", "agents": ["Initially mixed Fe(II)/Fe(III) hydroxide precipitate; ferrous sites are consumed as reducing equivalents"], "conditions": {"temperature": "343 K", "pressure": "Approximately 1 atm", "catalyst": "Mixed-valence hydroxide interface; not a regenerated ferrous reductant", "aqueous": true, "other": "Reported anchors: glyoxylate 2.5 mM, NH4Cl 375 mM, pH 7-10, and approximately 50% initial Fe(II) for substantial glycine/glycolate production. Use week-scale monitoring. Initial Fe(III) is a declared boundary inventory; an anoxic source such as prior photochemical Fe(II) oxidation is a geological assumption, not demonstrated here."}, "mechanism": "Ferrous mineral sites provide the reducing equivalents for imine hydrogenation and become ferric sites; the initial ferric component also supplies the mixed-valence interface.", "reasoning": "The glyoxylate experiments are reported by Barge et al. (2020), whereas Barge et al. (2019) primarily addressed pyruvate. Near-equal glycine and glycolate production makes rxn_021 essential. FeOOH on both sides preserves the explicitly required initial ferric inventory while recording additional oxidation; the endmember balance does not establish the final mineral assemblage."}, {"id": "rxn_015", "name": "Glycine imine reduction by ferroan brucite", "inputs": ["mol_014", "mol_021"], "outputs": ["mol_015", "mol_022"], "environment": "Biochemical", "agents": ["Ferroan brucite, nominal Fe0.33Mg0.67(OH)2; structural Fe(II) is the finite reductant and the Mg-bearing host is not consumed in the represented redox balance"], "conditions": {"temperature": "293 K", "pressure": "Approximately 1 atm", "catalyst": "Ferroan brucite reactive interface; structural Fe(II) is consumed", "aqueous": true, "other": "Reported anchors: starting pH 10, glyoxylate 100 mM, NH4Cl 100 mM, and six weeks. The reported ferrous inventory could support at most 31.25 mM amino acid. Couple directly to rxn_011. Quantify dissolved and mineral-associated glycine separately, together with glycolate and secondary amination products."}, "mechanism": "Structural Fe(II) transfers reducing equivalents to the imine; oxidation of the mineral supplies the net hydrogen equivalents needed to form glycine.", "reasoning": "Ferroan brucite supports glycine synthesis with ammonia under mild conditions (Chimiak et al., 2024). The reported 52-69% yields must be interpreted using the study's limiting-reagent basis, not as 52-69 mM glycine from 100 mM glyoxylate when Fe(II) permits only 31.25 mM. Mineral availability, long residence and independent replication remain limitations."}, {"id": "rxn_016", "name": "Coupled nitrate reduction and glyoxylate amination on ferroan brucite", "inputs": ["mol_013", "mol_023", "mol_021", "mol_024"], "outputs": ["mol_015", "mol_022", "mol_001"], "environment": "Biochemical", "agents": ["Ferroan brucite, nominal Fe0.33Mg0.67(OH)2, as a stoichiometrically consumed electron source and reactive interface"], "conditions": {"temperature": "293 K", "pressure": "Approximately 1 atm", "catalyst": "Ferroan brucite interface; Fe(II) is not regenerated", "aqueous": true, "other": "Reported anchors: glyoxylate 100 mM, KNO3 100 mM, starting pH 10, and six weeks. The reported Fe(II) inventory supports at most 6.25 mM glycine for this nitrogen source. The proton input is formal charge bookkeeping at controlled pH, not an acidic bulk solution. Distinguish acid-digestible total product from dissolved product."}, "mechanism": "A lumped coupled process reduces nitrate-derived nitrogen and incorporates it into reduced glyoxylate. Nitrogen reduction and carbonyl reduction together require substantially more electrons than ammonia-based amination.", "reasoning": "This coupled route was demonstrated with ferroan brucite (Chimiak et al., 2024). The graph does not assert that free ammonia accumulates as an isolated intermediate. Reported glycine yields were low, and up to 97% of product in nitrate systems was mineral-associated and recovered after acid digestion; synthesis therefore does not establish downstream bioavailability."}, {"id": "rxn_017", "name": "Glyoxylate condensation with hydroxylamine", "inputs": ["mol_013", "mol_017"], "outputs": ["mol_018", "mol_001"], "environment": "Biochemical", "agents": null, "conditions": {"temperature": "343 K nominal design temperature", "pressure": "Approximately 1 atm", "catalyst": null, "aqueous": true, "other": "Proposed screening window: pH 4-7, glyoxylate 10-100 mM, hydroxylamine at least comparable to glyoxylate, and hours to days. These are design conditions rather than a verified reproduction of the primary experimental recipe. Couple to native-iron reduction without requiring oxime isolation."}, "mechanism": "Hydroxylamine adds to the aldehyde group and loses water to form a glyoxylic acid oxime.", "reasoning": "Hydroxylamine plus metallic iron was used to obtain amino acids from ketoacids, including glyoxylate (Muchowska et al., 2019). Oxime formation is the conventional mechanistic interpretation, but the supplied research does not establish an isolated oxime time course under these conditions. Geological hydroxylamine supply and persistence are additional boundary assumptions."}, {"id": "rxn_018", "name": "Native-iron reduction of glyoxylic acid oxime", "inputs": ["mol_018", "mol_019", "mol_024"], "outputs": ["mol_015", "mol_020", "mol_001"], "environment": "Biochemical", "agents": ["Native Fe(0) powder or exposed meteoritic iron, acting as a consumed reductant and reactive surface"], "conditions": {"temperature": "343 K nominal design temperature", "pressure": "Approximately 1 atm", "catalyst": "Reactive Fe(0) surface; iron is consumed rather than assumed catalytic", "aqueous": true, "other": "Proposed window: pH 4-7 and hours-to-days monitoring. Supply enough accessible Fe(0) for oxime reduction, plus independently assessed corrosion losses. Buffered proton activity, not an unbuffered proton stock, supports the formal ionic balance. Surface passivation and dissolved Fe(II) must be measured."}, "mechanism": "Reduction cleaves the nitrogen-oxygen bond and saturates the carbon-nitrogen bond; Fe(0) is oxidized to Fe(II), with oxygen leaving as water.", "reasoning": "The overall hydroxylamine/metallic-iron amino-acid synthesis is supported by Muchowska et al. (2019). This node exposes reductant consumption that would be hidden by labeling iron only as a catalyst. The isolated-oxime mechanism and stated screening pH/time window are provisional decompositions of the experimentally supported overall transformation."}, {"id": "rxn_019", "name": "Competing glycolonitrile hydrolysis to glycolate", "inputs": ["mol_008", "mol_001"], "outputs": ["mol_016", "mol_003"], "environment": "Surface", "agents": ["Hydronium in the hydrolysis pool"], "conditions": {"temperature": "353-370 K", "pressure": "Approximately 1 atm", "catalyst": "Specific acid catalysis by hydronium", "aqueous": true, "other": "Same proposed pH 0-2 and 1-30 day hydrolysis window as the aminonitrile branch. This sink acts on glycolonitrile that escapes ammonia conversion. The amino/hydroxy product split is established partly during precursor formation, not only during hydrolysis."}, "mechanism": "Sequential nitrile hydration and amide hydrolysis release glycolic acid and ammonia.", "reasoning": "Cyanohydrin chemistry competes with aminoacetonitrile formation in cyanide-derived networks (Patel et al., 2015; Ruiz-Bermejo et al., 2013). Explicit glycolate production prevents the model from treating every cyanide-formaldehyde encounter as productive glycine synthesis. Exact rates must be determined in the same matrix used for rxn_005 and rxn_006."}, {"id": "rxn_020", "name": "Competing hydrogenation of glyoxylate to glycolate", "inputs": ["mol_013", "mol_006"], "outputs": ["mol_016"], "environment": "Biochemical", "agents": ["Ni(0)/SiO2-Al2O3 or characterized meteoritic Fe-Ni metal, used as alternative catalysts rather than a required mixture"], "conditions": {"temperature": "295 K", "pressure": "5 bar H2", "catalyst": "The same metal catalyst used in the coupled reductive-amination experiment", "aqueous": true, "other": "pH 8; total ammonium 6-150 mM; match catalyst loading, surface state and residence to rxn_012 or rxn_013. Measure amino-acid and hydroxy-acid production independently. Reduced ammonia availability increases the importance of direct carbonyl reduction."}, "mechanism": "Metal-activated hydrogen reduces the glyoxylate carbonyl directly, bypassing nitrogen incorporation.", "reasoning": "Amino-acid and hydroxy-acid production compete in the nickel and meteorite experiments (Kaur et al., 2024). Combined product yields cannot be assigned entirely to glycine. This sink shares the same hydrogen inventory and active surface as productive imine hydrogenation, so selectivity must be modeled jointly."}, {"id": "rxn_021", "name": "Competing mineral-driven glyoxylate reduction to glycolate", "inputs": ["mol_013", "mol_021"], "outputs": ["mol_016", "mol_022"], "environment": "Biochemical", "agents": ["Fe(II)-bearing hydroxide interface: either mixed-valence iron hydroxides or ferroan brucite in separate experiments"], "conditions": {"temperature": "343 K for the mixed-hydroxide system; 293 K for ferroan brucite", "pressure": "Approximately 1 atm", "catalyst": "Reactive iron hydroxide interface; ferrous reducing equivalents are consumed", "aqueous": true, "other": "Match pH, ammonium, mineral loading and duration to rxn_014 or rxn_015. These are two experimental settings, not a validated continuous temperature-response curve. Quantify glycolate against glycine and include competition for the finite Fe(II) inventory."}, "mechanism": "Electron and proton transfer from ferrous mineral sites reduces the carbonyl group directly while oxidizing Fe(II) to Fe(III).", "reasoning": "Glycolate is a documented competitor in iron-hydroxide and ferroan-brucite glyoxylate experiments (Barge et al., 2020; Chimiak et al., 2024). In the mixed-valence system it can be comparable to glycine. Including its reductant demand prevents overestimating the amino-acid yield permitted by the mineral electron budget."}, {"id": "rxn_022", "name": "Secondary reductive amination consuming glycine", "inputs": ["mol_015", "mol_013", "mol_021"], "outputs": ["mol_025", "mol_022", "mol_001"], "environment": "Biochemical", "agents": ["Ferroan brucite with remaining accessible structural Fe(II)"], "conditions": {"temperature": "293 K", "pressure": "Approximately 1 atm", "catalyst": "Ferroan brucite reactive interface; structural Fe(II) is consumed", "aqueous": true, "other": "Starting pH approximately 10; glyoxylate-rich mixtures; days to six weeks, matching the brucite incubations. Requires both residual glyoxylate and remaining mineral reducing capacity after glycine first forms. Product formation is not assumed if glycine is inaccessible through adsorption."}, "mechanism": "Glycine's amino group condenses with another glyoxylate molecule; reduction of the resulting imine yields iminodiacetic acid.", "reasoning": "Iminodiacetic acid was identified among ferroan-brucite reaction products (Chimiak et al., 2024). Secondary reductive amination is a chemically justified interpretation, although the isolated sequence was not established by the supplied evidence. This explicitly represents loss of accumulated glycine and additional consumption of the finite ferrous inventory."}], "pathways": [{"pathway_id": "P1", "name": "Aqueous imine-first Strecker pathway", "description": "Form methanimine in an ammonia-rich pool, trap it with cyanide, and hydrolyze the aminonitrile through glycinamide. The alkaline precursor stage and acidic heated hydrolysis stage require sequential conditions or physical transfer; they are not simultaneous one-pot conditions.", "reaction_sequence": ["rxn_001", "rxn_002", "rxn_005", "rxn_006"], "key_intermediates": ["mol_007", "mol_009", "mol_010"]}, {"pathway_id": "P2", "name": "Cyanohydrin-first ammonia-exchange pathway", "description": "Store formaldehyde and cyanide as glycolonitrile, introduce ammonia before hydrolysis, and converge on aminoacetonitrile. This is a distinct precursor-processing path sharing Strecker equilibria with P1, not an independent elementary mechanism. Residual glycolonitrile is lost through rxn_019.", "reaction_sequence": ["rxn_003", "rxn_004", "rxn_005", "rxn_006"], "key_intermediates": ["mol_008", "mol_009", "mol_010"]}, {"pathway_id": "P3", "name": "Hydantoin capture and hydrolytic release pathway", "description": "Capture formaldehyde-derived aminoacetonitrile with inorganic carbon, then open and hydrolyze hydantoin to glycine. The formaldehyde-specific mild formation window and environmental hydrolysis rates are provisional; evidence for other hydantoin substrates is not treated as a measured rate for this sequence.", "reaction_sequence": ["rxn_001", "rxn_002", "rxn_007", "rxn_008", "rxn_009"], "key_intermediates": ["mol_009", "mol_011", "mol_012"]}, {"pathway_id": "P4", "name": "Moderate-temperature hydrothermal Strecker pathway", "description": "Use the experimentally reported 423 K hydrothermal setting for coupled precursor reaction and hydrolysis, represented as one lumped reaction. This temperature-regime variant requires cooling for accumulation and is not extrapolated to black-smoker temperatures.", "reaction_sequence": ["rxn_010"], "key_intermediates": []}, {"pathway_id": "P5", "name": "Hydrogen-supported nickel reductive amination", "description": "Couple in situ glyoxylate-ammonia condensation to hydrogenation on supported Ni(0). This is an experimentally supported low-ammonium laboratory benchmark with an unresolved natural-catalyst analog. Direct glycolate formation through rxn_020 shares the same reductant.", "reaction_sequence": ["rxn_011", "rxn_012"], "key_intermediates": ["mol_014"]}, {"pathway_id": "P6", "name": "Hydrogen-supported meteoritic metal reductive amination", "description": "Couple the same imine-forming equilibrium to hydrogenation on characterized meteoritic Fe-Ni surfaces. This is a catalyst-distinct experimental variant of P5, contingent on accessible metal sites, sustained hydrogen pressure and limited passivation.", "reaction_sequence": ["rxn_011", "rxn_013"], "key_intermediates": ["mol_014"]}, {"pathway_id": "P7", "name": "Mixed-valence iron-hydroxide reductive amination", "description": "Reduce the glyoxylate-derived imine using ferrous sites in an initially mixed Fe(II)/Fe(III) interface. Initial ferric inventory is supplied explicitly rather than generated by an undeclared oxygen exposure. Glycolate competes for the same ferrous inventory through rxn_021.", "reaction_sequence": ["rxn_011", "rxn_014"], "key_intermediates": ["mol_014"]}, {"pathway_id": "P8", "name": "Ammonia-fed ferroan-brucite reductive amination", "description": "Form and reduce the imine within an ammonia-containing ferroan-brucite suspension at approximately 293 K. Structural Fe(II), not glyoxylate alone, limits yield. Long residence, competing glycolate production and secondary glycine consumption must be included in any accumulation model.", "reaction_sequence": ["rxn_011", "rxn_015"], "key_intermediates": ["mol_014"]}, {"pathway_id": "P9", "name": "Nitrate-fed ferroan-brucite coupled nitrogen reduction", "description": "Use nitrate rather than supplied ammonia in a coupled mineral-mediated reduction and amination. The greater electron demand lowers the maximum glycine yield for a fixed Fe(II) inventory. The target includes mineral-associated glycine; acid-digestion recovery is not evidence that free glycine was environmentally available.", "reaction_sequence": ["rxn_016"], "key_intermediates": []}, {"pathway_id": "P10", "name": "Hydroxylamine-oxime pathway with native iron", "description": "Condense glyoxylate with hydroxylamine and reduce the resulting oxime using consumable Fe(0). The overall reagent combination is experimentally supported, while the isolated intermediate sequence and proposed operating window require verification. Hydroxylamine supply is an additional unresolved feedstock boundary.", "reaction_sequence": ["rxn_017", "rxn_018"], "key_intermediates": ["mol_018"]}], "hub_molecules": ["mol_001", "mol_002", "mol_003", "mol_004", "mol_006", "mol_008", "mol_009", "mol_013", "mol_014", "mol_015", "mol_016", "mol_021", "mol_022", "mol_024"], "convergence_points": [{"molecule_id": "mol_001", "incoming_reactions": ["rxn_001", "rxn_004", "rxn_011", "rxn_016", "rxn_017", "rxn_018", "rxn_022"], "outgoing_reactions": ["rxn_005", "rxn_006", "rxn_008", "rxn_009", "rxn_010", "rxn_019"]}, {"molecule_id": "mol_003", "incoming_reactions": ["rxn_006", "rxn_009", "rxn_010", "rxn_019"], "outgoing_reactions": ["rxn_001", "rxn_004", "rxn_010", "rxn_011"]}, {"molecule_id": "mol_009", "incoming_reactions": ["rxn_002", "rxn_004"], "outgoing_reactions": ["rxn_005", "rxn_007"]}, {"molecule_id": "mol_015", "incoming_reactions": ["rxn_006", "rxn_009", "rxn_010", "rxn_012", "rxn_013", "rxn_014", "rxn_015", "rxn_016", "rxn_018"], "outgoing_reactions": ["rxn_022"]}, {"molecule_id": "mol_016", "incoming_reactions": ["rxn_019", "rxn_020", "rxn_021"], "outgoing_reactions": []}, {"molecule_id": "mol_022", "incoming_reactions": ["rxn_014", "rxn_015", "rxn_016", "rxn_021", "rxn_022"], "outgoing_reactions": ["rxn_014"]}]}, "reasoning": "", "duration_ms": 493273.54431152344, "success": true, "error_message": null}
{"timestamp": "2026-10-18T23:09:30.115736", "agent_name": "CriticAgent", "method_name": "evaluate_network", "step": null, "attempt": null, "system_message": "You are evaluating a COMPLETE SYNTHESIS NETWORK, not individual reactions.\n\n## Neutrality\n- Do not reward or penalize a network for using (or not using) any particular feedstock, intermediate,\n  reaction family, or prebiotic framework. Judge only the evidence and the chemistry.\n- The number of shared/hub molecules, the number of convergence points, and the order or number of\n  environments used are NOT scoring criteria.\n\n## Evaluation Criteria\n\n### 1. Network Validity (0.0-1.0)\n- Are there sufficient molecule and reaction nodes?\n- Is the network connected (no isolated subgraphs)?\n- Are molecule IDs used consistently, and are reactions approximately balanced?\n- When a DETERMINISTIC ATOM/CHARGE BALANCE CHECK section is provided, treat it as ground truth for\n  mass and charge conservation; reactions it reports as UNBALANCED are conservation violations.\n\n### 2. Chemical Feasibility (0.0-1.0)\n- Is each reaction chemically sound?\n- Are the conditions appropriate for each environment?\n- Are the mechanisms plausible?\n\n### 3. Environmental Consistency (0.0-1.0)\n- Are each reaction's conditions (temperature, pressure, pH, catalysts, energy source) consistent with its stated environment?\n- If molecules are transferred between environments, is the transfer physically justified?\n- If a catalyst or mineral agent is cited, is it realistic and present in that environment?\n\n### 4. Pathway Coherence (0.0-1.0)\n- Do pathways form valid routes to the target?\n- Are key intermediates properly identified?\n- Is the overall strategy sound?\n\n### 5. Target Achievement (0.0-1.0)\n- Does the network actually produce the target molecule?\n- Are the final steps chemically valid?\n\n### 6. Literature Alignment (0.0-1.0) - When research findings are provided\n- Are reactions supported by experimental evidence from cited studies?\n- Are literature citations present in reaction reasoning?\n- Does the network acknowledge critiques and known challenges identified in the research?\n- Departures from the research are acceptable when explicitly and soundly justified.\n\n## Scoring Guidelines\n- 0.9-1.0: Excellent network, valid and chemically sound\n- 0.8-0.9: Good network with minor issues\n- 0.7-0.8: Acceptable but with notable concerns\n- 0.5-0.7: Significant problems with validity or chemistry\n- 0.0-0.5: Major issues, network is not viable\n\nA network is APPROVED if overall_confidence >= 0.9\n\nOutput your evaluation as JSON matching the NetworkEvaluation schema.\n", "user_message": "Evaluate this synthesis network:\n\nTARGET MOLECULE: Glycine\nOVERALL STRATEGY: Construct ten graph-distinct pathways using experimentally supported Strecker, cyanohydrin, hydantoin and reductive-amination chemistry. Some pathways are experimentally distinct temperature, catalyst or mineral variants of a shared mechanism; they are not ten independent reaction families. The network is complete at a declared feedstock boundary: formaldehyde, HCN, ammonia, glyoxylate, hydroxylamine, hydrogen and reactive mineral inventories are supplied inputs. Their geological production and concentration are not assumed solved, especially for glyoxylate, HCN and hydroxylamine. Competing glycolate formation and secondary glycine consumption are explicit. All settings are anoxic; surface reactions not requiring irradiation occupy water-covered or mineral-shaded locations. Neutral organic acids and NH3 represent analytical acid-base pools rather than their dominant microspecies. Fe(OH)2 and FeOOH represent idealized ferrous and ferric mineral endmember equivalents; they conserve atoms and reducing equivalents without asserting that every experiment produces a pure FeOOH phase. Initial ferric material is an explicitly declared boundary inventory, not material generated using molecular oxygen within this network. A single representative environment_formed is assigned where several environments are possible; null denotes an unspecified boundary origin. Glycine denotes chemical identity, including mineral-associated material, not necessarily freely available dissolved product. The role intermediate also covers terminal coproducts because the schema has no byproduct category. Conditions distinguish reported experimental anchors from proposed screening windows. Slow hydrolysis, mineral passivation, feedstock supply and product desorption remain explicit bottlenecks.\n\nMOLECULES (25 nodes):\n  - mol_001: H2O (water) [starting]\n  - mol_002: CH2O (formaldehyde) [starting]\n  - mol_003: NH3 (ammonia) [starting]\n  - mol_004: CHN (hydrogen cyanide) [starting]\n  - mol_005: CO2 (carbon dioxide) [starting]\n  - mol_006: H2 (hydrogen) [starting]\n  - mol_007: CH3N (formaldimine) [intermediate]\n  - mol_008: C2H3NO (glycolonitrile) [hub_intermediate]\n  - mol_009: C2H4N2 (aminoacetonitrile) [hub_intermediate]\n  - mol_010: C2H6N2O (glycinamide) [intermediate]\n  - mol_011: C3H4N2O2 (hydantoin) [intermediate]\n  - mol_012: C3H6N2O3 (N-carbamoylglycine) [intermediate]\n  - mol_013: C2H2O3 (glyoxylic acid) [starting]\n  - mol_014: C2H3NO2 (glycine imine) [hub_intermediate]\n  - mol_015: C2H5NO2 (glycine) [target]\n  - mol_016: C2H4O3 (glycolic acid) [intermediate]\n  - mol_017: NH3O (hydroxylamine) [starting]\n  - mol_018: C2H3NO3 (glyoxylic acid oxime) [intermediate]\n  - mol_019: Fe (native iron) [starting]\n  - mol_020: Fe2+ (ferrous ion) [intermediate]\n  - mol_021: FeH2O2 (ferrous hydroxide endmember) [starting]\n  - mol_022: FeHO2 (ferric oxyhydroxide endmember) [starting]\n  - mol_023: NO3- (nitrate) [starting]\n  - mol_024: H+ (proton) [starting]\n  - mol_025: C4H7NO4 (iminodiacetic acid) [intermediate]\n\nREACTIONS (22 nodes):\n  - rxn_001: mol_002, mol_003 -> mol_007, mol_001 (Reversible formaldehyde-ammonia condensation) [Surface]\n  - rxn_002: mol_007, mol_004 -> mol_009 (Cyanide trapping of methanimine) [Surface]\n  - rxn_003: mol_002, mol_004 -> mol_008 (Formaldehyde cyanohydrin formation) [Surface]\n  - rxn_004: mol_008, mol_003 -> mol_009, mol_001 (Ammonia-driven conversion of glycolonitrile to aminoacetonitrile) [Surface]\n  - rxn_005: mol_009, mol_001 -> mol_010 (Aminoacetonitrile hydration to glycinamide) [Surface]\n  - rxn_006: mol_010, mol_001 -> mol_015, mol_003 (Glycinamide hydrolysis to glycine) [Surface]\n  - rxn_007: mol_009, mol_005 -> mol_011 (Carbon dioxide trapping of aminoacetonitrile as hydantoin) [Surface]\n  - rxn_008: mol_011, mol_001 -> mol_012 (Hydantoin ring opening to N-carbamoylglycine) [Surface]\n  - rxn_009: mol_012, mol_001 -> mol_015, mol_003, mol_005 (N-carbamoylglycine hydrolysis and carbon dioxide release) [Surface]\n  - rxn_010: mol_002, mol_003, mol_004, mol_001 -> mol_015, mol_003 (Moderate-temperature hydrothermal Strecker synthesis, lumped) [Hydrothermal]\n  - rxn_011: mol_013, mol_003 -> mol_014, mol_001 (Reversible glyoxylate-ammonia condensation to glycine imine) [Biochemical]\n  - rxn_012: mol_014, mol_006 -> mol_015 (Hydrogenation of glycine imine over supported nickel) [Biochemical]\n  - rxn_013: mol_014, mol_006 -> mol_015 (Hydrogenation of glycine imine on meteoritic Fe-Ni material) [Biochemical]\n  - rxn_014: mol_014, mol_021, mol_022 -> mol_015, mol_022 (Glycine imine reduction by mixed-valence iron hydroxides) [Biochemical]\n  - rxn_015: mol_014, mol_021 -> mol_015, mol_022 (Glycine imine reduction by ferroan brucite) [Biochemical]\n  - rxn_016: mol_013, mol_023, mol_021, mol_024 -> mol_015, mol_022, mol_001 (Coupled nitrate reduction and glyoxylate amination on ferroan brucite) [Biochemical]\n  - rxn_017: mol_013, mol_017 -> mol_018, mol_001 (Glyoxylate condensation with hydroxylamine) [Biochemical]\n  - rxn_018: mol_018, mol_019, mol_024 -> mol_015, mol_020, mol_001 (Native-iron reduction of glyoxylic acid oxime) [Biochemical]\n  - rxn_019: mol_008, mol_001 -> mol_016, mol_003 (Competing glycolonitrile hydrolysis to glycolate) [Surface]\n  - rxn_020: mol_013, mol_006 -> mol_016 (Competing hydrogenation of glyoxylate to glycolate) [Biochemical]\n  - rxn_021: mol_013, mol_021 -> mol_016, mol_022 (Competing mineral-driven glyoxylate reduction to glycolate) [Biochemical]\n  - rxn_022: mol_015, mol_013, mol_021 -> mol_025, mol_022, mol_001 (Secondary reductive amination consuming glycine) [Biochemical]\n\nPATHWAYS (10):\n  - P1: Aqueous imine-first Strecker pathway (4 steps)\n  - P2: Cyanohydrin-first ammonia-exchange pathway (4 steps)\n  - P3: Hydantoin capture and hydrolytic release pathway (5 steps)\n  - P4: Moderate-temperature hydrothermal Strecker pathway (1 steps)\n  - P5: Hydrogen-supported nickel reductive amination (2 steps)\n  - P6: Hydrogen-supported meteoritic metal reductive amination (2 steps)\n  - P7: Mixed-valence iron-hydroxide reductive amination (2 steps)\n  - P8: Ammonia-fed ferroan-brucite reductive amination (2 steps)\n  - P9: Nitrate-fed ferroan-brucite coupled nitrogen reduction (1 steps)\n  - P10: Hydroxylamine-oxime pathway with native iron (2 steps)\n\n\n=== DETERMINISTIC ATOM/CHARGE BALANCE CHECK (RDKit) ===\nComputed programmatically from each molecule's InChI (via RDKit) or stated formula. Reactions list no coefficients, so a reaction counts as balanced if some positive integer coefficients (<= 24) conserve every element and net charge.\nSummary: 22 reactions | 15 balanced as written | 7 balanceable with coefficients | 0 UNBALANCED | 0 unchecked\n  - rxn_014 balanceable: C2H3NO2 + 2 FeH2O2 + 3 FeHO2 -> C2H5NO2 + 3 FeHO2\n  - rxn_015 balanceable: C2H3NO2 + 2 FeH2O2 -> C2H5NO2 + 2 FeHO2\n  - rxn_016 balanceable: C2H2O3 + NO3- + 10 FeH2O2 + H+ -> C2H5NO2 + 10 FeHO2 + 4 H2O\n  - rxn_018 balanceable: C2H3NO3 + 2 Fe + 4 H+ -> C2H5NO2 + 2 Fe2+ + H2O\n  - rxn_019 balanceable: C2H3NO + 2 H2O -> C2H4O3 + NH3\n  - rxn_021 balanceable: C2H2O3 + 2 FeH2O2 -> C2H4O3 + 2 FeHO2\n  - rxn_022 balanceable: C2H5NO2 + C2H2O3 + 2 FeH2O2 -> C4H7NO4 + 2 FeHO2 + H2O\nFormula/structure inconsistencies:\n  - mol_020 (ferrous ion): stated formula Fe2+ disagrees with its InChI structure (stated minus InChI: Fe+1, charge 1 vs 2)\nTreat this check as ground truth for mass and charge conservation. Reactions that cannot be balanced violate conservation: reflect this in chemical_feasibility and reaction_scores, list them in problematic_reactions, and name the specific reaction IDs (with the missing species, if hinted) in your feedback so the network can be corrected. Note that implausibly large inferred coefficients may also indicate a mis-specified reaction.\n=== END BALANCE CHECK ===\n\n\n=== LITERATURE RESEARCH ON TARGET MOLECULE ===\nThe following research was conducted on the target molecule before network generation. Use it to assess whether the network aligns with known prebiotic chemistry literature.\n\n=== DEEP RESEARCH FINDINGS ===\n# Prebiotic Synthesis of Glycine: A Cross-Framework Evidence Review\n\nGlycine can be made by more prebiotic routes than any other amino acid, and every major framework produces it. The question is not whether glycine can form abiotically but which route was geochemically realistic, and that is still contested. Two routes are best supported experimentally. The first is cyanide/aldehyde (Strecker-type) chemistry, which runs through aminoacetonitrile and is evidenced by spark discharge, HCN oligomers, cyanosulfidic chemistry, hydrothermal Strecker runs and meteorites. The second is reductive amination of glyoxylate over Fe- or Ni-bearing minerals. Neither route has an undisputed answer to where its feedstock comes from.\n\n## TL;DR\n- **Glycine is the most robust product of prebiotic chemistry in every framework.** It is the dominant or reference amino acid in Miller-type spark discharges, HCN-oligomer hydrolysates, hydrothermal Strecker runs, impact-shock runs, and in samples from Murchison-type meteorites, Ryugu, Bennu and comets. Bennu is the clearest case: glycine was its most abundant amino acid, at 44 nmol g\u207b\u00b9.\\[1\\]\n- **The two leading chemical routes start from different feedstocks.**\n  - Strecker/cyanosulfidic routes use HCN + H\u2082CO + NH\u2083 via aminoacetonitrile, and need no catalyst.\n  - Reductive amination of glyoxylate (HC(O)COO\u207b) + NH\u2083 needs a reductant: Fe\u00b2\u207a, Fe(II)/Fe(III) hydroxides, ferroan brucite, FeS\u2192Fe\u2070, or H\u2082 over Ni/meteoritic metal.\n  - Kaur et al. (2024, *Chem*) ran the second route at 22 \u00b0C, pH 8, with NH\u2084\u207a as low as 6 mM.\\[2\\]\n  - Each camp's central critique is the other's strength. Cyanide routes have no clean geological source of concentrated HCN and are poorly congruent with ketoacid-based metabolism. Glyoxylate routes have no demonstrated, efficient prebiotic source of glyoxylate.\n- **For network design:** treat aminoacetonitrile and glyoxylate/glycine imine as the two hub intermediates. Model the Strecker branch as a competition between amino- and hydroxy-acid products, set by [NH\u2083]/[HCN]. Treat the high-temperature (>200 \u00b0C) hydrothermal, atmospheric neutral-gas, and delivery-only scenarios as contested or yield-limited rather than established.\n\n## Key Findings\n\n| Route | Feedstocks | Key intermediates | Conditions | Catalyst | Representative yield data | Status |\n|---|---|---|---|---|---|---|\n| Spark discharge (reducing) | CH\u2084, NH\u2083, H\u2082, H\u2082O (\u00b1H\u2082S) | HCN, H\u2082CO \u2192 aminoacetonitrile | Electric discharge, aqueous trap, ~1 week | None | Glycine 2.1%, 1.8%, 0.4% of CH\u2084 carbon in Miller's three apparatus\\[3\\] | Chemistry robust; atmosphere composition contested |\n| Spark discharge (neutral CO\u2082/N\u2082) | CO\u2082, N\u2082, H\u2082O | HCN (low), nitrite/nitrate interference | Discharge + carbonate buffer | None | Cleaves et al. 2008 reported several-hundred-fold higher yields with ascorbate\\[4\\] | Contested (ascorbate artifact) |\n| Strecker (aqueous) | HCN, H\u2082CO, NH\u2083 | Methanimine, aminoacetonitrile, glycinamide; side product glycolonitrile \u2192 glycolate | Ambient to 100 \u00b0C, pH ~8\u20139 | None | Product ratio depends on [NH\u2083], pH, T | Mechanism uncontested; feedstock concentration contested |\n| HCN oligomer hydrolysis | HCN (\u22650.1 M), NH\u2083 | Diaminomaleonitrile, oligomers, hydantoins | pH ~9.2, then acid/base hydrolysis | None | Glycine the highest-yield amino acid across all conditions assayed | Robust chemistry; needs concentrated HCN |\n| Cyanosulfidic (Sutherland) | HCN, H\u2082S, Cu(I)/ferrocyanide, UV, NH\u2083 | Glycolonitrile \u2192 aminoacetonitrile | UV (254 nm), phosphate, flow/stream scenario | Cu(I)\u2013Cu(II) photoredox | Glycine via glycolonitrile/aminoacetonitrile | Contested (multi-step choreography, cyanide supply) |\n| Bucherer\u2013Bergs/hydantoin | Ketoacids/aldehydes + HCN + NH\u2083 + CO\u2082 | Aminonitrile \u2192 carbamate \u2192 hydantoin | 20 \u00b0C formation; ~80 \u00b0C hydrolysis | None | Ketoacids \u2192 \u03b1-amino acids (Pulletikurti et al. 2022) | Promising; still cyanide-dependent |\n| Glyoxylate reductive amination: Fe\u00b2\u207a/Fe\u2070 | Glyoxylate, NH\u2083 or NH\u2082OH | Glycine imine / hemiaminal | 70 \u00b0C, aqueous | Fe\u00b2\u207a, Fe\u2070 | Glycine detected; glycine imine route NMR yield ~2\u20133% with FeSO\u2084\\[5\\] | Accepted chemistry; glyoxylate source contested |\n| Glyoxylate on iron (oxy)hydroxides / green rust | Glyoxylate, NH\u2084\u207a | Glycine imine | 70 \u00b0C, pH 7\u201310, 375 mM NH\u2084Cl | Mixed-valence Fe(OH)\u2093 | Glycine \u2248 glycolate at ~50% Fe(II)\\[6\\] | Plausible for alkaline vents/sediments |\n| Ferroan brucite (serpentinite) | Glyoxylate + NH\u2084\u207a or NO\u2083\u207b | Glycine imine | 20 \u00b0C, ~1 atm, pH 10 start | Fe(II) in brucite | 52\u201369% (NH\u2084\u207a) and 0.1\u20133.1% (NO\u2083\u207b) glycine at 6 weeks\\[7\\] | New (2024); single lab |\n| H\u2082/Ni or meteoritic metal | Glyoxylate/ketoacids, NH\u2084\u207a (6\u2013150 mM), H\u2082 | Imine | 22 \u00b0C, pH 8, 5 bar H\u2082 | Ni/SiO\u2082\u2013Al\u2082O\u2083, Pd, ground iron meteorites | 6\u201384% combined amino + hydroxy acid (Ni) | Promising; synthetic catalysts used |\n| CO/cyanide on Ni,Fe precipitates (Huber & W\u00e4chtersh\u00e4user) | CO, KCN, CH\u2083SH, Ni/Fe(S) | Formaldehyde/cyanohydrin analogues | 80\u2013120 \u00b0C, 75 bar CO | Ni, (Ni,Fe) precipitates \u00b1 sulfide | \u03b1-hydroxy and \u03b1-amino acids incl. glycine | Strongly contested (0.1\u20130.2 M KCN, CO pressure) |\n| Hydrothermal Strecker | HCN, H\u2082CO, NH\u2084Cl, CO\u2082/H\u2082 | Aminoacetonitrile | 150 \u00b0C, 10 bar | Pyrite\u2013pyrrhotite\u2013magnetite buffer | 9.3\u201311.6 mM glycine\\[8\\] | Contested (stability above ~200 \u00b0C) |\n| Impact shock | C/Fe/Ni + H\u2082O + NH\u2083; HCOONH\u2084; NH\u2084HCO\u2083; CO\u2082/N\u2082 | Unclear (radical, water-splitting) | 1 km/s, up to tens of GPa | Meteoritic Fe/Ni | 1\u00d710\u207b\u2076 to 1\u00d710\u207b\u00b3 mol% | Real but very low yield |\n| Interstellar ice (non-energetic) | CH\u2083NH\u2082/NH\u2082CH\u2082 radical, CO, OH, H | HOCO + NH\u2082CH\u2082 radical | ~13 K, H/O atom addition | Water-ice surface | Detected by TPD/RAIR | Delivery-relevant only |\n| Interstellar ice (UV) | H\u2082O, CH\u2083OH, NH\u2083, CO, HCN | Radicals; aminoacetonitrile | UV, ~10 K, then warm-up/hydrolysis | None | Glycine among racemic amino acids | Delivery-relevant only |\n\n## Details\n\n### 1. Atmospheric/spark-discharge synthesis (Miller\u2013Urey and reanalyses)\n\n**Chemistry.** The discharge makes HCN and aldehydes in the gas phase. These dissolve, and glycine forms in the aqueous trap by Strecker chemistry: H\u2082CO + NH\u2083 + HCN \u2192 aminoacetonitrile \u2192 glycinamide \u2192 glycine.\\[9\\] No catalyst is needed.\n\n**Evidence.**\n- Miller reported glycine yields of 2.1%, 1.8% and 0.4%, based on carbon added as methane, for his three apparatus.\\[3\\] These are summarized in Johnson, Cleaves, Dworkin, Glavin, Lazcano & Bada (2008, *Science* 322:404).\n- Johnson et al. reanalyzed Miller's archived vials with modern methods. They found 22 amino acids and five amines in the \"volcanic\" (steam-injected) apparatus. That apparatus produced a wider variety than the classic design, at comparable or higher yields.\\[10\\]\\[11\\]\n- Parker et al. (2011, *PNAS*) reanalyzed a 1958 Miller run with H\u2082S, CH\u2084, NH\u2083 and CO\u2082. It contained 23 amino acids and 4 amines, including 7 organosulfur compounds.\\[12\\] In both reanalyses glycine and alanine were made at much higher concentrations than any other proteinogenic amino acid.\\[13\\]\n\n**Neutral atmospheres.**\n- Cleaves, Chalmers, Lazcano, Miller & Bada (2008, *Origins of Life and Evolution of Biospheres* 38:105\u2013115) argued that earlier low yields from CO\u2082/N\u2082 were partly artifacts. In their view, nitrite and nitrate made in the discharge oxidized the amino acids or their precursors.\\[4\\] With carbonate buffering and an oxidation inhibitor (ascorbate), they reported much higher yields.\\[14\\]\n- **Critique:** Kuwahara et al. (2012, *Origins of Life and Evolution of Biospheres*, \"A cautionary note\") used isotope labeling. They concluded that ascorbate \"contributes amino acid contaminants\" by reacting with discharge-derived nitrogen species and formate, and that \"amino acids are not efficiently formed from a CO\u2082-rich atmosphere under the conditions studied.\"\\[4\\]\n- Takeuchi et al. (2020, *Scientific Reports*) also note that Plankensteiner et al.'s neutral-gas synthesis depended on oxidation of a Cu electrode, which is not available in natural lightning.\\[15\\]\n\n**Assessment.** The chemistry is not in doubt. What is contested is the geochemistry: most current models favor a weakly reducing to neutral N\u2082\u2013CO\u2082 Hadean atmosphere, where HCN output collapses. Supporters answer that local reducing settings, such as volcanic plumes rich in reduced gases (Johnson et al. 2008) or atmospheres after impacts, could reproduce the reducing chemistry.\\[11\\]\n\n### 2. Aqueous Strecker synthesis (aminoacetonitrile route)\n\n**Steps.**\n1. H\u2082CO + NH\u2083 \u21cc methanimine (CH\u2082=NH).\n2. CH\u2082=NH + HCN \u21cc aminoacetonitrile (NH\u2082CH\u2082CN). This competes with H\u2082CO + HCN \u21cc glycolonitrile (HOCH\u2082CN).\n3. Irreversible hydrolysis of aminoacetonitrile to glycinamide and then glycine. Glycolonitrile hydrolyzes to glycolate.\n\n**Conditions and kinetics.** Miller and co-workers measured the equilibrium constants for forming glycine nitrile and the kinetics of its hydrolysis (\"The Strecker Synthesis in the Primitive Ocean,\" in *Origin of Life*). They showed that the amino-acid/hydroxy-acid split can be calculated from pH, temperature and NH\u2083 concentration.\\[16\\] In practice the amino-acid branch is favored at mildly alkaline pH (~8\u20139), with NH\u2083 comparable to or above HCN.\n\n**Catalyst.** None is required. The steps run uncatalyzed in water.\n\n**Critiques.**\n- It requires simultaneous, non-trivial steady-state concentrations of HCN, H\u2082CO and NH\u2083.\n- Formaldehyde is also consumed by the formose reaction and by cyanohydrin formation.\n- Glycolate competes as a by-product.\n- Kaur et al. (2024) argue that \"cyanide is never directly used in metabolism and is toxic\" and that \"its relevance to metabolic origins is questionable.\"\\[2\\] This is a congruence argument from the metabolism-first camp, not a chemical refutation.\n\n### 3. Bucherer\u2013Bergs/hydantoin variant\n\nAdding CO\u2082 (or bicarbonate) traps the aminonitrile as a carbamate, which cyclizes to a hydantoin. Hydrolysis of the hydantoin releases the amino acid.\n\n- Pulletikurti, Yadav, Springsteen & Krishnamurthy (2022, *Nature Chemistry* 14:1142\u20131150) showed that \u03b1-ketoacids react with cyanide and ammonia sources by the Bucherer\u2013Bergs pathway to give \u03b1-amino acids, and also dihydroorotate and orotate.\\[17\\]\n- As Kaur et al. (2024) summarize, the conditions were hydantoin formation at 20 \u00b0C followed by decarboxylative hydrolysis at 80 \u00b0C.\\[2\\]\n- Hydantoins, including 5,5-dimethylhydantoin and 5-carboxymethylidene hydantoin, are also released when HCN oligomers are hydrolyzed (Ferris et al. 1974). Hydantoin hydrolyzes to glycine under acidic conditions.\\[18\\]\\[19\\]\n- **Significance:** this is the most explicit attempt to link cyanide chemistry with ketoacid (metabolic) substrates. **Critique:** it remains cyanide-dependent.\n\n### 4. HCN oligomer hydrolysis\n\n- Ferris, Joshi, Edelson & Lawless (1978, *Journal of Molecular Evolution* 11:293\u2013311) showed that dilute (0.1 M) HCN oligomerizes at pH 9.2. Hydrolysis of the oligomers releases purines, pyrimidines and amino acids.\\[20\\]\n- Ferris, Wos, Nooner & Or\u00f3 (1974, *J. Mol. Evol.*) identified glycine, aspartic acid and diaminosuccinic acid as the major amino acids.\\[21\\]\n- In a review, Ruiz-Bermejo, Zorzano & Osuna-Esteban (2013, *Life* 3:421) found that glycine and aspartic acid were \"the only amino acids that can be identified under all conditions assayed (twenty three sets of experimental conditions).\" They also found that \"glycine is the amino acid that is always obtained with the greatest yield.\"\\[22\\]\n- Or\u00f3 & Kamat (1961, *Nature* 190:442) first reported amino acid synthesis from HCN. UV irradiation of dilute HCN (Abelson) also gives glycine.\\[22\\]\n- **Critiques:**\n  - It needs HCN at \u22650.01\u20130.1 M. That probably requires eutectic freezing or evaporative concentration.\n  - The oligomers are intractable mixtures.\n  - Hydrazinolysis released only 10% of the amino acids released by acid hydrolysis, and no peptide bonds were found (Ferris et al., *J. Mol. Evol.*).\\[23\\] This argues against \"HCN polymers as proto-proteins\" (Matthews), not against glycine release.\n\n### 5. Cyanosulfidic/systems chemistry (Sutherland)\n\n- Patel, Percivalle, Ritson, Duffy & Sutherland (2015, *Nature Chemistry* 7:301\u2013307) showed that precursors of ribonucleotides, amino acids and lipids can all come from reductive homologation of HCN.\\[24\\]\n- The reductant is H\u2082S, with Cu(I)/Cu(II) photoredox cycling under UV, and phosphate is present.\\[25\\]\n- Glycine forms when glycolonitrile is exposed to ammonia to give aminoacetonitrile, which is then hydrolyzed. Glycolonitrile is the HCN/formaldehyde cyanohydrin and a branch point toward glycolaldehyde.\n- The proposed setting is surface streams and pools on a post-impact landscape. Ferrocyanide salts store cyanide, and different steps happen in different pools (\"flow chemistry\").\\[26\\]\n- **Critiques:**\n  - It needs sequential delivery of reagents and a high-UV, cyanide-rich surface environment.\n  - It needs sulfide as the reductant from the start, which may belong to a later geochemical stage.\\[27\\]\n  - It shares the cyanide-congruence objection.\n- **Supporters' answer:** it is the only route shown to deliver glycine together with nucleotide and lipid precursors from a single feedstock family.\n\n### 6. Reductive amination of glyoxylate (metal/mineral-mediated)\n\n**Mechanism.** Glyoxylate + NH\u2083 \u21cc hemiaminal (\u03b1-hydroxyglycine) \u21cc glycine imine (HN=CH\u2013COO\u207b), which a metal, mineral or H\u2082/metal surface then reduces to glycine. Direct reduction gives glycolate instead.\n\n- Paczelt et al. (2023, *Angewandte Chemie Int. Ed.*) isolated glycine imine for the first time. They showed that in water it hydrolyzes back to hydroxyglycine and hydrated glyoxylic acid. With FeSO\u2084 or at higher concentration it gives glycine, but \"the NMR yield\u2026 was approximately 2\u20133%.\"\\[5\\]\n- Mayer & Moran (2022, *Angew. Chem.*) measured inherent reactivities with BH\u2083CN\u207b. Glyoxylate was by far the most reactive biological keto acid toward reductive amination (\u03b1-ketoglutarate < oxaloacetate \u2248 pyruvate \u226a glyoxylate).\\[28\\] This makes glycine the kinetically easiest amino acid to obtain on this route.\n\n**Experimental systems:**\n- **Fe\u00b2\u207a/Fe\u2070 (Muchowska, Varma & Moran 2019, *Nature* 569:104\u2013107).**\n  - In this Fe\u00b2\u207a-promoted network, pyruvate and glyoxylate build up 9 of the 11 Krebs-cycle intermediates.\\[29\\]\n  - Adding hydroxylamine and metallic iron gave glycine, alanine, aspartate and glutamate. Reductive amination was confirmed by exposing glyoxylate, pyruvate, oxaloacetate and \u03b1-ketoglutarate to the same conditions.\\[29\\]\\[30\\]\n  - The authors describe pyruvate and glyoxylate as \"two products of abiotic CO\u2082 reduction.\"\\[29\\]\n- **Iron oxyhydroxides/green rust (Barge et al.).**\n  - Barge, Flores, Baum, VanderVelde & Russell (2019, *PNAS* 116:4828\u20134833) studied pyruvate \u2192 alanine, not glycine. Alanine was maximal (~70%) at pH 10, Fe(II):Fe(III) = 1:1 and 70 \u00b0C. Purely ferrous hydroxide gave only lactate, and ferric hydroxide gave no reaction.\\[31\\]\n  - The glycine data are in Barge et al. (2020, *JGR Planets* 125, e2020JE006423). Conditions were 2.5 mM glyoxylate, 375 mM NH\u2084Cl, 70 \u00b0C and pH 7\u201310.\\[32\\]\n  - At ~50% Fe(II), glycine and glycolate formed in roughly equal amounts.\\[6\\]\n  - Without minerals, glyoxylate produced glycine slowly at NH\u2084Cl \u2265 ~10 mM.\\[6\\]\n  - In the same paper's run with 33% Fe(II) minerals at 70 \u00b0C, pH 10, for 1 week, \"glycine and alanine can still be produced \u2026 even at much lower [NH4Cl] concentrations (5 mM),\" which was the lowest concentration tested. The primary text gives no glycine percent yield at that concentration.\n- **Ferroan brucite (Chimiak, Hara, Sessions & Templeton 2024, *PNAS* 121:e2408248121).**\n  - Conditions: ferroan brucite (Fe\u2080.\u2083\u2083Mg\u2080.\u2086\u2087(OH)\u2082), 100 mM glyoxylate, 100 mM NH\u2084Cl or KNO\u2083, ~20 \u00b0C, ~1 atm, pH 10 start.\\[7\\]\\[33\\]\n  - Glycine yields at 6 weeks were 52 \u00b1 4% to 69 \u00b1 15% with ammonia and 0.1\u20133.1% with nitrate.\\[7\\] These are relative to the starting reagents. The brucite's Fe(II) was actually the limiting reagent: it could support at most 31.25 mM amino acid in the ammonia system and 6.25 mM glycine in the nitrate system (Chimiak et al. 2024).\n  - Up to 97% of the glycine in the nitrate systems was bound to the mineral and appeared only after acid digestion.\\[34\\]\n  - By-products: glycolate, tartrate, 3-hydroxyaspartate and iminodiacetic acid.\\[35\\]\n  - Significance: nitrate reduction and amination are coupled on a serpentinization mineral, which partly addresses where reduced nitrogen comes from.\\[35\\]\n- **H\u2082 over Ni/meteoritic metal (Kaur et al. 2024, *Chem* 10:1528\u20131540).**\n  - Conditions: H\u2082 at 5 bar, 22 \u00b0C, pH 8, NH\u2084\u207a at 6\u2013150 mM.\\[2\\]\\[36\\]\n  - Catalysts: Ni/SiO\u2082\u2013Al\u2082O\u2083 (10 mol% Ni), Pd/C (1 mol%) and ground iron meteorites. Together they converted glyoxylate and six biological ketoacids into the corresponding amino acids.\\[2\\]\\[37\\]\n  - Ni and meteorite catalysts gave 6\u201384% combined yields in a roughly 1:1 amino:hydroxy acid ratio. Pd gave 52\u201388% with more than 5:1 selectivity for the amino acid.\\[2\\]\n  - There was no reduction without a metal catalyst.\\[2\\]\n  - The authors note that earlier Fe-based work used 375 mM to 1.5 M ammonia, 62\u2013250 times higher than their 6 mM.\\[2\\]\n- **FeS electroreduction (Kitadai et al. 2019, *Science Advances* 5:eaav7848).**\\[38\\]\n  - Electroreduction of FeS to Fe\u2070 at about \u22120.55 V vs SHE could have happened at alkaline vent\u2013seawater interfaces.\\[39\\] The Fe\u2070 formed promotes reductive amination of \u03b1-keto acids.\n  - The authors note that FeS itself promotes amination only \"slightly,\" at pH 8\u201310.\\[39\\]\n- **Cyanide as reductant.** Yadav, Pulletikurti, Yerabolu & Krishnamurthy (2022, *Nature Chemistry* 14:170\u2013178) showed that cyanide can act as the reductant in a protometabolic reductive glyoxylate pathway.\\[40\\]\\[41\\]\n\n**Where glyoxylate comes from (the key bottleneck):**\n- Proposed sources include abiotic CO\u2082 reduction, though C\u2082 glyoxylate from CO\u2082 is far less established than formate, acetate or pyruvate.\n- Eschenmoser's \"glyoxylate scenario\" derives it from HCN.\n- Transamination of serine and glycine by the Krishnamurthy group gives pyruvate and glyoxylate, but this uses glycine as an input.\\[42\\]\n- Varma et al. (2018, *Nature Ecology & Evolution*) showed native iron reducing CO\u2082 to acetate and pyruvate. Preiner et al. (2020) showed greigite, magnetite and awaruite (Ni\u2083Fe) fixing CO\u2082 with H\u2082 at 100 \u00b0C under alkaline conditions.\\[2\\] Neither established an efficient glyoxylate supply.\n- **The glyoxylate route is therefore chemically clean but upstream-incomplete.**\n\n### 7. Transamination\n\nGlycine can also form nonenzymatically by transamination from another amino acid to glyoxylate. Pyridoxal/pyridoxamine systems speed this up. Kaur et al. report that pyridoxal improves nickel-catalyzed reductive amination. Schlikker et al. (2025, *FEBS Journal* 292:3041\u20133055) then made pyridoxamine from pyridoxal \"by reaction with NH3 (as little as 5 mM) and H2 (5 bar) on Ni\u2070 as catalyst at pH 11 and 80 \u00b0C within hours,\" under serpentinizing conditions. **Critique:** transamination redistributes nitrogen rather than fixing it. Net nitrogen still has to enter by reductive amination or Strecker chemistry.\\[43\\]\n\n### 8. Hydrothermal / Fischer\u2013Tropsch-type / serpentinization routes\n\n- **Hydrothermal Strecker.** Hennet, Holm & Engel (1992, *Naturwissenschaften* 79:361\u2013365) reacted HCN, CH\u2082O and NH\u2084Cl at 150 \u00b0C and 10 bar under a CO\u2082/H\u2082 (3:1) gas phase, with redox buffered by pyrite\u2013pyrrhotite\u2013magnetite.\\[44\\] Glycine reached 9.3\u201311.6 mM after 25\u201354 h, roughly 10 times alanine. These values come from Andersson & Holm 2000 (*Origins of Life and Evolution of the Biosphere* 30:9\u201323, Table I), because the primary paper was not accessible.\\[8\\]\n- **Huber & W\u00e4chtersh\u00e4user (2006, *Science* 314:630\u2013632).** They reported CO-dependent formation of an ordered series of \u03b1-hydroxy and \u03b1-amino acids, including glycine and alanine, at 80\u2013120 \u00b0C. Catalysts were Ni or Ni,Fe precipitates with carbonyl, cyano and methylthio ligands, with Ca(OH)\u2082 or Mg(OH)\u2082 as buffer.\\[45\\]\n  - **Published critique:** Bada, Fegley, Miller, Lazcano, Cleaves, Hazen & Chalmers (2007, *Science* 315:937 letter) argued that the chemistry needs \"a steady-state concentration of 0.1 to 0.2 M KCN at 100 \u00b0C\" with \"no such robust sources\" known. They called 75 bar CO \"implausible\" by outgassing models, and argued the products are just cyanide/formaldehyde chemistry.\\[46\\]\n  - W\u00e4chtersh\u00e4user and Huber replied in the same issue.\\[46\\]\n  - Kitadai and co-workers similarly note that the scenario \"required a high pressure of CO (1 bar or more).\"\\[47\\]\n- **Stability critique.** Bada, Miller & Zhao (1995, *Origins of Life and Evolution of the Biosphere* 25:111\u2013118) showed amino acids are \"irreversibly destroyed by heating at 240 \u00b0C.\" They argued that quasi-equilibrium thermodynamic calculations, which had predicted favorable amino acid synthesis in vents (Amend & Shock 1998), \"give misleading descriptions.\"\\[48\\]\\[49\\] Aubrey, Cleaves & Bada (2009, *Origins of Life and Evolution of Biospheres* 39:91\u2013108) extended this and concluded that high-temperature vents are more likely sinks than sources of amino acids.\\[50\\]\n- **Natural-sample evidence.** M\u00e9nez et al. (2018, *Nature* 564:59\u201363) found abiotic aromatic amino acids, chiefly tryptophan, in serpentinized harzburgite 173 m below the Atlantis Massif seafloor. They proposed Friedel\u2013Crafts synthesis catalyzed by Fe-rich saponite. **No glycine was reported**, and the mechanism is stated with hedging (\"may have been formed\").\\[51\\]\n- **Recent critique.** Tutolo (2026, *PNAS* 123(36):e2613108123, \"Rethinking the origin of life at seafloor hydrothermal vents\") argues that ancient Lost City-type vents would have been virtually sulfide-free. His conference abstract of the same title says that \"because peridotite contains little sulfur and the ancient oceans were sulfate-poor, the elements required to produce sulfide minerals in alkaline vent chimneys would have been scarce.\" He also argues that complex organic synthesis there would be kinetically frustrated. Both points weaken sulfide-dependent vent scenarios.\n- **Net:** moderate-temperature (20\u2013100 \u00b0C) alkaline, serpentinizing settings are much better supported for glyoxylate amination than >200 \u00b0C black-smoker settings are for any glycine route.\n\n### 9. Impact-shock synthesis\n\n- Furukawa, Sekine, Oba, Kakegawa & Nakazawa (2009, *Nature Geoscience* 2:62\u201366) made glycine, amines and carboxylic acids by shocking solid carbon, iron, nickel, water and nitrogen/ammonia, simulating an oceanic impact. Maximum glycine yield was ~1\u00d710\u207b\u2076 mol%.\\[52\\]\\[53\\]\n- Suzuki et al. (2015, *Geochemistry, Geophysics, Geosystems*) reached ~1\u00d710\u207b\u00b3 mol% from ammonium formate and ~1\u00d710\u207b\u2075 mol% from ammonium bicarbonate at 10\u201318 GPa.\\[52\\]\n- Takeuchi et al. (2020, *Scientific Reports*) reported impact-induced amino acid formation from CO\u2082/N\u2082-derived feedstocks relevant to Hadean Earth and Noachian Mars.\n- Shocked cometary-ice analogues gave glycine, alanine and others (Martins et al. 2013, *Nature Geoscience*). Ab initio molecular dynamics predicts glycine-containing complexes form during cometary impact (Goldman et al. 2010, *Nature Chemistry*).\\[54\\]\\[55\\]\n- Glycine partly survives impact, though with decarboxylation to methylamine (Umeda et al. 2016, *Journal of Biological Physics*).\\[56\\]\n- **Critique:** yields are orders of magnitude below solution chemistry. The process is episodic and destructive as well as creative.\n\n### 10. Interstellar ice, meteorites, comets and returned samples\n\n**Lab ice chemistry.**\n- UV photolysis of H\u2082O/CH\u2083OH/NH\u2083/CO/HCN ices followed by warm-up and hydrolysis gives racemic amino acids including glycine (Bernstein et al. 2002 and Mu\u00f1oz Caro et al. 2002, both *Nature* 416).\\[57\\]\n- Ioppolo, Fedoseev, Chuang, Cuppen, Clements, Jin, Garrod, Qasim, Kofman, van Dishoeck & Linnartz (2021, *Nature Astronomy* 5:197\u2013205) made glycine at ~13 K by recombining HOCO with the NH\u2082CH\u2082 radical. They report that \"glycine forms without the need for energetic irradiation, such as UV photons and cosmic rays, in interstellar water-rich ices,\" and that \"solid methylamine is an important side-reaction product.\"\n- **Caveat** (raised in commentary): the methylamine and O\u2082 precursors are themselves thought to need energetic processing.\\[58\\]\n\n**Small-body samples.**\n- **Stardust/Wild 2:** glycine with \u03b4\u00b9\u00b3C = +29 \u00b1 6\u2030 (Elsila, Glavin & Dworkin 2009, *Meteoritics & Planetary Science* 44:1323\u20131330). This was the first cometary amino acid. Co-detected \u03b5-aminocaproic acid (\u03b4\u00b9\u00b3C \u221225\u2030) was Nylon-6 contamination.\\[59\\]\n- **Rosetta/67P:** ROSINA detected volatile glycine together with methylamine and ethylamine. Glycine/H\u2082O ranged from 0 to 0.16% and correlated with dust (Altwegg et al. 2016, *Science Advances* 2:e1600285).\\[60\\] Modeling suggests the glycine was released from dust as a distributed source, at roughly 170 ppb in the nucleus (Hadraoui et al. 2019, *Astronomy & Astrophysics*).\\[61\\]\n- **Ryugu:** 15 quantified amino acids, all approximately racemic. Glycine was 5.6 nmol g\u207b\u00b9 by 3D-HPLC versus ~0.6 nmol g\u207b\u00b9 by LC-FD/HRMS; the difference is attributed to evaporative losses (Naraoka et al. 2023, *Science* 379:eabn9033). Abundances were lower than in Orgueil and Murchison.\\[62\\]\\[63\\]\n- **Bennu:**\n  - Glavin, Dworkin et al. (2025, *Nature Astronomy* 9:199\u2013210) found 33 amino acids, 14 of them proteinogenic. Glycine was most abundant at 44 nmol g\u207b\u00b9.\\[64\\]\n  - Free ammonia was abundant, about 75 times Ryugu's.\\[65\\]\n  - All chiral non-protein amino acids were racemic.\\[66\\]\n  - The authors interpret the high glycine and racemic \u03b1-amino acids as indicating \"HCN polymerization and/or Strecker-cyanohydrin synthesis during aqueous alteration\" in NH\u2083-rich parent-body fluids.\\[66\\]\\[67\\]\n\n**Interpretation.** Small-body data are strong natural evidence that aqueous Strecker/cyanohydrin chemistry makes glycine abiotically. In the parent bodies, this ran at low temperature with NH\u2083 and H\u2082CO present. Whether delivery mattered for Earth's inventory is debated. Delivered concentrations (nmol g\u207b\u00b9) are low, and impact survival is partial. Most researchers treat delivery as a supplement, or as a proof of concept for in situ chemistry.\n\n### 11. Wet\u2013dry, evaporitic and mineral-surface (clay, oxide) scenarios\n\nWet\u2013dry cycling and clays mostly concern what happens to glycine after it forms: concentration, oligomerization to peptides, and protection. They have little to say about how it forms. Their main contribution to synthesis is concentrating feedstock. Evaporation or eutectic freezing can raise HCN/NH\u2083 to the 0.01\u20130.1 M levels that Strecker and oligomer chemistry need, and ferrocyanide evaporites store cyanide in the cyanosulfidic scenario. Oxide/hydroxide minerals (green rust, brucite, magnetite) and Fe-saponite are the best-documented mineral surfaces that actually take part in amino acid\u2013forming steps (Sections 6 and 8). The surveyed literature contains no quantitative, clay-catalyzed de novo glycine synthesis comparable to the Fe/Ni amination data.\n\n### 12. Photochemical and radiolytic routes\n\nUV makes HCN and aldehydes in reducing atmospheres. UV acting on dilute HCN gives glycine (Abelson, as reviewed by Ruiz-Bermejo et al. 2013).\\[22\\] UV drives the photoredox steps of cyanosulfidic chemistry and the ice-photolysis syntheses. Radiolytic (ionizing-radiation) syntheses of glycine from simple ices or solutions are reported in the astrochemistry literature but were not quantitatively reviewed here. They should be treated as plausible but secondary.\n\n## Catalysts: What Has Actually Been Shown\n\n| Step | Catalyst/mediator shown experimentally | Uncatalyzed? |\n|---|---|---|\n| H\u2082CO + NH\u2083 + HCN \u2192 aminoacetonitrile | None needed | Yes |\n| Aminoacetonitrile \u2192 glycine (hydrolysis) | None needed; base/acid accelerate | Yes |\n| HCN oligomerization | Base (pH ~9) | Yes |\n| Glycolonitrile \u2192 (via NH\u2083) aminoacetonitrile; reductive HCN homologation | Cu(I)/Cu(II) + UV + H\u2082S (cyanosulfidic) | Homologation: no |\n| Glyoxylate \u2192 glycine (reductive amination) | Fe\u00b2\u207a, Fe\u2070 (Muchowska 2019); mixed-valence Fe(OH)\u2093/green rust (Barge 2020); ferroan brucite (Chimiak 2024); Ni\u2070, Pd, iron meteorites + H\u2082 (Kaur 2024); Fe\u2070 from FeS electroreduction (Kitadai 2019); cyanide as reductant (Yadav 2022) | Imine forms uncatalyzed; reduction needs a reductant (slow uncatalyzed glycine at \u226510 mM NH\u2084Cl reported by Barge 2020)\\[6\\] |\n| CO/cyanide fixation to amino acids | Ni, (Ni,Fe) hydroxide/sulfide precipitates (Huber & W\u00e4chtersh\u00e4user 2006) | No |\n| CO\u2082 \u2192 C\u2082/C\u2083 acids (upstream) | Fe\u2070, greigite, magnetite, awaruite (Varma 2018; Preiner 2020) | No |\n| Hydrothermal Strecker | Pyrite\u2013pyrrhotite\u2013magnetite (redox buffer, not a proven catalyst)\\[8\\] | Largely yes |\n| Interstellar ice glycine | Water-ice surface (radical recombination) | \u2014 |\n\n## Open Questions and Challenges\n\n1. **Feedstock flux and concentration (both camps).**\n   - Strecker, HCN-oligomer and cyanosulfidic routes need concentrated HCN (\u22650.01\u20130.1 M) alongside H\u2082CO and NH\u2083. Under a neutral CO\u2082\u2013N\u2082 atmosphere HCN production is low. Impacts, volcanic plumes, or evaporite/ferrocyanide storage are invoked to fix this but are not quantified as steady sources.\n   - Glyoxylate routes lack a demonstrated efficient abiotic glyoxylate source. NH\u2083 is also a problem: most Fe-based systems used 0.1\u20131.5 M NH\u2084\u207a, and only Ni/H\u2082 (6 mM) and Barge's 5 mM tests come near plausible levels.\n2. **Selectivity against hydroxy acids.** Every route has a hydroxy-acid side branch: glycolate from glycolonitrile, or from glyoxylate reduction. Ni catalysts give ~1:1 amino:hydroxy acid, while Pd gives more than 5:1. Selectivity rises with pH and NH\u2083 but falls at low NH\u2083 (Barge 2019/2020; Kaur 2024).\\[31\\] This trade-off should be a core parameter in any network model.\n3. **Congruence with biochemistry (contested).**\n   - Metabolism-first authors (Moran, Martin, Muchowska) argue that ketoacid amination mirrors biosynthesis, and that cyanide is foreign to and toxic for metabolism.\n   - Cyanide-chemistry authors (Sutherland, Krishnamurthy) answer with cyanide-based routes that converge on ketoacid substrates (Bucherer\u2013Bergs) and on co-synthesis of nucleotides and lipids.\n   - Neither argument is decisive. Congruence is a heuristic, not evidence of historical pathway.\n4. **Compatibility of steps.**\n   - Cyanosulfidic chemistry needs spatially separated, sequential steps.\n   - Fe/Ni amination networks have only recently been run as continuous one-pot networks (Kaur 2024), and with synthetic supported catalysts rather than natural minerals (meteorite powder being the exception).\n   - Brucite-bound glycine (up to 97% mineral-associated) raises the question of whether the product is available downstream.\\[34\\]\n5. **Thermal stability.** Glycine and other amino acids decompose rapidly at \u2265240 \u00b0C (Bada et al. 1995; Aubrey et al. 2009).\\[48\\] This limits high-temperature vent scenarios to transient synthesis plus quenching.\n6. **Atmospheric scenario.** Gas-phase routes depend on the oxidation state of the Hadean atmosphere. The neutral-gas yield enhancement (Cleaves et al. 2008) was challenged as an ascorbate artifact (Kuwahara et al. 2012), so neutral-atmosphere glycine synthesis remains unconfirmed.\\[4\\]\n7. **Delivery versus in situ synthesis.** Exogenous glycine is real, confirmed by isotopes in Stardust and racemic, contamination-controlled data from Ryugu and Bennu. Its delivered concentration and impact survival are poorly constrained, though, so it is unclear whether delivery was significant for Earth.\n8. **Single-laboratory results.** The ferroan brucite (2024) and Ni/H\u2082 (2024) results are recent and not yet independently replicated. Hennet et al. (1992) numbers are available here only through a secondary source (Andersson & Holm 2000).\n\n## Recommendations for Synthesis-Network Design\n\n- **Build two hub nodes.** Aminoacetonitrile is the hub for HCN/H\u2082CO/NH\u2083 inputs. Glyoxylate \u21cc hemiaminal \u21cc glycine imine is the hub for C\u2082-ketoacid/NH\u2083/reductant inputs. Hydantoin connects the two (Bucherer\u2013Bergs, CO\u2082-dependent).\n- **Encode the competing branches explicitly:** glycolonitrile \u2192 glycolate, glyoxylate \u2192 glycolate, and glycine + glyoxylate \u2192 iminodiacetate. Parameterize the amino/hydroxy split by pH (best near 8\u201310), [NH\u2083] and the reductant.\n- **Use realistic boundaries.** Low-mM NH\u2083 for open-ocean scenarios. Mineral-buffered Fe(II)/Fe(III) around 1:1, or Fe(II)-brucite, for serpentinizing settings at 20\u201370 \u00b0C. Exclude >200 \u00b0C residence times for product accumulation.\n- **Prioritize filling the upstream gaps** with flux-limited sub-models: HCN production under N\u2082\u2013CO\u2082 atmospheres with impact or volcanic pulses, and abiotic glyoxylate formation. These, not the final glycine-forming step, decide which framework is viable.\n- **Treat glycine as an expected background product.** Because glycine forms under nearly every condition tested, detecting it in a model or experiment says little about which framework is correct. Product distributions such as the alanine/glycine ratio, hydroxy-acid co-products and \u03b2-amino acids are more diagnostic.\n\n## Caveats\n\n- The Hennet et al. 1992 values come from a secondary source (Andersson & Holm 2000). Yield definitions differ across studies (per carbon, per limiting reagent, mol%, mM), so cross-route yield comparisons are only order-of-magnitude.\n- Barge et al. 2019 (*PNAS*) is often cited for glycine but reports pyruvate \u2192 alanine.\\[31\\] The glyoxylate \u2192 glycine data are in Barge et al. 2020 (*JGR Planets*).\\[6\\]\n- M\u00e9nez et al. 2018 concerns tryptophan, not glycine. It is relevant only as natural evidence that serpentinite-hosted abiotic amino acid synthesis occurs.\\[51\\]\n- Statements about which environment \"was\" the site of glycine synthesis are inferences. No route is uncontested, and several of the most quantitative recent results come from single laboratories.\n- Some sources could not be checked directly. The numbers for Hennet et al. 1992, M\u00e9nez et al. 2018, Barge et al. 2020 and Chimiak et al. 2024 came from a delegated search; the Barge 2020 numbers are from search snippets because its full text could not be opened. The Tutolo 2026 quote comes from his conference abstract of the same title, because the *PNAS* full text was not accessible. The UV-ice papers (Bernstein et al. 2002; Mu\u00f1oz Caro et al. 2002), the Takeuchi et al. 2020 impact study and Preiner et al. 2020 are cited from secondary mentions, not read directly. The Kuwahara et al. 2012 and Bada et al. 2007 critiques were read only as search excerpts, and their author lists were not verified against the original papers.\n\n## Sources\n\n1. [Nature Astronomy nature astronomy https://doi.org/10.1038/s41550-024-02472-9](https://science.gsfc.nasa.gov/sed/content/uploadFiles/publication_files/Glavin%20Dworkin%202025.pdf)\n2. <https://www.molevol.hhu.de/fileadmin/redaktion/Fakultaeten/Mathematisch-Naturwissenschaftliche_Fakultaet/Biologie/Institute/Molekulare_Evolution/Dokumente/Kaur_et_al_2024_Chem.pdf>\n3. [The Miller Volcanic Spark Discharge Experiment BREVIA](https://science.gsfc.nasa.gov/sed/content/uploadFiles/publication_files/Johnsonetal2008.pdf)\n4. [The Use of Ascorbate as an Oxidation Inhibitor in Prebiotic Amino Acid Synthesis: A Cautionary Note](https://link.springer.com/article/10.1007/s11084-012-9296-z)\n5. [Glycine Imine\u2014The Elusive \u03b1\u2010Imino Acid Intermediate in the Reductive Amination of Glyoxylic Acid - Paczelt - 2023 - Angewandte Chemie International Edition - Wiley Online Library](https://onlinelibrary.wiley.com/doi/full/10.1002/anie.202218548)\n6. [Effects of Geochemical and Environmental Parameters on Abiotic Organic Chemistry Driven by Iron Hydroxide Minerals - Barge - 2020 - Journal of Geophysical Research: Planets - Wiley Online Library](https://agupubs.onlinelibrary.wiley.com/doi/full/10.1029/2020je006423)\n7. [Glycine synthesis from nitrate and glyoxylate mediated by ferroan brucite: An integrated pathway for prebiotic amine synthesis](https://www.pnas.org/doi/10.1073/pnas.2408248121)\n8. <https://link.springer.com/content/pdf/10.1023/A:1006668322298.pdf>\n9. [A thermodynamic basis for prebiotic amino acid synthesis and the nature of the first genetic code](https://arxiv.org/pdf/0904.0402)\n10. [(PDF) The Miller Volcanic Spark Discharge Experiment](https://www.academia.edu/121732208/The_Miller_Volcanic_Spark_Discharge_Experiment)\n11. [The Miller Volcanic Spark Discharge Experiment - ADS](https://ui.adsabs.harvard.edu/abs/2008Sci...322..404J)\n12. [Primord