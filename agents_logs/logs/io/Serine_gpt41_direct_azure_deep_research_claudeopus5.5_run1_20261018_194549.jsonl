"C3H4O4\",\n      \"iupac_name\": \"hydroxypyruvic acid\",\n      \"common_name\": \"hydroxypyruvate\",\n      \"inchi\": \"InChI=1S/C3H4O4/c4-1-2(5)3(6)7/h1,4H,2H2\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_013\",\n      \"formula\": \"C4H9N3O\",\n      \"iupac_name\": \"hexamethylenetetramine\",\n      \"common_name\": \"hexamethylenetetramine\",\n      \"inchi\": \"InChI=1S/C6H12N4/c7-1-3-9-5-2-8-4-6(5)10-3/h1-6H2\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_014\",\n      \"formula\": \"C2H4O\",\n      \"iupac_name\": \"acetaldehyde\",\n      \"common_name\": \"acetaldehyde\",\n      \"inchi\": \"InChI=1S/C2H4O/c1-2-3/h2H,1H3\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_015\",\n      \"formula\": \"C3H5NO3\",\n      \"iupac_name\": \"2-amino-3-(hydroxymethyl)-3-hydroxypropanoic acid\",\n      \"common_name\": \"hydroxymethylserine\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_016\",\n      \"formula\": \"H2O\",\n      \"iupac_name\": \"oxidane\",\n      \"common_name\": \"water\",\n      \"inchi\": \"InChI=1S/H2O/h1H2\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_017\",\n      \"formula\": \"C3H3NO3\",\n      \"iupac_name\": \"2-oxopropanoic acid\",\n      \"common_name\": \"pyruvic acid\",\n      \"inchi\": \"InChI=1S/C3H4O3/c1-2(4)3(5)6/h1H3,(H,5,6)\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_018\",\n      \"formula\": \"C3H7NO2\",\n      \"iupac_name\": \"2-aminopropanoic acid\",\n      \"common_name\": \"alanine\",\n      \"inchi\": \"InChI=1S/C3H7NO2/c1-2(4)3(5)6/h2H,4H2,1H3,(H,5,6)\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    }\n  ],\n  \"reactions\": [\n    {\n      \"id\": \"rxn_001\",\n      \"name\": \"HCN cyanohydrin formation\",\n      \"inputs\": [\"mol_001\", \"mol_003\"],\n      \"outputs\": [\"mol_004\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300\u2013320K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": \"true\",\n        \"other\": \"mildly basic pH\"\n      },\n      \"mechanism\": \"HCN adds to formaldehyde to yield glycolonitrile (cyanohydrin formation).\",\n      \"reasoning\": \"Directly supported as a robust reaction under prebiotic conditions and an established step in the cyanosulfidic pathway (Ritson & Sutherland, 2013).\"\n    },\n    {\n      \"id\": \"rxn_002\",\n      \"name\": \"Photoreductive homologation of glycolonitrile to glycolaldehyde\",\n      \"inputs\": [\"mol_004\", \"mol_005\", \"mol_016\"],\n      \"outputs\": [\"mol_006\", \"NH3\", \"S\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"CuCN\", \"UV light (254 nm)\"],\n      \"conditions\": {\n        \"temperature\": \"~298\u2013310K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"Cu(I) cyanide\",\n        \"aqueous\": \"true\",\n        \"other\": \"phosphate buffer, intense UV irradiation\"\n      },\n      \"mechanism\": \"UV/photoreduction (CuCN/H2S) reduces glycolonitrile to glycolaldehyde and ammonia, liberating sulfur.\",\n      \"reasoning\": \"Ritson & Sutherland 2013: photoredox + H2S gives up to 42% glycolaldehyde from glycolonitrile, with efficient C2 product formation.\"\n    },\n    {\n      \"id\": \"rxn_003\",\n      \"name\": \"Strecker synthesis of serine aminonitrile from glycolaldehyde\",\n      \"inputs\": [\"mol_006\", \"mol_001\", \"mol_002\"],\n      \"outputs\": [\"mol_007\", \"mol_016\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300\u2013340K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": \"true\",\n        \"other\": \"mildly basic to neutral pH\"\n      },\n      \"mechanism\": \"Glycolaldehyde undergoes Strecker synthesis with HCN and ammonia to yield serine aminonitrile and water.\",\n      \"reasoning\": \"Proven for prebiotic serine formation; serine aminonitrile forms in 'excellent yield' (Foden et al. 2020, Ritson & Sutherland 2013).\"\n    },\n    {\n      \"id\": \"rxn_004\",\n      \"name\": \"Serine aminonitrile hydrolysis\",\n      \"inputs\": [\"mol_007\", \"2 mol_016\"],\n      \"outputs\": [\"mol_008\", \"NH3\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300\u2013340K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": \"true\",\n        \"other\": \"Hydrolysis, mildly acidic or basic pH\"\n      },\n      \"mechanism\": \"Serine aminonitrile undergoes dihydrolysis to yield serine and ammonia.\",\n      \"reasoning\": \"Classic hydrolysis, robust and uncatalysed in mild conditions (Foden et al. 2020).\"\n    },\n    {\n      \"id\": \"rxn_005\",\n      \"name\": \"Aldol hydroxymethylation of glycine (Akabori reaction)\",\n      \"inputs\": [\"mol_009\", \"mol_003\", \"mol_016\"],\n      \"outputs\": [\"mol_008\", \"NH3\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"CuSO4\"],\n      \"conditions\": {\n        \"temperature\": \"310\u2013340K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"Cu2+\",\n        \"aqueous\": \"true\",\n        \"other\": \"mildly basic to neutral, pH ~9\"\n      },\n      \"mechanism\": \"Cu2+-catalysed condensation of glycine and formaldehyde forms serine and ammonia (aldol addition then deamination).\",\n      \"reasoning\": \"Strong experimental evidence (Akabori et al. 1959); serine produced efficiently via metal-catalysed route.\"\n    },\n    {\n      \"id\": \"rxn_006\",\n      \"name\": \"Pyridoxal\u2013metal catalysed serine synthesis\",\n      \"inputs\": [\"mol_009\", \"mol_003\", \"mol_016\"],\n      \"outputs\": [\"mol_008\", \"NH3\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Pyridoxal\", \"Fe3+\"],\n      \"conditions\": {\n        \"temperature\": \"300\u2013330K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"Pyridoxal + Fe3+/Cu2+\",\n        \"aqueous\": \"true\",\n        \"other\": \"pH 8\u20139\"\n      },\n      \"mechanism\": \"Pyridoxal forms a Schiff base with glycine; formaldehyde addition and Schiff base hydrolysis yield serine.\",\n      \"reasoning\": \"Experimentally confirmed for pyridoxal\u2013metal complex catalysis (Metzler & Snell, 1954).\"\n    },\n    {\n      \"id\": \"rxn_007\",\n      \"name\": \"Polyglycine side-chain hydroxymethylation\",\n      \"inputs\": [\"mol_009\", \"mol_003\", \"mol_016\"],\n      \"outputs\": [\"mol_008\", \"mol_015\", \"NH3\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Kaolinite\"],\n      \"conditions\": {\n        \"temperature\": \"320\u2013340K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"Kaolinite\",\n        \"aqueous\": \"true\",\n        \"other\": \"dry-down/wet-dry cycling\"\n      },\n      \"mechanism\": \"Formaldehyde reacts with glycine residues on polyglycine, introducing seryl side chains (surface-catalysis).\",\n      \"reasoning\": \"Demonstrated historically on kaolinite surfaces (Akabori, Okawa & Sato 1956).\"\n    },\n    {\n      \"id\": \"rxn_008\",\n      \"name\": \"Formose condensation yielding glycolaldehyde\",\n      \"inputs\": [\"2 mol_003\", \"mol_016\"],\n      \"outputs\": [\"mol_006\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Ca(OH)2\"],\n      \"conditions\": {\n        \"temperature\": \"320\u2013340K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": \"Ca(OH)2 or clays\",\n        \"aqueous\": \"true\",\n        \"other\": \"alkaline, mineral-rich solution\"\n      },\n      \"mechanism\": \"Base-catalysed aldol condensation dimerizes formaldehyde to glycolaldehyde.\",\n      \"reasoning\": \"Formose chemistry is well-established; glycolaldehyde readily forms but the overall selectivity is low (Weber, 1998).\"\n    },\n    {\n      \"id\": \"rxn_009\",\n      \"name\": \"Hydrothermal Strecker synthesis\",\n      \"inputs\": [\"mol_003\", \"mol_002\", \"mol_001\", \"mol_016\"],\n      \"outputs\": [\"mol_007\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"Pyrite\u2013pyrrhotite\u2013magnetite buffer\"],\n      \"conditions\": {\n        \"temperature\": \"398\u2013448K\",\n        \"pressure\": \"high\",\n        \"catalyst\": \"Fe minerals\",\n        \"aqueous\": \"true\",\n        \"other\": \"hydrothermal vent setting\"\n      },\n      \"mechanism\": \"High-temperature Strecker reaction from formaldehyde, ammonia, and HCN gives serine aminonitrile.\",\n      \"reasoning\": \"Observed under laboratory hydrothermal conditions, but serine is unstable and transient (Aubrey, Cleaves & Bada 2009; Hennet et al. 1992).\"\n    },\n    {\n      \"id\": \"rxn_010\",\n      \"name\": \"Hydrolysis of serine aminonitrile (hydrothermal)\",\n      \"inputs\": [\"mol_007\", \"2 mol_016\"],\n      \"outputs\": [\"mol_008\", \"NH3\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"398\u2013448K\",\n        \"pressure\": \"high\",\n        \"catalyst\": null,\n        \"aqueous\": \"true\",\n        \"other\": \"hydrothermal vent fluids\"\n      },\n      \"mechanism\": \"Thermal dihydrolysis of aminonitrile to serine.\",\n      \"reasoning\": \"Consistent with high-temperature aqueous aminonitrile hydrolysis (Aubrey, Cleaves & Bada 2009).\"\n    },\n    {\n      \"id\": \"rxn_011\",\n      \"name\": \"Reductive amination of hydroxypyruvate to serine (speculative)\",\n      \"inputs\": [\"mol_012\