lication_files/Glavin2020%20Asuka1.pdf)\n\n=== END DEEP RESEARCH FINDINGS ===\n\n\n\n=== END LITERATURE RESEARCH FINDINGS ===\n\nINSTRUCTIONS FOR LITERATURE-GUIDED SYNTHESIS:\n1. Prefer routes and conditions that are well supported experimentally in the research above.\n2. Weigh the critiques and contested points the research reports; do not adopt a route uncritically.\n3. You may depart from the described routes when the chemistry justifies it; explain why in \"reasoning\".\n4. Cite the supporting paper (author, year) in each reaction's \"reasoning\" field, or mark the reaction as speculative.\n", "raw_response": "{\n  \"target_molecule\": \"Serine\",\n  \"overall_strategy\": \"This network models all experimentally supported prebiotic routes to serine, prioritizing: (A) glycolaldehyde Strecker chemistry (Sutherland et al., best-demonstrated); (C) glycine + formaldehyde hydroxymethylation (Akabori, robust synthetic precedent); cyanosulfitic variants; polyglycine/kaolinite surface transformation; speculative biomimetic hydroxypyruvate amination (D), as well as environmental/energy-driven routes (spark discharge, interstellar ice, hydrothermal) as minor/parallel contributors. Downstream and loss channels, including over-reduction and serine degradation, are included as per literature guidance.\",\n  \"molecules\": [\n    {\n      \"id\": \"mol_001\",\n      \"formula\": \"HCN\",\n      \"iupac_name\": \"hydrogen cyanide\",\n      \"common_name\": \"hydrogen cyanide\",\n      \"inchi\": \"InChI=1S/CHN/c1-2/h1H\",\n      \"role\": \"starting\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_002\",\n      \"formula\": \"NH3\",\n      \"iupac_name\": \"azane\",\n      \"common_name\": \"ammonia\",\n      \"inchi\": \"InChI=1S/H3N/h1H3\",\n      \"role\": \"starting\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_003\",\n      \"formula\": \"H2CO\",\n      \"iupac_name\": \"methanal\",\n      \"common_name\": \"formaldehyde\",\n      \"inchi\": \"InChI=1S/CH2O/c1-2/h1H2\",\n      \"role\": \"starting\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_004\",\n      \"formula\": \"HOCH2CN\",\n      \"iupac_name\": \"2-hydroxyacetonitrile\",\n      \"common_name\": \"glycolonitrile\",\n      \"inchi\": \"InChI=1S/C2H3NO/c3-1-2-4/h2H,1H2\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_005\",\n      \"formula\": \"C2H4O2\",\n      \"iupac_name\": \"ethane-1,2-dione\",\n      \"common_name\": \"glycolaldehyde\",\n      \"inchi\": \"InChI=1S/C2H4O2/c3-1-2-4/h1-2,4H2\",\n      \"role\": \"hub_intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_006\",\n      \"formula\": \"C2H5NO2\",\n      \"iupac_name\": \"2-aminoacetic acid\",\n      \"common_name\": \"glycine\",\n      \"inchi\": \"InChI=1S/C2H5NO2/c3-1-2(4)5/h1,3H2,(H,4,5)\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_007\",\n      \"formula\": \"C3H6N2O2\",\n      \"iupac_name\": \"2-amino-3-hydroxypropanenitrile\",\n      \"common_name\": \"serine aminonitrile\",\n      \"inchi\": \"InChI=1S/C3H6N2O2/c4-1-2(6)3-5/h2,6H,1,3H2\",\n      \"role\": \"hub_intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_008\",\n      \"formula\": \"C3H7NO3\",\n      \"iupac_name\": \"2-amino-3-hydroxypropanoic acid\",\n      \"common_name\": \"serine\",\n      \"inchi\": \"InChI=1S/C3H7NO3/c4-2(1-5)3(6)7/h2,5H,1,4H2,(H,6,7)\",\n      \"role\": \"target\",\n      \"environment_formed\": \"Biochemical\"\n    },\n    {\n      \"id\": \"mol_009\",\n      \"formula\": \"C2H3NO\",\n      \"iupac_name\": \"aminoacetonitrile\",\n      \"common_name\": \"aminoacetonitrile\",\n      \"inchi\": \"InChI=1S/C2H3N/c3-1-2/h1H,3H2\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_010\",\n      \"formula\": \"C3H6O3\",\n      \"iupac_name\": \"2-hydroxypropanedial\",\n      \"common_name\": \"hydroxypyruvate\",\n      \"inchi\": \"InChI=1S/C3H6O3/c4-1-2(5)3(6)7/h1,3,5H,2H2\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Hydrothermal\"\n    },\n    {\n      \"id\": \"mol_011\",\n      \"formula\": \"C3H9N3O2\",\n      \"iupac_name\": \"2-amino-3-hydroxymethyl-amino-propanoic acid\",\n      \"common_name\": \"hydroxymethylserine\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_012\",\n      \"formula\": \"C3H6N2O2\",\n      \"iupac_name\": \"dehydroalanine nitrile\",\n      \"common_name\": \"dehydroalanine nitrile\",\n      \"inchi\": null,\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Biochemical\"\n    },\n    {\n      \"id\": \"mol_013\",\n      \"formula\": \"C2H2O2\",\n      \"iupac_name\": \"glyoxylate\",\n      \"common_name\": \"glyoxylic acid\",\n      \"inchi\": \"InChI=1S/C2H2O3/c3-1-2(4)5/h1H,(H,4,5)\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Hydrothermal\"\n    },\n    {\n      \"id\": \"mol_014\",\n      \"formula\": \"C1H2O2\",\n      \"iupac_name\": \"formic acid\",\n      \"common_name\": \"formic acid\",\n      \"inchi\": \"InChI=1S/CH2O2/c2-1-3/h1H,(H,2,3)\",\n      \"role\": \"starting\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_015\",\n      \"formula\": \"H2S\",\n      \"iupac_name\": \"sulfane\",\n      \"common_name\": \"hydrogen sulfide\",\n      \"inchi\": \"InChI=1S/H2S/h1H2\",\n      \"role\": \"starting\",\n      \"environment_formed\": \"Surface\"\n    }\n  ],\n  \"reactions\": [\n    {\n      \"id\": \"rxn_001\",\n      \"name\": \"Glycolonitrile formation from HCN and formaldehyde\",\n      \"inputs\": [\"mol_001\", \"mol_003\"],\n      \"outputs\": [\"mol_004\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300-320K\",\n        \"pressure\": \"ambient\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"pH neutral to slightly alkaline; phosphate buffer enhances yield\"\n      },\n      \"mechanism\": \"Nucleophilic addition of HCN to formaldehyde cyanohydrin formation.\",\n      \"reasoning\": \"This is a widely accepted prebiotic reaction, occurring abiotically under plausible primitive Earth conditions (Patel et al., 2015; Ritson & Sutherland, 2012; 2013).\"\n    },\n    {\n      \"id\": \"rxn_002\",\n      \"name\": \"Photoreductive homologation of glycolonitrile to glycolaldehyde (cyanosulfidic)\",\n      \"inputs\": [\"mol_004\", \"mol_015\"],\n      \"outputs\": [\"mol_005\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"CuCN\", \"UV 254nm\"],\n      \"conditions\": {\n        \"temperature\": \"300-310K\",\n        \"pressure\": \"ambient\",\n        \"catalyst\": \"CuCN (solid, 10 mol%)\",\n        \"aqueous\": true,\n        \"other\": \"strong UV irradiation, phosphate present, controlled time to favor glycolaldehyde\"\n      },\n      \"mechanism\": \"Reductive photochemistry: Cu(I)-cyanide acts as photoredox mediator, H2S as reductant; glycolonitrile is reduced to glycolaldehyde under UV.\",\n      \"reasoning\": \"This is the best-demonstrated experimental route for glycolaldehyde from cyanide (Ritson & Sutherland, 2013; Patel et al., 2015), but is geochemically constrained by Cu, H2S and UV together.\"\n    },\n    {\n      \"id\": \"rxn_003\",\n      \"name\": \"Strecker synthesis of serine aminonitrile from glycolaldehyde\",\n      \"inputs\": [\"mol_005\", \"mol_001\", \"mol_002\"],\n      \"outputs\": [\"mol_007\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300-320K\",\n        \"pressure\": \"ambient\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"neutral or mildly alkaline pH; aqueous ammonia\"\n      },\n      \"mechanism\": \"Nucleophilic addition of ammonia and HCN to glycolaldehyde; results in serine aminonitrile (Ser-CN).\",\n      \"reasoning\": \"This is robustly demonstrated for serine in the Sutherland group cyanosulfidic network (Foden et al., 2020; Patel et al., 2015). No catalyst is required for this step.\"\n    },\n    {\n      \"id\": \"rxn_004\",\n      \"name\": \"Hydrolysis of serine aminonitrile to serine\",\n      \"inputs\": [\"mol_007\"],\n      \"outputs\": [\"mol_008\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"310-340K\",\n        \"pressure\": \"ambient\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"neutral or mildly acidic water; timescale days to weeks\"\n      },\n      \"mechanism\": \"Two-step hydrolysis (nitrile \u2192 amide \u2192 acid) under aqueous conditions, often requiring mildly acidic or neutral pH.\",\n      \"reasoning\": \"Serine aminonitrile hydrolyzes slowly to serine in water; this is standard Strecker chemistry and supported for serine (Foden et al., 2020; Patel et al., 2015).\"\n    },\n    {\n      \"id\": \"rxn_005\",\n      \"name\": \"Aldol hydroxymethylation of glycine by formaldehyde (Akabori reaction)\",\n      \"inputs\": [\"mol_006\", \"mol_003\"],\n      \"outputs\": [\"mol_008\", \"mol_011\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"CuSO4\"],\n      \"conditions\": {\n        \"temperature\": \"300-350K\",\n        \"pressure\": \"ambient\",\n        \"catalyst\": \"CuSO4 (aq, catalytic)\",\n        \"aqueous\": true,\n        \"other\": \"pH mildly to strongly alkaline\"\n      },\n      \"mechanism\": \"Cu\u00b2\u207a catalysis promotes aldol addition of formaldehyde to glycine; further hydroxymethylation can occur.\",\n      \"reasoning\": \"Preparative reaction with robust precedent (Akabori et al., 1959). Route is reversible and over-hydroxymethylation is a competing side reaction. Requires Cu\u00b2\u207a, which is rare in reduced conditions, but may occur locally (Metzler, Longenecker & Snell, 1954; Chadha & Choughuley, 1984).\"\n    },\n    {\n      \"id\": \"rxn_006\",\n      \"name\": \"Formose reaction: oligomerization of formaldehyde to glycolaldehyde\",\n      \"inputs\": [\"mol_003\"],\n      \"outputs\": [\"mol_005\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"Ca(OH)2\"],\n      \"conditions\": {\n        \"temperature\": \"310-340K\",\n        \"pressure\": \"ambient\",\n        \"catalyst\": \"basic minerals (Ca(OH)2, clays possible)\",\n        \"aqueous\": true,\n        \"other\": \"Mildly alkaline pH; wet-dry cycles can concentrate product\"\n      },\n      \"mechanism\": \"Aldol-type base-catalyzed condensation of formaldehyde gives glycolaldehyde as one of the initial products.\",\n      \"reasoning\": \"This is the classic base-catalyzed route to glycolaldehyde (Weber, 1998). Unselective, but glycolaldehyde is observed; used as a minor/alternative source of glycolaldehyde in prebiotic chemistry.\"\n    },\n    {\n      \"id\": \"rxn_007\",\n      \"name\": \"Glycine formation from aminoacetonitrile hydrolysis\",\n      \"inputs\": [\"mol_009\"],\n      \"outputs\": [\"mol_006\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"310-330K\",\n        \"pressure\": \"ambient\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Neutral to mildly acidic water\"\n      },\n      \"mechanism\": \"Stepwise hydrolysis (nitrile to amide to acid); standard Strecker product hydrolysis.\",\n      \"reasoning\": \"Well-established for amino acid synthesis. Glycine arises from hydrolysis of aminoacetonitrile in the Sutherland and classic Strecker networks (Foden et al., 2020; Sutherland et al., 2013).\"\n    },\n    {\n      \"id\": \"rxn_008\",\n      \"name\": \"Strecker synthesis of aminoacetonitrile from formaldehyde\",\n      \"inputs\": [\"mol_003\", \"mol_001\", \"mol_002\"],\n      \"outputs\": [\"mol_009\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300-320K\",\n        \"pressure\": \"ambient\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Standard aqueous Strecker conditions\"\n      },\n      \"mechanism\": \"Ammonia and HCN react with formaldehyde to produce aminoacetonitrile.\",\n      \"reasoning\": \"Classic prebiotic route to aminoacetonitrile (Strecker intermediacy); forms upstream of glycine (Patel et al., 2015).\"\n    },\n    {\n      \"id\": \"rxn_009\",\n      \"name\": \"Cyanosulfitic photo-reduction (glycolonitrile + SO3, ferrocyanide variant)\",\n      \"inputs\": [\"mol_004\"],\n      \"outputs\": [\"mol_005\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"SO3^2-\", \"ferrocyanide\", \"UV 254nm\"],\n      \"conditions\": {\n        \"temperature\": \"300-310K\",\n        \"pressure\": \"ambient\",\n        \"catalyst\": \"ferrocyanide/anionic photochemistry\",\n        \"aqueous\": true,\n        \"other\": \"Mildly acidic to neutral pH; rapid photoexposure\"\n      },\n      \"mechanism\": \"SO3^2- acts as a reductant (substitute for H2S); ferrocyanide as electron donor under UV.\",\n      \"reasoning\": \"Variant demonstrated by Xu et al., 2018; expands environmental scope where H2S is sparse.\"\n    },\n    {\n      \"id\": \"rxn_010\",\n      \"name\": \"Speculative biomimetic reductive amination of hydroxypyruvate to serine\",\n      \"inputs\": [\"mol_010\", \"mol_002\"],\n      \"outputs\": [\"mol_008\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"Ni^0\", \"H2\"],\n      \"conditions\": {\n        \"temperature\": \"300-320K\",\n        \"pressure\": \"elevated\",\n        \"catalyst\": \"native Ni^0, meteorite catalysts (optional Pd, FeS, etc.)\",\n        \"aqueous\": true,\n        \"other\": \"pH near neutral to mildly alkaline; H2 availability\"\n      },\n      \"mechanism\": \"Reductive amination; hydroxypyruvate reacts with ammonia, reduced by native Ni/H2.\",\n      \"reasoning\": \"No direct prebiotic demonstration for serine, but all steps shown for analogous amino acids (Kaur et al., 2024; Muchowska et al., 2019; Kitadai et al., 2019). Included as a testable, biochemically congruent path.\"\n    },\n    {\n      \"id\": \"rxn_011\",\n      \"name\": \"Hydroxypyruvate formation from glycolaldehyde oxidation (speculative)\",\n      \"inputs\": [\"mol_005\"],\n      \"outputs\": [\"mol_010\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"Fe^0\", \"Ni^0\"],\n      \"conditions\": {\n        \"temperature\": \"350-400K\",\n        \"pressure\": \"moderate\",\n        \"catalyst\": \"Fe^0 or Ni^0 mineral surface\",\n        \"aqueous\": true,\n        \"other\": \"Geothermal/vent conditions suggested\"\n      },\n      \"mechanism\": \"Metals facilitate oxidation of glycolaldehyde to hydroxypyruvate in water.\",\n      \"reasoning\": \"Speculative: suggested by network expansion studies (Goldford et al., 2019), plausible by analogy with demonstrated glyoxylate chemistry, but explicit pathway not confirmed.\"\n    },\n    {\n      \"id\": \"rxn_012\",\n      \"name\": \"Polyglycine surface reaction introduction of serine residues\",\n      \"inputs\": [\"mol_006\", \"mol_003\"],\n      \"outputs\": [\"mol_008\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"kaolinite\"],\n      \"conditions\": {\n        \"temperature\": \"310-370K\",\n        \"pressure\": \"ambient\",\n        \"catalyst\": \"kaolinite surface\",\n        \"aqueous\": true,\n        \"other\": \"Wet-dry cycling; surface adsorption\"\n      },\n      \"mechanism\": \"Surface adsorption of polyglycine; side-chain introduction via reaction with formaldehyde forming seryl residues.\",\n      \"reasoning\": \"Akabori et al. (1956), Kuroda et al. (2024); plausible, with slow kinetics, for local serine production in polypeptides.\"\n    },\n    {\n      \"id\": \"rxn_013\",\n      \"name\": \"Serine degradation (retro-aldol, \u03b2-elimination)\",\n      \"inputs\": [\"mol_008\"],\n      \"outputs\": [\"mol_006\", \"mol_003\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300-370K, accelerated >100C\",\n        \"pressure\": \"ambient\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Alkaline conditions, heat accelerate decomposition\"\n      },\n      \"mechanism\": \"Retro-aldol and/or \u03b2-elimination result in reversible breakdown of serine to glycine and formaldehyde (and also pyruvate/alanine not shown).\",\n      \"reasoning\": \"Observed under prebiotic/thermal conditions; key bottleneck limiting serine accumulation (Aubrey, Cleaves & Bada, 2009; Sato et al., 2004; Ter-Ovanessian, 2025).\"\n    },\n    {\n      \"id\": \"rxn_014\",\n      \"name\": \"Strecker-type synthesis (parent body/ice photolysis route)\",\n      \"inputs\": [\"mol_001\", \"mol_003\", \"mol_002\"],\n      \"outputs\": [\"mol_008\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"UV\", null],\n      \"conditions\": {\n        \"temperature\": \"10-250K (ice); 300K (aqueous)\",\n        \"pressure\": \"vacuum/surface\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Interstellar UV or aqueous alteration after delivery\"\n      },\n      \"mechanism\": \"Radical-induced syntheses in ices and subsequent hydrolysis release serine upon aqueous alteration.\",\n      \"reasoning\": \"Detected after UV ice photolysis and meteoritic aqueous alteration (Bernstein et al., 2002; Mu\u00f1oz Caro et al., 2002; Kebukawa et al., 2017). Low-yield, non-selective.\"\n    },\n    {\n      \"id\": \"rxn_015\",\n      \"name\": \"Spark discharge abiotic amino acid synthesis\",\n      \"inputs\": [\"mol_001\", \"mol_002\", \"mol_003\"],\n      \"outputs\": [\"mol_008\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"electric discharge\"],\n      \"conditions\": {\n        \"temperature\": \"300-400K\",\n        \"pressure\": \"ambient\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Presence of atmospheric CH4, N2, H2, steam\"\n      },\n      \"mechanism\": \"Plasma/arc radical chemistry generates multiple amino acids from simple gases.\",\n      \"reasoning\": \"Detected in spark discharge/Miller experiments re-analyzed in Johnson et al., 2008; yields low and unselective but forms serine.\"\n    }\n  ],\n  \"pathways\": [\n    {\n      \"pathway_id\": \"P1\",\n      \"name\": \"Cyanosulfidic glycolaldehyde Strecker route\",\n      \"description\": \"HCN and formaldehyde react to give glycolonitrile, photoreduced (with H2S/CuCN/UV) to glycolaldehyde, Strecker reaction with HCN/NH3 gives serine aminonitrile, hydrolyzed to serine.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_002\", \"rxn_003\", \"rxn_004\"],\n      \"key_intermediates\": [\"mol_004\", \"mol_005\", \"mol_007\"]\n    },\n    {\n      \"pathway_id\": \"P2\",\n      \"name\": \"Cyanosulfitic glycolaldehyde Strecker variant\",\n      \"description\": \"HCN + H2CO form glycolonitrile; SO3^2-/ferrocyanide/UV photo-reduction forms glycolaldehyde; Strecker synthesis and hydrolysis proceed as above.\",\n      \"reaction_sequence\": [\"rxn_001\", \"rxn_009\", \"rxn_003\", \"rxn_004\"],\n      \"key_intermediates\": [\"mol_004\", \"mol_005\", \"mol_007\"]\n    },\n    {\n      \"pathway_id\": \"P3\",\n      \"name\": \"Formose-based glycolaldehyde Strecker route\",\n      \"description\": \"Formose base-catalyzed reaction of formaldehyde produces glycolaldehyde, which then proceeds via the Strecker and hydrolysis steps to serine.\",\n      \"reaction_sequence\": [\"rxn_006\", \"rxn_003\", \"rxn_004\"],\n      \"key_intermediates\": [\"mol_005\", \"mol_007\"]\n    },\n    {\n      \"pathway_id\": \"P4\",\n      \"name\": \"Classical Strecker via glycine: HCN + H2CO + NH3\",\n      \"description\": \"Formaldehyde, HCN and ammonia yield aminoacetonitrile, hydrolyzed to glycine, which then serves as substrate for aldol reaction to serine.\",\n      \"reaction_sequence\": [\"rxn_008\", \"rxn_007\", \"rxn_005\"],\n      \"key_intermediates\": [\"mol_009\", \"mol_006\"]\n    },\n    {\n      \"pathway_id\": \"P5\",\n      \"name\": \"Hydroxymethylation of glycine (Akabori path)\",\n      \"description\": \"Glycine reacts with formaldehyde in presence of Cu\u00b2\u207a to yield serine (and side product \u03b1-hydroxymethylserine).\",\n      \"reaction_sequence\": [\"rxn_005\"],\n      \"key_intermediates\": [\"mol_006\", \"mol_011\"]\n    },\n    {\n      \"pathway_id\": \"P6\",\n      \"name\": \"Hydroxypyruvate reductive amination path (biomimetic, speculative)\",\n      \"description\": \"Glycolaldehyde is oxidized to hydroxypyruvate, which is then aminated (Ni/H2 or FeS-catalyzed) with ammonia to serine.\",\n      \"reaction_sequence\": [\"rxn_011\", \"rxn_010\"],\n      \"key_intermediates\": [\"mol_010\"]\n    },\n    {\n      \"pathway_id\": \"P7\",\n      \"name\": \"Surface polymer path: side-chain introduction\",\n      \"description\": \"Polyglycine or surface-adsorbed glycine reacts with formaldehyde on kaolinite yielding polypeptides with serine residues.\",\n      \"reaction_sequence\": [\"rxn_012\"],\n      \"key_intermediates\": [\"mol_006\"]\n    },\n    {\n      \"pathway_id\": \"P8\",\n      \"name\": \"Interstellar ice + aqueous alteration route\",\n      \"description\": \"HCN, formaldehyde and ammonia in interstellar ices photolyzed by UV yield amino acid precursors, releasing serine on aqueous alteration.\",\n      \"reaction_sequence\": [\"rxn_014\"],\n      \"key_intermediates\": []\n    },\n    {