,\n        \"other\": \"Reducing gas, spark/lightning, water vapour\"\n      },\n      \"mechanism\": \"Spark and radical-driven chemistry randomises reagents; serine forms alongside others via Strecker and related reactions.\",\n      \"reasoning\": \"Serine detected as minor product, unselective, background yield (Johnson et al. 2008).\"\n    },\n    {\n      \"id\": \"rxn_014\",\n      \"name\": \"Interstellar ice/parent body photolytic amino acid synthesis\",\n      \"inputs\": [\"mol_001\", \"mol_002\", \"mol_003\", \"mol_016\"],\n      \"outputs\": [\"mol_008\", \"mol_009\", \"mol_018\", \"mol_016\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"UV irradiation\"],\n      \"conditions\": {\n        \"temperature\": \"80\u2013250K (accretionary transformation) then 300K aqueous alteration\",\n        \"pressure\": \"1 atm (after accretion)\",\n        \"catalyst\": null,\n        \"aqueous\": \"true\",\n        \"other\": \"vacuum UV/ice photolysis, aqueous parent body\"\n      },\n      \"mechanism\": \"Parent-body and interstellar photochemistry forms amino acid precursors; hydrolysis yields free amino acids.\",\n      \"reasoning\": \"Detection and quantification (Bernstein et al. 2002; Mu\u00f1oz Caro et al. 2002); low-yield, nonselective.\"\n    },\n    {\n      \"id\": \"rxn_015\",\n      \"name\": \"Serine retro-aldol to glycine and formaldehyde\",\n      \"inputs\": [\"mol_008\"],\n      \"outputs\": [\"mol_009\", \"mol_003\"],\n      \"environment\": \"Surface\",\n      \"agents\": [null],\n      \"conditions\": {\n        \"temperature\": \"300\u2013330K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": \"true\",\n        \"other\": \"reversible in solution\"\n      },\n      \"mechanism\": \"Serine decomposes to glycine and formaldehyde via retro-aldol cleavage; process is reversible.\",\n      \"reasoning\": \"Demonstrated as serine decomposition under mild heating; key to network reversibility (Met