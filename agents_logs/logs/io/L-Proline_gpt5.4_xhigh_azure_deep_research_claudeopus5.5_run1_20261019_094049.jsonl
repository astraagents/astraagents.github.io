acid", "common_name": "D-proline", "inchi": null, "role": "intermediate", "environment_formed": "Biochemical"}], "reactions": [{"id": "rxn_001", "name": "Cu(I)-mediated HCN-acetylene coupling to acrylonitrile", "inputs": ["mol_001", "mol_002"], "outputs": ["mol_007"], "environment": "Surface", "agents": ["Cu(I)"], "conditions": {"temperature": "300-340K", "pressure": "1 atm", "catalyst": "Cu(I)", "aqueous": true, "other": "Post-impact surface streams or evaporitic pools; acetylene supplied by carbide hydrolysis; anoxic and UV-exposed."}, "mechanism": "Copper(I)-promoted cyanovinylation of acetylene by HCN gives acrylonitrile.", "reasoning": "Patel et al. explicitly identify Cu(I)-catalyzed cross-coupling of HCN and acetylene to acrylonitrile as the entry to the proline branch (Patel et al., 2015). This is the best-supported carbon-skeleton entry, although Cu availability and acetylene delivery to surface waters remain geochemically contested (Ranjan et al., 2018; Todd et al., 2024)."}, {"id": "rxn_002", "name": "Aza-Michael addition of ammonia to acrylonitrile", "inputs": ["mol_007", "mol_003"], "outputs": ["mol_008"], "environment": "Surface", "agents": null, "conditions": {"temperature": "300-330K", "pressure": "1 atm", "catalyst": null, "aqueous": true, "other": "Ammonia-rich shallow pool or stream; near-neutral to mildly alkaline."}, "mechanism": "NH3 adds conjugatively to the activated C=C bond of acrylonitrile to give beta-aminopropionitrile.", "reasoning": "Patel et al. describe NH3 addition to acrylonitrile as the direct precursor step into the proline branch (Patel et al., 2015). The reaction is chemically reasonable without a catalyst in concentrated ammonia-bearing surface waters; cyanamide is omitted here because it diverts flux toward the arginine branch rather than the target."}, {"id": "rxn_003", "name": "Net UV-sulfidic reduction of beta-aminopropionitrile to 3-aminopanal", "inputs": ["mol_008", "mol_006", "mol_005"], "outputs": ["mol_009", "mol_003"