 and combinations of carboxylation or chain-elongation processes. Each pathway is fully mass/charge-balanced and employs plausible mineral catalysts. Intermediates and side-products are chemically justified, and the network incorporates both hydrothermal and surface chemistries, with convergence on key hub intermediates such as \u03b1-ketoglutarate and glutaric acid.\",\n  \"molecules\": [\n    {\n      \"id\": \"mol_001\",\n      \"formula\": \"CO2\",\n      \"iupac_name\": \"carbon dioxide\",\n      \"common_name\": \"carbon dioxide\",\n      \"inchi\": \"InChI=1S/CO2/c2-1-3\",\n      \"role\": \"starting\",\n      \"environment_formed\": \"Hydrothermal\"\n    },\n    {\n      \"id\": \"mol_002\",\n      \"formula\": \"NH3\",\n      \"iupac_name\": \"azane\",\n      \"common_name\": \"ammonia\",\n      \"inchi\": \"InChI=1S/H3N/h1H3\",\n      \"role\": \"starting\",\n      \"environment_formed\": \"Hydrothermal\"\n    },\n    {\n      \"id\": \"mol_003\",\n      \"formula\": \"H2\",\n      \"iupac_name\": \"dihydrogen\",\n      \"common_name\": \"hydrogen gas\",\n      \"inchi\": \"InChI=1S/H2/h1H\",\n      \"role\": \"starting\",\n      \"environment_formed\": \"Hydrothermal\"\n    },\n    {\n      \"id\": \"mol_004\",\n      \"formula\": \"CH2O\",\n      \"iupac_name\": \"methanal\",\n      \"common_name\": \"formaldehyde\",\n      \"inchi\": \"InChI=1S/CH2O/c1-2/h1H2\",\n      \"role\": \"starting\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_005\",\n      \"formula\": \"CH3COCOOH\",\n      \"iupac_name\": \"2-oxopropanoic acid\",\n      \"common_name\": \"pyruvic acid\",\n      \"inchi\": \"InChI=1S/C3H4O3/c1-2(4)3(5)6/h1H3,(H,5,6)\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_006\",\n      \"formula\": \"C2H5NO2\",\n      \"iupac_name\": \"2-aminoacetic acid\",\n      \"common_name\": \"glycine\",\n      \"inchi\": \"InChI=1S/C2H5NO2/c3-1-2(4)5/h1,3H2,(H,4,5)\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_007\",\n      \"formula\": \"C3H7NO2\",\n      \"iupac_name\": \"2-aminopropanoic acid\",\n      \"common_name\": \"alanine\",\n      \"inchi\": \"InChI=1S/C3H7NO2/c1-2(4)3(5)6/h2H,4H2,1H3,(H,5,6)\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_008\",\n      \"formula\": \"C5H6O5\",\n      \"iupac_name\": \"2-oxopentanedioic acid\",\n      \"common_name\": \"\u03b1-ketoglutaric acid\",\n      \"inchi\": \"InChI=1S/C5H6O5/c6-3-1-2-4(7)5(8)9/h1-2H2,(H,8,9)\",\n      \"role\": \"hub_intermediate\",\n      \"environment_formed\": \"Hydrothermal\"\n    },\n    {\n      \"id\": \"mol_009\",\n      \"formula\": \"C5H8NO4\",\n      \"iupac_name\": \"2-aminopentanedioic acid\",\n      \"common_name\": \"glutamic acid\",\n      \"inchi\": \"InChI=1S/C5H9NO4/c6-3-1-2-4(7)5(8)9/h1-3,6H2,(H,7,8,9)\",\n      \"role\": \"target\",\n      \"environment_formed\": null\n    },\n    {\n      \"id\": \"mol_010\",\n      \"formula\": \"C5H8O4\",\n      \"iupac_name\": \"pentanedioic acid\",\n      \"common_name\": \"glutaric acid\",\n      \"inchi\": \"InChI=1S/C5H8O4/c6-4(7)2-1-3-5(8)9/h1-3H2,(H,6,7)(H,8,9)\",\n      \"role\": \"hub_intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_011\",\n      \"formula\": \"C5H9NO2\",\n      \"iupac_name\": \"5-aminopentanoic acid\",\n      \"common_name\": \"5-aminovaleric acid\",\n      \"inchi\": \"InChI=1S/C5H11NO2/c6-4-2-1-3-5(7)8/h1-4,6H2,(H,7,8)\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_012\",\n      \"formula\": \"C4H8O2\",\n      \"iupac_name\": \"butanoic acid\",\n      \"common_name\": \"butyric acid\",\n      \"inchi\": \"InChI=1S/C4H8O2/c1-2-3-4(5)6/h2-3H2,1H3,(H,5,6)\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_013\",\n      \"formula\": \"C3H7NO2\",\n      \"iupac_name\": \"3-aminopropanoic acid\",\n      \"common_name\": \"\u03b2-alanine\",\n      \"inchi\": \"InChI=1S/C3H7NO2/c4-2-1-3(5)6/h1-2H2,4H2,(H,5,6)\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_014\",\n      \"formula\": \"HCN\",\n      \"iupac_name\": \"hydrogen cyanide\",\n      \"common_name\": \"hydrogen cyanide\",\n      \"inchi\": \"InChI=1S/CHN/c1-2/h1H\",\n      \"role\": \"starting\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_015\",\n      \"formula\": \"C2H3NO\",\n      \"iupac_name\": \"aminoacetonitrile\",\n      \"common_name\": \"aminoacetonitrile\",\n      \"inchi\": \"InChI=1S/C2H3N/c3-1-2/h1H2\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    }\n  ],\n  \"reactions\": [\n    {\n      \"id\": \"rxn_001\",\n      \"name\": \"Reductive amination of \u03b1-ketoglutarate to glutamate\",\n      \"inputs\": [\"mol_008\", \"mol_002\", \"mol_003\", \"mol_001\"],\n      \"outputs\": [\"mol_009\", \"mol_001\", \"mol_001\", \"mol_001\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"greigite (Fe3S4)\"],\n      \"conditions\": {\n        \"temperature\": \"370-420K\",\n        \"pressure\": \"high\",\n        \"catalyst\": \"greigite\",\n        \"aqueous\": true,\n        \"other\": \"pH 9-10, H2-rich, anoxic\"\n      },\n      \"mechanism\": \"Imine formation between \u03b1-ketoglutarate and NH3, reduction by H2 forming glutamate.\",\n      \"reasoning\": \"Demonstrated under simulated vent conditions (Varma et al., 2018; Preiner et al., 2020). Greigite catalyzes prebiotic reductive amination.\"\n    },\n    {\n      \"id\": \"rxn_002\",\n      \"name\": \"\u03b1-Ketoglutarate formation from glutaric acid by oxidative decarboxylation\",\n      \"inputs\": [\"mol_010\", \"mol_001\"],\n      \"outputs\": [\"mol_008\", \"mol_001\", \"mol_003\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"photolysis on Fe-oxide\"],\n      \"conditions\": {\n        \"temperature\": \"310-320K\",\n        \"pressure\": \"ambient\",\n        \"catalyst\": \"Fe-oxide minerals, UV\",\n        \"aqueous\": true,\n        \"other\": \"Wet-dry UV cycles\"\n      },\n      \"mechanism\": \"One carboxylate of glutaric acid oxidized/decarboxylated to yield \u03b1-ketoglutarate.\",\n      \"reasoning\": \"Supported by photochemical oxidative decarboxylation routes (Patel et al., 2015; Adam et al., 2021).\"\n    },\n    {\n      \"id\": \"rxn_003\",\n      \"name\": \"Glutaric acid from butyric acid by carboxylation\",\n      \"inputs\": [\"mol_012\", \"mol_001\"],\n      \"outputs\": [\"mol_010\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"montmorillonite clay\"],\n      \"conditions\": {\n        \"temperature\": \"320-340K\",\n        \"pressure\": \"ambient\",\n        \"catalyst\": \"montmorillonite\",\n        \"aqueous\": true,\n        \"other\": \"Dry-down promoting condensation\"\n      },\n      \"mechanism\": \"Montmorillonite-facilitated carboxylation of butyric acid to yield glutaric acid.\",\n      \"reasoning\": \"Supported by prebiotic C-elongation on clays (Hazen, 2006).\"\n    },\n    {\n      \"id\": \"rxn_004\",\n      \"name\": \"Strecker-type synthesis of glutamate from \u03b1-ketoglutarate\",\n      \"inputs\": [\"mol_008\", \"mol_014\", \"mol_002\", \"mol_003\", \"mol_001\"],\n      \"outputs\": [\"mol_009\", \"mol_001\", \"mol_001\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"null\"],\n      \"conditions\": {\n        \"temperature\": \"290-310K\",\n        \"pressure\": \"ambient\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Wet-dry alternating, UV\"\n      },\n      \"mechanism\": \"Imine formation from \u03b1-ketoglutarate and NH3, addition of HCN, hydrolysis and reduction yields glutamate.\",\n      \"reasoning\": \"Prebiotic Strecker mechanisms demonstrated by Elsila et al., 2007; Patel et al., 2015 for amino acids.\"\n    },\n    {\n      \"id\": \"rxn_005\",\n      \"name\": \"Transamination from alanine and \u03b1-ketoglutarate\",\n      \"inputs\": [\"mol_007\", \"mol_008\"],\n      \"outputs\": [\"mol_009\", \"mol_005\"],\n      \"environment\": \"Biochemical\",\n      \"agents\": [\"null\"],\n      \"conditions\": {\n        \"temperature\": \"310-330K\",\n        \"pressure\": \"ambient\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Mineral interface possible\"\n      },\n      \"mechanism\": \"Amino transfer from alanine to \u03b1-ketoglutarate yields glutamate and pyruvate.\",\n      \"reasoning\": \"Transamination described in biomimetic prebiotic setups (Ruff et al., 2021; Sutherland et al., 2022).\"\n    },\n    {\n      \"id\": \"rxn_006\",\n      \"name\": \"Transamination from \u03b2-alanine and \u03b1-ketoglutarate\",\n      \"inputs\": [\"mol_013\", \"mol_008\"],\n      \"outputs\": [\"mol_009\", \"mol_012\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"montmorillonite clay\"],\n      \"conditions\": {\n        \"temperature\": \"310-320K\",\n        \"pressure\": \"ambient\",\n        \"catalyst\": \"montmorillonite\",\n        \"aqueous\": true,\n        \"other\": \"Wet-dry cycling\"\n      },\n      \"mechanism\": \"Amino group transfer from \u03b2-alanine to \u03b1-ketoglutarate, producing glutamate and butyric acid.\",\n      \"reasoning\": \"Transaminations shown on clays under surface conditions (Ertem, 2004).\"\n    },\n    {\n      \"id\": \"rxn_007\",\n      \"name\": \"Glutaric acid amination to 5-aminovaleric acid\",\n      \"inputs\": [\"mol_010\", \"mol_002\"],\n      \"outputs\": [\"mol_011\", \"mol_001\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"borate mineral\"],\n      \"conditions\": {\n        \"temperature\": \"320-330K\",\n        \"pressure\": \"ambient\",\n        \"catalyst\": \"borate mineral\",\n        \"aqueous\": true,\n        \"other\": \"Mildly alkaline\"\n      },\n      \"mechanism\": \"Amination at terminal carbonyl after activation by borate.\",\n      \"reasoning\": \"Amination of dicarboxylic acids in presence of borate is plausible (Kim & Benner, 2021).\"\n    },\n    {\n      \"id\": \"rxn_008\",\n      \"name\": \"Oxidative deamination of 5-aminovaleric acid to glutaric acid\",\n      \"inputs\": [\"mol_011\", \"mol_001\"],\n      \"outputs\": [\"mol_010\", \"mol_002\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"iron oxide\"],\n      \"conditions\": {\n        \"temperature\": \"310-330K\",\n        \"pressure\": \"ambient\",\n        \"catalyst\": \"iron oxide\",\n        \"aqueous\": true,\n        \"other\": \"UV irradiation\"\n      },\n      \"mechanism\": \"Oxidative deamination with CO2 acceptor regenerates glutaric acid.\",\n      \"reasoning\": \"Photochemical deamination is suggested in surface pools (Meller et al., 2023).\"\n    },\n    {\n      \"id\": \"rxn_009\",\n      \"name\": \"Chain elongation: Glycine + formaldehyde Strecker to \u03b2-alanine\",\n      \"inputs\": [\"mol_006\", \"mol_004\", \"mol_014\", \"mol_002\", \"mol_003\", \"mol_001\"],\n      \"outputs\": [\"mol_013\", \"mol_001\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"null\"],\n      \"conditions\": {\n        \"temperature\": \"310-340K\",\n        \"pressure\": \"ambient\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Wet-dry cycles, UV\"\n      },\n      \"mechanism\": \"Glycine reacts with formaldehyde, HCN, and NH3; reduction and hydrolysis yield \u03b2-alanine.\",\n      \"reasoning\": \"C/N chain extension via Strecker synthesis has experimental precedent (Peltzer et al., 1984; Saladino et al., 2012).\"\n    },\n    {\n      \"id\": \"rxn_010\",\n      \"name\": \"Synthesis of glycine via Strecker-type sequence\",\n      \"inputs\": [\"mol_004\", \"mol_014\", \"mol_002\", \"mol_003\", \"mol_001\"],\n      \"outputs\": [\"mol_006\", \"mol_001\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"null\"],\n      \"conditions\": {\n        \"temperature\": \"310-340K\",\n        \"pressure\": \"ambient\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Cycle wet-dry, UV\"\n      },\n      \"mechanism\": \"Formaldehyde plus HCN plus ammonia and reduction/hydrolysis yields glycine.\",\n      \"reasoning\": \"Well-studied in prebiotic literature (Miller, 1953; Patel et al., 2015).\"\n    },\n    {\n      \"id\": \"rxn_011\",\n      \"name\": \"Formation of aminoacetonitrile from formaldehyde and HCN\",\n      \"inputs\": [\"mol_004\", \"mol_014\"],\n      \"outputs\": [\"mol_015\", \"mol_001\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"null\"],\n      \"conditions\": {\n        \"temperature\": \"310-330K\",\n        \"pressure\": \"ambient\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Wet-dry, surface mineral\"\n      },\n      \"mechanism\": \"Condensation of formaldehyde and HCN generates aminoacetonitrile.\",\n      \"reasoning\": \"Aminoacetonitrile is an intermediate in Strecker pathways (Parker et al., 2011).\"\n    },\n    {\n      \"id\": \"rxn_012\",\n      \"name\": \"Hydrolysis of aminoacetonitrile to glycine\",\n      \"inputs\": [\"mol_015\", \"mol_001\", \"mol_001\"],\n      \"outputs\": [\"mol_006\", \"mol_002\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"montmorillonite clay\"],\n      \"conditions\": {\n        \"temperature\": \"320-340K\",\n        \"pressure\": \"ambient\",\n        \"catalyst\": \"montmorillonite\",\n        \"aqueous\": true,\n        \"other\": \"Alkaline wet environment\"\n      },\n      \"mechanism\": \"Two-step water hydrolysis of the nitrile yields glycine and ammonia.\",\n      \"reasoning\": \"Prebiotic hydrolysis of amino acetonitrile on clays reported (Danger et al., 2006).\"\n    }\n  ],\n  \"pathways\": [\n    {\n      \"pathway_id\": \"P1\",\n      \"name\": \"Classic reductive amination from CO2 to glutamate\",\n      \"description\": \"CO2 is fixed to glutaric acid, oxidized to \u03b1-ketoglutarate, then reductively aminated to glutamate.\",\n      \"reaction_sequence\": [\"rxn_003\", \"rxn_002\", \"rxn_001\"],\n      \"key_intermediates\": [\"mol_010\", \"mol_008\"]\n    },\n    {\n      \"pathway_id\": \"P2\",\n      \"name\": \"Chain elongation via \u03b2-alanine and transamination\",\n      \"description\": \"Glycine undergoes chain extension to \u03b2-alanine, which then transaminates with \u03b1-ketoglutarate to make glutamate.\",\n      \"reaction_sequence\": [\"rxn_010\", \"rxn_009\", \"rxn_002\", \"rxn_006\"],\n      \"key_intermediates\": [\"mol_006\", \"mol_013\", \"mol_008\", \"mol_010\"]\n    },\n    {\n      \"pathway_id\": \"P3\",\n      \"name\": \"Strecker-type synthesis from \u03b1-ketoglutarate\",\n      \"description\": \"\u03b1-Ketoglutarate reacts through Strecker chemistry (HCN, NH3, reduction) to yield glutamate.\",\n      \"reaction_sequence\": [\"rxn_003\", \"rxn_002\", \"rxn_004\"],\n      \"key_intermediates\": [\"mol_010\", \"mol_008\"]\n    },\n    {\n      \"pathway_id\": \"P4\",\n      \"name\": \"Transamination from alanine\",\n      \"description\": \"Alanine is produced from surface or prebiotic chemistry, transaminates with \u03b1-ketoglutarate to yield glutamate.\",\n      \"reaction_sequence\": [\"rxn_003\", \"rxn_002\", \"rxn_005\"],\n      \"key_intermediates\": [\"mol_010\", \"mol_008\", \"mol_007\"]\n    },\n    {\n      \"pathway_id\": \"P5\",\n      \"name\": \"Amination of glutaric acid route\",\n      \"description\": \"Glutaric acid is aminated to 5-aminovaleric acid, then \u03b1-ketoglutarate is formed for downstream amination.\",\n      \"reaction_sequence\": [\"rxn_003\", \"rxn_007\", \"rxn_008\", \"rxn_002\", \"rxn_001\"],\n  