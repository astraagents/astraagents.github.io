rpentinization microenvironments"}, "mechanism": "Partial oxidation of methane and ammonia on FeS/FeNiS surfaces generates HCN and water.", "reasoning": "Hydrothermal FeS-catalyzed methane + ammonia partial oxidation is a recognized source of steady-state HCN (Brandes et al., 1998; McCollom, 2013)."}, {"id": "rxn_002", "name": "Formaldehyde formation from CO2 reduction", "inputs": ["mol_001", "mol_004"], "outputs": ["mol_006"], "environment": "Hydrothermal", "agents": ["FeS", "NiS"], "conditions": {"temperature": "400-450K", "pressure": "high", "catalyst": "FeS-NiS", "aqueous": true, "other": "Reductive, possibly driven by H2/metal redox couples"}, "mechanism": "CO2 is stepwise reduced to formaldehyde on iron-nickel sulfide interfaces.", "reasoning": "CO2 reduction to C1s under hydrothermal conditions is widely supported (Cody et al., 2000; Herschy et al., 2014)."}, {"id": "rxn_003", "name": "Acetaldehyde synthesis by aldol condensation of formaldehyde and methane derivatives", "inputs": ["mol_006", "mol_002"], "outputs": ["mol_007", "mol_004"], "environment": "Surface", "agents": ["UV light", "montmorillonite"], "conditions": {"temperature": "300-320K", "pressure": "1 atm", "catalyst": "montmorillonite", "aqueous": true, "other": "UV irradiation, partial dehydration at air\u2013water interface"}, "mechanism": "Formaldehyde undergoes condensation with methyl radicals from photolyzed methane to form acetaldehyde.", "reasoning": "Surface aldehyde formation by UV/macromolecular catalysis is established (Sita et al., 1972; Saladino et al., 2012)."}, {"id": "rxn_004", "name": "Pyruvate formation from acetaldehyde oxidation and CO2 addition", "inputs": ["mol_007", "mol_001", "mol_004"], "outputs": ["mol_009"], "environment": "Hydrothermal", "agents": ["FeS, transition metal oxides"], "conditions": {"temperature": "400-500K", "pressure": "high", "catalyst": "FeS, metal oxides", "aqueous": true, "other": "Redox/bicarbonate buffer"}, "mechanism": "Acetaldehyde reacts with CO2 and water on FeS to afford pyruvate via carboxylation/oxidation.", "reasoning": "Prebiotic pyruvate synthesis from simple aldehydes and CO2 is supported (Huber & W\u00e4chtersh\u00e4user, 1997; Muchowska et al., 2017)."}, {"id": "rxn_005", "name": "Pyruvate reductive amination to alanine", "inputs": ["mol_009", "mol_003"], "outputs": ["mol_011", "mol_004"], "environment": "Biochemical", "agents": ["FeS cluster or mineral", "UV light"], "conditions": {"temperature": "320-340K", "pressure": "ambient", "catalyst": "FeS or UV", "aqueous": true, "other": "Microenvironments or protocells"}, "mechanism": "Reductive amination of pyruvate yields L-alanine and water.", "reasoning": "Reductive amination of \u03b1-ketoacids is the principal biochemical route; surface/mineral or UV-catalyzed amination is plausible prebiotically (Raiswell et al., 2002; Weber, 1984)."}, {"id": "rxn_006", "name": "Strecker synthesis of alanine aminonitrile", "inputs": ["mol_007", "mol_003", "mol_005"], "outputs": ["mol_012", "mol_004"], "environment": "Surface", "agents": ["phosphate minerals"], "conditions": {"temperature": "300-350K", "pressure": "1 atm", "catalyst": "phosphate minerals", "aqueous": true, "other": "Mildly alkaline evaporitic pool, wet-dry cycling"}, "mechanism": "Acetaldehyde, ammonia, and HCN react by Strecker synthesis to form alanine aminonitrile plus water.", "reasoning": "Strecker reactions for \u03b1-amino acids are strongly supported (Lazcano & Bada, 2004; Pizzarello et al., 2006)."}, {"id": "rxn_007", "name": "Hydrolysis of alanine aminonitrile to L-alanine", "inputs": ["mol_012", "mol_004"], "outputs": ["mol_011"], "environment": "Surface", "agents": ["montmorillonite"], "conditions": {"temperature": "330-350K", "pressure": "1 atm", "catalyst": "montmorillonite", "aqueous": true, "other": "Wet-dry cycling or evaporitic pool"}, "mechanism": "Alanine aminonitrile is hydrolyzed to L-alanine.", "reasoning": "Geochemical and experimental precedents for clay-catalyzed aminonitrile hydrolysis (Barge et al., 2017; Saladino et al., 2001)."}, {"id": "rxn_008", "name": "Acetonitrile hydrolysis to amide then to methylamine", "inputs": ["mol_008", "mol_004"], "outputs": ["mol_010"], "environment": "Surface", "agents": ["montmorillonite"], "conditions": {"temperature": "320-350K", "pressure": "1 atm", "catalyst": "montmorillonite", "aqueous": true, "other": "Repeated hydrolysis in wet-dry cycles"}, "mechanism": "Stepwise hydration of acetonitrile forms methylamine.", "reasoning": "Methylamine is a recognized product of acetonitrile hydrolysis on clays (Peltzer & Bada, 1978)."}, {"id": "rxn_009", "name": "Methylamine to L-alanine via formose\u2013transamination sequence", "inputs": ["mol_010", "mol_006", "mol_003"], "outputs": ["mol_011", "mol_004"], "environment": "Biochemical", "agents": [null], "conditions": {"temperature": "320-330K", "pressure": "1 atm", "catalyst": null, "aqueous": true, "other": "Spontaneous or imine-catalyzed"}, "mechanism": "Methylamine reacts with formaldehyde and ammonia, yielding imine intermediates that hydrolyze to L-alanine.", "reasoning": "Imine chemistry with methylamines and C1s supports \u03b1-amino acid formation\u2014even without specific catalysts (Weber, 1998)."}, {"id": "rxn_010", "name": "Reductive amination of acetic acid to alanine", "inputs": ["mol_014", "mol_003", "mol_006"], "outputs": ["mol_011", "mol_004"], "environment": "Biochemical", "agents": ["FeS"], "conditions": {"temperature": "320-340K", "pressure": "ambient", "catalyst": "FeS", "aqueous": true, "other": "Inorganic surfaces, repetition in mini-pools"}, "mechanism": "Acetic acid, NH3, and formaldehyde undergo condensation and amination to yield alanine and water.", "reasoning": "Similar reactions with C2/C1s and ammonia give \u03b1-amino acids, especially on FeS (Huber & W\u00e4chtersh\u00e4user, 1998; speculative for pure acetic\u2013formaldehyde but logical extension)."}, {"id": "rxn_011", "name": "HCN trimerization and hydrolysis to ac