n_name\": \"pyruvic acid\",\n      \"inchi\": \"InChI=1S/C3H4O3/c1-2(4)3(5)6/h1H3,(H,5,6)\",\n      \"role\": \"hub_intermediate\",\n      \"environment_formed\": \"Hydrothermal\"\n    },\n    {\n      \"id\": \"mol_010\",\n      \"formula\": \"C3H5NO\",\n      \"iupac_name\": \"2-aminopropanal\",\n      \"common_name\": null,\n      \"inchi\": \"InChI=1S/C3H7NO/c1-3(4)2-5/h2-3H,4H2,1H3\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_011\",\n      \"formula\": \"C3H5NO\",\n      \"iupac_name\": \"2-aminopropanenitrile\",\n      \"common_name\": \"alanine nitrile\",\n      \"inchi\": \"InChI=1S/C3H6N2/c1-3(5)2-4/h2H,5H2,1H3\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_012\",\n      \"formula\": \"C3H5NO2\",\n      \"iupac_name\": \"(S)-2-aminopropanoic acid\",\n      \"common_name\": \"L-alanine\",\n      \"inchi\": \"InChI=1S/C3H7NO2/c1-2(4)3(5)6/h2H,4H2,1H3,(H,5,6)/t2-/m0/s1\",\n      \"role\": \"target\",\n      \"environment_formed\": \"Biochemical\"\n    },\n    {\n      \"id\": \"mol_013\",\n      \"formula\": \"C3H5NO2\",\n      \"iupac_name\": \"2-aminopropanoic acid\",\n      \"common_name\": \"DL-alanine\",\n      \"inchi\": \"InChI=1S/C3H7NO2/c1-2(4)3(5)6/h2H,4H2,1H3,(H,5,6)\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_014\",\n      \"formula\": \"C3H5NO2\",\n      \"iupac_name\": \"2-cyanopropanoic acid\",\n      \"common_name\": null,\n      \"inchi\": \"InChI=1S/C4H5NO2/c1-3(2-5)4(6)7/h2H,1H3,(H,6,7)\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    },\n    {\n      \"id\": \"mol_015\",\n      \"formula\": \"H2\",\n      \"iupac_name\": \"dihydrogen\",\n      \"common_name\": \"hydrogen\",\n      \"inchi\": \"InChI=1S/H2/h1H\",\n      \"role\": \"starting\",\n      \"environment_formed\": \"Hydrothermal\"\n    },\n    {\n      \"id\": \"mol_016\",\n      \"formula\": \"C2H5NH2\",\n      \"iupac_name\": \"ethanamine\",\n      \"common_name\": \"ethylamine\",\n      \"inchi\": \"InChI=1S/C2H7N/c1-2-3/h2-3H2,1H3\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Hydrothermal\"\n    },\n    {\n      \"id\": \"mol_017\",\n      \"formula\": \"C3H7NO\",\n      \"iupac_name\": \"2-amino-1-propanol\",\n      \"common_name\": null,\n      \"inchi\": \"InChI=1S/C3H9NO/c1-3(4)2-5/h3,5H,2,4H2,1H3\",\n      \"role\": \"intermediate\",\n      \"environment_formed\": \"Surface\"\n    }\n  ],\n  \"reactions\": [\n    {\n      \"id\": \"rxn_001\",\n      \"name\": \"Sabatier-type CO2 reduction to methane\",\n      \"inputs\": [\"mol_001\", \"mol_015\"],\n      \"outputs\": [\"mol_002\", \"mol_005\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"NiFe alloy\", \"FeS\"],\n      \"conditions\": {\n        \"temperature\": \"400-500K\",\n        \"pressure\": \"high\",\n        \"catalyst\": \"NiFe alloy/FeS\",\n        \"aqueous\": true,\n        \"other\": null\n      },\n      \"mechanism\": \"CO2 is hydrogenated in the presence of an FeS/NiFe catalytic surface to yield methane and water\",\n      \"reasoning\": \"Sabatier and CO2 reduction reactions are well-established for hydrothermal systems (McCollom & Seewald, 2007); plausible source of methane for prebiotic carbon feedstock.\"\n    },\n    {\n      \"id\": \"rxn_002\",\n      \"name\": \"Methane partial oxidation to formaldehyde\",\n      \"inputs\": [\"mol_002\", \"mol_001\"],\n      \"outputs\": [\"mol_006\", \"mol_005\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"Fe-oxides\"],\n      \"conditions\": {\n        \"temperature\": \"500-600K\",\n        \"pressure\": \"high\",\n        \"catalyst\": \"Fe-oxide mineral surface\",\n        \"aqueous\": true,\n        \"other\": null\n      },\n      \"mechanism\": \"Methane reacts with CO2 on iron oxide surfaces to yield formaldehyde; water is produced as byproduct\",\n      \"reasoning\": \"Supported in high-temp hydrothermal and volcanic systems (Horita & Berndt, 1999); SH-mineral catalysis plausible under reducing conditions.\"\n    },\n    {\n      \"id\": \"rxn_003\",\n      \"name\": \"HCN formation from methane/ammonia/shock\",\n      \"inputs\": [\"mol_002\", \"mol_003\"],\n      \"outputs\": [\"mol_004\", \"mol_005\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"UV light\"],\n      \"conditions\": {\n        \"temperature\": \"320-340K\",\n        \"pressure\": \"1 atm\",\n        \"catalyst\": null,\n        \"aqueous\": true,\n        \"other\": \"Strong UV\"\n      },\n      \"mechanism\": \"Methane and ammonia photochemically react under UV irradiation to form HCN and water\",\n      \"reasoning\": \"Supported by Titan-atmosphere radiolysis and spark discharge (Miller & Urey, 1959); plausible prebiotic feedstock route.\"\n    },\n    {\n      \"id\": \"rxn_004\",\n      \"name\": \"Formaldehyde dimerization to acetaldehyde\",\n      \"inputs\": [\"mol_006\"],\n      \"outputs\": [\"mol_007\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"CaO (basic surface)\"],\n      \"conditions\": {\n        \"temperature\": \"400-500K\",\n        \"pressure\": \"high\",\n        \"catalyst\": \"CaO\",\n        \"aqueous\": false,\n        \"other\": null\n      },\n      \"mechanism\": \"Cannizzaro-type surface reaction yields acetaldehyde and formic acid (not tracked here as L-alanine carbon atoms all trace from formaldehyde)\",\n      \"reasoning\": \"Well-established for basic mineral-driven aldehyde condensations; see Kitadai et al. (2012).\"\n    },\n    {\n      \"id\": \"rxn_005\",\n      \"name\": \"Strecker amino acid synthesis (alanine)\",\n      \"inputs\": [\"mol_007\", \"mol_003\", \"mol_004\", \"mol_005\"],\n      \"outputs\": [\"mol_011\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"montmorillonite clay\"],\n      \"conditions\": {\n        \"temperature\": \"300-320K\",\n        \"pressure\": \"ambient\",\n        \"catalyst\": \"Montmorillonite\",\n        \"aqueous\": true,\n        \"other\": \"Wet-dry cycles\"\n      },\n      \"mechanism\": \"Aldehyde reacts with ammonium and HCN to give the aminonitrile (alanine nitrile); water is consumed as solvent\",\n      \"reasoning\": \"Canonical Strecker synthesis, experimentally established to proceed on clays (Ferris et al., 1996).\"\n    },\n    {\n      \"id\": \"rxn_006\",\n      \"name\": \"Alanine nitrile hydrolysis to DL-alanine\",\n      \"inputs\": [\"mol_011\", \"mol_005\"],\n      \"outputs\": [\"mol_013\", \"mol_003\"],\n      \"environment\": \"Surface\",\n      \"agents\": [\"hectorite clay\"],\n      \"conditions\": {\n        \"temperature\": \"340-360K\",\n        \"pressure\": \"ambient\",\n        \"catalyst\": \"Hectorite\",\n        \"aqueous\": true,\n        \"other\": \"Wet-dry cycles\"\n      },\n      \"mechanism\": \"Aminonitrile is hydrolyzed to racemic alanine with ammonia released\",\n      \"reasoning\": \"Strecker aminonitrile hydrolysis reproducible under mild prebiotic surface conditions (Brack, 1998; Danger et al., 2012).\"\n    },\n    {\n      \"id\": \"rxn_007\",\n      \"name\": \"Pyruvate amination to alanine (reductive amination)\",\n      \"inputs\": [\"mol_009\", \"mol_003\", \"mol_015\"],\n      \"outputs\": [\"mol_013\", \"mol_005\"],\n      \"environment\": \"Hydrothermal\",\n      \"agents\": [\"FeS\", \"NiS\"],\n      \"conditions\": {\n        \"temperature\": \"400-450K\",\n        \"pressure\": \"high\",\n        \"catalyst\": \"FeS/NiS\",\n        \"aqueous\": true,\n        \"other\": null\n      },\n      \"mechanism\": \"Pyruvate is reductively aminated with ammonia and hydrogen to give alanine and water\",\n      \"reasoning\": \"Supported by hydrothermal mineral surface catalysis (Muchowska et al., 2019).\"\n    },\n    {\n      \"id\": \"rxn_008\",\n      \"name\": \"Acetaldeh