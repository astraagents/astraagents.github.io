iates": ["mol_006"]}, {"pathway_id": "P8", "name": "Hydrothermal Strecker with quench via glycinamide", "description": "Moderate hydrothermal Strecker entry followed by stepwise post-quench hydrolysis through glycinamide.", "reaction_sequence": ["rxn_004", "rxn_006", "rxn_007"], "key_intermediates": ["mol_006", "mol_007"]}, {"pathway_id": "P9", "name": "Hydrothermal Strecker with quench via hydantoin", "description": "Moderate hydrothermal Strecker entry followed by post-quench CO2 capture as hydantoin and hydrolysis to glycine.", "reaction_sequence": ["rxn_004", "rxn_008", "rxn_009"], "key_intermediates": ["mol_006", "mol_009"]}, {"pathway_id": "P10", "name": "Glyoxylate reductive amination via glycine imine", "description": "Non-cyanide mineral-interface route in which glyoxylate forms glycine imine and is then hydrogenated on Ni or meteoritic metal; chemically strong, but upstream glyoxylate supply remains the main uncertainty.", "reaction_sequence": ["rxn_010", "rxn_011"], "key_intermediates": ["mol_011"]}], "hub_molecules": ["mol_005", "mol_006", "mol_014"], "convergence_points": [{"molecule_id": "mol_005", "incoming_reactions": ["rxn_002"], "outgoing_reactions": ["rxn_003", "rxn_012"]}, {"molecule_id": "mol_006", "incoming_reactions": ["rxn_001", "rxn_003", "rxn_004"], "outgoing_reactions": ["rxn_005", "rxn_006", "rxn_008"]}, {"molecule_id": "mol_014", "incoming_reactions": ["rxn_005", "rxn_007", "rxn_009", "rxn_011"], "outgoing_reactions": []}]}, "reasoning": "", "duration_ms": 608931.1769008636, "success": true, "error_message": null}
