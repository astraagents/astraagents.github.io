    Reactions: rxn_001 -> rxn_002 -> rxn_004 -> rxn_008 -> rxn_009 -> rxn_010 -> rxn_012 -> rxn_014 -> rxn_017 -> rxn_018 -> rxn_020 -> rxn_021
